// ═══════════════════════════════════════
// CHAPTER EDITOR
// ═══════════════════════════════════════
function parseFM(text){
  const m=text.match(/^---\s*([\s\S]*?)---/); if(!m) return {};
  const fm={};
  let arr=null, arrKey=null;
  for(const line of m[1].split('\n')){
    const kv=line.match(/^(\w[\w_-]*):\s*(.*)/);
    if(kv){ arr=null; const v=kv[2].trim().replace(/^"(.*)"$/,'$1'); fm[kv[1]]=v===''?(arr=[],arrKey=kv[1],arr):isNaN(v)?v:Number(v); }
    else if(line.match(/^\s+-\s+"?(.+?)"?\s*$/)&&arr!==null) arr.push(line.match(/^\s+-\s+"?(.+?)"?\s*$/)[1]);
  }
  return fm;
}

function buildMD(title,tid,chuong,date,tags,body){
  const tl=tags.split(',').map(t=>t.trim()).filter(Boolean);
  let fm='---\n';
  fm+=`layout: ${tid?'../../../../':'../'}layouts/Layout.astro\n`;
  fm+=`title: "${title.replace(/"/g,'\\"')}"\n`;
  if(tid) fm+=`truyen_id: "${tid}"\n`;
  if(chuong!==''&&chuong!==null) fm+=`chuong: ${chuong}\n`;
  if(date) fm+=`date: "${date}"\n`;
  if(tl.length) fm+=`tags:\n${tl.map(t=>`  - "${t.replace(/"/g,'\\"')}"`).join('\n')}\n`;
  fm+='---\n\n';
  return fm+body;
}

window.openEditor=async function(mode,filename=null){
  editorMode=mode; currentFile={filename:null,sha:null,path:null};
  $('editorTitle').textContent=mode==='new'?`Chương mới — ${currentStory?.title||''}`:filename;
  $('editorBack').onclick=()=>{showSection('chap-list');renderChapTable();};
  $('editorStatus').textContent='';
  // reset tabs
  $$('#editorTabs .tab').forEach(t=>t.classList.toggle('active',t.dataset.tab==='write'));
  $$('#tab-write, #tab-meta, #tab-preview').forEach(p=>p.classList.toggle('active',p.id==='tab-write'));

  if(mode==='new'){
    $('ef-title').value=''; $('ef-chuong').value=''; $('ef-tid').value=currentStory?.id||''; $('ef-date').value=today(); $('ef-tags').value=''; $('ef-content').value='';
  } else {
    $('editorStatus').textContent='⏳ Đang tải...';
    try{
      const p=`${currentStory.path}/${filename}`;
      const fd=await getFile(p);
      currentFile={filename,sha:fd.sha,path:p};
      const fm=parseFM(fd.decoded);
      $('ef-title').value=fm.title||'';
      $('ef-chuong').value=fm.chuong??'';
      $('ef-tid').value=fm.truyen_id||currentStory?.id||'';
      $('ef-date').value=fm.date||today();
      $('ef-tags').value=Array.isArray(fm.tags)?fm.tags.join(', '):(fm.tags||'');
      const body=fd.decoded.replace(/^---[\s\S]*?---\s*/,'').trim();
      $('ef-content').value=body;
      $('editorStatus').textContent='✓ Đã tải';
    }catch(e){ $('editorStatus').textContent=`Lỗi: ${e.message}`; }
  }
  updateWC(); showSection('editor');
};

