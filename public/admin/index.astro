---
// src/pages/admin/index.astro
---
<!DOCTYPE html>
<html lang="vi" data-theme="">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin · Dynamic Duo</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=Literata:wght@400;600&display=swap" rel="stylesheet" />
  <style>
    :root{
      --sky:#0ea5e9;--sky2:#0284c7;--sky-dark:#0369a1;
      --sky-light:#bae6fd;--sky-pale:#f0f9ff;
      --bg:#fafcff;--bg2:#fff;--border:rgba(186,230,253,.6);
      --text:#1e3a5f;--text-mid:#64748b;--text-dim:#94a3b8;
      --red:#ef4444;--green:#22c55e;--amber:#f59e0b;
      --r-sm:6px;--r-md:12px;--r-lg:20px;--r-pill:999px;--t:all .2s ease;
    }
    [data-theme="dark"]{
      --sky:#38bdf8;--sky2:#7dd3fc;--sky-dark:#bae6fd;
      --sky-light:#1e4a6e;--sky-pale:#0f2a40;
      --bg:#0b1829;--bg2:#0d1e36;--border:rgba(30,74,110,.6);
      --text:#e0f2fe;--text-mid:#94a3b8;--text-dim:#4a6080;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{background:var(--bg);font-family:'Newsreader',serif;font-size:15px;color:var(--text);min-height:100vh}
    a{color:inherit;text-decoration:none}
    input,select,textarea,button{font-family:inherit}

    /* ── TOPBAR ── */
    .topbar{
      position:sticky;top:0;z-index:100;background:var(--bg2);
      border-bottom:1px solid var(--border);
      display:flex;align-items:center;justify-content:space-between;
      padding:0 20px;height:50px;box-shadow:0 2px 8px rgba(14,165,233,.07);
    }
    .topbar-logo{font-family:'Literata',serif;font-weight:600;font-size:.9rem;color:var(--sky-dark)}
    .topbar-right{display:flex;align-items:center;gap:8px}
    .topbar-user{font-size:.75rem;color:var(--text-mid)}
    .btn{padding:5px 14px;border-radius:var(--r-pill);font-size:.78rem;cursor:pointer;transition:var(--t);border:1.5px solid transparent;font-family:'Newsreader',serif;display:inline-flex;align-items:center;gap:4px}
    .btn-sky{background:var(--sky);color:#fff;border-color:var(--sky)}
    .btn-sky:hover{background:var(--sky2)}
    .btn-outline{background:var(--bg2);color:var(--sky-dark);border-color:var(--border)}
    .btn-outline:hover{background:var(--sky-pale);border-color:var(--sky);color:var(--sky)}
    .btn-red{background:var(--red);color:#fff;border-color:var(--red)}
    .btn-red:hover{opacity:.85}
    .btn-amber{background:var(--amber);color:#fff;border-color:var(--amber)}
    .btn-sm{padding:3px 10px;font-size:.72rem}

    /* ── LAYOUT ── */
    .admin-layout{display:flex;min-height:calc(100vh - 50px)}
    .sidebar{
      width:210px;flex-shrink:0;background:var(--bg2);
      border-right:1px solid var(--border);padding:14px 0;
    }
    .sb-sec{padding:5px 14px;font-size:.6rem;letter-spacing:2px;text-transform:uppercase;color:var(--text-dim);margin-top:10px}
    .sb-link{
      display:block;padding:8px 18px;font-size:.8rem;color:var(--text-mid);
      cursor:pointer;transition:var(--t);border-left:3px solid transparent;
    }
    .sb-link:hover,.sb-link.active{background:var(--sky-pale);color:var(--sky);border-left-color:var(--sky)}
    .main{flex:1;padding:24px 28px;max-width:980px;overflow:hidden}
    @media(max-width:700px){.sidebar{display:none}.main{padding:16px}}

    /* ── LOGIN ── */
    #loginScreen{
      position:fixed;inset:0;z-index:200;background:var(--bg);
      display:flex;align-items:center;justify-content:center;
    }
    .login-card{
      width:370px;background:var(--bg2);border:1px solid var(--border);
      border-radius:var(--r-lg);padding:36px 32px;
      box-shadow:0 8px 40px rgba(14,165,233,.12);text-align:center;
    }
    .login-logo{font-family:'Literata',serif;font-size:1.3rem;font-weight:600;color:var(--sky-dark);margin-bottom:4px}
    .login-sub{font-size:.78rem;color:var(--text-dim);font-style:italic;margin-bottom:24px}
    .field{margin-bottom:14px;text-align:left}
    .field label{display:block;font-size:.74rem;color:var(--text-mid);margin-bottom:4px}
    .field input,.field select,.field textarea{
      width:100%;padding:9px 12px;border:1.5px solid var(--border);border-radius:var(--r-md);
      font-size:.88rem;color:var(--text);background:var(--bg);transition:var(--t);
    }
    .field input:focus,.field select:focus,.field textarea:focus{outline:none;border-color:var(--sky);box-shadow:0 0 0 3px rgba(14,165,233,.1)}
    .field textarea{resize:vertical;min-height:100px;line-height:1.7}
    .err-msg{background:#fef2f2;border:1px solid #fca5a5;border-radius:var(--r-sm);padding:7px 11px;font-size:.76rem;color:var(--red);margin-bottom:10px;display:none}
    .login-note{font-size:.7rem;color:var(--text-dim);margin-top:12px;line-height:1.55}
    .login-note a{color:var(--sky)}

    /* ── SECTIONS ── */
    .section{display:none}
    .section.active{display:block}
    .sec-title{font-family:'Literata',serif;font-size:1.1rem;font-weight:600;color:var(--sky-dark);margin:0 0 18px}

    /* ── STAT CARDS ── */
    .stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:12px;margin-bottom:24px}
    .stat-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r-md);padding:16px 14px;text-align:center}
    .stat-num{font-family:'Literata',serif;font-size:1.6rem;font-weight:600;color:var(--sky-dark)}
    .stat-label{font-size:.7rem;color:var(--text-dim);margin-top:3px}

    /* ── STORY LIST ── */
    .story-item{
      display:flex;justify-content:space-between;align-items:center;
      padding:14px 16px;background:var(--bg2);border:1px solid var(--border);
      border-radius:var(--r-md);margin-bottom:10px;gap:12px;flex-wrap:wrap;
    }
    .story-item-info h3{font-family:'Literata',serif;font-size:.95rem;color:var(--sky-dark);margin:0 0 3px}
    .story-item-info p{font-size:.72rem;color:var(--text-dim);margin:0}
    .story-item-btns{display:flex;gap:6px;flex-shrink:0}

    /* ── CHAPTER TABLE ── */
    .chap-toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:12px}
    .chap-table{width:100%;border-collapse:collapse}
    .chap-table th{text-align:left;padding:7px 10px;font-size:.68rem;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-dim);border-bottom:2px solid var(--border)}
    .chap-table td{padding:9px 10px;border-bottom:1px solid rgba(186,230,253,.2);font-size:.8rem;color:var(--text-mid);vertical-align:middle}
    .chap-table tr:hover td{background:var(--sky-pale)}
    .chap-check{width:16px;height:16px;cursor:pointer;accent-color:var(--sky)}
    .chap-num{font-weight:600;color:var(--sky-dark);width:40px}
    .chap-title-cell{color:var(--text);max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .chap-actions{display:flex;gap:5px;white-space:nowrap}
    .bulk-bar{
      background:var(--sky);color:#fff;border-radius:var(--r-md);padding:10px 16px;
      display:none;align-items:center;gap:10px;margin-bottom:12px;font-size:.8rem;flex-wrap:wrap;
    }
    .bulk-bar.show{display:flex}

    /* ── EDITOR ── */
    .editor-header{display:flex;align-items:center;gap:10px;margin-bottom:18px;flex-wrap:wrap}
    .editor-back{cursor:pointer;color:var(--sky);font-size:.8rem;flex-shrink:0}
    .editor-back:hover{text-decoration:underline}
    .editor-title{font-family:'Literata',serif;font-size:1rem;font-weight:600;color:var(--sky-dark);flex:1}
    .editor-status{font-size:.72rem;color:var(--text-dim)}
    .meta-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
    @media(max-width:600px){.meta-grid{grid-template-columns:1fr}}
    .toolbar{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:6px}
    .tool-btn{
      padding:4px 9px;background:var(--sky-pale);border:1px solid var(--border);
      border-radius:var(--r-sm);font-size:.73rem;color:var(--sky-dark);
      cursor:pointer;transition:var(--t);
    }
    .tool-btn:hover{background:var(--sky-light)}
    .content-editor{
      width:100%;min-height:420px;border:1.5px solid var(--border);border-radius:var(--r-md);
      padding:14px 18px;font-size:.9rem;line-height:1.9;color:var(--text);
      resize:vertical;transition:var(--t);background:var(--bg);
    }
    .content-editor:focus{outline:none;border-color:var(--sky);box-shadow:0 0 0 3px rgba(14,165,233,.1)}
    .word-count{font-size:.68rem;color:var(--text-dim);text-align:right;margin-top:3px}
    .preview-panel{
      display:none;border:1.5px solid var(--border);border-radius:var(--r-md);
      padding:22px 26px;background:var(--bg2);margin-top:-4px;
      line-height:1.9;font-size:.9rem;min-height:200px;color:var(--text);
    }

    /* ── UPLOAD PANEL ── */
    .upload-zone{
      border:2px dashed var(--sky-light);border-radius:var(--r-md);
      padding:32px 20px;text-align:center;background:var(--sky-pale);
      cursor:pointer;transition:var(--t);
    }
    .upload-zone:hover,.upload-zone.drag{border-color:var(--sky);background:rgba(186,230,253,.2)}
    .upload-zone p{color:var(--text-mid);font-size:.84rem;margin:6px 0}
    .upload-preview{margin-top:14px;font-size:.8rem;color:var(--text-mid)}
    .progress-wrap{margin-top:12px}
    .progress-bar{height:6px;background:rgba(186,230,253,.3);border-radius:3px;overflow:hidden}
    .progress-fill{height:100%;background:var(--sky);border-radius:3px;transition:width .3s}

    /* ── STORY META EDITOR ── */
    .story-meta-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r-md);padding:18px 20px;margin-bottom:14px}
    .story-meta-card h3{font-family:'Literata',serif;font-size:.95rem;color:var(--sky-dark);margin:0 0 14px}

    /* ── TOAST ── */
    .toast{
      position:fixed;bottom:20px;right:20px;z-index:500;
      padding:11px 18px;border-radius:var(--r-md);font-size:.8rem;
      box-shadow:0 4px 16px rgba(0,0,0,.15);pointer-events:none;
      opacity:0;transform:translateY(10px);transition:opacity .3s,transform .3s;
    }
    .toast.show{opacity:1;transform:translateY(0)}
    .toast.success{background:#dcfce7;color:#166534;border:1px solid #86efac}
    .toast.error{background:#fef2f2;color:var(--red);border:1px solid #fca5a5}
    .toast.info{background:var(--sky-pale);color:var(--sky-dark);border:1px solid var(--sky-light)}

    /* ── SPINNER ── */
    .spin{display:inline-block;width:12px;height:12px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;vertical-align:middle}
    @keyframes spin{to{transform:rotate(360deg)}}

    /* ── CONFIRM ── */
    .overlay{position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:300;display:none;align-items:center;justify-content:center}
    .overlay.open{display:flex}
    .dialog{background:var(--bg2);border-radius:var(--r-lg);padding:26px;max-width:360px;width:90%;box-shadow:0 8px 40px rgba(0,0,0,.15)}
    .dialog h3{font-family:'Literata',serif;font-size:1rem;color:var(--text);margin:0 0 7px}
    .dialog p{font-size:.82rem;color:var(--text-mid);margin:0 0 18px;line-height:1.6}
    .dialog-btns{display:flex;gap:8px;justify-content:flex-end}

    /* ── TABS ── */
    .tabs{display:flex;gap:2px;border-bottom:2px solid var(--border);margin-bottom:18px}
    .tab{padding:7px 16px;font-size:.78rem;cursor:pointer;color:var(--text-mid);border-radius:var(--r-sm) var(--r-sm) 0 0;transition:var(--t);border-bottom:2px solid transparent;margin-bottom:-2px}
    .tab:hover{color:var(--sky);background:var(--sky-pale)}
    .tab.active{color:var(--sky);border-bottom-color:var(--sky);font-weight:600}
    .tab-panel{display:none}
    .tab-panel.active{display:block}

    /* DARK toggle in topbar */
    .theme-toggle{background:none;border:1.5px solid var(--border);border-radius:var(--r-pill);color:var(--text-mid);padding:3px 10px;font-size:.74rem;cursor:pointer;transition:var(--t)}
    .theme-toggle:hover{background:var(--sky-pale);color:var(--sky)}
  </style>
</head>
<body>

<!-- LOGIN -->
<div id="loginScreen">
  <div class="login-card">
    <div class="login-logo">dynamic duo ⚙</div>
    <div class="login-sub">Admin Panel</div>
    <div class="err-msg" id="loginErr"></div>
    <div class="field"><label>GitHub Token (quyền repo)</label><input type="password" id="tokenInput" placeholder="ghp_..." /></div>
    <div class="field"><label>Mật khẩu Admin</label><input type="password" id="passInput" placeholder="Mật khẩu" /></div>
    <button class="btn btn-sky" style="width:100%;margin-top:4px" id="loginBtn">Đăng nhập</button>
    <div class="login-note">
      Token tạo tại <a href="https://github.com/settings/tokens" target="_blank">github.com/settings/tokens</a> (chọn quyền <strong>repo</strong>).<br/>
      Mật khẩu admin: đổi field <code>ADMIN_PASSWORD</code> trong script dưới đây.
    </div>
  </div>
</div>

<!-- CONFIRM DIALOG -->
<div class="overlay" id="confirmOverlay">
  <div class="dialog">
    <h3 id="confirmTitle">Xác nhận</h3>
    <p id="confirmMsg"></p>
    <div class="dialog-btns">
      <button class="btn btn-outline" id="confirmCancel">Huỷ</button>
      <button class="btn btn-red" id="confirmOk">Xác nhận</button>
    </div>
  </div>
</div>

<!-- TOAST -->
<div class="toast" id="toast"></div>

<!-- APP -->
<div id="app" style="display:none">
  <div class="topbar">
    <div class="topbar-logo">⚙ Admin · dynamic duo</div>
    <div class="topbar-right">
      <button class="theme-toggle" id="themeBtn">🌙</button>
      <a href="/dynamic-duo-web/" target="_blank" class="btn btn-outline btn-sm">← Web</a>
      <span class="topbar-user" id="topUser"></span>
      <button class="btn btn-outline btn-sm" id="logoutBtn">Thoát</button>
    </div>
  </div>
  <div class="admin-layout">
    <div class="sidebar">
      <div class="sb-sec">Tổng quan</div>
      <div class="sb-link active" data-s="dashboard">📊 Dashboard</div>
      <div class="sb-sec">Truyện</div>
      <div class="sb-link" data-s="ongoing">🌊 Cá dưới nước</div>
      <div class="sb-link" data-s="completed">🍽️ Cá trên bàn</div>
      <div class="sb-link" data-s="upcoming">🌤️ Sắp đào</div>
      <div class="sb-sec">Công cụ</div>
      <div class="sb-link" data-s="quick-post">✏️ Đăng nhanh</div>
      <div class="sb-link" data-s="bulk-upload">📦 Upload hàng loạt</div>
      <div class="sb-link" data-s="new-story">📚 Thêm truyện</div>
    </div>
    <div class="main">

      <!-- DASHBOARD -->
      <div class="section active" id="sec-dashboard">
        <div class="sec-title">📊 Dashboard</div>
        <div class="stat-grid">
          <div class="stat-card"><div class="stat-num" id="stOngoing">–</div><div class="stat-label">Đang làm</div></div>
          <div class="stat-card"><div class="stat-num" id="stDone">–</div><div class="stat-label">Hoàn thành</div></div>
          <div class="stat-card"><div class="stat-num" id="stChaps">–</div><div class="stat-label">Tổng chương</div></div>
          <div class="stat-card"><div class="stat-num" id="stUpcoming">–</div><div class="stat-label">Sắp đào</div></div>
        </div>
        <div id="dashRecent"></div>
      </div>

      <!-- ONGOING -->
      <div class="section" id="sec-ongoing">
        <div class="sec-title">🌊 Cá dưới nước</div>
        <div id="ongoingList"></div>
      </div>

      <!-- COMPLETED -->
      <div class="section" id="sec-completed">
        <div class="sec-title">🍽️ Cá trên bàn</div>
        <div id="completedList"></div>
      </div>

      <!-- UPCOMING -->
      <div class="section" id="sec-upcoming">
        <div class="sec-title">🌤️ Sắp đào</div>
        <div id="upcomingList"></div>
      </div>

      <!-- CHAPTER LIST -->
      <div class="section" id="sec-chap-list">
        <div class="editor-header">
          <span class="editor-back" id="chapListBack">← Quay lại</span>
          <div class="editor-title" id="chapListTitle">Danh sách chương</div>
          <button class="btn btn-sky btn-sm" id="addChapBtn">+ Thêm chương</button>
        </div>
        <!-- Bulk bar -->
        <div class="bulk-bar" id="bulkBar">
          <span id="bulkCount">0 đã chọn</span>
          <button class="btn btn-red btn-sm" id="bulkDeleteBtn">🗑 Xoá hàng loạt</button>
          <button class="btn btn-outline btn-sm" id="bulkUnselectBtn" style="color:#fff;border-color:rgba(255,255,255,.4)">Bỏ chọn tất cả</button>
        </div>
        <div class="chap-toolbar">
          <button class="btn btn-outline btn-sm" id="selectAllBtn">☑ Chọn tất cả</button>
          <input type="text" id="chapSearch" placeholder="Tìm chương..." style="padding:5px 12px;border:1.5px solid var(--border);border-radius:var(--r-pill);font-size:.78rem;color:var(--text);background:var(--bg);width:200px" />
        </div>
        <div id="chapTableWrap"></div>
      </div>

      <!-- CHAPTER EDITOR -->
      <div class="section" id="sec-editor">
        <div class="editor-header">
          <span class="editor-back" id="editorBack">← Danh sách chương</span>
          <div class="editor-title" id="editorTitle">Soạn chương</div>
          <span class="editor-status" id="editorStatus"></span>
          <button class="btn btn-sky" id="saveBtn">💾 Lưu & Deploy</button>
        </div>
        <div class="tabs" id="editorTabs">
          <div class="tab active" data-tab="write">✏️ Soạn thảo</div>
          <div class="tab" data-tab="meta">⚙ Thông tin</div>
          <div class="tab" data-tab="preview">👁 Preview</div>
        </div>
        <div class="tab-panel active" id="tab-write">
          <div class="toolbar">
            <button class="tool-btn" data-wrap="**" data-end="**"><b>B</b></button>
            <button class="tool-btn" data-wrap="*" data-end="*"><i>I</i></button>
            <button class="tool-btn" data-ins="&#10;---&#10;">── HR ──</button>
            <button class="tool-btn" data-ins="&#10;> ">❝ Quote</button>
            <button class="tool-btn" data-ins="&#10;## ">H2</button>
            <button class="tool-btn" data-ins="&#10;#### ">H4</button>
          </div>
          <textarea class="content-editor" id="ef-content" placeholder="Dán nội dung chương vào đây..."></textarea>
          <div class="word-count" id="wordCount">0 ký tự · 0 từ</div>
        </div>
        <div class="tab-panel" id="tab-meta">
          <div class="meta-grid">
            <div class="field"><label>Tiêu đề chương</label><input type="text" id="ef-title" placeholder="Chương 5 – Tên chương" /></div>
            <div class="field"><label>Số chương</label><input type="number" id="ef-chuong" min="0" /></div>
            <div class="field"><label>Mã truyện (truyen_id)</label><input type="text" id="ef-tid" readonly style="background:var(--sky-pale)" /></div>
            <div class="field"><label>Ngày đăng</label><input type="date" id="ef-date" /></div>
          </div>
          <div class="field"><label>Tags (phẩy)</label><input type="text" id="ef-tags" /></div>
        </div>
        <div class="tab-panel" id="tab-preview">
          <div class="preview-panel" id="previewPanel" style="display:block"></div>
        </div>
      </div>

      <!-- STORY META EDITOR -->
      <div class="section" id="sec-story-meta">
        <div class="editor-header">
          <span class="editor-back" id="metaBack">← Quay lại</span>
          <div class="editor-title" id="metaTitle">Thông tin truyện</div>
          <button class="btn btn-sky" id="metaSaveBtn">💾 Lưu thông tin</button>
        </div>
        <div class="story-meta-card">
          <h3>Thông tin cơ bản</h3>
          <div class="meta-grid">
            <div class="field"><label>Tên truyện</label><input type="text" id="sm-title" /></div>
            <div class="field"><label>Tác giả</label><input type="text" id="sm-author" /></div>
            <div class="field"><label>Tổng chương dự kiến</label><input type="number" id="sm-total" /></div>
            <div class="field"><label>Trạng thái</label>
              <select id="sm-status">
                <option value="ongoing">🌊 Đang tiến hành</option>
                <option value="completed">✅ Hoàn thành</option>
                <option value="upcoming">🌤️ Sắp đào</option>
              </select>
            </div>
          </div>
          <div class="field"><label>Đường dẫn ảnh bìa</label><input type="text" id="sm-cover" placeholder="/dynamic-duo-web/images/..." /></div>
          <div class="field"><label>Mô tả ngắn</label><textarea id="sm-desc" style="min-height:70px"></textarea></div>
          <div class="field"><label>Tags</label><input type="text" id="sm-tags" /></div>
        </div>
        <div class="story-meta-card">
