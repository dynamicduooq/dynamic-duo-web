// ═══════════════════════════════════════
// BULK UPLOAD — PASTE MODE
// ═══════════════════════════════════════
function parseChapters(text,startNum){
  // Split by heading patterns: ### Chương N, Chương N, === Chương N ===
  const re=/(?:^|\n)(?:#{1,4}\s*|={3}\s*)?(?:chương|chapter|chuong)\s*(\d+)(?:\s*[-–—:]\s*([^\n]*))?/gi;
  const parts=[]; let lastIdx=0, lastNum=startNum-1, lastTitle='';
  let m;
  while((m=re.exec(text))!==null){
    if(m.index>lastIdx+5){
      parts.push({ num:lastNum, title:lastTitle||`Chương ${lastNum}`, body:text.slice(lastIdx,m.index).trim() });
    }
    lastNum=parseInt(m[1]); lastTitle=(m[2]||'').trim()||`Chương ${lastNum}`; lastIdx=m.index+m[0].length;
  }
  if(lastIdx<text.length-5) parts.push({ num:lastNum, title:lastTitle||`Chương ${lastNum}`, body:text.slice(lastIdx).trim() });
  return parts.filter(p=>p.body.length>10);
}

$('bu-parseBtn').onclick=()=>{
