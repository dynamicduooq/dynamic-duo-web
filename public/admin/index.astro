    parsedChapters.map(c=>`<span style="display:inline-block;margin:2px 6px;padding:1px 8px;background:var(--sky-pale);border-radius:var(--r-pill);font-size:.72rem;color:var(--sky)">C${c.num}: ${c.title.slice(0,30)}</span>`).join('');
