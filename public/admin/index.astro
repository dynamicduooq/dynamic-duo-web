  const tl=tags.split(',').map(t=>t.trim()).filter(Boolean);
  const btn=$('bu-uploadBtn'); btn.disabled=true;
  const prog=$('bu-progress'); prog.style.display='block';
  let done=0;
  for(const chap of parsedChapters){
    $('bu-prog-label').textContent=`Upload ${done+1}/${parsedChapters.length}: ${chap.title}`;
    try{
      const fn=`chuong-${String(chap.num).padStart(2,'0')}.md`;
      let fm=`---\nlayout: ../../../../layouts/Layout.astro\ntitle: "${chap.title.replace(/"/g,'\\"')}"\ntruyen_id: "${sid}"\nchuong: ${chap.num}\ndate: "${today()}"\n`;
      if(tl.length) fm+=`tags:\n${tl.map(t=>`  - "${t}"`).join('\n')}\n`;
      fm+='---\n\n';
      await putFile(`src/pages/${sp}/${fn}`,fm+chap.body,`✏️ Bulk: ${chap.title}`,null);
      done++;
    }catch(e){ toast(`Lỗi C${chap.num}: ${e.message}`,'error'); }
    $('bu-prog-fill').style.width=`${Math.round((done/parsedChapters.length)*100)}%`;
    await new Promise(r=>setTimeout(r,600)); // rate limit
  }
  prog.style.display='none'; btn.disabled=false;
  toast(`✅ Đã upload ${done}/${parsedChapters.length} chương!`,'success',5000);
  parsedChapters=[]; $('bu-preview').innerHTML=''; $('bu-content').value='';
  $('bu-uploadBtn').textContent='🚀 Upload tất cả';
};

// ═══════════════════════════════════════
// BULK UPLOAD — FILE MODE
// ═══════════════════════════════════════
const dz=$('fileDropZone'), fi=$('fileInput');
dz.ondragover=e=>{ e.preventDefault(); dz.classList.add('drag'); };
dz.ondragleave=()=>dz.classList.remove('drag');
dz.ondrop=e=>{ e.preventDefault(); dz.classList.remove('drag'); handleFile(e.dataTransfer.files[0]); };
fi.onchange=()=>handleFile(fi.files[0]);

async function handleFile(file){
  if(!file) return;
  $('filePreview').textContent='Đang đọc file...';
  try{
    let text='';
    if(file.name.endsWith('.txt')){
      text=await file.text();
    } else if(file.name.endsWith('.docx')){
      // Parse docx: use mammoth if available, else fallback
      try{
        const mammoth=await import('https://cdn.jsdelivr.net/npm/mammoth@1/mammoth.browser.min.js').catch(()=>null);
        if(mammoth){
          const ab=await file.arrayBuffer();
          const res=await mammoth.extractRawText({arrayBuffer:ab});
          text=res.value;
        } else throw new Error('Thư viện đọc docx chưa sẵn sàng. Hãy copy nội dung và dùng tab "Dán nhiều chương".');
      }catch(e2){ throw e2; }
    } else {
      throw new Error('Chỉ hỗ trợ .txt và .docx');
    }
    const start=parseInt($('fw-start').value)||1;
    fileChapters=parseChapters(text,start);
    if(!fileChapters.length){
      $('filePreview').innerHTML='<span style="color:var(--red)">Không tìm thấy chương. File phải có dòng "Chương N" để phân tách.</span>';
      $('fw-uploadBtn').disabled=true; return;
    }
    $('filePreview').innerHTML=`<strong style="color:var(--sky)">Đọc được ${fileChapters.length} chương từ "${file.name}"</strong><br/>`+
      fileChapters.slice(0,5).map(c=>`<span style="font-size:.74rem;color:var(--sky)">C${c.num}: ${c.title.slice(0,40)}</span>`).join('<br/>');
    $('fw-uploadBtn').textContent=`🚀 Upload ${fileChapters.length} chương`;
    $('fw-uploadBtn').disabled=false;
  }catch(e){ $('filePreview').innerHTML=`<span style="color:var(--red)">${e.message}</span>`; }
}

$('fw-uploadBtn').onclick=async()=>{
  if(!fileChapters.length) return;
  const [sp,sid]=$('fw-story').value.split('|');
