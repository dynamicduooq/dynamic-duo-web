<script is:inline>
// ═══════════════════════════════════════
// CONFIG
// ═══════════════════════════════════════
const REPO   = 'dynamicduooq/dynamic-duo-web';
const BRANCH = 'main';
const ADMIN_PASSWORD = 'dynamicduo2026'; // ← Đổi mật khẩu tại đây

const STORIES = [
  { id:'qhbcp',   title:'Quan hệ bạn cùng phòng',          path:'src/pages/ca-duoi-nuoc/quan-he-ban-cung-phong', cat:'ongoing'   },
  { id:'hcdh',    title:'Hạ cháy đồng hoang',               path:'src/pages/ca-duoi-nuoc/ha-chay-dong-hoang',    cat:'ongoing'   },
  { id:'ndntkm',  title:'Nếu đêm nay trời không mưa',       path:'src/pages/ca-tren-ban/neu-dem-nay-troi-khong-mua', cat:'completed' },
  { id:'tnctsct', title:'Tôi nghĩ chúng tôi sắp chia tay', path:'src/pages/ca-tren-ban/toi-nghi-chung-toi-sap-chia-tay', cat:'completed' },
  { id:'vdv',     title:'Vật dễ vỡ',                        path:'src/pages/ca-tren-ban/vat-de-vo', cat:'upcoming' },
  { id:'tdxt',    title:'Thiếu đế xuân tâm',                path:'src/pages/ca-tren-ban/thieu-de-xuan-tam', cat:'upcoming' },
];

// ═══════════════════════════════════════
// STATE
// ═══════════════════════════════════════
let TOKEN='', currentStory=null, currentFile=null, editorMode='new';
let parsedChapters=[], fileChapters=[], confirmCb=null, fileCache={};
let checkedChaps=new Set();

// ═══════════════════════════════════════
// UTILS
// ═══════════════════════════════════════
const $=id=>document.getElementById(id);
const $$=sel=>document.querySelectorAll(sel);

function toast(msg,type='info',dur=3500){
  const el=$('toast');el.textContent=msg;el.className=`toast ${type} show`;
  clearTimeout(el._t);el._t=setTimeout(()=>el.classList.remove('show'),dur);
}

function showSection(id){
  $$('.section').forEach(s=>s.classList.remove('active'));
  $(`sec-${id}`)?.classList.add('active');
  $$('.sb-link').forEach(l=>l.classList.toggle('active',l.dataset.s===id));
}

function confirmDlg(title,msg,onOk){
  $('confirmTitle').textContent=title;
  $('confirmMsg').textContent=msg;
  $('confirmOverlay').classList.add('open');
  confirmCb=onOk;
}
$('confirmOk').onclick=()=>{ $('confirmOverlay').classList.remove('open'); confirmCb?.(); };
$('confirmCancel').onclick=()=>$('confirmOverlay').classList.remove('open');

function b64enc(str){ return btoa(unescape(encodeURIComponent(str))); }
function b64dec(str){ return decodeURIComponent(escape(atob(str))); }
function today(){ return new Date().toISOString().slice(0,10); }
function countWords(str){ return str.trim() ? str.trim().split(/\s+/).length : 0; }

// ═══════════════════════════════════════
// GITHUB API
// ═══════════════════════════════════════
async function ghFetch(ep,opts={}){
  const r=await fetch(`https://api.github.com${ep}`,{
    ...opts,
    headers:{ Authorization:`token ${TOKEN}`, 'Content-Type':'application/json', Accept:'application/vnd.github.v3+json', ...(opts.headers||{}) }
  });
  if(!r.ok){ const e=await r.json().catch(()=>({})); throw new Error(e.message||`HTTP ${r.status}`); }
  return r.json();
}

async function listDir(path){
  return ghFetch(`/repos/${REPO}/contents/${path}?ref=${BRANCH}`);
}

async function getFile(path){
  if(fileCache[path]) return fileCache[path];
  const d=await ghFetch(`/repos/${REPO}/contents/${path}?ref=${BRANCH}`);
  const decoded=b64dec(d.content.replace(/\n/g,''));
  const r={...d,decoded};
  fileCache[path]=r; return r;
}

async function putFile(path,content,msg,sha=null){
  delete fileCache[path];
  const body={ message:msg, content:b64enc(content), branch:BRANCH };
  if(sha) body.sha=sha;
  return ghFetch(`/repos/${REPO}/contents/${path}`,{ method:'PUT', body:JSON.stringify(body) });
}

async function delFile(path,sha,msg){
  delete fileCache[path];
  return ghFetch(`/repos/${REPO}/contents/${path}`,{
    method:'DELETE', body:JSON.stringify({ message:msg, sha, branch:BRANCH })
  });
}

// ═══════════════════════════════════════
// DARK MODE
// ═══════════════════════════════════════
function applyTheme(dark){
  document.documentElement.setAttribute('data-theme',dark?'dark':'');
  $('themeBtn').textContent=dark?'☀️':'🌙';
  localStorage.setItem('dd-theme',dark?'dark':'light');
}
$('themeBtn').onclick=()=>applyTheme(document.documentElement.getAttribute('data-theme')!=='dark');
(()=>{ if(localStorage.getItem('dd-theme')==='dark') applyTheme(true); })();

// ═══════════════════════════════════════
// LOGIN
// ═══════════════════════════════════════
async function doLogin(){
  const token=$('tokenInput').value.trim();
  const pass=$('passInput').value;
  const err=$('loginErr');
  err.style.display='none';
  if(pass!==ADMIN_PASSWORD){ err.textContent='Mật khẩu không đúng.'; err.style.display='block'; return; }
  if(!token){ err.textContent='Vui lòng nhập GitHub Token.'; err.style.display='block'; return; }
  const btn=$('loginBtn'); btn.innerHTML='<span class="spin"></span> Đang kiểm tra...'; btn.disabled=true;
  try{
    TOKEN=token;
    const user=await ghFetch('/user');
    $('topUser').textContent=`👤 ${user.login}`;
    $('loginScreen').style.display='none';
    $('app').style.display='block';
    loadDashboard();
  }catch(e){
    TOKEN=''; err.textContent='Token không hợp lệ.'; err.style.display='block';
  }finally{ btn.innerHTML='Đăng nhập'; btn.disabled=false; }
}
$('loginBtn').onclick=doLogin;
$('passInput').onkeydown=e=>{ if(e.key==='Enter') doLogin(); };
$('logoutBtn').onclick=()=>{
  TOKEN=''; fileCache={}; checkedChaps.clear();
  $('app').style.display='none'; $('loginScreen').style.display='flex';
  $('tokenInput').value=''; $('passInput').value='';
};

// ═══════════════════════════════════════
// SIDEBAR NAV
// ═══════════════════════════════════════
$$('.sb-link').forEach(l=>l.onclick=()=>{
  const s=l.dataset.s; showSection(s);
  if(s==='dashboard') loadDashboard();
  if(s==='ongoing'||s==='completed'||s==='upcoming') renderStorySection(s);
});

// ═══════════════════════════════════════
// DASHBOARD
// ═══════════════════════════════════════
async function loadDashboard(){
  const bycat=cat=>STORIES.filter(s=>s.cat===cat).length;
  $('stOngoing').textContent=bycat('ongoing');
  $('stDone').textContent=bycat('completed');
  $('stUpcoming').textContent=bycat('upcoming');
  let total=0;
  let html='<div style="font-size:.76rem;color:var(--text-dim);margin-bottom:10px">Chương đã đăng theo truyện:</div>';
  for(const s of STORIES){
    try{
      const files=await listDir(s.path);
      const n=files.filter(f=>f.name!=='index.md'&&f.name.endsWith('.md')).length;
      total+=n;
      html+=`<div class="story-item">
        <div class="story-item-info"><h3>${s.title}</h3><p>${n} chương · ${s.cat}</p></div>
        <div class="story-item-btns">
          <button class="btn btn-outline btn-sm" onclick="openChapList('${s.id}')">Quản lý chương</button>
        </div>
      </div>`;
    }catch(e){}
  }
  $('stChaps').textContent=total;
  $('dashRecent').innerHTML=html;
}

// ═══════════════════════════════════════
// STORY SECTIONS
// ═══════════════════════════════════════
function renderStorySection(cat){
  const stories=STORIES.filter(s=>s.cat===cat);
  const containerId=cat==='ongoing'?'ongoingList':cat==='completed'?'completedList':'upcomingList';
  document.getElementById(containerId).innerHTML=stories.map(s=>`
    <div class="story-item">
      <div class="story-item-info">
        <h3>${s.title}</h3>
        <p style="font-family:monospace;font-size:.7rem">📁 ${s.path}</p>
      </div>
      <div class="story-item-btns">
        <button class="btn btn-sky btn-sm" onclick="openChapList('${s.id}')">Danh sách chương</button>
        <button class="btn btn-outline btn-sm" onclick="openStoryMeta('${s.id}')">✎ Thông tin truyện</button>
      </div>
    </div>
  `).join('');
}

// ═══════════════════════════════════════
// CHAPTER LIST
// ═══════════════════════════════════════
window.openChapList=async function(storyId){
  currentStory=STORIES.find(s=>s.id===storyId);
  checkedChaps.clear();
  updateBulkBar();
  $('chapListTitle').textContent=currentStory.title;
  $('chapListBack').onclick=()=>showSection(currentStory.cat==='ongoing'?'ongoing':currentStory.cat==='completed'?'completed':'upcoming');
  $('addChapBtn').onclick=()=>openEditor('new');
  $('chapSearch').value='';
  showSection('chap-list');
  await renderChapTable();
};

async function renderChapTable(filter=''){
  const wrap=$('chapTableWrap');
  wrap.innerHTML='<div style="text-align:center;padding:20px;color:var(--text-dim)">Đang tải...</div>';
  try{
    const files=await listDir(currentStory.path);
    let chaps=files.filter(f=>f.name!=='index.md'&&f.name.endsWith('.md')).sort((a,b)=>a.name.localeCompare(b.name,'vi',{numeric:true}));
    if(filter) chaps=chaps.filter(f=>f.name.toLowerCase().includes(filter.toLowerCase()));
    if(!chaps.length){ wrap.innerHTML='<div style="text-align:center;padding:20px;color:var(--text-dim);font-style:italic">Chưa có chương nào.</div>'; return; }

    let tbody='';
    for(const f of chaps){
      let chapTitle=f.name, chapDate='–';
      try{
        const fd=await getFile(`${currentStory.path}/${f.name}`);
        const tm=fd.decoded.match(/^title:\s*"?([^"\n]+)"?/m);
        const dm=fd.decoded.match(/^date:\s*"?([^"\n]+)"?/m);
        if(tm) chapTitle=tm[1]; if(dm) chapDate=dm[1];
      }catch(e){}
      const m=f.name.match(/chuong-(\d+)/); const num=m?parseInt(m[1]):'?';
      const checked=checkedChaps.has(f.name)?'checked':'';
      tbody+=`<tr data-file="${f.name}" data-sha="${f.sha}">
        <td><input type="checkbox" class="chap-check chap-cb" data-fn="${f.name}" ${checked}></td>
        <td class="chap-num">${num}</td>
        <td class="chap-title-cell" title="${chapTitle}">${chapTitle}</td>
        <td class="chap-date">${chapDate}</td>
        <td class="chap-actions">
          <button class="btn btn-outline btn-sm" onclick="openEditor('edit','${f.name}')">✎ Sửa</button>
          <button class="btn btn-red btn-sm" onclick="deleteOneChap('${f.name}','${f.sha}')">🗑</button>
        </td>
      </tr>`;
    }
    wrap.innerHTML=`<table class="chap-table">
      <thead><tr><th></th><th>#</th><th>Tiêu đề</th><th>Ngày</th><th>Thao tác</th></tr></thead>
      <tbody>${tbody}</tbody>
    </table>`;

    // checkbox events
    wrap.querySelectorAll('.chap-cb').forEach(cb=>{
      cb.checked=checkedChaps.has(cb.dataset.fn);
      cb.onchange=()=>{
        if(cb.checked) checkedChaps.add(cb.dataset.fn); else checkedChaps.delete(cb.dataset.fn);
        updateBulkBar();
      };
    });
  }catch(e){ wrap.innerHTML=`<div style="color:var(--red);padding:16px">Lỗi: ${e.message}</div>`; }
}

// Select all
$('selectAllBtn').onclick=async()=>{
  const cbs=document.querySelectorAll('.chap-cb');
  const allChecked=[...cbs].every(c=>c.checked);
  cbs.forEach(cb=>{ cb.checked=!allChecked; if(!allChecked) checkedChaps.add(cb.dataset.fn); else checkedChaps.delete(cb.dataset.fn); });
  updateBulkBar();
};

// Search filter
$('chapSearch').oninput=e=>renderChapTable(e.target.value);

function updateBulkBar(){
  const n=checkedChaps.size;
  $('bulkBar').classList.toggle('show',n>0);
  $('bulkCount').textContent=`${n} đã chọn`;
  $('bulkDeleteBtn').textContent=`🗑 Xoá ${n} chương`;
}

$('bulkUnselectBtn').onclick=()=>{
  checkedChaps.clear(); updateBulkBar();
  document.querySelectorAll('.chap-cb').forEach(cb=>cb.checked=false);
};

$('bulkDeleteBtn').onclick=()=>{
  const n=checkedChaps.size;
  confirmDlg('Xoá hàng loạt',`Xoá ${n} chương? Không thể hoàn tác!`,async()=>{
    const btn=$('bulkDeleteBtn'); btn.innerHTML='<span class="spin"></span>';
    let ok=0;
    for(const fn of [...checkedChaps]){
      try{
        const fd=await getFile(`${currentStory.path}/${fn}`);
        await delFile(`${currentStory.path}/${fn}`,fd.sha,`🗑 Xoá: ${fn}`);
        ok++;
      }catch(e){}
    }
    checkedChaps.clear(); updateBulkBar();
