---
const { frontmatter } = Astro.props;
import settings from '../data/settings.json';

const currentPath = Astro.url?.pathname ?? '';
const isNovelPage = frontmatter?.chuong !== undefined && frontmatter?.chuong !== 0;
const isHome = Astro.props.isHome === true || frontmatter?.isHome === true;
const currentTruyenId = frontmatter?.truyen_id;

let chapters: any[] = [];
let prevChap: any = null;
let nextChap: any = null;

if (currentTruyenId && isNovelPage) {
  const allPosts = Object.values(import.meta.glob('../pages/**/*.md', { eager: true })) as any[];
  chapters = allPosts
    .filter((p: any) =>
      p.frontmatter?.truyen_id === currentTruyenId &&
      p.frontmatter?.chuong !== undefined &&
      p.frontmatter?.chuong !== 0
    )
    .sort((a: any, b: any) => (a.frontmatter?.chuong ?? 999) - (b.frontmatter?.chuong ?? 999));

  const normPath = (u: string) => u.replace(/\/$/, '').replace(/\/index$/, '');
  const cur = normPath(currentPath);
  const idx = chapters.findIndex((c: any) => {
    const u = normPath(c.url || '');
    return u === cur || cur.endsWith(u);
  });
  if (idx > 0) prevChap = chapters[idx - 1];
  if (idx >= 0 && idx < chapters.length - 1) nextChap = chapters[idx + 1];
}
---
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{frontmatter?.title || 'Trang chủ'} | {settings.site_name}</title>
  <meta name="description" content={frontmatter?.description || settings.tagline} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,600;1,6..72,300;1,6..72,400&family=Literata:ital,opsz,wght@0,7..72,300;0,7..72,400;0,7..72,600&family=Merriweather:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet" />

  <!-- Firebase SDK -->
  <script type="module">
    import { initializeApp }
      from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js';
    import { getDatabase, ref, push, onValue, remove, update, get }
      from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-database.js';
    import { getAuth, signInWithPopup, GoogleAuthProvider, signOut, onAuthStateChanged }
      from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js';

    const firebaseConfig = {
      apiKey: "AIzaSyBkuHIU0qdS-zNeUFGN7keNGGbAMXvilD0",
      authDomain: "dynamic-duo-comments.firebaseapp.com",
      projectId: "dynamic-duo-comments",
      storageBucket: "dynamic-duo-comments.firebasestorage.app",
      messagingSenderId: "948025586876",
      appId: "1:948025586876:web:848f38701acfdb9b844cb9",
      databaseURL: "https://dynamic-duo-comments-default-rtdb.asia-southeast1.firebasedatabase.app"
    };

    const ADMIN_EMAIL = 'dynamicduoo.q@gmail.com';
    let db = null, auth = null;
    try {
      const app = initializeApp(firebaseConfig);
      db  = getDatabase(app);
      auth = getAuth(app);
    } catch(e) { console.warn('[DD] Firebase init failed:', e.message); }

    window.__ddFirebase = { db, auth, ref, push, onValue, remove, update, get,
                            GoogleAuthProvider, signInWithPopup, signOut,
                            onAuthStateChanged, ADMIN_EMAIL };
    window.__ddIsAdmin  = false;

    if (auth) {
      onAuthStateChanged(auth, user => {
        window.__ddIsAdmin = !!(user && user.email === ADMIN_EMAIL);
        window.dispatchEvent(new CustomEvent('dd-auth-change',
          { detail: { isAdmin: window.__ddIsAdmin, user } }));
      });
    }
    window.dispatchEvent(new Event('dd-firebase-ready'));
  </script>

  <script is:inline>
    (function(){
      const t = localStorage.getItem('dd-theme');
      if (t === 'dark') document.documentElement.setAttribute('data-theme','dark');
    })();
  </script>

  <style is:global>
    /* ── VARIABLES ── */
    :root {
      --sky:#0ea5e9; --sky2:#0284c7; --sky-dark:#0369a1;
      --sky-light:#bae6fd; --sky-pale:#f0f9ff;
      --cream:#fafcff;
      --text-main:#1e3a5f; --text-mid:#64748b; --text-dim:#94a3b8;
      --sh-card:0 4px 15px rgba(2,132,199,.12);
      --sh-soft:0 2px 8px rgba(0,0,0,.08);
      --r-sm:6px; --r-md:12px; --r-lg:20px; --r-pill:999px;
      --t:all .2s ease;
      /* CSS Variables dùng cho phần cài đặt đọc truyện */
      --read-fz: 18px;
      --read-ff: 'Newsreader', serif;
      /* card bg cho light */
      --bg-card:#ffffff;
      --bg-card2:#f0f9ff;
      --border-card:rgba(186,230,253,.5);
    }

    /* ── DARK THEME — xanh đậm navy thực sự ── */
    [data-theme="dark"] {
      --sky:#7ec8e3; --sky2:#a8daf0; --sky-dark:#c5e8f5;
      --sky-light:#1e4a6a; --sky-pale:#0d2035;
      --cream:#0a1929;
      --text-main:#F3F9FF; --text-mid:#8fbcd4; --text-dim:#527a96;
      --bg-card:#0f2336;
      --bg-card2:#0d2035;
      --border-card:rgba(126,200,227,.15);
    }
    [data-theme="dark"] body          { background:#0a1929; color:#F3F9FF; }
    [data-theme="dark"] nav           { background:rgba(8,18,32,.98); border-color:rgba(126,200,227,.15); }
    [data-theme="dark"] .mobile-menu  { background:rgba(8,18,32,.99); border-color:rgba(126,200,227,.18); }
    [data-theme="dark"] .dropdown-content { background:#0f2336; border-color:rgba(126,200,227,.2); }
    [data-theme="dark"] .dd-item      { color:#8fbcd4; }
    [data-theme="dark"] .dd-item:hover { background:rgba(126,200,227,.1); color:#F3F9FF; }
    [data-theme="dark"] .nav-item > a { color:#8fbcd4; }
    [data-theme="dark"] .nav-item > a:hover,
    [data-theme="dark"] .nav-btn:hover,
    [data-theme="dark"] .nav-item:hover > a,
    [data-theme="dark"] .nav-item:hover > .nav-btn { color:#7ec8e3; background:rgba(126,200,227,.1); }
    [data-theme="dark"] .nav-logo     { color:#a8daf0; }
    [data-theme="dark"] .nav-btn      { color:#8fbcd4; }
    [data-theme="dark"] .dd-section-title { color:#3d6a82; }
    [data-theme="dark"] .nav-hamburger span { background:#a8daf0; }

    /* Novel content & wrappers */
    [data-theme="dark"] .novel-content,
    [data-theme="dark"] .page-content-wrap {
      background:#0f2336 !important;
      border-color:rgba(126,200,227,.14);
      color:#d8eeff;
    }
    [data-theme="dark"] .novel-content p { color:#d8eeff; }
    [data-theme="dark"] h1,[data-theme="dark"] h2,
    [data-theme="dark"] h3,[data-theme="dark"] h4 { color:#a8daf0; }
    [data-theme="dark"] blockquote    { background:rgba(15,35,54,.9); color:#8fbcd4; border-left-color:#1e4a6a; }
    [data-theme="dark"] .chap-pn      { border-color:#1e4a6a; color:#8fbcd4; background:#0d2035; }
    [data-theme="dark"] .chap-pn:hover { background:rgba(126,200,227,.1); color:#F3F9FF; border-color:#7ec8e3; }
    [data-theme="dark"] .chap-dd-btn  { background:#0d2035; border-color:#1e4a6a; color:#8fbcd4; }
    [data-theme="dark"] .chap-dd-list { background:#0f2336; border-color:#1e4a6a; }
    [data-theme="dark"] .chap-dd-list a { color:#8fbcd4; border-color:rgba(126,200,227,.1); }
    [data-theme="dark"] .chap-dd-list a:hover { background:rgba(126,200,227,.1); color:#F3F9FF; }
    [data-theme="dark"] .chap-dd-list a.cur-chap { background:rgba(126,200,227,.15); color:#a8daf0; font-weight:700; }
    [data-theme="dark"] footer        { background:#0f2336; border-color:rgba(126,200,227,.1); color:#8fbcd4; }
    [data-theme="dark"] .ft-logo      { color:#a8daf0; }
    [data-theme="dark"] .ft-links a   { color:#8fbcd4; }
    [data-theme="dark"] .ft-links a:hover { color:#a8daf0; }
    [data-theme="dark"] .ft-bottom    { color:#3d6a82; }
    [data-theme="dark"] .ft-brand p   { color:#527a96; }
    [data-theme="dark"] .social-ic    { background:rgba(15,35,54,.8); border-color:#1e4a6a; }
    [data-theme="dark"] .tag-badge    { color:#a8daf0; border-color:#1e4a6a; }
    [data-theme="dark"] .tag-badge:hover { background:rgba(126,200,227,.1); }
    [data-theme="dark"] .scroll-btn   { background:#163552; }
    [data-theme="dark"] .scroll-btn:hover { background:#1e4a6a; }
    .contact-email { color:#475569; }
    [data-theme="dark"] .contact-email { color:#8fbcd4; }

    /* Comment section dark */
    [data-theme="dark"] .comment-form { background:#0f2336 !important; border-color:rgba(126,200,227,.16) !important; }
    [data-theme="dark"] .comment-card { background:#0f2336 !important; border-color:rgba(126,200,227,.14) !important; }
    [data-theme="dark"] .reply-item   { background:rgba(15,45,72,.6) !important; }
    [data-theme="dark"] .admin-bar    { background:rgba(15,70,115,.12); border-color:rgba(126,200,227,.18); color:#527a96; }
    [data-theme="dark"] .ic-sidebar   { background:#0f2336 !important; border-color:rgba(126,200,227,.14); }
    [data-theme="dark"] .ic-item      { background:rgba(15,45,72,.5) !important; border-color:rgba(126,200,227,.13); }
    [data-theme="dark"] .ic-reply-item { background:rgba(15,45,72,.6) !important; }

    *, *::before, *::after { box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { background:var(--cream); color:var(--text-main); font-family:var(--read-ff, 'Newsreader', serif); font-size:var(--read-fz, 18px); line-height:1.9; margin:0; padding:0; overflow-x:hidden; transition: font-size 0.2s, font-family 0.2s; }
    h1,h2,h3,h4 { font-family:'Merriweather',serif; color:var(--sky-dark); text-align:center; }
    a { color:inherit; text-decoration:none; }
    ::-webkit-scrollbar { width:5px; }
    ::-webkit-scrollbar-track { background:var(--sky-pale); }
    ::-webkit-scrollbar-thumb { background:var(--sky-light); border-radius:3px; }

    /* ── PROGRESS ── */
    #read-progress { position:fixed; top:0; left:0; height:3px; z-index:9999; background:linear-gradient(90deg,var(--sky-light),var(--sky),var(--sky2)); width:0%; transition:width .1s linear; pointer-events:none; }

    /* ── NAVBAR ── */
    /* ĐÃ SỬA: Bỏ justify-content: space-between để Logo đẩy Menu sang phải */
    nav { position:fixed; top:0; left:0; right:0; z-index:500; display:flex; align-items:center; height:56px; padding:0 28px; background:rgba(255,255,255,.97); backdrop-filter:blur(16px); border-bottom:1px solid rgba(186,230,253,.5); box-shadow:0 2px 12px rgba(2,132,199,.08); }
    .nav-logo { font-family:'Literata',serif; font-weight:600; font-size:.95rem; color:var(--sky-dark); white-space:nowrap; letter-spacing:.5px; margin-right: auto; } /* margin-right: auto sẽ ép Menu sang lề phải */
    .nav-links { display:flex; align-items:center; gap:2px; margin-right: 12px; }
    .nav-item { position:relative; }
    .nav-item > a, .nav-btn { font-family:'Newsreader',serif; font-size:.76rem; color:var(--text-mid); letter-spacing:1px; text-transform:uppercase; padding:6px 12px; border-radius:var(--r-pill); display:inline-flex; align-items:center; gap:5px; transition:var(--t); cursor:pointer; background:none; border:none; white-space:nowrap; }
    .nav-item > a:hover,.nav-btn:hover,.nav-item:hover > a,.nav-item:hover > .nav-btn { background:var(--sky-pale); color:var(--sky); }
    .dropdown-content { position:absolute; top:calc(100% + 8px); left:50%; transform:translateX(-50%) translateY(8px); min-width:240px; background:#fff; border:1px solid rgba(186,230,253,.7); border-radius:var(--r-md); box-shadow:0 16px 48px rgba(2,132,199,.13); padding:8px 6px; opacity:0; visibility:hidden; pointer-events:none; transition:opacity .22s ease,transform .22s ease; z-index:600; }
    .nav-item:hover .dropdown-content { opacity:1; visibility:visible; pointer-events:auto; transform:translateX(-50%) translateY(0); }
    .dd-section-title { font-size:.62rem; letter-spacing:2px; text-transform:uppercase; color:var(--text-dim); padding:6px 12px 3px; }
    .dd-item { display:flex; align-items:center; gap:7px; padding:7px 12px; font-size:.82rem; color:var(--text-mid); border-radius:var(--r-sm); transition:var(--t); }
    .dd-item:hover { background:var(--sky-pale); color:var(--sky); }
    .dd-divider { height:1px; background:rgba(186,230,253,.45); margin:5px 8px; }

    /* ── THEME BUTTON ── */
    .nav-theme-btn {
      font-size:.8rem; width:32px; height:32px; border-radius:50%;
      border:1px solid rgba(186,230,253,.6); background:none;
      color:var(--text-mid); cursor:pointer; transition:var(--t);
      display:inline-flex; align-items:center; justify-content:center;
      flex-shrink:0;
    }
    .nav-theme-btn:hover { background:var(--sky-pale); color:var(--sky); }
    [data-theme="dark"] .nav-theme-btn { border-color:rgba(126,200,227,.25); color:#8fbcd4; }
    [data-theme="dark"] .nav-theme-btn:hover { background:rgba(126,200,227,.1); color:#F3F9FF; }

    .nav-hamburger { display:none; flex-direction:column; gap:5px; cursor:pointer; padding:6px; background:none; border:none; }
    .nav-hamburger span { display:block; width:22px; height:2px; background:var(--sky-dark); border-radius:2px; transition:var(--t); }
    .mobile-menu { display:none; position:fixed; top:56px; left:0; right:0; background:rgba(255,255,255,.99); backdrop-filter:blur(16px); border-bottom:1px solid rgba(186,230,253,.5); padding:10px 16px 18px; z-index:490; flex-direction:column; gap:2px; max-height:calc(100vh - 56px); overflow-y:auto; }
    .mobile-menu.open { display:flex; }
    .mobile-menu a { padding:9px 12px; font-size:.88rem; color:var(--text-mid); border-radius:var(--r-sm); display:block; transition:var(--t); }
    .mobile-menu a:hover { background:var(--sky-pale); color:var(--sky); }
    [data-theme="dark"] .mobile-menu a { color:#8fbcd4; }
    [data-theme="dark"] .mobile-menu a:hover { background:rgba(126,200,227,.1); color:#a8daf0; }
    .mobile-section-title { font-size:.65rem; letter-spacing:2px; text-transform:uppercase; color:var(--text-dim); padding:10px 12px 3px; }
    [data-theme="dark"] .mobile-section-title { color:#3d6a82; }
    /* Mobile theme toggle row */
    .mobile-theme-row {
      display:flex; align-items:center; gap:8px;
      padding:9px 12px; font-size:.88rem; color:var(--text-mid);
      cursor:pointer; border-radius:var(--r-sm); transition:var(--t);
      background:none; border:none; width:100%; text-align:left;
      font-family:'Newsreader',serif;
    }
    .mobile-theme-row:hover { background:var(--sky-pale); color:var(--sky); }
    [data-theme="dark"] .mobile-theme-row { color:#8fbcd4; }
    [data-theme="dark"] .mobile-theme-row:hover { background:rgba(126,200,227,.1); color:#a8daf0; }
    @media(max-width:700px){ .nav-links{display:none;} .nav-hamburger{display:flex;} }

    /* ── LAYOUT ── */
    .page-wrapper { margin-top:56px; min-height:70vh; }
    .page-content-wrap { max-width:820px; margin:32px auto 60px; padding:40px 50px; background:rgba(255,255,255,.98); border-radius:var(--r-lg); box-shadow:var(--sh-soft); border:1px solid rgba(186,230,253,.5); }
    @media(max-width:640px){ .page-content-wrap{ padding:24px 18px; margin:16px 12px 40px; } }

    /* ── CHAP NAV ── */
    .chap-nav-row { display:flex; align-items:center; justify-content:center; gap:10px; padding:14px 20px; flex-wrap:wrap; max-width:900px; margin:0 auto; }
    .chap-pn { display:inline-flex; align-items:center; gap:5px; padding:6px 16px; border-radius:var(--r-pill); border:1px solid var(--sky-light); font-size:.78rem; color:var(--sky-dark); transition:var(--t); white-space:nowrap; background:rgba(255,255,255,.9); }
    .chap-pn:hover { background:var(--sky-pale); border-color:var(--sky); }
    .chap-pn.disabled { opacity:.4; pointer-events:none; }

    /* ── CHAPTER DROPDOWN ── */
    .chap-dd-wrap { position:relative; }
    .chap-dd-btn { display:inline-flex; align-items:center; gap:5px; padding:6px 14px; border-radius:var(--r-pill); border:1px solid var(--sky-light); font-size:.76rem; color:var(--sky-dark); cursor:pointer; font-family:'Newsreader',serif; background:rgba(255,255,255,.9); transition:var(--t); white-space:nowrap; }
    .chap-dd-btn:hover { background:var(--sky-pale); border-color:var(--sky); }
    .chap-dd-list { position:absolute; top:calc(100% + 6px); left:50%; transform:translateX(-50%); z-index:700; width:220px; max-height:280px; overflow-y:auto; overflow-x:hidden; background:#fff; border:1px solid rgba(186,230,253,.7); border-radius:var(--r-md); box-shadow:0 16px 48px rgba(2,132,199,.15); padding:4px; display:none; scrollbar-width:thin; scrollbar-color:var(--sky-light) transparent; }
    .chap-dd-list::-webkit-scrollbar { width:3px; }
    .chap-dd-list::-webkit-scrollbar-thumb { background:var(--sky-light); border-radius:3px; }
    .chap-dd-list.open { display:block; }
    .chap-dd-list.up { top:auto; bottom:calc(100% + 6px); }
    .chap-dd-list a { display:block; padding:6px 12px; font-size:.76rem; color:var(--text-mid); border-radius:var(--r-sm); transition:var(--t); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; border-bottom:1px solid rgba(186,230,253,.2); }
    .chap-dd-list a:last-child { border-bottom:none; }
    .chap-dd-list a:hover { background:var(--sky-pale); color:var(--sky); }
    .chap-dd-list a.cur-chap { background:rgba(14,165,233,.1); color:var(--sky-dark); font-weight:700; }

    /* ── NOVEL LAYOUT ── */
    .novel-layout-wrap { max-width:800px; margin:0 auto; padding:0 16px; position:relative; }
    .novel-content { max-width:760px; margin:24px auto 60px; padding:40px 50px; background:rgba(255,255,255,.98); border-radius:var(--r-lg); box-shadow:var(--sh-soft); border:1px solid rgba(186,230,253,.5); position:relative; }
    @media(max-width:640px){ .novel-content{ padding:24px 18px; margin:16px 12px 40px; } }
    .novel-content p { text-align:justify; text-justify:inter-word; position:relative; margin-bottom:1.1em; display:block; }
    blockquote { font-style:italic; font-size:.9rem; color:var(--text-mid); line-height:1.75; border-left:3px solid var(--sky-light); padding:15px 20px; margin:20px 0; background:var(--sky-pale); border-radius:0 12px 12px 0; }
    hr { border:none; text-align:center; margin:40px 0; }
    hr::after { content:"𓆝 𓆟 𓆞 𓆝 𓆟"; color:var(--sky-light); font-size:20px; letter-spacing:5px; }

    /* ── INLINE COMMENT SIDEBAR ── */
    .ic-sidebar { position:fixed; top:56px; right:0; bottom:0; width:300px; display:flex; flex-direction:column; background:#fff; border-left:1px solid rgba(186,230,253,.5); border-radius:var(--r-lg) 0 0 var(--r-lg); box-shadow:-8px 0 40px rgba(2,132,199,.18); opacity:0; pointer-events:none; transform:translateX(100%); transition:opacity .25s ease,transform .25s ease; z-index:460; overflow:hidden; }
    .novel-layout-wrap.sidebar-open .ic-sidebar { opacity:1; pointer-events:auto; transform:translateX(0); }
    .ic-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,.4); z-index:450; backdrop-filter:blur(1px); }
    .ic-overlay.show { display:block; }
    @media(max-width:600px){ .ic-sidebar { width:min(300px,88vw); } }

    .ic-sidebar-inner { display:flex; flex-direction:column; height:100%; overflow:hidden; }
    .ic-sidebar-header { display:flex; align-items:flex-start; gap:8px; padding:14px 14px 10px; border-bottom:1px solid rgba(186,230,253,.4); flex-shrink:0; }
    [data-theme="dark"] .ic-sidebar-header { border-color:rgba(126,200,227,.13); }
    .ic-para-preview { flex:1; font-size:.68rem; color:var(--text-dim); font-style:italic; line-height:1.5; max-height:3.5em; overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; }
    .ic-sidebar-close { flex-shrink:0; width:24px; height:24px; border-radius:50%; border:1px solid rgba(186,230,253,.5); background:none; cursor:pointer; font-size:.62rem; color:var(--text-dim); display:flex; align-items:center; justify-content:center; transition:var(--t); }
    .ic-sidebar-close:hover { background:var(--sky-pale); color:var(--sky); }
    [data-theme="dark"] .ic-sidebar-close { border-color:rgba(126,200,227,.18); color:#527a96; }
    .ic-sidebar-form { padding:10px 12px; border-bottom:1px solid rgba(186,230,253,.3); flex-shrink:0; display:flex; flex-direction:column; gap:6px; }
    [data-theme="dark"] .ic-sidebar-form { border-color:rgba(126,200,227,.1); }
    .ic-form-name { width:100%; padding:5px 10px; border:1.5px solid var(--sky-light); border-radius:var(--r-pill); font-size:.72rem; font-family:'Newsreader',serif; color:var(--text-main); background:var(--cream); outline:none; }
    .ic-form-name:focus { border-color:var(--sky); }
    [data-theme="dark"] .ic-form-name { background:#091620; border-color:#1e4a6a; color:#F3F9FF; }
    [data-theme="dark"] .ic-form-name::placeholder { color:#3d6a82; }
    .ic-form-body { display:flex; gap:6px; align-items:flex-end; }
    .ic-form-text { flex:1; padding:7px 10px; border:1.5px solid var(--sky-light); border-radius:10px; font-size:.74rem; font-family:'Newsreader',serif; color:var(--text-main); background:var(--cream); outline:none; resize:none; min-height:48px; }
    .ic-form-text:focus { border-color:var(--sky); }
