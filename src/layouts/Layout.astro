          </div>
        )}
      </div>     
      
      <div class="chap-like-area">
        <button class="chap-like-btn" id="btnLikeChapter">
          <span class="heart">🤍</span> Yêu thích chương này <span class="count" id="chapLikeCount" style="font-weight:bold;margin-left:4px">0</span>
        </button>
      </div>

      <aside class="ic-sidebar" id="icSidebar">
        <div class="ic-sidebar-inner">
          <div class="ic-sidebar-header">
            <div class="ic-para-preview" id="icParaPreview"></div>
            <button class="ic-sidebar-close" id="icSidebarClose" aria-label="Đóng">✕</button>
          </div>
          <div class="ic-sidebar-form">
            <div class="ic-quoting-bar" id="icQuotingBar">
              <span class="ic-quoting-label" id="icQuotingLabel"></span>
              <button class="ic-quoting-cancel" id="icQuotingCancel">✕</button>
            </div>
            <input class="ic-form-name" id="icFormName" placeholder="Tên của bạn (tùy chọn)" autocomplete="off" />
            <div class="ic-form-body">
              <textarea class="ic-form-text" id="icFormText" placeholder="Viết bình luận..." rows="2"></textarea>
              <button class="ic-form-send" id="icFormSend">↑</button>
            </div>
          </div>
          <div class="ic-sidebar-list" id="icSidebarList">
            <div class="ic-empty">Chọn một đoạn để xem bình luận 🌊</div>
          </div>
        </div>
      </aside>
    </div>
  ) : isHome ? (
    <slot />
  ) : (
    <div class="page-content-wrap"><slot /></div>
  )}

{isNovelPage && (
    <div class="chap-nav-container" style="margin-top:36px;">
      <div class="nav-controls-row">
        {prevChap
          ? <a href={prevChap.url} class="chap-pn">← Trước</a>
          : <span class="chap-pn disabled">← Trước</span>}

        {chapters.length > 1 && (
          <div class="chap-dd-wrap" id="ddBot">
            <button class="chap-dd-btn" id="ddBtnBot">⚓ Chương ▾</button>
            <div class="chap-dd-list up" id="ddListBot">
              {chapters.map((c: any) => (
                <a href={c.url} class={c.frontmatter?.chuong === frontmatter?.chuong ? 'cur-chap' : ''}>
                  {c.frontmatter?.title || `Chương ${c.frontmatter?.chuong}`}
                </a>
              ))}
            </div>
          </div>
        )}

        {nextChap
          ? <a href={nextChap.url} class="chap-pn">Sau →</a>
          : <span class="chap-pn disabled">Sau →</span>}
      </div>
    </div>
  )}

  {isNovelPage && (
    <div class="chap-comment-section" id="chapCommentSection">
      <div class="chap-comment-title">💬 Bình luận chương</div>
      <div class="admin-bar" id="adminBar" style="display:none">
        <span id="adminStatus"></span>
        <button class="admin-login-btn" id="adminLoginBtn">Đăng nhập Google</button>
      </div>
      <div class="comment-form">
        <div class="comment-form-row">
          <input class="comment-inp" id="cmtName" placeholder="Tên của bạn (tùy chọn)" style="max-width:220px" autocomplete="off" />
        </div>
        <textarea class="comment-textarea" id="cmtText" placeholder="Chia sẻ cảm nhận về chương này... 🌊"></textarea>
        <button class="comment-submit-btn" id="cmtSubmit">Gửi bình luận ✦</button>
      </div>
      <div id="cmtList" class="comment-list">
        <div class="comment-loading">Đang tải bình luận...</div>
      </div>
    </div>
  )}
</div>

<footer>
  <div class="footer-inner">
    <div class="ft-brand">
      <span class="ft-logo">dynamic duo 𓆝.°•</span>
      <p>paired dreams, boundless gleam.</p>
