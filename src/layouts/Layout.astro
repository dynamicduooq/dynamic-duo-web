---
const { frontmatter } = Astro.props;
import settings from '../data/settings.json';

const currentPath = Astro.url?.pathname ?? '';
const isNovelPage = frontmatter?.chuong !== undefined && frontmatter?.chuong !== 0;
const isHome = Astro.props.isHome === true || frontmatter?.isHome === true;
const currentTruyenId = frontmatter?.truyen_id;

let chapters: any[] = [];
let prevChap: any = null;
let nextChap: any = null;

if (currentTruyenId && isNovelPage) {
  const allPosts = Object.values(import.meta.glob('../pages/**/*.md', { eager: true })) as any[];
  chapters = allPosts
    .filter((p: any) =>
      p.frontmatter?.truyen_id === currentTruyenId &&
      p.frontmatter?.chuong !== undefined &&
      p.frontmatter?.chuong !== 0
    )
    .sort((a: any, b: any) => (a.frontmatter?.chuong ?? 999) - (b.frontmatter?.chuong ?? 999));

  const normPath = (u: string) => u.replace(/\/$/, '').replace(/\/index$/, '');
  const cur = normPath(currentPath);
  const idx = chapters.findIndex((c: any) => {
    const u = normPath(c.url || '');
    return u === cur || cur.endsWith(u);
  });
  if (idx > 0) prevChap = chapters[idx - 1];
  if (idx >= 0 && idx < chapters.length - 1) nextChap = chapters[idx + 1];
}
---
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{frontmatter?.title || 'Trang chủ'} | {settings.site_name}</title>
  <meta name="description" content={frontmatter?.description || settings.tagline} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,600;1,6..72,300;1,6..72,400&family=Literata:ital,opsz,wght@0,7..72,300;0,7..72,400;0,7..72,600&family=Merriweather:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet" />

  <!-- Firebase SDK -->
  <script type="module">
    import { initializeApp }
      from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js';
    import { getDatabase, ref, push, onValue, remove, update, get }
      from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-database.js';
    import { getAuth, signInWithPopup, GoogleAuthProvider, signOut, onAuthStateChanged }
      from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js';

    const firebaseConfig = {
      apiKey: "AIzaSyBkuHIU0qdS-zNeUFGN7keNGGbAMXvilD0",
      authDomain: "dynamic-duo-comments.firebaseapp.com",
      projectId: "dynamic-duo-comments",
      storageBucket: "dynamic-duo-comments.firebasestorage.app",
      messagingSenderId: "948025586876",
      appId: "1:948025586876:web:848f38701acfdb9b844cb9",
      databaseURL: "https://dynamic-duo-comments-default-rtdb.asia-southeast1.firebasedatabase.app"
    };

    const ADMIN_EMAIL = 'dynamicduoo.q@gmail.com';
    let db = null, auth = null;
    try {
      const app = initializeApp(firebaseConfig);
      db  = getDatabase(app);
      auth = getAuth(app);
    } catch(e) { console.warn('[DD] Firebase init failed:', e.message); }

    window.__ddFirebase = { db, auth, ref, push, onValue, remove, update, get,
                            GoogleAuthProvider, signInWithPopup, signOut,
                            onAuthStateChanged, ADMIN_EMAIL };
    window.__ddIsAdmin  = false;

    if (auth) {
      onAuthStateChanged(auth, user => {
        window.__ddIsAdmin = !!(user && user.email === ADMIN_EMAIL);
        window.dispatchEvent(new CustomEvent('dd-auth-change',
          { detail: { isAdmin: window.__ddIsAdmin, user } }));
      });
    }
    window.dispatchEvent(new Event('dd-firebase-ready'));
  </script>

  <script is:inline>
    (function(){
      const t = localStorage.getItem('dd-theme');
      if (t === 'dark') document.documentElement.setAttribute('data-theme','dark');
    })();
  </script>

  <style is:global>
    /* ── VARIABLES ── */
    :root {
      --sky:#0ea5e9; --sky2:#0284c7; --sky-dark:#0369a1;
      --sky-light:#bae6fd; --sky-pale:#f0f9ff;
      --cream:#fafcff;
      --text-main:#1e3a5f; --text-mid:#64748b; --text-dim:#94a3b8;
      --sh-card:0 4px 15px rgba(2,132,199,.12);
      --sh-soft:0 2px 8px rgba(0,0,0,.08);
      --r-sm:6px; --r-md:12px; --r-lg:20px; --r-pill:999px;
      --t:all .2s ease;
    }
    /* ── FIX 3: Dark theme - tất cả bg block dùng màu tối thực sự ── */
    [data-theme="dark"] {
      --sky:#60b8e8; --sky2:#89d0f5; --sky-dark:#c8e8f8;
      --sky-light:#1e5a7a; --sky-pale:#0c1e30;
      --cream:#091726;
      --text-main:#daeeff; --text-mid:#a0c8e0; --text-dim:#6a9ab5;
      /* Override white backgrounds globally */
      --bg-card:#0e2236;
      --bg-card2:#0c1e30;
      --border-card:rgba(96,184,232,.18);
    }
    [data-theme="dark"] body          { background:#091726; color:#daeeff; }
    [data-theme="dark"] nav           { background:rgba(9,23,38,.98); border-color:rgba(96,184,232,.18); }
    [data-theme="dark"] .mobile-menu  { background:rgba(9,23,38,.99); border-color:rgba(96,184,232,.2); }
    [data-theme="dark"] .dropdown-content { background:#0e2236; border-color:rgba(96,184,232,.22); }
    [data-theme="dark"] .dd-item      { color:#a0c8e0; }
    [data-theme="dark"] .dd-item:hover { background:rgba(96,184,232,.1); color:#daeeff; }
    [data-theme="dark"] .nav-item > a { color:#a0c8e0; }
    [data-theme="dark"] .nav-item > a:hover,
    [data-theme="dark"] .nav-btn:hover,
    [data-theme="dark"] .nav-item:hover > a,
    [data-theme="dark"] .nav-item:hover > .nav-btn { color:#60b8e8; background:rgba(96,184,232,.1); }
    [data-theme="dark"] .nav-logo     { color:#89d0f5; }
    [data-theme="dark"] .nav-btn      { color:#a0c8e0; }
    [data-theme="dark"] .dd-section-title { color:#4a7a96; }

    /* Novel content & page wrappers */
    [data-theme="dark"] .novel-content,
    [data-theme="dark"] .page-content-wrap {
      background:#0e2236 !important;
      border-color:rgba(96,184,232,.16);
      color:#daeeff;
    }
    [data-theme="dark"] .novel-content p { color:#cce4f8; }
    [data-theme="dark"] h1,[data-theme="dark"] h2,
    [data-theme="dark"] h3,[data-theme="dark"] h4 { color:#89d0f5; }
    [data-theme="dark"] blockquote    { background:rgba(14,36,58,.9); color:#a0c8e0; border-left-color:#1e5a7a; }
    [data-theme="dark"] .chap-pn      { border-color:#1e5a7a; color:#a0c8e0; background:#0c1e30; }
    [data-theme="dark"] .chap-pn:hover { background:rgba(96,184,232,.1); color:#daeeff; border-color:#60b8e8; }
    [data-theme="dark"] .chap-dd-btn  { background:#0c1e30; border-color:#1e5a7a; color:#a0c8e0; }
    [data-theme="dark"] .chap-dd-list { background:#0e2236; border-color:#1e5a7a; }
    [data-theme="dark"] .chap-dd-list a { color:#a0c8e0; border-color:rgba(96,184,232,.12); }
    [data-theme="dark"] .chap-dd-list a:hover { background:rgba(96,184,232,.1); color:#daeeff; }
    [data-theme="dark"] .chap-dd-list a.cur-chap { background:rgba(96,184,232,.15); color:#89d0f5; font-weight:700; }
    [data-theme="dark"] footer        { background:#0e2236; border-color:rgba(96,184,232,.12); color:#a0c8e0; }
    [data-theme="dark"] .ft-logo      { color:#89d0f5; }
    [data-theme="dark"] .ft-links a   { color:#a0c8e0; }
    [data-theme="dark"] .ft-links a:hover { color:#89d0f5; }
    [data-theme="dark"] .ft-bottom    { color:#4a7a96; }
    [data-theme="dark"] .ft-brand p   { color:#6a9ab5; }
    [data-theme="dark"] .social-ic    { background:rgba(14,36,58,.8); border-color:#1e5a7a; }
    [data-theme="dark"] .tag-badge    { color:#89d0f5; border-color:#1e5a7a; }
    [data-theme="dark"] .tag-badge:hover { background:rgba(96,184,232,.1); }
    [data-theme="dark"] .scroll-btn   { background:#1a4f6e; }
    [data-theme="dark"] .scroll-btn:hover { background:#215f84; }
    .contact-email { color:#475569; }
    [data-theme="dark"] .contact-email { color:#a0c8e0; }

    /* ── FIX 3: Comment section dark backgrounds ── */
    [data-theme="dark"] .comment-form { background:#0e2236 !important; border-color:rgba(96,184,232,.18) !important; }
    [data-theme="dark"] .comment-card { background:#0e2236 !important; border-color:rgba(96,184,232,.16) !important; }
    [data-theme="dark"] .reply-item   { background:rgba(21,50,80,.6) !important; }
    [data-theme="dark"] .admin-bar    { background:rgba(21,101,160,.12); border-color:rgba(96,184,232,.2); color:#6a9ab5; }
    [data-theme="dark"] .ic-sidebar   { background:#0e2236 !important; border-color:rgba(96,184,232,.16); }
    [data-theme="dark"] .ic-item      { background:rgba(21,50,80,.5) !important; border-color:rgba(96,184,232,.15); }
    [data-theme="dark"] .ic-reply-item { background:rgba(21,50,80,.6) !important; }

    *, *::before, *::after { box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { background:var(--cream); color:var(--text-main); font-family:'Newsreader',serif; font-size:18px; line-height:1.9; margin:0; padding:0; overflow-x:hidden; }
    h1,h2,h3,h4 { font-family:'Merriweather',serif; color:var(--sky-dark); text-align:center; }
    a { color:inherit; text-decoration:none; }
    ::-webkit-scrollbar { width:5px; }
    ::-webkit-scrollbar-track { background:var(--sky-pale); }
    ::-webkit-scrollbar-thumb { background:var(--sky-light); border-radius:3px; }

    /* ── PROGRESS ── */
    #read-progress { position:fixed; top:0; left:0; height:3px; z-index:9999; background:linear-gradient(90deg,var(--sky-light),var(--sky),var(--sky2)); width:0%; transition:width .1s linear; pointer-events:none; }

    /* ── NAVBAR ── */
    nav { position:fixed; top:0; left:0; right:0; z-index:500; display:flex; align-items:center; justify-content:space-between; height:56px; padding:0 28px; background:rgba(255,255,255,.97); backdrop-filter:blur(16px); border-bottom:1px solid rgba(186,230,253,.5); box-shadow:0 2px 12px rgba(2,132,199,.08); }
    .nav-logo { font-family:'Literata',serif; font-weight:600; font-size:.95rem; color:var(--sky-dark); white-space:nowrap; letter-spacing:.5px; }
    .nav-links { display:flex; align-items:center; gap:2px; }
    .nav-item { position:relative; }
    .nav-item > a, .nav-btn { font-family:'Newsreader',serif; font-size:.76rem; color:var(--text-mid); letter-spacing:1px; text-transform:uppercase; padding:6px 12px; border-radius:var(--r-pill); display:inline-flex; align-items:center; gap:5px; transition:var(--t); cursor:pointer; background:none; border:none; white-space:nowrap; }
    .nav-item > a:hover,.nav-btn:hover,.nav-item:hover > a,.nav-item:hover > .nav-btn { background:var(--sky-pale); color:var(--sky); }
    .dropdown-content { position:absolute; top:calc(100% + 8px); left:50%; transform:translateX(-50%) translateY(8px); min-width:240px; background:#fff; border:1px solid rgba(186,230,253,.7); border-radius:var(--r-md); box-shadow:0 16px 48px rgba(2,132,199,.13); padding:8px 6px; opacity:0; visibility:hidden; pointer-events:none; transition:opacity .22s ease,transform .22s ease; z-index:600; }
    .nav-item:hover .dropdown-content { opacity:1; visibility:visible; pointer-events:auto; transform:translateX(-50%) translateY(0); }
    .dd-section-title { font-size:.62rem; letter-spacing:2px; text-transform:uppercase; color:var(--text-dim); padding:6px 12px 3px; }
    .dd-item { display:flex; align-items:center; gap:7px; padding:7px 12px; font-size:.82rem; color:var(--text-mid); border-radius:var(--r-sm); transition:var(--t); }
    .dd-item:hover { background:var(--sky-pale); color:var(--sky); }
    .dd-divider { height:1px; background:rgba(186,230,253,.45); margin:5px 8px; }
    .nav-hamburger { display:none; flex-direction:column; gap:5px; cursor:pointer; padding:6px; background:none; border:none; }
    .nav-hamburger span { display:block; width:22px; height:2px; background:var(--sky-dark); border-radius:2px; transition:var(--t); }
    [data-theme="dark"] .nav-hamburger span { background:#89d0f5; }
    .mobile-menu { display:none; position:fixed; top:56px; left:0; right:0; background:rgba(255,255,255,.99); backdrop-filter:blur(16px); border-bottom:1px solid rgba(186,230,253,.5); padding:10px 16px 18px; z-index:490; flex-direction:column; gap:2px; max-height:calc(100vh - 56px); overflow-y:auto; }
    .mobile-menu.open { display:flex; }
    .mobile-menu a { padding:9px 12px; font-size:.88rem; color:var(--text-mid); border-radius:var(--r-sm); display:block; transition:var(--t); }
    .mobile-menu a:hover { background:var(--sky-pale); color:var(--sky); }
    [data-theme="dark"] .mobile-menu a { color:#a0c8e0; }
    [data-theme="dark"] .mobile-menu a:hover { background:rgba(96,184,232,.1); color:#89d0f5; }
    .mobile-section-title { font-size:.65rem; letter-spacing:2px; text-transform:uppercase; color:var(--text-dim); padding:10px 12px 3px; }
    [data-theme="dark"] .mobile-section-title { color:#4a7a96; }
    @media(max-width:700px){ .nav-links{display:none;} .nav-hamburger{display:flex;} }

    /* ── LAYOUT ── */
    .page-wrapper { margin-top:56px; min-height:70vh; }
    .page-content-wrap { max-width:820px; margin:32px auto 60px; padding:40px 50px; background:rgba(255,255,255,.98); border-radius:var(--r-lg); box-shadow:var(--sh-soft); border:1px solid rgba(186,230,253,.5); }
    @media(max-width:640px){ .page-content-wrap{ padding:24px 18px; margin:16px 12px 40px; } }

    /* ── CHAP NAV ── */
    .chap-nav-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 14px 20px;
      flex-wrap: wrap;
      max-width: 900px;
      margin: 0 auto;
    }
    .chap-pn {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 6px 16px; border-radius: var(--r-pill);
      border: 1px solid var(--sky-light); font-size: .78rem;
      color: var(--sky-dark); transition: var(--t); white-space: nowrap;
      background: rgba(255,255,255,.9);
    }
    .chap-pn:hover { background: var(--sky-pale); border-color: var(--sky); }
    .chap-pn.disabled { opacity: .4; pointer-events: none; }

    /* ── CHAPTER DROPDOWN ── */
    .chap-dd-wrap { position: relative; }
    .chap-dd-btn {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 6px 14px; border-radius: var(--r-pill);
      border: 1px solid var(--sky-light); font-size: .76rem;
      color: var(--sky-dark); cursor: pointer; font-family: 'Newsreader', serif;
      background: rgba(255,255,255,.9); transition: var(--t); white-space: nowrap;
    }
    .chap-dd-btn:hover { background: var(--sky-pale); border-color: var(--sky); }

    .chap-dd-list {
      position: absolute;
      top: calc(100% + 6px);
      left: 50%;
      transform: translateX(-50%);
      z-index: 700;
      width: 220px;
      max-height: 280px;
      overflow-y: auto;
      overflow-x: hidden;
      background: #fff;
      border: 1px solid rgba(186,230,253,.7);
      border-radius: var(--r-md);
      box-shadow: 0 16px 48px rgba(2,132,199,.15);
      padding: 4px;
      display: none;
      scrollbar-width: thin;
      scrollbar-color: var(--sky-light) transparent;
    }
    .chap-dd-list::-webkit-scrollbar { width: 3px; }
    .chap-dd-list::-webkit-scrollbar-thumb { background: var(--sky-light); border-radius: 3px; }
    .chap-dd-list.open { display: block; }
    .chap-dd-list.up {
      top: auto;
      bottom: calc(100% + 6px);
    }
    .chap-dd-list a {
      display: block;
      padding: 6px 12px;
      font-size: .76rem;
      color: var(--text-mid);
      border-radius: var(--r-sm);
      transition: var(--t);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      border-bottom: 1px solid rgba(186,230,253,.2);
    }
    .chap-dd-list a:last-child { border-bottom: none; }
    .chap-dd-list a:hover { background: var(--sky-pale); color: var(--sky); }
    .chap-dd-list a.cur-chap {
      background: rgba(14,165,233,.1);
      color: var(--sky-dark);
      font-weight: 700;
    }
    [data-theme="dark"] .chap-dd-list { background: #0e2236; border-color: #1e5a7a; }
    [data-theme="dark"] .chap-dd-list a { color: #a0c8e0; border-color: rgba(96,184,232,.12); }
    [data-theme="dark"] .chap-dd-list a:hover { background: rgba(96,184,232,.1); color: #daeeff; }
    [data-theme="dark"] .chap-dd-list a.cur-chap { background: rgba(96,184,232,.15); color: #89d0f5; }

    /* ── NOVEL LAYOUT ── */
    .novel-layout-wrap {
      max-width: 800px;
      margin: 0 auto;
      padding: 0 16px;
      position: relative;
    }

    /* ── NOVEL CONTENT ── */
    .novel-content {
      max-width: 760px;
      margin: 24px auto 60px;
      padding: 40px 50px;
      background: rgba(255,255,255,.98);
      border-radius: var(--r-lg);
      box-shadow: var(--sh-soft);
      border: 1px solid rgba(186,230,253,.5);
      position: relative;
      /* FIX 1: Không push content, sidebar sẽ overlay */
    }
    @media(max-width:640px){ .novel-content{ padding:24px 18px; margin:16px 12px 40px; } }
    .novel-content p {
      text-align: justify;
      text-justify: inter-word;
      position: relative;
      margin-bottom: 1.1em;
      display: block;
    }
    blockquote {
      font-style: italic; font-size: .9rem; color: var(--text-mid);
      line-height: 1.75; border-left: 3px solid var(--sky-light);
      padding: 15px 20px; margin: 20px 0;
      background: var(--sky-pale); border-radius: 0 12px 12px 0;
    }
    hr { border: none; text-align: center; margin: 40px 0; }
    hr::after { content:"𓆝 𓆟 𓆞 𓆝 𓆟"; color:var(--sky-light); font-size:20px; letter-spacing:5px; }

    /* ── FIX 1: INLINE COMMENT SIDEBAR — full overlay, không push content ── */
    .ic-sidebar {
      position: fixed;
      top: 56px;
      right: 0;
      bottom: 0;
      width: 300px;
      display: flex;
      flex-direction: column;
      background: #fff;
      border-left: 1px solid rgba(186,230,253,.5);
      border-radius: var(--r-lg) 0 0 var(--r-lg);
      box-shadow: -8px 0 40px rgba(2,132,199,.18);
      opacity: 0;
      pointer-events: none;
      transform: translateX(100%);
      transition: opacity .25s ease, transform .25s ease;
      z-index: 460; /* trên overlay, dưới nav */
      overflow: hidden;
    }
    [data-theme="dark"] .ic-sidebar {
      background: #0e2236;
      border-color: rgba(96,184,232,.16);
    }
    /* FIX 1: Chỉ toggle open/close, KHÔNG push content */
    .novel-layout-wrap.sidebar-open .ic-sidebar {
      opacity: 1;
      pointer-events: auto;
      transform: translateX(0);
    }
    /* FIX 1: Overlay backdrop che toàn bộ trang khi sidebar mở */
    .ic-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.4);
      z-index: 450;
      backdrop-filter: blur(1px);
    }
    .ic-overlay.show { display: block; }

    @media(max-width:600px){
      .ic-sidebar { width: min(300px, 88vw); }
    }

    /* Sidebar inner structure */
    .ic-sidebar-inner {
      display: flex;
      flex-direction: column;
      height: 100%;
      overflow: hidden;
    }
    .ic-sidebar-header {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      padding: 14px 14px 10px;
      border-bottom: 1px solid rgba(186,230,253,.4);
      flex-shrink: 0;
    }
    [data-theme="dark"] .ic-sidebar-header { border-color: rgba(96,184,232,.15); }
    .ic-para-preview {
      flex: 1;
      font-size: .68rem;
      color: var(--text-dim);
      font-style: italic;
      line-height: 1.5;
      max-height: 3.5em;
      overflow: hidden;
      text-overflow: ellipsis;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
    .ic-sidebar-close {
      flex-shrink: 0;
      width: 24px; height: 24px;
      border-radius: 50%;
      border: 1px solid rgba(186,230,253,.5);
      background: none; cursor: pointer;
      font-size: .62rem; color: var(--text-dim);
      display: flex; align-items: center; justify-content: center;
      transition: var(--t);
    }
    .ic-sidebar-close:hover { background: var(--sky-pale); color: var(--sky); }
    [data-theme="dark"] .ic-sidebar-close { border-color: rgba(96,184,232,.2); color: #6a9ab5; }

    /* Sidebar form */
    .ic-sidebar-form {
      padding: 10px 12px;
      border-bottom: 1px solid rgba(186,230,253,.3);
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    [data-theme="dark"] .ic-sidebar-form { border-color: rgba(96,184,232,.12); }
    .ic-form-name {
      width: 100%;
      padding: 5px 10px;
      border: 1.5px solid var(--sky-light);
      border-radius: var(--r-pill);
      font-size: .72rem;
      font-family: 'Newsreader', serif;
      color: var(--text-main);
      background: var(--cream);
      outline: none;
    }
    .ic-form-name:focus { border-color: var(--sky); }
    [data-theme="dark"] .ic-form-name { background: #091726; border-color: #1e5a7a; color: #daeeff; }
    [data-theme="dark"] .ic-form-name::placeholder { color: #4a7a96; }
    .ic-form-body {
      display: flex;
      gap: 6px;
      align-items: flex-end;
    }
    .ic-form-text {
      flex: 1;
      padding: 7px 10px;
      border: 1.5px solid var(--sky-light);
      border-radius: 10px;
      font-size: .74rem;
      font-family: 'Newsreader', serif;
      color: var(--text-main);
      background: var(--cream);
      outline: none;
      resize: none;
      min-height: 48px;
    }
    .ic-form-text:focus { border-color: var(--sky); }
    [data-theme="dark"] .ic-form-text { background: #091726; border-color: #1e5a7a; color: #daeeff; }
    [data-theme="dark"] .ic-form-text::placeholder { color: #4a7a96; }
    .ic-form-send {
      width: 32px; height: 32px;
      border-radius: 50%;
      background: var(--sky); color: #fff;
      border: none; cursor: pointer;
      font-size: .88rem;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
      transition: var(--t);
    }
    .ic-form-send:hover { background: var(--sky2); }
    .ic-form-send:disabled { opacity: .5; cursor: not-allowed; }

    /* Quoting bar in sidebar form */
    .ic-quoting-bar {
      display: none;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      background: rgba(14,165,233,.07);
      border-radius: 6px;
      border-left: 3px solid var(--sky-light);
      font-size: .66rem;
    }
    .ic-quoting-bar.show { display: flex; }
    [data-theme="dark"] .ic-quoting-bar { background: rgba(96,184,232,.1); border-left-color: #2a6a8a; }
    .ic-quoting-label { flex: 1; color: var(--sky); font-style: italic; }
    [data-theme="dark"] .ic-quoting-label { color: #89d0f5; }
    .ic-quoting-cancel {
      background: none; border: none; cursor: pointer;
      font-size: .58rem; color: var(--text-dim); padding: 0 2px;
      border-radius: 3px; transition: color .15s;
    }
    .ic-quoting-cancel:hover { color: #ef4444; }

    /* Sidebar list */
    .ic-sidebar-list {
      flex: 1;
      overflow-y: auto;
      padding: 10px 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      scrollbar-width: thin;
      scrollbar-color: var(--sky-light) transparent;
    }
    .ic-sidebar-list::-webkit-scrollbar { width: 3px; }
    .ic-sidebar-list::-webkit-scrollbar-thumb { background: var(--sky-light); border-radius: 3px; }
    .ic-empty {
      font-size: .74rem;
      color: var(--text-dim);
      font-style: italic;
      text-align: center;
      padding: 20px 0;
      line-height: 1.7;
    }
    [data-theme="dark"] .ic-empty { color: #4a7a96; }

    /* Sidebar comment items */
    .ic-item {
      background: var(--sky-pale);
      border: 1px solid rgba(186,230,253,.5);
      border-radius: 10px;
      padding: 9px 10px;
      font-size: .74rem;
    }
    .ic-item-header { display: flex; align-items: center; gap: 6px; margin-bottom: 4px; }
    .ic-item-name { font-weight: 700; color: var(--sky-dark); font-size: .72rem; }
    [data-theme="dark"] .ic-item-name { color: #89d0f5; }
    .ic-item-time { font-size: .6rem; color: var(--text-dim); margin-left: auto; }
    .ic-item-text { font-size: .74rem; color: var(--text-main); line-height: 1.5; margin-bottom: 6px; word-break: break-word; }
    [data-theme="dark"] .ic-item-text { color: #cce4f8; }
    .ic-item-actions { display: flex; align-items: center; gap: 6px; }
    .ic-reply-toggle {
      font-size: .64rem; color: var(--sky); background: none; border: none;
      cursor: pointer; font-family: 'Newsreader', serif; padding: 0;
      transition: color .15s;
    }
    .ic-reply-toggle:hover { color: var(--sky2); text-decoration: underline; }
    [data-theme="dark"] .ic-reply-toggle { color: #89d0f5; }
    .ic-del-btn {
      margin-left: auto; font-size: .62rem; color: var(--text-dim);
      background: none; border: none; cursor: pointer; padding: 2px 5px;
      border-radius: 4px; display: none; transition: color .15s;
    }
    .ic-del-btn.show { display: inline-flex; align-items: center; gap: 2px; }
    .ic-del-btn:hover { color: #ef4444; }

    /* Replies inside sidebar */
    .ic-replies {
      display: none;
      flex-direction: column;
      gap: 5px;
      margin-top: 7px;
      padding-top: 7px;
      border-top: 1px solid rgba(186,230,253,.3);
    }
    .ic-replies.open { display: flex; }
    [data-theme="dark"] .ic-replies { border-color: rgba(96,184,232,.12); }
    .ic-reply-item {
      display: flex;
      gap: 6px;
      align-items: flex-start;
      background: rgba(255,255,255,.7);
      border-radius: 7px;
      padding: 6px 8px;
      position: relative;
    }
    [data-theme="dark"] .ic-reply-item { background: rgba(21,50,80,.5); }
    .ic-reply-avatar {
      width: 20px; height: 20px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--sky-pale), var(--sky-light));
      display: flex; align-items: center; justify-content: center;
      font-size: .58rem; font-weight: 700;
      color: var(--sky-dark); flex-shrink: 0;
      border: 1px solid var(--sky-light);
    }
    [data-theme="dark"] .ic-reply-avatar { background: rgba(21,101,160,.4); color: #89d0f5; border-color: rgba(96,184,232,.3); }
    .ic-reply-body { flex: 1; min-width: 0; }
    .ic-reply-name { font-weight: 700; font-size: .66rem; color: var(--sky-dark); }
    [data-theme="dark"] .ic-reply-name { color: #89d0f5; }
    .ic-reply-at { color: var(--sky); font-weight: 700; font-size: .66rem; background: rgba(14,165,233,.08); border-radius: 3px; padding: 0 3px; margin-right: 2px; }
    [data-theme="dark"] .ic-reply-at { color: #89d0f5; background: rgba(96,184,232,.12); }
    .ic-reply-text { font-size: .7rem; color: var(--text-main); line-height: 1.45; margin-top: 2px; word-break: break-word; }
    [data-theme="dark"] .ic-reply-text { color: #b8d8f0; }
    .ic-rr-btn {
      display: inline-block; margin-top: 3px;
      background: none; border: none; cursor: pointer;
      font-size: .6rem; color: var(--sky); padding: 0;
      font-family: 'Newsreader', serif; transition: color .15s;
    }
    .ic-rr-btn:hover { color: var(--sky2); text-decoration: underline; }
    [data-theme="dark"] .ic-rr-btn { color: #89d0f5; }
    .ic-reply-del {
      position: absolute; top: 5px; right: 6px;
      background: none; border: none; cursor: pointer;
      font-size: .56rem; color: var(--text-dim); opacity: 0;
      transition: opacity .15s, color .15s; padding: 2px 3px;
      border-radius: 3px; display: none;
    }
    .ic-reply-item:hover .ic-reply-del { opacity: 1; }
    .ic-reply-del:hover { color: #ef4444; }
    .ic-reply-del.show { display: block; }

    /* Reply form inside sidebar */
    .ic-reply-form {
      display: none;
      flex-direction: column;
      gap: 5px;
      margin-top: 5px;
    }
    .ic-reply-form.open { display: flex; }
    .ic-reply-form input, .ic-reply-form textarea {
      width: 100%; padding: 5px 9px;
      border: 1.5px solid var(--sky-light);
      font-family: 'Newsreader', serif;
      color: var(--text-main); background: var(--cream);
      outline: none; font-size: .7rem;
    }
    .ic-reply-form input { border-radius: var(--r-pill); }
    .ic-reply-form textarea { border-radius: 8px; resize: none; min-height: 44px; }
    .ic-reply-form input:focus, .ic-reply-form textarea:focus { border-color: var(--sky); }
    [data-theme="dark"] .ic-reply-form input,
    [data-theme="dark"] .ic-reply-form textarea { background: #091726; border-color: #1e5a7a; color: #daeeff; }
    [data-theme="dark"] .ic-reply-form input::placeholder,
    [data-theme="dark"] .ic-reply-form textarea::placeholder { color: #4a7a96; }
    .ic-reply-form-row {
      display: flex; gap: 5px; justify-content: flex-end;
    }
    .ic-rf-cancel {
      padding: 3px 9px; background: none; border: 1px solid rgba(186,230,253,.6);
      border-radius: var(--r-pill); font-size: .66rem; cursor: pointer;
      color: var(--text-dim); transition: var(--t);
    }
    .ic-rf-cancel:hover { color: var(--sky); }
    .ic-rf-send {
      padding: 3px 10px; background: var(--sky); color: #fff;
      border: none; border-radius: var(--r-pill);
      font-size: .66rem; cursor: pointer; transition: var(--t);
    }
    .ic-rf-send:hover { background: var(--sky2); }
    .ic-rf-send:disabled { opacity: .5; cursor: not-allowed; }

    /* Trigger button on paragraphs */
    .ic-trigger {
      display: inline-flex;
      align-items: center;
      margin-left: 6px;
      padding: 0 4px;
      background: none;
      border: none;
      cursor: pointer;
      font-size: .75rem;
      opacity: 0;
      transition: opacity .15s;
      vertical-align: middle;
      border-radius: 4px;
      color: var(--sky);
      line-height: 1;
    }
    .novel-content p:hover .ic-trigger { opacity: .65; }
    .ic-trigger:hover { opacity: 1 !important; }
    .ic-trigger.has-comments { opacity: .8; }
    .novel-content p.ic-active .ic-trigger { opacity: 1; }

    /* ══════════════════════════════════
       CHAPTER-END COMMENT
    ══════════════════════════════════ */
    .chap-comment-section { max-width:760px; margin:0 auto; padding:0 12px 60px; }
    .chap-comment-title { font-family:'Merriweather',serif; font-size:.9rem; color:var(--sky-dark); letter-spacing:1.5px; text-transform:uppercase; margin:36px 0 18px; display:flex; align-items:center; gap:10px; }
    .chap-comment-title::after { content:''; flex:1; height:1px; background:linear-gradient(to right,var(--sky-light),transparent); }
    [data-theme="dark"] .chap-comment-title { color:#89d0f5; }
    [data-theme="dark"] .chap-comment-title::after { background:linear-gradient(to right,#1e5a7a,transparent); }

    /* FIX 6: Admin bar moved — ẩn admin-bar cũ ở comment section */
    .admin-bar { display:none; }

    .comment-form { background:#fff; border:1px solid rgba(186,230,253,.5); border-radius:14px; padding:18px; margin-bottom:20px; }
    .comment-form-row { display:flex; gap:8px; margin-bottom:10px; }
    .comment-inp { flex:1; padding:8px 14px; border:1.5px solid var(--sky-light); border-radius:var(--r-pill); font-size:.82rem; font-family:'Newsreader',serif; color:var(--text-main); background:var(--cream); outline:none; }
    .comment-inp:focus { border-color:var(--sky); }
    [data-theme="dark"] .comment-inp { background:#091726; border-color:#1e5a7a; color:#daeeff; }
    [data-theme="dark"] .comment-inp::placeholder { color:#4a7a96; }
    .comment-textarea { width:100%; padding:10px 14px; border:1.5px solid var(--sky-light); border-radius:12px; font-size:.84rem; font-family:'Newsreader',serif; color:var(--text-main); background:var(--cream); outline:none; resize:vertical; min-height:88px; margin-bottom:10px; }
    .comment-textarea:focus { border-color:var(--sky); }
    [data-theme="dark"] .comment-textarea { background:#091726; border-color:#1e5a7a; color:#daeeff; }
    [data-theme="dark"] .comment-textarea::placeholder { color:#4a7a96; }
    .comment-submit-btn { padding:7px 20px; background:var(--sky); color:#fff; border:none; border-radius:var(--r-pill); font-size:.8rem; cursor:pointer; font-family:'Newsreader',serif; transition:var(--t); }
    .comment-submit-btn:hover { background:var(--sky2); }
    .comment-submit-btn:disabled { opacity:.5; cursor:not-allowed; }

    .comment-list { display:flex; flex-direction:column; gap:12px; }
    .comment-card { background:#fff; border:1px solid rgba(186,230,253,.45); border-radius:14px; padding:15px 17px; transition:box-shadow .2s; }
    .comment-card:hover { box-shadow:0 4px 16px rgba(2,132,199,.08); }
    .comment-card-header { display:flex; align-items:center; gap:8px; margin-bottom:7px; }
    .comment-card-avatar { width:30px; height:30px; border-radius:50%; background:linear-gradient(135deg,var(--sky-pale),var(--sky-light)); display:flex; align-items:center; justify-content:center; font-size:.78rem; font-weight:700; color:var(--sky-dark); flex-shrink:0; border:1.5px solid var(--sky-light); }
    [data-theme="dark"] .comment-card-avatar { background:rgba(21,101,160,.3); border-color:rgba(96,184,232,.3); color:#89d0f5; }
    .comment-card-name { font-weight:700; color:var(--sky-dark); font-size:.82rem; }
    [data-theme="dark"] .comment-card-name { color:#89d0f5; }
    .comment-card-time { font-size:.68rem; color:var(--text-dim); margin-left:auto; }
    [data-theme="dark"] .comment-card-time { color:#4a7a96; }
    .comment-card-text { font-size:.86rem; color:var(--text-main); line-height:1.65; margin:0 0 10px; word-break:break-word; }
    [data-theme="dark"] .comment-card-text { color:#cce4f8; }

    .comment-card-actions { display:flex; align-items:center; gap:7px; flex-wrap:wrap; }
    .cmt-like-btn { display:inline-flex; align-items:center; gap:4px; padding:3px 10px; border-radius:var(--r-pill); border:1px solid rgba(186,230,253,.6); background:none; font-size:.72rem; color:var(--text-dim); cursor:pointer; transition:var(--t); font-family:'Newsreader',serif; }
    .cmt-like-btn:hover { border-color:#f472b6; color:#ec4899; background:rgba(244,114,182,.06); }
    .cmt-like-btn.liked { border-color:#f472b6; color:#ec4899; background:rgba(244,114,182,.08); }
    [data-theme="dark"] .cmt-like-btn { border-color:rgba(96,184,232,.2); color:#6a9ab5; }
    [data-theme="dark"] .cmt-like-btn.liked { border-color:#f472b6; color:#f9a8d4; }
    .cmt-reply-btn { display:inline-flex; align-items:center; gap:4px; padding:3px 10px; border-radius:var(--r-pill); border:1px solid rgba(186,230,253,.6); background:none; font-size:.72rem; color:var(--text-dim); cursor:pointer; transition:var(--t); font-family:'Newsreader',serif; }
    .cmt-reply-btn:hover { border-color:var(--sky-light); color:var(--sky); background:var(--sky-pale); }
    [data-theme="dark"] .cmt-reply-btn { border-color:rgba(96,184,232,.2); color:#6a9ab5; }
    [data-theme="dark"] .cmt-reply-btn:hover { background:rgba(96,184,232,.08); color:#89d0f5; }
    .cmt-del-btn { margin-left:auto; padding:3px 9px; border-radius:var(--r-pill); border:1px solid transparent; background:none; font-size:.68rem; color:var(--text-dim); cursor:pointer; transition:var(--t); display:none; }
    .cmt-del-btn.show { display:inline-flex; align-items:center; gap:3px; }
    .cmt-del-btn:hover { color:#ef4444; border-color:#fca5a5; background:rgba(239,68,68,.06); }

    .reply-thread { margin-top:10px; padding-top:10px; border-top:1px solid rgba(186,230,253,.35); display:none; flex-direction:column; gap:7px; }
    .reply-thread.open { display:flex; }
    [data-theme="dark"] .reply-thread { border-top-color:rgba(96,184,232,.15); }
    .reply-item { display:flex; gap:8px; align-items:flex-start; background:var(--sky-pale); border-radius:10px; padding:9px 11px; position:relative; }
    .reply-avatar { width:24px; height:24px; border-radius:50%; flex-shrink:0; background:linear-gradient(135deg,#bae6fd,#7dd3fc); display:flex; align-items:center; justify-content:center; font-size:.62rem; font-weight:700; color:#0369a1; border:1px solid var(--sky-light); }
    [data-theme="dark"] .reply-avatar { background:rgba(21,101,160,.4); color:#89d0f5; border-color:rgba(96,184,232,.3); }
    .reply-body { flex:1; min-width:0; }
    .reply-name { font-weight:700; font-size:.7rem; color:var(--sky-dark); }
    [data-theme="dark"] .reply-name { color:#89d0f5; }
    .reply-time { font-size:.6rem; color:var(--text-dim); margin-left:6px; }
    .reply-text { font-size:.78rem; color:var(--text-main); margin:3px 0 0; line-height:1.5; word-break:break-word; }
    [data-theme="dark"] .reply-text { color:#b8d8f0; }
    .reply-del { position:absolute; top:6px; right:8px; background:none; border:none; cursor:pointer; font-size:.58rem; color:var(--text-dim); opacity:0; transition:opacity .15s,color .15s; padding:2px 4px; border-radius:3px; display:none; }
    .reply-item:hover .reply-del { opacity:1; }
    .reply-del:hover { color:#ef4444; background:rgba(239,68,68,.08); }
    .reply-del.show { display:block; }

    .reply-form { display:none; margin-top:6px; flex-direction:column; gap:5px; }
    .reply-form.open { display:flex; }
    .reply-inp,.reply-inp-text { padding:6px 12px; border:1.5px solid var(--sky-light); font-family:'Newsreader',serif; color:var(--text-main); background:var(--cream); outline:none; }
    .reply-inp { border-radius:var(--r-pill); font-size:.75rem; }
    .reply-inp-text { border-radius:10px; font-size:.76rem; resize:none; min-height:52px; }
    .reply-inp:focus,.reply-inp-text:focus { border-color:var(--sky); }
    [data-theme="dark"] .reply-inp,[data-theme="dark"] .reply-inp-text { background:#091726; border-color:#1e5a7a; color:#daeeff; }
    [data-theme="dark"] .reply-inp::placeholder,[data-theme="dark"] .reply-inp-text::placeholder { color:#4a7a96; }
    .reply-form-btns { display:flex; gap:6px; justify-content:flex-end; }
    .reply-cancel-btn { padding:4px 11px; background:none; border:1px solid rgba(186,230,253,.6); border-radius:var(--r-pill); font-size:.7rem; cursor:pointer; color:var(--text-dim); transition:var(--t); }
    .reply-cancel-btn:hover { color:var(--sky); }
    .reply-send-btn { padding:4px 13px; background:var(--sky); color:#fff; border:none; border-radius:var(--r-pill); font-size:.7rem; cursor:pointer; transition:var(--t); }
    .reply-send-btn:hover { background:var(--sky2); }
    .reply-send-btn:disabled { opacity:.5; cursor:not-allowed; }
    .reply-at { display:inline-block; color:var(--sky); font-weight:700; font-size:.75em; background:rgba(14,165,233,.08); border-radius:4px; padding:0 4px; margin-right:2px; }
    [data-theme="dark"] .reply-at { color:#89d0f5; background:rgba(96,184,232,.12); }
    .reply-quoting { display:flex; align-items:center; gap:6px; padding:4px 10px; background:rgba(14,165,233,.07); border-radius:6px; margin-bottom:6px; border-left:3px solid var(--sky-light); }
    [data-theme="dark"] .reply-quoting { background:rgba(96,184,232,.1); border-left-color:#2a6a8a; }
    .reply-quoting-label { flex:1; font-size:.68rem; color:var(--sky); font-style:italic; }
    [data-theme="dark"] .reply-quoting-label { color:#89d0f5; }
    .reply-quoting-cancel { background:none; border:none; cursor:pointer; font-size:.62rem; color:var(--text-dim); padding:0 2px; border-radius:3px; transition:color .15s; }
    .reply-quoting-cancel:hover { color:#ef4444; }
    .reply-quote-btn { display:inline-block; margin-top:4px; background:none; border:none; cursor:pointer; font-size:.62rem; color:var(--sky); padding:0; font-family:'Newsreader',serif; transition:color .15s; }
    .reply-quote-btn:hover { color:var(--sky2); text-decoration:underline; }
    [data-theme="dark"] .reply-quote-btn { color:#89d0f5; }
    .reply-items-wrap { display:flex; flex-direction:column; gap:7px; margin-bottom:6px; }
    .comment-empty { font-size:.82rem; color:var(--text-dim); font-style:italic; text-align:center; padding:24px; }
    .comment-loading { font-size:.8rem; color:var(--text-dim); text-align:center; padding:16px; }
    [data-theme="dark"] .comment-empty,[data-theme="dark"] .comment-loading { color:#4a7a96; }

    /* ── FOOTER ── */
    footer { background:#fff; border-top:1px solid rgba(186,230,253,.4); padding:44px 20px 26px; margin-top:auto; }
    .footer-inner { max-width:1100px; margin:0 auto; display:grid; grid-template-columns:1fr auto 1fr; gap:28px; align-items:start; }
    @media(max-width:600px){ .footer-inner{grid-template-columns:1fr;text-align:center;} .ft-social{align-items:center!important;} }
    .ft-logo { font-family:'Literata',serif; font-size:1.1rem; font-weight:600; color:var(--sky-dark); display:block; margin-bottom:5px; }
    .ft-brand p { font-size:.78rem; color:var(--text-dim); font-style:italic; margin:3px 0; }
    .ft-links { display:flex; flex-direction:column; gap:7px; align-items:center; }
    .ft-links a { font-size:.76rem; color:var(--text-mid); letter-spacing:1px; text-transform:uppercase; transition:var(--t); }
    .ft-links a:hover { color:var(--sky); }
    .ft-social { display:flex; flex-direction:column; gap:7px; align-items:flex-end; }
    .ft-social-row { display:flex; gap:8px; }
    .social-ic { width:34px; height:34px; border-radius:50%; border:1px solid var(--sky-light); display:flex; align-items:center; justify-content:center; font-size:.88rem; color:var(--sky); background:var(--sky-pale); transition:var(--t); }
    .social-ic:hover { background:var(--sky-light); transform:translateY(-2px); }
    .ft-bottom { max-width:1100px; margin:26px auto 0; padding-top:16px; border-top:1px solid rgba(186,230,253,.3); text-align:center; font-size:.7rem; color:var(--text-dim); letter-spacing:1px; }

    /* ── SCROLL BUTTONS ── */
    .scroll-btns { position:fixed; bottom:24px; right:22px; z-index:400; display:flex; flex-direction:column; gap:8px; pointer-events:none; }
    .scroll-btn { width:40px; height:40px; border-radius:50%; background:var(--sky); color:#fff; border:none; cursor:pointer; font-size:1.1rem; box-shadow:0 4px 14px rgba(2,132,199,.35); transition:opacity .25s ease,transform .25s ease,background .2s ease; display:flex; align-items:center; justify-content:center; opacity:0; pointer-events:none; line-height:1; }
    .scroll-btn.show { opacity:1; pointer-events:auto; }
