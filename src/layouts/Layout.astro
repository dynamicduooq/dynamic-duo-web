<script is:inline>
/* ─── SCROLL + PROGRESS ─── */
const _st = document.getElementById('scrollTop');
const _sb = document.getElementById('scrollBot');
const _rp = document.getElementById('read-progress');
if (_st) _st.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
if (_sb) _sb.addEventListener('click', () => window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' }));
function _updScroll() {
  const y = window.scrollY;
  const max = Math.max(1, document.body.scrollHeight - window.innerHeight);
  const pct = y / max;
  if (_st) _st.classList.toggle('show', y > 300);
  if (_sb) _sb.classList.toggle('show', pct < 0.97 && max > 100);
  if (_rp) _rp.style.width = (pct * 100) + '%';
}
window.addEventListener('scroll', _updScroll, { passive: true });
requestAnimationFrame(() => setTimeout(_updScroll, 200));

/* ─── HAMBURGER ─── */
document.getElementById('hamburger')?.addEventListener('click', () => {
  document.getElementById('mobileMenu')?.classList.toggle('open');
});
document.addEventListener('click', (e) => {
  const mm = document.getElementById('mobileMenu');
  const hb = document.getElementById('hamburger');
  if (mm?.classList.contains('open') && !mm.contains(e.target) && !hb?.contains(e.target))
    mm.classList.remove('open');
});

/* ─── CHAPTER DROPDOWNS ─── */
function setupDD(btnId, listId) {
  const btn = document.getElementById(btnId);
  const list = document.getElementById(listId);
  if (!btn || !list) return;
  btn.addEventListener('click', (e) => {
    e.stopPropagation();
    const wasOpen = list.classList.contains('open');
    document.querySelectorAll('.chap-dd-list.open').forEach(el => el.classList.remove('open'));
    if (!wasOpen) {
      list.classList.add('open');
      const cur = list.querySelector('.cur-chap');
      if (cur) setTimeout(() => cur.scrollIntoView({ block: 'center' }), 30);
    }
  });
}
setupDD('ddBtnTop', 'ddListTop');
setupDD('ddBtnBot', 'ddListBot');
document.addEventListener('click', () => {
  document.querySelectorAll('.chap-dd-list.open').forEach(el => el.classList.remove('open'));
});

/* ─── DARK MODE ─── */
function applyTheme(dark) {
  document.documentElement.setAttribute('data-theme', dark ? 'dark' : '');
  localStorage.setItem('dd-theme', dark ? 'dark' : 'light');
}
window.__ddToggleTheme = function() {
  applyTheme(document.documentElement.getAttribute('data-theme') !== 'dark');
};

/* ─── FIREBASE COMMENT SYSTEM ─── */
(function initComments() {

  /* ── Helper: time ── */
  function timeAgo(ts) {
    if (!ts) return '';
    const d = Date.now() - ts;
    if (d < 60000) return 'vừa xong';
    if (d < 3600000) return Math.floor(d / 60000) + ' phút trước';
    if (d < 86400000) return Math.floor(d / 3600000) + ' giờ trước';
    return Math.floor(d / 86400000) + ' ngày trước';
  }

  /* ── Escape HTML ── */
  function esc(s) {
    return (s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  /* ── pageKey: pathname → Firebase node key ── */
  function pageKey() {
    return location.pathname.replace(/[^a-zA-Z0-9]/g, '_').replace(/^_+|_+$/g,'').substring(0, 120);
  }

  /* ═══════════════════════════════════════════
     A CUỐI CHƯƠNG — bình luận chính
  ═══════════════════════════════════════════ */
  (function setupChapComments() {
    const section = document.getElementById('chapCommentSection');
    if (!section) return;

    const cmtList   = document.getElementById('cmtList');
    const cmtName   = document.getElementById('cmtName');
    const cmtText   = document.getElementById('cmtText');
    const cmtSubmit = document.getElementById('cmtSubmit');
    if (!cmtList || !cmtSubmit) return;

    const key = 'chap_' + pageKey();

    /* Wait for Firebase to be ready (loaded via type="module") */
    function waitFirebase(cb, attempt) {
      attempt = attempt || 0;
      if (window.__ddFirebase?.db) return cb(window.__ddFirebase);
      if (attempt > 40) {
        cmtList.innerHTML = '<div class="comment-empty">⚠️ Chưa kết nối Firebase. Xem hướng dẫn README.</div>';
        return;
      }
      setTimeout(() => waitFirebase(cb, attempt + 1), 200);
    }

    waitFirebase(function({ db, ref, push, onValue, remove, serverTimestamp }) {
      const cmtRef = ref(db, 'comments/' + key);

      /* Listen realtime */
      onValue(cmtRef, (snap) => {
        const data = snap.val();
        if (!data) {
          cmtList.innerHTML = '<div class="comment-empty">𓆝 Chưa có bình luận. Hãy là người đầu tiên!</div>';
          return;
        }
        const items = Object.entries(data)
          .map(([id, v]) => ({ id, ...v }))
          .sort((a, b) => (a.ts || 0) - (b.ts || 0));

        cmtList.innerHTML = items.map(c => `
          <div class="comment-card">
            <button class="comment-card-del" data-id="${esc(c.id)}" title="Xóa">✕</button>
            <span class="comment-card-name">${esc(c.name) || 'Khách vô danh'}</span>
            <span class="comment-card-time">${timeAgo(c.ts)}</span>
            <p class="comment-card-text">${esc(c.text)}</p>
          </div>
        `).join('');

        /* Delete buttons */
        cmtList.querySelectorAll('.comment-card-del').forEach(btn => {
          btn.addEventListener('click', async () => {
            if (!confirm('Xóa bình luận này?')) return;
            await remove(ref(db, 'comments/' + key + '/' + btn.dataset.id));
          });
        });
      });

      /* Submit */
      cmtSubmit.addEventListener('click', async () => {
        const text = (cmtText?.value || '').trim();
        if (!text) return;
        cmtSubmit.disabled = true;
        try {
          await push(cmtRef, {
            name: (cmtName?.value || '').trim() || 'Khách vô danh',
            text,
            ts: Date.now()
          });
          if (cmtText) cmtText.value = '';
        } catch(e) {
          alert('Lỗi khi gửi bình luận: ' + e.message);
        }
        cmtSubmit.disabled = false;
      });

      /* Ctrl+Enter submit */
      cmtText?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) cmtSubmit.click();
      });
    });
  })();

  /* ═══════════════════════════════════════════
     B INLINE COMMENT — bình luận từng đoạn
  ═══════════════════════════════════════════ */
  (function setupInlineComments() {
    const content = document.querySelector('.novel-content');
    if (!content) return;

    const bubble = document.createElement('div');
    bubble.className = 'ic-bubble';
    document.body.appendChild(bubble);
    let currentIdx = null;

    function positionBubble(trigger) {
      const rect = trigger.getBoundingClientRect();
      const bw = Math.min(310, window.innerWidth - 32);
      const margin = 8;
      let top = rect.top - 4;
      const maxTop = window.innerHeight - 380 - margin;
      if (top > maxTop) top = maxTop;
      if (top < 70) top = 70;
      let left = rect.right + margin;
      if (left + bw > window.innerWidth - margin) left = rect.left - bw - margin;
      if (left < margin) { left = Math.max(margin, (window.innerWidth - bw) / 2); top = rect.bottom + margin; }
      bubble.style.cssText += `;width:${bw}px;left:${left}px;top:${top}px`;
    }

    function waitFirebase(cb, attempt) {
      attempt = attempt || 0;
      if (window.__ddFirebase?.db) return cb(window.__ddFirebase);
      if (attempt > 40) return;
      setTimeout(() => waitFirebase(cb, attempt + 1), 200);
    }

    function renderBubble(idx, data) {
      const { db, ref, push, onValue, remove } = window.__ddFirebase;
      const items = data ? Object.entries(data).map(([id, v]) => ({ id, ...v })).sort((a,b)=>(a.ts||0)-(b.ts||0)) : [];
      bubble.setAttribute('data-para', idx);

      const commentsHtml = items.length
        ? items.map(c => `
          <div class="ic-comment-item">
            <button class="ic-delete-btn" data-id="${esc(c.id)}" title="Xóa">✕</button>
            <div class="ic-comment-name">${esc(c.name)||'Khách vô danh'}<span class="ic-comment-time">${timeAgo(c.ts)}</span></div>
            <p class="ic-comment-text">${esc(c.text)}</p>
          </div>`).join('')
        : '<div style="color:var(--text-dim);font-size:.72rem;text-align:center;padding:8px 0">Chưa có bình luận cho đoạn này 🌊</div>';

      bubble.innerHTML = `
        <div class="ic-bubble-header">
          <span>💬 <strong>${items.length}</strong> · đoạn ${idx + 1}</span>
          <button class="ic-bubble-close">✕</button>
        </div>
        <div class="ic-comments-list">${commentsHtml}</div>
        <div class="ic-name-row">
          <input class="ic-input ic-name-inp" placeholder="Tên (tùy)" />
          <input class="ic-input ic-text-inp" placeholder="Bình luận đoạn này..." />
        </div>
        <div class="ic-send-row" style="margin-top:5px">
          <button class="ic-send-btn" style="width:100%">Gửi ✦</button>
        </div>`;

      bubble.querySelector('.ic-bubble-close').addEventListener('click', (e) => {
        e.stopPropagation(); bubble.classList.remove('open'); currentIdx = null;
      });

      const icKey = 'inline_' + pageKey() + '_p' + idx;
      const icRef = ref(db, 'comments/' + icKey);

      bubble.querySelector('.ic-send-btn').addEventListener('click', async () => {
        const textInp = bubble.querySelector('.ic-text-inp');
        const nameInp = bubble.querySelector('.ic-name-inp');
        const text = (textInp?.value || '').trim();
        if (!text) return;
        const btn = bubble.querySelector('.ic-send-btn');
        btn.disabled = true;
        try {
          await push(icRef, {
            name: (nameInp?.value || '').trim() || 'Khách vô danh',
            text,
            ts: Date.now()
          });
          if (textInp) textInp.value = '';
        } catch(e) {
          alert('Lỗi: ' + e.message);
        }
        btn.disabled = false;
      });

      bubble.querySelectorAll('.ic-delete-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          if (!confirm('Xóa?')) return;
          await remove(ref(db, 'comments/' + icKey + '/' + btn.dataset.id));
        });
      });
    }

    content.querySelectorAll('p').forEach((p, idx) => {
      const trigger = document.createElement('span');
      trigger.className = 'ic-trigger';
      trigger.title = 'Bình luận đoạn này';
      trigger.textContent = '💬';
      p.appendChild(trigger);

      /* Check if paragraph has comments → show faint indicator */
      waitFirebase(({ db, ref, onValue }) => {
        const icKey = 'inline_' + pageKey() + '_p' + idx;
        onValue(ref(db, 'comments/' + icKey), (snap) => {
          const cnt = snap.val() ? Object.keys(snap.val()).length : 0;
          trigger.textContent = cnt > 0 ? `💬${cnt}` : '💬';
          trigger.classList.toggle('has-comments', cnt > 0);

          /* If this para is currently open, refresh */
          if (currentIdx === idx && bubble.classList.contains('open')) {
            renderBubble(idx, snap.val());
            const triggers = content.querySelectorAll('.ic-trigger');
            positionBubble(triggers[idx]);
          }
        });
      });

      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        if (currentIdx === idx && bubble.classList.contains('open')) {
          bubble.classList.remove('open'); currentIdx = null; return;
        }
        currentIdx = idx;

        waitFirebase(({ db, ref, onValue }) => {
          const icKey = 'inline_' + pageKey() + '_p' + idx;
          /* One-time read for initial render, then realtime via the per-trigger listener above */
          onValue(ref(db, 'comments/' + icKey), (snap) => {
            if (currentIdx !== idx) return;
            renderBubble(idx, snap.val());
            bubble.classList.add('open');
            positionBubble(trigger);
            setTimeout(() => bubble.querySelector('.ic-text-inp')?.focus(), 50);
          }, { onlyOnce: true });
        });
      });
    });

    document.addEventListener('click', (e) => {
      if (!e.target.closest('.ic-bubble') && !e.target.closest('.ic-trigger')) {
        bubble.classList.remove('open'); currentIdx = null;
      }
    });

    window.addEventListener('scroll', () => {
      if (bubble.classList.contains('open') && currentIdx !== null) {
        const triggers = content.querySelectorAll('.ic-trigger');
        const t = triggers[currentIdx];
        if (t) positionBubble(t);
      }
    }, { passive: true });
  })();

})();
</script>
</body>
</html>