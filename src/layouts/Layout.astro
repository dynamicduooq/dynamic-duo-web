---
const { frontmatter } = Astro.props;
import settings from '../data/settings.json';

const currentPath = Astro.url?.pathname ?? '';

// Lấy truyen_id từ frontmatter
let currentTruyenId = frontmatter?.truyen_id;

// Lấy danh sách chương nếu có truyen_id
let chapters = [];
if (currentTruyenId) {
    const allPosts = Object.values(import.meta.glob('../pages/**/*.md', { eager: true }));
    chapters = allPosts
        .filter(post => {
            // Chỉ lấy bài có cùng truyen_id VÀ có số chương > 0 (tức là chương thật, không phải trang index)
            return post.frontmatter?.truyen_id === currentTruyenId
                && post.frontmatter?.chuong !== undefined
                && post.frontmatter?.chuong > 0;
        })
        .sort((a, b) => {
            return (a.frontmatter?.chuong ?? 999) - (b.frontmatter?.chuong ?? 999);
        });
}

// Kiểm tra đây có phải trang đọc chương không (chuong > 0)
const isNovelPage = frontmatter?.chuong !== undefined && frontmatter?.chuong > 0;

// Trang index truyện (chuong === 0): hiển thị mục lục dạng danh sách
const isStoryCover = frontmatter?.chuong === 0 && currentTruyenId;

// Prev / Next chapter
const currentIdx = chapters.findIndex(c => c.url === currentPath);
const prevChap = chapters[currentIdx - 1];
const nextChap = chapters[currentIdx + 1];
---

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{frontmatter?.title ?? 'Trang chủ'} | {settings.site_name}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,600;1,6..72,300;1,6..72,400&family=Lora:ital,wght@0,400;0,600;1,400&family=Literata:ital,opsz,wght@0,7..72,300;0,7..72,400;0,7..72,600;1,7..72,300;1,7..72,400&family=Merriweather:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet">

    <style is:global>
        /* ─── BIẾN MÀU ─── */
        :root {
            --sky:       #0ea5e9;
            --sky2:      #0284c7;
            --sky-dark:  #0369a1;
            --sky-light: #bae6fd;
            --sky-pale:  #f0f9ff;
            --cream:     #fafcff;
            --bg-content:#ffffff;
            --text-main: #1e3a4f;
            --text-mid:  #64748b;
            --text-dim:  #94a3b8;
            --sh-card:   0 4px 15px rgba(2,132,199,0.12);
            --sh-soft:   0 2px 8px rgba(0,0,0,0.08);
            --r-sm:      6px;
            --r-md:      12px;
            --r-lg:      18px;
            --r-pill:    999px;
            --t:         all 0.2s ease;
        }

        * { box-sizing: border-box; }

        body {
            background: var(--cream);
            color: var(--text-main);
            font-family: 'Newsreader', serif;
            font-size: 18px;
            line-height: 1.9;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        h1, h2, h3, h4 { font-family: 'Merriweather', serif; color: var(--sky-dark); text-align: center; }
        a { color: inherit; text-decoration: none; }

        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: var(--sky-pale); }
        ::-webkit-scrollbar-thumb { background: var(--sky-light); border-radius: 3px; }

        /* ─── NAVBAR ─── */
        nav {
            position: fixed; top: 0; left: 0; right: 0; z-index: 500;
            display: flex; align-items: center; justify-content: space-between;
            height: 56px; padding: 0 28px;
            background: rgba(255,255,255,.95); backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(186,230,253,.5);
            box-shadow: 0 2px 12px rgba(2,132,199,.08);
        }
        .nav-logo {
            font-family: 'Literata', serif; font-weight: 600; font-size: .95rem;
            color: var(--sky-dark); white-space: nowrap; letter-spacing: .5px;
        }
        .nav-links { display: flex; align-items: center; gap: 2px; }
        .nav-item { position: relative; }
        .nav-item > a, .nav-btn {
            font-family: 'Newsreader', serif; font-size: .76rem; font-weight: 400;
            color: var(--text-mid); letter-spacing: 1px; text-transform: uppercase;
            padding: 6px 12px; border-radius: var(--r-pill);
            display: inline-flex; align-items: center; gap: 5px;
            transition: var(--t); cursor: pointer; background: none; border: none; white-space: nowrap;
        }
        .nav-item > a:hover, .nav-btn:hover,
        .nav-item:hover > a, .nav-item:hover > .nav-btn { background: var(--sky-pale); color: var(--sky); }

        /* Dropdown nav */
        .dropdown-content {
            position: absolute; top: calc(100% + 8px); left: 50%;
            transform: translateX(-50%) translateY(8px);
            min-width: 230px; background: #fff;
            border: 1px solid rgba(186,230,253,.7); border-radius: var(--r-md);
            box-shadow: 0 16px 48px rgba(2,132,199,.13), 0 2px 8px rgba(2,132,199,.06);
            padding: 8px 6px;
            opacity: 0; visibility: hidden; pointer-events: none;
            transition: opacity .22s ease, transform .22s ease; z-index: 600;
        }
        .nav-item:hover .dropdown-content {
            opacity: 1; visibility: visible; pointer-events: auto;
            transform: translateX(-50%) translateY(0);
        }
        .dd-section-title { font-size: .62rem; letter-spacing: 2px; text-transform: uppercase; color: var(--text-dim); padding: 6px 12px 3px; }
        .dd-item { display: flex; align-items: center; gap: 7px; padding: 7px 12px; font-size: .82rem; color: var(--text-mid); border-radius: var(--r-sm); transition: var(--t); }
        .dd-item:hover { background: var(--sky-pale); color: var(--sky); }
        .dd-divider { height: 1px; background: rgba(186,230,253,.45); margin: 5px 8px; }

        /* ─── PAGE WRAPPER ─── */
        .page-wrapper { margin-top: 80px; min-height: 70vh; }
        .container {
            max-width: 800px; margin: 0 auto 60px;
            background-color: rgba(255,255,255,.98);
            padding: 40px 50px; border-radius: var(--r-lg);
            box-shadow: var(--sh-soft); border: 1px solid rgba(186,230,253,.5);
        }

        /* ─── MARKDOWN / CONTENT ─── */
        blockquote {
            font-style: italic; font-size: .9rem; color: var(--text-mid); line-height: 1.75;
            border-left: 3px solid var(--sky-light); margin: 20px 0;
            background: var(--sky-pale); border-radius: 0 12px 12px 0;
            padding: 15px 20px;
        }
        hr { border: none; text-align: center; margin: 40px 0; }
        hr::after { content: "𓆝 𓆟 𓆞 𓆝 𓆟"; color: var(--sky-light); font-size: 20px; letter-spacing: 5px; }

        /* ─── TAG BADGES ─── */
        .tag-badge {
            display: inline-block; padding: 4px 12px;
            border: 1.5px solid var(--sky); border-radius: var(--r-pill);
            font-size: 0.85rem; margin: 4px; color: var(--sky); transition: var(--t);
        }
        .tag-badge:hover { background: var(--sky-pale); }

        /* ─── CHAPTER DROPDOWN ─── */
        .chapter-nav-bar {
            display: flex; align-items: center; justify-content: center;
            gap: 12px; margin: 20px 0; flex-wrap: wrap;
        }
        .chapter-nav-bar a, .chapter-nav-bar button {
            padding: 8px 18px; border-radius: var(--r-pill);
            border: 1.5px solid var(--sky-light); background: var(--sky-pale);
            color: var(--sky-dark); font-size: .85rem; cursor: pointer; transition: var(--t);
            font-family: 'Newsreader', serif;
        }
        .chapter-nav-bar a:hover, .chapter-nav-bar button:hover { background: var(--sky-light); color: #fff; }
        .chapter-nav-bar a.disabled { opacity: .35; pointer-events: none; }

        .chapter-dropdown { position: relative; display: inline-block; }
        .chapter-dropdown summary {
            display: block; padding: 8px 20px;
            background: var(--sky-pale); border: 1.5px solid var(--sky-light);
            border-radius: var(--r-pill); color: var(--sky-dark);
            font-size: 14px; font-weight: bold; cursor: pointer;
            text-align: center; list-style: none; transition: var(--t);
        }
        .chapter-dropdown summary:hover { background: var(--sky-light); color: white; }
        .chapter-list {
            position: absolute; top: 115%; left: 50%; transform: translateX(-50%);
            width: 260px; max-height: 260px; overflow: auto;
            background: var(--bg-content); border: 1px solid var(--sky-light);
            border-radius: var(--r-md); display: flex; flex-direction: column;
            z-index: 10; box-shadow: var(--sh-card);
        }
        .chapter-list a {
            padding: 10px 14px; border-bottom: 1px dashed var(--sky-pale);
            color: var(--text-mid); text-align: center; font-size: 14px; transition: var(--t);
        }
        .chapter-list a:hover { background: var(--sky-pale); color: var(--sky); }
        .chapter-list a.current { color: var(--sky); font-weight: 600; background: var(--sky-pale); }

        /* ─── STORY COVER — mục lục ─── */
        .toc-grid {
            display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
            gap: 8px; margin-top: 16px;
        }
        .toc-grid a {
            display: block; text-align: center; padding: 8px 6px;
            border: 1px solid var(--sky-light); border-radius: var(--r-md);
            font-size: .82rem; color: var(--sky-dark);
            background: var(--sky-pale); transition: var(--t);
        }
        .toc-grid a:hover { background: var(--sky-light); color: #fff; }

        /* ─── READING PROGRESS BAR ─── */
        #readProgress {
            position: fixed; top: 56px; left: 0; height: 3px;
            background: var(--sky); width: 0%; z-index: 490; transition: width .1s linear;
        }

        /* ─── SCROLL BUTTONS ─── */
        .scroll-btns {
            position: fixed; bottom: 24px; right: 22px; z-index: 300;
            display: flex; flex-direction: column; gap: 8px;
        }
        .scroll-btn {
            width: 40px; height: 40px; border-radius: 50%;
            background: var(--sky); color: #fff; border: none;
            cursor: pointer; font-size: 1rem; box-shadow: var(--sh-card);
            opacity: 0; pointer-events: none; transition: var(--t);
            display: flex; align-items: center; justify-content: center;
        }
        .scroll-btn.show { opacity: 1; pointer-events: auto; }
        .scroll-btn:hover { transform: translateY(-2px); background: var(--sky2); }
        #btnDown { opacity: 1; pointer-events: auto; }

        /* ─── FOOTER ─── */
        footer {
            background: #fff; border-top: 1px solid rgba(186,230,253,.4);
            padding: 44px 20px 26px; margin-top: auto;
        }
        .footer-inner {
            max-width: 1120px; margin: 0 auto;
            display: grid; grid-template-columns: 1fr auto 1fr;
            gap: 28px; align-items: start;
        }
        .ft-brand .ft-logo { font-family: 'Literata', serif; font-size: 1.15rem; font-weight: 600; color: var(--sky-dark); display: block; margin-bottom: 5px; }
        .ft-brand p { font-size: .78rem; color: var(--text-dim); font-style: italic; }
        .ft-links { display: flex; flex-direction: column; gap: 7px; align-items: center; }
        .ft-links a { font-size: .76rem; color: var(--text-mid); letter-spacing: 1px; text-transform: uppercase; transition: var(--t); }
        .ft-links a:hover { color: var(--sky); }
        .ft-social { display: flex; flex-direction: column; gap: 7px; align-items: flex-end; }
        .social-ic { width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--sky-light); display: flex; align-items: center; justify-content: center; font-size: .88rem; color: var(--sky); background: var(--sky-pale); transition: var(--t); }
        .social-ic:hover { background: var(--sky-light); transform: translateY(-2px); }
        .ft-bottom { max-width: 1120px; margin: 26px auto 0; padding-top: 16px; border-top: 1px solid rgba(186,230,253,.3); text-align: center; font-size: .7rem; color: var(--text-dim); letter-spacing: 1px; }

        /* ─── RESPONSIVE ─── */
        @media (max-width: 768px) {
            .container { padding: 24px 18px; }
            .footer-inner { grid-template-columns: 1fr; text-align: center; }
            .ft-social { align-items: center; }
        }
    </style>
</head>
<body>
    <!-- Reading progress bar (chỉ hiện trên trang chương) -->
    {isNovelPage && <div id="readProgress"></div>}

    <nav id="navbar">
        <a class="nav-logo" href="/dynamic-duo-web/">dynamic duo 𓆝.°•</a>

        <div class="nav-links">
            <div class="nav-item">
                <a href="/dynamic-duo-web/">Trang chủ</a>
            </div>
            <div class="nav-item">
                <a href="/dynamic-duo-web/about">About</a>
            </div>
            <div class="nav-item">
                <button class="nav-btn">Cá dưới nước <span>▾</span></button>
                <div class="dropdown-content">
                    <div class="dd-section-title">Trang mục</div>
                    <a href="/dynamic-duo-web/ca-duoi-nuoc" class="dd-item">🐠 Tất cả truyện</a>
                    <div class="dd-divider"></div>
                    <div class="dd-section-title">Truyện</div>
                    <a href="/dynamic-duo-web/ca-duoi-nuoc/quan-he-ban-cung-phong" class="dd-item">✦ Quan hệ bạn cùng phòng</a>
                    <a href="/dynamic-duo-web/ca-duoi-nuoc/ha-chay-dong-hoang" class="dd-item">✦ Hạ cháy đồng hoang</a>
                </div>
            </div>
            <div class="nav-item">
                <button class="nav-btn">Cá trên bàn <span>▾</span></button>
                <div class="dropdown-content">
                    <div class="dd-section-title">Trang mục</div>
                    <a href="/dynamic-duo-web/ca-tren-ban" class="dd-item">🍽️ Tất cả truyện</a>
                    <div class="dd-divider"></div>
                    <div class="dd-section-title">Truyện</div>
                    <a href="/dynamic-duo-web/ca-tren-ban/neu-dem-nay-troi-khong-mua" class="dd-item">✦ Nếu đêm nay trời không mưa</a>
                    <a href="/dynamic-duo-web/ca-tren-ban/toi-nghi-chung-toi-sap-chia-tay" class="dd-item">✦ Tôi nghĩ chúng tôi sắp chia tay</a>
                </div>
            </div>
            <div class="nav-item">
                <a href="/dynamic-duo-web/ca-tren-troi">Cá trên trời</a>
            </div>
        </div>
    </nav>

    <div class="page-wrapper">
        <div class="container">

            <!-- Tags -->
            {frontmatter?.tags && (
                <div style="text-align:center;margin-bottom:20px">
                    {frontmatter.tags.map((tag: string) => (
                        <a href={`/dynamic-duo-web/tags/${tag}`} class="tag-badge"># {tag}</a>
                    ))}
                </div>
            )}

            <!-- Dropdown chương (đầu trang) — chỉ hiện khi đọc chương -->
            {isNovelPage && chapters.length > 0 && (
                <div class="chapter-nav-bar">
                    <a href={prevChap?.url ?? '#'} class={prevChap ? '' : 'disabled'}>← Chương trước</a>
                    <details class="chapter-dropdown">
                        <summary>⚓ Chọn chương ▾</summary>
                        <div class="chapter-list">
                            {chapters.map((chap: any) => (
                                <a href={chap.url} class={chap.url === currentPath ? 'current' : ''}>
                                    {chap.frontmatter.title}
                                </a>
                            ))}
                        </div>
                    </details>
                    <a href={nextChap?.url ?? '#'} class={nextChap ? '' : 'disabled'}>Chương sau →</a>
                </div>
            )}

            <!-- Mục lục tự động trên trang cover truyện -->
            {isStoryCover && chapters.length > 0 && (
                <div style="margin-top:32px">
                    <h3 style="text-align:center;color:var(--sky-dark)">🌊 Mục lục</h3>
                    <div class="toc-grid">
                        {chapters.map((chap: any) => (
                            <a href={chap.url}>{chap.frontmatter.title}</a>
                        ))}
                    </div>
                </div>
            )}

            <!-- NỘI DUNG TRANG -->
            <slot />

            <!-- Dropdown chương (cuối trang) — chỉ hiện khi đọc chương -->
            {isNovelPage && chapters.length > 0 && (
                <div class="chapter-nav-bar" style="margin-top:40px">
                    <a href={prevChap?.url ?? '#'} class={prevChap ? '' : 'disabled'}>← Chương trước</a>
                    <details class="chapter-dropdown">
                        <summary>⚓ Chọn chương ▾</summary>
                        <div class="chapter-list">
                            {chapters.map((chap: any) => (
                                <a href={chap.url} class={chap.url === currentPath ? 'current' : ''}>
                                    {chap.frontmatter.title}
                                </a>
                            ))}
                        </div>
                    </details>
                    <a href={nextChap?.url ?? '#'} class={nextChap ? '' : 'disabled'}>Chương sau →</a>
                </div>
            )}

            <!-- Giscus bình luận (chỉ trang chương) -->
            {isNovelPage && (
                <div style="margin-top:60px;border-top:1px dashed var(--sky-light);padding-top:30px">
                    <script src="https://giscus.app/client.js"
                        data-repo="dynamicduooq/dynamic-duo-web"
                        data-repo-id="R_kgDOSn8PYg"
                        data-category="Announcements"
                        data-category-id="DIC_kwDOSn8PYs4C923K"
                        data-mapping="pathname"
                        data-strict="0"
                        data-reactions-enabled="1"
                        data-emit-metadata="0"
                        data-input-position="bottom"
                        data-theme="light"
                        data-lang="vi"
                        crossorigin="anonymous"
                        async>
                    </script>
                </div>
            )}

        </div>
    </div>

    <footer>
        <div class="footer-inner">
            <div class="ft-brand">
                <span class="ft-logo">dynamic duo 𓆝.°•</span>
                <p>paired dreams, boundless gleam.</p>
                <p style="margin-top:5px;font-size:.74rem">✉ dynamicduoq@gmail.com</p>
            </div>
            <div class="ft-links">
                <a href="/dynamic-duo-web/">Trang chủ</a>
                <a href="/dynamic-duo-web/ca-duoi-nuoc">Cá dưới nước</a>
                <a href="/dynamic-duo-web/ca-tren-ban">Cá trên bàn</a>
                <a href="/dynamic-duo-web/ca-tren-troi">Cá trên trời</a>
            </div>
            <div class="ft-social">
                <p style="font-size:.68rem;color:var(--text-dim);letter-spacing:1px;text-transform:uppercase;margin-bottom:6px">Ghé thăm</p>
                <a href="https://dynamicduoq.wordpress.com" target="_blank" class="social-ic" title="WordPress">🌐</a>
            </div>
        </div>
        <div class="ft-bottom">dynamic duo 𓆝.°• · made with 🌊 by Xê &amp; Gờ · 2026</div>
    </footer>

    <!-- Nút cuộn lên / xuống -->
    <div class="scroll-btns">
        <button class="scroll-btn" id="btnTop" onclick="window.scrollTo({top:0,behavior:'smooth'})">↑</button>
        <button class="scroll-btn" id="btnDown" onclick="window.scrollTo({top:document.body.scrollHeight,behavior:'smooth'})">↓</button>
    </div>

    <script is:inline>
        // Hiện/ẩn nút cuộn + progress bar
        window.addEventListener('scroll', () => {
            const scrollY = window.scrollY;
            document.getElementById('btnTop')?.classList.toggle('show', scrollY > 300);

            // Reading progress
            const bar = document.getElementById('readProgress');
            if (bar) {
                const total = document.body.scrollHeight - window.innerHeight;
                bar.style.width = total > 0 ? (scrollY / total * 100) + '%' : '0%';
            }
        });

        // Keyboard navigation: ← → cho trang chương
        document.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft') {
                const prev = document.querySelector('.chapter-nav-bar a:first-child:not(.disabled)');
                if (prev) prev.click();
            }
            if (e.key === 'ArrowRight') {
                const next = document.querySelector('.chapter-nav-bar a:last-child:not(.disabled)');
                if (next) next.click();
            }
        });

        // Đóng dropdown khi click ra ngoài
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.chapter-dropdown')) {
                document.querySelectorAll('.chapter-dropdown[open]').forEach(d => d.removeAttribute('open'));
            }
        });
    </script>
</body>
</html>