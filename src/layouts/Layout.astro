    window.__ddIsAdmin = false;

    if (auth) {
      onAuthStateChanged(auth, user => {
        window.__ddIsAdmin = !!(user && user.email === ADMIN_EMAIL);
        window.dispatchEvent(new CustomEvent('dd-auth-change', { detail: { isAdmin: window.__ddIsAdmin, user } }));
      });
    }
    window.dispatchEvent(new Event('dd-firebase-ready'));
  </script>

  <script is:inline>
    // Khởi tạo Theme & Settings ngay lập tức
    (function(){
      const t = localStorage.getItem('dd-theme');
      if (t === 'dark') document.documentElement.setAttribute('data-theme','dark');
      
      const fz = localStorage.getItem('dd_fz');
      const ff = localStorage.getItem('dd_ff');
      if(fz) document.documentElement.style.setProperty('--read-fz', fz + 'px');
      if(ff) document.documentElement.style.setProperty('--read-ff', ff);
    })();
  </script>

  <style is:global>
    /* ── VARIABLES ── */
    :root {
      --sky:#0ea5e9; --sky2:#0284c7; --sky-dark:#0369a1;
      --sky-light:#bae6fd; --sky-pale:#f0f9ff;
      --cream:#fafcff;
      --text-main:#1e3a5f; --text-mid:#64748b; --text-dim:#94a3b8;
      --sh-card:0 4px 15px rgba(2,132,199,.12);
      --sh-soft:0 2px 8px rgba(0,0,0,.08);
      --r-sm:6px; --r-md:12px; --r-lg:20px; --r-pill:999px;
      --t:all .2s ease;
      --read-fz: 18px;
      --read-ff: 'Newsreader', serif;
      --bg-card:#ffffff;
      --bg-card2:#f0f9ff;
      --border-card:rgba(186,230,253,.5);
    }

    [data-theme="dark"] {
      --sky:#7ec8e3; --sky2:#a8daf0; --sky-dark:#c5e8f5;
      --sky-light:#1e4a6a; --sky-pale:#0d2035;
      --cream:#0a1929;
      --text-main:#F3F9FF; --text-mid:#8fbcd4; --text-dim:#527a96;
      --bg-card:#0f2336;
      --bg-card2:#0d2035;
      --border-card:rgba(126,200,227,.15);
    }

    *, *::before, *::after { box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { 
      background:var(--cream); color:var(--text-main); 
      font-family:var(--read-ff); 
      font-size:var(--read-fz); 
      line-height:1.9; margin:0; padding:0; overflow-x:hidden; 
      transition: font-size 0.2s, font-family 0.2s, background-color 0.2s, color 0.2s; 
    }
    
    [data-theme="dark"] body { background:#0a1929; color:#F3F9FF; }
    h1,h2,h3,h4 { font-family:'Merriweather',serif; color:var(--sky-dark); text-align:center; }
    [data-theme="dark"] h1, [data-theme="dark"] h2, [data-theme="dark"] h3, [data-theme="dark"] h4 { color:#a8daf0; }
    a { color:inherit; text-decoration:none; }
    ::-webkit-scrollbar { width:5px; }
    ::-webkit-scrollbar-track { background:var(--sky-pale); }
    ::-webkit-scrollbar-thumb { background:var(--sky-light); border-radius:3px; }

    #read-progress { position:fixed; top:0; left:0; height:3px; z-index:9999; background:linear-gradient(90deg,var(--sky-light),var(--sky),var(--sky2)); width:0%; transition:width .1s linear; pointer-events:none; }

    /* ── NAVBAR & DROPDOWN (FIXED HOVER) ── */
    nav { 
      position:fixed; top:0; left:0; right:0; z-index:500; 
      display:flex; align-items:center; height:56px; padding:0 28px; 
      background:rgba(255,255,255,.97); backdrop-filter:blur(16px); 
      border-bottom:1px solid var(--border-card); box-shadow:0 2px 12px rgba(2,132,199,.08); 
    }
    
    [data-theme="dark"] nav { 
      background:rgba(8,18,32,.98); border-color:rgba(126,200,227,.15); 
    }

    .nav-logo { 
      font-family:'Literata',serif; font-weight:600; font-size:.95rem; 
      color:var(--sky-dark); white-space:nowrap; letter-spacing:.5px; margin-right: auto; 
    }
    [data-theme="dark"] .nav-logo { color:#a8daf0; }

    /* SỬA LỖI NAVBAR HOVER */
    .nav-links { display:flex; align-items:center; gap:5px; }
    .nav-item { position:relative; display:flex; align-items:center; height:56px; }
    
    /* "Cầu nối" tàng hình giúp hover không bị mất chuột khi di chuyển xuống menu */
    .nav-item::before {
      content: ""; 
      position: absolute; 
      top: 0; 
      left: 0; 
      width: 100%; 
      height: 70px; /* Tạo vùng đệm 70px để giữ menu luôn mở khi chuột rà qua */
      z-index: -1;
    }

    .nav-item > a, .nav-btn { 
      font-family:'Newsreader',serif; font-size:.76rem; color:var(--text-mid); 
      letter-spacing:1px; text-transform:uppercase; padding:6px 12px; 
      border-radius:var(--r-pill); display:inline-flex; align-items:center; 
      gap:5px; transition:var(--t); cursor:pointer; background:none; 
      border:none; white-space:nowrap; 
    }

    .nav-item > a:hover, .nav-btn:hover, .nav-item:hover > a, .nav-item:hover > .nav-btn { 
      background:var(--sky-pale); color:var(--sky); 
    }
    [data-theme="dark"] .nav-item > a, [data-theme="dark"] .nav-btn { color:#8fbcd4; }
    [data-theme="dark"] .nav-item > a:hover, [data-theme="dark"] .nav-btn:hover, 
    [data-theme="dark"] .nav-item:hover > a, [data-theme="dark"] .nav-item:hover > .nav-btn { 
      color:#7ec8e3; background:rgba(126,200,227,.1); 
    }
    
    /* KHUNG MENU THẢ XUỐNG */
    .dropdown-content { 
      position:absolute; 
      top: 100%; /* Sát mép dưới của nav-item */
      left:50%; 
      transform:translateX(-50%) translateY(8px); 
      min-width:240px; 
      background:var(--bg-card); 
      border:1px solid var(--border-card); 
      border-radius:var(--r-md); 
      box-shadow:0 16px 48px rgba(2,132,199,.13); 
      padding:8px 6px; 
      opacity:0; 
      visibility:hidden; 
      pointer-events:none; 
      transition: all 0.2s ease-out; 
      z-index:600; 
    }

    [data-theme="dark"] .dropdown-content { box-shadow:0 16px 48px rgba(0,0,0,.4); }

    /* Hiệu ứng khi lướt chuột qua */
    .nav-item:hover .dropdown-content { 
      opacity:1; 
      visibility:visible; 
      pointer-events:auto; 
      transform:translateX(-50%) translateY(0); 
    }

    /* Các mục bên trong Dropdown */
    .dd-section-title { 
      font-size:.62rem; letter-spacing:2px; text-transform:uppercase; 
      color:var(--text-dim); padding:6px 12px 3px; 
    }
    [data-theme="dark"] .dd-section-title { color:#3d6a82; }

    .dd-item { 
      display:flex; align-items:center; gap:7px; padding:7px 12px; 
      font-size:.82rem; color:var(--text-mid); border-radius:var(--r-sm); 
      transition:var(--t); 
    }
    .dd-item:hover { background:var(--sky-pale); color:var(--sky); }
    [data-theme="dark"] .dd-item { color:#8fbcd4; }
    [data-theme="dark"] .dd-item:hover { background:rgba(126,200,227,.1); color:#F3F9FF; }

    .dd-divider { height:1px; background:rgba(186,230,253,.45); margin:5px 8px; }

/* ── MOBILE MENU (Sửa lỗi rớt chữ xuống trang) ── */
