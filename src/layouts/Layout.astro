---
const { frontmatter } = Astro.props;
import settings from '../data/settings.json';

const currentPath = Astro.url?.pathname ?? '';
let currentTruyenId = frontmatter?.truyen_id;

let chapters = [];
if (currentTruyenId) {
    const allPosts = Object.values(import.meta.glob('../pages/**/*.md', { eager: true }));
    chapters = allPosts
        .filter(post => post.frontmatter?.truyen_id === currentTruyenId)
        .sort((a, b) => {
            const parseChapter = (post) => {
                if (post.frontmatter?.chuong !== undefined) return post.frontmatter.chuong;
                const match = (post.url || '').match(/chuong-(\d+)/i);
                return match ? parseInt(match[1]) : 999;
            };
            return parseChapter(a) - parseChapter(b);
        });
}

const isNovelPage = frontmatter?.chuong !== undefined;
const currentIdx = chapters.findIndex(c => c.url === currentPath || c.url === currentPath.replace(/\/$/, ''));
const prevChap = currentIdx > 0 ? chapters[currentIdx - 1] : null;
const nextChap = currentIdx !== -1 && currentIdx < chapters.length - 1 ? chapters[currentIdx + 1] : null;
---

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{frontmatter?.title || 'Trang chủ'} | {settings.site_name}</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,600;1,6..72,300;1,6..72,400&family=Literata:ital,opsz,wght@0,7..72,300;0,7..72,400;0,7..72,600;1,7..72,300;1,7..72,400&family=Merriweather:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet">
    
    <style is:global>
        :root {
            --sky: #0ea5e9;
            --sky2: #0284c7;
            --sky-dark: #0369a1;
            --sky-light: #bae6fd;
            --sky-pale: #f0f9ff;
            --cream: #f8fbff;
            --bg-content: #ffffff;
            --text-main: #334155;
            --text-mid: #64748b;
            --text-dim: #94a3b8;
            --sh-card: 0 4px 15px rgba(2,132,199,0.12);
            --sh-soft: 0 2px 8px rgba(0,0,0,0.08);
            --r-sm: 8px;
            --r-md: 12px;
            --r-lg: 18px;
            --r-pill: 999px;
            --t: all 0.2s ease;
        }

        * { box-sizing: border-box; }

        body {
            background: var(--cream);
            color: var(--text-main);
            font-family: 'Newsreader', serif;
            font-size: 18px;
            line-height: 1.9;
            margin: 0; padding: 0; overflow-x: hidden;
        }

        h1, h2, h3, h4 { font-family: 'Merriweather', serif; color: var(--sky-dark); text-align: center; }
        a { color: inherit; text-decoration: none; }
        
        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: var(--sky-pale); }
        ::-webkit-scrollbar-thumb { background: var(--sky-light); border-radius: 3px; }

        /* ─── MARQUEE (FIX #4: editable notice bar) ─── */
        .marquee-bar {
            background: linear-gradient(90deg, var(--sky-pale) 0%, #e0f2fe 50%, var(--sky-pale) 100%);
            border-bottom: 1px solid rgba(186,230,253,.6);
            padding: 7px 0;
            overflow: hidden;
            position: fixed; top: 56px; left: 0; right: 0; z-index: 490;
        }
        .marquee-track {
            display: flex; gap: 60px;
            animation: marquee-scroll 35s linear infinite;
            white-space: nowrap;
        }
        .marquee-track:hover { animation-play-state: paused; }
        .marquee-item {
            font-size: 0.78rem; color: var(--sky-dark); letter-spacing: 0.3px;
            flex-shrink: 0;
        }
        .marquee-dot { color: var(--sky-light); margin: 0 6px; }
        @keyframes marquee-scroll {
            0%   { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        /* ─── NAVBAR ─── */
        nav { 
            position: fixed; top: 0; left: 0; right: 0; z-index: 500; 
            display: flex; align-items: center; justify-content: space-between; 
            height: 56px; padding: 0 28px; 
            background: rgba(255,255,255,.95); backdrop-filter: blur(16px); 
            border-bottom: 1px solid rgba(186,230,253,.5);
            box-shadow: 0 2px 12px rgba(2,132,199,.08);
        }
        .nav-logo { font-family: 'Literata', serif; font-weight: 600; font-size: .95rem; color: var(--sky-dark); white-space: nowrap; letter-spacing: .5px; }
        .nav-links { display: flex; align-items: center; gap: 2px; }
        .nav-item { position: relative; }
        .nav-item > a, .nav-btn { 
            font-family: 'Newsreader', serif; font-size: .76rem; font-weight: 400; 
            color: var(--text-mid); letter-spacing: 1px; text-transform: uppercase; 
            padding: 6px 12px; border-radius: var(--r-pill); display: inline-flex; align-items: center; gap: 5px; 
            transition: var(--t); cursor: pointer; background: none; border: none; white-space: nowrap; 
        }
        .nav-item > a:hover, .nav-btn:hover, .nav-item:hover > a, .nav-item:hover > .nav-btn { background: var(--sky-pale); color: var(--sky); }
        .dropdown-content { 
            position: absolute; top: calc(100% + 8px); left: 50%; transform: translateX(-50%) translateY(8px); 
            min-width: 230px; background: #fff; border: 1px solid rgba(186,230,253,.7); border-radius: var(--r-md); 
            box-shadow: 0 16px 48px rgba(2,132,199,.13); padding: 8px 6px; 
            opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .22s ease, transform .22s ease; z-index: 600; 
        }
        .nav-item:hover .dropdown-content { opacity: 1; visibility: visible; pointer-events: auto; transform: translateX(-50%) translateY(0); }
        .dd-section-title { font-size: .62rem; letter-spacing: 2px; text-transform: uppercase; color: var(--text-dim); padding: 6px 12px 3px; }
        .dd-item { display: flex; align-items: center; gap: 7px; padding: 7px 12px; font-size: .82rem; color: var(--text-mid); border-radius: var(--r-sm); transition: var(--t); }
        .dd-item:hover { background: var(--sky-pale); color: var(--sky); }
        .dd-divider { height: 1px; background: rgba(186,230,253,.45); margin: 5px 8px; }

        /* ─── LAYOUT ─── */
        .page-wrapper {
            /* FIX #3: tight margins, proper spacing */
            margin-top: 112px; /* nav 56px + marquee ~34px + buffer */
            min-height: 70vh;
            padding: 0 16px;
        }
        .container { 
            max-width: 860px; margin: 0 auto 60px;
            background-color: rgba(255,255,255,.98); 
            padding: 36px 44px;
            border-radius: var(--r-lg);
            box-shadow: var(--sh-soft);
            border: 1px solid rgba(186,230,253,.5);
        }

        /* ─── FIX #2: Justify text in novel pages ─── */
        .novel-content p {
            text-align: justify;
            hyphens: auto;
        }

        /* ─── FIX #3: Notice/rules box on homepage ─── */
        .notice-box {
            background: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 100%);
            border: 1.5px dashed var(--sky-light);
            border-radius: var(--r-md);
            padding: 20px 26px;
            margin: 28px 0;
            font-size: 0.88rem;
            color: var(--text-mid);
            line-height: 1.8;
        }
        .notice-box h4 {
            text-align: left;
            font-size: 0.82rem;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--sky);
            margin: 0 0 10px;
        }
        .notice-box ul { margin: 0; padding-left: 18px; }
        .notice-box li { margin: 4px 0; }

        /* Markdown */
        blockquote { font-style: italic; font-size: .9rem; color: var(--text-mid); line-height: 1.75; border-left: 3px solid var(--sky-light); padding: 15px 20px; margin: 20px 0; background: var(--sky-pale); border-radius: 0 12px 12px 0;}
        hr { border: none; text-align: center; margin: 40px 0; }
        hr::after { content: "𓆝 𓆟 𓆞 𓆝 𓆟"; color: var(--sky-light); font-size: 20px; letter-spacing: 5px; }

        /* Tags */
        .tag-badge { display: inline-block; padding: 4px 12px; border: 1.5px solid var(--sky); border-radius: var(--r-pill); font-size: 0.85rem; margin: 4px; color: var(--sky); transition: var(--t); }
        .tag-badge:hover { background: var(--sky-pale); }

        /* ─── FIX #5: Chapter nav - prev/next as proper links ─── */
        .chapter-nav-bar {
            display: flex; align-items: center; justify-content: center;
            gap: 10px; margin: 32px 0 0; flex-wrap: wrap;
        }
        .chap-nav-btn {
            padding: 10px 20px; border-radius: var(--r-pill);
            border: 1.5px solid var(--sky-light); background: white;
            color: var(--sky-dark); font-family: 'Newsreader', serif;
            font-size: 0.88rem; cursor: pointer; transition: var(--t);
            text-decoration: none; display: inline-flex; align-items: center; gap: 6px;
        }
        .chap-nav-btn:hover { background: var(--sky-pale); border-color: var(--sky); }
        .chap-nav-btn.disabled { opacity: 0.35; pointer-events: none; }
        .chap-select-wrap { position: relative; }
        .chap-select-btn {
            padding: 10px 20px; border-radius: var(--r-pill);
            border: 2px solid var(--sky); background: var(--sky);
            color: white; font-family: 'Newsreader', serif;
            font-size: 0.88rem; cursor: pointer; transition: var(--t);
            display: inline-flex; align-items: center; gap: 6px;
        }
        .chap-select-btn:hover { background: var(--sky2); border-color: var(--sky2); }
        .chap-dropdown-list {
            position: absolute; top: calc(100% + 8px); left: 50%;
            transform: translateX(-50%);
            width: 200px; max-height: 260px; overflow-y: auto;
            background: white; border: 1px solid var(--sky-light);
            border-radius: var(--r-md); box-shadow: var(--sh-card);
            z-index: 200;
            display: none;
        }
        .chap-dropdown-list.open { display: block; }
        .chap-dropdown-list a {
            display: block; padding: 10px 16px;
            font-size: 0.85rem; color: var(--text-mid);
            border-bottom: 1px dashed rgba(186,230,253,.5);
            text-align: center; transition: var(--t);
        }
        .chap-dropdown-list a:hover { background: var(--sky-pale); color: var(--sky); }
        .chap-dropdown-list a.active { color: var(--sky); font-weight: bold; background: #e0f2fe; }

        /* ─── FIX #1: Inline paragraph comments ─── */
        .novel-content p {
            position: relative;
        }
        .p-comment-btn {
            display: none;
            position: absolute; right: -38px; top: 2px;
            width: 26px; height: 26px;
            border-radius: 50%;
            border: 1.5px solid var(--sky-light);
            background: white; color: var(--sky);
            font-size: 12px; cursor: pointer;
            align-items: center; justify-content: center;
            box-shadow: 0 2px 8px rgba(14,165,233,.15);
            transition: var(--t); z-index: 50;
            line-height: 1;
        }
        .novel-content p:hover .p-comment-btn { display: flex; }
        .p-comment-btn:hover { background: var(--sky-pale); transform: scale(1.1); }

        /* Inline comment popover */
        .inline-comment-popover {
            position: absolute; right: -280px; top: 0;
            width: 260px; z-index: 100;
            background: white;
            border: 1.5px solid var(--sky-light);
            border-radius: var(--r-md);
            box-shadow: 0 8px 30px rgba(2,132,199,.14);
            padding: 14px;
            display: none;
            animation: pop-in .18s ease;
        }
        @keyframes pop-in {
            from { opacity: 0; transform: scale(.95) translateY(4px); }
            to   { opacity: 1; transform: scale(1) translateY(0); }
        }
        .inline-comment-popover.open { display: block; }
        .icm-header {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 10px;
        }
        .icm-title { font-size: 0.72rem; letter-spacing: 1px; text-transform: uppercase; color: var(--sky); font-weight: bold; }
        .icm-close { background: none; border: none; cursor: pointer; color: var(--text-dim); font-size: 14px; padding: 0; line-height: 1; }
        .icm-comments-list { max-height: 140px; overflow-y: auto; margin-bottom: 10px; }
        .icm-comment-item {
            background: var(--sky-pale); border-radius: var(--r-sm);
            padding: 7px 10px; margin-bottom: 6px; font-size: 0.78rem; color: var(--text-main); line-height: 1.55;
        }
        .icm-comment-item .icm-name { color: var(--sky-dark); font-weight: bold; font-size: 0.72rem; }
        .icm-comment-item .icm-time { color: var(--text-dim); font-size: 0.68rem; float: right; }
        .icm-empty { font-size: 0.75rem; color: var(--text-dim); text-align: center; font-style: italic; padding: 8px 0; }
        .icm-input-row { display: flex; gap: 6px; }
        .icm-input {
            flex: 1; padding: 6px 10px; border: 1.5px solid var(--sky-light);
            border-radius: var(--r-pill); font-size: 0.78rem;
            font-family: 'Newsreader', serif; outline: none;
            transition: var(--t); background: var(--sky-pale);
            color: var(--text-main);
        }
        .icm-input:focus { border-color: var(--sky); background: white; }
        .icm-send-btn {
            padding: 6px 12px; background: var(--sky); color: white;
            border: none; border-radius: var(--r-pill); cursor: pointer;
            font-size: 0.78rem; transition: var(--t);
        }
        .icm-send-btn:hover { background: var(--sky2); }
        .icm-name-input {
            width: 100%; padding: 6px 10px; border: 1.5px solid var(--sky-light);
            border-radius: var(--r-pill); font-size: 0.75rem;
            font-family: 'Newsreader', serif; outline: none;
            transition: var(--t); background: var(--sky-pale);
            color: var(--text-main); margin-bottom: 6px;
        }
        .icm-name-input:focus { border-color: var(--sky); background: white; }

        /* ─── FOOTER ─── */
        footer { background: #fff; border-top: 1px solid rgba(186,230,253,.4); padding: 44px 20px 26px; margin-top: auto;}
        .footer-inner { max-width: 1120px; margin: 0 auto; display: grid; grid-template-columns: 1fr auto 1fr; gap: 28px; align-items: start; }
        .ft-brand .ft-logo { font-family: 'Literata', serif; font-size: 1.15rem; font-weight: 600; color: var(--sky-dark); display: block; margin-bottom: 5px; }
        .ft-brand p { font-size: .78rem; color: var(--text-dim); font-style: italic; }
        .ft-links { display: flex; flex-direction: column; gap: 7px; align-items: center; }
        .ft-links a { font-size: .76rem; color: var(--text-mid); letter-spacing: 1px; text-transform: uppercase; transition: var(--t); }
        .ft-links a:hover { color: var(--sky); }
        .ft-social { display: flex; flex-direction: column; gap: 7px; align-items: flex-end; }
        .social-ic { width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--sky-light); display: flex; align-items: center; justify-content: center; font-size: .88rem; color: var(--sky); background: var(--sky-pale); transition: var(--t); }
        .social-ic:hover { background: var(--sky-light); transform: translateY(-2px); }
        .ft-bottom { max-width: 1120px; margin: 26px auto 0; padding-top: 16px; border-top: 1px solid rgba(186,230,253,.3); text-align: center; font-size: .7rem; color: var(--text-dim); letter-spacing: 1px; }

        .back-top { position: fixed; bottom: 24px; right: 22px; z-index: 300; width: 40px; height: 40px; border-radius: 50%; background: var(--sky); color: #fff; border: none; cursor: pointer; font-size: 1rem; box-shadow: var(--sh-card); opacity: 0; pointer-events: none; transition: var(--t); display: flex; align-items: center; justify-content: center; }
        .back-top.show { opacity: 1; pointer-events: auto; }
        .back-top:hover { transform: translateY(-3px); background: var(--sky2); }

        /* Responsive fix */
        @media (max-width: 700px) {
            .container { padding: 24px 18px; }
            .inline-comment-popover { right: 0; top: 32px; width: 230px; }
            .p-comment-btn { right: -4px; top: -28px; display: flex; opacity: 0; }
            .novel-content p:hover .p-comment-btn { opacity: 1; }
        }
    </style>
</head>
<body>
    <!-- NAVBAR -->
    <nav class="navbar" id="navbar">
        <a class="nav-logo" href="/dynamic-duo-web/">dynamic duo 𓆝.°•</a>
        <div class="nav-links">
            <div class="nav-item">
                <a href="/dynamic-duo-web/">Trang chủ</a>
            </div>
            <div class="nav-item">
                <button class="nav-btn">Cá dưới nước <span class="nav-caret">▾</span></button>
                <div class="dropdown-content">
                    <div class="dd-section-title">Trang mục</div>
                    <a href="/dynamic-duo-web/ca-duoi-nuoc" class="dd-item">🐠 Tất cả truyện</a>
                    <div class="dd-divider"></div>
                    <div class="dd-section-title">Truyện</div>
                    <a href="/dynamic-duo-web/ca-duoi-nuoc/quan-he-ban-cung-phong" class="dd-item">✦ Quan hệ bạn cùng phòng</a>
                    <a href="/dynamic-duo-web/ca-duoi-nuoc/ha-chay-dong-hoang" class="dd-item">✦ Hạ cháy đồng hoang</a>
                </div>
            </div>
            <div class="nav-item">
                <button class="nav-btn">Cá trên bàn <span class="nav-caret">▾</span></button>
                <div class="dropdown-content">
                    <div class="dd-section-title">Trang mục</div>
                    <a href="/dynamic-duo-web/ca-tren-ban" class="dd-item">🍽️ Tất cả truyện</a>
                    <div class="dd-divider"></div>
                    <div class="dd-section-title">Truyện</div>
                    <a href="/dynamic-duo-web/ca-tren-ban/neu-dem-nay-troi-khong-mua" class="dd-item">✦ Nếu đêm nay trời không mưa</a>
                    <a href="/dynamic-duo-web/ca-tren-ban/toi-nghi-chung-toi-sap-chia-tay" class="dd-item">✦ Tôi nghĩ chúng tôi sắp chia tay</a>
                </div>
            </div>
            <div class="nav-item">
                <a href="/dynamic-duo-web/ca-tren-troi">Cá trên trời</a>
            </div>
        </div>
    </nav>

    <!-- FIX #4: MARQUEE – editable in settings.json field "marquee_messages" -->
    <div class="marquee-bar" aria-label="Thông báo">
        <div class="marquee-track" id="marqueeTrack">
            <!-- Populated by JS below from settings -->
        </div>
    </div>

    <div class="page-wrapper">
        <div class="container">
            {frontmatter?.tags && (
                <div style="text-align: center; margin-bottom: 25px;">
                    {frontmatter.tags.map(tag => (
                        <a href={`/dynamic-duo-web/tags/${tag}`} class="tag-badge"># {tag}</a>
                    ))}
                </div>
            )}

            <!-- FIX #5: Chapter nav TOP - proper prev/next navigation -->
            {isNovelPage && chapters.length > 0 && (
                <div class="chapter-nav-bar">
                    <a
                        href={prevChap ? prevChap.url : '#'}
                        class={`chap-nav-btn${!prevChap ? ' disabled' : ''}`}
                    >← Chương trước</a>

                    <div class="chap-select-wrap" id="chapWrapTop">
                        <button class="chap-select-btn" onclick="toggleChapDrop('chapDropTop', 'chapDropBot')">
                            ⚓ Chọn chương ▾
                        </button>
                        <div class="chap-dropdown-list" id="chapDropTop">
                            {chapters.map((chap) => (
                                <a
                                    href={chap.url}
                                    class={chap.url === currentPath ? 'active' : ''}
                                >{chap.frontmatter.title}</a>
                            ))}
                        </div>
                    </div>

                    <a
                        href={nextChap ? nextChap.url : '#'}
                        class={`chap-nav-btn${!nextChap ? ' disabled' : ''}`}
                    >Chương sau →</a>
                </div>
            )}

            <!-- FIX #1 & #2: novel-content wrapper for justify + inline comments -->
            {isNovelPage ? (
                <div class="novel-content" id="novelContent">
                    <slot />
                </div>
            ) : (
                <slot />
            )}

            <!-- FIX #5: Chapter nav BOTTOM -->
            {isNovelPage && chapters.length > 0 && (
                <div class="chapter-nav-bar" style="margin-top: 40px; margin-bottom: 20px;">
                    <a
                        href={prevChap ? prevChap.url : '#'}
                        class={`chap-nav-btn${!prevChap ? ' disabled' : ''}`}
                    >← Chương trước</a>

                    <div class="chap-select-wrap" id="chapWrapBot">
                        <button class="chap-select-btn" onclick="toggleChapDrop('chapDropBot', 'chapDropTop')">
                            ⚓ Chọn chương ▾
                        </button>
                        <div class="chap-dropdown-list" id="chapDropBot">
                            {chapters.map((chap) => (
                                <a
                                    href={chap.url}
                                    class={chap.url === currentPath ? 'active' : ''}
                                >{chap.frontmatter.title}</a>
                            ))}
                        </div>
                    </div>

                    <a
                        href={nextChap ? nextChap.url : '#'}
                        class={`chap-nav-btn${!nextChap ? ' disabled' : ''}`}
                    >Chương sau →</a>
                </div>
            )}

            <!-- Giscus comment section (global) -->
            {isNovelPage && (
                <div style="margin-top: 60px; border-top: 1px dashed var(--sky-light); padding-top: 30px;">
                    <p style="text-align:center; font-size:.8rem; color:var(--text-dim); letter-spacing:1px; text-transform:uppercase; margin-bottom:20px;">💬 Bình luận tổng</p>
                    <script src="https://giscus.app/client.js"
                            data-repo="dynamicduooq/dynamic-duo-web"
                            data-repo-id="R_kgDOSn8PYg"
                            data-category="Announcements"
                            data-category-id="DIC_kwDOSn8PYs4C923K"
                            data-mapping="pathname"
                            data-strict="0"
                            data-reactions-enabled="1"
                            data-emit-metadata="0"
                            data-input-position="bottom"
                            data-theme="light"
                            data-lang="vi"
                            crossorigin="anonymous"
                            async>
                    </script>
                </div>
            )}
        </div>
    </div>

    <footer>
        <div class="footer-inner">
            <div class="ft-brand">
                <span class="ft-logo">dynamic duo 𓆝.°•</span>
                <p>paired dreams, boundless gleam.</p>
                <p style="margin-top:5px;font-size:.74rem">✉ dynamicduoq@gmail.com</p>
            </div>
            <div class="ft-links">
                <a href="/dynamic-duo-web/">Trang chủ</a>
                <a href="/dynamic-duo-web/ca-duoi-nuoc">Cá dưới nước</a>
                <a href="/dynamic-duo-web/ca-tren-ban">Cá trên bàn</a>
            </div>
            <div class="ft-social">
                <p style="font-size:.68rem;color:var(--text-dim);letter-spacing:1px;text-transform:uppercase;margin-bottom:6px">Ghé thăm</p>
                <a href="https://dynamicduoq.wordpress.com" target="_blank" class="social-ic" title="WordPress">🌐</a>
            </div>
        </div>
        <div class="ft-bottom">dynamic duo 𓆝.°• · made with 🌊 by Xê &amp; Gờ · 2026</div>
    </footer>

    <button class="back-top" id="backTop" onclick="scrollTo({top:0,behavior:'smooth'})">↑</button>

    <script is:inline>
        // ── Back to top ──
        window.addEventListener('scroll', () => {
            document.getElementById('backTop').classList.toggle('show', scrollY > 300);
        });

        // ── FIX #5: Chapter dropdown toggle ──
        function toggleChapDrop(id, otherId) {
            const el = document.getElementById(id);
            const other = document.getElementById(otherId);
            if (other) other.classList.remove('open');
            el.classList.toggle('open');
        }
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.chap-select-wrap')) {
                document.querySelectorAll('.chap-dropdown-list').forEach(d => d.classList.remove('open'));
            }
        });
        // Scroll active chapter into view when dropdown opens
        document.querySelectorAll('.chap-select-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                setTimeout(() => {
                    const wrap = btn.closest('.chap-select-wrap');
                    const active = wrap?.querySelector('.chap-dropdown-list a.active');
                    if (active) active.scrollIntoView({ block: 'center' });
                }, 50);
            });
        });

        // ── FIX #4: Marquee – reads from settings or fallback ──
        (function() {
            const track = document.getElementById('marqueeTrack');
            if (!track) return;
            // Default messages – replace by reading from settings.json via a data attribute if needed
            const msgs = (window.__MARQUEE_MSGS__ && window.__MARQUEE_MSGS__.length)
                ? window.__MARQUEE_MSGS__
                : [
                    "mừng đến với dynamic duo 𓆝.°•",
                    "paired dreams, boundless gleam",
                    "Nếu đêm nay trời không mưa – Hoàn thành · 76 chương",
                    "Tôi nghĩ chúng tôi sắp chia tay – Đang cập nhật",
                    "✉ dynamicduoq@gmail.com"
                ];
            // Duplicate for seamless loop
            const all = [...msgs, ...msgs];
            track.innerHTML = all.map(m =>
                `<span class="marquee-item">✦ <span class="marquee-dot"></span>${m}</span>`
            ).join('');
        })();

        // ── FIX #1: Inline paragraph comments ──
        (function() {
            const content = document.getElementById('novelContent');
            if (!content) return;

            const STORAGE_KEY = 'dd_inline_comments';
            function loadComments() {
                try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); } catch { return {}; }
            }
            function saveComments(data) {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
            }

            const pageKey = location.pathname;
            const allComments = loadComments();
            if (!allComments[pageKey]) allComments[pageKey] = {};

            let openPopoverId = null;

            content.querySelectorAll('p').forEach((p, i) => {
                const pid = `p_${i}`;
                p.style.position = 'relative';
                p.style.paddingRight = '40px';

                // Comment button
                const btn = document.createElement('button');
                btn.className = 'p-comment-btn';
                btn.innerHTML = '💬';
                btn.title = 'Bình luận đoạn này';
                btn.setAttribute('data-pid', pid);
                p.appendChild(btn);

                // Popover
                const popover = document.createElement('div');
                popover.className = 'inline-comment-popover';
                popover.id = `icm_${pid}`;
                popover.innerHTML = `
                    <div class="icm-header">
                        <span class="icm-title">💬 Bình luận</span>
                        <button class="icm-close" data-pid="${pid}">✕</button>
                    </div>
                    <div class="icm-comments-list" id="icm-list-${pid}"></div>
                    <input class="icm-name-input" id="icm-name-${pid}" placeholder="Tên bạn (không bắt buộc)" maxlength="30" />
                    <div class="icm-input-row">
                        <input class="icm-input" id="icm-input-${pid}" placeholder="Nhận xét đoạn này..." maxlength="200" />
                        <button class="icm-send-btn" data-pid="${pid}">✦</button>
                    </div>
                `;
                p.appendChild(popover);

                function renderComments() {
                    const list = document.getElementById(`icm-list-${pid}`);
                    const comments = (allComments[pageKey][pid] || []);
                    if (!comments.length) {
                        list.innerHTML = '<p class="icm-empty">Chưa có bình luận nào~</p>';
                        return;
                    }
                    list.innerHTML = comments.map(c => `
                        <div class="icm-comment-item">
                            <span class="icm-name">${c.name || 'Độc giả'}</span>
                            <span class="icm-time">${c.time}</span>
                            <br/>${c.text}
                        </div>
                    `).join('');
                    list.scrollTop = list.scrollHeight;
                }

                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const isOpen = popover.classList.contains('open');
                    // Close all
                    document.querySelectorAll('.inline-comment-popover.open').forEach(el => el.classList.remove('open'));
                    if (!isOpen) {
                        popover.classList.add('open');
                        renderComments();
                        openPopoverId = pid;
                        setTimeout(() => document.getElementById(`icm-input-${pid}`)?.focus(), 60);
                    } else {
                        openPopoverId = null;
                    }
                });

                popover.querySelector('.icm-close').addEventListener('click', (e) => {
                    e.stopPropagation();
                    popover.classList.remove('open');
                    openPopoverId = null;
                });

                popover.querySelector('.icm-send-btn').addEventListener('click', (e) => {
                    e.stopPropagation();
                    const input = document.getElementById(`icm-input-${pid}`);
                    const nameInput = document.getElementById(`icm-name-${pid}`);
                    const text = input.value.trim();
                    if (!text) return;
                    if (!allComments[pageKey][pid]) allComments[pageKey][pid] = [];
                    allComments[pageKey][pid].push({
                        name: nameInput.value.trim() || 'Độc giả',
                        text,
                        time: new Date().toLocaleDateString('vi-VN', { day:'2-digit', month:'2-digit' })
                    });
                    saveComments(allComments);
                    input.value = '';
                    renderComments();
                });

                document.getElementById(`icm-input-${pid}`)?.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') popover.querySelector('.icm-send-btn').click();
                });

                popover.addEventListener('click', e => e.stopPropagation());
            });

            document.addEventListener('click', () => {
                document.querySelectorAll('.inline-comment-popover.open').forEach(el => el.classList.remove('open'));
                openPopoverId = null;
            });
        })();
    </script>
</body>
</html>