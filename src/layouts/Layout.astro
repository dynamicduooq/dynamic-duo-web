---
const { frontmatter } = Astro.props;
import settings from '../data/settings.json';

const currentPath = Astro.url?.pathname ?? '';
const isNovelPage = frontmatter?.chuong !== undefined && frontmatter?.chuong !== 0;
const isHome = Astro.props.isHome === true || frontmatter?.isHome === true;
const currentTruyenId = frontmatter?.truyen_id; // Giữ nguyên để Firebase hoạt động

let chapters: any[] = [];
let prevChap: any = null;
let nextChap: any = null;
let currentFolder = "";

if (isNovelPage) {
  const allPosts = Object.values(import.meta.glob('../pages/**/*.md', { eager: true })) as any[];
  
  // Xử lý đường dẫn để lấy đúng thư mục mẹ
  const normPath = (u: string) => u.replace(/\/$/, '').replace(/\/index$/, '');
  const cur = normPath(currentPath);
  currentFolder = cur.substring(0, cur.lastIndexOf('/'));

  chapters = allPosts
    .filter((p: any) => {
      if (p.frontmatter?.chuong === undefined || p.frontmatter?.chuong === 0) return false;
      const pUrl = normPath(p.url || '');
      const pFolder = pUrl.substring(0, pUrl.lastIndexOf('/'));
      return pFolder === currentFolder;
    })
    .sort((a: any, b: any) => (a.frontmatter?.chuong ?? 999) - (b.frontmatter?.chuong ?? 999));

  const idx = chapters.findIndex((c: any) => {
    const u = normPath(c.url || '');
    return u === cur || cur.endsWith(u);
  });
  
  if (idx > 0) prevChap = chapters[idx - 1];
  if (idx >= 0 && idx < chapters.length - 1) nextChap = chapters[idx + 1];
}
---
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{frontmatter?.title || 'Trang chủ'} | {settings.site_name}</title>
  <meta name="description" content={frontmatter?.description || settings.tagline} />
  
  <link rel="icon" type="image/png" href="/dynamic-duo-web/images/logo2.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,600;1,6..72,300;1,6..72,400&family=Literata:ital,opsz,wght@0,7..72,300;0,7..72,400;0,7..72,600&family=Merriweather:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet" />

  <script type="module">
    import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js';
    import { getDatabase, ref, push, onValue, remove, update, get } from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-database.js';
    import { getAuth, signInWithPopup, GoogleAuthProvider, signOut, onAuthStateChanged } from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js';

    const firebaseConfig = {
      apiKey: "AIzaSyBkuHIU0qdS-zNeUFGN7keNGGbAMXvilD0",
      authDomain: "dynamic-duo-comments.firebaseapp.com",
      projectId: "dynamic-duo-comments",
      storageBucket: "dynamic-duo-comments.firebasestorage.app",
      messagingSenderId: "948025586876",
      appId: "1:948025586876:web:848f38701acfdb9b844cb9",
      databaseURL: "https://dynamic-duo-comments-default-rtdb.asia-southeast1.firebasedatabase.app"
    };

    const ADMIN_EMAIL = 'dynamicduoo.q@gmail.com';
    let db = null, auth = null;
    try {
      const app = initializeApp(firebaseConfig);
      db = getDatabase(app);
      auth = getAuth(app);
    } catch(e) { console.warn('[DD] Firebase init failed:', e.message); }

    window.__ddFirebase = { db, auth, ref, push, onValue, remove, update, get, GoogleAuthProvider, signInWithPopup, signOut, onAuthStateChanged, ADMIN_EMAIL };
    window.__ddIsAdmin = false;

    if (auth) {
      onAuthStateChanged(auth, user => {
        window.__ddIsAdmin = !!(user && user.email === ADMIN_EMAIL);
        window.dispatchEvent(new CustomEvent('dd-auth-change', { detail: { isAdmin: window.__ddIsAdmin, user } }));
      });
    }
    window.dispatchEvent(new Event('dd-firebase-ready'));
  </script>

  <script is:inline>
    // Khởi tạo Theme & Settings ngay lập tức
    (function(){
      const t = localStorage.getItem('dd-theme');
      if (t === 'dark') document.documentElement.setAttribute('data-theme','dark');
      
      const fz = localStorage.getItem('dd_fz');
      const ff = localStorage.getItem('dd_ff');
      if(fz) document.documentElement.style.setProperty('--read-fz', fz + 'px');
      if(ff) document.documentElement.style.setProperty('--read-ff', ff);
    })();
  </script>

  <style is:global>
    /* ── VARIABLES ── */
    :root {
      --sky:#0ea5e9; --sky2:#0284c7; --sky-dark:#0369a1;
      --sky-light:#bae6fd; --sky-pale:#f0f9ff;
      --cream:#fafcff;
      --text-main:#1e3a5f; --text-mid:#64748b; --text-dim:#94a3b8;
      --sh-card:0 4px 15px rgba(2,132,199,.12);
      --sh-soft:0 2px 8px rgba(0,0,0,.08);
      --r-sm:6px; --r-md:12px; --r-lg:20px; --r-pill:999px;
      --t:all .2s ease;
      --read-fz: 18px;
      --read-ff: 'Newsreader', serif;
      --bg-card:#ffffff;
      --bg-card2:#f0f9ff;
      --border-card:rgba(186,230,253,.5);
    }

    [data-theme="dark"] {
      --sky:#7ec8e3; --sky2:#a8daf0; --sky-dark:#c5e8f5;
      --sky-light:#1e4a6a; --sky-pale:#0d2035;
      --cream:#0a1929;
      --text-main:#F3F9FF; --text-mid:#8fbcd4; --text-dim:#527a96;
      --bg-card:#0f2336;
      --bg-card2:#0d2035;
      --border-card:rgba(126,200,227,.15);
    }

    *, *::before, *::after { box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { 
      background:var(--cream); color:var(--text-main); 
      font-family:var(--read-ff); 
      font-size:var(--read-fz); 
      line-height:1.9; margin:0; padding:0; overflow-x:hidden; 
      transition: font-size 0.2s, font-family 0.2s, background-color 0.2s, color 0.2s; 
    }
    
    [data-theme="dark"] body { background:#0a1929; color:#F3F9FF; }
    h1,h2,h3,h4 { font-family:'Merriweather',serif; color:var(--sky-dark); text-align:center; }
    [data-theme="dark"] h1, [data-theme="dark"] h2, [data-theme="dark"] h3, [data-theme="dark"] h4 { color:#a8daf0; }
    a { color:inherit; text-decoration:none; }
    ::-webkit-scrollbar { width:5px; }
    ::-webkit-scrollbar-track { background:var(--sky-pale); }
    ::-webkit-scrollbar-thumb { background:var(--sky-light); border-radius:3px; }

    #read-progress { position:fixed; top:0; left:0; height:3px; z-index:9999; background:linear-gradient(90deg,var(--sky-light),var(--sky),var(--sky2)); width:0%; transition:width .1s linear; pointer-events:none; }

    /* ── NAVBAR ── */
    nav { position:fixed; top:0; left:0; right:0; z-index:500; display:flex; align-items:center; height:56px; padding:0 28px; background:rgba(255,255,255,.97); backdrop-filter:blur(16px); border-bottom:1px solid var(--border-card); box-shadow:0 2px 12px rgba(2,132,199,.08); }
    [data-theme="dark"] nav { background:rgba(8,18,32,.98); border-color:rgba(126,200,227,.15); }
    .nav-logo { font-family:'Literata',serif; font-weight:600; font-size:.95rem; color:var(--sky-dark); white-space:nowrap; letter-spacing:.5px; margin-right: auto; }
    [data-theme="dark"] .nav-logo { color:#a8daf0; }
    .nav-links { display:flex; align-items:center; gap:2px; margin-right: 12px; }
    .nav-item { position:relative; }
    .nav-item > a, .nav-btn { font-family:'Newsreader',serif; font-size:.76rem; color:var(--text-mid); letter-spacing:1px; text-transform:uppercase; padding:6px 12px; border-radius:var(--r-pill); display:inline-flex; align-items:center; gap:5px; transition:var(--t); cursor:pointer; background:none; border:none; white-space:nowrap; }
    .nav-item > a:hover, .nav-btn:hover, .nav-item:hover > a, .nav-item:hover > .nav-btn { background:var(--sky-pale); color:var(--sky); }
    [data-theme="dark"] .nav-item > a, [data-theme="dark"] .nav-btn { color:#8fbcd4; }
    [data-theme="dark"] .nav-item > a:hover, [data-theme="dark"] .nav-btn:hover, [data-theme="dark"] .nav-item:hover > a, [data-theme="dark"] .nav-item:hover > .nav-btn { color:#7ec8e3; background:rgba(126,200,227,.1); }
    
    .dropdown-content { position:absolute; top:calc(100% + 8px); left:50%; transform:translateX(-50%) translateY(8px); min-width:240px; background:var(--bg-card); border:1px solid var(--border-card); border-radius:var(--r-md); box-shadow:0 16px 48px rgba(2,132,199,.13); padding:8px 6px; opacity:0; visibility:hidden; pointer-events:none; transition:var(--t); z-index:600; }
    [data-theme="dark"] .dropdown-content { box-shadow:0 16px 48px rgba(0,0,0,.4); }
    .nav-item:hover .dropdown-content { opacity:1; visibility:visible; pointer-events:auto; transform:translateX(-50%) translateY(0); }
    .dd-section-title { font-size:.62rem; letter-spacing:2px; text-transform:uppercase; color:var(--text-dim); padding:6px 12px 3px; }
    [data-theme="dark"] .dd-section-title { color:#3d6a82; }
    .dd-item { display:flex; align-items:center; gap:7px; padding:7px 12px; font-size:.82rem; color:var(--text-mid); border-radius:var(--r-sm); transition:var(--t); }
    .dd-item:hover { background:var(--sky-pale); color:var(--sky); }
    [data-theme="dark"] .dd-item { color:#8fbcd4; }
    [data-theme="dark"] .dd-item:hover { background:rgba(126,200,227,.1); color:#F3F9FF; }
    .dd-divider { height:1px; background:rgba(186,230,253,.45); margin:5px 8px; }

    .nav-theme-btn { font-size:.8rem; width:32px; height:32px; border-radius:50%; border:1px solid var(--border-card); background:none; color:var(--text-mid); cursor:pointer; transition:var(--t); display:inline-flex; align-items:center; justify-content:center; flex-shrink:0; }
    .nav-theme-btn:hover { background:var(--sky-pale); color:var(--sky); }
    [data-theme="dark"] .nav-theme-btn { border-color:rgba(126,200,227,.25); color:#8fbcd4; }
    [data-theme="dark"] .nav-theme-btn:hover { background:rgba(126,200,227,.1); color:#F3F9FF; }

    .nav-hamburger { display:none; flex-direction:column; gap:5px; cursor:pointer; padding:6px; background:none; border:none; }
    .nav-hamburger span { display:block; width:22px; height:2px; background:var(--sky-dark); border-radius:2px; transition:var(--t); }
    [data-theme="dark"] .nav-hamburger span { background:#a8daf0; }
    
    .mobile-menu { display:none; position:fixed; top:56px; left:0; right:0; background:rgba(255,255,255,.99); backdrop-filter:blur(16px); border-bottom:1px solid var(--border-card); padding:10px 16px 18px; z-index:490; flex-direction:column; gap:2px; max-height:calc(100vh - 56px); overflow-y:auto; }
    [data-theme="dark"] .mobile-menu { background:rgba(8,18,32,.99); border-color:rgba(126,200,227,.18); }
    .mobile-menu.open { display:flex; }
    .mobile-menu a { padding:9px 12px; font-size:.88rem; color:var(--text-mid); border-radius:var(--r-sm); display:block; transition:var(--t); }
    .mobile-menu a:hover { background:var(--sky-pale); color:var(--sky); }
    [data-theme="dark"] .mobile-menu a { color:#8fbcd4; }
    [data-theme="dark"] .mobile-menu a:hover { background:rgba(126,200,227,.1); color:#a8daf0; }
    .mobile-section-title { font-size:.65rem; letter-spacing:2px; text-transform:uppercase; color:var(--text-dim); padding:10px 12px 3px; }
    [data-theme="dark"] .mobile-section-title { color:#3d6a82; }
    
    #navThemeBtnMobile { display: none; }
    @media(max-width:700px){ 
      .nav-links{display:none;}  
      #navThemeBtnMobile { display: flex; } 
      .nav-hamburger { display: flex; } 
    }

    /* ── LAYOUT & CONTENT ── */
    .page-wrapper { margin-top:56px; min-height:70vh; }
    .page-content-wrap { max-width:820px; margin:32px auto 60px; padding:40px 50px; background:var(--bg-card); border-radius:var(--r-lg); box-shadow:var(--sh-soft); border:1px solid var(--border-card); }
    .novel-layout-wrap { max-width:920px; margin:0 auto; padding:0 16px; position:relative; }
    .novel-content { width:100%; margin:24px auto 60px; padding:48px 60px; background:var(--bg-card); border-radius:var(--r-lg); box-shadow:var(--sh-soft); border:1px solid var(--border-card); position:relative; user-select: none; -webkit-user-select: none; }
    [data-theme="dark"] .novel-content, [data-theme="dark"] .page-content-wrap { color:#d8eeff; }
    
    @media(max-width:768px){ .novel-content{ padding:30px 28px; } }
    @media(max-width:640px){ .novel-content, .page-content-wrap { padding:24px 18px; margin:16px 12px 40px; } }
    
    .novel-content p { text-align:justify; text-justify:inter-word; position:relative; margin-bottom:1.1em; display:block; }
    [data-theme="dark"] .novel-content p { color:#d8eeff; }
    blockquote { font-style:italic; font-size:.9rem; color:var(--text-mid); line-height:1.75; border-left:3px solid var(--sky-light); padding:15px 20px; margin:20px 0; background:var(--sky-pale); border-radius:0 12px 12px 0; }
    [data-theme="dark"] blockquote { background:rgba(15,35,54,.9); color:#8fbcd4; border-left-color:#1e4a6a; }
    hr { border:none; text-align:center; margin:40px 0; }
    hr::after { content:"𓆝 𓆟 𓆞 𓆝 𓆟"; color:var(--sky-light); font-size:20px; letter-spacing:5px; }

    /* ── TAGS ── */
    .tags-container { display:flex; flex-wrap:wrap; justify-content:center; gap:8px; margin-bottom:28px; margin-top:100px; }
    .tag-badge { display:inline-block; padding:4px 14px; border:1px solid var(--sky-light); border-radius:var(--r-pill); font-size:.75rem; color:var(--sky-dark); transition:var(--t); background:var(--sky-pale); font-family: 'Newsreader', serif;}
    .tag-badge:hover { background:var(--sky-light); transform: translateY(-2px); box-shadow: 0 2px 6px rgba(2,132,199,.1); }
    [data-theme="dark"] .tag-badge { border-color:rgba(80,150,210,.4); background:rgba(20,55,90,.6); color:#a8d4f0; }
    [data-theme="dark"] .tag-badge:hover { background:rgba(80,150,210,.6); }

    /* ── CHAP NAV ── */
    .chap-nav-row { display:flex; align-items:center; justify-content:center; gap:10px; padding:14px 20px; flex-wrap:wrap; max-width:900px; margin:0 auto; }
    .chap-pn { display:inline-flex; align-items:center; gap:5px; padding:6px 16px; border-radius:var(--r-pill); border:1px solid var(--sky-light); font-size:.78rem; color:var(--sky-dark); transition:var(--t); white-space:nowrap; background:rgba(255,255,255,.9); }
    .chap-pn:hover { background:var(--sky-pale); border-color:var(--sky); }
    .chap-pn.disabled { opacity:.4; pointer-events:none; }
    [data-theme="dark"] .chap-pn { border-color:#1e4a6a; color:#8fbcd4; background:#0d2035; }
    [data-theme="dark"] .chap-pn:hover { background:rgba(126,200,227,.1); color:#F3F9FF; border-color:#7ec8e3; }

    .chap-dd-wrap { position:relative; }
    .chap-dd-btn { display:inline-flex; align-items:center; gap:5px; padding:6px 14px; border-radius:var(--r-pill); border:1px solid var(--sky-light); font-size:.76rem; color:var(--sky-dark); cursor:pointer; font-family:'Newsreader',serif; background:rgba(255,255,255,.9); transition:var(--t); white-space:nowrap; }
    .chap-dd-btn:hover { background:var(--sky-pale); border-color:var(--sky); }
    [data-theme="dark"] .chap-dd-btn { background:#0d2035; border-color:#1e4a6a; color:#8fbcd4; }
    
    .chap-dd-list { position:absolute; top:calc(100% + 6px); left:50%; transform:translateX(-50%); z-index:700; width:220px; max-height:280px; overflow-y:auto; overflow-x:hidden; background:var(--bg-card); border:1px solid var(--border-card); border-radius:var(--r-md); box-shadow:0 16px 48px rgba(2,132,199,.15); padding:4px; display:none; scrollbar-width:thin; scrollbar-color:var(--sky-light) transparent; }
    .chap-dd-list::-webkit-scrollbar { width:3px; }
    .chap-dd-list::-webkit-scrollbar-thumb { background:var(--sky-light); border-radius:3px; }
    .chap-dd-list.open { display:block; }
    .chap-dd-list.up { top:auto; bottom:calc(100% + 6px); }
    .chap-dd-list a { display:block; padding:6px 12px; font-size:.76rem; color:var(--text-mid); border-radius:var(--r-sm); transition:var(--t); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; border-bottom:1px solid rgba(186,230,253,.2); }
    .chap-dd-list a:last-child { border-bottom:none; }
    .chap-dd-list a:hover { background:var(--sky-pale); color:var(--sky); }
    .chap-dd-list a.cur-chap { background:rgba(14,165,233,.1); color:var(--sky-dark); font-weight:700; }
    [data-theme="dark"] .chap-dd-list a { color:#8fbcd4; border-color:rgba(126,200,227,.1); }
    [data-theme="dark"] .chap-dd-list a:hover { background:rgba(126,200,227,.1); color:#F3F9FF; }
    [data-theme="dark"] .chap-dd-list a.cur-chap { background:rgba(126,200,227,.15); color:#a8daf0; font-weight:700; }

    /* ── AUDIO PLAYER ── */
    .auto-audio-player { max-width: 100%; margin: 0 auto 24px; padding: 14px 16px; background: var(--sky-pale); border: 1px dashed var(--sky-light); border-radius: 12px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
    [data-theme="dark"] .auto-audio-player { background: rgba(15,35,54,0.6); border-color: rgba(126,200,227,0.3); }
    .aa-top-row { display: flex; align-items: center; justify-content: space-between; width: 100%; gap: 10px; }
    .aa-header { font-family: 'Merriweather', serif; font-size: 0.9rem; font-weight: bold; color: var(--sky-dark); display: flex; align-items: center; gap: 8px; }
    [data-theme="dark"] .aa-header { color: #a8daf0; }
    .aa-icon { font-size: 1.2rem; }
    .aa-main-btns { display: flex; gap: 6px; align-items: center; }
    .aa-btn { border: none; padding: 6px 14px; border-radius: 99px; font-size: 0.8rem; font-family: inherit; font-weight: bold; cursor: pointer; transition: var(--t); }
    .aa-btn.play { background: var(--sky); color: #fff; }
    .aa-btn.play:hover { background: var(--sky2); }
    .aa-btn.pause { background: #f59e0b; color: #fff; }
    .aa-btn.stop { background: #ef4444; color: #fff; }
    .aa-btn-tool { background: none; border: 1px solid var(--sky-light); border-radius: 8px; cursor: pointer; padding: 4px 8px; font-size: 1rem; transition: var(--t); }
    .aa-btn-tool:hover { background: var(--sky-light); }
    
    .aa-settings-collapse { width: 100%; max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out; border-top: 0px solid transparent; }
    .aa-settings-collapse.open { max-height: 200px; margin-top: 10px; padding-top: 10px; border-top: 1px dashed var(--sky-light); }
    .aa-settings-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
    @media(max-width: 600px) { .aa-settings-grid { grid-template-columns: 1fr; } }
    .aa-field { display: flex; align-items: center; gap: 5px; font-size: 0.75rem; color: var(--text-mid); }
    .aa-field label { font-weight: bold; }
    #aaVoiceSelect { padding: 3px 8px; border-radius: 6px; border: 1px solid var(--sky-light); background: #fff; font-family: inherit; font-size: 0.75rem; outline: none; max-width: 150px; }
    #aaRateRange { cursor: pointer; accent-color: var(--sky); width: 80px; }
    #aaRateValue { min-width: 25px; font-weight: bold; color: var(--sky); }
    @media(max-width: 640px) { .aa-settings { flex-direction: column; align-items: flex-start; gap: 8px; } #aaVoiceSelect { max-width: 100%; } }

    /* ── EDITOR NOTE ── */
    .editor-note-box { margin-top: 50px; padding: 20px; background: var(--sky-pale); border-radius: var(--r-md); border-top: 2px dashed var(--sky-light); position: relative; }
    .editor-note-box::before { content: "𓆝"; position: absolute; top: -15px; left: 50%; transform: translateX(-50%); background: var(--bg-card); padding: 0 15px; color: var(--sky-light); font-size: 1.2rem; }
    [data-theme="dark"] .editor-note-box { background: rgba(14, 165, 233, 0.1); border-left-color: var(--sky); }
    .note-label { font-weight: bold; color: var(--sky-dark); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; display: block; }
    .note-text { font-style: italic; font-size: 0.95rem; color: var(--text-mid); line-height: 1.6; white-space: pre-wrap; }
    [data-theme="dark"] .note-text { color: #8fbcd4; }

    /* ── INLINE COMMENTS ── */
    .ic-trigger { position: absolute; left: -50px; top: -2px; display: inline-flex; align-items: center; justify-content: center; padding: 4px; background: transparent; border: none; cursor: pointer; font-size: 1.1rem; opacity: 0; transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); color: var(--sky); transform: translateX(-5px) scale(0.9); filter: grayscale(100%) opacity(0.5); z-index: 10; }
    @media(max-width: 768px) { .ic-trigger { left: -35px; } }
    @media(max-width: 640px) { .ic-trigger { left: -15px; background: rgba(255,255,255,0.8); border-radius: 50%; padding: 2px; } }
    .novel-content p:hover .ic-trigger { opacity: 0.6; transform: translateX(0) scale(1); filter: grayscale(0%) opacity(1); }
    .ic-trigger:hover { opacity: 1 !important; transform: translateX(2px) scale(1.2) !important; color: var(--sky2); filter: grayscale(0%) opacity(1) !important; }
    .ic-trigger.has-comments { opacity: 0.8; filter: grayscale(0%) opacity(1); transform: translateX(0) scale(1); }
    .novel-content p.ic-active .ic-trigger { opacity: 1; transform: scale(1.15); filter: grayscale(0%) opacity(1); }
