---
const { frontmatter } = Astro.props;
import settings from '../data/settings.json';

const currentPath = Astro.url?.pathname ?? '';
const isNovelPage = frontmatter?.chuong !== undefined && frontmatter?.chuong !== 0;
const currentTruyenId = frontmatter?.truyen_id;

let chapters: any[] = [];
let prevChap: any = null;
let nextChap: any = null;

if (currentTruyenId && isNovelPage) {
  const allPosts = Object.values(import.meta.glob('../pages/**/*.md', { eager: true })) as any[];
  chapters = allPosts
    .filter((p: any) =>
      p.frontmatter?.truyen_id === currentTruyenId &&
      p.frontmatter?.chuong !== undefined &&
      p.frontmatter?.chuong !== 0
    )
    .sort((a: any, b: any) => (a.frontmatter?.chuong ?? 999) - (b.frontmatter?.chuong ?? 999));

  const normPath = (u: string) => u.replace(/\/$/, '').replace(/\/index$/, '');
  const cur = normPath(currentPath);
  const idx = chapters.findIndex((c: any) => {
    const u = normPath(c.url || '');
    return u === cur || cur.endsWith(u);
  });
  if (idx > 0) prevChap = chapters[idx - 1];
  if (idx >= 0 && idx < chapters.length - 1) nextChap = chapters[idx + 1];
}
---
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{frontmatter?.title || 'Trang chủ'} | {settings.site_name}</title>
  <meta name="description" content={frontmatter?.description || settings.tagline} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,600;1,6..72,300;1,6..72,400&family=Literata:ital,opsz,wght@0,7..72,300;0,7..72,400;0,7..72,600&family=Merriweather:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet" />

  <script is:inline>
    (function(){ const t=localStorage.getItem('dd-theme'); if(t==='dark') document.documentElement.setAttribute('data-theme','dark'); })();
  </script>

  <style is:global>
    /* ─── BIẾN MÀU ─── */
    :root {
      --sky:#0ea5e9; --sky2:#0284c7; --sky-dark:#0369a1;
      --sky-light:#bae6fd; --sky-pale:#f0f9ff;
      --cream:#fafcff; --bg2:#fff;
      --text-main:#1e3a5f; --text-mid:#64748b; --text-dim:#94a3b8;
      --sh-card:0 4px 15px rgba(2,132,199,.12); --sh-soft:0 2px 8px rgba(0,0,0,.08);
      --r-sm:6px; --r-md:12px; --r-lg:20px; --r-pill:999px; --t:all .2s ease;
    }

    /* ─── DARK MODE: cân bằng, dễ đọc, không chói ─── */
    [data-theme="dark"] {
      --sky:#60b8e8;
      --sky2:#89d0f5;
      --sky-dark:#c8e8f8;
      --sky-light:#1d4a68;
      --sky-pale:#0f2438;
      --cream:#0d1b2a;
      --bg2:#111f30;
      --text-main:#d8edf8;
      --text-mid:#8fb3cc;
      --text-dim:#4e7a96;
    }
    [data-theme="dark"] body { background:#0d1b2a; color:#d8edf8; }
    [data-theme="dark"] nav {
      background:rgba(13,27,42,.97);
      border-color:rgba(29,74,104,.7);
    }
    [data-theme="dark"] .mobile-menu {
      background:rgba(13,27,42,.99);
      border-color:rgba(29,74,104,.6);
    }
    [data-theme="dark"] .dropdown-content {
      background:#111f30;
      border-color:rgba(29,74,104,.8);
    }
    [data-theme="dark"] .dd-item { color:#8fb3cc; }
    [data-theme="dark"] .dd-item:hover { background:rgba(29,74,104,.45); color:#c8e8f8; }
    [data-theme="dark"] .nav-item > a { color:#8fb3cc; }
    [data-theme="dark"] .nav-item > a:hover,
    [data-theme="dark"] .nav-btn:hover,
    [data-theme="dark"] .nav-item:hover > a,
    [data-theme="dark"] .nav-item:hover > .nav-btn { color:#60b8e8; background:rgba(29,74,104,.35); }
    [data-theme="dark"] .nav-logo { color:#60b8e8; }
    [data-theme="dark"] .nav-btn { color:#8fb3cc; }

    [data-theme="dark"] .novel-content,
    [data-theme="dark"] .page-content-wrap {
      background:rgba(17,31,48,.98);
      border-color:rgba(29,74,104,.5);
      color:#d8edf8;
    }
    [data-theme="dark"] .novel-content p { color:#cce3f4; }
    [data-theme="dark"] h1,[data-theme="dark"] h2,
    [data-theme="dark"] h3,[data-theme="dark"] h4 { color:#60b8e8; }

    [data-theme="dark"] blockquote {
      background:rgba(15,36,56,.9);
      color:#8fb3cc;
      border-left-color:#1d4a68;
    }
    [data-theme="dark"] .chap-pn { border-color:#1d4a68; color:#8fb3cc; }
    [data-theme="dark"] .chap-pn:hover { background:rgba(29,74,104,.4); color:#c8e8f8; border-color:#60b8e8; }
    [data-theme="dark"] .chap-dd-btn { background:#0f2438; border-color:#1d4a68; color:#8fb3cc; }
    [data-theme="dark"] .chap-dd-btn:hover { background:rgba(29,74,104,.5); }
    [data-theme="dark"] .chap-dd-list { background:#111f30; border-color:#1d4a68; }
    [data-theme="dark"] .chap-dd-list a { color:#8fb3cc; border-color:rgba(29,74,104,.3); }
    [data-theme="dark"] .chap-dd-list a:hover { background:rgba(29,74,104,.45); color:#c8e8f8; }
    [data-theme="dark"] .chap-dd-list a.cur-chap { background:rgba(29,74,104,.4); color:#60b8e8; }

    [data-theme="dark"] .ic-bubble {
      background:#111f30;
      border-color:rgba(29,74,104,.9);
      color:#d8edf8;
    }
    [data-theme="dark"] .ic-bubble-header { color:#4e7a96; }
    [data-theme="dark"] .ic-bubble-header strong { color:#60b8e8; }
    [data-theme="dark"] .ic-comment-item { background:rgba(29,74,104,.3); color:#cce3f4; }
    [data-theme="dark"] .ic-comment-name { color:#60b8e8; }
    [data-theme="dark"] .ic-input { background:#0f2438; border-color:#1d4a68; color:#d8edf8; }

    [data-theme="dark"] footer { background:#111f30; border-color:rgba(29,74,104,.4); color:#8fb3cc; }
    [data-theme="dark"] .ft-logo { color:#60b8e8; }
    [data-theme="dark"] .ft-links a { color:#8fb3cc; }
    [data-theme="dark"] .ft-links a:hover { color:#60b8e8; }
    [data-theme="dark"] .ft-bottom { color:#4e7a96; }
    [data-theme="dark"] .tag-badge { color:#60b8e8; border-color:#1d4a68; }
    [data-theme="dark"] .tag-badge:hover { background:rgba(29,74,104,.35); }

    [data-theme="dark"] .scroll-btn { background:#1a4d6e; }
    [data-theme="dark"] .scroll-btn:hover { background:#245f87; }

    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      background:var(--cream); color:var(--text-main);
      font-family:'Newsreader',serif; font-size:18px; line-height:1.9;
      margin:0; padding:0; overflow-x:hidden;
    }
    h1,h2,h3,h4 { font-family:'Merriweather',serif; color:var(--sky-dark); text-align:center; }
    a { color:inherit; text-decoration:none; }
    ::-webkit-scrollbar { width:5px; }
    ::-webkit-scrollbar-track { background:var(--sky-pale); }
    ::-webkit-scrollbar-thumb { background:var(--sky-light); border-radius:3px; }

    /* ─── PROGRESS BAR ─── */
    #read-progress {
      position:fixed; top:0; left:0; height:3px; z-index:9999;
      background:linear-gradient(90deg,var(--sky-light),var(--sky),var(--sky2));
      width:0%; transition:width .1s linear; pointer-events:none;
    }

    /* ─── NAVBAR ─── */
    nav {
      position:fixed; top:0; left:0; right:0; z-index:500;
      display:flex; align-items:center; justify-content:space-between;
      height:56px; padding:0 28px;
      background:rgba(255,255,255,.97); backdrop-filter:blur(16px);
      border-bottom:1px solid rgba(186,230,253,.5);
      box-shadow:0 2px 12px rgba(2,132,199,.08);
    }
    .nav-logo { font-family:'Literata',serif; font-weight:600; font-size:.95rem; color:var(--sky-dark); white-space:nowrap; letter-spacing:.5px; }
    .nav-links { display:flex; align-items:center; gap:2px; }
    .nav-item { position:relative; }
    .nav-item > a, .nav-btn {
      font-family:'Newsreader',serif; font-size:.76rem; font-weight:400;
      color:var(--text-mid); letter-spacing:1px; text-transform:uppercase;
      padding:6px 12px; border-radius:var(--r-pill);
      display:inline-flex; align-items:center; gap:5px;
      transition:var(--t); cursor:pointer; background:none; border:none; white-space:nowrap;
    }
    .nav-item > a:hover, .nav-btn:hover,
    .nav-item:hover > a, .nav-item:hover > .nav-btn { background:var(--sky-pale); color:var(--sky); }
    .dropdown-content {
      position:absolute; top:calc(100% + 8px); left:50%;
      transform:translateX(-50%) translateY(8px);
      min-width:240px; background:#fff;
      border:1px solid rgba(186,230,253,.7); border-radius:var(--r-md);
      box-shadow:0 16px 48px rgba(2,132,199,.13); padding:8px 6px;
      opacity:0; visibility:hidden; pointer-events:none;
      transition:opacity .22s ease, transform .22s ease; z-index:600;
    }
    .nav-item:hover .dropdown-content { opacity:1; visibility:visible; pointer-events:auto; transform:translateX(-50%) translateY(0); }
    .dd-section-title { font-size:.62rem; letter-spacing:2px; text-transform:uppercase; color:var(--text-dim); padding:6px 12px 3px; }
    .dd-item { display:flex; align-items:center; gap:7px; padding:7px 12px; font-size:.82rem; color:var(--text-mid); border-radius:var(--r-sm); transition:var(--t); }
    .dd-item:hover { background:var(--sky-pale); color:var(--sky); }
    .dd-divider { height:1px; background:rgba(186,230,253,.45); margin:5px 8px; }
    .nav-hamburger { display:none; flex-direction:column; gap:5px; cursor:pointer; padding:6px; background:none; border:none; }
    .nav-hamburger span { display:block; width:22px; height:2px; background:var(--sky-dark); border-radius:2px; transition:var(--t); }
    .mobile-menu {
      display:none; position:fixed; top:56px; left:0; right:0;
      background:rgba(255,255,255,.99); backdrop-filter:blur(16px);
      border-bottom:1px solid rgba(186,230,253,.5);
      padding:10px 16px 18px; z-index:490;
      flex-direction:column; gap:2px; max-height:calc(100vh - 56px); overflow-y:auto;
    }
    .mobile-menu.open { display:flex; }
    .mobile-menu a { padding:9px 12px; font-size:.88rem; color:var(--text-mid); border-radius:var(--r-sm); display:block; transition:var(--t); }
    .mobile-menu a:hover { background:var(--sky-pale); color:var(--sky); }
    .mobile-section-title { font-size:.65rem; letter-spacing:2px; text-transform:uppercase; color:var(--text-dim); padding:10px 12px 3px; }
    @media(max-width:700px) { .nav-links{display:none;} .nav-hamburger{display:flex;} }

    /* ─── LAYOUT ─── */
    .page-wrapper { margin-top:56px; min-height:70vh; }

    .page-content-wrap {
      max-width:820px;
      margin:32px auto 60px;
      padding:40px 50px;
      background:rgba(255,255,255,.98);
      border-radius:var(--r-lg);
      box-shadow:var(--sh-soft);
      border:1px solid rgba(186,230,253,.5);
    }
    @media(max-width:640px) { .page-content-wrap { padding:24px 18px; margin:16px 12px 40px; } }

    /* ─── NOVEL CONTENT ─── */
    .novel-content {
      max-width:760px;
      margin:32px auto 60px;
      padding:40px 50px;
      background:rgba(255,255,255,.98);
      border-radius:var(--r-lg);
      box-shadow:var(--sh-soft);
      border:1px solid rgba(186,230,253,.5);
    }
    @media(max-width:640px) { .novel-content { padding:24px 18px; margin:16px 12px 40px; } }
    .novel-content p {
      text-align:justify; text-justify:inter-word;
      position:relative; margin-bottom:1.1em;
    }
    blockquote {
      font-style:italic; font-size:.9rem; color:var(--text-mid); line-height:1.75;
      border-left:3px solid var(--sky-light); padding:15px 20px;
      margin:20px 0; background:var(--sky-pale); border-radius:0 12px 12px 0;
    }
    hr { border:none; text-align:center; margin:40px 0; }
    hr::after { content:"𓆝 𓆟 𓆞 𓆝 𓆟"; color:var(--sky-light); font-size:20px; letter-spacing:5px; }

    /* ─── TAGS ─── */
    .tag-badge {
      display:inline-block; padding:4px 12px;
      border:1.5px solid var(--sky); border-radius:var(--r-pill);
      font-size:.8rem; margin:3px; color:var(--sky); transition:var(--t);
    }
    .tag-badge:hover { background:var(--sky-pale); }

    /* ─── CHAPTER NAV ─── */
    .chap-nav-row {
      display:flex; align-items:center; justify-content:center;
      gap:10px; margin:22px 0; flex-wrap:wrap;
      max-width:820px; margin-left:auto; margin-right:auto;
      padding:0 12px;
    }
    .chap-pn {
      display:inline-flex; align-items:center; gap:6px;
      padding:8px 18px; border:1.5px solid var(--sky-light);
      border-radius:var(--r-pill); color:var(--sky-dark);
      font-size:.82rem; font-family:'Newsreader',serif;
      transition:var(--t); white-space:nowrap; flex-shrink:0;
    }
    .chap-pn:hover { background:var(--sky-pale); color:var(--sky); border-color:var(--sky); }
    .chap-pn.disabled { opacity:.35; pointer-events:none; }
    .chap-dd-wrap { position:relative; }
    .chap-dd-btn {
      display:inline-flex; align-items:center; gap:8px;
      padding:8px 20px;
      background:var(--sky-pale); border:1.5px solid var(--sky-light);
      border-radius:var(--r-pill); color:var(--sky-dark);
      font-size:.83rem; font-family:'Newsreader',serif; font-weight:600;
      cursor:pointer; transition:var(--t); white-space:nowrap; user-select:none;
    }
    .chap-dd-btn:hover { background:var(--sky-light); }
    .chap-dd-list {
      position:absolute; top:calc(100% + 6px); left:50%;
      transform:translateX(-50%);
      width:290px; max-height:260px; overflow-y:auto;
      background:#fff; border:1px solid var(--sky-light);
      border-radius:var(--r-md); z-index:200;
      box-shadow:var(--sh-card); display:none; flex-direction:column;
    }
    .chap-dd-list.open { display:flex; }
    .chap-dd-list a {
      padding:9px 16px; border-bottom:1px solid rgba(186,230,253,.25);
      color:var(--text-mid); font-size:.82rem; transition:var(--t);
    }
    .chap-dd-list a:last-child { border-bottom:none; }
    .chap-dd-list a:hover { background:var(--sky-pale); color:var(--sky); }
    .chap-dd-list a.cur-chap { background:var(--sky-pale); color:var(--sky); font-weight:700; }
    .chap-dd-list.up { bottom:calc(100% + 6px); top:auto; }

    /* ─── INLINE COMMENT ─── */
    .novel-content p:hover .ic-trigger { opacity:1; }
    .ic-trigger {
      display:inline-flex; align-items:center; justify-content:center;
      width:20px; height:20px; border-radius:50%;
      background:var(--sky-pale); border:1px solid var(--sky-light);
      color:var(--sky); font-size:.65rem; cursor:pointer;
      opacity:0; transition:opacity .18s ease;
      vertical-align:middle; margin-left:6px; flex-shrink:0;
      position:relative; z-index:10;
    }
    .ic-trigger:hover { background:var(--sky); color:#fff; opacity:1 !important; }
    .ic-bubble {
      display:none;
      position:fixed;
      width:min(290px, calc(100vw - 32px));
      background:#fff;
      border:1px solid rgba(186,230,253,.8); border-radius:14px;
      box-shadow:0 8px 28px rgba(2,132,199,.18); padding:14px 16px;
      z-index:1000; font-size:.8rem;
      animation:bubblePop .18s ease;
    }
    .ic-bubble.open { display:block; }
    @keyframes bubblePop { from{opacity:0;transform:scale(.9) translateY(4px)} to{opacity:1;transform:scale(1) translateY(0)} }
    .ic-bubble-header { font-size:.68rem; color:var(--text-dim); margin-bottom:8px; letter-spacing:.3px; display:flex; align-items:center; justify-content:space-between; }
    .ic-bubble-header strong { color:var(--sky); }
    .ic-bubble-close { background:none; border:none; cursor:pointer; color:var(--text-dim); font-size:.75rem; padding:0 2px; transition:color .15s; }
    .ic-bubble-close:hover { color:var(--sky); }
    .ic-comments-list { max-height:150px; overflow-y:auto; margin-bottom:8px; }
    .ic-comment-item {
      background:var(--sky-pale); border-radius:10px; padding:7px 10px;
      margin-bottom:6px; font-size:.76rem; color:var(--text-main); line-height:1.5;
      position:relative;
    }
    .ic-comment-item:last-child { margin-bottom:0; }
    .ic-comment-name { font-weight:700; color:var(--sky-dark); font-size:.7rem; margin-bottom:2px; }
    .ic-comment-time { font-size:.62rem; color:var(--text-dim); float:right; }
    .ic-comment-text { margin:0; }
    .ic-delete-btn {
      position:absolute; top:6px; right:6px;
      background:none; border:none; cursor:pointer;
      font-size:.65rem; color:var(--text-dim); opacity:0; transition:opacity .15s, color .15s;
      padding:2px 5px; border-radius:4px;
    }
    .ic-comment-item:hover .ic-delete-btn { opacity:1; }
    .ic-delete-btn:hover { color:#ef4444; background:rgba(239,68,68,.08); }
    .ic-reply-btn { font-size:.65rem; color:var(--sky); cursor:pointer; margin-top:3px; display:inline-block; }
    .ic-reply-btn:hover { text-decoration:underline; }
    .ic-reply-row { display:flex; gap:6px; margin-top:6px; padding-top:6px; border-top:1px solid rgba(186,230,253,.4); }
    .ic-input {
      flex:1; padding:5px 10px; border:1.5px solid var(--sky-light); border-radius:var(--r-pill);
      font-size:.75rem; font-family:'Newsreader',serif; color:var(--text-main);
      background:var(--cream); outline:none; min-width:0;
    }
    .ic-input:focus { border-color:var(--sky); }
    .ic-send-btn {
      padding:5px 11px; background:var(--sky); color:#fff; border:none;
      border-radius:var(--r-pill); font-size:.72rem; cursor:pointer; transition:var(--t);
      flex-shrink:0;
    }
    .ic-send-btn:hover { background:var(--sky2); }
    .ic-name-row { display:flex; gap:6px; margin-bottom:5px; flex-wrap:wrap; }
    .ic-name-inp { width:90px !important; flex-shrink:0 !important; }
    .ic-loading { font-size:.72rem; color:var(--text-dim); text-align:center; padding:6px 0; }

    /* ─── GISCUS ─── */
    .giscus-wrap { margin-top:56px; border-top:1px dashed var(--sky-light); padding-top:28px; }

    /* ─── FOOTER ─── */
    footer { background:#fff; border-top:1px solid rgba(186,230,253,.4); padding:44px 20px 26px; margin-top:auto; }
    .footer-inner { max-width:1100px; margin:0 auto; display:grid; grid-template-columns:1fr auto 1fr; gap:28px; align-items:start; }
    @media(max-width:600px) { .footer-inner{grid-template-columns:1fr; text-align:center;} .ft-social{align-items:center!important;} }
    .ft-logo { font-family:'Literata',serif; font-size:1.1rem; font-weight:600; color:var(--sky-dark); display:block; margin-bottom:5px; }
    .ft-brand p { font-size:.78rem; color:var(--text-dim); font-style:italic; margin:3px 0; }
    .ft-links { display:flex; flex-direction:column; gap:7px; align-items:center; }
    .ft-links a { font-size:.76rem; color:var(--text-mid); letter-spacing:1px; text-transform:uppercase; transition:var(--t); }
    .ft-links a:hover { color:var(--sky); }
    .ft-social { display:flex; flex-direction:column; gap:7px; align-items:flex-end; }
    .ft-social-row { display:flex; gap:8px; }
    .social-ic { width:34px; height:34px; border-radius:50%; border:1px solid var(--sky-light); display:flex; align-items:center; justify-content:center; font-size:.88rem; color:var(--sky); background:var(--sky-pale); transition:var(--t); }
    .social-ic:hover { background:var(--sky-light); transform:translateY(-2px); }
    .ft-bottom { max-width:1100px; margin:26px auto 0; padding-top:16px; border-top:1px solid rgba(186,230,253,.3); text-align:center; font-size:.7rem; color:var(--text-dim); letter-spacing:1px; }

    /* ─── SCROLL BUTTONS ─── */
    .scroll-btns {
      position:fixed; bottom:24px; right:22px; z-index:400;
      display:flex; flex-direction:column; gap:8px;
      pointer-events:none;
    }
    .scroll-btn {
      width:40px; height:40px; border-radius:50%;
      background:var(--sky); color:#fff;
      border:none; cursor:pointer; font-size:1.1rem;
      box-shadow:0 4px 14px rgba(2,132,199,.35);
      transition:opacity .25s ease, transform .25s ease, background .2s ease;
      display:flex; align-items:center; justify-content:center;
      opacity:0; pointer-events:none; line-height:1;
    }
    .scroll-btn.show { opacity:1; pointer-events:auto; }
    .scroll-btn:hover { transform:translateY(-3px); background:var(--sky2); }
  </style>
</head>
<body>

<div id="read-progress"></div>

<nav id="navbar">
  <a class="nav-logo" href="/dynamic-duo-web/">dynamic duo 𓆝.°•</a>
  <div class="nav-links">
    <div class="nav-item"><a href="/dynamic-duo-web/">Trang chủ</a></div>
    <div class="nav-item">
      <button class="nav-btn">Cá dưới nước ▾</button>
      <div class="dropdown-content">
        <div class="dd-section-title">Trang mục</div>
