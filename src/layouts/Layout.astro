<script is:inline>
/* ─── SCROLL + PROGRESS ─── */
const _st = document.getElementById('scrollTop');
const _sb = document.getElementById('scrollBot');
const _rp = document.getElementById('read-progress');
if (_st) _st.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
if (_sb) _sb.addEventListener('click', () => window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' }));
function _updScroll() {
  const y = window.scrollY;
  const max = Math.max(1, document.body.scrollHeight - window.innerHeight);
  const pct = y / max;
  if (_st) _st.classList.toggle('show', y > 300);
  if (_sb) _sb.classList.toggle('show', pct < 0.97 && max > 100);
  if (_rp) _rp.style.width = (pct * 100) + '%';
}
window.addEventListener('scroll', _updScroll, { passive: true });
requestAnimationFrame(() => setTimeout(_updScroll, 200));

/* ─── HAMBURGER ─── */
document.getElementById('hamburger')?.addEventListener('click', () => {
  document.getElementById('mobileMenu')?.classList.toggle('open');
});
document.addEventListener('click', (e) => {
  const mm = document.getElementById('mobileMenu');
  const hb = document.getElementById('hamburger');
  if (mm?.classList.contains('open') && !mm.contains(e.target) && !hb?.contains(e.target))
    mm.classList.remove('open');
});

/* ─── CHAPTER DROPDOWNS ─── */
function setupDD(btnId, listId) {
  const btn = document.getElementById(btnId);
  const list = document.getElementById(listId);
  if (!btn || !list) return;
  btn.addEventListener('click', (e) => {
    e.stopPropagation();
    const wasOpen = list.classList.contains('open');
    document.querySelectorAll('.chap-dd-list.open').forEach(el => el.classList.remove('open'));
    if (!wasOpen) {
      list.classList.add('open');
      const cur = list.querySelector('.cur-chap');
      if (cur) setTimeout(() => cur.scrollIntoView({ block: 'center' }), 30);
    }
  });
}
setupDD('ddBtnTop', 'ddListTop');
setupDD('ddBtnBot', 'ddListBot');
document.addEventListener('click', () => {
  document.querySelectorAll('.chap-dd-list.open').forEach(el => el.classList.remove('open'));
});

/* ─── INLINE COMMENT — public storage via Artifacts API ─── */
(function setupInlineComments() {
  const content = document.querySelector('.novel-content');
  if (!content) return;

  /* Storage key = pathname để phân biệt từng chương */
  const pageKey = 'dd_ic_' + location.pathname.replace(/[^a-zA-Z0-9_-]/g, '_');

  /* ── Helpers ── */
  function timeAgo(ts) {
    const d = Date.now() - ts;
    if (d < 60000) return 'vừa xong';
    if (d < 3600000) return Math.floor(d/60000) + ' phút trước';
    if (d < 86400000) return Math.floor(d/3600000) + ' giờ trước';
    return Math.floor(d/86400000) + ' ngày trước';
  }

  /* ── Load từ storage (shared = public) ── */
  async function loadStore() {
    try {
      const res = await window.storage?.get(pageKey, true);
      return res ? JSON.parse(res.value) : {};
    } catch(e) {
      /* Fallback: localStorage nếu storage API chưa có */
      try { return JSON.parse(localStorage.getItem(pageKey) || '{}'); } catch(e2) { return {}; }
    }
  }

  /* ── Lưu vào storage (shared = public) ── */
  async function saveStore(store) {
    try {
      await window.storage?.set(pageKey, JSON.stringify(store), true);
    } catch(e) {}
    /* Backup localStorage */
    try { localStorage.setItem(pageKey, JSON.stringify(store)); } catch(e) {}
  }

  /* ── Global store (sẽ load async) ── */
  let store = {};
  loadStore().then(s => { store = s; });

  /* ── Bubble (fixed, gắn vào body) ── */
  const bubble = document.createElement('div');
  bubble.className = 'ic-bubble';
  document.body.appendChild(bubble);
  let currentIdx = null;

  function positionBubble(trigger) {
    const rect = trigger.getBoundingClientRect();
    const bw = Math.min(290, window.innerWidth - 32);
    const margin = 8;
    let top = rect.top - 4;
    const maxTop = window.innerHeight - 420 - margin;
    if (top > maxTop) top = maxTop;
    if (top < 70) top = 70;
    let left = rect.right + margin;
    if (left + bw > window.innerWidth - margin) left = rect.left - bw - margin;
    if (left < margin) { left = Math.max(margin, (window.innerWidth - bw) / 2); top = rect.bottom + margin; }
    bubble.style.cssText += `;width:${bw}px;left:${left}px;top:${top}px`;
  }

  function renderComments(list, idx) {
    if (!list || !list.length)
      return '<div style="color:var(--text-dim);font-size:.72rem;text-align:center;padding:8px 0">Chưa có bình luận. Hãy là người đầu tiên! 🌊</div>';
    return list.map((c, ci) => `
      <div class="ic-comment-item">
        <button class="ic-delete-btn" data-para="${idx}" data-ci="${ci}" title="Xóa">✕</button>
        <div class="ic-comment-name">${c.name || 'Khách vô danh'}<span class="ic-comment-time">${timeAgo(c.ts)}</span></div>
        <p class="ic-comment-text">${c.text.replace(/</g,'&lt;')}</p>
        ${(c.replies||[]).map((r,ri) => `
          <div style="margin:5px 0 0 12px;padding:5px 8px;background:rgba(186,230,253,.15);border-radius:8px;border-left:2px solid var(--sky-light);position:relative">
            <button class="ic-delete-btn" data-para="${idx}" data-ci="${ci}" data-ri="${ri}" style="opacity:0" title="Xóa reply">✕</button>
            <div class="ic-comment-name" style="font-size:.65rem">${r.name||'Khách vô danh'}<span class="ic-comment-time">${timeAgo(r.ts)}</span></div>
            <p class="ic-comment-text">${r.text.replace(/</g,'&lt;')}</p>
          </div>`).join('')}
        <span class="ic-reply-btn" data-para="${idx}" data-ci="${ci}">↩ Trả lời</span>
      </div>`).join('');
  }

  async function refreshBubble(idx) {
    /* Reload từ storage để lấy comment mới nhất từ mọi người */
    store = await loadStore();
    const comments = store[idx] || [];
    bubble.setAttribute('data-para', idx);
    bubble.innerHTML = `
      <div class="ic-bubble-header">
        <span>💬 <strong>${comments.length}</strong> bình luận · đoạn ${idx + 1}</span>
        <button class="ic-bubble-close" id="icBubbleClose">✕ đóng</button>
      </div>
      <div class="ic-comments-list" id="icList${idx}">${renderComments(comments, idx)}</div>
      <div class="ic-name-row">
        <input class="ic-input ic-name-inp" placeholder="Tên (tùy chọn)" style="width:80px;flex:0 0 80px" />
        <input class="ic-input ic-text-inp" placeholder="Viết bình luận..." />
      </div>
      <div class="ic-reply-row">
        <button class="ic-send-btn">Gửi ✦</button>
      </div>`;

    /* Đóng bubble */
    bubble.querySelector('#icBubbleClose')?.addEventListener('click', (e) => {
      e.stopPropagation();
      bubble.classList.remove('open');
      currentIdx = null;
    });

    /* Gửi comment */
    bubble.querySelector('.ic-send-btn').addEventListener('click', async () => {
      const name = bubble.querySelector('.ic-name-inp').value.trim();
      const text = bubble.querySelector('.ic-text-inp').value.trim();
      if (!text) return;
      if (!store[idx]) store[idx] = [];
      store[idx].push({ name, text, ts: Date.now(), replies: [] });
      await saveStore(store);
      await refreshBubble(idx);
    });

    /* Reply */
    bubble.querySelectorAll('.ic-reply-btn').forEach(rb => {
      rb.addEventListener('click', async () => {
        const ci = parseInt(rb.dataset.ci);
        const rName = prompt('Tên của bạn (tùy chọn):') || '';
        const rText = prompt('Trả lời:') || '';
        if (!rText.trim()) return;
        if (!store[idx][ci].replies) store[idx][ci].replies = [];
        store[idx][ci].replies.push({ name: rName, text: rText, ts: Date.now() });
        await saveStore(store);
        await refreshBubble(idx);
      });
    });

    /* Xóa comment / reply */
    bubble.querySelectorAll('.ic-delete-btn').forEach(db => {
      db.addEventListener('click', async (e) => {
        e.stopPropagation();
        if (!confirm('Xóa bình luận này?')) return;
        const ci = parseInt(db.dataset.ci);
        const ri = db.dataset.ri !== undefined ? parseInt(db.dataset.ri) : null;
        if (ri !== null) {
          store[idx][ci].replies.splice(ri, 1);
        } else {
          store[idx].splice(ci, 1);
          if (store[idx].length === 0) delete store[idx];
        }
        await saveStore(store);
        await refreshBubble(idx);
      });
    });
  }

  content.querySelectorAll('p').forEach((p, idx) => {
    const trigger = document.createElement('span');
    trigger.className = 'ic-trigger';
    trigger.title = 'Bình luận đoạn này';
    trigger.textContent = '💬';
    p.appendChild(trigger);

    trigger.addEventListener('click', async (e) => {
      e.stopPropagation();
      if (currentIdx === idx && bubble.classList.contains('open')) {
        bubble.classList.remove('open'); currentIdx = null; return;
      }
      currentIdx = idx;
      bubble.innerHTML = '<div class="ic-loading">Đang tải bình luận...</div>';
      bubble.classList.add('open');
      positionBubble(trigger);
      await refreshBubble(idx);
      positionBubble(trigger);
      setTimeout(() => bubble.querySelector('.ic-text-inp')?.focus(), 50);
    });
  });

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.ic-bubble') && !e.target.closest('.ic-trigger')) {
      bubble.classList.remove('open'); currentIdx = null;
    }
  });

  window.addEventListener('scroll', () => {
    if (bubble.classList.contains('open') && currentIdx !== null) {
      const triggers = content.querySelectorAll('.ic-trigger');
      const t = triggers[currentIdx];
      if (t) positionBubble(t);
    }
  }, { passive: true });
})();

/* ─── DARK MODE ─── */
function applyTheme(dark) {
  document.documentElement.setAttribute('data-theme', dark ? 'dark' : '');
  localStorage.setItem('dd-theme', dark ? 'dark' : 'light');
  const giscus = document.querySelector('iframe.giscus-frame');
  if (giscus) giscus.contentWindow.postMessage({ giscus: { setConfig: { theme: dark ? 'dark' : 'light' }}}, 'https://giscus.app');
}
window.__ddToggleTheme = function() {
  applyTheme(document.documentElement.getAttribute('data-theme') !== 'dark');
};
</script>
