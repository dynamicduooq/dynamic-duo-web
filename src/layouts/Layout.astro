      position: fixed; top: 56px; left: 0; right: 0; z-index: 499;
      box-shadow: 0 10px 20px rgba(0,0,0,0.1);
      max-height: calc(100vh - 56px); overflow-y: auto;
    }
    .mobile-menu.open { display: flex; }
