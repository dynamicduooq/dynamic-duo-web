    /* Tags */
    .tag-badge { display:inline-block; margin:2px 3px; padding:3px 10px; border:1px solid var(--sky-light); border-radius:var(--r-pill); font-size:.72rem; color:var(--sky-dark); transition:var(--t); background:var(--sky-pale); }
    .tag-badge:hover { background:var(--sky-light); }
    [data-theme="dark"] .tag-badge { color:#89d0f5; border-color:#1e5a7a; background:rgba(21,101,160,.2); }
    [data-theme="dark"] .tag-badge:hover { background:rgba(96,184,232,.1); }

    /* FIX 6: Admin floating button */
    #adminFloatingBtn {
      opacity: 0.15;
      position: fixed;
      bottom: 8px;
      right: 8px;
      z-index: 410;
      width: 18px; height: 18px;
      border-radius: 50%;
      background: linear-gradient(135deg, #1565a0, #0e3d6e);
