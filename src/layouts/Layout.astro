  }

  const btnPlay = document.getElementById('btnPlayTTS'), btnPause = document.getElementById('btnPauseTTS'), btnStop = document.getElementById('btnStopTTS');
  const btnNext = document.getElementById('btnNextSent'), btnPrev = document.getElementById('btnPrevSent');
  const voiceSelect = document.getElementById('aaVoiceSelect'), rateRange = document.getElementById('aaRateRange'), rateValue = document.getElementById('aaRateValue');
  const content = document.getElementById('novelContent'), aaSettings = document.getElementById('aaSettings');

  if(btnPlay && content && 'speechSynthesis' in window) {
    const synth = window.speechSynthesis;
    let sentences = [];
    let currentIdx = 0;
    let isPaused = false;
    let voices = []; 

    function loadVoices() {
      const allVoices = synth.getVoices();
      if (allVoices.length === 0) return; 
      let vnVoices = allVoices.filter(v => v.lang.toLowerCase().includes('vi') || v.name.toLowerCase().includes('viet'));
      if (vnVoices.length === 0) vnVoices = allVoices;
      voices = vnVoices;
      voiceSelect.innerHTML = voices.map((v, i) => `<option value="${i}">${v.name} (${v.lang})</option>`).join('');
    }

    loadVoices();
    if(synth.onvoiceschanged !== undefined) synth.onvoiceschanged = loadVoices;

    document.getElementById('btnToggleAudioSet')?.addEventListener('click', () => aaSettings?.classList.toggle('open'));
    if(rateRange) rateRange.oninput = () => { if(rateValue) rateValue.textContent = rateRange.value + 'x'; };

    function resetAudioUI() {
      synth.cancel();
      btnPlay.style.display = 'inline-block'; btnPlay.textContent = '▶ Nghe';
      btnPause.style.display = 'none'; btnStop.style.display = 'none';
      isPaused = false; currentIdx = 0;
    }

    function initSentences() {
      const clone = content.cloneNode(true);
      clone.querySelectorAll('.ic-trigger, .editor-note-box, .tags-container, script, style, .auto-audio-player, .chap-nav-row').forEach(el => el.remove());
      sentences = clone.innerText.split(/[.?!|\n]/).map(s => s.trim()).filter(s => s.length > 1);
    }

    function speakSentence() {
      synth.cancel(); 
      if (currentIdx < 0) currentIdx = 0;
      if (currentIdx >= sentences.length) { resetAudioUI(); return; }
      if (isPaused) return;

      const utter = new SpeechSynthesisUtterance(sentences[currentIdx]);
      utter.rate = parseFloat(rateRange.value || 1);
      
      const selectedIdx = voiceSelect.value;
      if (voices.length > 0 && selectedIdx !== "") {
        utter.voice = voices[selectedIdx];
        utter.lang = utter.voice.lang; 
      } else { utter.lang = 'vi-VN'; }

      utter.onend = () => { if(!isPaused) { currentIdx++; speakSentence(); } };
      utter.onerror = (e) => { if (e.error !== 'interrupted') resetAudioUI(); };
      synth.speak(utter);
    }

    btnPlay.addEventListener('click', () => {
      if (isPaused) { isPaused = false; } else { initSentences(); if (sentences.length === 0) return alert("Không tìm thấy nội dung"); currentIdx = 0; }
      speakSentence();
      btnPlay.style.display = 'none'; btnPause.style.display = 'inline-block'; btnStop.style.display = 'inline-block';
    });

    btnPause.addEventListener('click', () => {
      isPaused = true; synth.cancel();
      btnPlay.style.display = 'inline-block'; btnPlay.textContent = '▶ Tiếp tục'; btnPause.style.display = 'none';
    });
    btnStop.addEventListener('click', resetAudioUI);

    btnNext?.addEventListener('click', () => {
      if (sentences.length === 0) initSentences(); 
      if (sentences.length > 0) { isPaused = false; currentIdx = Math.min(sentences.length - 1, currentIdx + 1); speakSentence(); btnPlay.style.display = 'none'; btnPause.style.display = 'inline-block'; btnStop.style.display = 'inline-block'; }
    });

    btnPrev?.addEventListener('click', () => {
      if (sentences.length === 0) initSentences();
      if (sentences.length > 0) { isPaused = false; currentIdx = Math.max(0, currentIdx - 1); speakSentence(); btnPlay.style.display = 'none'; btnPause.style.display = 'inline-block'; btnStop.style.display = 'inline-block'; }
    });
  }
  
  const footerAdminBtn = document.getElementById('footerAdmin');
  if (footerAdminBtn) {
