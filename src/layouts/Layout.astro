/* =========================================
   THIẾT LẬP BẢNG MÀU XANH NƯỚC BIỂN
   ========================================= */
:root {
  --blue-main: #0288d1;      /* Chữ và Icon màu xanh biển đậm vừa để dễ đọc */
  --blue-light: #e1f5fe;     /* Xanh biển rất nhạt cho nền khi ấn/hover */
  --blue-border: #81d4fa;    /* Viền xanh biển nhạt */
  --shadow-btn: 0 2px 6px rgba(2, 136, 209, 0.12); /* Bóng xanh mờ */
}

/* =========================================
   THANH ĐIỀU HƯỚNG CHƯƠNG (2 HÀNG)
   ========================================= */
.chap-nav-row {
  display: flex !important;
  flex-wrap: wrap !important; /* Cho phép các nút rớt xuống hàng mới */
  justify-content: center; 
  align-items: center;
  gap: 12px; 
  padding: 20px 0; 
  width: 100%;
  max-width: 420px; /* Độ rộng vừa phải để 3 nút dưới không bị quá bẹt */
  margin: 0 auto !important;
}

/* ------------------------------------------------
   1. ĐƯA MỤC LỤC LÊN HÀNG TRÊN CÙNG & CANH GIỮA
   (Dùng :nth-child(2) vì trong ảnh Mục lục đứng thứ 2)
   ------------------------------------------------ */
.chap-nav-row > :nth-child(2) {
  order: 1 !important; /* Đẩy lên vị trí đầu tiên */
  flex: 0 0 100% !important; /* Ép chiếm trọn 100% chiều ngang để rớt dòng */
  max-width: 160px; /* Độ rộng vừa phải cho nút Mục lục */
  margin: 0 auto 4px auto !important; /* Canh giữa và cách hàng dưới 4px */
}

/* ------------------------------------------------
   2. BA NÚT CÒN LẠI (HÀNG DƯỚI)
   ------------------------------------------------ */
.chap-pn, 
.chap-dd-wrap {
  order: 2; /* Nằm ở hàng thứ 2 */
  flex: 1; /* Chia đều không gian ngang cho 3 nút */
  min-width: 0;
}

.chap-dd-wrap .chap-dd-btn {
  width: 100%; /* Nút chọn chương tự động co giãn bằng 2 nút kia */
}

/* ------------------------------------------------
   3. ĐỊNH DẠNG CHUNG CHO TẤT CẢ CÁC NÚT (BO TRÒN, MÀU SẮC)
   ------------------------------------------------ */
.chap-pn, 
.chap-dd-btn,
.chap-nav-row > :nth-child(2) {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 44px; /* Tăng nhẹ chiều cao để nút nhìn sang và dễ chạm hơn */
  font-size: 0.85rem !important; 
  font-weight: 500;
  color: var(--blue-main) !important; /* Chữ xanh nước biển */
  background-color: #ffffff; /* Nền trắng */
  border: 1.5px solid var(--blue-border) !important; /* Viền xanh biển nhạt */
  border-radius: 999px !important; /* BO TRÒN TỐI ĐA (DẠNG VIÊN THUỐC) */
  padding: 0 12px !important; 
  box-shadow: var(--shadow-btn); 
  
  /* Cắt chữ thừa gọn gàng */
  white-space: nowrap !important; 
  overflow: hidden;
  text-overflow: ellipsis;
  
  cursor: pointer;
  user-select: none;
  transition: all 0.2s ease-in-out;
}

/* Hiệu ứng khi lướt qua (Hover) */
.chap-pn:hover, 
.chap-dd-btn:hover,
.chap-nav-row > :nth-child(2):hover {
  background-color: var(--blue-light) !important; /* Nền chuyển xanh biển siêu nhạt */
  border-color: var(--blue-main) !important; /* Viền đậm lên 1 chút */
  transform: translateY(-2px); 
  box-shadow: 0 4px 8px rgba(2, 136, 209, 0.2);
}

/* Hiệu ứng khi chạm/bấm (Active) */
.chap-pn:active, 
.chap-dd-btn:active,
.chap-nav-row > :nth-child(2):active {
  transform: scale(0.95); 
  background-color: #b3e5fc !important;
}

/* =========================================
   4. RESPONSIVE CHO MÀN HÌNH SIÊU NHỎ (< 480px)
   ========================================= */
@media (max-width: 480px) {
  .chap-nav-row {
    gap: 8px; /* Thu hẹp khoảng cách giữa các nút */
    padding: 16px 0;
  }
  
  .chap-pn, 
  .chap-dd-btn,
  .chap-nav-row > :nth-child(2) {
    height: 40px; /* Thu nhỏ nút lại một chút trên đt */
    font-size: 0.78rem !important; 
    padding: 0 8px !important;
  }

  /* Khung dropdown ở giữa cho rộng hơn xíu để hiện rõ tên chương */
  .chap-dd-wrap { 
    flex: 1.4; 
  }
}
</style>
