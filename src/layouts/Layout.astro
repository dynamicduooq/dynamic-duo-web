---
const { frontmatter, title: titleProp } = Astro.props;
import settings from '../data/settings.json';

const pageTitle = frontmatter?.title || titleProp || settings.site_name;
const currentPath = Astro.url?.pathname ?? '';
const isNovelPage = frontmatter?.chuong !== undefined && frontmatter?.chuong !== 0;
const currentTruyenId = frontmatter?.truyen_id;

let chapters: any[] = [];
let prevChap: any = null;
let nextChap: any = null;

if (currentTruyenId && isNovelPage) {
  const allPosts = Object.values(import.meta.glob('../pages/**/*.md', { eager: true })) as any[];
  chapters = allPosts
    .filter((p) => p.frontmatter?.truyen_id === currentTruyenId && p.frontmatter?.chuong !== undefined && p.frontmatter?.chuong !== 0)
    .sort((a, b) => (a.frontmatter?.chuong ?? 999) - (b.frontmatter?.chuong ?? 999));

  const idx = chapters.findIndex((c) => {
    const cUrl = (c.url || '').replace(/\/$/, '');
    const cur = currentPath.replace(/\/$/, '');
    return cUrl === cur || cur.endsWith(cUrl);
  });
  if (idx > 0) prevChap = chapters[idx - 1];
  if (idx >= 0 && idx < chapters.length - 1) nextChap = chapters[idx + 1];
}
---
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle} | {settings.site_name}</title>
  <meta name="description" content={frontmatter?.description || settings.tagline} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,600;1,6..72,300;1,6..72,400&family=Literata:ital,opsz,wght@0,7..72,300;0,7..72,400;0,7..72,600;1,7..72,300;1,7..72,400&family=Merriweather:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet" />

  <style is:global>
    :root {
      --sky:       #0ea5e9;
      --sky2:      #0284c7;
      --sky-dark:  #0369a1;
      --sky-light: #bae6fd;
      --sky-pale:  #f0f9ff;
      --cream:     #fafcff;
      --bg-content:#ffffff;
      --text-main: #1e3a5f;
      --text-mid:  #64748b;
      --text-dim:  #94a3b8;
      --sh-card:   0 4px 15px rgba(2,132,199,.12);
      --sh-soft:   0 2px 8px rgba(0,0,0,.08);
      --r-sm:      6px;
      --r-md:      12px;
      --r-lg:      20px;
      --r-pill:    999px;
      --t:         all .2s ease;
    }

    *, *::before, *::after { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      background: var(--cream);
      color: var(--text-main);
      font-family: 'Newsreader', serif;
      font-size: 18px;
      line-height: 1.9;
      margin: 0; padding: 0;
      overflow-x: hidden;
    }

    h1, h2, h3, h4 { font-family: 'Merriweather', serif; color: var(--sky-dark); text-align: center; }
    a { color: inherit; text-decoration: none; }

    ::-webkit-scrollbar { width: 5px; }
    ::-webkit-scrollbar-track { background: var(--sky-pale); }
    ::-webkit-scrollbar-thumb { background: var(--sky-light); border-radius: 3px; }

    /* ── NAVBAR ── */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 500;
      display: flex; align-items: center; justify-content: space-between;
      height: 56px; padding: 0 28px;
      background: rgba(255,255,255,.97); backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(186,230,253,.5);
      box-shadow: 0 2px 12px rgba(2,132,199,.08);
    }
    .nav-logo {
      font-family: 'Literata', serif; font-weight: 600; font-size: .95rem;
      color: var(--sky-dark); white-space: nowrap; letter-spacing: .5px;
    }
    .nav-links { display: flex; align-items: center; gap: 2px; }
    .nav-item { position: relative; }
    .nav-item > a, .nav-btn {
      font-family: 'Newsreader', serif; font-size: .76rem; font-weight: 400;
      color: var(--text-mid); letter-spacing: 1px; text-transform: uppercase;
      padding: 6px 12px; border-radius: var(--r-pill);
      display: inline-flex; align-items: center; gap: 5px;
      transition: var(--t); cursor: pointer; background: none; border: none; white-space: nowrap;
    }
    .nav-item > a:hover, .nav-btn:hover,
    .nav-item:hover > a, .nav-item:hover > .nav-btn {
      background: var(--sky-pale); color: var(--sky);
    }
    .nav-item > a.active-link { color: var(--sky); font-weight: 600; }

    /* Dropdown */
    .dropdown-content {
      position: absolute; top: calc(100% + 8px); left: 50%;
      transform: translateX(-50%) translateY(8px);
      min-width: 240px; background: #fff;
      border: 1px solid rgba(186,230,253,.7); border-radius: var(--r-md);
      box-shadow: 0 16px 48px rgba(2,132,199,.13), 0 2px 8px rgba(2,132,199,.06);
      padding: 8px 6px;
      opacity: 0; visibility: hidden; pointer-events: none;
      transition: opacity .22s ease, transform .22s ease; z-index: 600;
    }
    .nav-item:hover .dropdown-content {
      opacity: 1; visibility: visible; pointer-events: auto;
      transform: translateX(-50%) translateY(0);
    }
    .dd-section-title { font-size: .62rem; letter-spacing: 2px; text-transform: uppercase; color: var(--text-dim); padding: 6px 12px 3px; }
    .dd-item { display: flex; align-items: center; gap: 7px; padding: 7px 12px; font-size: .82rem; color: var(--text-mid); border-radius: var(--r-sm); transition: var(--t); }
    .dd-item:hover { background: var(--sky-pale); color: var(--sky); }
    .dd-divider { height: 1px; background: rgba(186,230,253,.45); margin: 5px 8px; }

    /* Hamburger mobile */
    .nav-hamburger {
      display: none; flex-direction: column; gap: 5px;
      cursor: pointer; padding: 6px; background: none; border: none;
    }
    .nav-hamburger span { display: block; width: 22px; height: 2px; background: var(--sky-dark); border-radius: 2px; transition: var(--t); }
    .mobile-menu {
      display: none; position: fixed; top: 56px; left: 0; right: 0;
      background: rgba(255,255,255,.99); backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(186,230,253,.5);
      padding: 10px 16px 18px; z-index: 490;
      flex-direction: column; gap: 2px;
      box-shadow: 0 8px 24px rgba(2,132,199,.1);
      max-height: calc(100vh - 56px); overflow-y: auto;
    }
    .mobile-menu.open { display: flex; }
    .mobile-menu a { padding: 9px 12px; font-size: .88rem; color: var(--text-mid); border-radius: var(--r-sm); transition: var(--t); display: block; }
    .mobile-menu a:hover { background: var(--sky-pale); color: var(--sky); }
    .mobile-section-title { font-size: .65rem; letter-spacing: 2px; text-transform: uppercase; color: var(--text-dim); padding: 10px 12px 3px; }
    @media (max-width: 700px) { .nav-links { display: none; } .nav-hamburger { display: flex; } }

    /* ── LAYOUT ── */
    .page-wrapper { margin-top: 80px; min-height: 70vh; padding: 0 16px; }
    .container {
      max-width: 800px; margin: 0 auto 60px;
      background: rgba(255,255,255,.98);
      padding: 40px 50px; border-radius: var(--r-lg);
      box-shadow: var(--sh-soft); border: 1px solid rgba(186,230,253,.5);
    }
    @media (max-width: 640px) { .container { padding: 24px 20px; } }

    /* ── NỘI DUNG TRUYỆN ── */
    .novel-content { position: relative; }
    .novel-content p { position: relative; padding-right: 30px; }

    blockquote {
      font-style: italic; font-size: .9rem; color: var(--text-mid); line-height: 1.75;
      border-left: 3px solid var(--sky-light); padding: 15px 20px;
      margin: 20px 0; background: var(--sky-pale); border-radius: 0 12px 12px 0;
    }
    hr { border: none; text-align: center; margin: 40px 0; }
    hr::after { content: "𓆝 𓆟 𓆞 𓆝 𓆟"; color: var(--sky-light); font-size: 20px; letter-spacing: 5px; }

    /* ── TAG BADGES ── */
    .tag-badge {
      display: inline-block; padding: 4px 12px;
      border: 1.5px solid var(--sky); border-radius: var(--r-pill);
      font-size: .8rem; margin: 3px; color: var(--sky); transition: var(--t);
    }
    .tag-badge:hover { background: var(--sky-pale); }

    /* ── CHAPTER DROPDOWN ── */
    .chap-nav-wrap {
      display: flex; justify-content: center; gap: 10px;
      align-items: center; margin: 20px 0; flex-wrap: wrap;
    }
    .chap-select-btn {
      position: relative;
      display: inline-flex; align-items: center; gap: 8px;
      padding: 9px 20px;
      background: var(--sky-pale); border: 1.5px solid var(--sky-light);
      border-radius: var(--r-pill); color: var(--sky-dark);
      font-size: .86rem; font-family: 'Newsreader', serif; font-weight: 600;
      cursor: pointer; transition: var(--t); user-select: none;
    }
    .chap-select-btn:hover { background: var(--sky-light); color: var(--sky-dark); }

    .chap-dropdown-list {
      position: absolute; top: calc(100% + 6px); left: 50%;
      transform: translateX(-50%);
      width: 290px; max-height: 270px; overflow-y: auto;
      background: #fff; border: 1px solid var(--sky-light);
      border-radius: var(--r-md); z-index: 200;
      box-shadow: var(--sh-card);
      display: none; flex-direction: column;
    }
    .chap-dropdown-list.open { display: flex; }
    .chap-dropdown-list a {
      padding: 9px 16px; border-bottom: 1px solid rgba(186,230,253,.3);
      color: var(--text-mid); font-size: .83rem; transition: var(--t);
    }
    .chap-dropdown-list a:last-child { border-bottom: none; }
    .chap-dropdown-list a:hover { background: var(--sky-pale); color: var(--sky); }
    .chap-dropdown-list a.current-chap { background: var(--sky-pale); color: var(--sky); font-weight: 600; }

    /* PREV / NEXT */
    .chap-prev-next {
      display: flex; justify-content: space-between; align-items: center;
      gap: 12px; margin: 36px 0 20px; flex-wrap: wrap;
    }
    .chap-pn-btn {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 9px 18px; border: 1.5px solid var(--sky-light);
      border-radius: var(--r-pill); color: var(--sky-dark); font-size: .83rem;
      font-family: 'Newsreader', serif; transition: var(--t); flex: 1; min-width: 120px;
    }
    .chap-pn-btn:hover { background: var(--sky-pale); color: var(--sky); }
    .chap-pn-btn.prev-btn { justify-content: flex-start; }
    .chap-pn-btn.next-btn { justify-content: flex-end; }

    /* ── INLINE BÌNH LUẬN ── */
    .inline-comment-btn {
      position: absolute; right: 0; top: 50%; transform: translateY(-50%);
      width: 22px; height: 22px; border-radius: 50%;
      background: var(--sky-pale); border: 1px solid var(--sky-light);
      color: var(--sky); font-size: .6rem;
      display: none; align-items: center; justify-content: center;
      cursor: pointer; transition: var(--t); line-height: 1;
    }
    .novel-content p:hover .inline-comment-btn { display: flex; }
    .inline-comment-btn:hover { background: var(--sky); color: #fff; }
    .inline-panel {
      background: var(--sky-pale); border: 1px solid var(--sky-light);
      border-radius: var(--r-md); padding: 12px 16px; margin: 6px 0 10px;
      font-size: .83rem; display: none;
    }
    .inline-panel.open { display: block; }
    .inline-panel textarea {
      width: 100%; border: 1px solid var(--sky-light); border-radius: var(--r-sm);
      padding: 8px 12px; font-family: 'Newsreader', serif; font-size: .83rem;
      resize: vertical; min-height: 56px; color: var(--text-main); background: #fff;
    }
    .inline-panel textarea:focus { outline: none; border-color: var(--sky); }
    .inline-submit {
      margin-top: 7px; padding: 5px 14px; background: var(--sky); color: #fff;
      border: none; border-radius: var(--r-pill); font-size: .78rem; cursor: pointer; transition: var(--t);
    }
    .inline-submit:hover { background: var(--sky2); }

    /* ── GISCUS ── */
    .giscus-wrap { margin-top: 56px; border-top: 1px dashed var(--sky-light); padding-top: 28px; }

    /* ── FOOTER ── */
    footer { background: #fff; border-top: 1px solid rgba(186,230,253,.4); padding: 44px 20px 26px; }
    .footer-inner {
      max-width: 1120px; margin: 0 auto;
      display: grid; grid-template-columns: 1fr auto 1fr; gap: 28px; align-items: start;
    }
    @media (max-width: 600px) { .footer-inner { grid-template-columns: 1fr; text-align: center; } .ft-social { align-items: center !important; } }
    .ft-logo { font-family: 'Literata', serif; font-size: 1.1rem; font-weight: 600; color: var(--sky-dark); display: block; margin-bottom: 5px; }
    .ft-brand p { font-size: .78rem; color: var(--text-dim); font-style: italic; margin: 3px 0; }
    .ft-links { display: flex; flex-direction: column; gap: 7px; align-items: center; }
    .ft-links a { font-size: .76rem; color: var(--text-mid); letter-spacing: 1px; text-transform: uppercase; transition: var(--t); }
    .ft-links a:hover { color: var(--sky); }
    .ft-social { display: flex; flex-direction: column; gap: 7px; align-items: flex-end; }
    .ft-social-row { display: flex; gap: 8px; }
    .social-ic {
      width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--sky-light);
      display: flex; align-items: center; justify-content: center;
      font-size: .88rem; color: var(--sky); background: var(--sky-pale); transition: var(--t);
    }
    .social-ic:hover { background: var(--sky-light); transform: translateY(-2px); }
    .ft-bottom { max-width: 1120px; margin: 26px auto 0; padding-top: 16px; border-top: 1px solid rgba(186,230,253,.3); text-align: center; font-size: .7rem; color: var(--text-dim); letter-spacing: 1px; }

    /* ── SCROLL BUTTONS ── */
    .scroll-btns { position: fixed; bottom: 24px; right: 22px; z-index: 300; display: flex; flex-direction: column; gap: 8px; }
    .scroll-btn {
      width: 40px; height: 40px; border-radius: 50%; background: var(--sky); color: #fff;
      border: none; cursor: pointer; font-size: 1rem; box-shadow: var(--sh-card);
      transition: var(--t); display: flex; align-items: center; justify-content: center;
      opacity: 0; pointer-events: none;
    }
    .scroll-btn.show { opacity: 1; pointer-events: auto; }
    .scroll-btn:hover { transform: translateY(-3px); background: var(--sky2); }
  </style>
</head>
<body>

