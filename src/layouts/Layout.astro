      <a href="/dynamic-duo-web/ca-tren-ban/">Cá trên bàn</a>
      <a href="/dynamic-duo-web/ca-tren-troi/">Cá trên trời</a>
      <a href="/dynamic-duo-web/about/">About</a>
    </div>
    <div class="ft-social">
      <p style="font-size:.68rem;color:var(--text-dim);letter-spacing:1px;text-transform:uppercase;margin-bottom:6px">Ghé thăm</p>
      <div class="ft-social-row">
        <a href="https://dynamicduoq.wordpress.com" target="_blank" class="social-ic" title="WordPress">🌐</a>
      </div>
    </div>
  </div>
  <div class="ft-bottom">dynamic duo 𓆝.°• · made with 🌊 by Xê &amp; Gờ · 2026</div>
</footer>

<!-- SCROLL BUTTONS -->
<div class="scroll-btns">
  <button class="scroll-btn" id="scrollTop" title="Lên đầu" onclick="scrollTo({top:0,behavior:'smooth'})">↑</button>
  <button class="scroll-btn" id="scrollBot" title="Xuống cuối" onclick="scrollTo({top:document.body.scrollHeight,behavior:'smooth'})">↓</button>
</div>

<script is:inline>
  // ── Scroll buttons ──
  const _st = document.getElementById('scrollTop');
  const _sb = document.getElementById('scrollBot');
  function _updScroll() {
    const y = window.scrollY;
    const max = document.body.scrollHeight - window.innerHeight;
    _st?.classList.toggle('show', y > 300);
    _sb?.classList.toggle('show', y < max - 80);
  }
  window.addEventListener('scroll', _updScroll, { passive: true });
  setTimeout(_updScroll, 150);

  // ── Hamburger ──
  document.getElementById('hamburger')?.addEventListener('click', () => {
    document.getElementById('mobileMenu')?.classList.toggle('open');
  });
  document.addEventListener('click', (e) => {
    const mm = document.getElementById('mobileMenu');
    const hb = document.getElementById('hamburger');
    if (mm?.classList.contains('open') && !mm.contains(e.target) && !hb?.contains(e.target)) {
      mm.classList.remove('open');
    }
  });

  // ── Chapter dropdowns ──
  function setupChapBtn(btnId, listId) {
    const btn = document.getElementById(btnId);
    const list = document.getElementById(listId);
    if (!btn || !list) return;
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = list.classList.contains('open');
      document.querySelectorAll('.chap-dropdown-list.open').forEach(el => el.classList.remove('open'));
      if (!isOpen) list.classList.add('open');
    });
  }
  setupChapBtn('chapBtnTop', 'chapListTop');
  setupChapBtn('chapBtnBot', 'chapListBot');
  document.addEventListener('click', () => {
    document.querySelectorAll('.chap-dropdown-list.open').forEach(el => el.classList.remove('open'));
  });

  // ── Scroll current chapter into view in dropdown ──
  document.querySelectorAll('.current-chap').forEach(el => {
    const list = el.closest('.chap-dropdown-list');
    if (list) setTimeout(() => { el.scrollIntoView({ block: 'center' }); }, 50);
  });

  // ── Inline comment ──
  document.querySelectorAll('.novel-content p').forEach((p, idx) => {
    const btn = document.createElement('button');
    btn.className = 'inline-comment-btn';
    btn.title = 'Bình luận đoạn này';
    btn.textContent = '💬';
    p.style.position = 'relative';
    p.appendChild(btn);

    const panel = document.createElement('div');
    panel.className = 'inline-panel';
    panel.innerHTML = `<div style="font-size:.74rem;color:var(--text-dim);margin-bottom:6px">💬 Bình luận đoạn ${idx + 1}:</div>
      <textarea placeholder="Viết bình luận..."></textarea>
      <button class="inline-submit">Gửi vào Giscus ↓</button>`;
    p.after(panel);

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const wasOpen = panel.classList.contains('open');
      document.querySelectorAll('.inline-panel.open').forEach(el => el.classList.remove('open'));
      if (!wasOpen) { panel.classList.add('open'); panel.querySelector('textarea').focus(); }
    });

    panel.querySelector('.inline-submit').addEventListener('click', () => {
      const txt = panel.querySelector('textarea').value.trim();
      if (!txt) return;
      const quote = `> Đoạn ${idx + 1}: "${p.textContent.trim().slice(0,60)}..."\n\n${txt}`;
      navigator.clipboard?.writeText(quote).catch(() => {});
      document.querySelector('.giscus-wrap')?.scrollIntoView({ behavior: 'smooth' });
      panel.classList.remove('open');
      panel.querySelector('textarea').value = '';
      alert('Đã copy! Paste vào ô bình luận bên dưới nhé.');
    });
  });
</script>
</body>
</html>
