<div class="page-wrapper">
    {fullWidth ? (
        <slot />
    ) : (

  <div class="container">

    {/* Tags */}
    {frontmatter?.tags && frontmatter.tags.length > 0 && (
      <div style="text-align:center;margin-bottom:22px;">
        {frontmatter.tags.map((tag: string) => (
          <a href={`/dynamic-duo-web/tags/${encodeURIComponent(tag)}/`} class="tag-badge"># {tag}</a>
        ))}
      </div>
    )}

    {/* ── CHAPTER NAV ĐẦU TRANG ── */}
    {isNovelPage && (
      <div class="chap-nav-row">
        {prevChap
          ? <a href={prevChap.url} class="chap-pn">← {prevChap.frontmatter?.title || `Chương ${prevChap.frontmatter?.chuong}`}</a>
          : <span class="chap-pn disabled">← Chương trước</span>}

        {chapters.length > 1 && (
          <div class="chap-dd-wrap" id="ddTop">
            <button class="chap-dd-btn" id="ddBtnTop">⚓ Chọn chương ▾</button>
            <div class="chap-dd-list" id="ddListTop">
              {chapters.map((c: any) => (
                <a
                  href={c.url}
                  class={c.frontmatter?.chuong === frontmatter?.chuong ? 'cur-chap' : ''}
                >
                  {c.frontmatter?.title || `Chương ${c.frontmatter?.chuong}`}
                </a>
              ))}
            </div>
          </div>
        )}

        {nextChap
          ? <a href={nextChap.url} class="chap-pn">{nextChap.frontmatter?.title || `Chương ${nextChap.frontmatter?.chuong}`} →</a>
          : <span class="chap-pn disabled">Chương sau →</span>}
      </div>
    )}

    {/* NỘI DUNG */}
    <div class={isNovelPage ? 'novel-content' : ''}>
      <slot />
    </div>

    {/* ── CHAPTER NAV CUỐI TRANG ── */}
    {isNovelPage && (
      <div class="chap-nav-row" style="margin-top:36px;">
        {prevChap
          ? <a href={prevChap.url} class="chap-pn">← {prevChap.frontmatter?.title || `Chương ${prevChap.frontmatter?.chuong}`}</a>
          : <span class="chap-pn disabled">← Chương trước</span>}

        {chapters.length > 1 && (
          <div class="chap-dd-wrap" id="ddBot">
            <button class="chap-dd-btn" id="ddBtnBot">⚓ Chọn chương ▾</button>
            <div class="chap-dd-list up" id="ddListBot">
              {chapters.map((c: any) => (
                <a
                  href={c.url}
                  class={c.frontmatter?.chuong === frontmatter?.chuong ? 'cur-chap' : ''}
                >
                  {c.frontmatter?.title || `Chương ${c.frontmatter?.chuong}`}
                </a>
              ))}
            </div>
          </div>
        )}

        {nextChap
          ? <a href={nextChap.url} class="chap-pn">{nextChap.frontmatter?.title || `Chương ${nextChap.frontmatter?.chuong}`} →</a>
          : <span class="chap-pn disabled">Chương sau →</span>}
      </div>
    )}

    {/* Giscus */}
    {isNovelPage && (
      <div class="giscus-wrap">
        <script src="https://giscus.app/client.js"
          data-repo="dynamicduooq/dynamic-duo-web"
          data-repo-id="R_kgDOSn8PYg"
          data-category="Announcements"
          data-category-id="DIC_kwDOSn8PYs4C923K"
          data-mapping="pathname"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="bottom"
          data-theme="light"
          data-lang="vi"
          crossorigin="anonymous"
          async>
        </script>
      </div>
    )}

  </div>
    )}
</div>

