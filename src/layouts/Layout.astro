      font-family:'Newsreader',serif; color:var(--text-main);
      background:var(--cream); outline:none;
    }
    [data-theme="dark"] .comment-inp { background:#102030; border-color:#2a6a8a; color:#d8eeff; }
    [data-theme="dark"] .comment-inp::placeholder { color:#5a8fa8; }
    .comment-inp:focus { border-color:var(--sky); }
    .comment-textarea {
      width:100%; padding:10px 14px; border:1.5px solid var(--sky-light);
      border-radius:12px; font-size:.84rem;
      font-family:'Newsreader',serif; color:var(--text-main);
      background:var(--cream); outline:none; resize:vertical; min-height:80px;
      box-sizing:border-box; margin-bottom:10px;
    }
    [data-theme="dark"] .comment-textarea { background:#102030; border-color:#2a6a8a; color:#d8eeff; }
    [data-theme="dark"] .comment-textarea::placeholder { color:#5a8fa8; }
    .comment-textarea:focus { border-color:var(--sky); }
    .comment-submit-btn {
      padding:7px 20px; background:var(--sky); color:#fff; border:none;
      border-radius:var(--r-pill); font-size:.8rem; cursor:pointer;
      font-family:'Newsreader',serif; transition:var(--t);
    }
    .comment-submit-btn:hover { background:var(--sky2); }
    .comment-submit-btn:disabled { opacity:.5; cursor:not-allowed; }
    .comment-list { display:flex; flex-direction:column; gap:10px; }
    .comment-card {
      background:#fff; border:1px solid rgba(186,230,253,.45);
      border-radius:14px; padding:14px 16px; position:relative;
    }
    [data-theme="dark"] .comment-card { background:rgba(15,30,48,.95); border-color:rgba(96,184,232,.18); }
    .comment-card-name { font-weight:700; color:var(--sky-dark); font-size:.8rem; }
