---
const { frontmatter } = Astro.props;
import settings from '../data/settings.json';

const currentPath = Astro.url?.pathname ?? '';
const isNovelPage = frontmatter?.chuong !== undefined && frontmatter?.chuong !== 0;
const currentTruyenId = frontmatter?.truyen_id;

let chapters: any[] = [];
let prevChap: any = null;
let nextChap: any = null;

if (currentTruyenId && isNovelPage) {
  const allPosts = Object.values(import.meta.glob('../pages/**/*.md', { eager: true })) as any[];
  chapters = allPosts
    .filter((p: any) =>
      p.frontmatter?.truyen_id === currentTruyenId &&
      p.frontmatter?.chuong !== undefined &&
      p.frontmatter?.chuong !== 0
    )
    .sort((a: any, b: any) => (a.frontmatter?.chuong ?? 999) - (b.frontmatter?.chuong ?? 999));

  const normPath = (u: string) => u.replace(/\/$/, '').replace(/\/index$/, '');
  const cur = normPath(currentPath);
  const idx = chapters.findIndex((c: any) => {
    const u = normPath(c.url || '');
    return u === cur || cur.endsWith(u);
  });
  if (idx > 0) prevChap = chapters[idx - 1];
  if (idx >= 0 && idx < chapters.length - 1) nextChap = chapters[idx + 1];
}
---
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{frontmatter?.title || 'Trang chủ'} | {settings.site_name}</title>
  <meta name="description" content={frontmatter?.description || settings.tagline} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,600;1,6..72,300;1,6..72,400&family=Literata:ital,opsz,wght@0,7..72,300;0,7..72,400;0,7..72,600&family=Merriweather:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet" />

  <!-- Firebase SDK -->
  <script type="module">
    import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js';
    import { getDatabase, ref, push, onValue, remove, update, get, serverTimestamp }
      from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-database.js';
    import { getAuth, signInWithPopup, GoogleAuthProvider, signOut, onAuthStateChanged }
      from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js';

    const firebaseConfig = {
      apiKey: "AIzaSyBkuHIU0qdS-zNeUFGN7keNGGbAMXvilD0",
      authDomain: "dynamic-duo-comments.firebaseapp.com",
      projectId: "dynamic-duo-comments",
      storageBucket: "dynamic-duo-comments.firebasestorage.app",
      messagingSenderId: "948025586876",
      appId: "1:948025586876:web:848f38701acfdb9b844cb9",
      databaseURL: "https://dynamic-duo-comments-default-rtdb.asia-southeast1.firebasedatabase.app"
    };

    let db = null, auth = null;
    try {
      const app = initializeApp(firebaseConfig);
      db = getDatabase(app);
      auth = getAuth(app);
    } catch(e) {
      console.warn('[DD] Firebase init failed:', e.message);
    }

    // Admin email
    const ADMIN_EMAIL = 'dynamicduoo.q@gmail.com';

    // Expose globally
    window.__ddFirebase = { db, auth, ref, push, onValue, remove, update, get, serverTimestamp, GoogleAuthProvider, signInWithPopup, signOut, onAuthStateChanged, ADMIN_EMAIL };
    window.__ddAdminUid = null;

    // Watch auth state
    if (auth) {
      onAuthStateChanged(auth, (user) => {
        const isAdmin = user && user.email === ADMIN_EMAIL;
        window.__ddAdminUid = isAdmin ? user.uid : null;
        window.__ddAdminEmail = isAdmin ? user.email : null;
        window.dispatchEvent(new CustomEvent('dd-auth-change', { detail: { isAdmin, user } }));
      });
    }

    window.dispatchEvent(new Event('dd-firebase-ready'));
  </script>

  <script is:inline>
    (function(){ const t=localStorage.getItem('dd-theme'); if(t==='dark') document.documentElement.setAttribute('data-theme','dark'); })();
  </script>

  <style is:global>
    /* ─── CSS VARIABLES ─── */
    :root {
      --sky:#0ea5e9; --sky2:#0284c7; --sky-dark:#0369a1;
      --sky-light:#bae6fd; --sky-pale:#f0f9ff;
      --cream:#fafcff; --bg2:#fff;
      --text-main:#1e3a5f; --text-mid:#64748b; --text-dim:#94a3b8;
      --sh-card:0 4px 15px rgba(2,132,199,.12); --sh-soft:0 2px 8px rgba(0,0,0,.08);
      --r-sm:6px; --r-md:12px; --r-lg:20px; --r-pill:999px; --t:all .2s ease;
    }
    [data-theme="dark"] {
      --sky:#60b8e8; --sky2:#89d0f5; --sky-dark:#c8e8f8;
      --sky-light:#1e5a7a; --sky-pale:#0c1e30;
      --cream:#091726; --bg2:#0e2236;
      --text-main:#daeeff; --text-mid:#a0c8e0; --text-dim:#6a9ab5;
    }
    [data-theme="dark"] body { background:#091726; color:#daeeff; }
    [data-theme="dark"] nav { background:rgba(9,23,38,.98); border-color:rgba(96,184,232,.18); }
    [data-theme="dark"] .mobile-menu { background:rgba(9,23,38,.99); border-color:rgba(96,184,232,.2); }
    [data-theme="dark"] .dropdown-content { background:#0e2236; border-color:rgba(96,184,232,.22); }
    [data-theme="dark"] .dd-item { color:#a0c8e0; }
    [data-theme="dark"] .dd-item:hover { background:rgba(96,184,232,.1); color:#daeeff; }
    [data-theme="dark"] .nav-item > a { color:#a0c8e0; }
    [data-theme="dark"] .nav-item > a:hover, [data-theme="dark"] .nav-btn:hover,
    [data-theme="dark"] .nav-item:hover > a, [data-theme="dark"] .nav-item:hover > .nav-btn { color:#60b8e8; background:rgba(96,184,232,.1); }
    [data-theme="dark"] .nav-logo { color:#89d0f5; }
    [data-theme="dark"] .nav-btn { color:#a0c8e0; }
    [data-theme="dark"] .dd-section-title { color:#4a7a96; }
    [data-theme="dark"] .novel-content, [data-theme="dark"] .page-content-wrap { background:rgba(12,24,40,.99); border-color:rgba(96,184,232,.16); color:#daeeff; }
    [data-theme="dark"] .novel-content p { color:#cce4f8; }
    [data-theme="dark"] h1,[data-theme="dark"] h2,[data-theme="dark"] h3,[data-theme="dark"] h4 { color:#89d0f5; }
    [data-theme="dark"] blockquote { background:rgba(14,36,58,.9); color:#a0c8e0; border-left-color:#1e5a7a; }
    [data-theme="dark"] .chap-pn { border-color:#1e5a7a; color:#a0c8e0; }
    [data-theme="dark"] .chap-pn:hover { background:rgba(96,184,232,.1); color:#daeeff; border-color:#60b8e8; }
    [data-theme="dark"] .chap-dd-btn { background:#0c1e30; border-color:#1e5a7a; color:#a0c8e0; }
    [data-theme="dark"] .chap-dd-btn:hover { background:rgba(96,184,232,.12); color:#daeeff; }
    [data-theme="dark"] .chap-dd-list { background:#0e2236; border-color:#1e5a7a; }
    [data-theme="dark"] .chap-dd-list a { color:#a0c8e0; border-color:rgba(96,184,232,.12); }
    [data-theme="dark"] .chap-dd-list a:hover { background:rgba(96,184,232,.1); color:#daeeff; }
    [data-theme="dark"] .chap-dd-list a.cur-chap { background:rgba(96,184,232,.15); color:#89d0f5; font-weight:700; }
    [data-theme="dark"] footer { background:#0e2236; border-color:rgba(96,184,232,.12); color:#a0c8e0; }
    [data-theme="dark"] .ft-logo { color:#89d0f5; }
    [data-theme="dark"] .ft-links a { color:#a0c8e0; }
    [data-theme="dark"] .ft-links a:hover { color:#89d0f5; }
    [data-theme="dark"] .ft-bottom { color:#4a7a96; }
    [data-theme="dark"] .ft-brand p { color:#6a9ab5; }
    [data-theme="dark"] .social-ic { background:rgba(14,36,58,.8); border-color:#1e5a7a; }
    [data-theme="dark"] .tag-badge { color:#89d0f5; border-color:#1e5a7a; }
    [data-theme="dark"] .tag-badge:hover { background:rgba(96,184,232,.1); }
    [data-theme="dark"] .scroll-btn { background:#1a4f6e; }
    [data-theme="dark"] .scroll-btn:hover { background:#215f84; }
    .contact-email { color:#475569; }
    [data-theme="dark"] .contact-email { color:#a0c8e0; }

    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { background:var(--cream); color:var(--text-main); font-family:'Newsreader',serif; font-size:18px; line-height:1.9; margin:0; padding:0; overflow-x:hidden; }
    h1,h2,h3,h4 { font-family:'Merriweather',serif; color:var(--sky-dark); text-align:center; }
    a { color:inherit; text-decoration:none; }
    ::-webkit-scrollbar { width:5px; }
    ::-webkit-scrollbar-track { background:var(--sky-pale); }
    ::-webkit-scrollbar-thumb { background:var(--sky-light); border-radius:3px; }

    /* ─── PROGRESS BAR ─── */
    #read-progress { position:fixed; top:0; left:0; height:3px; z-index:9999; background:linear-gradient(90deg,var(--sky-light),var(--sky),var(--sky2)); width:0%; transition:width .1s linear; pointer-events:none; }

    /* ─── NAVBAR ─── */
    nav { position:fixed; top:0; left:0; right:0; z-index:500; display:flex; align-items:center; justify-content:space-between; height:56px; padding:0 28px; background:rgba(255,255,255,.97); backdrop-filter:blur(16px); border-bottom:1px solid rgba(186,230,253,.5); box-shadow:0 2px 12px rgba(2,132,199,.08); }
    .nav-logo { font-family:'Literata',serif; font-weight:600; font-size:.95rem; color:var(--sky-dark); white-space:nowrap; letter-spacing:.5px; }
    .nav-links { display:flex; align-items:center; gap:2px; }
    .nav-item { position:relative; }
    .nav-item > a, .nav-btn { font-family:'Newsreader',serif; font-size:.76rem; font-weight:400; color:var(--text-mid); letter-spacing:1px; text-transform:uppercase; padding:6px 12px; border-radius:var(--r-pill); display:inline-flex; align-items:center; gap:5px; transition:var(--t); cursor:pointer; background:none; border:none; white-space:nowrap; }
    .nav-item > a:hover, .nav-btn:hover, .nav-item:hover > a, .nav-item:hover > .nav-btn { background:var(--sky-pale); color:var(--sky); }
    .dropdown-content { position:absolute; top:calc(100% + 8px); left:50%; transform:translateX(-50%) translateY(8px); min-width:240px; background:#fff; border:1px solid rgba(186,230,253,.7); border-radius:var(--r-md); box-shadow:0 16px 48px rgba(2,132,199,.13); padding:8px 6px; opacity:0; visibility:hidden; pointer-events:none; transition:opacity .22s ease, transform .22s ease; z-index:600; }
    .nav-item:hover .dropdown-content { opacity:1; visibility:visible; pointer-events:auto; transform:translateX(-50%) translateY(0); }
    .dd-section-title { font-size:.62rem; letter-spacing:2px; text-transform:uppercase; color:var(--text-dim); padding:6px 12px 3px; }
    .dd-item { display:flex; align-items:center; gap:7px; padding:7px 12px; font-size:.82rem; color:var(--text-mid); border-radius:var(--r-sm); transition:var(--t); }
    .dd-item:hover { background:var(--sky-pale); color:var(--sky); }
    .dd-divider { height:1px; background:rgba(186,230,253,.45); margin:5px 8px; }
    .nav-hamburger { display:none; flex-direction:column; gap:5px; cursor:pointer; padding:6px; background:none; border:none; }
    .nav-hamburger span { display:block; width:22px; height:2px; background:var(--sky-dark); border-radius:2px; transition:var(--t); }
    [data-theme="dark"] .nav-hamburger span { background:#89d0f5; }
    .mobile-menu { display:none; position:fixed; top:56px; left:0; right:0; background:rgba(255,255,255,.99); backdrop-filter:blur(16px); border-bottom:1px solid rgba(186,230,253,.5); padding:10px 16px 18px; z-index:490; flex-direction:column; gap:2px; max-height:calc(100vh - 56px); overflow-y:auto; }
    .mobile-menu.open { display:flex; }
    .mobile-menu a { padding:9px 12px; font-size:.88rem; color:var(--text-mid); border-radius:var(--r-sm); display:block; transition:var(--t); }
    .mobile-menu a:hover { background:var(--sky-pale); color:var(--sky); }
    [data-theme="dark"] .mobile-menu a { color:#a0c8e0; }
    [data-theme="dark"] .mobile-menu a:hover { background:rgba(96,184,232,.1); color:#89d0f5; }
    .mobile-section-title { font-size:.65rem; letter-spacing:2px; text-transform:uppercase; color:var(--text-dim); padding:10px 12px 3px; }
    [data-theme="dark"] .mobile-section-title { color:#4a7a96; }
    @media(max-width:700px) { .nav-links{display:none;} .nav-hamburger{display:flex;} }

    /* ─── LAYOUT ─── */
    .page-wrapper { margin-top:56px; min-height:70vh; }
    .page-content-wrap { max-width:820px; margin:32px auto 60px; padding:40px 50px; background:rgba(255,255,255,.98); border-radius:var(--r-lg); box-shadow:var(--sh-soft); border:1px solid rgba(186,230,253,.5); }
    @media(max-width:640px) { .page-content-wrap { padding:24px 18px; margin:16px 12px 40px; } }

    /* ─── NOVEL CONTENT ─── */
    /* Khi sidebar comment mở, thu hẹp nội dung */
    .novel-wrap { transition: margin-right .3s ease; }
    .novel-wrap.sidebar-open { margin-right: 360px; }
    @media(max-width:900px) { .novel-wrap.sidebar-open { margin-right: 0; } }

    .novel-content { max-width:760px; margin:32px auto 60px; padding:40px 50px; background:rgba(255,255,255,.98); border-radius:var(--r-lg); box-shadow:var(--sh-soft); border:1px solid rgba(186,230,253,.5); }
    @media(max-width:640px) { .novel-content { padding:24px 18px; margin:16px 12px 40px; } }
    .novel-content p { text-align:justify; text-justify:inter-word; position:relative; margin-bottom:1.1em; }
    blockquote { font-style:italic; font-size:.9rem; color:var(--text-mid); line-height:1.75; border-left:3px solid var(--sky-light); padding:15px 20px; margin:20px 0; background:var(--sky-pale); border-radius:0 12px 12px 0; }
    hr { border:none; text-align:center; margin:40px 0; }
    hr::after { content:"𓆝 𓆟 𓆞 𓆝 𓆟"; color:var(--sky-light); font-size:20px; letter-spacing:5px; }

    /* ─── TAGS ─── */
    .tag-badge { display:inline-block; padding:4px 12px; border:1.5px solid var(--sky); border-radius:var(--r-pill); font-size:.8rem; margin:3px; color:var(--sky); transition:var(--t); }
    .tag-badge:hover { background:var(--sky-pale); }

    /* ─── CHAPTER NAV ─── */
    .chap-nav-row { display:flex; align-items:center; justify-content:center; gap:10px; margin:22px 0; flex-wrap:wrap; max-width:820px; margin-left:auto; margin-right:auto; padding:0 12px; }
    .chap-pn { display:inline-flex; align-items:center; gap:6px; padding:8px 18px; border:1.5px solid var(--sky-light); border-radius:var(--r-pill); color:var(--sky-dark); font-size:.82rem; font-family:'Newsreader',serif; transition:var(--t); white-space:nowrap; flex-shrink:0; }
    .chap-pn:hover { background:var(--sky-pale); color:var(--sky); border-color:var(--sky); }
    .chap-pn.disabled { opacity:.35; pointer-events:none; }
    .chap-dd-wrap { position:relative; }
    .chap-dd-btn { display:inline-flex; align-items:center; gap:8px; padding:8px 20px; background:var(--sky-pale); border:1.5px solid var(--sky-light); border-radius:var(--r-pill); color:var(--sky-dark); font-size:.83rem; font-family:'Newsreader',serif; font-weight:600; cursor:pointer; transition:var(--t); white-space:nowrap; user-select:none; }
    .chap-dd-btn:hover { background:var(--sky-light); }
    .chap-dd-list { position:absolute; top:calc(100% + 6px); left:50%; transform:translateX(-50%); width:290px; max-height:260px; overflow-y:auto; background:#fff; border:1px solid var(--sky-light); border-radius:var(--r-md); z-index:200; box-shadow:var(--sh-card); display:none; flex-direction:column; }
    .chap-dd-list.open { display:flex; }
    .chap-dd-list a { padding:9px 16px; border-bottom:1px solid rgba(186,230,253,.25); color:var(--text-mid); font-size:.82rem; transition:var(--t); }
    .chap-dd-list a:last-child { border-bottom:none; }
    .chap-dd-list a:hover { background:var(--sky-pale); color:var(--sky); }
    .chap-dd-list a.cur-chap { background:var(--sky-pale); color:var(--sky); font-weight:700; }
    .chap-dd-list.up { bottom:calc(100% + 6px); top:auto; }

    /* ════════════════════════════════
       INLINE COMMENT TRIGGER
    ════════════════════════════════ */
    .ic-trigger {
      display:inline-flex; align-items:center; justify-content:center;
      min-width:22px; height:20px; padding:0 4px;
      border-radius:10px;
      background:var(--sky-pale); border:1px solid var(--sky-light);
      color:var(--sky); font-size:.62rem; cursor:pointer;
      opacity:0; transition:opacity .18s ease;
      vertical-align:middle; margin-left:6px; flex-shrink:0;
      font-family:'Newsreader',serif; font-style:normal;
      line-height:1;
    }
    .novel-content p:hover .ic-trigger { opacity:1; }
    .ic-trigger:hover { background:var(--sky); color:#fff; opacity:1 !important; }
    .ic-trigger.has-comments { opacity:0.8; background:rgba(14,165,233,.1); }
    [data-theme="dark"] .ic-trigger { background:rgba(14,32,52,.9); border-color:rgba(96,184,232,.3); color:#89d0f5; }
    [data-theme="dark"] .ic-trigger:hover { background:#1565a0; color:#e8f6ff; }
    [data-theme="dark"] .ic-trigger.has-comments { background:rgba(21,101,160,.25); }

    /* ════════════════════════════════
       INLINE COMMENT SIDEBAR
    ════════════════════════════════ */
    .ic-sidebar {
      position:fixed;
      right:0; top:56px;
      width:340px;
      height:calc(100vh - 56px);
      background:#fff;
      border-left:1px solid rgba(186,230,253,.6);
      box-shadow:-6px 0 24px rgba(2,132,199,.10);
      z-index:450;
      display:flex; flex-direction:column;
      transform:translateX(100%);
      transition:transform .3s cubic-bezier(.4,0,.2,1);
      overflow:hidden;
    }
    .ic-sidebar.open { transform:translateX(0); }
    [data-theme="dark"] .ic-sidebar { background:#0e2236; border-left-color:rgba(96,184,232,.2); box-shadow:-6px 0 24px rgba(0,0,0,.4); }

    @media(max-width:900px) {
      .ic-sidebar { width:100%; top:auto; bottom:0; height:65vh; transform:translateY(100%); border-left:none; border-top:1px solid rgba(186,230,253,.5); border-radius:20px 20px 0 0; }
      .ic-sidebar.open { transform:translateY(0); }
      [data-theme="dark"] .ic-sidebar { border-top-color:rgba(96,184,232,.2); }
    }

    .ic-sidebar-header {
      display:flex; align-items:center; justify-content:space-between;
      padding:14px 16px 12px;
      border-bottom:1px solid rgba(186,230,253,.4);
      flex-shrink:0;
    }
    [data-theme="dark"] .ic-sidebar-header { border-bottom-color:rgba(96,184,232,.15); }
    .ic-sidebar-title { font-family:'Merriweather',serif; font-size:.8rem; color:var(--sky-dark); letter-spacing:1px; }
    [data-theme="dark"] .ic-sidebar-title { color:#89d0f5; }
    .ic-sidebar-para { font-size:.68rem; color:var(--text-dim); font-style:italic; margin-top:2px; }
    [data-theme="dark"] .ic-sidebar-para { color:#6a9ab5; }
    .ic-sidebar-close {
      background:none; border:none; cursor:pointer;
      color:var(--text-dim); font-size:1rem; padding:4px 8px;
      border-radius:var(--r-sm); transition:var(--t);
    }
    .ic-sidebar-close:hover { background:var(--sky-pale); color:var(--sky); }
    [data-theme="dark"] .ic-sidebar-close:hover { background:rgba(96,184,232,.1); color:#89d0f5; }

    .ic-sidebar-list {
      flex:1; overflow-y:auto; padding:12px 14px;
      display:flex; flex-direction:column; gap:8px;
      scrollbar-width:thin; scrollbar-color:var(--sky-light) transparent;
    }
    .ic-sidebar-list::-webkit-scrollbar { width:3px; }
    .ic-sidebar-list::-webkit-scrollbar-thumb { background:var(--sky-light); border-radius:3px; }

    .ic-cmt-item {
      background:var(--sky-pale); border-radius:12px; padding:10px 12px;
      font-size:.78rem; color:var(--text-main); line-height:1.55; position:relative;
      border:1px solid rgba(186,230,253,.4);
    }
    [data-theme="dark"] .ic-cmt-item { background:rgba(21,50,80,.5); border-color:rgba(96,184,232,.15); color:#cce4f8; }
    .ic-cmt-header { display:flex; align-items:center; gap:6px; margin-bottom:5px; }
    .ic-cmt-name { font-weight:700; font-size:.72rem; color:var(--sky-dark); }
    [data-theme="dark"] .ic-cmt-name { color:#89d0f5; }
    .ic-cmt-time { font-size:.62rem; color:var(--text-dim); margin-left:auto; }
    [data-theme="dark"] .ic-cmt-time { color:#6a9ab5; }
    .ic-cmt-del {
      position:absolute; top:8px; right:8px;
      background:none; border:none; cursor:pointer;
      font-size:.6rem; color:var(--text-dim); opacity:0;
      transition:opacity .15s, color .15s; padding:2px 5px; border-radius:4px;
    }
    .ic-cmt-item:hover .ic-cmt-del { opacity:1; }
    .ic-cmt-del:hover { color:#ef4444; background:rgba(239,68,68,.08); }

    .ic-sidebar-form { padding:12px 14px; border-top:1px solid rgba(186,230,253,.35); flex-shrink:0; }
    [data-theme="dark"] .ic-sidebar-form { border-top-color:rgba(96,184,232,.15); }
    .ic-form-name {
      width:100%; padding:7px 12px; border:1.5px solid var(--sky-light);
      border-radius:var(--r-pill); font-size:.75rem; font-family:'Newsreader',serif;
      color:var(--text-main); background:var(--cream); outline:none;
      margin-bottom:7px;
    }
    .ic-form-name:focus { border-color:var(--sky); }
    [data-theme="dark"] .ic-form-name { background:#091726; border-color:#1e5a7a; color:#daeeff; }
    [data-theme="dark"] .ic-form-name::placeholder { color:#4a7a96; }
