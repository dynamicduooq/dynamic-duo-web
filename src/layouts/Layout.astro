    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,600;1,6..72,300;1,6..72,400&family=Literata:ital,opsz,wght@0,7..72,300;0,7..72,400;0,7..72,600;1,7..72,300;1,7..72,400&family=Merriweather:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet">
    
    <style is:global>
        :root {
            --sky: #0ea5e9;
            --sky2: #0284c7;
            --sky-dark: #0369a1;
            --sky-light: #bae6fd;
            --sky-pale: #f0f9ff;
            --cream: #fafcff;
            --bg-content: #ffffff;
            --text-main: #334155;
            --text-mid: #64748b;
            --text-dim: #94a3b8;
            --sh-card: 0 4px 15px rgba(2,132,199,0.12);
            --sh-soft: 0 2px 8px rgba(0,0,0,0.08);
            --r-sm: 6px;
            --r-md: 12px;
            --r-lg: 18px;
            --r-pill: 999px;
            --t: all 0.2s ease;
        }

        * { box-sizing: border-box; }

        body {
            background: var(--cream);
            color: var(--text-main);
            font-family: 'Newsreader', serif;
            font-size: 18px;
            line-height: 1.9;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        h1, h2, h3, h4 { font-family: 'Merriweather', serif; color: var(--sky-dark); text-align: center; }
        a { color: inherit; text-decoration: none; }

        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: var(--sky-pale); }
        ::-webkit-scrollbar-thumb { background: var(--sky-light); border-radius: 3px; }

        /* ── TICKER ── */
        .ticker-wrap {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 700;
            height: 28px;
            background: linear-gradient(90deg, #e0f2fe 0%, #f0f9ff 50%, #e0f2fe 100%);
            border-bottom: 1px solid rgba(186,230,253,.8);
            overflow: hidden;
            display: flex;
            align-items: center;
        }
        .ticker-track {
            display: flex;
            width: max-content;
            animation: ticker-scroll 45s linear infinite;
            will-change: transform;
        }
        .ticker-wrap:hover .ticker-track { animation-play-state: paused; }
        .ticker-msg {
            white-space: nowrap;
            padding: 0 48px;
            font-size: .72rem;
            letter-spacing: .5px;
            color: var(--sky-dark);
            font-family: 'Newsreader', serif;
        }
        @keyframes ticker-scroll {
            0%   { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        /* ── NAVBAR ── */
        nav {
            position: fixed;
            top: 28px; left: 0; right: 0;
            z-index: 500;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 56px;
            padding: 0 28px;
            background: rgba(255,255,255,.95);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(186,230,253,.5);
            box-shadow: 0 2px 12px rgba(2,132,199,.08);
        }
        .nav-logo { font-family: 'Literata', serif; font-weight: 600; font-size: .95rem; color: var(--sky-dark); white-space: nowrap; letter-spacing: .5px; }
        .nav-links { display: flex; align-items: center; gap: 2px; }
        .nav-item { position: relative; }
        .nav-item > a, .nav-btn {
            font-family: 'Newsreader', serif; font-size: .76rem; font-weight: 400;
            color: var(--text-mid); letter-spacing: 1px; text-transform: uppercase;
            padding: 6px 12px; border-radius: var(--r-pill); display: inline-flex; align-items: center; gap: 5px;
            transition: var(--t); cursor: pointer; background: none; border: none; white-space: nowrap;
        }
        .nav-item > a:hover, .nav-btn:hover, .nav-item:hover > a, .nav-item:hover > .nav-btn { background: var(--sky-pale); color: var(--sky); }

        .dropdown-content {
            position: absolute; top: calc(100% + 8px); left: 50%; transform: translateX(-50%) translateY(8px);
            min-width: 230px; background: #fff; border: 1px solid rgba(186,230,253,.7); border-radius: var(--r-md);
            box-shadow: 0 16px 48px rgba(2,132,199,.13), 0 2px 8px rgba(2,132,199,.06); padding: 8px 6px;
            opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .22s ease, transform .22s ease; z-index: 600;
        }
        .nav-item:hover .dropdown-content { opacity: 1; visibility: visible; pointer-events: auto; transform: translateX(-50%) translateY(0); }
        .dd-section-title { font-size: .62rem; letter-spacing: 2px; text-transform: uppercase; color: var(--text-dim); padding: 6px 12px 3px; }
        .dd-item { display: flex; align-items: center; gap: 7px; padding: 7px 12px; font-size: .82rem; color: var(--text-mid); border-radius: var(--r-sm); transition: var(--t); }
        .dd-item:hover { background: var(--sky-pale); color: var(--sky); }
        .dd-divider { height: 1px; background: rgba(186,230,253,.45); margin: 5px 8px; }

        /* ── LAYOUT ── */
        .page-wrapper { margin-top: 104px; min-height: 70vh; }
        .container {
            max-width: 800px; margin: 0 auto 60px;
            background-color: rgba(255,255,255,.98);
            padding: 40px 50px; border-radius: var(--r-lg);
            box-shadow: var(--sh-soft); border: 1px solid rgba(186,230,253,.5);
        }

        blockquote { font-style: italic; font-size: .9rem; color: var(--text-mid); line-height: 1.75; border-left: 3px solid var(--sky-light); padding: 15px 20px; margin: 20px 0; background: var(--sky-pale); border-radius: 0 12px 12px 0; }
        hr { border: none; text-align: center; margin: 40px 0; }
        hr::after { content: "𓆝 𓆟 𓆞 𓆝 𓆟"; color: var(--sky-light); font-size: 20px; letter-spacing: 5px; }

        .tag-badge { display: inline-block; padding: 4px 12px; border: 1.5px solid var(--sky); border-radius: var(--r-pill); font-size: 0.85rem; margin: 4px; color: var(--sky); transition: var(--t); }
        .tag-badge:hover { background: var(--sky-pale); }

        .chapter-dropdown summary { display: block; padding: 12px 20px; background: var(--sky-pale); border: 1.5px solid var(--sky-light); border-radius: var(--r-pill); color: var(--sky-dark); font-size: 14px; font-weight: bold; cursor: pointer; max-width: 200px; margin: 0 auto; text-align: center; list-style: none; transition: var(--t); }
        .chapter-dropdown summary:hover { background: var(--sky-light); color: white; }
        .chapter-dropdown { position: relative; display: inline-block; }
        .chapter-list { position: absolute; top: 115%; left: 50%; transform: translateX(-50%); width: 250px; max-height: 250px; overflow: auto; background: var(--bg-content); border: 1px solid var(--sky-light); border-radius: var(--r-md); display: flex; flex-direction: column; z-index: 10; box-shadow: var(--sh-card); }
        .chapter-list a { padding: 12px 10px; border-bottom: 1px dashed var(--sky-pale); color: var(--text-mid); text-align: center; font-size: 14px; transition: var(--t); }
        .chapter-list a:hover { background: var(--sky-pale); color: var(--sky); }

        /* ── FOOTER ── */
        footer { background: #fff; border-top: 1px solid rgba(186,230,253,.4); padding: 44px 20px 26px; margin-top: auto; }
        .footer-inner { max-width: 1120px; margin: 0 auto; display: grid; grid-template-columns: 1fr auto 1fr; gap: 28px; align-items: start; }
        .ft-brand .ft-logo { font-family: 'Literata', serif; font-size: 1.15rem; font-weight: 600; color: var(--sky-dark); display: block; margin-bottom: 5px; }
        .ft-brand p { font-size: .78rem; color: var(--text-dim); font-style: italic; }
        .ft-links { display: flex; flex-direction: column; gap: 7px; align-items: center; }
        .ft-links a { font-size: .76rem; color: var(--text-mid); letter-spacing: 1px; text-transform: uppercase; transition: var(--t); }
        .ft-links a:hover { color: var(--sky); }
        .ft-social { display: flex; flex-direction: column; gap: 7px; align-items: flex-end; }
        .social-ic { width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--sky-light); display: flex; align-items: center; justify-content: center; font-size: .88rem; color: var(--sky); background: var(--sky-pale); transition: var(--t); }
        .social-ic:hover { background: var(--sky-light); transform: translateY(-2px); }
        .ft-bottom { max-width: 1120px; margin: 26px auto 0; padding-top: 16px; border-top: 1px solid rgba(186,230,253,.3); text-align: center; font-size: .7rem; color: var(--text-dim); letter-spacing: 1px; }

        /* ── SCROLL BUTTONS (fix cứng, luôn hoạt động) ── */
        .scroll-btns {
            position: fixed;
            right: 22px;
            bottom: 24px;
            z-index: 400;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .scroll-btn {
            width: 40px; height: 40px;
            border-radius: 50%;
            background: var(--sky);
            color: #fff;
            border: none;
            cursor: pointer;
            font-size: 1rem;
            box-shadow: var(--sh-card);
            transition: var(--t);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transform: translateY(8px);
        }
        .scroll-btn.show {
            opacity: 1;
            pointer-events: auto;
            transform: translateY(0);
        }
        .scroll-btn:hover { background: var(--sky2); transform: translateY(-2px) !important; }
        #btnTop  { font-size: .9rem; }
        #btnBot  { font-size: .9rem; }

        /* ── INLINE COMMENT ── */
        .ic-btn {
            display: inline-flex; align-items: center; justify-content: center;
            width: 20px; height: 20px; border-radius: 50%;
            background: var(--sky-pale); border: 1.5px solid var(--sky-light);
            color: var(--sky); font-size: .62rem; cursor: pointer;
            vertical-align: middle; margin-left: 6px;
            transition: var(--t); user-select: none;
            flex-shrink: 0;
        }
        .ic-btn:hover { background: var(--sky-light); color: #fff; }

        .ic-popup {
            position: absolute;
            z-index: 800;
            width: 290px;
            background: #fff;
            border: 1px solid rgba(186,230,253,.8);
            border-radius: 14px;
            box-shadow: 0 12px 36px rgba(2,132,199,.16), 0 2px 8px rgba(0,0,0,.06);
            padding: 14px 16px;
            display: none;
        }
        .ic-popup.open { display: block; }
        .ic-popup-header { font-size: .7rem; letter-spacing: 1.2px; text-transform: uppercase; color: var(--text-dim); margin-bottom: 8px; }
        .ic-comment-list { max-height: 160px; overflow-y: auto; margin-bottom: 10px; }
        .ic-comment-item { font-size: .82rem; color: var(--text-mid); border-bottom: 1px dashed var(--sky-pale); padding: 6px 0; line-height: 1.5; }
        .ic-comment-item .ic-name { font-weight: 600; color: var(--sky-dark); font-size: .78rem; }
        .ic-empty { font-size: .8rem; font-style: italic; color: var(--text-dim); text-align: center; padding: 10px 0; }
        .ic-name-row { margin-bottom: 6px; }
        .ic-name-row input,
        .ic-input-row input {
            width: 100%; border: 1px solid var(--sky-light); border-radius: var(--r-pill);
            padding: 6px 12px; font-size: .82rem; font-family: 'Newsreader', serif;
            color: var(--text-mid); outline: none; background: var(--sky-pale);
            box-sizing: border-box;
        }
        .ic-name-row input:focus, .ic-input-row input:focus { border-color: var(--sky); }
        .ic-input-row { display: flex; gap: 6px; }
        .ic-input-row input { flex: 1; }
        .ic-input-row button {
            padding: 6px 14px; background: var(--sky); color: #fff;
            border: none; border-radius: var(--r-pill); font-size: .8rem; cursor: pointer;
            transition: var(--t); white-space: nowrap;
        }
        .ic-input-row button:hover { background: var(--sky2); }
    </style>
</head>
