---
const { frontmatter } = Astro.props;
import settings from '../data/settings.json';

const currentPath = Astro.url?.pathname ?? '';
let currentTruyenId = frontmatter?.truyen_id;

let chapters = [];
if (currentTruyenId) {
    const allPosts = Object.values(import.meta.glob('../pages/**/*.md', { eager: true }));
    chapters = allPosts
        .filter(post => {
            const postTruyenId = post.frontmatter?.truyen_id;
            return postTruyenId === currentTruyenId;
        })
        .sort((a, b) => {
            const parseChapter = (post) => {
                if (post.frontmatter?.chuong !== undefined) return post.frontmatter.chuong;
                const match = (post.url || '').match(/chuong-(\d+)/i);
                return match ? parseInt(match[1]) : (post.url?.includes('index') ? 0 : 999);
            };
            return parseChapter(a) - parseChapter(b);
        });
}

const isNovelPage = frontmatter?.chuong !== undefined;

// Tính chương trước / sau
let prevChapter = null;
let nextChapter = null;
if (isNovelPage && chapters.length > 0) {
    const idx = chapters.findIndex(c => c.url === currentPath);
    if (idx > 0) prevChapter = chapters[idx - 1];
    if (idx < chapters.length - 1) nextChapter = chapters[idx + 1];
}
---

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{frontmatter?.title || 'Trang chủ'} | {settings.site_name}</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,600;1,6..72,300;1,6..72,400&family=Literata:ital,opsz,wght@0,7..72,300;0,7..72,400;0,7..72,600;1,7..72,300;1,7..72,400&family=Merriweather:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet">
    
    <style is:global>
        /* ══════════════════════════════════════════
           CSS VARIABLES — LIGHT & DARK
        ══════════════════════════════════════════ */
        :root {
            --sky: #0ea5e9;
            --sky2: #0284c7;
            --sky-dark: #0369a1;
            --sky-light: #bae6fd;
            --sky-pale: #f0f9ff;

            /* Light mode */
            --bg: #f8fafc;
            --bg-content: #ffffff;
            --bg-sidebar: #ffffff;
            --text-main: #1e293b;
            --text-mid: #475569;
            --text-dim: #94a3b8;
            --border: rgba(186,230,253,.55);
            --nav-bg: rgba(255,255,255,.96);

            --sh-card: 0 4px 15px rgba(2,132,199,0.12);
            --sh-soft: 0 2px 8px rgba(0,0,0,0.07);
            --r-sm: 8px;
            --r-md: 12px;
            --r-lg: 18px;
            --r-pill: 999px;
            --t: all 0.2s ease;
        }

        /* ── DARK MODE ── */
        body.dark-mode {
            --bg: #0d1117;
            --bg-content: #161b22;
            --bg-sidebar: #161b22;
            --text-main: #e6edf3;
            --text-mid: #b0bec5;
            --text-dim: #6e7f8d;
            --border: rgba(56,139,253,.25);
            --nav-bg: rgba(13,17,23,.97);
            --sky: #58b6ff;
            --sky2: #79c8ff;
            --sky-dark: #a8d8ff;
            --sky-light: #1d3a5f;
            --sky-pale: #0d1e30;
            --sh-card: 0 4px 20px rgba(0,0,0,.5);
            --sh-soft: 0 2px 12px rgba(0,0,0,.4);
        }

        /* ══════════════════════════════════════════
           BASE
        ══════════════════════════════════════════ */
        *, *::before, *::after { box-sizing: border-box; }

        body {
            background: var(--bg);
            color: var(--text-main);
            font-family: 'Newsreader', serif;
            font-size: 18px;
            line-height: 1.9;
            margin: 0; padding: 0;
            overflow-x: hidden;
            transition: background .3s ease, color .3s ease;
        }

        h1, h2, h3, h4 {
            font-family: 'Merriweather', serif;
            color: var(--sky-dark);
            text-align: center;
        }
        a { color: inherit; text-decoration: none; }

        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: var(--sky-pale); }
        ::-webkit-scrollbar-thumb { background: var(--sky-light); border-radius: 3px; }

        /* ══════════════════════════════════════════
           NAVBAR
        ══════════════════════════════════════════ */
        nav {
            position: fixed; top: 0; left: 0; right: 0; z-index: 500;
            display: flex; align-items: center; justify-content: space-between;
            height: 56px; padding: 0 28px;
            background: var(--nav-bg);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
            box-shadow: var(--sh-soft);
        }
        .nav-logo {
            font-family: 'Literata', serif; font-weight: 600; font-size: .95rem;
            color: var(--sky-dark); white-space: nowrap; letter-spacing: .5px;
        }
        .nav-links { display: flex; align-items: center; gap: 2px; }
        .nav-item { position: relative; }
        .nav-item > a, .nav-btn {
            font-family: 'Newsreader', serif; font-size: .76rem; font-weight: 400;
            color: var(--text-mid); letter-spacing: 1px; text-transform: uppercase;
            padding: 6px 12px; border-radius: var(--r-pill);
            display: inline-flex; align-items: center; gap: 5px;
            transition: var(--t); cursor: pointer; background: none; border: none; white-space: nowrap;
        }
        .nav-item > a:hover, .nav-btn:hover,
        .nav-item:hover > a, .nav-item:hover > .nav-btn { background: var(--sky-pale); color: var(--sky); }

        /* Dropdown */
        .dropdown-content {
            position: absolute; top: calc(100% + 8px); left: 50%;
            transform: translateX(-50%) translateY(8px);
            min-width: 230px; background: var(--bg-content);
            border: 1px solid var(--border); border-radius: var(--r-md);
            box-shadow: var(--sh-card); padding: 8px 6px;
            opacity: 0; visibility: hidden; pointer-events: none;
            transition: opacity .22s ease, transform .22s ease; z-index: 600;
        }
        .nav-item:hover .dropdown-content {
            opacity: 1; visibility: visible; pointer-events: auto;
            transform: translateX(-50%) translateY(0);
        }
        .dd-section-title { font-size: .62rem; letter-spacing: 2px; text-transform: uppercase; color: var(--text-dim); padding: 6px 12px 3px; }
        .dd-item { display: flex; align-items: center; gap: 7px; padding: 7px 12px; font-size: .82rem; color: var(--text-mid); border-radius: var(--r-sm); transition: var(--t); }
        .dd-item:hover { background: var(--sky-pale); color: var(--sky); }
        .dd-divider { height: 1px; background: var(--border); margin: 5px 8px; }

        /* Nút Dark Mode */
        .theme-btn {
            margin-left: 10px; width: 36px; height: 36px; border-radius: 50%;
            border: 1.5px solid var(--border); background: var(--sky-pale);
            cursor: pointer; display: flex; align-items: center; justify-content: center;
            font-size: 1rem; transition: var(--t); color: var(--text-mid);
        }
        .theme-btn:hover { background: var(--sky-light); color: #fff; transform: rotate(20deg); }

        /* ══════════════════════════════════════════
           LAYOUT CHÍNH — MỞ RỘNG WIDTH
        ══════════════════════════════════════════ */
        .page-wrapper { margin-top: 72px; min-height: 70vh; }

        /* Container cho trang chương truyện (đọc truyện) */
        .container {
            max-width: 860px; margin: 0 auto 60px;
            background: var(--bg-content);
            padding: 44px 56px; border-radius: var(--r-lg);
            box-shadow: var(--sh-soft); border: 1px solid var(--border);
        }

        /* Căn chính giữa tiêu đề, justify nội dung */
        .container h1, .container h2, .container h3 { text-align: center; }
        .container p { text-align: justify; }

        /* ══════════════════════════════════════════
           CHAPTER NAV (Trước / Sau)
        ══════════════════════════════════════════ */
        .chapter-nav-bar {
            display: flex; align-items: center; justify-content: space-between;
            gap: 12px; margin: 32px 0 8px;
            padding: 0 4px;
        }
        .chapter-nav-bar .cnav-btn {
            flex: 1; max-width: 240px; display: flex; align-items: center; gap: 8px;
            padding: 10px 18px; border-radius: var(--r-pill);
            border: 1.5px solid var(--border); background: var(--bg-content);
            color: var(--sky-dark); font-family: 'Newsreader', serif;
            font-size: .82rem; font-weight: 600; cursor: pointer;
            transition: var(--t); text-decoration: none;
        }
        .chapter-nav-bar .cnav-btn:hover { background: var(--sky-pale); border-color: var(--sky); color: var(--sky); }
        .chapter-nav-bar .cnav-btn.next { justify-content: flex-end; text-align: right; margin-left: auto; }
        .chapter-nav-bar .cnav-btn.prev { justify-content: flex-start; text-align: left; }
        .chapter-nav-bar .cnav-btn .cnav-label { font-size: .65rem; color: var(--text-dim); display: block; letter-spacing: 1px; text-transform: uppercase; }
        .chapter-nav-bar .cnav-btn .cnav-title { display: block; line-height: 1.3; }
        .chapter-nav-bar .cnav-middle { flex: 0 0 auto; }

        /* ══════════════════════════════════════════
           CHAPTER DROPDOWN
        ══════════════════════════════════════════ */
        .chapter-dropdown { position: relative; display: inline-block; }
        .chapter-dropdown summary {
            display: block; padding: 10px 20px;
            background: var(--sky-pale); border: 1.5px solid var(--border);
            border-radius: var(--r-pill); color: var(--sky-dark);
            font-size: 13px; font-weight: bold; cursor: pointer;
            list-style: none; transition: var(--t); white-space: nowrap;
        }
        .chapter-dropdown summary:hover { background: var(--sky-light); color: #fff; border-color: var(--sky-light); }
        .chapter-list {
            position: absolute; top: 115%; left: 50%; transform: translateX(-50%);
            width: 260px; max-height: 280px; overflow: auto;
            background: var(--bg-content); border: 1px solid var(--border);
            border-radius: var(--r-md); display: flex; flex-direction: column;
            z-index: 10; box-shadow: var(--sh-card);
        }
        .chapter-list a {
            padding: 11px 14px; border-bottom: 1px dashed var(--sky-pale);
            color: var(--text-mid); text-align: center; font-size: 13px; transition: var(--t);
        }
        .chapter-list a:hover { background: var(--sky-pale); color: var(--sky); }

        /* ══════════════════════════════════════════
           MARKDOWN CONTENT
        ══════════════════════════════════════════ */
        blockquote {
            font-style: italic; font-size: .9rem; color: var(--text-mid);
            line-height: 1.75; border-left: 3px solid var(--sky-light);
            padding: 15px 20px; margin: 20px 0;
            background: var(--sky-pale); border-radius: 0 12px 12px 0;
        }
        hr { border: none; text-align: center; margin: 40px 0; }
        hr::after { content: "𓆝 𓆟 𓆞 𓆝 𓆟"; color: var(--sky-light); font-size: 20px; letter-spacing: 5px; }

        .tag-badge {
            display: inline-block; padding: 4px 12px;
            border: 1.5px solid var(--sky); border-radius: var(--r-pill);
            font-size: .82rem; margin: 3px; color: var(--sky); transition: var(--t);
        }
        .tag-badge:hover { background: var(--sky-pale); }

        /* ══════════════════════════════════════════
           FOOTER
        ══════════════════════════════════════════ */
        footer {
            background: var(--bg-content);
            border-top: 1px solid var(--border);
            padding: 44px 20px 26px; margin-top: auto;
        }
        .footer-inner {
            max-width: 94vw; margin: 0 auto;
            display: grid; grid-template-columns: 1fr auto 1fr;
            gap: 28px; align-items: start;
        }
        .ft-brand .ft-logo { font-family: 'Literata', serif; font-size: 1.15rem; font-weight: 600; color: var(--sky-dark); display: block; margin-bottom: 5px; }
        .ft-brand p { font-size: .78rem; color: var(--text-dim); font-style: italic; }
        .ft-links { display: flex; flex-direction: column; gap: 7px; align-items: center; }
        .ft-links a { font-size: .76rem; color: var(--text-mid); letter-spacing: 1px; text-transform: uppercase; transition: var(--t); }
        .ft-links a:hover { color: var(--sky); }
        .ft-social { display: flex; flex-direction: column; gap: 7px; align-items: flex-end; }
        .social-ic { width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--sky-light); display: flex; align-items: center; justify-content: center; font-size: .88rem; color: var(--sky); background: var(--sky-pale); transition: var(--t); }
        .social-ic:hover { background: var(--sky-light); transform: translateY(-2px); }
        .ft-bottom { max-width: 1120px; margin: 26px auto 0; padding-top: 16px; border-top: 1px solid var(--border); text-align: center; font-size: .7rem; color: var(--text-dim); letter-spacing: 1px; }

        /* Back to top */
        .back-top {
            position: fixed; bottom: 24px; right: 22px; z-index: 300;
            width: 40px; height: 40px; border-radius: 50%;
            background: var(--sky); color: #fff; border: none;
            cursor: pointer; font-size: 1rem; box-shadow: var(--sh-card);
            opacity: 0; pointer-events: none; transition: var(--t);
            display: flex; align-items: center; justify-content: center;
        }
        .back-top.show { opacity: 1; pointer-events: auto; }
        .back-top:hover { transform: translateY(-3px); background: var(--sky2); }

        /* ══════════════════════════════════════════
           GISCUS COMMENT WRAPPER
           (reply natively supported by giscus)
        ══════════════════════════════════════════ */
        .comment-section {
            margin-top: 60px;
            border-top: 1px dashed var(--sky-light);
            padding-top: 30px;
        }
        .comment-section-title {
            font-family: 'Merriweather', serif;
            font-size: 1rem; color: var(--sky-dark);
            text-align: center; margin-bottom: 20px;
            letter-spacing: .5px;
        }

        /* Override giscus iframe chiều rộng */
        .giscus, .giscus-frame {
            width: 100% !important;
        }
    </style>
</head>
<body>
    <nav id="navbar">
        <a class="nav-logo" href="/dynamic-duo-web/">dynamic duo 𓆝.°•</a>
        
        <div class="nav-links">
            <div class="nav-item">
                <a href="/dynamic-duo-web/">Trang chủ</a>
            </div>
            <div class="nav-item">
                <button class="nav-btn">Cá dưới nước <span>▾</span></button>
                <div class="dropdown-content">
                    <div class="dd-section-title">Trang mục</div>
                    <a href="/dynamic-duo-web/ca-duoi-nuoc" class="dd-item">🐠 Tất cả truyện</a>
                    <div class="dd-divider"></div>
                    <div class="dd-section-title">Truyện</div>
                    <a href="/dynamic-duo-web/ca-duoi-nuoc/quan-he-ban-cung-phong" class="dd-item">✦ Quan hệ bạn cùng phòng</a>
                    <a href="/dynamic-duo-web/ca-duoi-nuoc/ha-chay-dong-hoang" class="dd-item">✦ Hạ cháy đồng hoang</a>
                </div>
            </div>
            <div class="nav-item">
                <button class="nav-btn">Cá trên bàn <span>▾</span></button>
                <div class="dropdown-content">
                    <div class="dd-section-title">Trang mục</div>
                    <a href="/dynamic-duo-web/ca-tren-ban" class="dd-item">🍽️ Tất cả truyện</a>
                    <div class="dd-divider"></div>
                    <div class="dd-section-title">Truyện</div>
                    <a href="/dynamic-duo-web/ca-tren-ban/neu-dem-nay-troi-khong-mua" class="dd-item">✦ Nếu đêm nay trời không mưa</a>
                    <a href="/dynamic-duo-web/ca-tren-ban/toi-nghi-chung-toi-sap-chia-tay" class="dd-item">✦ Tôi nghĩ chúng tôi sắp chia tay</a>
                </div>
            </div>
            <div class="nav-item">
                <a href="/dynamic-duo-web/ca-tren-troi">Cá trên trời</a>
            </div>

            <button class="theme-btn" id="themeToggle" title="Đổi giao diện" aria-label="Toggle dark mode">🌙</button>
        </div>
    </nav>

    <div class="page-wrapper">
        <div class="container">
            {frontmatter?.tags && (
                <div style="text-align: center; margin-bottom: 25px;">
                    {frontmatter.tags.map(tag => (
                        <a href={`/dynamic-duo-web/tags/${tag}`} class="tag-badge"># {tag}</a>
                    ))}
                </div>
            )}

            {/* Dropdown chọn chương — trên nội dung */}
            {isNovelPage && chapters.length > 0 && (
                <div style="text-align: center; margin-bottom: 30px; position: relative;">
                    <details class="chapter-dropdown">
                        <summary>⚓ Chọn chương ▾</summary>
                        <div class="chapter-list">
                            {chapters.map((chap) => (
                                <a href={chap.url}>{chap.frontmatter.title}</a>
                            ))}
                        </div>
                    </details>
                </div>
            )}

            {/* Nút chương trước / sau — trên nội dung */}
            {isNovelPage && (prevChapter || nextChapter) && (
                <div class="chapter-nav-bar">
                    {prevChapter ? (
                        <a href={prevChapter.url} class="cnav-btn prev">
                            <span>←</span>
                            <span>
                                <span class="cnav-label">Chương trước</span>
                                <span class="cnav-title">{prevChapter.frontmatter.title}</span>
                            </span>
                        </a>
                    ) : <span />}
                    {nextChapter ? (
                        <a href={nextChapter.url} class="cnav-btn next">
                            <span>
                                <span class="cnav-label">Chương sau</span>
                                <span class="cnav-title">{nextChapter.frontmatter.title}</span>
                            </span>
                            <span>→</span>
                        </a>
                    ) : <span />}
                </div>
            )}

            <slot />

            {/* Dropdown + nav — dưới nội dung */}
            {isNovelPage && chapters.length > 0 && (
                <div style="text-align: center; margin-top: 40px; position: relative;">
                    <details class="chapter-dropdown">
                        <summary>⚓ Chọn chương ▾</summary>
                        <div class="chapter-list">
                            {chapters.map((chap) => (
                                <a href={chap.url}>{chap.frontmatter.title}</a>
                            ))}
                        </div>
                    </details>
                </div>
            )}

            {isNovelPage && (prevChapter || nextChapter) && (
                <div class="chapter-nav-bar" style="margin-top: 24px;">
                    {prevChapter ? (
                        <a href={prevChapter.url} class="cnav-btn prev">
                            <span>←</span>
                            <span>
                                <span class="cnav-label">Chương trước</span>
                                <span class="cnav-title">{prevChapter.frontmatter.title}</span>
                            </span>
                        </a>
                    ) : <span />}
                    {nextChapter ? (
                        <a href={nextChapter.url} class="cnav-btn next">
                            <span>
                                <span class="cnav-label">Chương sau</span>
                                <span class="cnav-title">{nextChapter.frontmatter.title}</span>
                            </span>
                            <span>→</span>
                        </a>
                    ) : <span />}
                </div>
            )}

            {/* Giscus comment — hỗ trợ reply natively */}
            {isNovelPage && (
                <div class="comment-section">
                    <div class="comment-section-title">𓆝 Bình luận</div>
                    <script src="https://giscus.app/client.js"
                            data-repo="dynamicduooq/dynamic-duo-web"
                            data-repo-id="R_kgDOSn8PYg"
                            data-category="Announcements"
                            data-category-id="DIC_kwDOSn8PYs4C923K"
                            data-mapping="pathname"
                            data-strict="0"
                            data-reactions-enabled="1"
                            data-emit-metadata="0"
                            data-input-position="top"
                            data-theme="light"
                            data-lang="vi"
                            crossorigin="anonymous"
                            async>
                    </script>
                </div>
            )}
        </div>
    </div>

    <footer>
        <div class="footer-inner">
            <div class="ft-brand">
                <span class="ft-logo">dynamic duo 𓆝.°•</span>
                <p>paired dreams, boundless gleam.</p>
                <p style="margin-top:5px;font-size:.74rem">✉ dynamicduoq@gmail.com</p>
            </div>
            <div class="ft-links">
                <a href="/dynamic-duo-web/">Trang chủ</a>
                <a href="/dynamic-duo-web/ca-duoi-nuoc">Cá dưới nước</a>
                <a href="/dynamic-duo-web/ca-tren-ban">Cá trên bàn</a>
            </div>
            <div class="ft-social">
                <p style="font-size:.68rem;color:var(--text-dim);letter-spacing:1px;text-transform:uppercase;margin-bottom:6px">Ghé thăm</p>
                <a href="https://dynamicduoq.wordpress.com" target="_blank" class="social-ic" title="WordPress">🌐</a>
            </div>
        </div>
        <div class="ft-bottom">dynamic duo 𓆝.°• · made with 🌊 by Xê &amp; Gờ · 2026</div>
    </footer>

    <button class="back-top" id="backTop" onclick="scrollTo({top:0,behavior:'smooth'})">↑</button>

    <script is:inline>
        /* ── Back to top ── */
        window.addEventListener('scroll', () => {
            document.getElementById('backTop').classList.toggle('show', scrollY > 300);
        });

        /* ── Dark mode toggle ── */
        (function() {
            const btn = document.getElementById('themeToggle');
            const saved = localStorage.getItem('dd-theme');
            if (saved === 'dark') applyDark();

            btn.addEventListener('click', () => {
                document.body.classList.toggle('dark-mode');
                const isDark = document.body.classList.contains('dark-mode');
                localStorage.setItem('dd-theme', isDark ? 'dark' : 'light');
                btn.textContent = isDark ? '☀️' : '🌙';
                // Đổi theme giscus
                const iframe = document.querySelector('.giscus-frame');
                if (iframe) {
                    iframe.contentWindow.postMessage(
                        { giscus: { setConfig: { theme: isDark ? 'dark_dimmed' : 'light' } } },
                        'https://giscus.app'
                    );
                }
            });

            function applyDark() {
                document.body.classList.add('dark-mode');
                btn.textContent = '☀️';
            }
        })();
    </script>
</body>
</html>