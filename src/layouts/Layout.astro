<div class="tool-fab-wrap" id="toolFabWrap">
  <div class="tool-fab-menu" id="toolFabMenu">
    {isHome && <button class="fab-btn" id="fabMail" title="Hòm thư" style="background:#0284c7">✉️</button>}
    {isNovelPage && <button class="fab-btn" id="fabSettings" title="Cài đặt hiển thị" style="background:#8b5cf6">⚙️</button>}
    {isNovelPage && <button class="fab-btn" id="fabStats" title="Thống kê" style="background:#10b981; display:none;">📊</button>}
    <button class="fab-btn" id="fabUp" title="Lên đầu">↑</button>
