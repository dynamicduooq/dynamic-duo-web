      </div>
    </aside>
  </>
)}

<div class="page-wrapper">
  {frontmatter?.tags && frontmatter.tags.length > 0 && (
    <div style="text-align:center;margin-bottom:22px;margin-top:16px;">
      {frontmatter.tags.map((tag: string) => (
        <a href={`/dynamic-duo-web/tags/${encodeURIComponent(tag)}/`} class="tag-badge"># {tag}</a>
      ))}
    </div>
  )}

  {isNovelPage && (
    <div class="chap-nav-row">
      {prevChap
        ? <a href={prevChap.url} class="chap-pn">← {prevChap.frontmatter?.title || `Chương ${prevChap.frontmatter?.chuong}`}</a>
        : <span class="chap-pn disabled">← Chương trước</span>}
      {chapters.length > 1 && (
        <div class="chap-dd-wrap" id="ddTop">
          <button class="chap-dd-btn" id="ddBtnTop">⚓ Chọn chương ▾</button>
          <div class="chap-dd-list" id="ddListTop">
            {chapters.map((c: any) => (
              <a href={c.url} class={c.frontmatter?.chuong === frontmatter?.chuong ? 'cur-chap' : ''}>
                {c.frontmatter?.title || `Chương ${c.frontmatter?.chuong}`}
              </a>
            ))}
          </div>
        </div>
      )}
      {nextChap
        ? <a href={nextChap.url} class="chap-pn">{nextChap.frontmatter?.title || `Chương ${nextChap.frontmatter?.chuong}`} →</a>
        : <span class="chap-pn disabled">Chương sau →</span>}
    </div>
  )}

  {isNovelPage ? (
    <div class="novel-wrap" id="novelWrap">
      <div class="novel-content">
        <slot />
      </div>
    </div>
  ) : (
    <div class="page-content-wrap">
      <slot />
    </div>
  )}

  {isNovelPage && (
    <div class="chap-nav-row" style="margin-top:36px;">
      {prevChap
        ? <a href={prevChap.url} class="chap-pn">← {prevChap.frontmatter?.title || `Chương ${prevChap.frontmatter?.chuong}`}</a>
        : <span class="chap-pn disabled">← Chương trước</span>}
      {chapters.length > 1 && (
        <div class="chap-dd-wrap" id="ddBot">
          <button class="chap-dd-btn" id="ddBtnBot">⚓ Chọn chương ▾</button>
          <div class="chap-dd-list up" id="ddListBot">
            {chapters.map((c: any) => (
              <a href={c.url} class={c.frontmatter?.chuong === frontmatter?.chuong ? 'cur-chap' : ''}>
                {c.frontmatter?.title || `Chương ${c.frontmatter?.chuong}`}
              </a>
            ))}
          </div>
        </div>
      )}
      {nextChap
        ? <a href={nextChap.url} class="chap-pn">{nextChap.frontmatter?.title || `Chương ${nextChap.frontmatter?.chuong}`} →</a>
        : <span class="chap-pn disabled">Chương sau →</span>}
    </div>
  )}

  <!-- ════ CHAPTER-END COMMENT ════ -->
  {isNovelPage && (
    <div class="chap-comment-section" id="chapCommentSection">
      <div class="chap-comment-title">💬 Bình luận chương</div>

      <!-- Admin bar -->
      <div class="admin-bar" id="adminBar">
        <span id="adminStatus">🔒 Admin: chưa đăng nhập</span>
        <button class="admin-login-btn" id="adminLoginBtn">Đăng nhập Google</button>
      </div>

      <!-- Form gửi comment -->
      <div class="comment-form">
        <div class="comment-form-row">
          <input class="comment-inp" id="cmtName" placeholder="Tên của bạn (tùy chọn)" style="max-width:220px" />
        </div>
        <textarea class="comment-textarea" id="cmtText" placeholder="Chia sẻ cảm nhận về chương này... 🌊"></textarea>
        <button class="comment-submit-btn" id="cmtSubmit">Gửi bình luận ✦</button>
      </div>

      <div id="cmtList" class="comment-list">
        <div class="comment-loading">Đang tải bình luận...</div>
      </div>
    </div>
  )}
</div>

<footer>
  <div class="footer-inner">
    <div class="ft-brand">
      <span class="ft-logo">dynamic duo 𓆝.°•</span>
      <p>paired dreams, boundless gleam.</p>
      <p style="margin-top:5px;font-size:.74rem">✉ dynamicduoo.q@gmail.com</p>
    </div>
    <div class="ft-links">
      <a href="/dynamic-duo-web/">Trang chủ</a>
      <a href="/dynamic-duo-web/ca-duoi-nuoc/">Cá dưới nước</a>
      <a href="/dynamic-duo-web/ca-tren-ban/">Cá trên bàn</a>
      <a href="/dynamic-duo-web/ca-tren-troi/">Cá trên trời</a>
      <a href="/dynamic-duo-web/about/">About</a>
    </div>
    <div class="ft-social">
      <p style="font-size:.68rem;color:var(--text-dim);letter-spacing:1px;text-transform:uppercase;margin-bottom:6px">Ghé thăm</p>
      <div class="ft-social-row">
        <a href="https://dynamicduoq.wordpress.com" target="_blank" class="social-ic" title="WordPress">🌐</a>
      </div>
    </div>
  </div>
  <div class="ft-bottom">dynamic duo 𓆝.°• · made with 🌊 by Xê &amp; Gờ · 2026</div>
</footer>

<!-- Nút mở inline comment sidebar (chỉ hiện ở novel page) -->
{isNovelPage && (
  <button class="ic-open-btn" id="icOpenBtn">
    💬 <span id="icOpenBtnLabel">Bình luận đoạn</span>
  </button>
)}

<div class="scroll-btns">
  <button class="scroll-btn" id="scrollTop" title="Lên đầu" aria-label="Lên đầu trang">↑</button>
  <button class="scroll-btn" id="scrollBot" title="Xuống cuối" aria-label="Xuống cuối trang">↓</button>
</div>

<script is:inline>
/* ══════════════════════════════════════════
   SCROLL + PROGRESS BAR
══════════════════════════════════════════ */
const _st = document.getElementById('scrollTop');
const _sb = document.getElementById('scrollBot');
const _rp = document.getElementById('read-progress');
if (_st) _st.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
if (_sb) _sb.addEventListener('click', () => window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' }));
function _updScroll() {
  const y = window.scrollY;
  const max = Math.max(1, document.body.scrollHeight - window.innerHeight);
  const pct = y / max;
  if (_st) _st.classList.toggle('show', y > 300);
  if (_sb) _sb.classList.toggle('show', pct < 0.97 && max > 100);
  if (_rp) _rp.style.width = (pct * 100) + '%';
}
window.addEventListener('scroll', _updScroll, { passive: true });
requestAnimationFrame(() => setTimeout(_updScroll, 200));

/* ══════════════════════════════════════════
   HAMBURGER
══════════════════════════════════════════ */
document.getElementById('hamburger')?.addEventListener('click', () => {
  document.getElementById('mobileMenu')?.classList.toggle('open');
});
document.addEventListener('click', (e) => {
  const mm = document.getElementById('mobileMenu');
  const hb = document.getElementById('hamburger');
  if (mm?.classList.contains('open') && !mm.contains(e.target) && !hb?.contains(e.target))
    mm.classList.remove('open');
});

/* ══════════════════════════════════════════
   CHAPTER DROPDOWNS
══════════════════════════════════════════ */
function setupDD(btnId, listId) {
  const btn = document.getElementById(btnId);
  const list = document.getElementById(listId);
  if (!btn || !list) return;
  btn.addEventListener('click', (e) => {
    e.stopPropagation();
    const wasOpen = list.classList.contains('open');
    document.querySelectorAll('.chap-dd-list.open').forEach(el => el.classList.remove('open'));
    if (!wasOpen) {
      list.classList.add('open');
      const cur = list.querySelector('.cur-chap');
      if (cur) setTimeout(() => cur.scrollIntoView({ block: 'center' }), 30);
    }
  });
}
setupDD('ddBtnTop', 'ddListTop');
setupDD('ddBtnBot', 'ddListBot');
document.addEventListener('click', () => {
  document.querySelectorAll('.chap-dd-list.open').forEach(el => el.classList.remove('open'));
});

/* ══════════════════════════════════════════
   DARK MODE
══════════════════════════════════════════ */
function applyTheme(dark) {
  document.documentElement.setAttribute('data-theme', dark ? 'dark' : '');
  localStorage.setItem('dd-theme', dark ? 'dark' : 'light');
}
window.__ddToggleTheme = function() {
  applyTheme(document.documentElement.getAttribute('data-theme') !== 'dark');
};

/* ══════════════════════════════════════════
   HELPERS
══════════════════════════════════════════ */
function esc(s) {
  return (s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
function timeAgo(ts) {
  if (!ts) return '';
  const d = Date.now() - ts;
  if (d < 60000) return 'vừa xong';
  if (d < 3600000) return Math.floor(d / 60000) + ' phút trước';
  if (d < 86400000) return Math.floor(d / 3600000) + ' giờ trước';
  return Math.floor(d / 86400000) + ' ngày trước';
}
function pageKey() {
  return location.pathname.replace(/[^a-zA-Z0-9]/g, '_').replace(/^_+|_+$/g,'').substring(0, 120);
}
function avatarLetter(name) {
  return (name || 'K').trim().charAt(0).toUpperCase();
}
// Like fingerprint — dùng localStorage per comment
function getLiked(cmtId) {
  try { return JSON.parse(localStorage.getItem('dd_liked') || '{}')[cmtId] || false; } catch(e) { return false; }
}
function setLiked(cmtId, val) {
  try {
    const obj = JSON.parse(localStorage.getItem('dd_liked') || '{}');
    obj[cmtId] = val;
    localStorage.setItem('dd_liked', JSON.stringify(obj));
  } catch(e) {}
}

function waitFirebase(cb) {
  if (window.__ddFirebase?.db) { cb(window.__ddFirebase); return; }
  const handler = () => { if (window.__ddFirebase?.db) cb(window.__ddFirebase); };
  window.addEventListener('dd-firebase-ready', handler, { once: true });
  let attempts = 0;
  const poll = setInterval(() => {
    if (window.__ddFirebase?.db) { clearInterval(poll); cb(window.__ddFirebase); }
    if (++attempts > 50) { clearInterval(poll); }
  }, 200);
}

/* ══════════════════════════════════════════
   A. INLINE COMMENT SIDEBAR
══════════════════════════════════════════ */
(function setupInlineSidebar() {
  const content = document.querySelector('.novel-content');
  const sidebar = document.getElementById('icSidebar');
  const overlay = document.getElementById('icOverlay');
  const closeBtn = document.getElementById('icSidebarClose');
  const paraLabel = document.getElementById('icParaLabel');
  const cmtList = document.getElementById('icCommentList');
  const formName = document.getElementById('icFormName');
  const formText = document.getElementById('icFormText');
  const formSend = document.getElementById('icFormSend');
  const openBtn = document.getElementById('icOpenBtn');
  const novelWrap = document.getElementById('novelWrap');
  if (!content || !sidebar) return;

  // Hiện nút mở
  if (openBtn) openBtn.classList.add('visible');

  let currentParaIdx = null;
  let currentUnsub = null;
  let isAdmin = !!window.__ddAdminUid;

  window.addEventListener('dd-auth-change', (e) => { isAdmin = e.detail.isAdmin; });

  function openSidebar(idx, label) {
    currentParaIdx = idx;
    if (paraLabel) paraLabel.textContent = label;
    sidebar.classList.add('open');
    overlay?.classList.add('show');
    novelWrap?.classList.add('sidebar-open');
    if (openBtn) openBtn.querySelector('#icOpenBtnLabel').textContent = 'Đóng';
    loadInlineComments(idx);
  }

  function closeSidebar() {
    sidebar.classList.remove('open');
    overlay?.classList.remove('show');
    novelWrap?.classList.remove('sidebar-open');
    if (openBtn) openBtn.querySelector('#icOpenBtnLabel').textContent = 'Bình luận đoạn';
    if (currentUnsub) { try { currentUnsub(); } catch(e){} currentUnsub = null; }
    currentParaIdx = null;
  }

  closeBtn?.addEventListener('click', closeSidebar);
  overlay?.addEventListener('click', closeSidebar);
  openBtn?.addEventListener('click', () => {
    if (sidebar.classList.contains('open')) { closeSidebar(); return; }
    // Mở sidebar với đoạn đầu tiên mặc định
    openSidebar(0, 'Đoạn 1');
  });

  function loadInlineComments(idx) {
    if (cmtList) cmtList.innerHTML = '<div class="ic-loading-text">Đang tải...</div>';
    if (currentUnsub) { try { currentUnsub(); } catch(e){} }
    waitFirebase(({ db, ref, onValue, remove }) => {
      const key = 'inline_' + pageKey() + '_p' + idx;
      const unsubFn = onValue(ref(db, 'comments/' + key), (snap) => {
        if (currentParaIdx !== idx) return;
        const data = snap.val();
        if (!data) {
          if (cmtList) cmtList.innerHTML = '<div class="ic-empty">Chưa có bình luận cho đoạn này 🌊</div>';
          return;
        }
        const items = Object.entries(data)
          .map(([id, v]) => ({ id, ...v }))
          .sort((a, b) => (a.ts||0) - (b.ts||0));
        if (cmtList) {
          cmtList.innerHTML = items.map(c => `
            <div class="ic-cmt-item">
              ${isAdmin ? `<button class="ic-cmt-del" data-id="${esc(c.id)}" data-key="${esc(key)}" title="Xóa (admin)">✕</button>` : ''}
              <div class="ic-cmt-header">
                <span class="ic-cmt-name">${esc(c.name) || 'Khách vô danh'}</span>
                <span class="ic-cmt-time">${timeAgo(c.ts)}</span>
              </div>
              <div>${esc(c.text)}</div>
            </div>`).join('');
          // Bind delete
          cmtList.querySelectorAll('.ic-cmt-del').forEach(btn => {
            btn.addEventListener('click', async () => {
              if (!confirm('Xóa bình luận này?')) return;
              await remove(ref(db, 'comments/' + btn.dataset.key + '/' + btn.dataset.id));
            });
          });
          cmtList.scrollTop = cmtList.scrollHeight;
        }
      });
      currentUnsub = unsubFn;
    });
  }

  // Gửi inline comment
  formSend?.addEventListener('click', async () => {
    const text = (formText?.value || '').trim();
    if (!text || currentParaIdx === null) return;
    formSend.disabled = true;
    waitFirebase(async ({ db, ref, push }) => {
      const key = 'inline_' + pageKey() + '_p' + currentParaIdx;
      try {
        await push(ref(db, 'comments/' + key), {
          name: (formName?.value || '').trim() || 'Khách vô danh',
          text, ts: Date.now()
        });
        if (formText) formText.value = '';
      } catch(e) { alert('Lỗi: ' + e.message); }
      formSend.disabled = false;
    });
  });
  formText?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) formSend?.click();
  });

  // Gắn trigger vào từng đoạn
  const paragraphs = content.querySelectorAll('p');
  paragraphs.forEach((p, idx) => {
    const trigger = document.createElement('button');
    trigger.className = 'ic-trigger';
    trigger.title = 'Bình luận đoạn ' + (idx + 1);
    trigger.setAttribute('aria-label', 'Bình luận đoạn ' + (idx + 1));
    trigger.innerHTML = '💬';
    p.appendChild(trigger);

    // Realtime counter
    waitFirebase(({ db, ref, onValue }) => {
      const key = 'inline_' + pageKey() + '_p' + idx;
      onValue(ref(db, 'comments/' + key), (snap) => {
        const cnt = snap.val() ? Object.keys(snap.val()).length : 0;
        trigger.innerHTML = cnt > 0 ? `💬<span style="font-size:.58rem;margin-left:2px">${cnt}</span>` : '💬';
        trigger.classList.toggle('has-comments', cnt > 0);
      });
    });

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      if (currentParaIdx === idx && sidebar.classList.contains('open')) {
        closeSidebar(); return;
      }
      openSidebar(idx, `Đoạn ${idx + 1} · ${p.textContent.trim().substring(0, 30)}...`);
      setTimeout(() => formText?.focus(), 200);
    });
  });
})();

/* ══════════════════════════════════════════
   B. CHAPTER-END COMMENT (reply + like + admin)
══════════════════════════════════════════ */
(function setupChapComments() {
  const section = document.getElementById('chapCommentSection');
  if (!section) return;

  const cmtList     = document.getElementById('cmtList');
  const cmtName     = document.getElementById('cmtName');
  const cmtText     = document.getElementById('cmtText');
  const cmtSubmit   = document.getElementById('cmtSubmit');
  const adminBar    = document.getElementById('adminBar');
  const adminStatus = document.getElementById('adminStatus');
  const adminLoginBtn = document.getElementById('adminLoginBtn');
  if (!cmtList) return;

  const ADMIN_EMAIL = 'dynamicduoo.q@gmail.com';
  let isAdmin = false;
  let adminUid = null;
  const key = 'chap_' + pageKey();

  /* ── Admin auth UI ── */
  window.addEventListener('dd-auth-change', (e) => {
    isAdmin = e.detail.isAdmin;
    adminUid = isAdmin ? e.detail.user?.uid : null;
    if (adminStatus) {
      adminStatus.textContent = isAdmin
        ? `✅ Admin: ${ADMIN_EMAIL}`
        : '🔒 Admin: chưa đăng nhập';
    }
    if (adminLoginBtn) {
      adminLoginBtn.textContent = isAdmin ? 'Đăng xuất' : 'Đăng nhập Google';
      adminLoginBtn.className = isAdmin ? 'admin-logout-btn' : 'admin-login-btn';
    }
    // Re-render để cập nhật nút xóa
    rebuildComments(lastData);
  });

  // Login / logout
  adminLoginBtn?.addEventListener('click', () => {
    const fb = window.__ddFirebase;
    if (!fb) return;
    if (isAdmin) {
      fb.signOut(fb.auth);
    } else {
      const provider = new fb.GoogleAuthProvider();
      fb.signInWithPopup(fb.auth, provider).catch(e => {
        alert('Đăng nhập thất bại: ' + e.message);
      });
    }
  });

  /* ── Render comments ── */
  let lastData = null;
  function rebuildComments(data) {
    lastData = data;
    if (!data) {
      cmtList.innerHTML = '<div class="comment-empty">𓆝 Chưa có bình luận. Hãy là người đầu tiên!</div>';
      return;
    }
    const items = Object.entries(data)
      .map(([id, v]) => ({ id, ...v }))
      .sort((a, b) => (a.ts||0) - (b.ts||0));

    cmtList.innerHTML = items.map(c => {
      const likeCount = c.likes ? Object.keys(c.likes).length : 0;
      const liked = getLiked(c.id);
      const replies = c.replies
        ? Object.entries(c.replies).map(([rid, rv]) => ({ id: rid, ...rv })).sort((a,b)=>(a.ts||0)-(b.ts||0))
        : [];
      const replyCount = replies.length;

      const repliesHtml = replies.map(r => `
        <div class="reply-item" data-rid="${esc(r.id)}" data-cid="${esc(c.id)}">
          <div class="reply-avatar">${esc(avatarLetter(r.name))}</div>
          <div class="reply-body">
            <span class="reply-name">${esc(r.name)||'Khách vô danh'}</span>
            <span class="reply-time">${timeAgo(r.ts)}</span>
            <div class="reply-text">${esc(r.text)}</div>
          </div>
          <button class="reply-del ${isAdmin ? 'admin-visible' : ''}"
            data-rid="${esc(r.id)}" data-cid="${esc(c.id)}" title="Xóa reply">✕</button>
        </div>`).join('');

      return `
        <div class="comment-card" id="cmt-${esc(c.id)}">
          <div class="comment-card-header">
            <div class="comment-card-avatar">${esc(avatarLetter(c.name))}</div>
            <span class="comment-card-name">${esc(c.name)||'Khách vô danh'}</span>
            <span class="comment-card-time">${timeAgo(c.ts)}</span>
          </div>
          <p class="comment-card-text">${esc(c.text)}</p>
          <div class="comment-card-actions">
            <button class="cmt-like-btn ${liked ? 'liked' : ''}" data-id="${esc(c.id)}">
              ${liked ? '❤️' : '🤍'} <span>${likeCount}</span>
            </button>
            <button class="cmt-reply-btn" data-id="${esc(c.id)}">
              💬 ${replyCount > 0 ? `${replyCount} reply` : 'Reply'}
            </button>
            <button class="cmt-del-btn ${isAdmin ? 'admin-visible' : ''}" data-id="${esc(c.id)}">🗑 Xóa</button>
          </div>
          <div class="reply-thread ${replyCount > 0 ? 'open' : ''}" id="thread-${esc(c.id)}">
            ${repliesHtml}
            <div class="reply-form" id="replyForm-${esc(c.id)}">
              <input class="reply-inp" placeholder="Tên (tùy chọn)" data-role="rname" />
              <textarea class="reply-inp-text" placeholder="Viết reply..." rows="2" data-role="rtext"></textarea>
              <div class="reply-form-btns">
                <button class="reply-cancel-btn" data-cid="${esc(c.id)}">Hủy</button>
                <button class="reply-send-btn" data-cid="${esc(c.id)}">Gửi ✦</button>
              </div>
            </div>
          </div>
        </div>`;
    }).join('');

    bindCommentEvents();
  }

  function bindCommentEvents() {
    const fb = window.__ddFirebase;
    if (!fb) return;

    // Like
    cmtList.querySelectorAll('.cmt-like-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const cid = btn.dataset.id;
        const liked = getLiked(cid);
        const likeRef = fb.ref(fb.db, `comments/${key}/${cid}/likes/${Date.now()}_${Math.random().toString(36).slice(2,7)}`);
        if (liked) {
          // Không cho unlike (đơn giản) — hoặc bỏ qua
          return;
        }
        setLiked(cid, true);
        try {
          await fb.push(fb.ref(fb.db, `comments/${key}/${cid}/likes`), { ts: Date.now() });
        } catch(e) {}
      });
    });

    // Reply toggle
    cmtList.querySelectorAll('.cmt-reply-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const cid = btn.dataset.id;
        const thread = document.getElementById('thread-' + cid);
        const form = document.getElementById('replyForm-' + cid);
        if (!thread || !form) return;
        thread.classList.add('open');
        form.classList.toggle('open');
        if (form.classList.contains('open')) {
          form.querySelector('[data-role="rtext"]')?.focus();
        }
      });
    });

    // Reply cancel
    cmtList.querySelectorAll('.reply-cancel-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const form = document.getElementById('replyForm-' + btn.dataset.cid);
        form?.classList.remove('open');
      });
    });

    // Reply send
    cmtList.querySelectorAll('.reply-send-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const cid = btn.dataset.cid;
        const form = document.getElementById('replyForm-' + cid);
        if (!form) return;
        const nameEl = form.querySelector('[data-role="rname"]');
        const textEl = form.querySelector('[data-role="rtext"]');
        const text = (textEl?.value || '').trim();
        if (!text) return;
        btn.disabled = true;
        try {
          await fb.push(fb.ref(fb.db, `comments/${key}/${cid}/replies`), {
            name: (nameEl?.value || '').trim() || 'Khách vô danh',
            text, ts: Date.now()
          });
          if (textEl) textEl.value = '';
          form.classList.remove('open');
        } catch(e) { alert('Lỗi: ' + e.message); }
        btn.disabled = false;
      });
    });

    // Delete comment (admin only)
    cmtList.querySelectorAll('.cmt-del-btn.admin-visible').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!isAdmin) return;
        if (!confirm('Xóa bình luận này?')) return;
        await fb.remove(fb.ref(fb.db, `comments/${key}/${btn.dataset.id}`));
      });
    });

    // Delete reply (admin only)
    cmtList.querySelectorAll('.reply-del.admin-visible').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!isAdmin) return;
        if (!confirm('Xóa reply này?')) return;
        await fb.remove(fb.ref(fb.db, `comments/${key}/${btn.dataset.cid}/replies/${btn.dataset.rid}`));
      });
    });
  }

  /* ── Firebase listener ── */
  waitFirebase(({ db, ref, push, onValue }) => {
    onValue(ref(db, 'comments/' + key), (snap) => {
      rebuildComments(snap.val());
    });

    // Submit comment
    cmtSubmit?.addEventListener('click', async () => {
      const text = (cmtText?.value || '').trim();
      if (!text) return;
      cmtSubmit.disabled = true;
      try {
        await push(ref(db, 'comments/' + key), {
          name: (cmtName?.value || '').trim() || 'Khách vô danh',
          text, ts: Date.now()
        });
        if (cmtText) cmtText.value = '';
      } catch(e) { alert('Lỗi: ' + e.message); }
      cmtSubmit.disabled = false;
    });

    cmtText?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) cmtSubmit?.click();
    });
  });
})();
</script>
</body>
</html>