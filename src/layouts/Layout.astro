  <a href="/dynamic-duo-web/admin/">⚙ Admin</a>
</div>

<div class="page-wrapper">
  <div class="container">

    {/* Tags */}
    {frontmatter?.tags && frontmatter.tags.length > 0 && (
      <div style="text-align:center;margin-bottom:24px;">
        {frontmatter.tags.map((tag: string) => (
          <a href={`/dynamic-duo-web/tags/${encodeURIComponent(tag)}/`} class="tag-badge"># {tag}</a>
        ))}
      </div>
    )}

    {/* Dropdown chương đầu trang */}
    {isNovelPage && chapters.length > 1 && (
      <div class="chap-nav-wrap" style="position:relative;">
        <button class="chap-select-btn" id="chapBtnTop">
          ⚓ {frontmatter?.title} ▾
          <div class="chap-dropdown-list" id="chapListTop">
            {chapters.map((c: any) => (
              <a href={c.url} class={c.frontmatter?.chuong === frontmatter?.chuong ? 'current-chap' : ''}>
                {c.frontmatter?.title || `Chương ${c.frontmatter?.chuong}`}
              </a>
            ))}
          </div>
        </button>
      </div>
    )}

    {/* NỘI DUNG */}
    <div class={isNovelPage ? 'novel-content' : ''}>
      <slot />
    </div>

    {/* Prev / Next */}
    {isNovelPage && (prevChap || nextChap) && (
      <div class="chap-prev-next">
        {prevChap
          ? <a href={prevChap.url} class="chap-pn-btn prev-btn">← {prevChap.frontmatter?.title || `Chương ${prevChap.frontmatter?.chuong}`}</a>
          : <span />}
        {nextChap
          ? <a href={nextChap.url} class="chap-pn-btn next-btn">{nextChap.frontmatter?.title || `Chương ${nextChap.frontmatter?.chuong}`} →</a>
          : <span />}
      </div>
    )}

    {/* Dropdown chương cuối trang */}
    {isNovelPage && chapters.length > 1 && (
      <div class="chap-nav-wrap" style="position:relative;">
        <button class="chap-select-btn" id="chapBtnBot">
          ⚓ Chọn chương ▾
          <div class="chap-dropdown-list" id="chapListBot" style="bottom:calc(100% + 6px);top:auto;">
            {chapters.map((c: any) => (
              <a href={c.url} class={c.frontmatter?.chuong === frontmatter?.chuong ? 'current-chap' : ''}>
                {c.frontmatter?.title || `Chương ${c.frontmatter?.chuong}`}
              </a>
            ))}
          </div>
        </button>
      </div>
    )}

    {/* Giscus bình luận */}
    {isNovelPage && (
      <div class="giscus-wrap">
        <script src="https://giscus.app/client.js"
          data-repo="dynamicduooq/dynamic-duo-web"
          data-repo-id="R_kgDOSn8PYg"
          data-category="Announcements"
          data-category-id="DIC_kwDOSn8PYs4C923K"
          data-mapping="pathname"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="bottom"
          data-theme="light"
          data-lang="vi"
          crossorigin="anonymous"
          async>
        </script>
      </div>
    )}

  </div>
</div>

