---
const { frontmatter } = Astro.props;
import settings from '../data/settings.json';

const currentPath = Astro.url?.pathname ?? '';
let currentTruyenId = frontmatter?.truyen_id;

const parts = currentPath.split('/').filter(Boolean);
const folderName = parts[parts.length - 2] || parts[parts.length - 1];
if (!currentTruyenId && folderName) {
    currentTruyenId = frontmatter?.truyen_id;
}

let chapters = [];
if (currentTruyenId) {
    const allPosts = Object.values(import.meta.glob('../pages/**/*.md', { eager: true }));
    chapters = allPosts
        .filter(post => {
            const postPath = post.url || '';
            const postFileName = postPath.split('/').pop() || '';
            const postTruyenId = post.frontmatter?.truyen_id || (postFileName.includes('-') ? postFileName.split('-')[0] : null);
            return postTruyenId === currentTruyenId;
        })
        .sort((a, b) => {
            const parseChapter = (post) => {
                if (post.frontmatter?.chuong !== undefined) return post.frontmatter.chuong;
                const match = (post.url || '').match(/chuong-(\d+)/i);
                return match ? parseInt(match[1]) : (post.url?.includes('index') ? 0 : 999);
            };
            return parseChapter(a) - parseChapter(b);
        });
}

const isNovelPage = frontmatter?.chuong !== undefined;
---

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{frontmatter?.title || 'Trang chủ'} | {settings.site_name}</title>
    
