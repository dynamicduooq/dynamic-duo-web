---
const { frontmatter } = Astro.props;
import settings from '../data/settings.json';

const currentPath = Astro.url?.pathname ?? '';
const isNovelPage = frontmatter?.chuong !== undefined && frontmatter?.chuong !== 0;
const isHome = Astro.props.isHome === true || frontmatter?.isHome === true;
const currentTruyenId = frontmatter?.truyen_id;

// 1. Quét toàn bộ file .md VÀ danh sách thư mục (để lấy cả truyện chưa có chương)
const allPosts = Object.values(import.meta.glob('../pages/**/*.md', { eager: true })) as any[];
const storyFolders = Object.keys(import.meta.glob('../pages/truyen/*/index.astro'));

// 2. Lấy danh sách slug duy nhất (Sửa lỗi dính "dynamic duo web")
const slugs = [...new Set([
  ...allPosts.map(p => {
    const parts = (p.url || "").split('/').filter(Boolean);
    const idx = parts.indexOf('truyen');
    return idx !== -1 ? parts[idx + 1] : null; // Chỉ lấy những URL có chứa /truyen/
  }),
  ...storyFolders.map(path => {
    const parts = path.split('/');
    const idx = parts.indexOf('truyen');
    return idx !== -1 ? parts[idx + 1] : null;
  })
])].filter(Boolean) as string[];
// 3. Xây dựng dữ liệu cho Navbar
const navStories = slugs.map(slug => {
  const storyChaps = allPosts.filter(p => p.url?.includes(`/truyen/${slug}/`));
  const infoFile = storyChaps.find(c => c.frontmatter?.truyen_name) || storyChaps[0];
  const fm = infoFile?.frontmatter || {};

  const chapCount = storyChaps.filter(c => c.frontmatter?.chuong && c.frontmatter.chuong !== 0).length;
  const tongSoChuong = parseInt(fm.tong_so_chuong) || 0;
  
  const isCompleted = tongSoChuong > 0 && chapCount >= tongSoChuong;
  const isOngoing = chapCount > 0 && !isCompleted;
  const isUpcoming = chapCount === 0;

  return {
    title: fm.truyen_name || slug.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' '),
    url: `/dynamic-duo-web/truyen/${slug}/`,
    isCompleted, isOngoing, isUpcoming
  };
});

const navDuoiNuoc = navStories.filter(s => s.isOngoing);
const navTrenBan = navStories.filter(s => s.isCompleted);
const navTrenTroi = navStories.filter(s => s.isUpcoming);

// LOGIC ĐIỀU HƯỚNG CHƯƠNG (Sửa lỗi sắp xếp 20 sau 10)
let chapters: any[] = [];
let prevChap: any = null;
let nextChap: any = null;
let currentFolder = "";

if (isNovelPage) {
  const normPath = (u: string) => u.replace(/\/$/, '').replace(/\/index$/, '');
  const cur = normPath(currentPath);
  currentFolder = cur.substring(0, cur.lastIndexOf('/'));

  chapters = allPosts
    .filter((p: any) => {
      const pUrl = normPath(p.url || '');
      return pUrl.substring(0, pUrl.lastIndexOf('/')) === currentFolder && p.frontmatter?.chuong;
    })
    .sort((a: any, b: any) => Number(a.frontmatter.chuong) - Number(b.frontmatter.chuong));

  const idx = chapters.findIndex((c: any) => normPath(c.url || '') === cur);
  if (idx > 0) prevChap = chapters[idx - 1];
  if (idx < chapters.length - 1) nextChap = chapters[idx + 1];
}
