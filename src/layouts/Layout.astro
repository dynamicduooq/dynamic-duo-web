<script is:inline>
/* ══ HELPERS ══ */
function esc(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function timeAgo(ts){
  if(!ts) return '';
  const d=Date.now()-ts;
  if(d<60000) return 'vừa xong';
  if(d<3600000) return Math.floor(d/60000)+' phút trước';
  if(d<86400000) return Math.floor(d/3600000)+' giờ trước';
  return Math.floor(d/86400000)+' ngày trước';
}
function pageKey(){
  return location.pathname.replace(/[^a-zA-Z0-9]/g,'_').replace(/^_+|_+$/g,'').substring(0,120);
}
function avatarLetter(name){ return (name||'K').trim().charAt(0).toUpperCase(); }
function getMyToken(){
  let t = localStorage.getItem('dd_token');
  if(!t){ t = Math.random().toString(36).slice(2)+Date.now().toString(36); localStorage.setItem('dd_token',t); }
  return t;
}
function getLiked(id){ try{ return JSON.parse(localStorage.getItem('dd_liked')||'{}')[id]||false; }catch(e){ return false; } }
function setLiked(id,v){ try{ const o=JSON.parse(localStorage.getItem('dd_liked')||'{}'); o[id]=v; localStorage.setItem('dd_liked',JSON.stringify(o)); }catch(e){} }
function waitFirebase(cb){
  if(window.__ddFirebase?.db){ cb(window.__ddFirebase); return; }
  window.addEventListener('dd-firebase-ready',()=>{ if(window.__ddFirebase?.db) cb(window.__ddFirebase); },{once:true});
  let n=0; const t=setInterval(()=>{ if(window.__ddFirebase?.db){clearInterval(t);cb(window.__ddFirebase);} if(++n>60) clearInterval(t); },200);
}

/* ══ SCROLL + PROGRESS ══ */
const _st=document.getElementById('scrollTop'),_sb=document.getElementById('scrollBot'),_rp=document.getElementById('read-progress');
if(_st) _st.addEventListener('click',()=>window.scrollTo({top:0,behavior:'smooth'}));
if(_sb) _sb.addEventListener('click',()=>window.scrollTo({top:document.body.scrollHeight,behavior:'smooth'}));
function updScroll(){
  const y=window.scrollY, max=Math.max(1,document.body.scrollHeight-window.innerHeight), p=y/max;
  if(_st) _st.classList.toggle('show',y>300);
  if(_sb) _sb.classList.toggle('show',p<.97&&max>100);
  if(_rp) _rp.style.width=(p*100)+'%';
}
window.addEventListener('scroll',updScroll,{passive:true});
requestAnimationFrame(()=>setTimeout(updScroll,200));

/* ══ HAMBURGER ══ */
document.getElementById('hamburger')?.addEventListener('click',()=>document.getElementById('mobileMenu')?.classList.toggle('open'));
document.addEventListener('click',e=>{
  const mm=document.getElementById('mobileMenu'),hb=document.getElementById('hamburger');
  if(mm?.classList.contains('open')&&!mm.contains(e.target)&&!hb?.contains(e.target)) mm.classList.remove('open');
});

/* ══ CHAPTER DROPDOWNS ══ */
function setupDD(btnId,listId){
  const btn=document.getElementById(btnId),list=document.getElementById(listId);
  if(!btn||!list) return;
  btn.addEventListener('click',e=>{
    e.stopPropagation();
    const was=list.classList.contains('open');
    document.querySelectorAll('.chap-dd-list.open').forEach(el=>el.classList.remove('open'));
    if(!was){
      list.classList.add('open');
      const cur=list.querySelector('.cur-chap');
      if(cur) setTimeout(()=>cur.scrollIntoView({block:'nearest'}),30);
    }
  });
}
setupDD('ddBtnTop','ddListTop'); setupDD('ddBtnBot','ddListBot');
document.addEventListener('click',()=>document.querySelectorAll('.chap-dd-list.open').forEach(el=>el.classList.remove('open')));

/* ══ FIX 5: DARK MODE — chỉ 1 button theme duy nhất ══ */
function applyTheme(dark){ document.documentElement.setAttribute('data-theme',dark?'dark':''); localStorage.setItem('dd-theme',dark?'dark':'light'); }
window.__ddToggleTheme=()=>applyTheme(document.documentElement.getAttribute('data-theme')!=='dark');

(function injectThemeBtn(){
  const navLinks = document.querySelector('.nav-links');
  if(!navLinks) return;
  const btn = document.createElement('button');
  btn.style.cssText = 'font-size:.8rem;width:32px;height:32px;border-radius:50%;border:1px solid rgba(186,230,253,.6);background:none;color:var(--text-mid);cursor:pointer;transition:all .2s ease;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;';
  btn.id = 'navThemeBtn';
  const isDark = () => document.documentElement.getAttribute('data-theme') === 'dark';
  const sync = () => { btn.textContent = isDark() ? '☀️' : '🌙'; btn.title = isDark() ? 'Chế độ sáng' : 'Chế độ tối'; };
  sync();
  btn.addEventListener('click', () => { window.__ddToggleTheme(); sync(); });
  navLinks.appendChild(btn);
})();

/* ══ FIX 6: ADMIN FLOATING BUTTON ══ */
(function setupAdminBtn(){
  const btn = document.getElementById('adminFloatingBtn');
  if(!btn) return;

  let isAdmin = !!window.__ddIsAdmin;

  function syncBtn(){
    btn.classList.toggle('visible', isAdmin); // chỉ hiện khi đăng nhập
    btn.textContent = isAdmin ? '🔓' : '🔑';
    btn.title = isAdmin ? 'Đăng xuất Admin' : 'Đăng nhập Admin';
  }
  syncBtn();

  window.addEventListener('dd-auth-change', e => {
    isAdmin = e.detail.isAdmin;
    syncBtn();
  });

  btn.addEventListener('click', () => {
    const fb = window.__ddFirebase; if(!fb) return;
    if(isAdmin){
      if(confirm('Đăng xuất tài khoản admin?')) fb.signOut(fb.auth);
    } else {
      const p = new fb.GoogleAuthProvider();
      fb.signInWithPopup(fb.auth, p).catch(e => alert('Lỗi đăng nhập: '+e.message));
    }
  });
})();

/* ══════════════════════════════════════════
   A. INLINE COMMENT SIDEBAR
══════════════════════════════════════════ */
(function setupInlineSidebar(){
  const novelWrap  = document.getElementById('novelLayoutWrap');
  const content    = document.getElementById('novelContent');
  const sidebar    = document.getElementById('icSidebar');
  const sideList   = document.getElementById('icSidebarList');
  const closeBtn   = document.getElementById('icSidebarClose');
  const formName   = document.getElementById('icFormName');
  const formText   = document.getElementById('icFormText');
  const formSend   = document.getElementById('icFormSend');
  const overlay    = document.getElementById('icOverlay');
  const quotingBar = document.getElementById('icQuotingBar');
  const quotingLabel = document.getElementById('icQuotingLabel');
  if(!content || !sidebar || !novelWrap) return;

  let currentIdx   = null;
  let currentUnsub = null;
  let isAdmin      = !!window.__ddIsAdmin;
  const myToken    = getMyToken();
  let quotingReplyId   = null;
  let quotingReplyName = null;

  document.getElementById('icQuotingCancel')?.addEventListener('click', clearQuoting);

  function setQuoting(rid, rname){
    quotingReplyId   = rid;
    quotingReplyName = rname;
    if(quotingBar)   quotingBar.classList.add('show');
    if(quotingLabel) quotingLabel.textContent = '↩ Reply cho ' + (rname || 'Khách vô danh');
    formText?.focus();
  }
  function clearQuoting(){
    quotingReplyId   = null;
    quotingReplyName = null;
    if(quotingBar) quotingBar.classList.remove('show');
  }

  window.addEventListener('dd-auth-change', e => { isAdmin = e.detail.isAdmin; });

  function openSidebar(idx){
    content.querySelectorAll('p.ic-active').forEach(p => p.classList.remove('ic-active'));
    currentIdx = idx;
    clearQuoting();
    const paras   = content.querySelectorAll('p');
    const preview = document.getElementById('icParaPreview');
    if(preview){
      const clone = paras[idx] ? paras[idx].cloneNode(true) : null;
      if(clone){ clone.querySelectorAll('.ic-trigger').forEach(b => b.remove()); preview.textContent = clone.textContent.trim().substring(0,120)+(clone.textContent.trim().length>120?'…':''); }
    }
    if(sideList) sideList.innerHTML = '<div class="ic-empty">Đang tải...</div>';
    if(paras[idx]) paras[idx].classList.add('ic-active');
    novelWrap.classList.add('sidebar-open');
    /* FIX 1: Overlay hiện, không push content */
    if(overlay) overlay.classList.add('show');
    loadInlineComments(idx);
    setTimeout(() => formText?.focus(), 200);
  }

  function closeSidebar(){
    novelWrap.classList.remove('sidebar-open');
    if(overlay) overlay.classList.remove('show');
    content.querySelectorAll('p.ic-active').forEach(p => p.classList.remove('ic-active'));
    if(currentUnsub){ try{currentUnsub();}catch(e){} currentUnsub = null; }
    currentIdx = null;
    clearQuoting();
  }

  closeBtn?.addEventListener('click', closeSidebar);
  overlay?.addEventListener('click', closeSidebar);

  function loadInlineComments(idx){
    if(currentUnsub){ try{currentUnsub();}catch(e){} currentUnsub = null; }
    waitFirebase(({db, ref, onValue}) => {
      const key = 'inline_' + pageKey() + '_p' + idx;
      currentUnsub = onValue(ref(db, 'comments/' + key), snap => {
        if(currentIdx !== idx) return;
        renderInlineComments(snap.val(), key, idx);
      });
    });
  }

  function renderInlineComments(data, key, idx){
    if(!sideList) return;
    if(!data){
      sideList.innerHTML = '<div class="ic-empty">Chưa có bình luận cho đoạn này 🌊<br><small>Hãy là người đầu tiên!</small></div>';
      return;
    }
    const items = Object.entries(data)
      .map(([id,v]) => ({id,...v}))
      .sort((a,b) => (a.ts||0) - (b.ts||0));

    sideList.innerHTML = items.map(c => {
      const isMine = c.token === myToken;
      const canDel = isAdmin || isMine;
      const replies = c.replies
        ? Object.entries(c.replies).map(([rid,rv]) => ({id:rid,...rv})).sort((a,b) => (a.ts||0)-(b.ts||0))
        : [];

      const repliesHtml = replies.map(r => {
        const rMine  = r.token === myToken;
        const rCanDel= isAdmin || rMine;
        const atTag  = r.replyTo ? `<span class="ic-reply-at">@${esc(r.replyTo.name)}</span>` : '';
        return `<div class="ic-reply-item" id="icri-${esc(r.id)}">
          <div class="ic-reply-avatar">${esc(avatarLetter(r.name))}</div>
          <div class="ic-reply-body">
            <span class="ic-reply-name">${esc(r.name)||'Khách vô danh'}</span>
            <div class="ic-reply-text">${atTag}${esc(r.text)}</div>
            <button class="ic-rr-btn" data-action="rr-reply" data-cid="${esc(c.id)}" data-rid="${esc(r.id)}" data-rname="${esc(r.name||'Khách vô danh')}">↩ Reply</button>
          </div>
          ${rCanDel ? `<button class="ic-reply-del show" data-action="del-reply" data-key="${esc(key)}" data-cid="${esc(c.id)}" data-rid="${esc(r.id)}">✕</button>` : ''}
        </div>`;
      }).join('');

      return `<div class="ic-item" id="icitem-${esc(c.id)}">
        <div class="ic-item-header">
          <span class="ic-item-name">${esc(c.name)||'Khách vô danh'}</span>
          <span class="ic-item-time">${timeAgo(c.ts)}</span>
        </div>
        <div class="ic-item-text">${esc(c.text)}</div>
        <div class="ic-item-actions">
          <button class="ic-reply-toggle" data-action="toggle-reply" data-cid="${esc(c.id)}">
            ↩ Reply ${replies.length > 0 ? '('+replies.length+')' : ''}
          </button>
          ${canDel ? `<button class="ic-del-btn show" data-action="del-comment" data-key="${esc(key)}" data-id="${esc(c.id)}">✕ Xóa</button>` : ''}
        </div>
        <div class="ic-replies ${replies.length > 0 ? 'open' : ''}" id="icreplies-${esc(c.id)}">
          ${repliesHtml}
          <div class="ic-reply-form" id="icrf-${esc(c.id)}">
            <input placeholder="Tên (tùy chọn)" data-role="rname" />
            <textarea placeholder="Viết reply..." rows="2" data-role="rtext"></textarea>
            <div class="ic-reply-form-row">
              <button class="ic-rf-cancel" data-action="cancel-reply" data-cid="${esc(c.id)}">Hủy</button>
              <button class="ic-rf-send"   data-action="send-reply"   data-cid="${esc(c.id)}" data-key="${esc(key)}">Gửi ✦</button>
            </div>
          </div>
        </div>
      </div>`;
    }).join('');

    sideList.scrollTop = sideList.scrollHeight;
  }

  sideList?.addEventListener('click', async e => {
    const btn = e.target.closest('[data-action]');
    if(!btn) return;
    const action = btn.dataset.action;

    if(action === 'del-comment'){
      if(!confirm('Xóa bình luận này?')) return;
      waitFirebase(({db, ref, remove}) => remove(ref(db, 'comments/' + btn.dataset.key + '/' + btn.dataset.id)));
      return;
    }
    if(action === 'del-reply'){
      if(!confirm('Xóa reply này?')) return;
      waitFirebase(({db, ref, remove}) => remove(ref(db, 'comments/' + btn.dataset.key + '/' + btn.dataset.cid + '/replies/' + btn.dataset.rid)));
      return;
    }
    if(action === 'toggle-reply'){
      const cid     = btn.dataset.cid;
      const replies = document.getElementById('icreplies-' + cid);
      const form    = document.getElementById('icrf-' + cid);
      if(replies) replies.classList.add('open');
      if(form){
        form.classList.toggle('open');
        if(form.classList.contains('open')) form.querySelector('[data-role="rtext"]')?.focus();
      }
      clearQuoting();
      return;
    }
    if(action === 'rr-reply'){
      const cid   = btn.dataset.cid;
      const rid   = btn.dataset.rid;
      const rname = btn.dataset.rname;
      const form  = document.getElementById('icrf-' + cid);
      const replies = document.getElementById('icreplies-' + cid);
      if(replies) replies.classList.add('open');
      if(form){ form.classList.add('open'); form.querySelector('[data-role="rtext"]')?.focus(); }
      setQuoting(rid, rname);
      setTimeout(() => sideList?.scrollTo({top: sideList.scrollHeight, behavior:'smooth'}), 50);
      return;
    }
    if(action === 'cancel-reply'){
      document.getElementById('icrf-' + btn.dataset.cid)?.classList.remove('open');
      clearQuoting();
      return;
    }
    if(action === 'send-reply'){
      const form = document.getElementById('icrf-' + btn.dataset.cid);
      const text = (form?.querySelector('[data-role="rtext"]')?.value || '').trim();
      if(!text) return;
      btn.disabled = true;
      const name = (form?.querySelector('[data-role="rname"]')?.value || '').trim() || 'Khách vô danh';
      const payload = { name, text, ts: Date.now(), token: myToken };
      if(quotingReplyId){ payload.replyTo = { id: quotingReplyId, name: quotingReplyName || '' }; }
      waitFirebase(async ({db, ref, push}) => {
        try{
          await push(ref(db, 'comments/' + btn.dataset.key + '/' + btn.dataset.cid + '/replies'), payload);
          form.querySelector('[data-role="rtext"]').value = '';
          form.classList.remove('open');
          clearQuoting();
        } catch(e){ alert('Lỗi: ' + e.message); }
        btn.disabled = false;
      });
      return;
    }
  });

  formSend?.addEventListener('click', async () => {
    const text = (formText?.value || '').trim();
    if(!text || currentIdx === null) return;
    formSend.disabled = true;
    waitFirebase(async ({db, ref, push}) => {
      const key = 'inline_' + pageKey() + '_p' + currentIdx;
      try{
        await push(ref(db, 'comments/' + key), {
          name : (formName?.value || '').trim() || 'Khách vô danh',
          text, ts: Date.now(), token: myToken
        });
        if(formText) formText.value = '';
      } catch(e){ alert('Lỗi: ' + e.message); }
      formSend.disabled = false;
    });
  });
  formText?.addEventListener('keydown', e => {
    if(e.key === 'Enter' && (e.ctrlKey || e.metaKey)) formSend?.click();
  });

  const paragraphs = content.querySelectorAll('p');
  paragraphs.forEach((p, idx) => {
    const btn = document.createElement('button');
    btn.className = 'ic-trigger';
    btn.title     = 'Bình luận đoạn ' + (idx + 1);
    btn.setAttribute('aria-label', 'Bình luận đoạn ' + (idx + 1));
    btn.innerHTML = '💬';
    p.appendChild(btn);

    waitFirebase(({db, ref, onValue}) => {
      const key = 'inline_' + pageKey() + '_p' + idx;
      onValue(ref(db, 'comments/' + key), snap => {
        const cnt = snap.val() ? Object.keys(snap.val()).length : 0;
        btn.innerHTML = cnt > 0
          ? `💬<span style="font-size:.56rem;margin-left:1px;font-style:normal">${cnt}</span>`
          : '💬';
        btn.classList.toggle('has-comments', cnt > 0);
      });
    });

    btn.addEventListener('click', e => {
      e.stopPropagation();
      if(currentIdx === idx && novelWrap.classList.contains('sidebar-open')){
        closeSidebar();
      } else {
        openSidebar(idx);
      }
    });
  });
})();

/* ══════════════════════════════════════════
   B. CHAPTER-END COMMENT
══════════════════════════════════════════ */
(function setupChapComments(){
  const section       = document.getElementById('chapCommentSection');
  if(!section) return;

  const cmtList       = document.getElementById('cmtList');
  const cmtName       = document.getElementById('cmtName');
  const cmtText       = document.getElementById('cmtText');
  const cmtSubmit     = document.getElementById('cmtSubmit');

  if(!cmtList) return;

  const myToken     = getMyToken();
  const key         = 'chap_' + pageKey();
  let isAdmin       = false;
  let lastData      = null;
  let listenerBound = false;
  let rebuildTimer  = null;

  function scheduleRebuild(data){
    lastData = data;
    clearTimeout(rebuildTimer);
    rebuildTimer = setTimeout(() => rebuildComments(lastData), 60);
  }

  window.addEventListener('dd-auth-change', e => {
    isAdmin = e.detail.isAdmin;
    if(lastData !== null) rebuildComments(lastData);
  });

  function rebuildComments(data){
    if(!cmtList) return;
    if(!data){
      cmtList.innerHTML = '<div class="comment-empty">𓆝 Chưa có bình luận. Hãy là người đầu tiên!</div>';
      return;
    }
    const items = Object.entries(data)
      .map(([id,v]) => ({id,...v}))
      .sort((a,b) => (a.ts||0) - (b.ts||0));

    cmtList.innerHTML = items.map(c => {
      const isMine    = c.token === myToken;
      const canDel    = isAdmin || isMine;
      const likeCount = c.likes ? Object.keys(c.likes).length : 0;
      const liked     = getLiked(c.id);
      const replies   = c.replies
        ? Object.entries(c.replies).map(([rid,rv]) => ({id:rid,...rv})).sort((a,b) => (a.ts||0)-(b.ts||0))
        : [];

      const repliesHtml = replies.map(r => {
        const rMine  = r.token === myToken;
        const rCanDel= isAdmin || rMine;
        const atTag  = r.replyTo ? `<span class="reply-at">@${esc(r.replyTo.name)}</span> ` : '';
        return `<div class="reply-item" id="ri-${esc(r.id)}">
          <div class="reply-avatar">${esc(avatarLetter(r.name))}</div>
          <div class="reply-body">
            <span class="reply-name">${esc(r.name)||'Khách vô danh'}</span>
            <span class="reply-time">${timeAgo(r.ts)}</span>
            <div class="reply-text">${atTag}${esc(r.text)}</div>
            <button class="reply-quote-btn" data-cid="${esc(c.id)}" data-rid="${esc(r.id)}" data-rname="${esc(r.name||'Khách vô danh')}">↩ Reply</button>
          </div>
          <button class="reply-del ${rCanDel?'show':''}" data-rid="${esc(r.id)}" data-cid="${esc(c.id)}">✕</button>
        </div>`;
      }).join('');

      return `<div class="comment-card" id="cmt-${esc(c.id)}">
        <div class="comment-card-header">
          <div class="comment-card-avatar">${esc(avatarLetter(c.name))}</div>
          <span class="comment-card-name">${esc(c.name)||'Khách vô danh'}</span>
          <span class="comment-card-time">${timeAgo(c.ts)}</span>
        </div>
        <p class="comment-card-text">${esc(c.text)}</p>
        <div class="comment-card-actions">
          <button class="cmt-like-btn ${liked?'liked':''}" data-id="${esc(c.id)}">
            ${liked?'❤️':'🤍'} <span>${likeCount}</span>
          </button>
          <button class="cmt-reply-btn" data-id="${esc(c.id)}">
            💬 ${replies.length > 0 ? replies.length+' reply' : 'Reply'}
          </button>
          <button class="cmt-del-btn ${canDel?'show':''}" data-id="${esc(c.id)}">🗑 Xóa</button>
        </div>
        <div class="reply-thread ${replies.length > 0 ? 'open' : ''}" id="thread-${esc(c.id)}">
          <div class="reply-items-wrap" id="riwrap-${esc(c.id)}">${repliesHtml}</div>
          <div class="reply-form" id="rf-${esc(c.id)}">
            <div class="reply-quoting" id="rq-${esc(c.id)}" style="display:none">
              <span class="reply-quoting-label"></span>
              <button class="reply-quoting-cancel" data-cid="${esc(c.id)}">✕</button>
            </div>
            <input class="reply-inp" placeholder="Tên (tùy chọn)" data-role="rname" />
            <textarea class="reply-inp-text" placeholder="Viết reply..." rows="2" data-role="rtext"></textarea>
            <div class="reply-form-btns">
              <button class="reply-cancel-btn" data-cid="${esc(c.id)}">Hủy</button>
              <button class="reply-send-btn"   data-cid="${esc(c.id)}">Gửi ✦</button>
            </div>
          </div>
        </div>
      </div>`;
    }).join('');

    bindEvents();
  }

  function bindEvents(){
    const fb = window.__ddFirebase; if(!fb) return;
    cmtList.querySelectorAll('.cmt-like-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id;
        if(getLiked(id)) return;
        setLiked(id, true);
        try { await fb.push(fb.ref(fb.db, `comments/${key}/${id}/likes`), {ts:Date.now()}); } catch(e){}
      });
    });
    cmtList.querySelectorAll('.cmt-reply-btn').forEach(btn => {
      btn.addEventListener('click', () => openReplyForm(btn.dataset.id, null, null));
    });
    cmtList.querySelectorAll('.reply-quote-btn').forEach(btn => {
      btn.addEventListener('click', () => openReplyForm(btn.dataset.cid, btn.dataset.rid, btn.dataset.rname));
    });
    cmtList.querySelectorAll('.reply-quoting-cancel').forEach(btn => {
      btn.addEventListener('click', () => clearQuoting(btn.dataset.cid));
    });
    cmtList.querySelectorAll('.reply-cancel-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.getElementById('rf-'+btn.dataset.cid)?.classList.remove('open');
        clearQuoting(btn.dataset.cid);
      });
    });
    cmtList.querySelectorAll('.reply-send-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const cid  = btn.dataset.cid;
        const form = document.getElementById('rf-'+cid);
        const text = (form?.querySelector('[data-role="rtext"]')?.value||'').trim();
        if(!text) return;
        btn.disabled = true;
        const name    = (form?.querySelector('[data-role="rname"]')?.value||'').trim() || 'Khách vô danh';
        const quotBox = document.getElementById('rq-'+cid);
        const replyTo = quotBox?.dataset.replyToId ? { id: quotBox.dataset.replyToId, name: quotBox.dataset.replyToName || '' } : null;
        const payload = { name, text, ts: Date.now(), token: myToken };
        if(replyTo) payload.replyTo = replyTo;
        try {
          await fb.push(fb.ref(fb.db, `comments/${key}/${cid}/replies`), payload);
          form.querySelector('[data-role="rtext"]').value = '';
          form.classList.remove('open');
          clearQuoting(cid);
          setTimeout(() => { const wrap = document.getElementById('riwrap-'+cid); if(wrap) wrap.lastElementChild?.scrollIntoView({behavior:'smooth', block:'nearest'}); }, 300);
        } catch(e){ alert('Lỗi: '+e.message); }
        btn.disabled = false;
      });
    });
    cmtList.querySelectorAll('.cmt-del-btn.show').forEach(btn => {
      btn.addEventListener('click', async () => {
        if(!confirm('Xóa bình luận này?')) return;
        await fb.remove(fb.ref(fb.db, `comments/${key}/${btn.dataset.id}`));
      });
    });
    cmtList.querySelectorAll('.reply-del.show').forEach(btn => {
      btn.addEventListener('click', async () => {
        if(!confirm('Xóa reply này?')) return;
        await fb.remove(fb.ref(fb.db, `comments/${key}/${btn.dataset.cid}/replies/${btn.dataset.rid}`));
      });
    });
  }

  function openReplyForm(cid, rid, rname){
    const thread = document.getElementById('thread-'+cid);
    const form   = document.getElementById('rf-'+cid);
    if(thread) thread.classList.add('open');
    if(form){
      form.classList.add('open');
      if(rid){ setQuoting(cid, rid, rname); }
      else { clearQuoting(cid); }
      form.querySelector('[data-role="rtext"]')?.focus();
    }
  }
  function setQuoting(cid, rid, rname){
    const box = document.getElementById('rq-'+cid);
    if(!box) return;
    box.style.display    = 'flex';
    box.dataset.replyToId   = rid;
    box.dataset.replyToName = rname;
    const label = box.querySelector('.reply-quoting-label');
    if(label) label.textContent = '↩ Reply cho ' + (rname||'Khách vô danh');
  }
  function clearQuoting(cid){
    const box = document.getElementById('rq-'+cid);
    if(!box) return;
    box.style.display       = 'none';
    box.dataset.replyToId   = '';
    box.dataset.replyToName = '';
  }

  waitFirebase(({db, ref, push, onValue}) => {
    onValue(ref(db, 'comments/'+key), snap => scheduleRebuild(snap.val()));
    if(listenerBound) return;
    listenerBound = true;
    cmtSubmit?.addEventListener('click', async () => {
      const text = (cmtText?.value||'').trim();
      if(!text) return;
      cmtSubmit.disabled = true;
      try {
        await push(ref(db, 'comments/'+key), {
          name  : (cmtName?.value||'').trim() || 'Khách vô danh',
          text, ts : Date.now(), token : myToken
        });
        if(cmtText) cmtText.value = '';
      } catch(e){ alert('Lỗi: '+e.message); }
      cmtSubmit.disabled = false;
    });
    cmtText?.addEventListener('keydown', e => {
      if(e.key === 'Enter' && (e.ctrlKey || e.metaKey)) cmtSubmit?.click();
    });
  });
})();
</script>
</body>
</html>