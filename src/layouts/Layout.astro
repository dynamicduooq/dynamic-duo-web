    <div class="rs-row">
      <span class="rs-label">Font chữ</span>
    </div>
    <div class="rs-btn-group" style="flex-wrap:wrap; justify-content:center; gap:8px; padding:8px; border-radius:12px; margin-bottom: 6px;">
        <button class="rs-btn active" data-font="'Newsreader', serif" title="Newsreader" style="font-family:'Newsreader', serif; padding:4px 8px;">N</button>
        <button class="rs-btn" data-font="'Literata', serif" title="Literata" style="font-family:'Literata', serif; padding:4px 8px;">L</button>
        <button class="rs-btn" data-font="'Merriweather', serif" title="Merriweather" style="font-family:'Merriweather', serif; padding:4px 8px;">M</button>
        <button class="rs-btn" data-font="'Palatino Linotype', serif" title="Palatino" style="font-family:'Palatino Linotype', serif; padding:4px 8px;">P</button>
        <button class="rs-btn" data-font="Arial, sans-serif" title="Arial" style="font-family:Arial, sans-serif; padding:4px 8px;">A</button>
        <button class="rs-btn" data-font="'Segoe UI', sans-serif" title="Segoe UI" style="font-family:'Segoe UI', sans-serif; padding:4px 8px;">S</button>
    </div>
    <p style="font-size:.65rem;color:var(--text-dim);text-align:center;margin:10px 0 0;font-style:italic">💡 Bấm ⬅️ ➡️ trên bàn phím để sang trang</p>
  </div>
)}

{isNovelPage && (
  <div class="rs-popup" id="statsPopup">
    <div class="rs-title" style="color: #10b981;">📊 Thống kê Chương</div>
    <div style="font-size: .8rem; color: var(--text-main); display: flex; flex-direction: column; gap: 10px;">
       <div style="display:flex; justify-content:space-between; border-bottom: 1px dashed rgba(186,230,253,.5); padding-bottom: 6px;"><span>👁 Lượt xem:</span> <strong id="statViews" style="color:var(--sky)">0</strong></div>
       <div style="display:flex; justify-content:space-between; border-bottom: 1px dashed rgba(186,230,253,.5); padding-bottom: 6px;"><span>💬 Bình luận:</span> <strong id="statCmts" style="color:var(--sky)">0</strong></div>
       <div style="display:flex; justify-content:space-between;"><span>❤️ Lượt thích:</span> <strong id="statLikes" style="color:var(--sky)">0</strong></div>
    </div>
    <p style="font-size:.6rem;color:var(--text-dim);text-align:center;margin:12px 0 0;font-style:italic">Cập nhật theo thời gian thực</p>
  </div>
)}

<script is:inline>
/* ══ HELPERS ══ */
function esc(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function timeAgo(ts){
  if(!ts) return ''; const d=Date.now()-ts;
  if(d<60000) return 'vừa xong'; if(d<3600000) return Math.floor(d/60000)+' phút trước';
  if(d<86400000) return Math.floor(d/3600000)+' giờ trước'; return Math.floor(d/86400000)+' ngày trước';
}
function pageKey(){ return location.pathname.replace(/[^a-zA-Z0-9]/g,'_').replace(/^_+|_+$/g,'').substring(0,120); }
function avatarLetter(name){ return (name||'K').trim().charAt(0).toUpperCase(); }
function getMyToken(){ let t = localStorage.getItem('dd_token'); if(!t){ t = Math.random().toString(36).slice(2)+Date.now().toString(36); localStorage.setItem('dd_token',t); } return t; }
function getLiked(id){ try{ return JSON.parse(localStorage.getItem('dd_liked')||'{}')[id]||false; }catch(e){ return false; } }
function setLiked(id,v){ try{ const o=JSON.parse(localStorage.getItem('dd_liked')||'{}'); o[id]=v; localStorage.setItem('dd_liked',JSON.stringify(o)); }catch(e){} }
function getSavedName(){ return localStorage.getItem('dd_commenter_name') || ''; }
function saveName(name){ if(name && name.trim()) localStorage.setItem('dd_commenter_name', name.trim()); }

const ADMIN_DISPLAY_NAME = 'dynamic duo 𓆝';

function waitFirebase(cb){
  if(window.__ddFirebase?.db){ cb(window.__ddFirebase); return; }
  window.addEventListener('dd-firebase-ready',()=>{ if(window.__ddFirebase?.db) cb(window.__ddFirebase); },{once:true});
  let n=0; const t=setInterval(()=>{ if(window.__ddFirebase?.db){clearInterval(t);cb(window.__ddFirebase);} if(++n>60) clearInterval(t); },200);
}

/* ══════════════════════════════════════════
   CHƯƠNG TRÌNH ĐIỀU KHIỂN TỔNG HỢP
   ══════════════════════════════════════════ */
document.addEventListener('DOMContentLoaded', () => {
  const root = document.documentElement;

  // 1. UI: Hamburger, FAB, Progress, Theme
  const mm = document.getElementById('mobileMenu'), hb = document.getElementById('hamburger');
  hb?.addEventListener('click', () => mm?.classList.toggle('open'));
  document.addEventListener('click', e => { if(mm?.classList.contains('open') && !mm.contains(e.target) && !hb?.contains(e.target)) mm.classList.remove('open'); });

  const fabWrap = document.getElementById('toolFabWrap'), fabToggle = document.getElementById('toolFabToggle');
  fabToggle?.addEventListener('click', (e) => { e.stopPropagation(); fabWrap.classList.toggle('open'); });
  document.addEventListener('click', (e) => { if(!fabWrap.contains(e.target)) fabWrap.classList.remove('open'); });
  document.getElementById('fabUp')?.addEventListener('click', () => { window.scrollTo({top:0, behavior:'smooth'}); fabWrap?.classList.remove('open'); });
  document.getElementById('fabDown')?.addEventListener('click', () => { window.scrollTo({top:document.body.scrollHeight, behavior:'smooth'}); fabWrap?.classList.remove('open'); });

  const _rp = document.getElementById('read-progress');
  window.addEventListener('scroll', () => {
    const max = Math.max(1, document.body.scrollHeight - window.innerHeight);
    if(_rp) _rp.style.width = (window.scrollY / max * 100) + '%';
  }, {passive:true});

  const themeBtn = document.getElementById('navThemeBtn'), themeBtnMob = document.getElementById('navThemeBtnMobile');
  function syncThemeBtns(){
    const isDark = root.getAttribute('data-theme')==='dark';
    const icon = isDark ? '☀️' : '🌙';
    document.querySelectorAll('.nav-theme-btn').forEach(el=> el.textContent = icon);
  }
  const toggleTheme = () => {
    const isDark = root.getAttribute('data-theme') === 'dark';
    root.setAttribute('data-theme', isDark ? '' : 'dark');
    localStorage.setItem('dd-theme', isDark ? 'light' : 'dark');
    syncThemeBtns();
  };
  themeBtn?.addEventListener('click', toggleTheme); themeBtnMob?.addEventListener('click', toggleTheme);
  syncThemeBtns();

// 3. AUDIO LOGIC
  const btnPlay = document.getElementById('btnPlayTTS'), btnPause = document.getElementById('btnPauseTTS'), btnStop = document.getElementById('btnStopTTS');
  const btnNext = document.getElementById('btnNextSent'), btnPrev = document.getElementById('btnPrevSent');
  const voiceSelect = document.getElementById('aaVoiceSelect'), rateRange = document.getElementById('aaRateRange'), rateValue = document.getElementById('aaRateValue');
  const content = document.getElementById('novelContent'), aaSettings = document.getElementById('aaSettings');

  if(btnPlay && content && 'speechSynthesis' in window) {
    const synth = window.speechSynthesis;
    let sentences = [];
    let currentIdx = 0;
    let isPaused = false;
    let voices = []; 

    function loadVoices() {
      const allVoices = synth.getVoices();
      if (allVoices.length === 0) return; 

      let vnVoices = allVoices.filter(v => 
        v.lang.toLowerCase().includes('vi') || 
        v.name.toLowerCase().includes('viet')
      );

      if (vnVoices.length === 0) {
        vnVoices = allVoices;
      }

      voices = vnVoices;

      voiceSelect.innerHTML = voices.map((v, i) => 
        `<option value="${i}">${v.name} (${v.lang})</option>`
      ).join('');
    }

    loadVoices();
    
    if(synth.onvoiceschanged !== undefined) {
      synth.onvoiceschanged = loadVoices;
    }

    document.getElementById('btnToggleAudioSet')?.addEventListener('click', () => aaSettings?.classList.toggle('open'));
    if(rateRange) rateRange.oninput = () => { if(rateValue) rateValue.textContent = rateRange.value + 'x'; };

    function resetAudioUI() {
      synth.cancel();
      btnPlay.style.display = 'inline-block'; btnPlay.textContent = '▶ Nghe';
      btnPause.style.display = 'none'; btnStop.style.display = 'none';
      isPaused = false; currentIdx = 0;
    }

    function initSentences() {
      const clone = content.cloneNode(true);
      clone.querySelectorAll('.ic-trigger, .editor-note-box, .tags-container, script, style, .auto-audio-player, .chap-nav-row').forEach(el => el.remove());
      sentences = clone.innerText.split(/[.?!|\n]/).map(s => s.trim()).filter(s => s.length > 1);
    }

    function speakSentence() {
      synth.cancel(); 
      if (currentIdx < 0) currentIdx = 0;
      if (currentIdx >= sentences.length) { resetAudioUI(); return; }
      if (isPaused) return;

      const utter = new SpeechSynthesisUtterance(sentences[currentIdx]);
      utter.rate = parseFloat(rateRange.value || 1);
      
      const selectedIdx = voiceSelect.value;
      if (voices.length > 0 && selectedIdx !== "") {
        utter.voice = voices[selectedIdx];
        utter.lang = utter.voice.lang; 
      } else {
        utter.lang = 'vi-VN'; 
      }

      utter.onend = () => {
        if(!isPaused) {
          currentIdx++;
          speakSentence();
        }
      };
      
      utter.onerror = (e) => {
        if (e.error !== 'interrupted') resetAudioUI();
      };

      synth.speak(utter);
    }

    btnPlay.addEventListener('click', () => {
      if (isPaused) {
        isPaused = false;
      } else {
        initSentences();
        if (sentences.length === 0) return alert("Không tìm thấy nội dung");
        currentIdx = 0;
      }
      speakSentence();
      btnPlay.style.display = 'none'; btnPause.style.display = 'inline-block'; btnStop.style.display = 'inline-block';
    });

    btnPause.addEventListener('click', () => {
      isPaused = true;
      synth.cancel();
      btnPlay.style.display = 'inline-block'; btnPlay.textContent = '▶ Tiếp tục'; btnPause.style.display = 'none';
    });

    btnStop.addEventListener('click', resetAudioUI);

    btnNext?.addEventListener('click', () => {
      if (sentences.length === 0) initSentences(); 
      if (sentences.length > 0) {
        isPaused = false; 
        currentIdx = Math.min(sentences.length - 1, currentIdx + 1);
        speakSentence();
        btnPlay.style.display = 'none'; btnPause.style.display = 'inline-block'; btnStop.style.display = 'inline-block';
      }
    });

    btnPrev?.addEventListener('click', () => {
      if (sentences.length === 0) initSentences();
      if (sentences.length > 0) {
        isPaused = false;
        currentIdx = Math.max(0, currentIdx - 1);
        speakSentence();
        btnPlay.style.display = 'none'; btnPause.style.display = 'inline-block'; btnStop.style.display = 'inline-block';
      }
    });
  }
  // --- LOGIC ĐĂNG NHẬP ADMIN QUA NÚT CHÌA KHÓA ---
  const footerAdminBtn = document.getElementById('footerAdmin');
  if (footerAdminBtn) {
    footerAdminBtn.addEventListener('click', (e) => {
      e.preventDefault();
      waitFirebase(async ({ auth, GoogleAuthProvider, signInWithPopup, signOut }) => {
        if (!auth) return alert('Hệ thống Firebase chưa sẵn sàng. Vui lòng thử lại sau.');
        
        if (window.__ddIsAdmin) {
          if (confirm('Bạn đang đăng nhập với quyền Admin. Bạn có muốn đăng xuất không?')) {
            await signOut(auth);
            alert('Đã đăng xuất thành công.');
            location.reload(); 
          }
        } else {
          try {
            const provider = new GoogleAuthProvider();
            const result = await signInWithPopup(auth, provider);
            
            if (result.user.email === window.__ddFirebase.ADMIN_EMAIL) {
              alert('Chào mừng Admin đã quay trở lại! 🌊');
              location.reload(); 
            } else {
              alert('Cảnh báo: Tài khoản này không có quyền Admin!');
              await signOut(auth); 
            }
          } catch (error) {
            console.error(error);
            if (error.code !== 'auth/popup-closed-by-user') {
              alert('Lỗi đăng nhập: ' + error.message);
            }
          }
        }
      });
    });
  }

  window.addEventListener('dd-auth-change', (e) => {
    const isAdmin = e.detail?.isAdmin;
    if (footerAdminBtn && isAdmin) {
      footerAdminBtn.style.opacity = '1';
      footerAdminBtn.style.color = 'var(--sky)';
      footerAdminBtn.title = "Đăng xuất Admin";
    }
  });

  // 3. DROPDOWNS
  function setupDD(btnId, listId){
    const btn=document.getElementById(btnId), list=document.getElementById(listId);
    if(!btn || !list) return;
    btn.onclick = (e) => { e.stopPropagation(); list.classList.toggle('open'); };
  }
  setupDD('ddBtnTop','ddListTop'); setupDD('ddBtnBot','ddListBot');
  document.addEventListener('click', () => document.querySelectorAll('.chap-dd-list').forEach(el=>el.classList.remove('open')));

  // 4. SETTINGS
  let fz = parseInt(localStorage.getItem('dd_fz') || '18');
  let ff = localStorage.getItem('dd_ff') || "'Newsreader', serif";
  const btnSet = document.getElementById('fabSettings'), popSet = document.getElementById('rsPopup');
  btnSet?.addEventListener('click', e => { e.stopPropagation(); popSet?.classList.toggle('open'); });
  document.getElementById('rsDec')?.addEventListener('click', () => { if(fz > 12) { fz-=1; root.style.setProperty('--read-fz', fz + 'px'); localStorage.setItem('dd_fz', fz); } });
  document.getElementById('rsInc')?.addEventListener('click', () => { if(fz < 30) { fz+=1; root.style.setProperty('--read-fz', fz + 'px'); localStorage.setItem('dd_fz', fz); } });
  popSet?.querySelectorAll('[data-font]').forEach(fb => fb.addEventListener('click', () => {
      ff = fb.dataset.font; root.style.setProperty('--read-ff', ff); localStorage.setItem('dd_ff', ff);
      popSet.querySelectorAll('[data-font]').forEach(b=>b.classList.remove('active')); fb.classList.add('active');
  }));

// --- HỆ THỐNG COMMENT INLINE TỐI ƯU ---
  const novelContent = document.getElementById('novelContent');
  const icSidebar = document.getElementById('icSidebar');
  const layoutWrap = document.getElementById('novelLayoutWrap');
  const icOverlay = document.getElementById('icOverlay');
  const pageId = pageKey(); 
  let allInlineComments = {}; 

  if (novelContent && icSidebar) {
    const paragraphs = novelContent.querySelectorAll('p');
    
    // 1. Gắn bong bóng vào từng đoạn văn
    paragraphs.forEach((p, index) => {
      const btn = document.createElement('button');
      btn.className = 'ic-trigger';
      btn.innerHTML = '<span class="ic-count">0</span>'; 
      btn.setAttribute('data-idx', index);
      p.prepend(btn);

      btn.onclick = (e) => {
        e.stopPropagation();
        document.querySelectorAll('.novel-content p').forEach(el => el.classList.remove('ic-active'));
        p.classList.add('ic-active');
        
        layoutWrap.classList.add('sidebar-open');
        icOverlay.classList.add('show'); // SỬA LỖI 1: Bật Lớp Phủ Overlay
        document.body.style.overflow = 'hidden'; 

        document.getElementById('icParaPreview').innerText = p.innerText.substring(0, 80) + '...';
        document.getElementById('icFormSend').setAttribute('data-current-p', index);
        
        renderSidebarComments(index);
      };
    });

    // 2. Hàm vẽ comment ra Sidebar hỗ trợ REPLY
    function renderSidebarComments(pIdx) {
      const listEl = document.getElementById('icSidebarList');
      const pKey = 'p' + pIdx;
      const pComments = allInlineComments[pKey];
      
      if (!pComments || Object.keys(pComments).length === 0) {
        listEl.innerHTML = '<div class="ic-empty">Đoạn này chưa có bình luận. Hãy là người đầu tiên! 🌊</div>';
        return;
      }

      const myToken = getMyToken();
      const items = Object.entries(pComments).map(([id, v]) => ({ id, ...v })).sort((a, b) => a.ts - b.ts);

      listEl.innerHTML = items.map(item => {
        const canDel = window.__ddIsAdmin || item.token === myToken;
        
        // Tải danh sách Reply
        const repliesData = item.replies || {};
        const replies = Object.entries(repliesData).map(([rid, rv]) => ({id: rid, ...rv})).sort((a,b) => a.ts - b.ts);
        
        const repliesHtml = replies.map(r => {
            const rCanDel = window.__ddIsAdmin || r.token === myToken;
            return `
              <div class="ic-reply-item">
                <div class="ic-reply-body">
                  <div class="ic-reply-name">${esc(r.name||'Khách')} ${r.isAdmin?'<span class="ic-item-admin-badge">chủ nhà</span>':''} <span style="font-size:0.6rem;color:var(--text-dim);font-weight:normal">${timeAgo(r.ts)}</span></div>
                  <div class="ic-reply-text">${esc(r.text)}</div>
                </div>
                ${rCanDel ? `<button class="ic-del-reply-btn" data-cid="${item.id}" data-rid="${r.id}" style="font-size:0.6rem; color:#ef4444; background:none; border:none; cursor:pointer;">✕</button>` : ''}
              </div>
            `;
        }).join('');

        return `
          <div class="ic-item">
            <div class="ic-item-header">
              <span class="ic-item-name">${esc(item.name || 'Khách')} ${item.isAdmin?'<span class="ic-item-admin-badge">chủ nhà</span>':''}</span>
              <span class="ic-item-time">${timeAgo(item.ts)}</span>
            </div>
            <div class="ic-item-text">${esc(item.text)}</div>
            <div style="display:flex; justify-content:space-between; align-items:center;">
               <button class="ic-reply-toggle" data-cid="${item.id}">💬 Trả lời</button>
               ${canDel ? `<button class="ic-del-btn" data-cid="${item.id}">✕ Xóa</button>` : ''}
            </div>
            
            <div class="ic-replies ${replies.length > 0 ? 'open' : ''}">
               ${repliesHtml}
            </div>
            
            <div class="ic-reply-form" id="ic-rf-${item.id}">
               <input class="ic-form-name" id="ic-rn-${item.id}" placeholder="Tên..." value="${esc(getSavedName())}">
               <textarea class="ic-form-text" id="ic-rt-${item.id}" placeholder="Phản hồi..."></textarea>
               <div class="ic-reply-form-row">
                  <button class="ic-rf-cancel" data-cid="${item.id}">Hủy</button>
                  <button class="ic-rf-send" data-cid="${item.id}" data-pidx="${pIdx}">Gửi</button>
               </div>
            </div>
          </div>
        `;
      }).join('');
    }

    // Lắng nghe sự kiện click cho các nút Trả lời / Xóa bên trong Sidebar
    document.getElementById('icSidebarList').onclick = async (e) => {
        const tgt = e.target;
        const pIdx = document.getElementById('icFormSend').getAttribute('data-current-p');
        const pKey = 'p' + pIdx;
        
        // Mở khung trả lời
        if (tgt.classList.contains('ic-reply-toggle')) {
            const form = document.getElementById('ic-rf-' + tgt.dataset.cid);
            if (form) form.style.display = form.style.display === 'flex' ? 'none' : 'flex';
        }
        
        // Nút Hủy Trả lời
        if (tgt.classList.contains('ic-rf-cancel')) {
            const form = document.getElementById('ic-rf-' + tgt.dataset.cid);
            if (form) form.style.display = 'none';
        }
        
        // Nút Gửi Trả lời
        if (tgt.classList.contains('ic-rf-send')) {
            const cid = tgt.dataset.cid;
            const nameInp = document.getElementById('ic-rn-' + cid);
            const textInp = document.getElementById('ic-rt-' + cid);
            const text = textInp.value.trim();
            const name = nameInp.value.trim() || 'Khách';
            
            if (!text) return;
            tgt.disabled = true;
            saveName(name);
            
            waitFirebase(async ({db, ref, push}) => {
                await push(ref(db, `inline_comments/${pageId}/${pKey}/${cid}/replies`), {
                    name, text, ts: Date.now(), token: getMyToken(), isAdmin: window.__ddIsAdmin
                });
            });
        }
        
        // Nút Xóa Bình luận gốc
        if (tgt.classList.contains('ic-del-btn')) {
            if (confirm('Bạn muốn xóa bình luận này? Toàn bộ trả lời bên trong cũng sẽ bị xóa.')) {
                waitFirebase(async ({db, ref, remove}) => {
                    await remove(ref(db, `inline_comments/${pageId}/${pKey}/${tgt.dataset.cid}`));
                });
            }
        }
        
        // Nút Xóa Trả lời
        if (tgt.classList.contains('ic-del-reply-btn')) {
            if (confirm('Bạn muốn xóa phản hồi này?')) {
                waitFirebase(async ({db, ref, remove}) => {
                    await remove(ref(db, `inline_comments/${pageId}/${pKey}/${tgt.dataset.cid}/replies/${tgt.dataset.rid}`));
                });
            }
        }
    };

    function startListeningInline() {
      waitFirebase(({ db, ref, onValue }) => {
        onValue(ref(db, 'inline_comments/' + pageId), (snap) => {
          allInlineComments = snap.val() || {}; 
          
          paragraphs.forEach((p, idx) => {
            const countEl = p.querySelector('.ic-count');
            const trigger = p.querySelector('.ic-trigger');
            const pComments = allInlineComments['p' + idx];
            
            if (countEl && trigger) {
              const count = pComments ? Object.keys(pComments).length : 0;
              countEl.innerText = count;
              
              if (count > 0) {
                trigger.classList.add('has-comments');
              } else {
                trigger.classList.remove('has-comments');
              }
            }
          });
          
          const activeIdx = document.getElementById('icFormSend')?.getAttribute('data-current-p');
          if (activeIdx !== null && activeIdx !== undefined) {
            renderSidebarComments(activeIdx);
          }
        });
      });
    }

    document.getElementById('icFormSend').onclick = async () => {
      const btn = document.getElementById('icFormSend');
      const pIdx = btn.getAttribute('data-current-p');
      const textEl = document.getElementById('icFormText'); 
      const text = textEl.value.trim();
      const name = document.getElementById('icFormName').value.trim() || 'Khách';
      
      if (!text || pIdx === null) return;
      btn.disabled = true;

      waitFirebase(async ({ db, ref, push }) => {
        try {
          await push(ref(db, `inline_comments/${pageId}/p${pIdx}`), {
            name, text, ts: Date.now(), token: getMyToken(), isAdmin: window.__ddIsAdmin
          });
          textEl.value = ''; 
        } catch (e) {
          alert("Lỗi gửi comment: " + e.message);
        } finally {
          btn.disabled = false;
        }
      });
    };
    
    startListeningInline();
  }

  // Đóng sidebar & Overlay
  const closeSidebar = () => {
    layoutWrap.classList.remove('sidebar-open');
    if (icOverlay) icOverlay.classList.remove('show');
    document.body.style.overflow = '';
  };
  
  if (document.getElementById('icSidebarClose')) document.getElementById('icSidebarClose').onclick = closeSidebar;
  if (icOverlay) icOverlay.onclick = closeSidebar;
  
  // Khởi chạy các module khác
  setupChapterLike();
  setupChapComments();
}); 

/* ══ MODULE: LIKE & COMMENTS TRANG (HỖ TRỢ TRẢ LỜI & XÓA) ══ */
function setupChapterLike(){
  const btn = document.getElementById('btnLikeChapter'), countEl = document.getElementById('chapLikeCount');
  if(!btn) return;
  const key = 'chap_' + pageKey(), myToken = getMyToken();
  waitFirebase(({db, ref, onValue, update, remove}) => {
    onValue(ref(db, 'chapter_likes/' + key), snap => {
      const data = snap.val() || {}; countEl.textContent = Object.keys(data).length;
      if(data[myToken]) { btn.classList.add('liked'); btn.querySelector('.heart').textContent = '❤️'; }
      else { btn.classList.remove('liked'); btn.querySelector('.heart').textContent = '🤍'; }
    });
    btn.onclick = async () => {
      const isLiked = btn.classList.contains('liked');
      if(isLiked) await remove(ref(db, `chapter_likes/${key}/${myToken}`));
      else await update(ref(db, `chapter_likes/${key}`), { [myToken]: Date.now() });
    };
  });
}

function setupChapComments(){
  const section = document.getElementById('chapCommentSection');
  if(!section) return;
  const cmtList = document.getElementById('cmtList');
  const cmtName = document.getElementById('cmtName');
  const cmtText = document.getElementById('cmtText');
  const cmtSubmit = document.getElementById('cmtSubmit');
  const key = 'chap_' + pageKey();
  const myToken = getMyToken();
  
  if(cmtName) cmtName.value = getSavedName();

  waitFirebase(({db, ref, push, onValue, remove}) => {
    onValue(ref(db, 'comments/'+key), snap => {
      const data = snap.val();
      if(!data) { cmtList.innerHTML = '<div class="comment-empty">Chưa có bình luận nào 🌊</div>'; return; }
      
      const items = Object.entries(data).map(([id,v]) => ({id,...v})).sort((a,b) => a.ts - b.ts);
      
      cmtList.innerHTML = items.map(c => {
        const canDel = window.__ddIsAdmin || c.token === myToken;
        
        // Parse Replies
        const repliesData = c.replies || {};
        const replies = Object.entries(repliesData).map(([rid, rv]) => ({id: rid, ...rv})).sort((a,b) => a.ts - b.ts);
        
        const repliesHtml = replies.map(r => {
          const rCanDel = window.__ddIsAdmin || r.token === myToken;
          return `
            <div class="reply-item">
              <div class="reply-avatar">${avatarLetter(r.name)}</div>
              <div class="reply-body">
                <div class="reply-name">${esc(r.name||'Khách')} ${r.isAdmin?'<span class="reply-admin-badge">chủ nhà</span>':''} <span class="reply-time">${timeAgo(r.ts)}</span></div>
                <div class="reply-text">${esc(r.text)}</div>
              </div>
              ${rCanDel ? `<button class="reply-del show" data-cid="${c.id}" data-rid="${r.id}">✕</button>` : ''}
            </div>
          `;
        }).join('');

        return `
          <div class="comment-card">
            <div class="comment-card-header">
              <span class="comment-card-name">${esc(c.name)||'Khách'} ${c.isAdmin?'<span class="comment-admin-badge">chủ nhà</span>':''}</span>
              <span class="comment-card-time">${timeAgo(c.ts)}</span>
            </div>
            <p class="comment-card-text">${esc(c.text)}</p>
            
            <div class="comment-card-actions">
              <button class="cmt-reply-btn" data-cid="${c.id}">💬 Trả lời</button>
              ${canDel ? `<button class="cmt-del-btn show" data-cid="${c.id}">🗑 Xóa</button>` : ''}
            </div>
            
            <div class="reply-thread ${replies.length > 0 ? 'open' : ''}">
              ${repliesHtml}
            </div>
            
            <div class="reply-form" id="rf-${c.id}">
              <input class="reply-inp" id="rn-${c.id}" placeholder="Tên của bạn..." value="${esc(getSavedName())}">
              <textarea class="reply-inp-text" id="rt-${c.id}" placeholder="Viết phản hồi..."></textarea>
              <div class="reply-form-btns">
                <button class="reply-cancel-btn" data-cid="${c.id}">Hủy</button>
                <button class="reply-send-btn" data-cid="${c.id}">Gửi</button>
              </div>
            </div>
          </div>
        `;
      }).join('');
    });
    
    // Bắt các sự kiện click bên trong danh sách comment
    cmtList.onclick = async (e) => {
       const tgt = e.target;
       
       // Mở khung trả lời
       if(tgt.classList.contains('cmt-reply-btn')) {
         const form = document.getElementById('rf-' + tgt.dataset.cid);
         if(form) form.classList.toggle('open');
       }
       
       // Hủy trả lời
       if(tgt.classList.contains('reply-cancel-btn')) {
         const form = document.getElementById('rf-' + tgt.dataset.cid);
         if(form) form.classList.remove('open');
       }
       
       // Gửi trả lời
       if(tgt.classList.contains('reply-send-btn')) {
         const cid = tgt.dataset.cid;
         const nameInput = document.getElementById('rn-' + cid);
         const textInput = document.getElementById('rt-' + cid);
         const text = textInput.value.trim();
         const name = nameInput.value.trim() || 'Khách';
         
         if(!text) return;
         tgt.disabled = true;
         saveName(name);
         
         await push(ref(db, `comments/${key}/${cid}/replies`), {
           name, text, ts: Date.now(), token: myToken, isAdmin: window.__ddIsAdmin
         });
         
         textInput.value = '';
         tgt.disabled = false;
       }
       
       // Xóa Comment cha
       if(tgt.classList.contains('cmt-del-btn')) {
         if(confirm('Bạn muốn xóa bình luận này? Các phản hồi bên trong cũng sẽ biến mất.')) {
           await remove(ref(db, `comments/${key}/${tgt.dataset.cid}`));
         }
       }
       
       // Xóa Reply con
       if(tgt.classList.contains('reply-del')) {
         if(confirm('Bạn muốn xóa phản hồi này?')) {
           await remove(ref(db, `comments/${key}/${tgt.dataset.cid}/replies/${tgt.dataset.rid}`));
         }
       }
    };

    cmtSubmit.onclick = async () => {
      const text = cmtText.value.trim(), name = cmtName.value.trim() || 'Khách';
      if(!text) return; cmtSubmit.disabled = true; saveName(name);
      await push(ref(db, 'comments/'+key), { name, text, ts: Date.now(), token: myToken, isAdmin: window.__ddIsAdmin });
      cmtText.value = ''; cmtSubmit.disabled = false;
    };
  });
}
</script>
</body>
