  authDomain: "dynamic-duo-comments.firebaseapp.com",
  projectId: "dynamic-duo-comments",
  storageBucket: "dynamic-duo-comments.firebasestorage.app",
  messagingSenderId: "948025586876",
  appId: "1:948025586876:web:848f38701acfdb9b844cb9",
  measurementId: "G-9SJG2YV1LL"
};    

    let db = null;
    try {
      const app = initializeApp(firebaseConfig);
      db = getDatabase(app);
    } catch(e) {
