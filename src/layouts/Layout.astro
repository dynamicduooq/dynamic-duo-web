---
const { frontmatter } = Astro.props;
import settings from '../data/settings.json';

const currentPath = Astro.url?.pathname ?? '';
let currentTruyenId = frontmatter?.truyen_id;

const allPosts = Object.values(import.meta.glob('../pages/**/*.md', { eager: true }));
let chapters = [];
if (currentTruyenId) {
    chapters = allPosts
        .filter(post => {
            const postFileName = (post.url || '').split('/').pop() || '';
            const postTruyenId = post.frontmatter?.truyen_id || (postFileName.includes('-') ? postFileName.split('-')[0] : null);
            return postTruyenId === currentTruyenId;
        })
        .sort((a, b) => {
            const parseChapter = (post) => {
                if (post.frontmatter?.chuong !== undefined) return post.frontmatter.chuong;
                const match = (post.url || '').match(/chuong-(\d+)/i);
                return match ? parseInt(match[1]) : (post.url?.includes('index') ? 0 : 999);
            };
            return parseChapter(a) - parseChapter(b);
        });
}

// Trang chương truyện = có trường chuong trong frontmatter
const isNovelPage = frontmatter?.chuong !== undefined;
---

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{frontmatter?.title || 'Trang chủ'} | {settings.site_name}</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,600;1,6..72,300;1,6..72,400&family=Literata:ital,opsz,wght@0,7..72,300;0,7..72,400;0,7..72,600;1,7..72,300;1,7..72,400&family=Merriweather:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet">
    
    <style is:global>
        :root {
            --sky: #0ea5e9;
            --sky2: #0284c7;
            --sky-dark: #0369a1;
            --sky-light: #bae6fd;
            --sky-pale: #f0f9ff;
            --cream: #fafcff;
            --bg-content: #ffffff;
            --text-main: #334155;
            --text-mid: #64748b;
            --text-dim: #94a3b8;
            --sh-card: 0 4px 15px rgba(2,132,199,0.12);
            --sh-soft: 0 2px 8px rgba(0,0,0,0.08);
            --r-sm: 6px;
            --r-md: 12px;
            --r-lg: 16px;
            --r-pill: 999px;
            --t: all 0.2s ease;
        }

        *, *::before, *::after { box-sizing: border-box; }

        html, body {
            margin: 0; padding: 0;
            width: 100%;
            overflow-x: hidden;
        }

        body {
            background: var(--cream);
            color: var(--text-main);
            font-family: 'Newsreader', serif;
            font-size: 18px;
            line-height: 1.9;
        }

        h1, h2, h3, h4 { font-family: 'Merriweather', serif; color: var(--sky-dark); text-align: center; }
        a { color: inherit; text-decoration: none; }
        
        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: var(--sky-pale); }
        ::-webkit-scrollbar-thumb { background: var(--sky-light); border-radius: 3px; }

        /* ─── NAVBAR ─── */
        nav {
            position: fixed; top: 0; left: 0; right: 0; z-index: 500;
            display: flex; align-items: center; justify-content: space-between;
            height: 56px; padding: 0 32px;
            background: rgba(255,255,255,.96); backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(186,230,253,.5);
            box-shadow: 0 2px 12px rgba(2,132,199,.08);
        }
        .nav-logo {
            font-family: 'Literata', serif; font-weight: 600; font-size: .95rem;
            color: var(--sky-dark); white-space: nowrap; letter-spacing: .5px;
        }
        .nav-links { display: flex; align-items: center; gap: 2px; }
        
        .nav-item { position: relative; }
        .nav-item > a, .nav-btn {
            font-family: 'Newsreader', serif; font-size: .76rem; font-weight: 400;
            color: var(--text-mid); letter-spacing: 1px; text-transform: uppercase;
            padding: 6px 12px; border-radius: var(--r-pill);
            display: inline-flex; align-items: center; gap: 5px;
            transition: var(--t); cursor: pointer; background: none; border: none; white-space: nowrap;
        }
        .nav-item > a:hover, .nav-btn:hover,
        .nav-item:hover > a, .nav-item:hover > .nav-btn {
            background: var(--sky-pale); color: var(--sky);
        }

        .dropdown-content {
            position: absolute; top: calc(100% + 8px); left: 50%;
            transform: translateX(-50%) translateY(8px);
            min-width: 230px; background: #fff;
            border: 1px solid rgba(186,230,253,.7); border-radius: var(--r-md);
            box-shadow: 0 16px 48px rgba(2,132,199,.13), 0 2px 8px rgba(2,132,199,.06);
            padding: 8px 6px;
            opacity: 0; visibility: hidden; pointer-events: none;
            transition: opacity .22s ease, transform .22s ease; z-index: 600;
        }
        .nav-item:hover .dropdown-content {
            opacity: 1; visibility: visible; pointer-events: auto;
            transform: translateX(-50%) translateY(0);
        }
        .dd-section-title { font-size: .62rem; letter-spacing: 2px; text-transform: uppercase; color: var(--text-dim); padding: 6px 12px 3px; }
        .dd-item { display: flex; align-items: center; gap: 7px; padding: 7px 12px; font-size: .82rem; color: var(--text-mid); border-radius: var(--r-sm); transition: var(--t); }
        .dd-item:hover { background: var(--sky-pale); color: var(--sky); }
        .dd-divider { height: 1px; background: rgba(186,230,253,.45); margin: 5px 8px; }

        /* ─── LAYOUT CHÍNH - full width ─── */
        .site-body {
            margin-top: 56px;
            min-height: calc(100vh - 56px);
            width: 100%;
        }

        /* Layout khi ĐỌC TRUYỆN: bài viết + comment sidebar */
        .novel-layout {
            display: grid;
            grid-template-columns: 1fr 320px;
            gap: 0;
            max-width: 1400px;
            margin: 0 auto;
            padding: 32px 24px 60px;
            align-items: start;
        }

        /* Layout trang bình thường: full width với max-width cân đối */
        .page-layout {
            max-width: 880px;
            margin: 0 auto;
            padding: 32px 24px 60px;
        }

        /* ─── KHUNG NỘI DUNG ─── */
        .container {
            background: rgba(255,255,255,0.98);
            padding: 40px 50px;
            border-radius: var(--r-lg);
            box-shadow: var(--sh-soft);
            border: 1px solid rgba(186,230,253,.5);
        }

        /* ─── COMMENT SIDEBAR (chỉ trang truyện) ─── */
        .comment-sidebar {
            position: sticky;
            top: 72px;
            max-height: calc(100vh - 90px);
            overflow-y: auto;
            padding: 20px 16px;
            background: rgba(255,255,255,0.95);
            border-radius: var(--r-lg);
            border: 1px solid rgba(186,230,253,.5);
            box-shadow: var(--sh-soft);
            margin-left: 20px;
        }

        .comment-sidebar h3 {
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--text-dim);
            margin: 0 0 14px;
            text-align: center;
        }

        .comment-sidebar::-webkit-scrollbar { width: 3px; }
        .comment-sidebar::-webkit-scrollbar-thumb { background: var(--sky-light); border-radius: 3px; }

        /* ─── MARKDOWN STYLES ─── */
        blockquote {
            font-style: italic; font-size: .9rem; color: var(--text-mid); line-height: 1.75;
            border-left: 3px solid var(--sky-light); padding: 15px 20px;
            margin: 20px 0; background: var(--sky-pale); border-radius: 0 12px 12px 0;
        }
        hr { border: none; text-align: center; margin: 40px 0; }
        hr::after { content: "𓆝 𓆟 𓆞 𓆝 𓆟"; color: var(--sky-light); font-size: 20px; letter-spacing: 5px; }

        /* ─── TAGS ─── */
        .tag-badge {
            display: inline-block; padding: 4px 12px;
            border: 1.5px solid var(--sky); border-radius: var(--r-pill);
            font-size: 0.85rem; margin: 4px; color: var(--sky); transition: var(--t);
        }
        .tag-badge:hover { background: var(--sky-pale); }

        /* ─── DROPDOWN CHƯƠNG ─── */
        .chapter-dropdown summary {
            display: block; padding: 12px 20px;
            background: var(--sky-pale); border: 1.5px solid var(--sky-light);
            border-radius: var(--r-pill); color: var(--sky-dark);
            font-size: 14px; font-weight: bold; cursor: pointer;
            max-width: 200px; margin: 0 auto; text-align: center;
            list-style: none; transition: var(--t);
        }
        .chapter-dropdown summary:hover { background: var(--sky-light); color: white; }
        .chapter-dropdown { position: relative; display: inline-block; }
        .chapter-list {
            position: absolute; top: 115%; left: 50%; transform: translateX(-50%);
            width: 250px; max-height: 250px; overflow: auto;
            background: var(--bg-content); border: 1px solid var(--sky-light);
            border-radius: var(--r-md); display: flex; flex-direction: column;
            z-index: 10; box-shadow: var(--sh-card);
        }
        .chapter-list a {
            padding: 12px 10px; border-bottom: 1px dashed var(--sky-pale);
            color: var(--text-mid); text-align: center; font-size: 14px; transition: var(--t);
        }
        .chapter-list a:hover { background: var(--sky-pale); color: var(--sky); }

        /* ─── ĐIỀU HƯỚNG CHƯƠNG ─── */
        .chapter-nav {
            display: flex; justify-content: space-between; align-items: center;
            gap: 16px; margin-top: 40px; padding-top: 24px;
            border-top: 1px dashed var(--sky-light);
        }
        .chapter-nav a {
            padding: 8px 18px; border: 1.5px solid var(--sky-light);
            border-radius: var(--r-pill); font-size: 0.82rem; color: var(--sky-dark);
            transition: var(--t); background: var(--sky-pale);
        }
        .chapter-nav a:hover { background: var(--sky-light); color: white; }

        /* ─── FOOTER ─── */
        footer {
            background: #fff; border-top: 1px solid rgba(186,230,253,.4);
            padding: 44px 32px 26px; margin-top: auto; width: 100%;
        }
        .footer-inner {
            max-width: 1200px; margin: 0 auto;
            display: grid; grid-template-columns: 1fr auto 1fr;
            gap: 28px; align-items: start;
        }
        .ft-brand .ft-logo { font-family: 'Literata', serif; font-size: 1.15rem; font-weight: 600; color: var(--sky-dark); display: block; margin-bottom: 5px; }
        .ft-brand p { font-size: .78rem; color: var(--text-dim); font-style: italic; }
        .ft-links { display: flex; flex-direction: column; gap: 7px; align-items: center; }
        .ft-links a { font-size: .76rem; color: var(--text-mid); letter-spacing: 1px; text-transform: uppercase; transition: var(--t); }
        .ft-links a:hover { color: var(--sky); }
        .ft-social { display: flex; flex-direction: column; gap: 7px; align-items: flex-end; }
        .social-ic {
            width: 34px; height: 34px; border-radius: 50%;
            border: 1px solid var(--sky-light); display: flex; align-items: center; justify-content: center;
            font-size: .88rem; color: var(--sky); background: var(--sky-pale); transition: var(--t);
        }
        .social-ic:hover { background: var(--sky-light); transform: translateY(-2px); }
        .ft-bottom {
            max-width: 1200px; margin: 26px auto 0; padding-top: 16px;
            border-top: 1px solid rgba(186,230,253,.3);
            text-align: center; font-size: .7rem; color: var(--text-dim); letter-spacing: 1px;
        }

        /* ─── NÚT CUỘN (lên đầu & xuống cuối) ─── */
        .scroll-btns {
            position: fixed; bottom: 24px; right: 22px; z-index: 300;
            display: flex; flex-direction: column; gap: 8px;
        }
        .scroll-btn {
            width: 40px; height: 40px; border-radius: 50%;
            background: var(--sky); color: #fff; border: none; cursor: pointer;
            font-size: 1rem; box-shadow: var(--sh-card);
            opacity: 0; pointer-events: none; transition: var(--t);
            display: flex; align-items: center; justify-content: center;
        }
        .scroll-btn.show { opacity: 1; pointer-events: auto; }
        .scroll-btn:hover { transform: translateY(-3px); background: var(--sky2); }

        /* luôn hiện nút xuống cuối (khi chưa ở cuối trang) */
        .scroll-btn-down { opacity: 1 !important; pointer-events: auto !important; }
        .scroll-btn-down.hide { opacity: 0 !important; pointer-events: none !important; }
    </style>
</head>
<body>
    <nav id="navbar">
        <a class="nav-logo" href="/dynamic-duo-web/">dynamic duo 𓆝.°•</a>
        
        <div class="nav-links">
            <div class="nav-item">
                <a href="/dynamic-duo-web/">Trang chủ</a>
            </div>
            
            <div class="nav-item">
                <button class="nav-btn">Cá dưới nước <span>▾</span></button>
                <div class="dropdown-content">
                    <div class="dd-section-title">Trang mục</div>
                    <a href="/dynamic-duo-web/ca-duoi-nuoc" class="dd-item">🐠 Tất cả truyện</a>
                    <div class="dd-divider"></div>
                    <div class="dd-section-title">Truyện</div>
                    <a href="/dynamic-duo-web/ca-duoi-nuoc/quan-he-ban-cung-phong" class="dd-item">✦ Quan hệ bạn cùng phòng</a>
                    <a href="/dynamic-duo-web/ca-duoi-nuoc/ha-chay-dong-hoang" class="dd-item">✦ Hạ cháy đồng hoang</a>
                </div>
            </div>
            
            <div class="nav-item">
                <button class="nav-btn">Cá trên bàn <span>▾</span></button>
                <div class="dropdown-content">
                    <div class="dd-section-title">Trang mục</div>
                    <a href="/dynamic-duo-web/ca-tren-ban" class="dd-item">🍽️ Tất cả truyện</a>
                    <div class="dd-divider"></div>
                    <div class="dd-section-title">Truyện</div>
                    <a href="/dynamic-duo-web/ca-tren-ban/neu-dem-nay-troi-khong-mua" class="dd-item">✦ Nếu đêm nay trời không mưa</a>
                    <a href="/dynamic-duo-web/ca-tren-ban/toi-nghi-chung-toi-sap-chia-tay" class="dd-item">✦ Tôi nghĩ chúng tôi sắp chia tay</a>
                </div>
            </div>
            
            <div class="nav-item">
                <a href="/dynamic-duo-web/ca-tren-troi">Cá trên trời</a>
            </div>
        </div>
    </nav>

    <div class="site-body">
        {isNovelPage ? (
            <div class="novel-layout">
                <!-- CỘT TRÁI: Nội dung truyện -->
                <div>
                    <div class="container">
                        {frontmatter?.tags && (
                            <div style="text-align: center; margin-bottom: 25px;">
                                {frontmatter.tags.map(tag => (
                                    <a href={`/dynamic-duo-web/tags/${tag}`} class="tag-badge"># {tag}</a>
                                ))}
                            </div>
                        )}

                        {chapters.length > 0 && (
                            <div style="text-align: center; margin-bottom: 30px; position: relative;">
                                <details class="chapter-dropdown">
                                    <summary>⚓ Chọn chương ▾</summary>
                                    <div class="chapter-list">
                                        {chapters.map((chap) => (
                                            <a href={chap.url}>{chap.frontmatter.title}</a>
                                        ))}
                                    </div>
                                </details>
                            </div>
                        )}

                        <slot />

                        {chapters.length > 0 && (
                            <div style="text-align: center; margin-top: 40px; position: relative;">
                                <details class="chapter-dropdown">
                                    <summary>⚓ Chọn chương ▾</summary>
                                    <div class="chapter-list">
                                        {chapters.map((chap) => (
                                            <a href={chap.url}>{chap.frontmatter.title}</a>
                                        ))}
                                    </div>
                                </details>
                            </div>
                        )}

                        {/* Điều hướng chương trước/sau */}
                        {(() => {
                            const idx = chapters.findIndex(c => c.url === currentPath);
                            const prev = chapters[idx - 1];
                            const next = chapters[idx + 1];
                            return (prev || next) && (
                                <div class="chapter-nav">
                                    {prev
                                        ? <a href={prev.url}>← {prev.frontmatter.title}</a>
                                        : <span></span>
                                    }
                                    {next
                                        ? <a href={next.url}>{next.frontmatter.title} →</a>
                                        : <span></span>
                                    }
                                </div>
                            );
                        })()}
                    </div>
                </div>

                <!-- CỘT PHẢI: Comment sidebar - CHỈ hiện ở trang truyện -->
                <div class="comment-sidebar">
                    <h3>💬 Bình luận</h3>
                    <script src="https://giscus.app/client.js"
                            data-repo="dynamicduooq/dynamic-duo-web"
                            data-repo-id="R_kgDOSn8PYg"
                            data-category="Announcements"
                            data-category-id="DIC_kwDOSn8PYs4C923K"
                            data-mapping="pathname"
                            data-strict="0"
                            data-reactions-enabled="1"
                            data-emit-metadata="0"
                            data-input-position="bottom"
                            data-theme="light"
                            data-lang="vi"
                            crossorigin="anonymous"
                            async>
                    </script>
                </div>
            </div>
        ) : (
            <!-- TRANG BÌNH THƯỜNG: không có comment -->
            <div class="page-layout">
                <div class="container">
                    {frontmatter?.tags && (
                        <div style="text-align: center; margin-bottom: 25px;">
                            {frontmatter.tags.map(tag => (
                                <a href={`/dynamic-duo-web/tags/${tag}`} class="tag-badge"># {tag}</a>
                            ))}
                        </div>
                    )}
                    <slot />
                </div>
            </div>
        )}
    </div>

    <footer>
        <div class="footer-inner">
            <div class="ft-brand">
                <span class="ft-logo">dynamic duo 𓆝.°•</span>
                <p>paired dreams, boundless gleam.</p>
                <p style="margin-top:5px;font-size:.74rem">✉ dynamicduoq@gmail.com</p>
            </div>
            <div class="ft-links">
                <a href="/dynamic-duo-web/">Trang chủ</a>
                <a href="/dynamic-duo-web/ca-duoi-nuoc">Cá dưới nước</a>
                <a href="/dynamic-duo-web/ca-tren-ban">Cá trên bàn</a>
            </div>
            <div class="ft-social">
                <p style="font-size:.68rem;color:var(--text-dim);letter-spacing:1px;text-transform:uppercase;margin-bottom:6px">Ghé thăm</p>
                <div>
                    <a href="https://dynamicduoq.wordpress.com" target="_blank" class="social-ic" title="WordPress">🌐</a>
                </div>
            </div>
        </div>
        <div class="ft-bottom">dynamic duo 𓆝.°• · made with 🌊 by Xê &amp; Gờ · 2026</div>
    </footer>

    <!-- Nút cuộn: lên đầu + xuống cuối -->
    <div class="scroll-btns">
        <button class="scroll-btn" id="btnTop" title="Lên đầu trang" onclick="window.scrollTo({top:0,behavior:'smooth'})">↑</button>
        <button class="scroll-btn scroll-btn-down" id="btnBottom" title="Xuống cuối trang" onclick="window.scrollTo({top:document.body.scrollHeight,behavior:'smooth'})">↓</button>
    </div>

    <script is:inline>
        const btnTop = document.getElementById('btnTop');
        const btnBottom = document.getElementById('btnBottom');

        function updateScrollBtns() {
            const scrollY = window.scrollY;
            const maxScroll = document.body.scrollHeight - window.innerHeight;

            // Nút LÊN ĐẦU: hiện khi cuộn xuống > 300px
            btnTop.classList.toggle('show', scrollY > 300);

            // Nút XUỐNG CUỐI: ẩn khi đã ở gần cuối trang (< 100px từ đáy)
            btnBottom.classList.toggle('hide', scrollY > maxScroll - 100);
        }

        window.addEventListener('scroll', updateScrollBtns, { passive: true });
        updateScrollBtns(); // chạy lần đầu
    </script>
</body>
</html>