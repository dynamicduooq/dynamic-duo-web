/* --- BONG BÓNG BÌNH LUẬN 3D GLASS --- */
.ic-trigger {
  position: absolute;
  left: -38px;          /* Đẩy ra lề trái, không chiếm chỗ của chữ */
  top: 6px;
  width: 24px;
  height: 20px;
  background: rgba(14, 165, 233, 0.15); /* Màu xanh trong suốt */
  backdrop-filter: blur(4px);           /* Kính mờ */
  -webkit-backdrop-filter: blur(4px);
  border: 1px solid rgba(14, 165, 233, 0.3);
  border-radius: 6px 6px 6px 2px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  transition: all 0.3s ease;
  box-shadow: 0 2px 5px rgba(2, 132, 199, 0.1), inset 0 1px 1px rgba(255,255,255,0.4);
  opacity: 0.1; /* Mờ đi khi không dùng */
}

/* Đuôi nhọn bong bóng */
.ic-trigger::after {
  content: "";
  position: absolute;
  bottom: -4px;
  left: 0;
  border-left: 4px solid rgba(14, 165, 233, 0.3);
  border-bottom: 4px solid transparent;
}

/* Số bên trong */
.ic-count {
  font-family: sans-serif;
  font-size: 9px;
  font-weight: 800;
  color: var(--sky-dark);
  pointer-events: none;
}

/* Hiện rõ khi có người bình luận hoặc rê chuột vào đoạn văn */
.novel-content p:hover .ic-trigger,
.ic-trigger.has-comments {
  opacity: 1;
  background: rgba(14, 165, 233, 0.25);
  border-color: var(--sky);
}

.ic-trigger:hover {
  transform: scale(1.2) translateY(-2px);
  background: var(--sky) !important;
}

.ic-trigger:hover .ic-count { color: #fff; }

/* Dark Mode Fix */
[data-theme="dark"] .ic-trigger {
  background: rgba(126, 200, 227, 0.1);
  border-color: rgba(126, 200, 227, 0.2);
}
[data-theme="dark"] .ic-count { color: #a8daf0; }

/* Responsive cho Mobile: Fix lệch chữ và bong bóng */
@media (max-width: 640px) {
  .ic-trigger { 
    left: -10px; /* Đặt lấn một chút ra lề trái của trang để không bị ép vào chữ */
    opacity: 0.5; 
    transform: scale(0.85); /* Thu nhỏ bong bóng lại */
  } 
  .novel-content p:hover .ic-trigger, .ic-trigger.has-comments {
    transform: scale(0.85); /* Giữ tỷ lệ nhỏ khi hiện rõ */
  }
  .ic-trigger:hover {
    transform: scale(1) translateY(-2px); 
  }
}

/* 1. Lớp phủ Overlay */
.ic-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5); /* Màu đen mờ */
  backdrop-filter: blur(2px);    /* Làm mờ nhẹ hậu cảnh */
  z-index: 998;                  /* Nằm sát dưới Sidebar */
  display: none;
  opacity: 0;
  transition: opacity 0.3s ease;
}

/* Hiện overlay khi mở sidebar */
.ic-overlay.show {
  display: block;
  opacity: 1;
}

/* 2. Sidebar được ưu tiên nằm trên cùng */
