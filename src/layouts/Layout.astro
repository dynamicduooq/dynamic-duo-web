    <!-- ── SCROLL BUTTONS (luôn hiển thị đúng) ── -->
    <div class="scroll-btns">
        <button class="scroll-btn" id="btnTop" title="Lên đầu trang">↑</button>
        <button class="scroll-btn" id="btnBot" title="Xuống cuối trang">↓</button>
    </div>

    <script is:inline>
    // ── SCROLL BUTTONS ──
    // Dùng requestAnimationFrame để đảm bảo luôn hoạt động
    (function() {
        var btnTop = document.getElementById('btnTop');
        var btnBot = document.getElementById('btnBot');
        if (!btnTop || !btnBot) return;

        function getScrollMax() {
            return Math.max(
                document.body.scrollHeight,
                document.documentElement.scrollHeight
            ) - window.innerHeight;
        }

        function updateButtons() {
            var y = window.scrollY || window.pageYOffset;
            var max = getScrollMax();
            // Nút lên: hiện khi cuộn xuống > 200px
            if (y > 200) {
                btnTop.classList.add('show');
            } else {
                btnTop.classList.remove('show');
            }
            // Nút xuống: hiện khi chưa đến cuối (còn > 200px)
            if (max - y > 200) {
                btnBot.classList.add('show');
            } else {
                btnBot.classList.remove('show');
            }
        }

        btnTop.addEventListener('click', function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
        btnBot.addEventListener('click', function() {
            window.scrollTo({ top: getScrollMax() + 200, behavior: 'smooth' });
        });

        // Lắng nghe cả scroll và resize
        window.addEventListener('scroll', updateButtons, { passive: true });
        window.addEventListener('resize', updateButtons, { passive: true });
        // Chạy lần đầu sau khi trang load xong hoàn toàn
        updateButtons();
        setTimeout(updateButtons, 500);
    })();
    </script>

    <script is:inline>
    // ── INLINE COMMENT POPUP ──
    (function() {
        var STORE_KEY = 'dd_inline_comments';

        function loadAll() {
            try { return JSON.parse(localStorage.getItem(STORE_KEY) || '{}'); } catch(e) { return {}; }
        }
        function saveAll(data) {
            try { localStorage.setItem(STORE_KEY, JSON.stringify(data)); } catch(e) {}
        }

        function escHtml(str) {
            return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        function renderList(paraId) {
            var all = loadAll();
            var comments = all[paraId] || [];
            if (comments.length === 0) return '<div class="ic-empty">Chưa có bình luận nào ✦</div>';
            return comments.map(function(c) {
                return '<div class="ic-comment-item"><span class="ic-name">' + escHtml(c.name) + '</span>: ' + escHtml(c.text) + '</div>';
            }).join('');
        }

        function closeAllPopups() {
            document.querySelectorAll('.ic-popup').forEach(function(p) { p.remove(); });
        }

        function openPopup(paraId, btn) {
            closeAllPopups();

            var popup = document.createElement('div');
            popup.className = 'ic-popup open';
            popup.innerHTML =
                '<div class="ic-popup-header">💬 Bình luận đoạn này</div>' +
                '<div class="ic-comment-list" id="icList-' + paraId + '">' + renderList(paraId) + '</div>' +
                '<div class="ic-name-row"><input type="text" id="icName-' + paraId + '" placeholder="Tên (để trống = Ẩn danh)" maxlength="30" /></div>' +
                '<div class="ic-input-row">' +
                  '<input type="text" id="icText-' + paraId + '" placeholder="Nhập bình luận..." maxlength="200" />' +
                  '<button id="icSend-' + paraId + '">Gửi</button>' +
                '</div>';

            document.body.appendChild(popup);

            // Tính vị trí
            var rect = btn.getBoundingClientRect();
            var scrollTop = window.scrollY || document.documentElement.scrollTop;
            var left = Math.max(8, Math.min(rect.left, window.innerWidth - 310));
            popup.style.position = 'absolute';
            popup.style.top = (rect.bottom + scrollTop + 8) + 'px';
            popup.style.left = left + 'px';

            // Gửi comment
            function doSend() {
                var nameEl = document.getElementById('icName-' + paraId);
                var textEl = document.getElementById('icText-' + paraId);
                var name = (nameEl.value.trim() || 'Ẩn danh 𓆝');
                var text = textEl.value.trim();
                if (!text) return;
                var all = loadAll();
                if (!all[paraId]) all[paraId] = [];
                all[paraId].push({ name: name, text: text, ts: Date.now() });
                saveAll(all);
                textEl.value = '';
                document.getElementById('icList-' + paraId).innerHTML = renderList(paraId);
            }

            document.getElementById('icSend-' + paraId).addEventListener('click', doSend);
            document.getElementById('icText-' + paraId).addEventListener('keydown', function(e) {
                if (e.key === 'Enter') doSend();
            });

            // Đóng khi click ngoài
            setTimeout(function() {
                function outsideHandler(e) {
                    if (!popup.contains(e.target) && e.target !== btn) {
                        popup.remove();
                        document.removeEventListener('click', outsideHandler);
                    }
                }
                document.addEventListener('click', outsideHandler);
            }, 150);
        }

        function injectButtons() {
            var container = document.querySelector('.container');
            if (!container) return;
            var paras = container.querySelectorAll('p');
            paras.forEach(function(p, i) {
                if (p.querySelector('.ic-btn')) return;
                var id = 'ic-p-' + i;
                var btn = document.createElement('button');
                btn.className = 'ic-btn';
                btn.title = 'Bình luận đoạn này';
                btn.setAttribute('aria-label', 'Bình luận đoạn này');
                btn.textContent = '+';
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    openPopup(id, btn);
                });
                p.appendChild(btn);
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', injectButtons);
        } else {
            injectButtons();
        }
    })();
    </script>

</body>
</html>