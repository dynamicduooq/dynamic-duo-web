  syncActiveButton('.ff-btn', 'dd_ff', "'Newsreader', serif");
  syncActiveButton('.fw-btn', 'dd_fw', "400");
  syncActiveButton('.lh-btn', 'dd_lh', "1.9");
  syncActiveButton('.theme-btn', 'dd_read_theme', "light");

  function setupDD(btnId, listId){
    const btn=document.getElementById(btnId), list=document.getElementById(listId);
    if(!btn || !list) return;
    btn.onclick = (e) => { e.stopPropagation(); list.classList.toggle('open'); };
  }
  setupDD('ddBtnTop','ddListTop'); setupDD('ddBotBtn','ddListBot');

  const novelContent = document.getElementById('novelContent');
  const icSidebar = document.getElementById('icSidebar');
  const layoutWrap = document.getElementById('novelLayoutWrap');
  const icOverlay = document.getElementById('icOverlay');
  const pageId = pageKey(); 
  let allInlineComments = {}; 
  
  function autoCleanupInline(data, maxItems = 500) {
      if(!data) return;
      waitFirebase(({db, ref, remove}) => {
          Object.keys(data).forEach(pKey => {
              const pComments = data[pKey];
              const keys = Object.keys(pComments);
              if (keys.length > maxItems) {
                  const sorted = keys.sort((a,b) => pComments[a].ts - pComments[b].ts);
                  const toDelete = sorted.slice(0, keys.length - maxItems);
                  toDelete.forEach(k => remove(ref(db, `inline_comments/${pageId}/${pKey}/${k}`)));
              }
          });
      });
  }

  if (novelContent && icSidebar) {
    const paragraphs = novelContent.querySelectorAll('p');
    
    paragraphs.forEach((p, index) => {
      const btn = document.createElement('button');
      btn.className = 'ic-trigger';
      btn.innerHTML = '<span class="ic-count">0</span>'; 
      btn.setAttribute('data-idx', index);
      p.prepend(btn);

      p.onclick = (e) => {
         if (window.innerWidth <= 640) {
            document.querySelectorAll('.novel-content p').forEach(el => el.classList.remove('show-mobile-bubble'));
            p.classList.add('show-mobile-bubble');
         }
      };

      btn.onclick = (e) => {
        e.stopPropagation();
        document.querySelectorAll('.novel-content p').forEach(el => el.classList.remove('ic-active'));
        p.classList.add('ic-active');
        
        layoutWrap.classList.add('sidebar-open');
        icOverlay.classList.add('show'); 
        document.body.style.overflow = 'hidden'; 

        document.getElementById('icParaPreview').innerText = p.innerText.substring(0, 80) + '...';
        document.getElementById('icFormSend').setAttribute('data-current-p', index);
        
        renderSidebarComments(index);
      };
    });

    function renderThreadHtml(repliesFlat, parentId, level, rootCid) {
        const children = repliesFlat.filter(r => {
            const rt = r.replyTo || null;
            return parentId === null ? (rt === null || rt === rootCid) : (rt === parentId);
        });

        if(children.length === 0) return '';
        
        const myToken = getMyToken();
        return children.map(r => {
            const sub = repliesFlat.filter(sr => sr.replyTo === r.id);
            const rCanDel = window.__ddIsAdmin || r.token === myToken;
            
            return `
              <div class="ic-reply-item">
                <div class="ic-reply-body" style="width: 100%;">
                  <div class="ic-reply-name">${esc(r.name||'Khách')} ${r.isAdmin?'<span class="ic-item-admin-badge">chủ nhà</span>':''} <span style="font-size:0.6rem;color:var(--text-dim);font-weight:normal">${timeAgo(r.ts)}</span></div>
                  <div class="ic-reply-text">${esc(r.text)}</div>
                  <div style="display:flex; gap: 10px; margin-top: 4px; align-items: center;">
                      <button class="ic-reply-at-btn" data-cid="${rootCid}" data-rid="${r.id}" data-name="${esc(r.name||'Khách')}">💬 Trả lời</button>
                      ${rCanDel ? `<button class="ic-del-reply-btn" data-cid="${rootCid}" data-rid="${r.id}">✕ Xóa</button>` : ''}
                  </div>
                  ${sub.length > 0 ? `<button class="toggle-replies-btn" data-cid="${r.id}">Hiển thị ${sub.length} câu trả lời ▾</button>` : ''}
                  
                  <div class="ic-replies" id="thread-${r.id}">
                     ${renderThreadHtml(repliesFlat, r.id, level + 1, rootCid)}
                  </div>
                  
                  <div class="chat-form-modern" id="ic-rf-${r.id}" style="display:none; margin-top: 8px;">
                     <input class="cfm-name reply-inp" id="rn-${r.id}" placeholder="Tên..." value="${esc(getSavedName())}">
                     <div class="cfm-bottom">
                        <textarea class="cfm-text reply-inp-text" id="rt-${r.id}" placeholder="Phản hồi..." rows="1"></textarea>
                        <button class="cfm-send ic-rf-send" data-cid="${rootCid}" data-replyto="${r.id}" data-formid="${r.id}">➤</button>
                     </div>
                     <button class="ic-rf-cancel" data-formid="${r.id}" style="font-size: 0.6rem; color: var(--text-dim); background: none; border: none; text-align: right; margin-top: -5px; padding: 0; cursor:pointer;">Hủy</button>
                  </div>
                </div>
              </div>
            `;
        }).join('');
    }

    function renderSidebarComments(pIdx) {
      const listEl = document.getElementById('icSidebarList');
      const pKey = 'p' + pIdx;
      const pComments = allInlineComments[pKey];
      
      const openThreads = new Set();
      if(listEl) { listEl.querySelectorAll('.ic-replies.open').forEach(el => openThreads.add(el.id)); }
      
      if (!pComments || Object.keys(pComments).length === 0) {
        listEl.innerHTML = '<div class="ic-empty">Đoạn này chưa có bình luận. Hãy là người đầu tiên! 🌊</div>';
        return;
      }

      const myToken = getMyToken();
      const items = Object.entries(pComments).map(([id, v]) => ({ id, ...v })).sort((a, b) => a.ts - b.ts);

      listEl.innerHTML = items.map(item => {
        const canDel = window.__ddIsAdmin || item.token === myToken;
        const repliesData = item.replies || {};
        const repliesFlat = Object.entries(repliesData).map(([rid, rv]) => ({id: rid, ...rv})).sort((a,b) => a.ts - b.ts);
        
        const rootRepliesHtml = renderThreadHtml(repliesFlat, null, 1, item.id);
        const rootRepliesCount = repliesFlat.filter(r => !r.replyTo || r.replyTo === item.id).length;
        
        const toggleBtnHtml = rootRepliesCount > 0 ? `<button class="toggle-replies-btn" data-cid="${item.id}">Hiển thị ${rootRepliesCount} câu trả lời ▾</button>` : '';

        return `
          <div class="ic-item">
            <div class="ic-item-header">
              <span class="ic-item-name">${esc(item.name || 'Khách')} ${item.isAdmin?'<span class="ic-item-admin-badge">chủ nhà</span>':''}</span>
              <span class="ic-item-time">${timeAgo(item.ts)}</span>
            </div>
            <div class="ic-item-text">${esc(item.text)}</div>
            <div style="display:flex; justify-content:space-between; align-items:center;">
               <button class="ic-reply-toggle" data-cid="${item.id}" data-rid="">💬 Trả lời</button>
               ${canDel ? `<button class="ic-del-btn show" data-cid="${item.id}">✕ Xóa</button>` : ''}
            </div>
            
            ${toggleBtnHtml}
            <div class="ic-replies" id="thread-${item.id}">
               ${rootRepliesHtml}
            </div>
            
            <div class="chat-form-modern" id="ic-rf-${item.id}" style="display:none; margin-top: 8px;">
               <input class="cfm-name reply-inp" id="rn-${item.id}" placeholder="Tên..." value="${esc(getSavedName())}">
               <div class="cfm-bottom">
                  <textarea class="cfm-text reply-inp-text" id="rt-${item.id}" placeholder="Phản hồi..." rows="1"></textarea>
                  <button class="cfm-send ic-rf-send" data-cid="${item.id}" data-replyto="" data-formid="${item.id}">➤</button>
               </div>
               <button class="ic-rf-cancel" data-formid="${item.id}" style="font-size: 0.6rem; color: var(--text-dim); background: none; border: none; text-align: right; margin-top: -5px; padding: 0; cursor:pointer;">Hủy</button>
            </div>
          </div>
        `;
      }).join('');

      openThreads.forEach(id => { document.getElementById(id)?.classList.add('open'); });
      if(window.__ddIsAdmin) {
         document.querySelectorAll('.ic-form-name, .reply-inp').forEach(inp => { inp.value = 'dynamic duo 𓆝'; inp.disabled = true; inp.style.opacity = '0.7'; });
      }
    }

    document.getElementById('icSidebarList').onclick = async (e) => {
        const tgtBtn = e.target.closest('button');
        if (!tgtBtn) return;
        
        const pIdx = document.getElementById('icFormSend').getAttribute('data-current-p');
        const pKey = 'p' + pIdx;
        
        if (tgtBtn.classList.contains('toggle-replies-btn')) {
            const thread = document.getElementById('thread-' + tgtBtn.dataset.cid);
            if(thread) {
                const isOpen = thread.classList.toggle('open');
                const count = thread.children.length;
                tgtBtn.innerHTML = isOpen ? `Ẩn câu trả lời ▴` : `Hiển thị ${count} câu trả lời ▾`;
            }
        }

        if (tgtBtn.classList.contains('ic-reply-toggle') || tgtBtn.classList.contains('ic-reply-at-btn')) {
            const rid = tgtBtn.dataset.rid || tgtBtn.dataset.cid;
            const form = document.getElementById('ic-rf-' + rid);
            if (form) {
                form.style.display = 'flex';
                const textInput = document.getElementById('rt-' + rid);
                if(tgtBtn.dataset.name) {
                    textInput.value = `@${tgtBtn.dataset.name} ` + textInput.value;
                }
                textInput.focus();
            }
        }
        
        if (tgtBtn.classList.contains('ic-rf-cancel')) {
            const form = document.getElementById('ic-rf-' + tgtBtn.dataset.formid);
            if (form) { form.style.display = 'none'; }
        }
        
        if (tgtBtn.classList.contains('ic-rf-send')) {
            const formId = tgtBtn.dataset.formid;
            const rootCid = tgtBtn.dataset.cid;
            const replyTo = tgtBtn.dataset.replyto || null;
            
            const nameInp = document.getElementById('rn-' + formId);
            const textInp = document.getElementById('rt-' + formId);
            const text = textInp.value.trim();
            const finalName = window.__ddIsAdmin ? 'dynamic duo 𓆝' : (nameInp.value.trim() || 'Khách');
            
            if (!text) return;
            tgtBtn.disabled = true; tgtBtn.innerHTML = '...'; saveName(finalName);
            
            waitFirebase(async ({db, ref, push}) => {
                try {
                    await push(ref(db, `inline_comments/${pageId}/${pKey}/${rootCid}/replies`), {
                        name: finalName, text, ts: Date.now(), token: getMyToken(), isAdmin: window.__ddIsAdmin, replyTo
                    });
                    textInp.value = '';
                    const form = document.getElementById('ic-rf-' + formId);
                    if(form) { form.style.display = 'none'; }
                    
                    const targetThread = replyTo ? `thread-${replyTo}` : `thread-${rootCid}`;
                    document.getElementById(targetThread)?.classList.add('open');
                } catch(err) { alert("Lỗi: " + err.message); } 
                finally { tgtBtn.disabled = false; tgtBtn.innerHTML = '➤'; }
            });
        }
        
        if (tgtBtn.classList.contains('ic-del-btn')) {
            if (confirm('Bạn muốn xóa bình luận này? Toàn bộ trả lời bên trong cũng sẽ bị xóa.')) {
                waitFirebase(async ({db, ref, remove}) => { await remove(ref(db, `inline_comments/${pageId}/${pKey}/${tgtBtn.dataset.cid}`)); });
            }
        }
        
        if (tgtBtn.classList.contains('ic-del-reply-btn')) {
            if (confirm('Bạn muốn xóa phản hồi này?')) {
                waitFirebase(async ({db, ref, remove}) => { await remove(ref(db, `inline_comments/${pageId}/${pKey}/${tgtBtn.dataset.cid}/replies/${tgtBtn.dataset.rid}`)); });
            }
        }
    };

    function startListeningInline() {
      waitFirebase(({ db, ref, onValue }) => {
        onValue(ref(db, 'inline_comments/' + pageId), (snap) => {
          const data = snap.val() || {}; 
          allInlineComments = data;
          autoCleanupInline(data, 500);
          
          paragraphs.forEach((p, idx) => {
            const countEl = p.querySelector('.ic-count');
            const trigger = p.querySelector('.ic-trigger');
            const pComments = allInlineComments['p' + idx];
            
            if (countEl && trigger) {
              const count = pComments ? Object.keys(pComments).length : 0;
              countEl.innerText = count;
              if (count > 0) { trigger.classList.add('has-comments'); } else { trigger.classList.remove('has-comments'); }
            }
          });
          const activeIdx = document.getElementById('icFormSend')?.getAttribute('data-current-p');
          if (activeIdx !== null && activeIdx !== undefined) renderSidebarComments(activeIdx);
        });
      });
    }

    document.getElementById('icFormSend').onclick = async () => {
      const btn = document.getElementById('icFormSend');
      const pIdx = btn.getAttribute('data-current-p');
      const textEl = document.getElementById('icFormText'); 
      const text = textEl.value.trim();
      
      const rawName = document.getElementById('icFormName').value.trim() || 'Khách';
      const finalName = window.__ddIsAdmin ? 'dynamic duo 𓆝' : rawName;
      
      if (!text || pIdx === null) return;
      btn.disabled = true;

      waitFirebase(async ({ db, ref, push }) => {
        try {
          await push(ref(db, `inline_comments/${pageId}/p${pIdx}`), {
            name: finalName, text, ts: Date.now(), token: getMyToken(), isAdmin: window.__ddIsAdmin
          });
          textEl.value = ''; 
        } catch (e) { alert("Lỗi gửi comment: " + e.message); } 
        finally { btn.disabled = false; }
      });
    };
    
    startListeningInline();
  }

  const closeSidebar = () => {
    layoutWrap.classList.remove('sidebar-open');
    if (icOverlay) icOverlay.classList.remove('show');
    document.body.style.overflow = '';
  };
  
  if (document.getElementById('icSidebarClose')) document.getElementById('icSidebarClose').onclick = closeSidebar;
  if (icOverlay) icOverlay.onclick = closeSidebar;
  
  setupChapterLike();
  setupChapComments();
}); 

/* ══ MODULE: DOUBLE TAP LIKES & CHAT CUỐI CHƯƠNG ══ */
function setupChapterLike(){
  const btn = document.getElementById('btnLikeChapter'), countEl = document.getElementById('chapLikeCount');
  if(!btn) return;
  const key = 'chap_' + pageKey(), myToken = getMyToken();
  
  let lastTap = 0;
  const contentEl = document.getElementById('novelContent');
  if (contentEl) {
      contentEl.addEventListener('touchend', (e) => {
          const currentTime = new Date().getTime();
          const tapLength = currentTime - lastTap;
          if (tapLength < 500 && tapLength > 0) { 
              btn.click(); 
              e.preventDefault(); 
          }
          lastTap = currentTime;
      });
  }

  waitFirebase(({db, ref, onValue, update, remove}) => {
    onValue(ref(db, 'chapter_likes/' + key), snap => {
      const data = snap.val() || {}; countEl.textContent = Object.keys(data).length;
      if(data[myToken]) { btn.classList.add('liked'); btn.querySelector('.heart').textContent = '❤️'; }
      else { btn.classList.remove('liked'); btn.querySelector('.heart').textContent = '🤍'; }
    });
    btn.onclick = async (e) => {
      const isLiked = btn.classList.contains('liked');
      if(isLiked) {
          await remove(ref(db, `chapter_likes/${key}/${myToken}`));
      } else {
          const rect = btn.getBoundingClientRect();
          shootConfetti(rect.left + rect.width / 2, rect.top);
          await update(ref(db, `chapter_likes/${key}`), { [myToken]: Date.now() });
      }
    };
  });
}

function setupChapComments(){
  const section = document.getElementById('chapCommentSection');
  if(!section) return;
  const cmtList = document.getElementById('cmtList');
  const cmtName = document.getElementById('cmtName');
  const cmtText = document.getElementById('cmtText');
  const cmtSubmit = document.getElementById('cmtSubmit');
  const key = 'chap_' + pageKey();
  const myToken = getMyToken();
  
  if(cmtName) cmtName.value = getSavedName();

  function autoCleanupComments(data, maxItems = 500) {
      if(!data) return;
      waitFirebase(({db, ref, remove}) => {
          const keys = Object.keys(data);
          if (keys.length > maxItems) {
              const sorted = keys.sort((a,b) => data[a].ts - data[b].ts);
              const toDelete = sorted.slice(0, keys.length - maxItems);
              toDelete.forEach(k => remove(ref(db, `comments/${key}/${k}`)));
          }
      });
  }

  function renderMainThreadHtml(repliesFlat, parentId, level, rootCid) {
        const children = repliesFlat.filter(r => {
            const rt = r.replyTo || null;
            return parentId === null ? (rt === null || rt === rootCid) : (rt === parentId);
        });

        if(children.length === 0) return '';
        
        return children.map(r => {
            const sub = repliesFlat.filter(sr => sr.replyTo === r.id);
            const rCanDel = window.__ddIsAdmin || r.token === myToken;
            
            return `
            <div class="reply-item">
              <div class="reply-avatar">${avatarLetter(r.name)}</div>
              <div class="reply-body" style="width: 100%;">
                <div class="reply-name">${esc(r.name||'Khách')} ${r.isAdmin?'<span class="reply-admin-badge">chủ nhà</span>':''} <span class="reply-time">${timeAgo(r.ts)}</span></div>
                <div class="reply-text">${esc(r.text)}</div>
                <div style="display:flex; gap: 10px; margin-top: 4px; align-items: center;">
                    <button class="reply-at-btn" data-cid="${rootCid}" data-rid="${r.id}" data-name="${esc(r.name||'Khách')}">💬 Trả lời</button>
                    ${rCanDel ? `<button class="reply-del show" data-cid="${rootCid}" data-rid="${r.id}">✕ Xóa</button>` : ''}
                </div>
                ${sub.length > 0 ? `<button class="toggle-replies-btn" data-cid="${r.id}">Hiển thị ${sub.length} câu trả lời ▾</button>` : ''}
                  
                <div class="reply-thread" id="chap-thread-${r.id}">
                    ${renderMainThreadHtml(repliesFlat, r.id, level + 1, rootCid)}
                </div>
                
                <div class="chat-form-modern" id="rf-${r.id}" style="display:none; margin-top:8px;">
                   <input class="cfm-name reply-inp" id="rn-${r.id}" placeholder="Tên..." value="${esc(getSavedName())}">
                   <div class="cfm-bottom">
                      <textarea class="cfm-text reply-inp-text" id="rt-${r.id}" placeholder="Phản hồi..." rows="1"></textarea>
                      <button class="cfm-send reply-send-btn" data-cid="${rootCid}" data-replyto="${r.id}" data-formid="${r.id}">➤</button>
                   </div>
                   <button class="reply-cancel-btn" data-formid="${r.id}" style="font-size: 0.6rem; color: var(--text-dim); background: none; border: none; text-align: right; margin-top: -5px; padding: 0; cursor:pointer;">Hủy</button>
                </div>
              </div>
            </div>`;
        }).join('');
  }

  waitFirebase(({db, ref, push, onValue, remove}) => {
    onValue(ref(db, 'comments/'+key), snap => {
      const data = snap.val();
      autoCleanupComments(data, 500); 
      
      const openThreads = new Set();
      if(cmtList) { cmtList.querySelectorAll('.reply-thread.open').forEach(el => openThreads.add(el.id)); }
      
      if(!data) { cmtList.innerHTML = '<div class="comment-empty">Chưa có bình luận nào 🌊</div>'; return; }
      const items = Object.entries(data).map(([id,v]) => ({id,...v})).sort((a,b) => a.ts - b.ts);
      
      cmtList.innerHTML = items.map(c => {
        const canDel = window.__ddIsAdmin || c.token === myToken;
        const repliesData = c.replies || {};
        const repliesFlat = Object.entries(repliesData).map(([rid, rv]) => ({id: rid, ...rv})).sort((a,b) => a.ts - b.ts);
        
        const rootRepliesHtml = renderMainThreadHtml(repliesFlat, null, 1, c.id);
        const rootRepliesCount = repliesFlat.filter(r => !r.replyTo || r.replyTo === c.id).length;

        const toggleBtnHtml = rootRepliesCount > 0 ? `<button class="toggle-replies-btn" data-cid="${c.id}">Hiển thị ${rootRepliesCount} câu trả lời ▾</button>` : '';

        return `
          <div class="comment-card">
            <div class="comment-card-header">
              <div class="comment-card-avatar">${avatarLetter(c.name)}</div>
              <div>
                 <span class="comment-card-name">${esc(c.name)||'Khách'} ${c.isAdmin?'<span class="comment-admin-badge">chủ nhà</span>':''}</span>
                 <span class="comment-card-time">${timeAgo(c.ts)}</span>
              </div>
            </div>
            <p class="comment-card-text">${esc(c.text)}</p>
            
            <div class="comment-card-actions">
              <button class="cmt-reply-btn" data-cid="${c.id}" data-rid="">💬 Trả lời</button>
              ${canDel ? `<button class="cmt-del-btn show" data-cid="${c.id}">🗑 Xóa</button>` : ''}
            </div>
            
            ${toggleBtnHtml}
            <div class="reply-thread" id="chap-thread-${c.id}">
              ${rootRepliesHtml}
            </div>
            
            <div class="chat-form-modern" id="rf-${c.id}" style="display:none; margin-top:8px;">
               <input class="cfm-name reply-inp" id="rn-${c.id}" placeholder="Tên..." value="${esc(getSavedName())}">
               <div class="cfm-bottom">
                  <textarea class="cfm-text reply-inp-text" id="rt-${c.id}" placeholder="Phản hồi..." rows="1"></textarea>
                  <button class="cfm-send reply-send-btn" data-cid="${c.id}" data-replyto="" data-formid="${c.id}">➤</button>
               </div>
               <button class="reply-cancel-btn" data-formid="${c.id}" style="font-size: 0.6rem; color: var(--text-dim); background: none; border: none; text-align: right; margin-top: -5px; padding: 0; cursor:pointer;">Hủy</button>
            </div>
          </div>
        `;
      }).join('');
      
      openThreads.forEach(id => { document.getElementById(id)?.classList.add('open'); });
      if(window.__ddIsAdmin) {
         document.querySelectorAll('.comment-inp, .reply-inp').forEach(inp => { inp.value = 'dynamic duo 𓆝'; inp.disabled = true; inp.style.opacity = '0.7'; });
      }
    });
    
    cmtList.onclick = async (e) => {
       const tgtBtn = e.target.closest('button');
       if (!tgtBtn) return;
       
       if(tgtBtn.classList.contains('toggle-replies-btn')) {
           const thread = document.getElementById('chap-thread-' + tgtBtn.dataset.cid);
           if(thread) {
               const isOpen = thread.classList.toggle('open');
               const count = thread.children.length; 
               tgtBtn.innerHTML = isOpen ? `Ẩn câu trả lời ▴` : `Hiển thị ${count} câu trả lời ▾`;
           }
       }
       
       if(tgtBtn.classList.contains('cmt-reply-btn') || tgtBtn.classList.contains('reply-at-btn')) {
         const rid = tgtBtn.dataset.rid || tgtBtn.dataset.cid;
         const form = document.getElementById('rf-' + rid);
         if(form) {
             form.style.display = 'flex';
             const textInput = document.getElementById('rt-' + rid);
             if (tgtBtn.dataset.name) {
                textInput.value = `@${tgtBtn.dataset.name} ` + textInput.value;
             }
             textInput.focus();
         }
       }
       
       if(tgtBtn.classList.contains('reply-cancel-btn')) {
         const form = document.getElementById('rf-' + tgtBtn.dataset.formid);
         if(form) { form.style.display = 'none'; }
       }
       
       if(tgtBtn.classList.contains('reply-send-btn')) {
         const formId = tgtBtn.dataset.formid;
         const rootCid = tgtBtn.dataset.cid;
         const replyTo = tgtBtn.dataset.replyto || null;
         
         const nameInput = document.getElementById('rn-' + formId);
         const textInput = document.getElementById('rt-' + formId);
         const text = textInput.value.trim();
         
         const finalName = window.__ddIsAdmin ? 'dynamic duo 𓆝' : (nameInput.value.trim() || 'Khách');
         
         if(!text) return;
         tgtBtn.disabled = true; tgtBtn.innerHTML = '...'; saveName(finalName);
         
         waitFirebase(async ({db, ref, push}) => {
             try {
                 await push(ref(db, `comments/${key}/${rootCid}/replies`), {
                   name: finalName, text, ts: Date.now(), token: myToken, isAdmin: window.__ddIsAdmin, replyTo
                 });
                 textInput.value = '';
                 const form = document.getElementById('rf-' + formId);
                 if(form) { form.style.display = 'none'; }
                 
                 const targetThread = replyTo ? `chap-thread-${replyTo}` : `chap-thread-${rootCid}`;
                 document.getElementById(targetThread)?.classList.add('open');
             } catch (err) { alert("Lỗi: " + err.message); } 
             finally { tgtBtn.disabled = false; tgtBtn.innerHTML = '➤'; }
         });
       }
       
       if(tgtBtn.classList.contains('cmt-del-btn')) {
         if(confirm('Bạn muốn xóa bình luận này? Các phản hồi bên trong cũng sẽ biến mất.')) {
           waitFirebase(async ({db, ref, remove}) => { await remove(ref(db, `comments/${key}/${tgtBtn.dataset.cid}`)); });
         }
       }
       
       if(tgtBtn.classList.contains('reply-del')) {
         if(confirm('Bạn muốn xóa phản hồi này?')) {
           waitFirebase(async ({db, ref, remove}) => { await remove(ref(db, `comments/${key}/${tgtBtn.dataset.cid}/replies/${tgtBtn.dataset.rid}`)); });
         }
       }
    };

    cmtSubmit.onclick = async () => {
      const text = cmtText.value.trim();
      const rawName = cmtName.value.trim() || 'Khách';
      const finalName = window.__ddIsAdmin ? 'dynamic duo 𓆝' : rawName;
      
      if(!text) return; cmtSubmit.disabled = true; saveName(finalName);
      await push(ref(db, 'comments/'+key), { name: finalName, text, ts: Date.now(), token: myToken, isAdmin: window.__ddIsAdmin });
      cmtText.value = ''; cmtSubmit.disabled = false;
    };
  });
}
</script>
</body>
