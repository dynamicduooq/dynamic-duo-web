---
// src/pages/admin/index.astro
// Siêu Admin Panel: Quản lý truyện, Markdown Editor, Firebase (Comments/Views), System Settings
---

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin · Dynamic Duo</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=Literata:wght@400;600&display=swap" rel="stylesheet" />
  
  <!-- JSZip for Backup Feature -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

  <style>
    :root {
      --sky: #0ea5e9; --sky2: #0284c7; --sky-dark: #0369a1;
      --sky-light: #bae6fd; --sky-pale: #f0f9ff;
      --cream: #f8fafc; --text-main: #1e293b; --text-mid: #475569; --text-dim: #94a3b8;
      --r-sm: 6px; --r-md: 10px; --r-lg: 16px; --r-pill: 999px;
      --t: all .2s ease;
      --red: #ef4444; --green: #10b981; --amber: #f59e0b; --purple: #8b5cf6;
    }
    *, *::before, *::after { box-sizing: border-box; }
    body { margin: 0; padding: 0; background: var(--cream); font-family: 'Newsreader', serif; font-size: 16px; color: var(--text-main); }
    
    /* ── SCROLLBAR ── */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: var(--sky-pale); }
    ::-webkit-scrollbar-thumb { background: var(--sky-light); border-radius: 4px; }

    /* ── TOPBAR ── */
    .topbar {
      position: sticky; top: 0; z-index: 100; background: #fff; border-bottom: 1px solid var(--sky-light);
      display: flex; align-items: center; justify-content: space-between; padding: 0 24px; height: 56px;
      box-shadow: 0 2px 10px rgba(14,165,233,.05);
    }
    .topbar-logo { font-family: 'Literata', serif; font-weight: 600; font-size: 1.1rem; color: var(--sky-dark); display: flex; align-items: center; gap: 8px;}
    .topbar-right { display: flex; align-items: center; gap: 12px; }
    
    .btn { padding: 6px 16px; border-radius: var(--r-sm); font-size: .85rem; font-family: 'Newsreader', serif; cursor: pointer; transition: var(--t); border: 1px solid transparent; font-weight:600; display: inline-flex; align-items: center; gap: 6px; justify-content: center; }
    .btn-sky { background: var(--sky); color: #fff; border-color: var(--sky); box-shadow: 0 2px 6px rgba(14,165,233,.2); }
    .btn-sky:hover { background: var(--sky2); border-color: var(--sky2); transform: translateY(-1px); }
    .btn-outline { background: #fff; color: var(--sky-dark); border-color: var(--sky-light); }
    .btn-outline:hover { background: var(--sky-pale); border-color: var(--sky); color: var(--sky); }
    .btn-red { background: var(--red); color: #fff; border-color: var(--red); }
    .btn-red:hover { background: #dc2626; }
    .btn-green { background: var(--green); color: #fff; border-color: var(--green); }
    .btn-green:hover { background: #059669; }
    .btn-sm { padding: 4px 10px; font-size: .75rem; }

    /* ── LAYOUT ── */
    .admin-layout { display: flex; min-height: calc(100vh - 56px); }
    .sidebar { width: 240px; flex-shrink: 0; background: #fff; border-right: 1px solid var(--sky-light); padding: 20px 0; overflow-y: auto; }
    .sidebar-section { padding: 8px 20px; font-size: .7rem; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-dim); margin-top: 10px; font-family: sans-serif; font-weight: bold; }
    .sidebar-link { display: flex; align-items: center; gap: 10px; padding: 10px 20px; font-size: .9rem; color: var(--text-mid); cursor: pointer; transition: var(--t); border-left: 3px solid transparent; font-weight: 500; }
    .sidebar-link:hover, .sidebar-link.active { background: var(--sky-pale); color: var(--sky-dark); border-left-color: var(--sky); font-weight: 700; }
    
    .main { flex: 1; padding: 30px 40px; max-width: 1200px; margin: 0 auto; overflow-x: hidden; }

    /* ── LOGIN SCREEN ── */
    #loginScreen { position: fixed; inset: 0; z-index: 200; background: var(--cream); display: flex; align-items: center; justify-content: center; }
    .login-card { width: 400px; background: #fff; border: 1px solid var(--sky-light); border-radius: var(--r-lg); padding: 40px; box-shadow: 0 10px 40px rgba(14,165,233,.1); text-align: center; }
    .field { margin-bottom: 16px; text-align: left; position: relative; }
    .field label { display: block; font-size: .8rem; font-family: sans-serif; font-weight: bold; color: var(--text-mid); margin-bottom: 6px; }
    .field input, .field select, .field textarea { width: 100%; padding: 10px 14px; border: 1px solid var(--sky-light); border-radius: var(--r-md); font-family: 'Newsreader', serif; font-size: .95rem; color: var(--text-main); background: #fff; transition: var(--t); }
    .field input:focus, .field select:focus, .field textarea:focus { outline: none; border-color: var(--sky); box-shadow: 0 0 0 3px rgba(14,165,233,.15); }
    .error-msg { background: #fef2f2; border: 1px solid #fca5a5; border-radius: var(--r-sm); padding: 10px; font-size: .85rem; color: var(--red); margin-bottom: 16px; display: none; }

    /* ── SECTIONS & CARDS ── */
    .section { display: none; animation: fadeIn 0.3s ease; }
    .section.active { display: block; }
    @keyframes fadeIn { from {opacity: 0; transform: translateY(10px)} to {opacity: 1; transform: translateY(0)} }
    
    .page-title { font-family: 'Literata', serif; font-size: 1.5rem; color: var(--sky-dark); margin: 0 0 24px; display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid var(--sky-pale); padding-bottom: 12px; }
    
    .card { background: #fff; border: 1px solid var(--sky-light); border-radius: var(--r-md); padding: 20px; box-shadow: 0 4px 15px rgba(14,165,233,.03); margin-bottom: 20px; }
    
    .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .stat-card { background: #fff; border: 1px solid var(--sky-light); border-radius: var(--r-md); padding: 20px; text-align: center; box-shadow: 0 2px 10px rgba(14,165,233,.05); }
    .stat-num { font-family: 'Literata', serif; font-size: 2.2rem; font-weight: bold; color: var(--sky-dark); line-height: 1; }
    .stat-label { font-size: .75rem; color: var(--text-dim); margin-top: 8px; font-family: sans-serif; text-transform: uppercase; font-weight: bold; }

    /* ── TABLE & LISTS ── */
    .toolbar-row { display: flex; gap: 10px; margin-bottom: 16px; align-items: center; flex-wrap: wrap; }
    .search-box { flex: 1; min-width: 200px; padding: 8px 12px; border: 1px solid var(--sky-light); border-radius: var(--r-sm); font-family: 'Newsreader', serif; }
    
    .data-table { width: 100%; border-collapse: collapse; background: #fff; border-radius: var(--r-md); overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.02); border: 1px solid var(--sky-light); }
    .data-table th { text-align: left; padding: 12px; background: var(--sky-pale); font-size: .75rem; letter-spacing: 1px; text-transform: uppercase; font-family: sans-serif; color: var(--sky-dark); border-bottom: 2px solid var(--sky-light); }
    .data-table td { padding: 12px; border-bottom: 1px solid rgba(186,230,253,.4); font-size: .9rem; color: var(--text-main); vertical-align: middle; }
    .data-table tr:hover td { background: #f8fafc; }
    .data-table tr.dragging { opacity: 0.5; background: var(--sky-pale); }
    .drag-handle { cursor: grab; color: var(--text-dim); padding: 0 10px; font-size: 1.2rem; }
    
    .badge { padding: 2px 8px; border-radius: var(--r-pill); font-size: .7rem; font-family: sans-serif; font-weight: bold; }
    .badge-draft { background: #fef08a; color: #b45309; }
    .badge-live { background: #dcfce7; color: #166534; }

    /* ── EDITOR ADVANCED ── */
    .editor-wrap { border: 1px solid var(--sky-light); border-radius: var(--r-md); background: #fff; overflow: hidden; display: flex; flex-direction: column; }
    .editor-toolbar { background: var(--sky-pale); padding: 8px 12px; border-bottom: 1px solid var(--sky-light); display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
    .editor-btn { background: #fff; border: 1px solid var(--sky-light); border-radius: 4px; padding: 4px 8px; font-size: .8rem; cursor: pointer; color: var(--text-main); font-weight: 600; display: inline-flex; align-items: center; gap: 4px; }
    .editor-btn:hover { background: var(--sky); color: #fff; border-color: var(--sky); }
    
    /* Search & Replace Bar */
    .snr-bar { display: none; padding: 8px 12px; background: #fff; border-bottom: 1px solid var(--sky-light); gap: 8px; align-items: center; }
    .snr-bar.open { display: flex; }
    .snr-input { padding: 4px 8px; border: 1px solid var(--sky-light); border-radius: 4px; font-size: .85rem; flex: 1; }

    .editor-textarea { width: 100%; min-height: 500px; padding: 20px; border: none; font-family: 'Newsreader', serif; font-size: 1.05rem; line-height: 1.8; color: var(--text-main); resize: vertical; outline: none; }
    .editor-footer { background: #f8fafc; padding: 8px 16px; border-top: 1px solid var(--sky-light); display: flex; justify-content: space-between; font-size: .75rem; color: var(--text-dim); font-family: sans-serif; }

    /* ── FIREBASE DASHBOARD ── */
    .fb-list { display: flex; flex-direction: column; gap: 12px; max-height: 600px; overflow-y: auto; padding-right: 10px; }
    .fb-item { padding: 12px; border: 1px solid var(--sky-light); border-radius: var(--r-md); background: #fff; }
    .fb-item-hd { display: flex; justify-content: space-between; margin-bottom: 6px; font-size: .85rem; }
    .fb-item-body { font-size: .95rem; line-height: 1.5; color: var(--text-main); background: var(--sky-pale); padding: 10px; border-radius: var(--r-sm); margin-bottom: 8px;}
    
    /* Chart */
    .chart-container { display: flex; align-items: flex-end; gap: 4px; height: 150px; padding: 20px 0 0; border-bottom: 1px solid var(--text-dim); margin-top: 20px; }
    .chart-bar { flex: 1; background: var(--sky); border-radius: 4px 4px 0 0; position: relative; transition: height 0.3s; min-height: 2px;}
    .chart-bar:hover { background: var(--sky2); }
    .chart-label { position: absolute; bottom: -20px; left: 50%; transform: translateX(-50%); font-size: .65rem; color: var(--text-dim); font-family: sans-serif; white-space: nowrap; }
    .chart-val { position: absolute; top: -18px; left: 50%; transform: translateX(-50%); font-size: .7rem; font-weight: bold; color: var(--sky-dark); }

    /* Components */
    .toast { position: fixed; bottom: 20px; right: 20px; z-index: 1000; padding: 12px 20px; border-radius: var(--r-md); font-size: .9rem; box-shadow: 0 4px 15px rgba(0,0,0,.1); opacity: 0; transform: translateY(20px); transition: var(--t); pointer-events: none; font-weight: bold; }
    .toast.show { opacity: 1; transform: translateY(0); }
    .toast.success { background: #dcfce7; color: #166534; border: 1px solid #86efac; }
    .toast.error { background: #fef2f2; color: var(--red); border: 1px solid #fca5a5; }

    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 500; display: none; align-items: center; justify-content: center; backdrop-filter: blur(2px); }
    .modal-overlay.open { display: flex; }
    .modal-content { background: #fff; width: 90%; max-width: 500px; border-radius: var(--r-lg); padding: 24px; box-shadow: 0 10px 30px rgba(0,0,0,.2); }
    .modal-title { margin: 0 0 16px; font-family: 'Literata', serif; font-size: 1.2rem; }
    .color-swatch { width: 24px; height: 24px; border-radius: 4px; display: inline-block; cursor: pointer; border: 1px solid #ccc; }
  </style>
  
  <!-- Firebase SDK (Version matching web index) -->
  <script type="module">
    import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js';
    import { getDatabase, ref, onValue, remove, get } from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-database.js';

    const firebaseConfig = {
      apiKey: "AIzaSyBkuHIU0qdS-zNeUFGN7keNGGbAMXvilD0",
      authDomain: "dynamic-duo-comments.firebaseapp.com",
      projectId: "dynamic-duo-comments",
      storageBucket: "dynamic-duo-comments.firebasestorage.app",
      messagingSenderId: "948025586876",
      appId: "1:948025586876:web:848f38701acfdb9b844cb9",
      databaseURL: "https://dynamic-duo-comments-default-rtdb.asia-southeast1.firebasedatabase.app"
    };

    try {
      const app = initializeApp(firebaseConfig);
      window.__fbDb = getDatabase(app);
      window.__fbRef = ref;
      window.__fbOnValue = onValue;
      window.__fbRemove = remove;
      window.__fbGet = get;
      window.dispatchEvent(new Event('firebase-ready'));
    } catch(e) { console.error('Firebase Init Error', e); }
  </script>
</head>
<body>

<!-- TOAST -->
<div class="toast" id="toast"></div>

<!-- MODALS -->
<div class="modal-overlay" id="confirmModal">
  <div class="modal-content" style="max-width: 400px;">
    <h3 class="modal-title" id="confirmTitle">Xác nhận</h3>
    <p id="confirmMsg" style="margin-bottom: 20px; line-height: 1.5;"></p>
    <div style="display:flex; justify-content: flex-end; gap: 10px;">
      <button class="btn btn-outline" onclick="closeModal('confirmModal')">Hủy</button>
      <button class="btn btn-red" id="confirmOkBtn">Đồng ý</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="bulkUploadModal">
  <div class="modal-content" style="max-width: 700px;">
    <h3 class="modal-title">Bulk Upload - Dán nhiều chương</h3>
    <p style="font-size: .85rem; color: var(--text-mid); margin-bottom: 12px;">Hệ thống sẽ tự động cắt các chương dựa theo từ khóa "Chương X". Hãy đảm bảo định dạng rõ ràng.</p>
    <textarea id="bulkText" style="width: 100%; height: 300px; padding: 10px; font-family: monospace; border: 1px solid var(--sky-light); border-radius: var(--r-md);" placeholder="Chương 1: Bắt đầu...&#10;Nội dung chương 1...&#10;Chương 2: Tiếp diễn...&#10;Nội dung chương 2..."></textarea>
    <div style="display:flex; justify-content: flex-end; gap: 10px; margin-top: 16px;">
      <button class="btn btn-outline" onclick="closeModal('bulkUploadModal')">Hủy</button>
      <button class="btn btn-sky" id="bulkProcessBtn">Xử lý & Cắt chương</button>
    </div>
  </div>
</div>

<!-- LOGIN -->
<div id="loginScreen">
  <div class="login-card">
    <div style="font-family: 'Literata'; font-size: 1.8rem; color: var(--sky-dark); font-weight: bold; margin-bottom: 8px;">dynamic duo 𓆝</div>
    <div style="color: var(--text-dim); margin-bottom: 24px; font-style: italic;">CMS Admin Panel</div>
    <div class="error-msg" id="loginError"></div>
    <div class="field">
      <label>GitHub Personal Access Token (repo scope)</label>
      <input type="password" id="ghToken" placeholder="ghp_..." autocomplete="off" />
    </div>
    <div class="field">
      <label>Mật khẩu Admin</label>
      <input type="password" id="adminPass" placeholder="••••••••" autocomplete="off" />
    </div>
    <button class="btn btn-sky" style="width: 100%; padding: 12px; font-size: 1rem; margin-top: 8px;" id="loginBtn">Đăng nhập Hệ thống</button>
  </div>
</div>

<!-- MAIN APP -->
<div id="app" style="display:none;">
  <!-- TOPBAR -->
  <div class="topbar">
    <div class="topbar-logo">⚙ Dynamic Duo Workspace</div>
    <div class="topbar-right">
      <div id="autoSaveIndicator" style="font-size:.75rem; color:var(--text-dim); font-style:italic; margin-right:10px;"></div>
      <a href="/dynamic-duo-web/" target="_blank" class="btn btn-outline btn-sm">🌍 Xem Web</a>
      <button class="btn btn-red btn-sm" onclick="logout()">Đăng xuất</button>
    </div>
  </div>

  <div class="admin-layout">
    <!-- SIDEBAR -->
    <div class="sidebar">
      <div class="sidebar-section">Hệ thống</div>
      <div class="sidebar-link active" data-nav="dashboard">📊 Dashboard</div>
      
      <div class="sidebar-section">Quản lý Truyện</div>
      <div class="sidebar-link" data-nav="stories">📚 Danh sách Truyện</div>
      <div class="sidebar-link" data-nav="new-story">✨ Thêm Truyện Mới</div>
      
      <div class="sidebar-section">Độc giả & Tương tác</div>
      <div class="sidebar-link" data-nav="fb-comments">💬 Bình luận Web</div>
      <div class="sidebar-link" data-nav="fb-messages">✉️ Hộp thư (Private)</div>
      
      <div class="sidebar-section">Cài đặt Trang</div>
      <div class="sidebar-link" data-nav="settings">⚙️ Cấu hình Site</div>
      <div class="sidebar-link" data-nav="backup" style="color: var(--purple);">📦 Backup (ZIP)</div>
    </div>

    <!-- MAIN -->
    <div class="main">
      
      <!-- DASHBOARD -->
      <div class="section active" id="sec-dashboard">
        <h2 class="page-title">Tổng quan Hệ thống</h2>
        <div class="stat-grid">
          <div class="stat-card">
            <div class="stat-num" id="db-stories">0</div><div class="stat-label">Tổng truyện</div>
          </div>
          <div class="stat-card">
            <div class="stat-num" id="db-views">0</div><div class="stat-label">Lượt xem (Firebase)</div>
          </div>
          <div class="stat-card">
            <div class="stat-num" id="db-comments">0</div><div class="stat-label">Bình luận (Firebase)</div>
          </div>
        </div>
        
        <div class="card">
          <h3 style="margin-top:0; color:var(--sky-dark);">Biểu đồ lượt xem (Top 5 trang)</h3>
          <div class="chart-container" id="viewChart">
            <!-- Rendered via JS -->
            <div style="font-size: .8rem; color: var(--text-dim);">Đang tải dữ liệu từ Firebase...</div>
          </div>
        </div>
      </div>

      <!-- STORIES LIST -->
      <div class="section" id="sec-stories">
        <h2 class="page-title">Quản lý Truyện
          <div class="toolbar-row" style="margin:0;">
            <input type="text" class="search-box" id="storySearch" placeholder="Tìm kiếm truyện..." />
          </div>
        </h2>
        <table class="data-table">
          <thead><tr><th>Tên Truyện</th><th>Phân loại</th><th>Chương</th><th>Thao tác</th></tr></thead>
          <tbody id="storyTbody"></tbody>
        </table>
      </div>

      <!-- CHAPTER LIST -->
      <div class="section" id="sec-chapter-list">
        <h2 class="page-title">
          <span id="cl-title">Danh sách Chương</span>
          <div style="display:flex; gap: 8px;">
            <button class="btn btn-outline" onclick="navTo('stories')">← Quay lại</button>
            <button class="btn btn-outline" onclick="openBulkUpload()">📑 Dán Bulk</button>
            <button class="btn btn-sky" onclick="openEditor('new')">+ Viết chương mới</button>
          </div>
        </h2>
        
        <div class="toolbar-row">
          <input type="text" class="search-box" id="chapSearch" placeholder="Lọc theo tên/số chương..." />
          <button class="btn btn-outline" id="toggleReorderBtn">↕️ Bật Kéo thả Sắp xếp</button>
          <button class="btn btn-red" id="bulkDeleteBtn" style="display:none;">🗑 Xóa các mục đã chọn</button>
        </div>

        <p id="reorderNotice" style="display:none; font-size:.8rem; color:var(--amber); font-weight:bold; background:#fef3c7; padding:8px; border-radius:4px;">
          Kéo thả hàng để đổi thứ tự. Sau khi xếp xong, nhấn nút Lưu Thứ Tự xuất hiện bên dưới. 
          <br/>(Lưu ý: Lưu thứ tự sẽ update từng file một qua GitHub API, có thể mất chút thời gian).
        </p>

        <table class="data-table" id="chapTable">
          <thead>
            <tr>
              <th style="width: 40px;"><input type="checkbox" id="checkAllChaps" /></th>
              <th style="width: 60px;">#</th>
              <th>Tiêu đề</th>
              <th>Ngày</th>
              <th>Trạng thái</th>
              <th style="text-align: right;">Thao tác</th>
            </tr>
          </thead>
          <tbody id="chapTbody"></tbody>
        </table>
        
        <div id="saveReorderWrap" style="display:none; margin-top: 16px; text-align: right;">
          <button class="btn btn-sky" id="saveReorderBtn">💾 Lưu Thứ Tự Mới</button>
        </div>
      </div>

      <!-- EDITOR (Tích hợp mọi tính năng) -->
      <div class="section" id="sec-editor">
        <h2 class="page-title">
          <span id="ed-title">Soạn thảo</span>
          <div style="display:flex; gap:8px;">
            <button class="btn btn-outline" onclick="navTo('chapter-list')">← Hủy</button>
            <button class="btn btn-sky" id="ed-saveBtn">💾 Lưu & Publish</button>
          </div>
        </h2>
        
        <!-- Meta block -->
        <div class="card" style="display:grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div class="field"><label>Tiêu đề *</label><input type="text" id="ed-tieude" placeholder="Chương X - Tên..." /></div>
          <div class="field"><label>Số chương *</label><input type="number" id="ed-so" placeholder="Số nguyên" /></div>
          <div class="field"><label>Trạng thái</label>
            <select id="ed-draft"><option value="false">🟢 Công khai</option><option value="true">🟡 Nháp (Draft)</option></select>
          </div>
          <div class="field"><label>Tags (cách nhau dấu phẩy)</label><input type="text" id="ed-tags" placeholder="tag1, tag2" /></div>
          <div class="field" style="grid-column: 1 / -1;"><label>SEO Description</label><input type="text" id="ed-desc" placeholder="Tóm tắt nội dung 1 câu..." /></div>
          <div class="field" style="grid-column: 1 / -1;"><label>Lời Editor</label><textarea id="ed-note" rows="2" placeholder="Ghi chú, pass truyện..."></textarea></div>
