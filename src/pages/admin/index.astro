async function loadDashboard() {
  const ongoing = STORIES.filter(s => s.cat === 'ongoing');
  const completed = STORIES.filter(s => s.cat === 'completed');
  document.getElementById('statOngoing').textContent = ongoing.length;
  document.getElementById('statCompleted').textContent = completed.length;
  document.getElementById('statUpcoming').textContent = '☁️';

  let totalChaps = 0;
  let recentHtml = '<div style="font-size:.8rem;color:var(--text-dim);margin-bottom:12px">Chương mới nhất:</div><div style="display:flex;flex-direction:column;gap:8px">';

  for (const story of STORIES) {
    try {
      const files = await listDir(story.path);
      const chaps = files.filter(f => f.name !== 'index.md' && f.name.endsWith('.md'));
      totalChaps += chaps.length;
      if (chaps.length > 0) {
        const last = chaps[chaps.length - 1];
        recentHtml += `<div style="display:flex;justify-content:space-between;align-items:center;padding:10px 14px;background:#fff;border:1px solid rgba(186,230,253,.5);border-radius:var(--r-md)">
          <div>
            <div style="font-size:.82rem;color:var(--text-main);font-weight:600">${story.title}</div>
            <div style="font-size:.74rem;color:var(--text-dim)">${last.name}</div>
          </div>
          <div style="display:flex;gap:6px">
            <button class="btn btn-outline btn-sm" onclick="openStoryChaps('${story.id}')">Xem chương</button>
          </div>
        </div>`;
      }
    } catch(e) {}
  }
  recentHtml += '</div>';
  document.getElementById('statChaps').textContent = totalChaps;
  document.getElementById('recentList').innerHTML = recentHtml;
}

