// UTF-8 base64 encoding/decoding
function b64encode(str) { return btoa(unescape(encodeURIComponent(str))); }
function b64decode(str) { return decodeURIComponent(escape(atob(str))); }

function todayISO() { return new Date().toISOString().slice(0, 10); }

function wordCount(str) {
  if(!str) return 0;
  return str.trim().split(/\s+/).filter(word => word.length > 0).length;
}

// ═══════════════════════════════════════════════════════════
//  GITHUB API
// ═══════════════════════════════════════════════════════════
async function ghFetch(endpoint, opts = {}) {
  const res = await fetch(`https://api.github.com${endpoint}`, {
    ...opts,
    headers: {
      Authorization: `token ${TOKEN}`,
      'Content-Type': 'application/json',
      Accept: 'application/vnd.github.v3+json',
      ...(opts.headers || {}),
    },
  });
  if (!res.ok) {
    const err = await res.json().catch(() => ({}));
    throw new Error(err.message || `HTTP ${res.status}`);
  }
  return res.json();
}

async function listDir(path) {
  return ghFetch(`/repos/${REPO}/contents/${path}?ref=${BRANCH}`);
}

async function getFile(path) {
  if (fileCache[path]) return fileCache[path];
  const data = await ghFetch(`/repos/${REPO}/contents/${path}?ref=${BRANCH}`);
  const content = b64decode(data.content.replace(/\n/g, ''));
  const result = { ...data, decoded: content };
  fileCache[path] = result;
  return result;
}

async function putFile(path, content, message, sha = null) {
  delete fileCache[path]; // invalidate cache
  const body = { message, content: b64encode(content), branch: BRANCH };
  if (sha) body.sha = sha;
  return ghFetch(`/repos/${REPO}/contents/${path}`, { method: 'PUT', body: JSON.stringify(body) });
}

async function deleteFile(path, sha, message) {
  delete fileCache[path];
  return ghFetch(`/repos/${REPO}/contents/${path}`, { method: 'DELETE', body: JSON.stringify({ message, sha, branch: BRANCH }) });
}

