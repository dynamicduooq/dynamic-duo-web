  clearTimeout(el._t); el._t = setTimeout(() => el.classList.remove('show'), time);
};
const b64e = str => btoa(unescape(encodeURIComponent(str)));
const b64d = str => decodeURIComponent(escape(atob(str)));
const getISODate = () => new Date().toISOString().slice(0, 10);

function navTo(sectionId) {
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.sidebar-link').forEach(l => l.classList.remove('active'));
  $(`sec-${sectionId}`)?.classList.add('active');
  const link = document.querySelector(`.sidebar-link[data-nav="${sectionId}"]`);
  if(link) link.classList.add('active');

  // Trigger load logic based on section
  if(sectionId === 'stories') renderStories();
  if(sectionId === 'dashboard') loadFirebaseDashboard();
  if(sectionId === 'fb-comments') renderFirebaseComments();
  if(sectionId === 'fb-messages') renderFirebaseMessages();
  if(sectionId === 'settings') loadSettingsJson();
