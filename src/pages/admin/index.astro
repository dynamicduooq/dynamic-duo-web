window.openStoryChaps = async function(storyId) {
  currentStory = STORIES.find(s => s.id === storyId);
  document.getElementById('chapListTitle').textContent = `Chương — ${currentStory.title}`;
  document.getElementById('chapListBack').onclick = () => {
    showSection(currentStory.cat === 'ongoing' ? 'ongoing' : 'completed');
  };
  document.getElementById('addChapBtn').onclick = () => openEditor('new');
  showSection('chapter-list');
  await renderChapTable();
};

async function renderChapTable() {
  const wrap = document.getElementById('chapTableWrap');
  wrap.innerHTML = '<div class="empty">Đang tải...</div>';
  try {
    const files = await listDir(currentStory.path);
    const chaps = files
      .filter(f => f.name !== 'index.md' && f.name.endsWith('.md'))
      .sort((a, b) => a.name.localeCompare(b.name));

    if (chaps.length === 0) {
      wrap.innerHTML = '<div class="empty">Chưa có chương nào. Nhấn "+ Thêm chương" để bắt đầu.</div>';
      return;
    }

    wrap.innerHTML = `<table class="chap-table">
      <thead><tr>
        <th>#</th><th>Tên file</th><th>Tiêu đề</th><th>Ngày</th><th>Thao tác</th>
      </tr></thead>
      <tbody id="chapTbody"></tbody>
    </table>`;

    const tbody = document.getElementById('chapTbody');
    for (let i = 0; i < chaps.length; i++) {
      const f = chaps[i];
      const m = f.name.match(/chuong-(\d+)/);
      const num = m ? parseInt(m[1]) : i + 1;

      // Quick read frontmatter for title
      let chapTitle = f.name;
      try {
        const fd = await getFile(`${currentStory.path}/${f.name}`);
        const tm = fd.decoded.match(/^title:\s*"?([^"\n]+)"?/m);
        if (tm) chapTitle = tm[1];
      } catch(e) {}

      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="chap-num">${num}</td>
        <td style="font-size:.75rem;color:var(--text-dim);font-family:monospace">${f.name}</td>
        <td class="chap-title-cell">${chapTitle}</td>
        <td class="chap-date">–</td>
        <td class="chap-actions">
          <button class="btn btn-outline btn-sm" onclick="openEditor('edit','${f.name}')">✏️ Sửa</button>
          <button class="btn btn-red btn-sm" onclick="deleteChap('${f.name}','${f.sha}')">🗑</button>
        </td>`;
      tbody.appendChild(tr);
    }
  } catch(e) {
    wrap.innerHTML = `<div class="empty">Lỗi: ${e.message}</div>`;
  }
}

// ═══════════════════════════════════════════════════════════
//  EDITOR
// ═══════════════════════════════════════════════════════════
window.openEditor = async function(mode, filename = null) {
  editorMode = mode;
  showSection('editor');
  document.getElementById('editorBack').onclick = () => {
    showSection('chapter-list');
    renderChapTable();
  };

  const today = todayISO();

  if (mode === 'new') {
    document.getElementById('editorTitle').textContent = `Chương mới — ${currentStory.title}`;
    document.getElementById('ef-title').value = '';
    document.getElementById('ef-chuong').value = '';
    document.getElementById('ef-truyen-id').value = currentStory.id;
    document.getElementById('ef-date').value = today;
    document.getElementById('ef-tags').value = '';
    document.getElementById('ef-content').value = '';
    document.getElementById('editorStatus').textContent = '';
    currentFile = { filename: null, sha: null };
  } else {
    document.getElementById('editorTitle').textContent = `Sửa: ${filename}`;
    document.getElementById('editorStatus').textContent = '⏳ Đang tải...';
    try {
      const fd = await getFile(`${currentStory.path}/${filename}`);
      currentFile = { filename, sha: fd.sha, path: `${currentStory.path}/${filename}` };
      // Parse frontmatter
      const fm = parseFrontmatter(fd.decoded);
      document.getElementById('ef-title').value = fm.title || '';
      document.getElementById('ef-chuong').value = fm.chuong || '';
      document.getElementById('ef-truyen-id').value = fm.truyen_id || currentStory.id;
      document.getElementById('ef-date').value = fm.date || today;
      document.getElementById('ef-tags').value = Array.isArray(fm.tags) ? fm.tags.join(', ') : (fm.tags || '');
      // Body = everything after second ---
      const body = fd.decoded.replace(/^---[\s\S]*?---\s*/m, '').trim();
      document.getElementById('ef-content').value = body;
      document.getElementById('editorStatus').textContent = '✓ Đã tải';
    } catch(e) {
      document.getElementById('editorStatus').textContent = `Lỗi: ${e.message}`;
    }
  }

  updateWordCount();
};

window.editIndexPage = async function(storyId) {
  currentStory = STORIES.find(s => s.id === storyId);
  editorMode = 'edit-index';
  showSection('editor');
  document.getElementById('editorTitle').textContent = `Sửa trang truyện — ${currentStory.title}`;
  document.getElementById('editorBack').onclick = () => showSection(currentStory.cat === 'ongoing' ? 'ongoing' : 'completed');
  document.getElementById('editorStatus').textContent = '⏳ Đang tải...';

  try {
    const fd = await getFile(`${currentStory.path}/index.md`);
    currentFile = { filename: 'index.md', sha: fd.sha, path: `${currentStory.path}/index.md` };
    const fm = parseFrontmatter(fd.decoded);
    document.getElementById('ef-title').value = fm.title || '';
    document.getElementById('ef-chuong').value = '';
    document.getElementById('ef-truyen-id').value = fm.truyen_id || '';
    document.getElementById('ef-date').value = fm.date || todayISO();
    document.getElementById('ef-tags').value = Array.isArray(fm.tags) ? fm.tags.join(', ') : '';
    const body = fd.decoded.replace(/^---[\s\S]*?---\s*/m, '').trim();
    document.getElementById('ef-content').value = body;
    document.getElementById('editorStatus').textContent = '✓ Đã tải';
  } catch(e) {
    document.getElementById('editorStatus').textContent = `Lỗi: ${e.message}`;
  }
  updateWordCount();
};

function parseFrontmatter(text) {
  const match = text.match(/^---\s*([\s\S]*?)---/);
  if (!match) return {};
  const fm = {};
  const lines = match[1].split('\n');
  let currentKey = null, currentArr = null;
  for (const line of lines) {
    const kvMatch = line.match(/^(\w[\w_-]*):\s*(.*)/);
    if (kvMatch) {
      currentArr = null;
      const k = kvMatch[1], v = kvMatch[2].trim().replace(/^"(.*)"$/, '$1');
      if (v === '') { fm[k] = []; currentKey = k; currentArr = fm[k]; }
      else { fm[k] = isNaN(v) ? v : Number(v); currentKey = k; }
    } else if (line.match(/^\s+-\s+"?(.+?)"?\s*$/) && currentArr !== null) {
      currentArr.push(line.match(/^\s+-\s+"?(.+?)"?\s*$/)[1]);
    }
  }
  return fm;
}

function buildMarkdown(title, truyen_id, chuong, date, tags, body) {
  const tagList = tags.split(',').map(t => t.trim()).filter(Boolean);
  let fm = '---\n';
  fm += `title: "${title.replace(/"/g, '\\"')}"\n`;
  if (truyen_id) fm += `truyen_id: "${truyen_id}"\n`;
  if (chuong !== '' && chuong !== null) fm += `chuong: ${chuong}\n`;
  if (date) fm += `date: "${date}"\n`;
  if (tagList.length > 0) {
    fm += `tags:\n${tagList.map(t => `  - "${t.replace(/"/g, '\\"')}"`).join('\n')}\n`;
  }
  fm += '---\n\n';
  return fm + body;
}

// SAVE
document.getElementById('saveBtn').addEventListener('click', async () => {
  const title = document.getElementById('ef-title').value.trim();
  const chuong = document.getElementById('ef-chuong').value;
  const truyen_id = document.getElementById('ef-truyen-id').value.trim();
  const date = document.getElementById('ef-date').value;
  const tags = document.getElementById('ef-tags').value;
  const body = document.getElementById('ef-content').value;

  if (!title) { toast('Vui lòng nhập tiêu đề chương.', 'error'); return; }

  const btn = document.getElementById('saveBtn');
  btn.innerHTML = '<span class="spinner"></span> Đang lưu...';
  btn.disabled = true;

  try {
    let filePath, filename, sha;

    if (editorMode === 'edit' || editorMode === 'edit-index') {
      filePath = currentFile.path;
      filename = currentFile.filename;
      sha = currentFile.sha;
    } else {
      // New chapter: auto filename
      const chapNum = chuong ? parseInt(chuong) : 1;
      filename = `chuong-${String(chapNum).padStart(2, '0')}.md`;
      filePath = `${currentStory.path}/${filename}`;
      sha = null;
    }

    const content = buildMarkdown(title, truyen_id, chuong, date, tags, body);
    const commitMsg = editorMode === 'new'
      ? `✏️ Thêm chương: ${title}`
      : `📝 Cập nhật: ${title}`;

    await putFile(filePath, content, commitMsg, sha);
    currentFile.sha = null; // invalidate
    toast('✅ Đã lưu & deploy thành công!', 'success', 4000);
    document.getElementById('editorStatus').textContent = '✓ Đã lưu';

    // If new chapter, switch to edit mode with new sha
    if (editorMode === 'new') {
      currentFile = { filename, sha: null, path: filePath };
      editorMode = 'edit';
    }
  } catch(e) {
    toast(`❌ Lỗi: ${e.message}`, 'error', 5000);
  } finally {
    btn.innerHTML = '💾 Lưu & Deploy';
    btn.disabled = false;
  }
});

// DELETE
window.deleteChap = function(filename, sha) {
  confirm('Xoá chương', `Bạn chắc chắn muốn xoá "${filename}"? Hành động này không thể hoàn tác.`, async () => {
    try {
      await deleteFile(`${currentStory.path}/${filename}`, sha, `🗑 Xoá chương: ${filename}`);
      toast('Đã xoá chương.', 'success');
      await renderChapTable();
    } catch(e) {
      toast(`Lỗi: ${e.message}`, 'error');
    }
  });
};

