document.getElementById('ncSaveBtn').addEventListener('click', async () => {
  const storyVal = document.getElementById('nc-story').value;
  const [storyPath, storyId] = storyVal.split('|');
  const title = document.getElementById('nc-title').value.trim();
  const chuong = document.getElementById('nc-chuong').value;
