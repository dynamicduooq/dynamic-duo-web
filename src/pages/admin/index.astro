</div>

<div class="modal-overlay" id="editStoryModal">
  <div class="modal-content" style="max-width: 600px">
    <h3 style="margin-top:0; border-bottom:1px solid var(--sky-light); padding-bottom:10px; color:var(--sky-dark)">Cập nhật thông tin truyện</h3>
    <p style="font-size: .85rem; color: var(--text-mid); margin-top: 0">Sửa nội dung dễ dàng, hệ thống sẽ tự động ghép code an toàn.</p>
    
    <div class="field"><label>Tên bộ truyện</label><input type="text" id="edit-st-title" /></div>
    <div class="field"><label>Tác giả</label><input type="text" id="edit-st-author" /></div>
    
    <div class="field">
        <label>Tags (Cách nhau dấu phẩy)</label>
        <input type="text" id="edit-st-tags" placeholder="đam mỹ, HE, niên hạ..." />
        <small style="color:var(--amber); font-size: 0.7rem; display:block; margin-top: 4px;">Lưu ý: Sửa tag ở đây CHỈ cập nhật vào trang giới thiệu (index.astro), KHÔNG sửa tag bên trong các chương truyện. Để sửa tag toàn bộ chương, vui lòng dùng chức năng "Quản lý Tags" ở menu bên trái.</small>
    </div>

    <div class="field"><label>Mô tả ngắn (Tagline)</label><textarea id="edit-st-desc" rows="2"></textarea></div>
    <div class="field"><label>Văn án chi tiết (Hỗ trợ HTML/Markdown cơ bản)</label><textarea id="edit-st-body" rows="6"></textarea></div>
    
    <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:20px">
      <button class="btn btn-outline" onclick="closeModal('editStoryModal')">Hủy bỏ</button>
      <button class="btn btn-sky" id="btn-save-story-info" onclick="saveStoryInfo()">🚀 Lưu thay đổi</button>
    </div>
  </div>
</div>

<script is:inline>
/* ==========================================================================
   CẤU HÌNH CƠ BẢN
   ========================================================================== */
const REPO = 'dynamicduooq/dynamic-duo-web';
const BRANCH = 'main';
const ADMIN_PASS = 'dynamicduo2026'; 

let GH_TOKEN = localStorage.getItem('dd_gh_token') || '';
let currentStory = null; 
let currentChap = null;  
let loadedChapters = []; 
let chapSortAsc = true;

const $ = id => document.getElementById(id);

function showToast(msg, type = 'success') { 
    const el = $('toast');
    el.textContent = msg; 
    el.className = `toast show ${type}`;
    clearTimeout(el.t);
    el.t = setTimeout(()=> el.classList.remove('show'), 3500); 
}

/* ==========================================================================
   AUTH & LOGIN
   ========================================================================== */
if(GH_TOKEN) $('ghToken').value = GH_TOKEN;

$('loginBtn').onclick = async () => {
  if($('adminPass').value !== ADMIN_PASS) {
      showToast('Sai mật khẩu Admin!', 'error');
      return;
  }
  const token = $('ghToken').value.trim();
  if(!token) return showToast('Chưa nhập Token GitHub', 'error');

  const btn = $('loginBtn');
  btn.textContent = 'Đang kiểm tra...';
  btn.disabled = true;

  try {
    const res = await fetch('https://api.github.com/user', { headers: { Authorization: `token ${token}` }});
    if(!res.ok) throw new Error();
    const user = await res.json();
    
    GH_TOKEN = token;
    localStorage.setItem('dd_gh_token', token);
    
    $('ghUser').textContent = 'Admin: ' + user.login;
    $('loginScreen').style.display = 'none';
    $('app').style.display = 'block';
    
    navTo('dashboard');
    loadStoriesFromLocalOrAPI();
    loadFirebaseStats();
    
  } catch(e) { 
      showToast('Token lỗi hoặc không có quyền truy cập Repo!', 'error'); 
  } finally {
      btn.textContent = 'Đăng nhập hệ thống';
      btn.disabled = false;
  }
};

/* ==========================================================================
   ROUTING TÍCH HỢP LỊCH SỬ TRÌNH DUYỆT (BROWSER BACK/FORWARD)
   ========================================================================== */
function navTo(id, pushHistory = true) {
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.sidebar-link').forEach(l => l.classList.remove('active'));
  
  const sec = $('sec-'+id);
  if(sec) sec.classList.add('active');
  
  const link = document.querySelector(`[data-nav="${id}"]`);
  if(link) link.classList.add('active');
  
  if(id === 'stories') renderStoriesTable();
  if(id === 'settings') loadSettingsJSON();
  if(id === 'fb-comments') loadFbComments();
  if(id === 'fb-messages') loadFbMessages();
  if(id === 'fb-readers') loadFbReaders();
  if(id === 'bulk-upload') populateBulkUploadSelect();
  if(id === 'tags') {
      $('tag-old').value = ''; $('tag-new').value = ''; $('tag-log').style.display = 'none';
      if(typeof toggleTagInputs === 'function') toggleTagInputs();
      $('tag-target-story').innerHTML = '<option value="all">TẤT CẢ TRUYỆN</option>' + 
          storiesList.map(s => `<option value="${s.id}">${s.title}</option>`).join('');
  }

  // Đẩy ID vào lịch sử URL của trình duyệt
  if (pushHistory) {
      window.history.pushState({ section: id }, '', `#${id}`);
  }
}

// Bắt sự kiện khi người dùng ấn nút Back/Forward trên trình duyệt
window.addEventListener('popstate', (e) => {
    if (e.state && e.state.section) {
        navTo(e.state.section, false); // false để không tạo vòng lặp vô tận
    } else {
        navTo('dashboard', false); // Mặc định về Dashboard nếu hết lịch sử
    }
});

document.querySelectorAll('.sidebar-link').forEach(l => {
    l.onclick = () => navTo(l.dataset.nav);
});

/* ==========================================================================
   GITHUB API HELPERS
   ========================================================================== */
async function ghAPI(path, method='GET', body=null) {
  const opts = { method, headers: { Authorization: `token ${GH_TOKEN}`, 'Content-Type': 'application/json' } };
  if(body) opts.body = JSON.stringify(body);
  const res = await fetch(`https://api.github.com/repos/${REPO}${path}`, opts);
  if(!res.ok) {
      const err = await res.json().catch(()=>({}));
      throw new Error(err.message || 'Lỗi kết nối GitHub API');
  }
  return res.json();
}

const b64Encode = str => btoa(unescape(encodeURIComponent(str)));
const b64Decode = str => decodeURIComponent(escape(atob(str)));

/* ==========================================================================
   QUẢN LÝ TRUYỆN 
   ========================================================================== */
let storiesList = [
  { id: 'ha-chay-dong-hoang', shortId: 'hcdh', title: 'Hạ cháy đồng hoang', cat: 'ca-duoi-nuoc' },
  { id: 'quan-he-ban-cung-phong', shortId: 'qhbcp', title: 'Quan hệ bạn cùng phòng', cat: 'ca-duoi-nuoc' },
  { id: 'toi-nghi-chung-toi-sap-chia-tay', shortId: 'tnctsct', title: 'Tôi nghĩ chúng tôi sắp chia tay', cat: 'ca-tren-ban' },
  { id: 'neu-dem-nay-troi-khong-mua', shortId: 'ndntkm', title: 'Nếu đêm nay trời không mưa', cat: 'ca-tren-ban' },
  { id: 'vat-de-vo', shortId: 'vdv', title: 'Vật dễ vỡ', cat: 'ca-tren-ban' },
  { id: 'thieu-de-xuan-tam', shortId: 'tdxt', title: 'Thiếu đế xuân tâm', cat: 'ca-tren-ban' }
];

function loadStoriesFromLocalOrAPI() {
    $('stat-stories').textContent = storiesList.length;
}

function renderStoriesTable() {
  $('storyTbody').innerHTML = storiesList.map(s => `
    <tr>
      <td><b>${s.title}</b></td>
      <td style="font-size:.75rem; font-family:monospace; color:var(--text-dim)">src/pages/${s.cat}/${s.id}</td>
      <td><span class="badge badge-pub">Hoạt động</span></td>
      <td>
        <button class="btn btn-outline btn-sm" onclick="editStoryInfo('${s.id}')">✏️ Sửa thông tin</button>
        <button class="btn btn-sky btn-sm" onclick="openStoryManager('${s.id}')">Quản lý Chương</button>
      </td>
    </tr>
  `).join('');
}

function populateBulkUploadSelect() {
    const sel = $('bulk-story-select');
    sel.innerHTML = storiesList.map(s => `<option value="${s.cat}|${s.id}|${s.shortId || s.id}">${s.title}</option>`).join('');
}

let currentEditStoryId = null;
let currentEditStoryPath = null;
let currentEditStorySha = null;
let currentRawAstroCode = ""; 

async function editStoryInfo(id) {
    const story = storiesList.find(s => s.id === id);
    currentEditStoryId = id;
    currentEditStoryPath = `/contents/src/pages/${story.cat}/${story.id}/index.astro`;
    
    $('edit-st-title').value = '⏳ Đang tải...';
    openModal('editStoryModal');
    
    try {
        const file = await ghAPI(`${currentEditStoryPath}?ref=${BRANCH}`);
        currentRawAstroCode = b64Decode(file.content.replace(/\n/g,''));
        currentEditStorySha = file.sha;

        // Bóc tách dữ liệu
        const titleMatch = currentRawAstroCode.match(/const title = "(.*?)";/);
        const authorMatch = currentRawAstroCode.match(/const author = "(.*?)";/);
        const descMatch = currentRawAstroCode.match(/const description = "(.*?)";/);
        // FIX Regex tìm list tag trong Astro
        const tagsMatch = currentRawAstroCode.match(/const tags = \[(.*?)\];/);
        const bodyMatch = currentRawAstroCode.match(/<div class="desc">([\s\S]*?)<\/div>/);

        $('edit-st-title').value = titleMatch ? titleMatch[1] : '';
        $('edit-st-author').value = authorMatch ? authorMatch[1] : '';
        $('edit-st-desc').value = descMatch ? descMatch[1] : '';
        
        if (tagsMatch && tagsMatch[1]) {
            // Chuyển mảng string ["tag1", "tag2"] thành "tag1, tag2"
            $('edit-st-tags').value = tagsMatch[1].replace(/["']/g, '').split(',').map(s=>s.trim()).join(', ');
        } else {
            $('edit-st-tags').value = '';
        }
        
        $('edit-st-body').value = bodyMatch ? bodyMatch[1].trim() : '';

    } catch(e) {
        showToast('Không tải được file (Lỗi: ' + e.message + ')', 'error');
        closeModal('editStoryModal');
    }
}

async function saveStoryInfo() {
    const title = $('edit-st-title').value;
    const author = $('edit-st-author').value;
    const desc = $('edit-st-desc').value;
    const tagsRaw = $('edit-st-tags').value;
    const body = $('edit-st-body').value;

    if(!title) return showToast('Tên truyện không được để trống', 'error');
    
    const btn = $('btn-save-story-info');
    btn.textContent = 'Đang lưu...'; btn.disabled = true;

    try {
        let updatedCode = currentRawAstroCode;
        
        updatedCode = updatedCode.replace(/const title = "(.*?)";/, `const title = "${title.replace(/"/g, '\\"')}";`);
        updatedCode = updatedCode.replace(/const author = "(.*?)";/, `const author = "${author.replace(/"/g, '\\"')}";`);
        updatedCode = updatedCode.replace(/const description = "(.*?)";/, `const description = "${desc.replace(/"/g, '\\"')}";`);
        
        // Cập nhật mảng Tags
        if(tagsRaw.trim()) {
            const tagsFormatted = tagsRaw.split(',').map(t => `"${t.trim()}"`).join(', ');
            // Nếu đã có dòng const tags thì thay thế, nếu chưa có thì chèn vào
            if(/const tags = \[.*?\];/.test(updatedCode)) {
                updatedCode = updatedCode.replace(/const tags = \[.*?\];/, `const tags = [${tagsFormatted}];`);
            } else {
                updatedCode = updatedCode.replace(/const description = "(.*?)";/, `const description = "$1";\nconst tags = [${tagsFormatted}];`);
            }
        }
        
        updatedCode = updatedCode.replace(/<div class="desc">([\s\S]*?)<\/div>/, `<div class="desc">\n${body}\n  </div>`);

        let latestSha = currentEditStorySha;
        try {
            const check = await ghAPI(currentEditStoryPath);
            latestSha = check.sha;
        } catch(e){}
        
        await ghAPI(currentEditStoryPath, 'PUT', {
            message: `📝 Admin: Cập nhật thông tin truyện ${currentEditStoryId}`,
            content: b64Encode(updatedCode),
            sha: latestSha,
            branch: BRANCH
        });
        showToast('Lưu thông tin thành công!');
        closeModal('editStoryModal');
    } catch(e) {
        showToast('Lỗi khi lưu: ' + e.message, 'error');
    } finally {
        btn.textContent = '🚀 Lưu thay đổi'; btn.disabled = false;
    }
}

/* ==========================================================================
   QUẢN LÝ CHƯƠNG 
   ========================================================================== */
async function openStoryManager(id) {
  currentStory = storiesList.find(s => s.id === id);
  $('cl-title').textContent = `Chương truyện: ${currentStory.title}`;
  navTo('chapter-list');
  await fetchChapters();
}

async function fetchChapters() {
  $('chapTbody').innerHTML = '<tr><td colspan="5" style="text-align:center; padding:20px">⏳ Đang lấy dữ liệu từ GitHub...</td></tr>';
  try {
      const path = `/contents/src/pages/${currentStory.cat}/${currentStory.id}?ref=${BRANCH}`;
      const files = await ghAPI(path);
      loadedChapters = files.filter(f => f.name.endsWith('.md') && f.name !== 'index.md');
      renderChapTable(loadedChapters);
  } catch(e) {
      $('chapTbody').innerHTML = `<tr><td colspan="5" style="color:red">Lỗi: ${e.message}</td></tr>`;
  }
}

function renderChapTable(chaps) {
  if(!chaps || chaps.length === 0) {
      $('chapTbody').innerHTML = '<tr><td colspan="5" style="text-align:center; font-style:italic">Chưa có chương nào.</td></tr>';
      return;
  }
  
  $('chapTbody').innerHTML = chaps.map((f, i) => {
    const match = f.name.match(/chuong-(\d+)/);
    const num = match ? parseInt(match[1]) : i + 1;
    return `
    <tr>
      <td><input type="checkbox" class="chap-checkbox" data-name="${f.name}" data-sha="${f.sha}"></td>
      <td><b>${num}</b></td>
      <td><span style="color:var(--sky-dark); font-weight:bold">${f.name}</span></td>
      <td><span class="badge badge-pub">Published</span></td>
      <td style="display:flex; gap:5px">
        <button class="btn btn-outline btn-sm" onclick="openEditor('edit', '${f.name}', '${f.sha}')">✏️ Sửa</button>
        <button class="btn btn-red btn-sm" onclick="delChap('${f.name}', '${f.sha}')">🗑</button>
      </td>
    </tr>
  `}).join('');
}

function filterChapters() {
    const term = $('chapSearch').value.toLowerCase();
    const filtered = loadedChapters.filter(f => f.name.toLowerCase().includes(term));
    renderChapTable(filtered);
}

function sortChapters() {
    chapSortAsc = !chapSortAsc;
    const sorted = [...loadedChapters].sort((a,b) => {
        return chapSortAsc ? a.name.localeCompare(b.name) : b.name.localeCompare(a.name);
    });
    renderChapTable(sorted);
}

async function delChap(name, sha) {
    if(!confirm(`Xóa vĩnh viễn file ${name}?`)) return;
    try {
        await ghAPI(`/contents/src/pages/${currentStory.cat}/${currentStory.id}/${name}`, 'DELETE', {
            message: `🗑 Xóa chương: ${name}`, sha: sha, branch: BRANCH
        });
        showToast(`Đã xóa ${name}`);
        fetchChapters();
    } catch(e) { showToast('Lỗi khi xóa: ' + e.message, 'error'); }
}

function toggleSelectAllChaps(el) {
    document.querySelectorAll('.chap-checkbox').forEach(cb => cb.checked = el.checked);
}
async function bulkDeleteChaps() {
    const selected = Array.from(document.querySelectorAll('.chap-checkbox:checked'));
    if(selected.length === 0) return showToast('Chưa chọn chương nào!', 'error');
    if(!confirm(`Xóa ${selected.length} chương đã chọn? Quá trình này sẽ mất một lúc do gọi nhiều API.`)) return;
    
    let success = 0;
    for(const cb of selected) {
        try {
            await ghAPI(`/contents/src/pages/${currentStory.cat}/${currentStory.id}/${cb.dataset.name}`, 'DELETE', {
                message: `🗑 Bulk delete: ${cb.dataset.name}`, sha: cb.dataset.sha, branch: BRANCH
            });
            success++;
        } catch(e) { console.error(e); }
    }
    showToast(`Đã xóa thành công ${success}/${selected.length} chương.`);
    fetchChapters();
}


/* ==========================================================================
   EDITOR SOẠN THẢO 
   ========================================================================== */
let editorDraftInterval;

async function openEditor(mode, name, sha) {
  navTo('editor');
  currentChap = (mode === 'edit') ? { name, sha } : null;
  window.__currentRawFm = ""; 
  
  const draftKey = mode === 'new' ? `draft_new_${currentStory.id}` : `draft_edit_${currentStory.id}_${name}`;
  const draftData = localStorage.getItem(draftKey);
  
  if (mode === 'new') {
    $('ed-title').value = ''; 
    $('ed-num').value = ''; 
    $('ed-desc').value = '';
    $('ed-tags').value = '';
    $('ed-note').value = '';
    $('ed-content').value = '';
    
    if(draftData && confirm('Phát hiện bản nháp chưa lưu. Bạn có muốn khôi phục không?')) {
        const d = JSON.parse(draftData);
        $('ed-title').value = d.title; $('ed-content').value = d.content;
    }
  } else {
    $('ed-content').value = '⏳ Đang tải nội dung file từ GitHub...';
    try {
        const file = await ghAPI(`/contents/src/pages/${currentStory.cat}/${currentStory.id}/${name}?ref=${BRANCH}`);
        const raw = b64Decode(file.content.replace(/\n/g,''));
        
        const fmMatch = raw.match(/^---\n([\s\S]*?)\n---/);
        let body = raw;
        if(fmMatch) {
            body = raw.slice(fmMatch[0].length).trim();
            const fmText = fmMatch[1];
            window.__currentRawFm = fmText; 
            
            const getVal = (key) => { const m = fmText.match(new RegExp(`^${key}:\\s*(.+)$`, 'm')); return m ? m[1].replace(/^"|"$/g, '').trim() : ''; };
            
            // Xử lý Tag riêng vì nó là mảng
            const tagsMatch = fmText.match(/^tags:\s*\[(.*?)\]/m) || fmText.match(/^tags:\s*\n((?:  - .*\n?)+)/m);
            let tagsVal = '';
            if (tagsMatch) {
                if (tagsMatch[1].includes('-')) {
                    // Định dạng list: - "tag1"
                    tagsVal = tagsMatch[1].split('\n').map(t => t.replace(/-\s*"?|"?\s*$/g, '').trim()).filter(Boolean).join(', ');
                } else {
                    // Định dạng array: ["tag1", "tag2"]
                    tagsVal = tagsMatch[1].replace(/["']/g, '').split(',').map(s=>s.trim()).join(', ');
                }
            }

            $('ed-title').value = getVal('title');
            $('ed-num').value = getVal('chuong');
            $('ed-desc').value = getVal('description');
            $('ed-tags').value = tagsVal;
            $('ed-status').value = getVal('draft') === 'true' ? 'draft' : 'published';
            $('ed-note').value = getVal('editor_note');
        }
        $('ed-content').value = body;
        
        if(draftData && confirm('Có bản nháp cục bộ mới hơn file trên GitHub. Khôi phục?')) {
            $('ed-content').value = JSON.parse(draftData).content;
        }
    } catch(e) {
        showToast('Lỗi tải file: ' + e.message, 'error');
    }
  }
  
  updateWordCount();
  
  clearInterval(editorDraftInterval);
  editorDraftInterval = setInterval(() => {
      const data = { title: $('ed-title').value, content: $('ed-content').value, time: new Date().toLocaleTimeString() };
      localStorage.setItem(draftKey, JSON.stringify(data));
      $('ed-last-save').textContent = 'Đã lưu nháp lúc ' + data.time;
  }, 10000); 
}

function fmt(cmd) {
  const ta = $('ed-content');
  const start = ta.selectionStart;
  const end = ta.selectionEnd;
  const sel = ta.value.substring(start, end);
  let ins = '';
  
  if(cmd === 'bold') ins = `**${sel || 'chữ in đậm'}**`;
  if(cmd === 'italic') ins = `*${sel || 'chữ in nghiêng'}*`;
  if(cmd === 'underline') ins = `<u>${sel || 'chữ gạch chân'}</u>`;
  if(cmd === 'h2') ins = `\n## ${sel || 'Tiêu đề 2'}\n`;
  if(cmd === 'quote') ins = `\n> ${sel || 'Trích dẫn'}\n`;
  if(cmd === 'center') ins = `\n<div style="text-align:center">\n${sel || 'Nội dung căn giữa'}\n</div>\n`;
  if(cmd === 'hr') ins = `\n---\n`;
  if(cmd === 'color') {
    const color = $('ed-color-picker').value;
    ins = `<span style="color:${color}">${sel || 'chữ màu'}</span>`;
  }
  
  ta.value = ta.value.substring(0, start) + ins + ta.value.substring(end);
  ta.focus();
  ta.selectionEnd = start + ins.length;
  updateWordCount();
}

function findAndReplace() {
    const f = $('fr-find').value;
    const r = $('fr-replace').value;
    if(!f) return;
    const ta = $('ed-content');
    const regex = new RegExp(f, 'g');
    const matches = (ta.value.match(regex) || []).length;
    ta.value = ta.value.replace(regex, r);
    showToast(`Đã thay thế ${matches} chỗ.`);
    updateWordCount();
}

function updateWordCount() {
  const text = $('ed-content').value.trim();
  const words = text ? text.split(/\s+/).length : 0;
  $('ed-word-count').textContent = `${words} từ | ${text.length} ký tự`;
}
$('ed-content').oninput = updateWordCount;

let isPreview = false;
function togglePreview() {
    isPreview = !isPreview;
    const ta = $('ed-content');
    const pv = $('ed-preview');
    const btn = $('btn-preview-toggle');
    
    if(isPreview) {
        let html = ta.value
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
            .replace(/\*(.+?)\*/g, '<em>$1</em>')
            .replace(/^## (.+)$/gm, '<h2>$1</h2>')
            .replace(/^> (.+)$/gm, '<blockquote style="border-left:3px solid var(--sky); padding-left:10px; color:gray">$1</blockquote>')
            .replace(/\n\n/g, '</p><p>').replace(/\n/g, '<br>');
            
        html = html.replace(/&lt;span style=&quot;color:(.*?)&quot;&gt;(.*?)&lt;\/span&gt;/g, '<span style="color:$1">$2</span>');
        html = html.replace(/&lt;div style=&quot;text-align:center&quot;&gt;/g, '<div style="text-align:center">').replace(/&lt;\/div&gt;/g, '</div>');
        html = html.replace(/&lt;u&gt;(.*?)&lt;\/u&gt;/g, '<u>$1</u>');

        pv.innerHTML = `<p>${html}</p>`;
        ta.style.display = 'none';
        pv.style.display = 'block';
        btn.textContent = '✏️ Sửa';
    } else {
        ta.style.display = 'block';
        pv.style.display = 'none';
        btn.textContent = '👁 Xem trước';
    }
}

$('ed-saveBtn').onclick = async () => {
  if(!$('ed-title').value || !$('ed-num').value) return showToast('Vui lòng nhập Tiêu đề và Số chương', 'error');

  const btn = $('ed-saveBtn');
  btn.disabled = true; btn.textContent = 'Đang đẩy lên Git...';
  
  let finalFm = "";
  const tagsRaw = $('ed-tags').value;
  const tagsFormatted = tagsRaw ? `\n  - "` + tagsRaw.split(',').map(t => t.trim()).join('"\n  - "') + `"` : ' []';

  if (currentChap && window.__currentRawFm) {
      finalFm = window.__currentRawFm;
      
      const setKey = (key, val, isStr=true) => {
          const regex = new RegExp(`^${key}:.*$`, 'm');
          const strVal = isStr ? `"${val}"` : val;
          if (regex.test(finalFm)) {
              finalFm = finalFm.replace(regex, `${key}: ${strVal}`);
          } else {
              finalFm += `\n${key}: ${strVal}`;
          }
      };
      setKey('title', $('ed-title').value.replace(/"/g, '\\"'));
      setKey('chuong', parseInt($('ed-num').value), false);
      setKey('description', $('ed-desc').value.replace(/"/g, '\\"'));
      setKey('draft', $('ed-status').value === 'draft' ? 'true' : 'false', false);
      if($('ed-note').value) setKey('editor_note', $('ed-note').value.replace(/"/g, '\\"'));
      
      // Xử lý ghi đè mảng tags
      if (/^tags:\s*\[.*?\]/m.test(finalFm)) {
          finalFm = finalFm.replace(/^tags:\s*\[.*?\]/m, `tags: [${tagsRaw.split(',').map(t => `"${t.trim()}"`).join(', ')}]`);
      } else if (/^tags:\s*\n(?:  - .*\n?)+/m.test(finalFm)) {
          finalFm = finalFm.replace(/^tags:\s*\n(?:  - .*\n?)+/m, `tags:${tagsFormatted}\n`);
      } else {
          finalFm += `\ntags:${tagsFormatted}`;
      }

  } else {
      finalFm = `layout: "../../../layouts/Layout.astro"
title: "${$('ed-title').value.replace(/"/g, '\\"')}"
truyen_id: "${currentStory.shortId || currentStory.id}"
chuong: ${parseInt($('ed-num').value)}
date: "${new Date().toISOString().split('T')[0]}"
tags:${tagsFormatted}
description: "${$('ed-desc').value.replace(/"/g, '\\"')}"
draft: ${$('ed-status').value === 'draft' ? 'true' : 'false'}
editor_note: "${$('ed-note').value.replace(/"/g, '\\"')}"`;
  }
  
  const content = `---\n${finalFm.trim()}\n---\n\n${$('ed-content').value}`;
  
  const filename = currentChap ? currentChap.name : `chuong-${String($('ed-num').value).padStart(2,'0')}.md`;
  const path = `/contents/src/pages/${currentStory.cat}/${currentStory.id}/${filename}`;
  
  let latestSha = currentChap ? currentChap.sha : null;
  if(currentChap) {
      try {
          const checkFile = await ghAPI(path);
          latestSha = checkFile.sha;
      } catch(e){} 
  }
  
  try {
      const res = await ghAPI(path, 'PUT', {
        message: `🚀 Editor: Cập nhật ${filename}`,
        content: b64Encode(content),
        sha: latestSha,
        branch: BRANCH
      });
      
      showToast('Đã xuất bản thành công!');
      if(currentChap) { currentChap.sha = res.content.sha; }
      
      const draftKey = currentChap ? `draft_edit_${currentStory.id}_${currentChap.name}` : `draft_new_${currentStory.id}`;
      localStorage.removeItem(draftKey);
      
      setTimeout(()=> {
          openStoryManager(currentStory.id);
      }, 1000);
      
  } catch(e) {
      showToast('Lỗi khi lưu: ' + e.message, 'error');
  } finally {
      btn.disabled = false; btn.textContent = '🚀 Xuất bản (GitHub)';
  }
};

/* ==========================================================================
   BULK UPLOAD (ĐÃ NÂNG CẤP REGEX)
   ========================================================================== */
async function processBulkUpload() {
    const rawText = $('bulk-content').value;
    const target = $('bulk-story-select').value;
    if(!rawText || !target) return showToast('Vui lòng nhập nội dung và chọn truyện', 'error');
    
    const [cat, id, shortId] = target.split('|');
    const log = $('bulk-log');
    log.innerHTML = 'Bắt đầu xử lý...\n';
    
    // Thuật toán tách: Tìm chữ "Chương" có số đằng sau, nằm ở đầu một dòng mới
    const chapters = rawText.split(/(?=(?:^|\n)\s*Chương\s+\d+)/i).map(s => s.trim()).filter(s => s.length > 50);
    log.innerHTML += `Tìm thấy ${chapters.length} chương. Bắt đầu đẩy lên GitHub...\n\n`;
    
    let success = 0;
    for(const text of chapters) {
        const lines = text.split('\n');
        const titleLine = lines[0].trim();
        const numMatch = titleLine.match(/Chương\s+(\d+)/i);
        
        if(!numMatch) {
            log.innerHTML += `❌ Bỏ qua 1 đoạn không xác định được số chương.\n`;
            continue;
        }
        
        const num = parseInt(numMatch[1]);
        const titleMatch = titleLine.replace(/["']/g, ''); 
        
        const fm = `---
layout: "../../../layouts/Layout.astro"
title: "${titleMatch}"
truyen_id: "${shortId}"
chuong: ${num}
date: "${new Date().toISOString().split('T')[0]}"
---`;
        // Cắt bỏ dòng tiêu đề khỏi phần nội dung để tránh bị lặp lại khi đọc
        const bodyContent = lines.slice(1).join('\n').trim();
        const content = fm + '\n\n' + bodyContent;
        const filename = `chuong-${String(num).padStart(2,'0')}.md`;
        
        try {
            await ghAPI(`/contents/src/pages/${cat}/${id}/${filename}`, 'PUT', {
                message: `🚀 Bulk Upload: ${filename}`, content: b64Encode(content), branch: BRANCH
            });
            log.innerHTML += `✅ Đã đăng: ${filename}\n`;
            success++;
        } catch(e) {
            log.innerHTML += `❌ Lỗi đăng ${filename}: ${e.message}\n`;
        }
    }
    showToast(`Hoàn tất Bulk Upload! Thành công ${success}/${chapters.length}`);
}

/* ==========================================================================
   FIREBASE & CHART.JS
   ========================================================================== */
function loadFirebaseStats() {
  window.addEventListener('firebase-ready', () => {
    const db = window.__fbDb;
    const ref = window.__fbRef;
    const get = window.__fbGet;
    
    get(ref(db, 'page_views')).then(snap => {
      const data = snap.val() || {};
      let total = 0;
      const dailyDataAgg = {};
      
      for (const page in data) {
          total += (data[page].views || 0);
          if (data[page].daily) {
              dailyDataAgg[page] = data[page].daily;
          }
      }
      $('stat-views').textContent = total.toLocaleString();
      renderViewsChart(dailyDataAgg);
    });
    
    get(ref(db, 'private_messages')).then(snap => { $('stat-users').textContent = snap.size; });
    get(ref(db, 'comments')).then(snap => {
        let cmts = 0;
        snap.forEach(p => { cmts += p.size; });
        $('stat-cmts').textContent = cmts;
    });
  });
}

let viewsChartInstance = null;

function renderViewsChart(dailyData) {
    const ctx = document.getElementById('viewsChart');
    if(!ctx) return;
    
    const labels = [];
    const dataPoints = [];
    
    for (let i = 6; i >= 0; i--) {
        const d = new Date();
        d.setDate(d.getDate() - i);
        const dateStr = d.toISOString().split('T')[0]; 
        const shortDate = `${d.getDate()}/${d.getMonth()+1}`;
        
        labels.push(shortDate);
        let dailyTotal = 0;
        for (const page in dailyData) {
            if (dailyData[page] && dailyData[page][dateStr]) {
                dailyTotal += dailyData[page][dateStr];
            }
        }
        dataPoints.push(dailyTotal);
    }

    if(viewsChartInstance) viewsChartInstance.destroy();
    
    viewsChartInstance = new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [{
                label: 'Lượt xem toàn trang',
                data: dataPoints,
                borderColor: '#0ea5e9',
                backgroundColor: 'rgba(14, 165, 233, 0.1)',
                borderWidth: 2,
                pointBackgroundColor: '#0284c7',
                pointRadius: 4,
                fill: true,
                tension: 0.3
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.05)' }, ticks: { stepSize: 1 } },
                x: { grid: { display: false } }
            },
            plugins: {
                legend: { display: false }
            }
        }
    });
}

