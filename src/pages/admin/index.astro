  const body = document.getElementById('nc-content').value;

  if (!title || !chuong) { toast('Vui lòng nhập tiêu đề và số chương.', 'error'); return; }

  const btn = document.getElementById('ncSaveBtn');
  btn.innerHTML = '<span class="spinner"></span> Đang đăng...';
  btn.disabled = true;

  try {
    const chapNum = parseInt(chuong);
    const filename = `chuong-${String(chapNum).padStart(2, '0')}.md`;
    const filePath = `src/pages/${storyPath}/${filename}`;
    const content = buildMarkdown(title, storyId, chuong, todayISO(), tags, body);
    await putFile(filePath, content, `✏️ Đăng chương: ${title}`, null);
    toast('✅ Đăng chương thành công!', 'success', 4000);
    document.getElementById('nc-title').value = '';
    document.getElementById('nc-chuong').value = '';
    document.getElementById('nc-content').value = '';
    document.getElementById('ncWordCount').textContent = '0 ký tự';
  } catch(e) {
    toast(`❌ Lỗi: ${e.message}`, 'error', 5000);
  } finally {
    btn.innerHTML = '🚀 Đăng chương & Deploy';
    btn.disabled = false;
  }
});

// ═══════════════════════════════════════════════════════════
//  TOOLBAR
// ═══════════════════════════════════════════════════════════
document.querySelectorAll('.tool-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const targetId = btn.dataset.target || 'ef-content';
    const ta = document.getElementById(targetId);
    if (!ta) return;
    const start = ta.selectionStart, end = ta.selectionEnd;
    const selected = ta.value.slice(start, end);

    if (btn.dataset.wrap) {
      const before = btn.dataset.wrap, after = btn.dataset.wrapEnd || before;
      ta.value = ta.value.slice(0, start) + before + selected + after + ta.value.slice(end);
      ta.selectionStart = start + before.length;
      ta.selectionEnd = end + before.length;
    } else if (btn.dataset.insert) {
      const ins = btn.dataset.insert;
      ta.value = ta.value.slice(0, start) + ins + ta.value.slice(end);
      ta.selectionStart = ta.selectionEnd = start + ins.length;
    }
    ta.focus();
    updateWordCount();
  });
});

// Preview toggle
document.getElementById('previewToggleBtn')?.addEventListener('click', () => {
  const panel = document.getElementById('previewPanel');
  const ta = document.getElementById('ef-content');
  if (panel.style.display === 'none') {
    panel.style.display = 'block';
    // Simple markdown → HTML preview
    let html = ta.value
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.+?)\*/g, '<em>$1</em>')
      .replace(/^#### (.+)$/gm, '<h4>$1</h4>')
      .replace(/^## (.+)$/gm, '<h2>$1</h2>')
      .replace(/^> (.+)$/gm, '<blockquote>$1</blockquote>')
      .replace(/^---$/gm, '<hr>')
      .replace(/\n\n/g, '</p><p>')
      .replace(/\n/g, '<br>');
    panel.innerHTML = `<p>${html}</p>`;
    document.getElementById('previewToggleBtn').textContent = '✏️ Soạn';
    ta.style.display = 'none';
  } else {
    panel.style.display = 'none';
    ta.style.display = '';
    document.getElementById('previewToggleBtn').textContent = '👁 Preview';
  }
});

// Word count
function updateWordCount() {
  const ta = document.getElementById('ef-content');
  if (ta) document.getElementById('wordCount').textContent = `${wordCount(ta.value)} ký tự`;
}
document.getElementById('ef-content')?.addEventListener('input', updateWordCount);
document.getElementById('nc-content')?.addEventListener('input', () => {
  const ta = document.getElementById('nc-content');
  document.getElementById('ncWordCount').textContent = `${wordCount(ta.value)} ký tự`;
});

// Auto-slug from title for new story
document.getElementById('ns-title')?.addEventListener('input', e => {
  const slug = e.target.value
    .toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .replace(/đ/g, 'd').replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
  document.getElementById('ns-slug').value = slug;
});
</script>
</body>
</html>