// ═══════════════════════════════════════════════════════════
//  EDITOR & PARSER
// ═══════════════════════════════════════════════════════════
// Parser Frontmatter thông minh hỗ trợ boolean và ngoặc kép
function parseFrontmatter(text) {
  const match = text.match(/^---\n([\s\S]*?)\n---/);
  if (!match) return {};
  const fm = {};
  const lines = match[1].split('\n');
  let currentArr = null;
  
  for (const line of lines) {
    const kvMatch = line.match(/^(\w[\w_-]*):\s*(.*)/);
    if (kvMatch) {
      currentArr = null;
      const k = kvMatch[1];
      let v = kvMatch[2].trim();
      // Bỏ ngoặc kép ở hai đầu
      if(v.startsWith('"') && v.endsWith('"')) v = v.slice(1, -1);
      else if(v.startsWith("'") && v.endsWith("'")) v = v.slice(1, -1);
      
      if (v === '') { fm[k] = []; currentArr = fm[k]; }
      else if (v === 'true') fm[k] = true;
      else if (v === 'false') fm[k] = false;
      else fm[k] = isNaN(v) ? v : Number(v);
    } else if (line.match(/^\s+-\s+"?(.+?)"?\s*$/) && currentArr !== null) {
      let val = line.match(/^\s+-\s+"?([^"]+)"?\s*$/);
      if(val) currentArr.push(val[1]);
    }
  }
  return fm;
}

// Xây dựng Frontmatter mới chuẩn Astro Layout
function buildMarkdown(title, truyen_id, chuong, date, tags, desc, note, isDraft, body, layoutPath) {
  const tagList = tags.split(',').map(t => t.trim()).filter(Boolean);
  let fm = '---\n';
  if (layoutPath) fm += `layout: "${layoutPath}"\n`;
  fm += `title: "${title.replace(/"/g, '\\"')}"\n`;
  if (truyen_id) fm += `truyen_id: "${truyen_id}"\n`;
  if (chuong !== '' && chuong !== null) fm += `chuong: ${chuong}\n`;
  if (date) fm += `date: "${date}"\n`;
  if (desc) fm += `description: "${desc.replace(/"/g, '\\"')}"\n`;
  fm += `draft: ${isDraft}\n`;
  if (tagList.length > 0) {
    fm += `tags:\n${tagList.map(t => `  - "${t.replace(/"/g, '\\"')}"`).join('\n')}\n`;
  }
  if (note) fm += `editor_note: "${note.replace(/"/g, '\\"')}"\n`;
  fm += '---\n\n';
  return fm + body;
}

window.openEditor = async function(mode, filename = null) {
  editorMode = mode;
  showSection('editor');
  document.getElementById('editorBack').onclick = () => { showSection('chapter-list'); renderChapTable(); };

  const today = todayISO();

  if (mode === 'new') {
    document.getElementById('editorTitle').textContent = `Chương mới — ${currentStory.title}`;
    document.getElementById('ef-title').value = '';
    document.getElementById('ef-chuong').value = '';
    document.getElementById('ef-truyen-id').value = currentStory.id;
    document.getElementById('ef-date').value = today;
    document.getElementById('ef-tags').value = '';
    document.getElementById('ef-desc').value = '';
    document.getElementById('ef-note').value = '';
    document.getElementById('ef-draft').value = 'false';
    document.getElementById('ef-content').value = '';
    document.getElementById('editorStatus').textContent = '';
    currentFile = { filename: null, sha: null };
  } else {
    document.getElementById('editorTitle').textContent = `Sửa: ${filename}`;
    document.getElementById('editorStatus').textContent = '⏳ Đang tải...';
    try {
      const fd = await getFile(`${currentStory.path}/${filename}`);
      currentFile = { filename, sha: fd.sha, path: `${currentStory.path}/${filename}` };
      const fm = parseFrontmatter(fd.decoded);
      
      document.getElementById('ef-title').value = fm.title || '';
      document.getElementById('ef-chuong').value = fm.chuong || '';
      document.getElementById('ef-truyen-id').value = fm.truyen_id || currentStory.id;
      document.getElementById('ef-date').value = fm.date || today;
      document.getElementById('ef-tags').value = Array.isArray(fm.tags) ? fm.tags.join(', ') : (fm.tags || '');
      document.getElementById('ef-desc').value = fm.description || '';
      document.getElementById('ef-note').value = fm.editor_note || '';
      document.getElementById('ef-draft').value = fm.draft === true ? 'true' : 'false';
      
      const body = fd.decoded.replace(/^---[\s\S]*?---\s*/m, '').trim();
      document.getElementById('ef-content').value = body;
      document.getElementById('editorStatus').textContent = '✓ Tải thành công';
    } catch(e) {
      document.getElementById('editorStatus').textContent = `Lỗi: ${e.message}`;
    }
  }
  updateWordCount();
};

