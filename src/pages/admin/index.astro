// ═══════════════════════════════════════════════════════════
//  UTILS
// ═══════════════════════════════════════════════════════════
function toast(msg, type = 'info', dur = 3500) {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.className = `toast ${type} show`;
  clearTimeout(el._t);
  el._t = setTimeout(() => el.classList.remove('show'), dur);
}

function showSection(id) {
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.getElementById(`sec-${id}`)?.classList.add('active');
  document.querySelectorAll('.sidebar-link').forEach(l => {
    l.classList.toggle('active', l.dataset.section === id);
  });
}

function confirm(title, msg, onOk) {
  document.getElementById('confirmTitle').textContent = title;
  document.getElementById('confirmMsg').textContent = msg;
  document.getElementById('confirmOverlay').classList.add('open');
  confirmCallback = onOk;
}

document.getElementById('confirmOk').addEventListener('click', () => {
  document.getElementById('confirmOverlay').classList.remove('open');
  confirmCallback?.();
});
document.getElementById('confirmCancel').addEventListener('click', () => {
  document.getElementById('confirmOverlay').classList.remove('open');
});

function b64encode(str) {
  return btoa(unescape(encodeURIComponent(str)));
}
function b64decode(str) {
  return decodeURIComponent(escape(atob(str)));
}

function todayISO() {
  return new Date().toISOString().slice(0, 10);
}

function wordCount(str) {
  return str ? str.length : 0;
}

// ═══════════════════════════════════════════════════════════
//  GITHUB API
// ═══════════════════════════════════════════════════════════
async function ghFetch(endpoint, opts = {}) {
  const res = await fetch(`https://api.github.com${endpoint}`, {
    ...opts,
    headers: {
      Authorization: `token ${TOKEN}`,
      'Content-Type': 'application/json',
      Accept: 'application/vnd.github.v3+json',
      ...(opts.headers || {}),
    },
  });
  if (!res.ok) {
    const err = await res.json().catch(() => ({}));
    throw new Error(err.message || `HTTP ${res.status}`);
  }
  return res.json();
}

async function listDir(path) {
  return ghFetch(`/repos/${REPO}/contents/${path}?ref=${BRANCH}`);
}

async function getFile(path) {
  if (fileCache[path]) return fileCache[path];
  const data = await ghFetch(`/repos/${REPO}/contents/${path}?ref=${BRANCH}`);
  const content = b64decode(data.content.replace(/\n/g, ''));
  const result = { ...data, decoded: content };
  fileCache[path] = result;
  return result;
}

async function putFile(path, content, message, sha = null) {
  delete fileCache[path];
  const body = {
    message,
    content: b64encode(content),
    branch: BRANCH,
  };
  if (sha) body.sha = sha;
  return ghFetch(`/repos/${REPO}/contents/${path}`, {
    method: 'PUT',
    body: JSON.stringify(body),
  });
}

async function deleteFile(path, sha, message) {
  delete fileCache[path];
  return ghFetch(`/repos/${REPO}/contents/${path}`, {
    method: 'DELETE',
    body: JSON.stringify({ message, sha, branch: BRANCH }),
  });
}

// ═══════════════════════════════════════════════════════════
//  LOGIN
// ═══════════════════════════════════════════════════════════
document.getElementById('loginBtn').addEventListener('click', async () => {
  const token = document.getElementById('tokenInput').value.trim();
  const pass = document.getElementById('passInput').value;
  const errEl = document.getElementById('loginError');
  errEl.style.display = 'none';

  if (pass !== ADMIN_PASSWORD) {
    errEl.textContent = 'Mật khẩu không đúng.';
    errEl.style.display = 'block';
    return;
  }
  if (!token) {
    errEl.textContent = 'Vui lòng nhập GitHub Token.';
    errEl.style.display = 'block';
    return;
  }

  const btn = document.getElementById('loginBtn');
  btn.innerHTML = '<span class="spinner"></span> Đang kiểm tra...';
  btn.disabled = true;

  try {
    TOKEN = token;
    const user = await ghFetch('/user');
    document.getElementById('topbarUser').textContent = `👤 ${user.login}`;
    document.getElementById('loginScreen').style.display = 'none';
    document.getElementById('app').style.display = 'block';
    loadDashboard();
  } catch (e) {
    TOKEN = '';
    errEl.textContent = 'Token không hợp lệ hoặc không có quyền repo.';
    errEl.style.display = 'block';
  } finally {
    btn.innerHTML = 'Đăng nhập';
    btn.disabled = false;
  }
});

document.getElementById('logoutBtn').addEventListener('click', () => {
  TOKEN = ''; fileCache = {};
  document.getElementById('app').style.display = 'none';
  document.getElementById('loginScreen').style.display = 'flex';
  document.getElementById('tokenInput').value = '';
  document.getElementById('passInput').value = '';
});

// Enter key login
document.getElementById('passInput').addEventListener('keydown', e => {
  if (e.key === 'Enter') document.getElementById('loginBtn').click();
});

