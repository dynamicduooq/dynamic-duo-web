document.querySelectorAll('.sidebar-link').forEach(l => {
  l.addEventListener('click', () => navTo(l.dataset.nav));
});

function openModal(id) { $(id).classList.add('open'); }
function closeModal(id) { $(id).classList.remove('open'); }
let confirmCb = null;
function askConfirm(title, msg, cb) {
  $('confirmTitle').textContent = title; $('confirmMsg').innerHTML = msg;
  openModal('confirmModal'); confirmCb = cb;
}
$('confirmOkBtn').addEventListener('click', () => { closeModal('confirmModal'); if(confirmCb) confirmCb(); });

// ==========================================
// GITHUB API
// ==========================================
async function ghReq(endpoint, opts = {}) {
  const res = await fetch(`https://api.github.com/repos/${REPO}${endpoint}`, {
    ...opts,
    headers: { Authorization: `token ${GH_TOKEN}`, 'Content-Type': 'application/json', ...(opts.headers||{}) }
  });
  if (!res.ok) throw new Error(`GH Error: ${res.status}`);
  return res.json();
}
async function getFile(path) {
  const data = await ghReq(`/contents/${path}?ref=${BRANCH}`);
  return { ...data, decoded: b64d(data.content.replace(/\n/g, '')) };
}
async function putFile(path, content, message, sha=null) {
  const body = { message, content: b64e(content), branch: BRANCH };
  if(sha) body.sha = sha;
  return ghReq(`/contents/${path}`, { method: 'PUT', body: JSON.stringify(body) });
}
async function delFile(path, sha, message) {
  return ghReq(`/contents/${path}`, { method: 'DELETE', body: JSON.stringify({ message, sha, branch: BRANCH }) });
}

// ==========================================
// AUTH
// ==========================================
$('loginBtn').addEventListener('click', async () => {
  const token = $('ghToken').value.trim();
  const pass = $('adminPass').value;
  if (pass !== ADMIN_PASS) { $('loginError').textContent = 'Sai mật khẩu.'; $('loginError').style.display='block'; return; }
  if (!token) { $('loginError').textContent = 'Nhập Token.'; $('loginError').style.display='block'; return; }
  
  $('loginBtn').textContent = 'Đang kiểm tra...';
  try {
    const res = await fetch('https://api.github.com/user', { headers: { Authorization: `token ${token}` }});
    if(!res.ok) throw new Error();
    GH_TOKEN = token;
    $('loginScreen').style.display = 'none';
    $('app').style.display = 'block';
    navTo('dashboard');
  } catch(e) {
    $('loginError').textContent = 'Token vô hiệu hoặc lỗi mạng.'; $('loginError').style.display='block';
  }
  $('loginBtn').textContent = 'Đang nhập Hệ thống';
});
function logout() { GH_TOKEN=''; $('app').style.display='none'; $('loginScreen').style.display='flex'; }

// ==========================================
// SMART PARSER & MARKDOWN BUILDER
// ==========================================
function parseFM(md) {
  const match = md.match(/^---\n([\s\S]*?)\n---/);
  if (!match) return { body: md };
  const fm = {};
  const lines = match[1].split('\n');
  let curArr = null;
  for (const line of lines) {
    const kv = line.match(/^([a-zA-Z0-9_-]+):\s*(.*)/);
    if (kv) {
      curArr = null;
      let [_, k, v] = kv; v = v.trim();
      if (v.startsWith('"') && v.endsWith('"')) v = v.slice(1,-1);
      else if (v.startsWith("'") && v.endsWith("'")) v = v.slice(1,-1);
      if (v === '') { fm[k] = []; curArr = fm[k]; }
      else if (v === 'true') fm[k] = true;
      else if (v === 'false') fm[k] = false;
      else fm[k] = isNaN(v) ? v : Number(v);
    } else if (line.match(/^\s+-\s+"?(.+?)"?\s*$/) && curArr !== null) {
      curArr.push(line.match(/^\s+-\s+"?([^"]+)"?\s*$/)[1]);
    }
  }
  return { fm, body: md.replace(/^---\n[\s\S]*?\n---\n*/, '') };
}

function buildMD(fm, body) {
  let out = '---\n';
  // Bắt buộc nhồi layout Astro
  out += `layout: "../../../layouts/Layout.astro"\n`;
  for(const [k,v] of Object.entries(fm)) {
    if(k === 'layout') continue;
    if(Array.isArray(v)) {
      if(v.length > 0) out += `${k}:\n${v.map(i=>`  - "${i}"`).join('\n')}\n`;
    }
    else if(typeof v === 'boolean' || typeof v === 'number') out += `${k}: ${v}\n`;
    else out += `${k}: "${String(v).replace(/"/g, '\\"')}"\n`;
  }
  out += '---\n\n' + body;
  return out;
}

// ==========================================
// STORY & CHAPTER MANAGEMENT
// ==========================================
function renderStories() {
  const tbody = $('storyTbody');
  tbody.innerHTML = STORIES_DB.map(s => `
    <tr>
      <td style="font-weight:bold; color:var(--sky-dark);">${s.title}</td>
      <td><span class="badge ${s.cat==='ca-duoi-nuoc'?'badge-draft':'badge-live'}">${s.cat==='ca-duoi-nuoc'?'Đang tiến hành':'Hoàn thành'}</span></td>
      <td style="color:var(--text-dim); font-family:monospace;">src/pages/${s.cat}/${s.id}</td>
      <td><button class="btn btn-sky btn-sm" onclick="openStory('${s.id}')">Quản lý Chương</button></td>
    </tr>
  `).join('');
}

async function openStory(id) {
  currentStory = STORIES_DB.find(s => s.id === id);
  currentStory.path = `src/pages/${currentStory.cat}/${currentStory.id}`;
  $('cl-title').textContent = `Chương: ${currentStory.title}`;
  navTo('chapter-list');
  await loadChapters();
}

let cachedChapList = [];
async function loadChapters() {
  const tbody = $('chapTbody');
  tbody.innerHTML = `<tr><td colspan="6" style="text-align:center;">Đang tải danh sách từ GitHub...</td></tr>`;
  try {
    const files = await ghReq(`/contents/${currentStory.path}?ref=${BRANCH}`);
    cachedChapList = files.filter(f => f.name.endsWith('.md') && f.name !== 'index.md').sort((a,b)=>a.name.localeCompare(b.name));
    renderChapterTable();
  } catch(e) { tbody.innerHTML = `<tr><td colspan="6" style="color:red">Lỗi: ${e.message}</td></tr>`; }
}

function renderChapterTable(filterText = '') {
  const tbody = $('chapTbody');
  if(cachedChapList.length === 0) { tbody.innerHTML = '<tr><td colspan="6" style="text-align:center">Chưa có chương nào.</td></tr>'; return; }
  
  let html = '';
  cachedChapList.forEach((f, i) => {
    if(filterText && !f.name.includes(filterText)) return;
    const numMatch = f.name.match(/chuong-(\d+)/);
    const num = numMatch ? parseInt(numMatch[1]) : i+1;
    // Bỏ qua parse frontmatter toàn bộ ở list view để tăng tốc độ, chỉ lấy từ tên file
    html += `
      <tr data-sha="${f.sha}" data-name="${f.name}" draggable="false">
        <td><input type="checkbox" class="chap-check" value="${f.name}|${f.sha}" /></td>
        <td class="chap-num-cell" style="font-weight:bold;">${num}</td>
        <td><span class="drag-handle" style="display:none;">☰</span> ${f.name}</td>
        <td style="font-size:.8rem; color:var(--text-dim);">--</td>
        <td><span class="badge badge-live">Live</span></td>
        <td style="text-align:right;">
          <button class="btn btn-outline btn-sm" onclick="openEditor('edit', '${f.name}', '${f.sha}')">Sửa</button>
          <button class="btn btn-red btn-sm" onclick="singleDelete('${f.name}', '${f.sha}')">Xóa</button>
        </td>
      </tr>
    `;
  });
  tbody.innerHTML = html;
  setupDragAndDrop();
}

$('chapSearch').addEventListener('input', e => renderChapterTable(e.target.value.trim()));

// ==========================================
// BULK DELETE
// ==========================================
$('checkAllChaps').addEventListener('change', e => {
  document.querySelectorAll('.chap-check').forEach(cb => cb.checked = e.target.checked);
  toggleBulkDeleteBtn();
});
$('chapTbody').addEventListener('change', e => { if(e.target.classList.contains('chap-check')) toggleBulkDeleteBtn(); });

function toggleBulkDeleteBtn() {
  const checked = document.querySelectorAll('.chap-check:checked').length;
  $('bulkDeleteBtn').style.display = checked > 0 ? 'inline-flex' : 'none';
  $('bulkDeleteBtn').textContent = `🗑 Xóa ${checked} mục`;
}

$('bulkDeleteBtn').addEventListener('click', () => {
  const cbs = document.querySelectorAll('.chap-check:checked');
  askConfirm('Xóa hàng loạt', `Sắp xóa vĩnh viễn ${cbs.length} file. Tiếp tục?`, async () => {
    $('bulkDeleteBtn').textContent = 'Đang xóa...'; $('bulkDeleteBtn').disabled = true;
    for(const cb of cbs) {
      const [name, sha] = cb.value.split('|');
      try { await delFile(`${currentStory.path}/${name}`, sha, `Bulk delete ${name}`); } catch(e){}
    }
    toast('Đã xóa xong.', 'success');
    $('bulkDeleteBtn').style.display = 'none'; $('bulkDeleteBtn').disabled = false;
    $('checkAllChaps').checked = false;
    loadChapters();
  });
});

function singleDelete(name, sha) {
  askConfirm('Xóa file', `Xóa ${name}?`, async () => {
    try { await delFile(`${currentStory.path}/${name}`, sha, `Delete ${name}`); toast('Đã xóa', 'success'); loadChapters(); }
    catch(e) { toast('Lỗi xóa', 'error'); }
  });
}

// ==========================================
// REORDER (DRAG & DROP) - KÉO THẢ
// ==========================================
let isReordering = false;
$('toggleReorderBtn').addEventListener('click', () => {
  isReordering = !isReordering;
  $('toggleReorderBtn').textContent = isReordering ? '✅ Tắt Kéo thả' : '↕️ Bật Kéo thả Sắp xếp';
  $('toggleReorderBtn').classList.toggle('btn-green', isReordering);
  $('reorderNotice').style.display = isReordering ? 'block' : 'none';
  $('saveReorderWrap').style.display = isReordering ? 'block' : 'none';
  
  document.querySelectorAll('#chapTbody tr').forEach(tr => {
    tr.setAttribute('draggable', isReordering);
    tr.querySelector('.drag-handle').style.display = isReordering ? 'inline' : 'none';
  });
});

let draggedRow = null;
function setupDragAndDrop() {
  const tbody = $('chapTbody');
  tbody.addEventListener('dragstart', e => { if(!isReordering) return; draggedRow = e.target.closest('tr'); e.target.closest('tr').classList.add('dragging'); });
  tbody.addEventListener('dragend', e => { if(!isReordering) return; e.target.closest('tr').classList.remove('dragging'); });
  tbody.addEventListener('dragover', e => {
    if(!isReordering) return; e.preventDefault();
    const afterEl = getDragAfterElement(tbody, e.clientY);
    const row = e.target.closest('tr');
    if(row && row !== draggedRow) {
      if(afterEl == null) tbody.appendChild(draggedRow);
      else tbody.insertBefore(draggedRow, afterEl);
    }
  });
}
function getDragAfterElement(container, y) {
  const els = [...container.querySelectorAll('tr:not(.dragging)')];
  return els.reduce((closest, child) => {
    const box = child.getBoundingClientRect(); const offset = y - box.top - box.height / 2;
    if(offset < 0 && offset > closest.offset) return { offset: offset, element: child }; else return closest;
  }, { offset: Number.NEGATIVE_INFINITY }).element;
}

$('saveReorderBtn').addEventListener('click', async () => {
  const rows = document.querySelectorAll('#chapTbody tr');
  const updates = [];
  rows.forEach((tr, idx) => {
    const oldName = tr.dataset.name;
    const sha = tr.dataset.sha;
    const newNum = idx + 1;
    const expectedName = `chuong-${String(newNum).padStart(2,'0')}.md`;
    if(oldName !== expectedName) updates.push({ oldName, expectedName, sha });
  });

  if(updates.length === 0) { toast('Không có thay đổi nào cần lưu.', 'info'); return; }
  
  askConfirm('Lưu Thứ Tự', `Cần đổi tên ${updates.length} file thông qua API. Quá trình này sẽ mất thời gian.`, async () => {
    const btn = $('saveReorderBtn'); btn.disabled = true; btn.textContent = 'Đang xử lý (0/' + updates.length + ')...';
    // GitHub ko có rename trực tiếp qua REST API (trừ khi dùng Tree API phức tạp). 
    // Cách đơn giản nhất trên client: get content -> put new file -> delete old file.
    let done = 0;
    for(const u of updates) {
      try {
        const file = await getFile(`${currentStory.path}/${u.oldName}`);
        await putFile(`${currentStory.path}/${u.expectedName}`, file.decoded, `Rename to ${u.expectedName} (Reorder)`);
        await delFile(`${currentStory.path}/${u.oldName}`, u.sha, `Remove old name (Reorder)`);
        done++; btn.textContent = `Đang xử lý (${done}/${updates.length})...`;
      } catch(e) { console.error('Lỗi đổi tên', u.oldName, e); }
    }
    toast('Đã cập nhật thứ tự xong!', 'success');
    btn.disabled = false; btn.textContent = '💾 Lưu Thứ Tự Mới';
    loadChapters();
  });
});

// ==========================================
// EDITOR CORE
// ==========================================
let autoSaveInterval;

async function openEditor(mode, filename = null, sha = null) {
  navTo('editor');
  $('ed-title').textContent = mode === 'new' ? `Tạo Chương - ${currentStory.title}` : `Sửa - ${filename}`;
  $('ed-saveBtn').textContent = '💾 Lưu & Publish';
  $('ed-preview').style.display = 'none'; $('ed-content').style.display = 'block'; $('btnPreview').textContent = '👁 Xem trước';
  $('snrBar').classList.remove('open');
  $('ed-autosave-status').textContent = '';

  const clearForm = () => {
    ['ed-tieude','ed-so','ed-tags','ed-desc','ed-note','ed-commit','ed-content'].forEach(id => $(id).value = '');
    $('ed-draft').value = 'false'; $('ed-words').textContent = '0 từ';
  };

  if(mode === 'new') {
    currentChap = null; clearForm();
    // Auto fill next chap num
    $('ed-so').value = cachedChapList.length + 1;
    $('ed-tieude').value = `Chương ${cachedChapList.length + 1} - `;
  } else {
    clearForm();
    currentChap = { path: `${currentStory.path}/${filename}`, sha };
    $('ed-saveBtn').textContent = '⏳ Đang tải...'; $('ed-saveBtn').disabled = true;
    try {
      const data = await getFile(currentChap.path);
      const parsed = parseFM(data.decoded);
      
      $('ed-tieude').value = parsed.fm.title || '';
      $('ed-so').value = parsed.fm.chuong || '';
      $('ed-tags').value = parsed.fm.tags ? (Array.isArray(parsed.fm.tags) ? parsed.fm.tags.join(', ') : parsed.fm.tags) : '';
      $('ed-desc').value = parsed.fm.description || '';
      $('ed-note').value = parsed.fm.editor_note || '';
      $('ed-draft').value = parsed.fm.draft ? 'true' : 'false';
      $('ed-content').value = parsed.body.trim();
      $('ed-words').textContent = `${wordCount(parsed.body)} từ`;
    } catch(e) { toast('Lỗi tải file', 'error'); }
    $('ed-saveBtn').textContent = '💾 Lưu & Publish'; $('ed-saveBtn').disabled = false;
  }

  // Bật Auto-save
  clearInterval(autoSaveInterval);
  autoSaveInterval = setInterval(() => {
    const data = { title: $('ed-tieude').value, content: $('ed-content').value };
    localStorage.setItem('dd_autosave', JSON.stringify(data));
    const now = new Date();
    $('ed-autosave-status').textContent = `Đã lưu nháp local lúc ${now.getHours()}:${String(now.getMinutes()).padStart(2,'0')}:${String(now.getSeconds()).padStart(2,'0')}`;
  }, 10000); // Lưu mỗi 10s
}

// FORMAT TOOLBAR
document.querySelectorAll('.tool-fmt').forEach(btn => {
  btn.addEventListener('click', () => {
    const cmd = btn.dataset.cmd; const ta = $('ed-content');
    const s = ta.selectionStart; const e = ta.selectionEnd; const sel = ta.value.substring(s, e);
    let pre = '', suf = '';
    
    if(cmd === 'bold') { pre = '**'; suf = '**'; }
    if(cmd === 'italic') { pre = '*'; suf = '*'; }
    if(cmd === 'underline') { pre = '<u>'; suf = '</u>'; }
    if(cmd === 'h2') { pre = '\n## '; suf = '\n'; }
    if(cmd === 'h3') { pre = '\n### '; suf = '\n'; }
    if(cmd === 'quote') { pre = '\n> '; suf = '\n'; }
    if(cmd === 'hr') { pre = '\n---\n'; suf = ''; }
    if(cmd === 'center') { pre = '<div style="text-align:center">'; suf = '</div>'; }
    if(cmd === 'color') { const c = $('ed-color').value; pre = `<span style="color:${c}">`; suf = '</span>'; }

    ta.value = ta.value.substring(0,s) + pre + sel + suf + ta.value.substring(e);
    ta.focus(); ta.selectionStart = s + pre.length; ta.selectionEnd = s + pre.length + sel.length;
    $('ed-words').textContent = `${wordCount(ta.value)} từ`;
  });
});

// SEARCH & REPLACE
$('btnToggleSnr').addEventListener('click', () => $('snrBar').classList.toggle('open'));
$('btnReplaceAll').addEventListener('click', () => {
  const f = $('snrFind').value; const r = $('snrReplace').value; const ta = $('ed-content');
  if(!f) return;
  ta.value = ta.value.split(f).join(r);
  toast(`Đã thay thế toàn bộ "${f}"`, 'success');
});

// PREVIEW
$('btnPreview').addEventListener('click', () => {
  const ta = $('ed-content'); const pv = $('ed-preview');
  if(ta.style.display !== 'none') {
    ta.style.display = 'none'; pv.style.display = 'block'; $('btnPreview').textContent = '✏️ Chỉnh sửa';
    let h = ta.value.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/\*(.*?)\*/g, '<em>$1</em>')
      .replace(/^## (.*)$/gm, '<h2>$1</h2>').replace(/^### (.*)$/gm, '<h3>$1</h3>')
      .replace(/^> (.*)$/gm, '<blockquote style="border-left:3px solid var(--sky-light); padding-left:10px; color:var(--text-mid)">$1</blockquote>')
      .replace(/^---$/gm, '<hr>')
      .replace(/\n\n/g, '</p><p>').replace(/\n/g, '<br>');
    pv.innerHTML = `<p>${h}</p>`;
  } else {
    ta.style.display = 'block'; pv.style.display = 'none'; $('btnPreview').textContent = '👁 Xem trước';
  }
});

// SAVE CHAPTER
$('ed-saveBtn').addEventListener('click', async () => {
  const tieude = $('ed-tieude').value.trim(); const so = parseInt($('ed-so').value);
  if(!tieude || isNaN(so)) { toast('Lỗi: Cần nhập tiêu đề và số chương!', 'error'); return; }
  
  const fm = {
    title: tieude, truyen_id: currentStory.id, chuong: so, date: getISODate(),
    description: $('ed-desc').value.trim(), editor_note: $('ed-note').value.trim(),
    draft: $('ed-draft').value === 'true', tags: $('ed-tags').value.split(',').map(x=>x.trim()).filter(Boolean)
  };
  const body = $('ed-content').value;
  const content = buildMD(fm, body);
  const commitMsg = $('ed-commit').value.trim() || (currentChap ? `Sửa: ${tieude}` : `Tạo: ${tieude}`);
  const filename = `chuong-${String(so).padStart(2,'0')}.md`;
  const path = `${currentStory.path}/${filename}`;

  const btn = $('ed-saveBtn'); btn.disabled = true; btn.textContent = 'Đang lưu...';
  try {
    await putFile(path, content, commitMsg, currentChap ? currentChap.sha : null);
    toast('Lưu thành công!', 'success');
    clearInterval(autoSaveInterval); localStorage.removeItem('dd_autosave');
    navTo('chapter-list'); loadChapters();
  } catch(e) { toast('Lỗi lưu file: ' + e.message, 'error'); }
  btn.disabled = false; btn.textContent = '💾 Lưu & Publish';
});

// ==========================================
// BULK UPLOAD
// ==========================================
function openBulkUpload() { openModal('bulkUploadModal'); }
$('bulkProcessBtn').addEventListener('click', async () => {
  const text = $('bulkText').value;
  if(!text.trim()) return;
  // Cắt bằng regex tìm chữ "Chương " hoặc "Chương X" ở đầu dòng
  const rawChaps = text.split(/^(?=Chương\s+\d+)/m).filter(c => c.trim().length > 0);
  if(rawChaps.length === 0) { toast('Không tìm thấy chương nào', 'error'); return; }
  
  askConfirm('Xử lý Hàng loạt', `Phát hiện ${rawChaps.length} chương. Đẩy tất cả lên Github? (Sẽ mất thời gian)`, async () => {
    closeModal('bulkUploadModal');
    const btn = $('bulkUploadBtn'); if(btn) btn.disabled=true;
    let done = 0;
    
    // Tìm max số chương hiện tại
    let maxNum = cachedChapList.length;

    for(const block of rawChaps) {
      const lines = block.split('\n');
      const titleLine = lines[0].trim();
      const body = lines.slice(1).join('\n').trim();
      maxNum++;
      
      const fm = { title: titleLine, truyen_id: currentStory.id, chuong: maxNum, date: getISODate(), draft: false };
      const content = buildMD(fm, body);
      const filename = `chuong-${String(maxNum).padStart(2,'0')}.md`;
      try {
        await putFile(`${currentStory.path}/${filename}`, content, `Bulk upload: ${titleLine}`);
        done++; toast(`Đã upload ${done}/${rawChaps.length}`);
      } catch(e) { console.error('Bulk Lỗi', e); }
    }
    toast(`Đã dán xong ${done} chương!`, 'success');
    loadChapters();
  });
});

// ==========================================
// FIREBASE MODULES (VIEWS, COMMENTS, MSGS)
// ==========================================
function loadFirebaseDashboard() {
  window.addEventListener('firebase-ready', () => {
    if(!window.__fbDb) return;
    const { ref, get } = window;
    
    // Lấy tổng Views
    window.__fbGet(window.__fbRef(window.__fbDb, 'page_views')).then(snap => {
      const v = snap.val() || {};
      let totalViews = 0;
      const viewList = [];
      for(const [k, obj] of Object.entries(v)) { totalViews += obj.views || 0; viewList.push({path: k, views: obj.views}); }
      $('db-views').textContent = totalViews;
      
      // Render chart
      viewList.sort((a,b)=>b.views - a.views);
      const top5 = viewList.slice(0, 5);
      const chart = $('viewChart');
      if(top5.length > 0) {
        const maxV = top5[0].views;
        chart.innerHTML = top5.map(item => {
          const h = (item.views / maxV) * 100;
          return `<div style="flex:1; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; height:100%;"><div class="chart-bar" style="height:${h}%; width:50%;"><div class="chart-val">${item.views}</div><div class="chart-label" style="text-overflow:ellipsis; overflow:hidden; width:100%; text-align:center;">${item.path.slice(0,10)}</div></div></div>`;
        }).join('');
      } else { chart.innerHTML = '<div style="color:var(--text-dim)">Chưa có view</div>'; }
    });

    // Lấy tổng Comments
    window.__fbGet(window.__fbRef(window.__fbDb, 'comments')).then(snap => {
      const v = snap.val() || {};
      let total = 0;
      for(const key of Object.keys(v)) { total += Object.keys(v[key]).length; }
      $('db-comments').textContent = total;
    });

    $('db-stories').textContent = STORIES_DB.length;
  });
  if(window.__fbDb) window.dispatchEvent(new Event('firebase-ready')); // Triger if already loaded
}

function renderFirebaseComments() {
  const list = $('fbCommentsList');
  if(!window.__fbDb) { list.innerHTML='Chưa kết nối DB.'; return; }
  
  window.__fbOnValue(window.__fbRef(window.__fbDb, 'comments'), snap => {
    const data = snap.val() || {};
    let allCmts = [];
    Object.entries(data).forEach(([pageKey, cmtsObj]) => {
      Object.entries(cmtsObj).forEach(([cId, cData]) => {
        allCmts.push({ ...cData, pageKey, id: cId });
      });
    });
    allCmts.sort((a,b) => b.ts - a.ts);
    
    if(allCmts.length === 0) { list.innerHTML='Chưa có bình luận nào.'; return; }
    
    list.innerHTML = allCmts.map(c => `
      <div class="fb-item">
        <div class="fb-item-hd">
          <strong style="color:var(--sky-dark)">${c.name}</strong> 
          <span style="color:var(--text-dim); font-size:.75rem;">Trên trang: ${c.pageKey} • ${new Date(c.ts).toLocaleString()}</span>
        </div>
        <div class="fb-item-body">${c.text}</div>
        <div style="text-align:right">
          <button class="btn btn-red btn-sm" onclick="delFbNode('comments/${c.pageKey}/${c.id}')">Xóa</button>
        </div>
      </div>
    `).join('');
  });
}

function renderFirebaseMessages() {
  const list = $('fbMessagesList');
  if(!window.__fbDb) return;
  window.__fbOnValue(window.__fbRef(window.__fbDb, 'private_messages'), snap => {
    const data = snap.val() || {};
    let allMsgs = [];
    Object.entries(data).forEach(([tok, msgs]) => {
      Object.entries(msgs).forEach(([mid, mData]) => { allMsgs.push({ ...mData, token: tok, id: mid }); });
    });
    allMsgs.sort((a,b) => b.ts - a.ts);
    
    list.innerHTML = allMsgs.map(m => `
      <div class="fb-item" style="border-left: 4px solid ${m.adminReply?'var(--green)':'var(--sky)'}">
        <div class="fb-item-hd">
          <strong style="color:var(--sky-dark)">${m.name}</strong>
          <span style="color:var(--text-dim); font-size:.75rem;">${new Date(m.ts).toLocaleString()}</span>
        </div>
        <div class="fb-item-body">${m.text}</div>
        ${m.adminReply ? `<div style="background:#dcfce7; padding:8px; border-radius:4px; font-size:.8rem; margin-bottom:8px;">↩ Đã rep: ${m.adminReply.text}</div>` : ''}
        <div style="display:flex; gap:6px;">
          <input type="text" id="rep-${m.token}-${m.id}" placeholder="Reply..." style="flex:1; padding:4px 8px; border:1px solid #ccc; border-radius:4px;" />
          <button class="btn btn-sky btn-sm" onclick="replyMsg('${m.token}', '${m.id}')">Gửi</button>
          <button class="btn btn-red btn-sm" onclick="delFbNode('private_messages/${m.token}/${m.id}')">Xóa</button>
        </div>
      </div>
    `).join('');
  });
}

window.delFbNode = function(path) {
  askConfirm('Xóa Data Firebase', 'Xóa mục này vĩnh viễn khỏi DB?', () => {
    window.__fbRemove(window.__fbRef(window.__fbDb, path)).then(()=>toast('Đã xóa','success'));
  });
}
window.replyMsg = async function(tok, mid) {
  const text = $(`rep-${tok}-${mid}`).value.trim();
  if(!text) return;
  try {
    const { update } = await import('https://www.gstatic.com/firebasejs/10.12.2/firebase-database.js');
    await update(window.__fbRef(window.__fbDb, `private_messages/${tok}/${mid}/adminReply`), { text, ts: Date.now() });
    toast('Đã reply thành công', 'success');
  } catch(e) { toast('Lỗi rep', 'error'); }
}

// ==========================================
// SYSTEM SETTINGS (JSON)
// ==========================================
async function loadSettingsJson() {
  const ta = $('sys-json');
  ta.value = 'Đang tải src/data/settings.json...';
  try {
    const f = await getFile('src/data/settings.json');
    ta.value = f.decoded;
    ta.dataset.sha = f.sha;
  } catch(e) { ta.value = '{\n  "site_name": "dynamic duo",\n  "tagline": "paired dreams, boundless gleam"\n}'; }
}

$('saveSysJsonBtn').addEventListener('click', async () => {
  const text = $('sys-json').value;
  try { JSON.parse(text); } catch(e) { toast('JSON không hợp lệ!', 'error'); return; }
  
  $('saveSysJsonBtn').textContent = 'Đang lưu...';
  try {
    await putFile('src/data/settings.json', text, '⚙️ Cập nhật settings.json', $('sys-json').dataset.sha);
    toast('Lưu settings thành công!', 'success');
    loadSettingsJson();
  } catch(e) { toast('Lỗi lưu', 'error'); }
  $('saveSysJsonBtn').textContent = '💾 Lưu Cấu hình';
});

// ==========================================
// BACKUP (ZIP EXPORT)
// ==========================================
$('btnRunBackup').addEventListener('click', async () => {
  if (typeof JSZip === 'undefined') { toast('Thư viện JSZip chưa load. Tải lại trang.', 'error'); return; }
  const btn = $('btnRunBackup');
  const prog = $('backupProgress');
  btn.disabled = true;
  prog.textContent = 'Đang quét toàn bộ file...';
  
  try {
    const zip = new JSZip();
    let totalFiles = 0;
    
    // Quét từng truyện
    for(const story of STORIES_DB) {
      prog.textContent = `Đang tải: ${story.title}...`;
      try {
        const files = await ghReq(`/contents/src/pages/${story.cat}/${story.id}?ref=${BRANCH}`);
        const chaps = files.filter(f => f.name.endsWith('.md'));
        const folder = zip.folder(story.id);
        
        for(let i=0; i<chaps.length; i++) {
          const fileData = await getFile(chaps[i].path);
          folder.file(chaps[i].name, fileData.decoded);
          totalFiles++;
          prog.textContent = `Đã nén ${totalFiles} file...`;
        }
      } catch(e) { console.error('Skip', story.id); }
    }
    
    prog.textContent = 'Đang tạo file ZIP...';
    const blob = await zip.generateAsync({type:"blob"});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = `dynamic-duo-backup-${getISODate()}.zip`;
    a.click();
    URL.revokeObjectURL(url);
    
    prog.textContent = `Hoàn tất tải xuống ${totalFiles} file!`;
    toast('Backup thành công!', 'success', 5000);
  } catch(e) {
    prog.textContent = 'Lỗi Backup: ' + e.message;
  }
  btn.disabled = false;
});

// Initial check local storage for autosave
if(localStorage.getItem('dd_autosave')) {
  setTimeout(()=>toast('Bạn có bản nháp chưa lưu. Mở Trình Soạn Thảo để tiếp tục.', 'info', 5000), 2000);
}
</script>
