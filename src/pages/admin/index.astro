    <h3 style="margin-top:0; border-bottom:1px solid var(--sky-light); padding-bottom:10px; color:var(--sky-dark)">Tạo Truyện Mới</h3>
    
    <div class="field"><label>Tên bộ truyện</label><input type="text" id="st-title" placeholder="VD: Sương mù tháng tám" /></div>
