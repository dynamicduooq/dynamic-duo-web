  const isDraft = document.getElementById('ef-draft').value === 'true';
  const body = document.getElementById('ef-content').value;

  if (!title) { toast('Vui lòng nhập tiêu đề chương.', 'error'); return; }

  const btn = document.getElementById('saveBtn');
  btn.innerHTML = '<span class="spinner"></span> Đang đẩy lên Web...';
  btn.disabled = true;

  try {
    let filePath, filename, sha;
    // Xử lý Layout Path: Đi ngược 3 thư mục từ src/pages/cat/truyen/chuong.md về src/layouts/Layout.astro
    let layoutPath = "../../../layouts/Layout.astro";

    if (editorMode === 'edit' || editorMode === 'edit-index') {
      filePath = currentFile.path;
      filename = currentFile.filename;
      sha = currentFile.sha;
    } else {
      const chapNum = chuong ? parseInt(chuong) : 1;
      filename = `chuong-${String(chapNum).padStart(2, '0')}.md`;
      filePath = `${currentStory.path}/${filename}`;
      sha = null;
    }

    const content = buildMarkdown(title, truyen_id, chuong, date, tags, desc, note, isDraft, body, layoutPath);
    const commitMsg = editorMode === 'new' ? `✏️ Đăng chương: ${title}` : `📝 Cập nhật: ${title}`;

    await putFile(filePath, content, commitMsg, sha);
    currentFile.sha = null;
    toast('✅ Đã lưu & cập nhật Web thành công!', 'success', 4000);
    document.getElementById('editorStatus').textContent = '✓ Mới lưu tức thì';

    if (editorMode === 'new') {
      currentFile = { filename, sha: null, path: filePath };
      editorMode = 'edit';
    }
  } catch(e) {
    toast(`❌ Lỗi hệ thống: ${e.message}`, 'error', 5000);
  } finally {
    btn.innerHTML = '💾 Lưu & Cập nhật';
    btn.disabled = false;
  }
});

// DELETE Action
window.deleteChap = function(filename, sha) {
  confirm('Xoá chương truyện', `Cẩn thận! Bạn có chắc chắn muốn xoá vĩnh viễn chương "${filename}" không? Hành động này không thể lấy lại được.`, async () => {
    try {
      await deleteFile(`${currentStory.path}/${filename}`, sha, `🗑 Xoá chương: ${filename}`);
      toast('Đã xoá sạch sẽ.', 'success');
      await renderChapTable();
    } catch(e) { toast(`Lỗi: ${e.message}`, 'error'); }
  });
};

// ═══════════════════════════════════════════════════════════
//  NEW STORY
// ═══════════════════════════════════════════════════════════
document.getElementById('createStoryBtn').addEventListener('click', async () => {
  const title = document.getElementById('ns-title').value.trim();
  const slug = document.getElementById('ns-slug').value.trim();
  const author = document.getElementById('ns-author').value.trim();
  const cat = document.getElementById('ns-cat').value;
  const tags = document.getElementById('ns-tags').value;
  const desc = document.getElementById('ns-desc').value.trim();
  const body = document.getElementById('ns-body').value;

  if (!title || !slug) { toast('Phải nhập tên truyện và mã truyện.', 'error'); return; }

  const btn = document.getElementById('createStoryBtn');
  btn.innerHTML = '<span class="spinner"></span> Đang tạo nhà mới...';
  btn.disabled = true;

  try {
    const tagList = tags.split(',').map(t => t.trim()).filter(Boolean);
    const storyId = slug.replace(/-/g, '');
    let fm = `---\nlayout: "../../../layouts/Layout.astro"\ntitle: "${title}"\ntruyen_id: "${storyId}"\nstatus: "${cat === 'ca-duoi-nuoc' ? 'ongoing' : 'completed'}"\nauthor: "${author}"\ndescription: "${desc.replace(/"/g, '\\"')}"\n`;
    if (tagList.length) fm += `tags:\n${tagList.map(t => `  - "${t}"`).join('\n')}\n`;
    fm += `---\n\n${body}`;

    const path = `src/pages/${cat}/${slug}/index.md`;
    await putFile(path, fm, `📚 Tạo bộ truyện mới: ${title}`, null);
    toast('✅ Đã thả cá thành công!', 'success', 4000);

    ['ns-title','ns-slug','ns-author','ns-tags','ns-desc','ns-body'].forEach(id => { document.getElementById(id).value = ''; });
  } catch(e) {
    toast(`❌ Lỗi: ${e.message}`, 'error', 5000);
  } finally {
    btn.innerHTML = '🚀 Khởi tạo & Đưa lên Web';
    btn.disabled = false;
  }
});

// ═══════════════════════════════════════════════════════════
//  NEW CHAPTER SHORTCUT
// ═══════════════════════════════════════════════════════════
document.getElementById('ncSaveBtn').addEventListener('click', async () => {
  const storyVal = document.getElementById('nc-story').value;
  const [storyPath, storyId] = storyVal.split('|');
  const title = document.getElementById('nc-title').value.trim();
  const chuong = document.getElementById('nc-chuong').value;
  const tags = document.getElementById('nc-tags').value;
  const note = document.getElementById('nc-note').value.trim();
  const isDraft = document.getElementById('nc-draft').value === 'true';
  const body = document.getElementById('nc-content').value;

  if (!title || !chuong) { toast('Nhập tên và số chương nhé.', 'error'); return; }

  const btn = document.getElementById('ncSaveBtn');
  btn.innerHTML = '<span class="spinner"></span> Bay lên web...';
  btn.disabled = true;

  try {
    const chapNum = parseInt(chuong);
    const filename = `chuong-${String(chapNum).padStart(2, '0')}.md`;
    const filePath = `src/pages/${storyPath}/${filename}`;
    const layoutPath = "../../../layouts/Layout.astro";
    
    const content = buildMarkdown(title, storyId, chuong, todayISO(), tags, "", note, isDraft, body, layoutPath);
    await putFile(filePath, content, `✏️ Đăng chương nhanh: ${title}`, null);
    
    toast('✅ Lên sóng thành công!', 'success', 4000);
    document.getElementById('nc-title').value = '';
    document.getElementById('nc-chuong').value = '';
    document.getElementById('nc-content').value = '';
    document.getElementById('nc-note').value = '';
    document.getElementById('ncWordCount').textContent = '0 từ';
  } catch(e) {
    toast(`❌ Úi lỗi rồi: ${e.message}`, 'error', 5000);
  } finally {
    btn.innerHTML = '🚀 Xuất bản Chương';
    btn.disabled = false;
  }
});

// ═══════════════════════════════════════════════════════════
//  TOOLBAR & PREVIEW
// ═══════════════════════════════════════════════════════════
document.querySelectorAll('.tool-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const targetId = btn.dataset.target || 'ef-content';
    const ta = document.getElementById(targetId);
    if (!ta) return;
    const start = ta.selectionStart, end = ta.selectionEnd;
    const selected = ta.value.slice(start, end);

    if (btn.dataset.wrap) {
      const before = btn.dataset.wrap, after = btn.dataset.wrapEnd || before;
      ta.value = ta.value.slice(0, start) + before + selected + after + ta.value.slice(end);
      ta.selectionStart = start + before.length;
      ta.selectionEnd = end + before.length;
    } else if (btn.dataset.insert) {
      const ins = btn.dataset.insert;
      ta.value = ta.value.slice(0, start) + ins + ta.value.slice(end);
      ta.selectionStart = ta.selectionEnd = start + ins.length;
    }
    ta.focus();
    updateWordCount();
  });
});

document.getElementById('previewToggleBtn')?.addEventListener('click', () => {
  const panel = document.getElementById('previewPanel');
  const ta = document.getElementById('ef-content');
  if (panel.style.display === 'none') {
    panel.style.display = 'block';
    let html = ta.value
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.+?)\*/g, '<em>$1</em>')
      .replace(/^#### (.+)$/gm, '<h4>$1</h4>')
      .replace(/^## (.+)$/gm, '<h2>$1</h2>')
      .replace(/^> (.+)$/gm, '<blockquote style="border-left:3px solid var(--sky-light); padding-left:15px; margin-left:0; font-style:italic; color:var(--text-mid)">$1</blockquote>')
      .replace(/^---$/gm, '<hr style="border:none; text-align:center; margin:30px 0;"><div style="text-align:center; color:var(--sky-light); letter-spacing:5px;">𓆝 𓆟 𓆞</div>')
      .replace(/\n\n/g, '</p><p style="text-align:justify">')
      .replace(/\n/g, '<br>');
    panel.innerHTML = `<p style="text-align:justify">${html}</p>`;
    document.getElementById('previewToggleBtn').textContent = '✏️ Quay lại Sửa';
    ta.style.display = 'none';
  } else {
    panel.style.display = 'none';
    ta.style.display = '';
    document.getElementById('previewToggleBtn').textContent = '👁 Xem trước';
  }
});

function updateWordCount() {
  const ta = document.getElementById('ef-content');
  if (ta) document.getElementById('wordCount').textContent = `${wordCount(ta.value)} từ`;
}
document.getElementById('ef-content')?.addEventListener('input', updateWordCount);
document.getElementById('nc-content')?.addEventListener('input', () => {
  const ta = document.getElementById('nc-content');
  document.getElementById('ncWordCount').textContent = `${wordCount(ta.value)} từ`;
});

// Tạo mã truyện tự động khi gõ tên
document.getElementById('ns-title')?.addEventListener('input', e => {
  const slug = e.target.value
    .toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .replace(/đ/g, 'd').replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
  document.getElementById('ns-slug').value = slug;
});
</script>
</body>
