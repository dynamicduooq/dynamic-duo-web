---
// src/pages/admin/index.astro
// Siêu Admin Panel: Quản lý toàn diện Website Dynamic Duo
---

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Siêu Admin · Dynamic Duo</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=Literata:wght@400;600&display=swap" rel="stylesheet" />  
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

  <style>
    :root {
      --sky: #0ea5e9; --sky2: #0284c7; --sky-dark: #0369a1;
      --sky-light: #bae6fd; --sky-pale: #f0f9ff;
      --cream: #f8fafc; --text-main: #1e293b; --text-mid: #475569; --text-dim: #94a3b8;
      --r-sm: 6px; --r-md: 10px; --r-lg: 16px; --r-pill: 999px;
      --t: all .2s ease;
      --red: #ef4444; --green: #10b981; --amber: #f59e0b; --purple: #8b5cf6;
    }
    *, *::before, *::after { box-sizing: border-box; }
    body { margin: 0; padding: 0; background: var(--cream); font-family: 'Newsreader', serif; font-size: 15px; color: var(--text-main); overflow-x: hidden;}
    
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: var(--sky-pale); }
    ::-webkit-scrollbar-thumb { background: var(--sky-light); border-radius: 4px; }

    /* TOPBAR */
    .topbar {
      position: sticky; top: 0; z-index: 100; background: #fff; border-bottom: 1px solid var(--sky-light);
      display: flex; align-items: center; justify-content: space-between; padding: 0 24px; height: 56px;
      box-shadow: 0 2px 10px rgba(14,165,233,.05);
    }
    .topbar-logo { font-family: 'Literata', serif; font-weight: 600; font-size: 1.1rem; color: var(--sky-dark); display: flex; align-items: center; gap: 8px;}
    
    .btn { padding: 6px 14px; border-radius: var(--r-sm); font-size: .85rem; font-family: 'Newsreader', serif; cursor: pointer; transition: var(--t); border: 1px solid transparent; font-weight:600; display: inline-flex; align-items: center; gap: 6px; justify-content: center; }
    .btn-sky { background: var(--sky); color: #fff; border-color: var(--sky); }
    .btn-sky:hover { background: var(--sky2); }
    .btn-outline { background: #fff; color: var(--sky-dark); border-color: var(--sky-light); }
    .btn-outline:hover { background: var(--sky-pale); }
    .btn-red { background: var(--red); color: #fff; }
    .btn-green { background: var(--green); color: #fff; }
    .btn-sm { padding: 4px 10px; font-size: .75rem; }

    /* LAYOUT */
    .admin-layout { display: flex; min-height: calc(100vh - 56px); }
    .sidebar { width: 240px; flex-shrink: 0; background: #fff; border-right: 1px solid var(--sky-light); padding: 10px 0; overflow-y: auto; position: sticky; top: 56px; height: calc(100vh - 56px); }
    .sidebar-section { padding: 12px 20px 6px; font-size: .65rem; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-dim); font-family: sans-serif; font-weight: bold; }
    .sidebar-link { display: flex; align-items: center; gap: 10px; padding: 10px 20px; font-size: .9rem; color: var(--text-mid); cursor: pointer; transition: var(--t); border-left: 3px solid transparent; }
    .sidebar-link:hover, .sidebar-link.active { background: var(--sky-pale); color: var(--sky-dark); border-left-color: var(--sky); font-weight: bold; }
    
    .main { flex: 1; padding: 24px 32px; max-width: 1200px; margin: 0 auto; overflow-y: auto;}

    /* FORM & INPUTS */
    .field { margin-bottom: 14px; }
    .field label { display: block; font-size: .75rem; font-family: sans-serif; font-weight: bold; color: var(--text-mid); margin-bottom: 6px; text-transform: uppercase; }
    .field input, .field select, .field textarea { width: 100%; padding: 8px 12px; border: 1px solid var(--sky-light); border-radius: var(--r-md); font-family: 'Newsreader', serif; font-size: .95rem; background: #fff;}
    .field input:focus, .field textarea:focus { outline: none; border-color: var(--sky); box-shadow: 0 0 0 3px rgba(14,165,233,.1); }

    /* SECTIONS */
    .section { display: none; }
    .section.active { display: block; animation: fadeIn 0.3s ease; }
    @keyframes fadeIn { from {opacity: 0; transform: translateY(5px)} to {opacity: 1; transform: translateY(0)} }
    
    .page-title { font-family: 'Literata', serif; font-size: 1.3rem; color: var(--sky-dark); margin-top: 0; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid var(--sky-pale); padding-bottom: 10px; }
    .card { background: #fff; border: 1px solid var(--sky-light); border-radius: var(--r-md); padding: 16px; margin-bottom: 16px; box-shadow: 0 2px 10px rgba(14,165,233,.02);}
    
    /* DATA TABLE */
    .data-table { width: 100%; border-collapse: collapse; border: 1px solid var(--sky-light); background: #fff; border-radius: var(--r-md); overflow: hidden; }
    .data-table th { text-align: left; padding: 10px 12px; background: var(--sky-pale); font-size: .7rem; text-transform: uppercase; font-family: sans-serif; color: var(--sky-dark); }
    .data-table td { padding: 10px 12px; border-bottom: 1px solid var(--sky-pale); font-size: .85rem; vertical-align: middle;}
    .data-table tr:last-child td { border-bottom: none; }
    .data-table tr:hover td { background: #f8fafc; }

    /* EDITOR TOOLBAR */
    .editor-wrap { border: 1px solid var(--sky-light); border-radius: var(--r-md); background: #fff; display: flex; flex-direction: column; }
    .editor-toolbar { background: var(--sky-pale); padding: 8px; border-bottom: 1px solid var(--sky-light); display: flex; gap: 4px; flex-wrap: wrap; align-items: center;}
    .editor-btn { background: #fff; border: 1px solid var(--sky-light); border-radius: 4px; padding: 4px 8px; font-size: .8rem; cursor: pointer; color: var(--sky-dark); font-family: sans-serif; font-weight: bold;}
    .editor-btn:hover { background: var(--sky); color: #fff; }
    .editor-textarea { width: 100%; min-height: 500px; padding: 16px; border: none; font-family: 'Newsreader', serif; font-size: 1rem; line-height: 1.8; resize: vertical; outline: none; }

    /* MODAL */
    .modal-overlay { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); z-index: 500; display: none; align-items: center; justify-content: center; backdrop-filter: blur(2px); }
    .modal-overlay.open { display: flex; }
    .modal-content { background: #fff; width: 90%; max-width: 600px; border-radius: var(--r-lg); padding: 24px; max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);}

    /* LOGIN */
    #loginScreen { position: fixed; inset: 0; z-index: 1000; background: var(--cream); display: flex; align-items: center; justify-content: center; }

    .toast { position: fixed; bottom: 20px; right: 20px; z-index: 1100; padding: 12px 24px; border-radius: var(--r-md); background: #1e293b; color: #fff; transform: translateY(100px); transition: var(--t); font-size: .85rem; box-shadow: 0 10px 15px rgba(0,0,0,.1);}
    .toast.show { transform: translateY(0); }
    .toast.error { background: var(--red); }
    .toast.success { background: var(--green); }

    .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
    .badge { padding: 2px 8px; border-radius: var(--r-pill); font-size: .65rem; font-family: sans-serif; font-weight: bold; text-transform: uppercase;}
    .badge-draft { background: var(--amber); color: #fff; }
    .badge-pub { background: var(--green); color: #fff; }
  </style>

  <script type="module">
    import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js';
    import { getDatabase, ref, onValue, remove, get, update } from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-database.js';

    // CẤU HÌNH FIREBASE CỦA BẠN
    const firebaseConfig = {
      apiKey: "AIzaSyBkuHIU0qdS-zNeUFGN7keNGGbAMXvilD0",
      authDomain: "dynamic-duo-comments.firebaseapp.com",
      projectId: "dynamic-duo-comments",
      databaseURL: "https://dynamic-duo-comments-default-rtdb.asia-southeast1.firebasedatabase.app"
    };

    const app = initializeApp(firebaseConfig);
    window.__fbDb = getDatabase(app);
    window.__fbRef = ref; window.__fbOnValue = onValue; window.__fbRemove = remove; window.__fbGet = get; window.__fbUpdate = update;
    window.dispatchEvent(new Event('firebase-ready'));
  </script>
</head>
<body>

<div id="toast" class="toast"></div>

<div id="loginScreen">
  <div style="width: 360px; background: #fff; padding: 40px; border-radius: 20px; box-shadow: 0 10px 40px rgba(14,165,233,.1); text-align: center;">
    <h2 style="font-family: 'Literata'; color: var(--sky-dark); margin-top:0;">Siêu Admin Panel<br><span style="font-size:1rem; color:var(--text-dim)">Dynamic Duo 𓆝</span></h2>
    <div class="field" style="margin-top:20px; text-align:left">
        <label>Mật khẩu Admin</label>
        <input type="password" id="adminPass" placeholder="Nhập mật khẩu..." />
    </div>
    <div class="field" style="text-align:left">
        <label>GitHub Token (Repo Permission)</label>
        <input type="password" id="ghToken" placeholder="ghp_..." />
    </div>
    <button class="btn btn-sky" style="width: 100%; margin-top: 10px; padding: 10px" id="loginBtn">Đăng nhập hệ thống</button>
  </div>
</div>

<div id="app" style="display:none;">
  <div class="topbar">
    <div class="topbar-logo">🌊 Dynamic Duo Workspace</div>
    <div style="display:flex; gap:12px; align-items:center">
      <span id="ghUser" style="font-size: .8rem; color: var(--text-dim); font-weight:bold"></span>
      <button class="btn btn-outline btn-sm" onclick="window.open('/dynamic-duo-web/', '_blank')">Xem Web</button>
      <button class="btn btn-red btn-sm" onclick="location.reload()">Đăng xuất</button>
    </div>
  </div>

  <div class="admin-layout">
    <aside class="sidebar">
      <div class="sidebar-section">Hệ thống</div>
      <div class="sidebar-link active" data-nav="dashboard">📊 Dashboard</div>
      
      <div class="sidebar-section">Nội dung</div>
      <div class="sidebar-link" data-nav="stories">📚 Quản lý Truyện</div>
      <div class="sidebar-link" data-nav="bulk-upload">🚀 Đăng nhanh (Bulk)</div>
      <div class="sidebar-link" data-nav="tags">🏷️ Quản lý Tags</div>

      <div class="sidebar-section">Cộng đồng (Firebase)</div>
      <div class="sidebar-link" data-nav="fb-comments">💬 Bình luận</div>
      <div class="sidebar-link" data-nav="fb-messages">✉️ Hòm thư riêng</div>
      <div class="sidebar-link" data-nav="fb-readers">👥 Độc giả (Tokens)</div>
      
      <div class="sidebar-section">Cài đặt Site</div>
      <div class="sidebar-link" data-nav="settings">⚙️ Cấu hình chung</div>
      <div class="sidebar-link" data-nav="settings-ui">🎨 Giao diện & Banner</div>
      <div class="sidebar-link" data-nav="backup">📦 Sao lưu (Backup)</div>
    </aside>

    <main class="main">
      
      <section class="section active" id="sec-dashboard">
        <h2 class="page-title">Tổng quan hệ thống</h2>
        <div class="stat-grid">
          <div class="card" style="text-align:center; border-top: 4px solid var(--sky)">
            <div style="font-size: 2.2rem; font-weight: bold; color: var(--sky)" id="stat-stories">0</div>
            <div style="font-size: .75rem; color: var(--text-dim); font-weight:bold; letter-spacing:1px">TỔNG SỐ TRUYỆN</div>
          </div>
          <div class="card" style="text-align:center; border-top: 4px solid var(--green)">
            <div style="font-size: 2.2rem; font-weight: bold; color: var(--green)" id="stat-views">0</div>
            <div style="font-size: .75rem; color: var(--text-dim); font-weight:bold; letter-spacing:1px">LƯỢT XEM (Firebase)</div>
          </div>
          <div class="card" style="text-align:center; border-top: 4px solid var(--amber)">
            <div style="font-size: 2.2rem; font-weight: bold; color: var(--amber)" id="stat-cmts">0</div>
            <div style="font-size: .75rem; color: var(--text-dim); font-weight:bold; letter-spacing:1px">BÌNH LUẬN</div>
          </div>
          <div class="card" style="text-align:center; border-top: 4px solid var(--purple)">
            <div style="font-size: 2.2rem; font-weight: bold; color: var(--purple)" id="stat-users">0</div>
            <div style="font-size: .75rem; color: var(--text-dim); font-weight:bold; letter-spacing:1px">NGƯỜI DÙNG UNIQUE</div>
          </div>
        </div>
        <div class="card" style="margin-top: 20px;">
            <h3 style="margin-top:0; color:var(--sky-dark); font-family:'Literata', serif;">📈 Biểu đồ Lượt xem (7 ngày gần nhất)</h3>
            <div style="position: relative; height: 300px; width: 100%;">
                <canvas id="viewsChart"></canvas>
            </div>
            <p style="font-size: .75rem; color: var(--text-dim); text-align:center; font-style:italic;">*Lưu ý: Dữ liệu ngày chỉ bắt đầu được ghi nhận từ hôm nay.</p>
        </div>
      </section>

      <section class="section" id="sec-stories">
        <h2 class="page-title">Danh sách Truyện 
          <button class="btn btn-sky btn-sm" onclick="openStoryModal()">+ Thêm truyện mới</button>
        </h2>
        <table class="data-table">
          <thead><tr><th>Tên truyện</th><th>Đường dẫn (Path)</th><th>Phân loại</th><th>Thao tác</th></tr></thead>
          <tbody id="storyTbody"></tbody>
        </table>
      </section>

      <section class="section" id="sec-chapter-list">
        <h2 class="page-title"><span id="cl-title">Danh sách chương</span>
          <div style="display:flex; gap:8px">
            <button class="btn btn-outline btn-sm" onclick="navTo('stories')">← Quay lại</button>
            <button class="btn btn-red btn-sm" onclick="bulkDeleteChaps()">🗑 Xóa nhiều</button>
            <button class="btn btn-sky btn-sm" onclick="openEditor('new')">+ Viết chương mới</button>
          </div>
        </h2>
        <div class="card" style="display:flex; gap:10px; align-items:center; padding:10px">
          <input type="text" id="chapSearch" placeholder="🔍 Tìm theo số hoặc tên chương..." style="flex:1; border:none; outline:none; background:transparent; font-family:'Newsreader'" onkeyup="filterChapters()" />
          <button class="btn btn-outline btn-sm" onclick="sortChapters()">↕️ Đảo chiều sắp xếp</button>
        </div>
        <table class="data-table" id="chapTable">
          <thead>
            <tr>
                <th width="30"><input type="checkbox" id="selectAllChaps" onclick="toggleSelectAllChaps(this)"></th>
                <th width="50">Số</th>
                <th>Tiêu đề / File</th>
                <th width="80">Trạng thái</th>
                <th width="120">Thao tác</th>
            </tr>
          </thead>
          <tbody id="chapTbody"></tbody>
        </table>
      </section>

      <section class="section" id="sec-editor">
<h2 class="page-title">Biên tập Chương
          <div style="display:flex; gap:8px">
            <button class="btn btn-outline btn-sm" onclick="navTo('chapter-list')">← Quay lại danh sách</button>
            <button class="btn btn-outline btn-sm" id="btn-save-draft">💾 Lưu Nháp</button>
            <button class="btn btn-sky" id="ed-saveBtn">🚀 Xuất bản (GitHub)</button>
          </div>
        </h2>

        <div class="card" style="display:grid; grid-template-columns: 1fr 1fr 1fr; gap:15px">
          <div class="field"><label>Tiêu đề chương (*)</label><input type="text" id="ed-title" placeholder="VD: Chương 1 - Gặp gỡ" /></div>
          <div class="field"><label>Số chương (*)</label><input type="number" id="ed-num" placeholder="Dùng để sắp xếp" /></div>
          <div class="field"><label>Trạng thái</label>
            <select id="ed-status">
                <option value="published">Xuất bản (Public)</option>
                <option value="draft">Bản nháp (Draft)</option>
            </select>
          </div>
          
          <div class="field" style="grid-column: 1 / 3"><label>Mô tả SEO (Meta Description)</label><input type="text" id="ed-desc" placeholder="Tóm tắt ngắn gọn chương này để Google index..." /></div>
          <div class="field"><label>Tags</label><input type="text" id="ed-tags" placeholder="Cách nhau bằng dấu phẩy..." /></div>
          
          <div class="field" style="grid-column: 1 / -1"><label>Ghi chú của Editor</label><textarea id="ed-note" rows="2" placeholder="Hiển thị ở đầu hoặc cuối chương..."></textarea></div>
        </div>
        
        <div class="editor-wrap">
          <div class="editor-toolbar">
            <button class="editor-btn" onclick="fmt('bold')" title="In đậm"><b>B</b></button>
            <button class="editor-btn" onclick="fmt('italic')" title="In nghiêng"><i>I</i></button>
            <button class="editor-btn" onclick="fmt('underline')" title="Gạch chân"><u>U</u></button>
            <button class="editor-btn" onclick="fmt('h2')" title="Tiêu đề 2">H2</button>
            <button class="editor-btn" onclick="fmt('quote')" title="Trích dẫn">Quote</button>
            <button class="editor-btn" onclick="fmt('center')" title="Căn giữa">Căn giữa</button>
            <button class="editor-btn" onclick="fmt('hr')" title="Đường kẻ ngang">HR</button>
            
            <div style="display:flex; align-items:center; gap:5px; margin-left:10px; background:#fff; padding:2px 8px; border-radius:4px; border:1px solid var(--sky-light)">
              <span style="font-size:.7rem; font-weight:bold">Màu chữ:</span>
              <input type="color" id="ed-color-picker" value="#ef4444" style="border:none; width:22px; height:22px; cursor:pointer; padding:0" />
              <button class="editor-btn" onclick="fmt('color')" style="border:none; padding:2px 5px">Tô màu</button>
            </div>

            <div style="display:flex; align-items:center; gap:5px; margin-left:auto; background:#fff; padding:2px; border-radius:4px; border:1px solid var(--sky-light)">
                <input type="text" id="fr-find" placeholder="Tìm..." style="width:80px; font-size:.75rem; border:none; outline:none; padding:2px 5px">
                <input type="text" id="fr-replace" placeholder="Thay bằng..." style="width:80px; font-size:.75rem; border:none; border-left:1px solid #ccc; outline:none; padding:2px 5px">
                <button class="editor-btn" onclick="findAndReplace()" style="border:none; background:var(--sky-pale)">Thay thế</button>
            </div>
            
            <button class="editor-btn" onclick="togglePreview()" id="btn-preview-toggle" style="margin-left:10px; background:var(--sky); color:#fff">👁 Xem trước</button>
          </div>
          
          <textarea id="ed-content" class="editor-textarea" placeholder="Nội dung chương viết vào đây (Hỗ trợ Markdown)..."></textarea>
          <div id="ed-preview" class="editor-textarea" style="display:none; background:#fafcff; overflow-y:auto"></div>
          
          <div style="padding:8px 12px; font-size:.75rem; border-top:1px solid var(--sky-pale); color:var(--text-dim); display:flex; justify-content:space-between; background:#f8fafc">
            <span id="ed-word-count">0 từ | 0 ký tự</span>
            <span id="ed-last-save">Chưa lưu nháp</span>
          </div>
        </div>
      </section>

      <section class="section" id="sec-bulk-upload">
        <h2 class="page-title">Đăng chương hàng loạt (Bulk Upload)</h2>
        <div class="card">
            <p style="font-size:.85rem; color:var(--text-mid); margin-top:0">Tính năng này cho phép dán nguyên một cụm văn bản lớn chứa nhiều chương. Hệ thống tự động cắt dựa trên từ khóa "Chương [số]".</p>
            <div class="field">
                <label>Chọn Truyện Đích</label>
                <select id="bulk-story-select"></select>
            </div>
            <div class="field">
                <label>Dán nội dung vào đây</label>
                <textarea id="bulk-content" style="height: 300px" placeholder="Chương 1: Bắt đầu...&#10;(Nội dung chương 1)&#10;&#10;Chương 2: Tiếp diễn...&#10;(Nội dung chương 2)"></textarea>
            </div>
            <button class="btn btn-sky" onclick="processBulkUpload()">Cắt & Lưu lên GitHub</button>
            <div id="bulk-log" style="margin-top:15px; font-size:.8rem; font-family:monospace; color:var(--text-dim); white-space:pre-wrap"></div>
        </div>
      </section>
      
<section class="section" id="sec-tags">
        <h2 class="page-title">Quản lý Tags (Hàng loạt)</h2>
        <div class="card">
            <p style="font-size:.85rem; color:var(--text-mid); margin-top:0">Bộ công cụ tự động chèn/sửa/xóa Tag trực tiếp vào các file chương truyện (.md) trên GitHub.</p>
            
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:15px; margin-top: 20px;">
                <div class="field">
                    <label>Hành động</label>
                    <select id="tag-action" onchange="toggleTagInputs()">
                        <option value="replace">🔄 Đổi tên Tag (Thay thế)</option>
                        <option value="add">➕ Thêm Tag mới</option>
                        <option value="delete">🗑️ Xóa Tag</option>
                    </select>
                </div>
                <div class="field">
                    <label>Áp dụng cho</label>
                    <select id="tag-target-story">
                        </select>
                </div>
                <div class="field" id="wrap-tag-old">
                    <label>Tag cũ (Cần đổi/xóa)</label>
                    <input type="text" id="tag-old" placeholder="VD: hiện đai" />
                </div>
                <div class="field" id="wrap-tag-new">
                    <label>Tag mới (Sẽ được thêm/đổi thành)</label>
                    <input type="text" id="tag-new" placeholder="VD: hiện đại" />
                </div>
            </div>
            <button class="btn btn-sky" onclick="processBulkTags()">🚀 Tiến hành Thực thi</button>
            <div id="tag-log" style="margin-top:15px; font-size:.8rem; font-family:monospace; color:var(--sky-dark); white-space:pre-wrap; background: var(--sky-pale); padding: 10px; border-radius: 6px; display: none; max-height: 250px; overflow-y: auto;"></div>
        </div>
      </section>
      
      <section class="section" id="sec-fb-comments">
        <h2 class="page-title">Quản lý Bình luận (Firebase)</h2>
        <div id="fb-comments-list" style="display:flex; flex-direction:column; gap:12px"></div>
      </section>

      <section class="section" id="sec-fb-messages">
        <h2 class="page-title">Hòm thư riêng (Inbox)</h2>
        <div id="fb-msgs-list" style="display:flex; flex-direction:column; gap:12px"></div>
      </section>

      <section class="section" id="sec-fb-readers">
        <h2 class="page-title">Thống kê Độc giả (Token / ID)</h2>
        <div class="card">
            <table class="data-table">
                <thead><tr><th>Token ID</th><th>Lượt truy cập</th><th>Lần cuối</th></tr></thead>
                <tbody id="fb-readers-list"></tbody>
            </table>
        </div>
      </section>

      <section class="section" id="sec-settings">
        <h2 class="page-title">Cấu hình Chung (settings.json)</h2>
        <div class="card">
            <p style="font-size:.85rem; color:var(--red); font-weight:bold; margin-top:0">⚠️ Cẩn thận: Dữ liệu JSON phải chuẩn cú pháp, sai dấu phẩy có thể gây lỗi web.</p>
            <textarea id="settings-json" style="width:100%; height:450px; font-family:monospace; font-size:.85rem; padding:15px; background:#f1f5f9; border:1px solid #cbd5e1; border-radius:var(--r-sm)"></textarea>
            <div style="text-align:right; margin-top:12px"><button class="btn btn-sky" onclick="saveSettingsJSON()">Lưu Cấu hình</button></div>
        </div>
      </section>

      <section class="section" id="sec-settings-ui">
        <h2 class="page-title">Giao diện & Banner</h2>
        <div class="card">
           <p style="font-size:.85rem; color:var(--text-mid)"><i>Tính năng đang được phát triển... Tạm thời sửa trực tiếp trong file mã nguồn.</i></p>
        </div>
      </section>

      <section class="section" id="sec-backup">
        <h2 class="page-title">Sao lưu Hệ thống (Backup)</h2>
        <div class="card" style="text-align:center; padding: 40px 20px">
            <div style="font-size:3rem; margin-bottom:10px">📦</div>
            <h3 style="margin:0 0 10px; color:var(--sky-dark)">Tải toàn bộ truyện về máy</h3>
            <p style="font-size:.85rem; color:var(--text-mid); max-width:500px; margin:0 auto 20px">Tính năng này sẽ nén toàn bộ các file Markdown trong thư mục <code>src/pages</code> thành một file ZIP duy nhất để bạn cất giữ an toàn.</p>
            <button class="btn btn-green" id="btn-backup" onclick="performBackup()" style="font-size:1rem; padding:10px 24px">Tiến hành Sao lưu (Tạo ZIP)</button>
            <div id="backup-log" style="margin-top:15px; font-size:.8rem; color:var(--text-dim)"></div>
        </div>
      </section>

    </main>
  </div>
</div>

<div class="modal-overlay" id="storyModal">
