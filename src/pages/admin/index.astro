---
// src/pages/admin/index.astro
// Trang admin: đăng nhập + quản lý truyện/chương qua GitHub API
---

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin · Dynamic Duo</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=Literata:wght@400;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      --sky: #0ea5e9; --sky2: #0284c7; --sky-dark: #0369a1;
      --sky-light: #bae6fd; --sky-pale: #f0f9ff;
      --cream: #fafcff; --text-main: #1e3a5f; --text-mid: #64748b; --text-dim: #94a3b8;
      --r-sm: 6px; --r-md: 12px; --r-lg: 20px; --r-pill: 999px;
      --t: all .2s ease;
      --red: #ef4444; --green: #22c55e; --amber: #f59e0b;
    }
    *, *::before, *::after { box-sizing: border-box; }
    body { margin: 0; padding: 0; background: var(--cream); font-family: 'Newsreader', serif; font-size: 16px; color: var(--text-main); }

    /* ── TOPBAR ── */
    .topbar {
      position: sticky; top: 0; z-index: 100;
      background: #fff; border-bottom: 1px solid var(--sky-light);
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 24px; height: 52px;
      box-shadow: 0 2px 8px rgba(14,165,233,.08);
    }
    .topbar-logo { font-family: 'Literata', serif; font-weight: 600; font-size: .95rem; color: var(--sky-dark); }
    .topbar-right { display: flex; align-items: center; gap: 12px; }
    .topbar-user { font-size: .8rem; color: var(--text-mid); }
    .btn { padding: 6px 16px; border-radius: var(--r-pill); font-size: .82rem; font-family: 'Newsreader', serif; cursor: pointer; transition: var(--t); border: 1.5px solid transparent; font-weight:600; }
    .btn-sky { background: var(--sky); color: #fff; border-color: var(--sky); }
    .btn-sky:hover { background: var(--sky2); border-color: var(--sky2); box-shadow: 0 4px 10px rgba(14,165,233,.2); }
    .btn-outline { background: #fff; color: var(--sky-dark); border-color: var(--sky-light); }
    .btn-outline:hover { background: var(--sky-pale); border-color: var(--sky); color: var(--sky); }
    .btn-red { background: var(--red); color: #fff; border-color: var(--red); }
    .btn-red:hover { opacity: .85; }
    .btn-sm { padding: 4px 12px; font-size: .76rem; }

    /* ── LAYOUT ── */
    .admin-layout { display: flex; min-height: calc(100vh - 52px); }
    .sidebar {
      width: 220px; flex-shrink: 0;
      background: #fff; border-right: 1px solid var(--sky-light);
      padding: 20px 0;
    }
    .sidebar-section { padding: 6px 16px; font-size: .65rem; letter-spacing: 2px; text-transform: uppercase; color: var(--text-dim); margin-top: 12px; font-family: sans-serif; font-weight: bold;}
    .sidebar-link {
      display: block; padding: 9px 20px;
      font-size: .88rem; color: var(--text-mid);
      cursor: pointer; transition: var(--t);
      border-left: 3px solid transparent;
    }
    .sidebar-link:hover, .sidebar-link.active {
      background: var(--sky-pale); color: var(--sky); border-left-color: var(--sky); font-weight: bold;
    }
    .main { flex: 1; padding: 28px 32px; max-width: 960px; margin: 0 auto; }

    /* ── LOGIN SCREEN ── */
    #loginScreen {
      position: fixed; inset: 0; z-index: 200;
      background: var(--cream);
      display: flex; align-items: center; justify-content: center;
    }
    .login-card {
      width: 380px; background: #fff;
      border: 1px solid var(--sky-light);
      border-radius: var(--r-lg); padding: 40px 36px;
      box-shadow: 0 8px 40px rgba(14,165,233,.12);
      text-align: center;
    }
    .login-logo { font-family: 'Literata', serif; font-size: 1.4rem; font-weight: 600; color: var(--sky-dark); margin-bottom: 6px; }
    .login-sub { font-size: .82rem; color: var(--text-dim); font-style: italic; margin-bottom: 28px; }
    .field { margin-bottom: 16px; text-align: left; }
    .field label { display: block; font-size: .78rem; font-family: sans-serif; font-weight: bold; color: var(--text-mid); margin-bottom: 6px; letter-spacing: .5px; }
    .field input, .field select, .field textarea {
      width: 100%; padding: 10px 14px;
      border: 1.5px solid var(--sky-light); border-radius: var(--r-md);
      font-family: 'Newsreader', serif; font-size: .9rem; color: var(--text-main);
      background: #fff; transition: var(--t); box-sizing: border-box;
    }
    .field input:focus, .field select:focus, .field textarea:focus {
      outline: none; border-color: var(--sky); box-shadow: 0 0 0 3px rgba(14,165,233,.12);
    }
    .field textarea { resize: vertical; min-height: 120px; line-height: 1.7; }
    .login-note { font-size: .74rem; color: var(--text-dim); margin-top: 16px; line-height: 1.5; }
    .login-note a { color: var(--sky); }
    .error-msg { background: #fef2f2; border: 1px solid #fca5a5; border-radius: var(--r-sm); padding: 8px 12px; font-size: .8rem; color: var(--red); margin-bottom: 12px; display: none; }

    /* ── SECTIONS ── */
    .section { display: none; animation: fadeIn 0.3s ease; }
    .section.active { display: block; }
    @keyframes fadeIn { from {opacity: 0; transform: translateY(10px)} to {opacity: 1; transform: translateY(0)} }
    .section-title { font-family: 'Literata', serif; font-size: 1.3rem; font-weight: 600; color: var(--sky-dark); margin: 0 0 24px; border-bottom: 2px solid var(--sky-pale); padding-bottom: 10px;}

    /* ── CHAPTER LIST ── */
    .story-select-bar { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 20px; }
    .chap-table { width: 100%; border-collapse: collapse; background: #fff; border-radius: var(--r-md); overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.02); border: 1px solid var(--sky-light);}
    .chap-table th {
      text-align: left; padding: 12px 14px; background: var(--sky-pale);
      font-size: .72rem; letter-spacing: 1.5px; text-transform: uppercase; font-family: sans-serif;
      color: var(--sky-dark); border-bottom: 2px solid var(--sky-light);
    }
    .chap-table td {
      padding: 12px 14px; border-bottom: 1px solid rgba(186,230,253,.3);
      font-size: .84rem; color: var(--text-mid); vertical-align: middle;
    }
    .chap-table tr:last-child td { border-bottom: none; }
    .chap-table tr:hover td { background: var(--sky-pale); }
    .chap-num { font-weight: 600; color: var(--sky-dark); width: 60px; text-align: center; }
    .chap-title-cell { color: var(--text-main); font-weight: 600;}
    .chap-date { font-size: .74rem; color: var(--text-dim); white-space: nowrap; }
    .chap-actions { display: flex; gap: 6px; white-space: nowrap; }
    
    .badge-draft { background: #fef08a; color: #b45309; font-size: 0.65rem; padding: 2px 6px; border-radius: 4px; font-weight: bold; margin-left: 8px; font-family: sans-serif; vertical-align: middle;}

    /* ── EDITOR ── */
    .editor-header {
      display: flex; align-items: center; gap: 12px; margin-bottom: 20px; flex-wrap: wrap;
      background: #fff; padding: 12px 20px; border-radius: var(--r-md); border: 1px solid var(--sky-light); box-shadow: 0 2px 8px rgba(0,0,0,.02);
    }
    .editor-back { cursor: pointer; color: var(--sky); font-size: .84rem; font-weight: 600;}
    .editor-back:hover { text-decoration: underline; }
    .editor-title { font-family: 'Literata', serif; font-size: 1.1rem; font-weight: 600; color: var(--sky-dark); flex: 1; }
    .editor-status { font-size: .76rem; color: var(--text-dim); }

    .meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
    @media (max-width: 600px) { .meta-grid { grid-template-columns: 1fr; } }

    .content-editor-wrap { position: relative; }
    .content-editor {
      width: 100%; min-height: 500px;
      border: 1.5px solid var(--sky-light); border-radius: var(--r-md);
      padding: 16px 20px; font-family: 'Newsreader', serif;
      font-size: 1rem; line-height: 1.9; color: var(--text-main);
      resize: vertical; transition: var(--t); box-sizing: border-box;
    }
    .content-editor:focus { outline: none; border-color: var(--sky); box-shadow: 0 0 0 3px rgba(14,165,233,.1); }

    .toolbar { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 8px; }
    .tool-btn {
      padding: 6px 12px; background: var(--sky-pale); border: 1px solid var(--sky-light);
      border-radius: var(--r-sm); font-size: .8rem; color: var(--sky-dark); font-weight: 600;
      cursor: pointer; transition: var(--t); font-family: 'Newsreader', serif;
    }
    .tool-btn:hover { background: var(--sky); color: #fff; border-color: var(--sky); }

    /* word count */
    .word-count { font-size: .75rem; color: var(--text-dim); text-align: right; margin-top: 6px; font-family: sans-serif;}

    /* ── TOAST ── */
    .toast {
      position: fixed; bottom: 24px; right: 24px; z-index: 500;
      padding: 12px 20px; border-radius: var(--r-md);
      font-size: .84rem; font-family: 'Newsreader', serif;
      box-shadow: 0 8px 25px rgba(0,0,0,.15);
      opacity: 0; transform: translateY(12px);
      transition: opacity .3s ease, transform .3s cubic-bezier(0.34, 1.56, 0.64, 1);
      pointer-events: none;
    }
    .toast.show { opacity: 1; transform: translateY(0); }
    .toast.success { background: #dcfce7; color: #166534; border: 1px solid #86efac; }
    .toast.error { background: #fef2f2; color: var(--red); border: 1px solid #fca5a5; }
    .toast.info { background: var(--sky-pale); color: var(--sky-dark); border: 1px solid var(--sky-light); }

    /* ── SPINNER ── */
    .spinner {
      display: inline-block; width: 14px; height: 14px;
      border: 2px solid rgba(255,255,255,.4); border-top-color: #fff;
      border-radius: 50%; animation: spin .7s linear infinite; vertical-align: middle; margin-right: 4px;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ── EMPTY STATE ── */
    .empty { text-align: center; padding: 40px 20px; color: var(--text-dim); font-style: italic; background: #fff; border-radius: var(--r-md); border: 1px dashed var(--sky-light);}

    /* ── STAT CARDS ── */
    .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px; margin-bottom: 32px; }
    .stat-card { background: #fff; border: 1px solid var(--sky-light); border-radius: var(--r-md); padding: 24px 16px; text-align: center; box-shadow: 0 4px 15px rgba(2,132,199,.05); transition: var(--t); }
    .stat-card:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(2,132,199,.1); border-color: var(--sky); }
    .stat-num { font-family: 'Literata', serif; font-size: 2rem; font-weight: 600; color: var(--sky-dark); line-height: 1; }
    .stat-label { font-size: .78rem; color: var(--text-dim); margin-top: 8px; font-family: sans-serif; text-transform: uppercase; letter-spacing: 1px;}

    /* ── CONFIRM DIALOG ── */
    .overlay { position: fixed; inset: 0; background: rgba(0,0,0,.5); backdrop-filter: blur(2px); z-index: 600; display: none; align-items: center; justify-content: center; }
    .overlay.open { display: flex; animation: fadeIn 0.2s; }
    .dialog { background: #fff; border-radius: var(--r-lg); padding: 28px 28px 24px; max-width: 380px; width: 90%; box-shadow: 0 10px 40px rgba(0,0,0,.2); }
    .dialog h3 { margin: 0 0 12px; font-family: 'Literata', serif; font-size: 1.1rem; color: var(--text-main); }
    .dialog p { font-size: .9rem; color: var(--text-mid); margin: 0 0 24px; line-height: 1.6; }
    .dialog-btns { display: flex; gap: 10px; justify-content: flex-end; }
  </style>
</head>
<body>

<!-- LOGIN SCREEN -->
<div id="loginScreen">
  <div class="login-card">
    <div class="login-logo">dynamic duo 𓆝.°•</div>
    <div class="login-sub">Admin Panel</div>
    <div class="error-msg" id="loginError"></div>
    <div class="field">
      <label>GitHub Personal Access Token</label>
      <input type="password" id="tokenInput" placeholder="ghp_xxxxxxxxxxxxxxxxxxxx" autocomplete="off" />
    </div>
    <div class="field">
      <label>Mật khẩu Admin</label>
      <input type="password" id="passInput" placeholder="Nhập mật khẩu" autocomplete="off" />
    </div>
    <button class="btn btn-sky" style="width:100%;margin-top:8px; padding: 10px;" id="loginBtn">
      Đăng nhập
    </button>
    <p class="login-note">
      Token cần cấp quyền <strong>repo</strong>. Tạo tại
      <a href="https://github.com/settings/tokens" target="_blank">GitHub → Settings → Tokens</a>.<br/>
      Mật khẩu admin quy định trong file source code.
    </p>
  </div>
</div>

<!-- CONFIRM DIALOG -->
<div class="overlay" id="confirmOverlay">
  <div class="dialog">
    <h3 id="confirmTitle">Xác nhận</h3>
    <p id="confirmMsg"></p>
    <div class="dialog-btns">
      <button class="btn btn-outline" id="confirmCancel">Huỷ</button>
      <button class="btn btn-red" id="confirmOk">Xoá</button>
    </div>
  </div>
</div>

<!-- TOAST -->
<div class="toast" id="toast"></div>

<!-- MAIN APP -->
<div id="app" style="display:none">
  <!-- TOPBAR -->
  <div class="topbar">
    <div class="topbar-logo">⚙ Quản trị · dynamic duo</div>
    <div class="topbar-right">
      <a href="/dynamic-duo-web/" target="_blank" class="btn btn-outline btn-sm">← Ra Web</a>
      <span class="topbar-user" id="topbarUser"></span>
      <button class="btn btn-outline btn-sm" id="logoutBtn">Đăng xuất</button>
    </div>
  </div>

  <div class="admin-layout">
    <!-- SIDEBAR -->
    <div class="sidebar">
      <div class="sidebar-section">Tổng quan</div>
      <div class="sidebar-link active" data-section="dashboard">📊 Dashboard</div>
      <div class="sidebar-section">Quản lý Truyện</div>
      <div class="sidebar-link" data-section="ongoing">🌊 Cá dưới nước</div>
      <div class="sidebar-link" data-section="completed">🍽️ Cá trên bàn</div>
      <div class="sidebar-link" data-section="upcoming">🌤️ Cá trên trời</div>
      <div class="sidebar-section">Tác vụ nhanh</div>
      <div class="sidebar-link" data-section="new-chapter">✏️ Đăng chương mới</div>
      <div class="sidebar-link" data-section="new-story">📚 Thêm bộ truyện</div>
    </div>

    <!-- MAIN -->
    <div class="main">

      <!-- DASHBOARD -->
      <div class="section active" id="sec-dashboard">
        <h2 class="section-title">📊 Dashboard Thống Kê</h2>
        <div class="stat-grid" id="statGrid">
          <div class="stat-card"><div class="stat-num" id="statOngoing">–</div><div class="stat-label">Đang tiến hành</div></div>
          <div class="stat-card"><div class="stat-num" id="statCompleted">–</div><div class="stat-label">Hoàn thành</div></div>
          <div class="stat-card"><div class="stat-num" id="statChaps">–</div><div class="stat-label">Tổng số chương</div></div>
          <div class="stat-card"><div class="stat-num" id="statUpcoming">☁️</div><div class="stat-label">Sắp đào</div></div>
        </div>
        <div id="recentList"><div class="empty">Đang tải dữ liệu truyện...</div></div>
      </div>

      <!-- ONGOING (CA DUOI NUOC) -->
      <div class="section" id="sec-ongoing">
        <h2 class="section-title">🌊 Cá dưới nước — Truyện đang tiến hành</h2>
        <div id="ongoingStoryList"></div>
      </div>

      <!-- COMPLETED (CA TREN BAN) -->
      <div class="section" id="sec-completed">
        <h2 class="section-title">🍽️ Cá trên bàn — Truyện đã hoàn thành</h2>
        <div id="completedStoryList"></div>
      </div>

      <!-- UPCOMING -->
      <div class="section" id="sec-upcoming">
        <h2 class="section-title">🌤️ Cá trên trời — Sắp đào</h2>
        <div class="empty" style="margin-top:20px">Tính năng chỉnh sửa Đặt gạch đang được hoàn thiện. Vui lòng sửa trực tiếp file <code>src/pages/ca-tren-troi/index.astro</code>.</div>
      </div>

      <!-- CHAPTER LIST -->
      <div class="section" id="sec-chapter-list">
        <div class="editor-header">
          <span class="editor-back" id="chapListBack">← Quay lại</span>
          <div class="editor-title" id="chapListTitle">Danh sách chương</div>
          <button class="btn btn-sky" id="addChapBtn">+ Đăng chương mới</button>
        </div>
        <div id="chapTableWrap"></div>
      </div>

      <!-- CHAPTER EDITOR -->
      <div class="section" id="sec-editor">
        <div class="editor-header">
          <span class="editor-back" id="editorBack">← Thoát</span>
          <div class="editor-title" id="editorTitle">Soạn chương</div>
          <span class="editor-status" id="editorStatus"></span>
          <button class="btn btn-sky" id="saveBtn">💾 Lưu & Cập nhật</button>
        </div>

        <div class="meta-grid">
          <div class="field">
            <label>Tiêu đề chương (Bắt buộc)</label>
            <input type="text" id="ef-title" placeholder="VD: Chương 5 - Lần đầu gặp mặt" />
          </div>
          <div class="field">
            <label>Số chương (Để sắp xếp thứ tự)</label>
            <input type="number" id="ef-chuong" min="0" placeholder="5" />
          </div>
          <div class="field">
            <label>Mã truyện</label>
            <input type="text" id="ef-truyen-id" readonly style="background:#f8fafc; color: var(--text-dim);" />
          </div>
          <div class="field">
            <label>Ngày đăng</label>
            <input type="date" id="ef-date" />
          </div>
        </div>

        <div class="meta-grid">
          <div class="field">
            <label>Trạng thái</label>
            <select id="ef-draft">
              <option value="false">🟢 Công khai (Đăng ngay)</option>
              <option value="true">🟡 Lưu nháp (Chưa hiện lên web)</option>
            </select>
          </div>
          <div class="field">
            <label>Mô tả ngắn SEO (Tùy chọn)</label>
            <input type="text" id="ef-desc" placeholder="Tóm tắt 1-2 câu để share FB..." />
          </div>
        </div>

        <div class="field">
          <label>Tags (cách nhau bằng dấu phẩy)</label>
          <input type="text" id="ef-tags" placeholder="đam mỹ, hiện đại, HE" />
        </div>
        
        <div class="field">
          <label>Lời Editor lảm nhảm (Tùy chọn)</label>
          <textarea id="ef-note" rows="2" style="min-height:70px" placeholder="Chú thích, lảm nhảm, pass truyện..."></textarea>
        </div>

        <div class="field">
          <label>Nội dung chương chính (Markdown)</label>
          <div class="toolbar">
            <button class="tool-btn" data-target="ef-content" data-wrap="**" data-wrap-end="**">B (Đậm)</button>
            <button class="tool-btn" data-target="ef-content" data-wrap="*" data-wrap-end="*">I (Nghiêng)</button>
            <button class="tool-btn" data-target="ef-content" data-insert="&#10;---&#10;">── Kẻ ngang</button>
            <button class="tool-btn" data-target="ef-content" data-insert="&#10;> ">❝ Trích dẫn</button>
            <button class="tool-btn" style="margin-left: auto; border-color: var(--sky); color: var(--sky);" id="previewToggleBtn">👁 Xem trước</button>
          </div>
          <textarea class="content-editor" id="ef-content" placeholder="Dán nội dung bản dịch vào đây..."></textarea>
          <div class="word-count" id="wordCount">0 từ</div>
        </div>

        <!-- Preview panel -->
        <div id="previewPanel" style="display:none;border:1.5px solid var(--sky-light);border-radius:var(--r-md);padding:24px 32px;background:#fff;margin-top:-8px;line-height:1.9;font-size:1rem;min-height:300px;"></div>
      </div>

      <!-- NEW STORY FORM -->
      <div class="section" id="sec-new-story">
        <h2 class="section-title">📚 Khởi tạo Bộ truyện mới</h2>
        <div class="field"><label>Tên truyện</label><input type="text" id="ns-title" placeholder="VD: Vạn dặm vân" /></div>
        <div class="meta-grid">
          <div class="field"><label>Mã truyện (slug, viết liền không dấu)</label><input type="text" id="ns-slug" placeholder="VD: van-dam-van" /></div>
          <div class="field"><label>Tác giả</label><input type="text" id="ns-author" placeholder="VD: Tam Đạo" /></div>
        </div>
        <div class="meta-grid">
          <div class="field">
            <label>Phân loại</label>
            <select id="ns-cat">
              <option value="ca-duoi-nuoc">🌊 Cá dưới nước (Đang tiến hành)</option>
              <option value="ca-tren-ban">🍽️ Cá trên bàn (Hoàn thành)</option>
            </select>
          </div>
          <div class="field"><label>Tags</label><input type="text" id="ns-tags" placeholder="đam mỹ, hiện đại, HE" /></div>
        </div>
        <div class="field"><label>Mô tả ngắn (Tagline)</label><textarea id="ns-desc" style="min-height:80px" placeholder="Văn án siêu ngắn gọn..."></textarea></div>
        <div class="field"><label>Nội dung Văn án chi tiết (Markdown)</label><textarea id="ns-body" style="min-height:200px" placeholder="Mô tả chi tiết, nhân vật, thể loại dài..."></textarea></div>
        <button class="btn btn-sky" id="createStoryBtn" style="padding: 12px 24px; font-size: 1rem;">🚀 Khởi tạo & Đưa lên Web</button>
      </div>

