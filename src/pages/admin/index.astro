/* ==========================================================================
   CÔNG CỤ QUẢN LÝ VÀ ĐỔI TAG HÀNG LOẠT (NÂNG CẤP)
   ========================================================================== */
function toggleTagInputs() {
    const action = $('tag-action').value;
    $('wrap-tag-old').style.display = (action === 'add') ? 'none' : 'block';
    $('wrap-tag-new').style.display = (action === 'delete') ? 'none' : 'block';
}

async function processBulkTags() {
    const action = $('tag-action').value;
    const targetStory = $('tag-target-story').value;
    const oldTag = $('tag-old').value.trim();
    const newTag = $('tag-new').value.trim();
    const log = $('tag-log');
    
    if(action !== 'add' && !oldTag) return showToast('Vui lòng nhập Tag cũ', 'error');
    if(action !== 'delete' && !newTag) return showToast('Vui lòng nhập Tag mới', 'error');
    
    let actionText = action === 'add' ? `THÊM tag "${newTag}"` : 
                     action === 'delete' ? `XÓA tag "${oldTag}"` : 
                     `ĐỔI tag "${oldTag}" thành "${newTag}"`;
                     
    let targetText = targetStory === 'all' ? 'TẤT CẢ các bộ truyện' : 'bộ truyện đã chọn';

    if(!confirm(`⚠️ Bạn sắp ${actionText} cho ${targetText}. Thao tác này sẽ tự động ghi đè lên hàng loạt file.\nBạn có chắc chắn muốn tiến hành?`)) return;
    
    log.style.display = 'block';
    log.innerHTML = `🔄 Bắt đầu thực thi: ${actionText}...\n`;
    const btn = event.target; btn.disabled = true;

    try {
        let updateCount = 0;
        // Lọc danh sách truyện cần chạy
        const storiesToProcess = targetStory === 'all' ? storiesList : storiesList.filter(s => s.id === targetStory);

        for (const story of storiesToProcess) {
            log.innerHTML += `\n📂 Quét thư mục: ${story.title}...\n`;
            const path = `/contents/src/pages/${story.cat}/${story.id}?ref=${BRANCH}`;
            try {
                const files = await ghAPI(path);
                const mdFiles = files.filter(f => f.name.endsWith('.md'));
                
                for (const file of mdFiles) {
                    const fileData = await ghAPI(file.path);
                    let rawContent = b64Decode(fileData.content.replace(/\n/g,''));
                    
                    // Regex tách nguyên khối Frontmatter
                    const fmMatch = rawContent.match(/^---\n([\s\S]*?)\n---/);
                    if (!fmMatch) continue;
                    
                    let fmText = fmMatch[1];
                    let tagsMatch = fmText.match(/^tags:\s*\[(.*?)\]/m) || fmText.match(/^tags:\s*\n((?:  - .*\n?)+)/m);
                    
                    // Chuyển Tag cũ thành mảng chuẩn để xử lý (tránh bị lỗi Regex)
                    let tagsArray = [];
                    if (tagsMatch && tagsMatch[1]) {
                        if (tagsMatch[1].includes('-')) {
                            tagsArray = tagsMatch[1].split('\n').map(t => t.replace(/-\s*"?|"?\s*$/g, '').trim()).filter(Boolean);
                        } else {
                            tagsArray = tagsMatch[1].replace(/["']/g, '').split(',').map(s=>s.trim()).filter(Boolean);
                        }
                    }

                    let isModified = false;

                    // XỬ LÝ THEO YÊU CẦU
                    if (action === 'replace') {
                        const idx = tagsArray.indexOf(oldTag);
                        if (idx !== -1) { tagsArray[idx] = newTag; isModified = true; }
                    } else if (action === 'add') {
                        if (!tagsArray.includes(newTag)) { tagsArray.push(newTag); isModified = true; }
                    } else if (action === 'delete') {
                        const idx = tagsArray.indexOf(oldTag);
                        if (idx !== -1) { tagsArray.splice(idx, 1); isModified = true; }
                    }

                    // GHI ĐÈ FILE NẾU CÓ SỰ THAY ĐỔI
                    if (isModified) {
                        const tagsFormatted = tagsArray.length > 0 ? tagsArray.map(t => `"${t}"`).join(', ') : '';
                        let newFmText = fmText;
                        
                        if (tagsMatch) {
                            if(tagsFormatted === '') {
                                newFmText = newFmText.replace(tagsMatch[0], ''); // Xóa hẳn dòng tags nếu trống
                            } else {
                                newFmText = newFmText.replace(tagsMatch[0], `tags: [${tagsFormatted}]`);
                            }
                        } else {
                            newFmText += `\ntags: [${tagsFormatted}]`; // Chưa có thì chèn thêm dòng mới
                        }
                        
                        const updatedContent = rawContent.replace(fmText, newFmText);
                        
                        await ghAPI(file.path, 'PUT', {
                            message: `🏷️ Admin: ${actionText} (Chương: ${file.name})`,
                            content: b64Encode(updatedContent),
                            sha: fileData.sha,
                            branch: BRANCH
                        });
                        
                        log.innerHTML += `  ✅ Đã cập nhật tag cho: ${file.name}\n`;
                        updateCount++;
                    }
                }
            } catch(e) { log.innerHTML += `  ❌ Bỏ qua thư mục do lỗi mạng hoặc cấp quyền.\n`; }
        }
        
        log.innerHTML += `\n🎉 Hoàn tất! Đã cập nhật tag trong tổng cộng ${updateCount} chương.`;
        showToast('Xử lý Tag hoàn tất!');
    } catch(e) {
        log.innerHTML += `\n❌ Lỗi hệ thống: ${e.message}`;
    } finally {
        btn.disabled = false;
        // Đẩy scroll xuống dưới cùng khung log
        log.scrollTop = log.scrollHeight;
    }
}
/* ==========================================================================
   CẤU HÌNH & BACKUP
   ========================================================================== */
async function loadSettingsJSON() {
  $('settings-json').value = 'Đang tải file cấu hình từ GitHub...';
  try {
      const f = await ghAPI('/contents/src/data/settings.json?ref=' + BRANCH);
      $('settings-json').value = b64Decode(f.content.replace(/\n/g,''));
      $('settings-json').dataset.sha = f.sha;
  } catch(e) { $('settings-json').value = 'Không tìm thấy file src/data/settings.json'; }
}

async function saveSettingsJSON() {
  const content = $('settings-json').value;
  try { JSON.parse(content); } catch(e) { return showToast('Lỗi Cú Pháp JSON!', 'error'); }
  const sha = $('settings-json').dataset.sha;
  
  const btn = event.target;
  btn.textContent = 'Đang lưu...'; btn.disabled = true;
  
  try {
      await ghAPI('/contents/src/data/settings.json', 'PUT', { message: '⚙️ Admin cập nhật cấu hình', content: b64Encode(content), sha, branch: BRANCH });
      showToast('Đã lưu cấu hình!');
  } catch(e) { showToast('Lỗi: ' + e.message, 'error'); }
  btn.textContent = 'Lưu Cấu hình'; btn.disabled = false;
}

async function performBackup()
function openStoryModal() { openModal('storyModal'); }
function openModal(id) { $(id).classList.add('open'); }
function closeModal(id) { $(id).classList.remove('open'); }

async function saveNewStory() {
    const title = $('st-title').value; const id = $('st-id').value;
    const cat = $('st-cat').value; const author = $('st-author').value;
    
    if(!title || !id) return showToast('Tên và Slug không được trống', 'error');
    
    const fm = `---
import Layout from "../../../layouts/Layout.astro";
const title = "${title}";
const author = "${author}";
const description = "${$('st-desc').value}";
const tags = [${$('st-tags').value.split(',').map(t => `"${t.trim()}"`).join(', ')}];
---
<Layout title={title}>
  <div class="story-info">
    <h1>{title}</h1>
    <p>Tác giả: {author}</p>
    <div class="desc">${$('st-body').value}</div>
  </div>
</Layout>`;

    try {
        await ghAPI(`/contents/src/pages/${cat}/${id}/index.astro`, 'PUT', { message: `📚 Thêm truyện mới: ${title}`, content: b64Encode(fm), branch: BRANCH });
        showToast('Tạo thư mục truyện thành công!');
        closeModal('storyModal');
        storiesList.push({ id, title, cat, shortId: id });
        renderStoriesTable();
    } catch(e) { showToast('Lỗi: ' + e.message, 'error'); }
}
