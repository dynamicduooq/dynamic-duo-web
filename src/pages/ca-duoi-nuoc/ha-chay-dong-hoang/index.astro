---
import Layout from '../../../layouts/Layout.astro';

const allPosts = Object.values(
  import.meta.glob('./*.md', { eager: true })
) as any[];
const chapters = allPosts
  .filter((p) => p.frontmatter?.chuong && p.frontmatter.chuong !== 0)
  .sort((a, b) => (a.frontmatter?.chuong ?? 999) - (b.frontmatter?.chuong ?? 999));

const total = 109;
const pct = Math.round((chapters.length / total) * 100);
---

<Layout frontmatter={{
  title: 'Hạ cháy đồng hoang',
  description: 'Tình yêu là bản năng ẩn sau miền hoang tàn của ký ức.',
  tags: ['đam mỹ', 'hiện đại', 'chua xót', 'mất trí nhớ', 'đồng quê', 'thủy tinh']
}}>
  <style>
    .story-cover { width: 200px; border-radius: 12px; box-shadow: var(--sh-card); display: block; margin: 0 auto 28px; }
    .status-badge { display: inline-block; padding: 3px 14px; border-radius: var(--r-pill); font-size: .72rem; letter-spacing: 1.5px; text-transform: uppercase; font-weight: 600; background: #fef9c3; color: #854d0e; margin: 8px 0 16px; }
    .progress-bar-wrap { max-width: 320px; margin: 12px auto; }
    .progress-label { font-size: .76rem; color: var(--text-dim); text-align: center; margin-bottom: 5px; }
    .progress-bar { height: 6px; background: rgba(186,230,253,.4); border-radius: 3px; overflow: hidden; }
    .progress-fill { height: 100%; background: linear-gradient(to right, var(--sky-light), var(--sky)); border-radius: 3px; }
    .intro-block { background: var(--sky-pale); border: 1px solid rgba(186,230,253,.5); border-radius: var(--r-md); padding: 20px 24px; margin: 24px 0; font-size: .9rem; color: var(--text-mid); line-height: 1.8; }
    .intro-block h4 { font-size: .8rem; letter-spacing: 2px; text-transform: uppercase; color: var(--sky-dark); text-align: left; margin: 0 0 10px; }
    .char-grid { display: grid; grid-template-columns: 1fr auto 1fr; gap: 10px; align-items: center; text-align: center; margin: 20px 0; }
    .char-name { font-family: 'Merriweather', serif; font-size: .95rem; color: var(--sky-dark); }
    .char-role { font-size: .72rem; color: var(--text-dim); letter-spacing: 1px; text-transform: uppercase; margin-top: 3px; }
    .toc-section { margin-top: 32px; }
    .toc-title { font-family: 'Merriweather', serif; font-size: .88rem; color: var(--sky-dark); letter-spacing: 2px; text-transform: uppercase; text-align: center; margin-bottom: 16px; padding-bottom: 10px; border-bottom: 1px dashed var(--sky-light); }
    .toc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
    @media (max-width: 480px) { .toc-grid { grid-template-columns: 1fr; } }
    .toc-item { display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: var(--r-sm); font-size: .84rem; color: var(--text-mid); transition: var(--t); border: 1px solid transparent; }
    .toc-item:hover { background: var(--sky-pale); color: var(--sky); border-color: rgba(186,230,253,.5); }
    .toc-num { font-size: .7rem; color: var(--text-dim); width: 28px; flex-shrink: 0; font-family: monospace; }
    .read-btn { display: block; text-align: center; margin: 28px auto 0; padding: 12px 32px; background: var(--sky); color: #fff; border-radius: var(--r-pill); font-size: .9rem; font-family: 'Newsreader', serif; transition: var(--t); max-width: 220px; }
    .read-btn:hover { background: var(--sky2); transform: translateY(-2px); }
  </style>

  <img src="/dynamic-duo-web/images/biatdxt.png" alt="Bìa truyện" class="story-cover"
    onerror="this.src='/dynamic-duo-web/images/frontpage.png'" />

  <div style="text-align:center">
    <h2 style="margin:0 0 10px;font-size:1.3rem">Hạ cháy đồng hoang</h2>
    <span class="status-badge">🌊 Đang tiến hành</span>
    <div style="font-size:.9rem;color:var(--text-mid);margin:4px 0"><strong style="color:var(--sky-dark)">Tác giả:</strong> Hỉ Thượng Mi Sao</div>
    <div style="font-size:.9rem;color:var(--text-mid);margin:4px 0"><strong style="color:var(--sky-dark)">Editor:</strong> Dynamic Duo</div>
    <div style="font-size:.9rem;color:var(--text-mid);margin:4px 0"><strong style="color:var(--sky-dark)">Thể loại:</strong> Đam mỹ · Hiện đại · Chua xót · Mất trí nhớ</div>
    <div class="progress-bar-wrap">
      <div class="progress-label">📖 Tiến độ: {pct}% ({chapters.length}/{total} chương)</div>
      <div class="progress-bar"><div class="progress-fill" style={`width:${pct}%`}></div></div>
    </div>
  </div>

  <div class="char-grid">
    <div><div class="char-name">??</div><div class="char-role">Công</div></div>
    <div style="font-size:1.2rem;color:var(--sky-light)">✧ ✖ ✧</div>
    <div><div class="char-name">??</div><div class="char-role">Thụ</div></div>
  </div>

  <div class="intro-block">
    <h4>📖 Giới thiệu</h4>
    <p>Tình yêu là bản năng ẩn sau miền hoang tàn của ký ức.</p>
    <p>Khi anh không còn nhớ gì, liệu tình cảm có thể tự tìm lại đường về?</p>
  </div>

  {chapters.length > 0 && (
    <a href={chapters[0].url} class="read-btn">Đọc từ Chương 1 →</a>
  )}

  <div class="toc-section">
    <div class="toc-title">🌊 Mục lục ({chapters.length} chương đã đăng)</div>
    <div class="toc-grid">
      {chapters.map((c) => (
        <a href={c.url} class="toc-item">
          <span class="toc-num">C{c.frontmatter?.chuong}</span>
          <span>{c.frontmatter?.title || `Chương ${c.frontmatter?.chuong}`}</span>
        </a>
      ))}
    </div>
  </div>
<div class="public-reviews-widget" data-truyen-id="NHẬP_MÃ_TRUYỆN_VÀO_ĐÂY">
  <div class="prw-header">
    <h3>⭐ Đánh giá từ độc giả</h3>
    <div class="prw-stats">
      <div class="prw-avg-box">
        <span class="prw-avg">0.0</span>
        <div class="prw-stars-wrap">
          <span class="prw-stars">☆☆☆☆☆</span>
          <span class="prw-count">(0 đánh giá)</span>
        </div>
      </div>
    </div>
  </div>

  <div class="prw-form-box">
    <p style="text-align:center; font-size: 0.75rem; color: var(--sky); margin: 0 0 10px; text-transform: uppercase; letter-spacing: 1px;">Bạn thấy truyện này thế nào?</p>
    <div class="prw-star-select" id="prwStarSelect">
      <span data-val="1">★</span><span data-val="2">★</span><span data-val="3">★</span><span data-val="4">★</span><span data-val="5" class="active">★</span>
    </div>
    <div class="prw-form-row">
      <input class="prw-inp" id="prwName" placeholder="Tên của bạn (Tùy chọn)" autocomplete="off" />
    </div>
    <textarea class="prw-textarea" id="prwText" placeholder="Chia sẻ cảm nhận của bạn về bộ truyện này nhé... 🌊" rows="3"></textarea>
    <div style="text-align:right">
      <button class="prw-submit-btn" id="prwSubmit">Gửi đánh giá ✦</button>
    </div>
  </div>

  <div class="prw-list" id="prwList">
     <div style="grid-column: 1/-1; text-align:center; padding: 40px; font-style:italic; color:var(--text-dim);">Đang tải đánh giá...</div>
  </div>
</div>

<style>
  /* TỔNG THỂ */
  .public-reviews-widget {
    margin: 60px auto 40px;
    padding: 30px 0;
    border-top: 1px solid var(--border-card);
    font-family: var(--read-ff, 'Newsreader', serif);
    max-width: 900px;
  }

  /* HEADER & ĐIỂM SỐ */
  .prw-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 30px; flex-wrap: wrap; gap: 20px; }
  .prw-header h3 { margin: 0; font-size: 1.1rem; color: var(--sky-dark); font-family: 'Merriweather', serif; text-transform: uppercase; letter-spacing: 1px; }
  
  .prw-avg-box { display: flex; align-items: center; gap: 12px; background: var(--bg-card); padding: 8px 16px; border-radius: var(--r-md); border: 1px solid var(--border-card); box-shadow: var(--sh-soft); }
  .prw-avg { font-weight: 700; font-size: 1.8rem; color: var(--sky-dark); line-height: 1; }
  .prw-stars-wrap { display: flex; flex-direction: column; }
  .prw-stars { color: #fbbf24; font-size: 0.9rem; letter-spacing: 2px; }
  .prw-count { font-size: 0.65rem; color: var(--text-dim); font-style: italic; }

  /* FORM NHẬP ĐÁNH GIÁ */
  .prw-form-box { 
    background: var(--bg-card2); 
    padding: 24px; 
    border-radius: var(--r-lg); 
    margin-bottom: 40px; 
    border: 1px solid var(--border-card);
    box-shadow: var(--sh-card);
  }
  .prw-star-select { font-size: 2.2rem; color: #d1d5db; cursor: pointer; user-select: none; text-align: center; margin-bottom: 15px; }
  .prw-star-select span { transition: all 0.2s; padding: 0 4px; display: inline-block; }
  .prw-star-select span:hover { transform: scale(1.2); }
  .prw-star-select span.active { color: #fbbf24; text-shadow: 0 0 10px rgba(251, 191, 36, 0.3); }

  .prw-inp, .prw-textarea { 
    width: 100%; padding: 12px 16px; 
    border: 1.5px solid var(--sky-light); 
    border-radius: 12px; font-size: .9rem; 
    font-family: inherit; color: var(--text-main); 
    background: var(--cream); outline: none; 
    margin-bottom: 12px; transition: all 0.2s;
    box-sizing: border-box;
  }
  .prw-inp:focus, .prw-textarea:focus { border-color: var(--sky); box-shadow: 0 0 0 3px rgba(14,165,233,0.1); background: #fff; }
  
  .prw-submit-btn { 
    padding: 10px 28px; background: var(--sky); color: #fff; 
    border: none; border-radius: var(--r-pill); 
    font-size: .85rem; cursor: pointer; font-family: inherit; 
    font-weight: 600; transition: all 0.3s; 
  }
  .prw-submit-btn:hover { background: var(--sky2); transform: translateY(-2px); box-shadow: 0 4px 12px rgba(2,132,199,0.3); }

  /* DANH SÁCH REVIEW */
  .prw-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
  
  .prw-item {
    background: var(--bg-card); border: 1px solid var(--border-card);
    padding: 20px; border-radius: var(--r-md); transition: all 0.3s;
    display: flex; flex-direction: column; position: relative;
    box-shadow: var(--sh-soft);
  }
  .prw-item:hover { transform: translateY(-4px); box-shadow: 0 8px 20px rgba(2,132,199,0.12); border-color: var(--sky-light); }
  
  .prw-item-user { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
  .prw-item-name { font-weight: 700; font-size: 0.85rem; color: var(--sky-dark); font-family: 'Merriweather', serif; }
  .prw-item-stars { color: #fbbf24; font-size: 0.75rem; letter-spacing: 1px; }
  
  .prw-item-text { 
    font-size: 0.88rem; color: var(--text-main); line-height: 1.7; 
    margin: 0 0 15px 0; flex-grow: 1; word-break: break-word;
    font-style: italic;
  }
  
  .prw-item-footer { 
    display: flex; justify-content: space-between; align-items: center; 
    border-top: 1px solid rgba(186,230,253,0.3); padding-top: 10px;
  }
  .prw-item-time { font-size: 0.65rem; color: var(--text-dim); }
  
  .prw-del-btn { 
    font-size: 0.65rem; color: var(--text-dim); background: rgba(239,68,68,0.05); 
    border: 1px solid transparent; cursor: pointer; padding: 3px 8px; 
    border-radius: 4px; transition: all 0.2s;
  }
  .prw-del-btn:hover { color: #ef4444; background: rgba(239,68,68,0.1); border-color: #fca5a5; }

  /* DARK MODE OVERRIDES */
  [data-theme="dark"] .prw-avg-box,
  [data-theme="dark"] .prw-item { background: #0f2336; border-color: rgba(126,200,227,0.1); }
  [data-theme="dark"] .prw-form-box { background: rgba(15,35,54,0.4); }
  [data-theme="dark"] .prw-inp, [data-theme="dark"] .prw-textarea { background: #0a1929; border-color: #1e4a6a; color: #F3F9FF; }
  [data-theme="dark"] .prw-avg, [data-theme="dark"] .prw-item-name { color: #a8daf0; }
</style>

<script is:inline>
  (function loadPublicReviews() {
    const widget = document.querySelector('.public-reviews-widget');
    const listEl = document.getElementById('prwList');
    if(!widget || !listEl) return;
    const truyenId = widget.dataset.truyenId;
    
    function esc(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
    function timeAgo(ts){
      if(!ts) return ''; const d=Date.now()-ts;
      if(d<60000) return 'vừa xong'; if(d<3600000) return Math.floor(d/60000)+' phút trước';
      if(d<86400000) return Math.floor(d/3600000)+' giờ trước'; return Math.floor(d/86400000)+' ngày trước';
    }
    function getMyToken(){ let t = localStorage.getItem('dd_token'); if(!t){ t = Math.random().toString(36).slice(2)+Date.now().toString(36); localStorage.setItem('dd_token',t); } return t; }
    
    const myToken = getMyToken();
    const savedName = localStorage.getItem('dd_commenter_name');
    if(savedName) document.getElementById('prwName').value = savedName;

    let selectedStars = 5;
    const starSelect = document.getElementById('prwStarSelect');
    if(starSelect) {
      const stars = starSelect.querySelectorAll('span');
      stars.forEach(s => {
        s.addEventListener('click', () => {
          selectedStars = parseInt(s.dataset.val);
          stars.forEach(st => { st.classList.toggle('active', parseInt(st.dataset.val) <= selectedStars); });
        });
      });
    }

    function initFirebase(fb) {
      fb.onValue(fb.ref(fb.db, 'novel_reviews/' + truyenId), snap => {
        const data = snap.val() || {};
        const items = Object.entries(data).map(([id,v]) => ({id, ...v})).sort((a,b) => b.ts - a.ts);
        
        widget.querySelector('.prw-count').textContent = `(${items.length} đánh giá)`;
        let avg = 0;
        if(items.length > 0) {
           const total = items.reduce((sum, item) => sum + (item.rating||5), 0);
           avg = (total / items.length).toFixed(1);
        }
        widget.querySelector('.prw-avg').textContent = avg > 0 ? avg : '0.0';
        
        let starHtml = ''; const fullStars = Math.round(avg);
        for(let i=0; i<5; i++) starHtml += (i < fullStars ? '★' : '☆');
        widget.querySelector('.prw-stars').textContent = starHtml;

        if(items.length === 0) {
           listEl.innerHTML = '<div style="grid-column: 1/-1; text-align:center; padding: 40px; font-style:italic; color:var(--text-dim); border: 1px dashed var(--border-card); border-radius: 12px;">Chưa có đánh giá nào. Hãy là người đầu tiên chia sẻ cảm nhận nhé! 🐚</div>';
        } else {
           listEl.innerHTML = items.map(rv => {
              const stars = '★'.repeat(rv.rating) + '☆'.repeat(5 - rv.rating);
              const badge = rv.isAdmin ? '<span class="comment-admin-badge" style="margin-left:5px">chủ nhà</span>' : '';
              const canDel = window.__ddIsAdmin || rv.token === myToken;

              return `
                <div class="prw-item">
                  <div class="prw-item-user">
                    <span class="prw-item-name">${esc(rv.name)||'Khách ẩn danh'}${badge}</span>
                    <span class="prw-item-stars">${stars}</span>
                  </div>
                  <p class="prw-item-text">“${esc(rv.text).replace(/\n/g, '<br>')}”</p>
                  <div class="prw-item-footer">
                    <span class="prw-item-time">― ${timeAgo(rv.ts)}</span>
                    ${canDel ? `<button class="prw-del-btn" data-id="${esc(rv.id)}">Xóa</button>` : ''}
                  </div>
                </div>
              `;
           }).join('');

           listEl.querySelectorAll('.prw-del-btn').forEach(b => {
              b.addEventListener('click', async () => {
                 if(!confirm('Bạn muốn xóa đánh giá này?')) return;
                 await fb.remove(fb.ref(fb.db, `novel_reviews/${truyenId}/${b.dataset.id}`));
              });
           });
        }
      });

      const submitBtn = document.getElementById('prwSubmit');
      if(submitBtn && !submitBtn.dataset.boundSubmit) {
        submitBtn.dataset.boundSubmit = "true";
        submitBtn.addEventListener('click', async () => {
          const text = document.getElementById('prwText')?.value.trim();
          let name = document.getElementById('prwName')?.value.trim() || 'Khách';
          if(!text) return;
          
          if(window.__ddIsAdmin) name = 'dynamic duo 𓆝';
          else if(name !== 'Khách') localStorage.setItem('dd_commenter_name', name);
          
          submitBtn.disabled = true;
          submitBtn.textContent = 'Đang gửi...';
          
          try {
            await fb.push(fb.ref(fb.db, 'novel_reviews/' + truyenId), {
              name: name, text: text, rating: selectedStars, ts: Date.now(),
              token: myToken, isAdmin: !!window.__ddIsAdmin
            });
            document.getElementById('prwText').value = '';
          } catch(e) { alert('Lỗi: ' + e.message); } 
          finally { submitBtn.disabled = false; submitBtn.textContent = 'Gửi đánh giá ✦'; }
        });
      }
    }

    if(window.__ddFirebase?.db) { initFirebase(window.__ddFirebase); }
    else { window.addEventListener('dd-firebase-ready', () => initFirebase(window.__ddFirebase), {once:true}); }
  })();
</script>
</Layout>
