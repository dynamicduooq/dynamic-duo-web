---
import Layout from '../../../layouts/Layout.astro';

const allPosts = Object.values(
  import.meta.glob('./*.md', { eager: true })
) as any[];

const chapters = allPosts
  .filter((p) => p.frontmatter?.chuong && p.frontmatter.chuong !== 0)
  .sort((a, b) => (a.frontmatter?.chuong ?? 999) - (b.frontmatter?.chuong ?? 999));
---

<Layout frontmatter={{
  title: 'Tôi nghĩ chúng tôi sắp chia tay',
  description: 'Khủng hoảng năm thứ 8. Hai người lớn nhát gan.',
  tags: ['đam mỹ', 'hiện đại', 'HE', 'chua xót', '1v1', 'thủy tinh']
}}>
  <style>
    .story-cover { width: 200px; border-radius: 12px; box-shadow: var(--sh-card); display: block; margin: 0 auto 28px; }
    .status-badge { display: inline-block; padding: 3px 14px; border-radius: var(--r-pill); font-size: .72rem; letter-spacing: 1.5px; text-transform: uppercase; font-weight: 600; background: #dcfce7; color: #166534; margin: 8px 0 16px; }
    .progress-bar-wrap { max-width: 320px; margin: 12px auto; }
    .progress-label { font-size: .76rem; color: var(--text-dim); text-align: center; margin-bottom: 5px; }
    .progress-bar { height: 6px; background: rgba(186,230,253,.4); border-radius: 3px; overflow: hidden; }
    .progress-fill { height: 100%; background: linear-gradient(to right, var(--sky-light), var(--sky)); border-radius: 3px; }
    .intro-block { background: var(--sky-pale); border: 1px solid rgba(186,230,253,.5); border-radius: var(--r-md); padding: 20px 24px; margin: 24px 0; font-size: .9rem; color: var(--text-mid); line-height: 1.8; }
    .intro-block h4 { font-size: .8rem; letter-spacing: 2px; text-transform: uppercase; color: var(--sky-dark); text-align: left; margin: 0 0 10px; }
    .intro-block p { margin: 0 0 8px; }
    .char-grid { display: grid; grid-template-columns: 1fr auto 1fr; gap: 10px; align-items: center; text-align: center; margin: 20px 0; }
    .char-name { font-family: 'Merriweather', serif; font-size: .95rem; color: var(--sky-dark); }
    .char-role { font-size: .72rem; color: var(--text-dim); letter-spacing: 1px; text-transform: uppercase; margin-top: 3px; }
    .char-divider { font-size: 1.2rem; color: var(--sky-light); }
    .toc-section { margin-top: 32px; }
    .toc-title { font-family: 'Merriweather', serif; font-size: .88rem; color: var(--sky-dark); letter-spacing: 2px; text-transform: uppercase; text-align: center; margin-bottom: 16px; padding-bottom: 10px; border-bottom: 1px dashed var(--sky-light); }
    .toc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
    @media (max-width: 480px) { .toc-grid { grid-template-columns: 1fr; } }
    .toc-item { display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: var(--r-sm); font-size: .84rem; color: var(--text-mid); transition: var(--t); border: 1px solid transparent; }
    .toc-item:hover { background: var(--sky-pale); color: var(--sky); border-color: rgba(186,230,253,.5); }
    .toc-num { font-size: .7rem; color: var(--text-dim); width: 28px; flex-shrink: 0; font-family: monospace; }
    .read-btn { display: block; text-align: center; margin: 28px auto 0; padding: 12px 32px; background: var(--sky); color: #fff; border-radius: var(--r-pill); font-size: .9rem; font-family: 'Newsreader', serif; transition: var(--t); max-width: 220px; }
    .read-btn:hover { background: var(--sky2); transform: translateY(-2px); }
  </style>

  <img src="/dynamic-duo-web/images/biatnctsct.png" alt="Bìa truyện" class="story-cover"
    onerror="this.src='/dynamic-duo-web/images/frontpage.png'" />

  <div style="text-align:center">
    <h2 style="margin:0 0 4px;font-size:1.3rem">Tôi nghĩ chúng tôi sắp chia tay</h2>
    <p style="font-size:.8rem;color:var(--text-dim);font-style:italic;margin:0 0 10px">我觉得我们快分手了</p>
    <span class="status-badge">✅ Hoàn thành</span>
    <div style="font-size:.9rem;color:var(--text-mid);margin:4px 0"><strong style="color:var(--sky-dark)">Tác giả:</strong> Hạ Nhất Thiên</div>
    <div style="font-size:.9rem;color:var(--text-mid);margin:4px 0"><strong style="color:var(--sky-dark)">Editor:</strong> Dynamic Duo</div>
    <div style="font-size:.9rem;color:var(--text-mid);margin:4px 0"><strong style="color:var(--sky-dark)">Thể loại:</strong> Đam mỹ · Hiện đại · HE · Chua xót</div>
    <div class="progress-bar-wrap">
      <div class="progress-label">📖 Tiến độ: 100% ({chapters.length} chương)</div>
      <div class="progress-bar"><div class="progress-fill" style="width:100%"></div></div>
    </div>
  </div>

  <div class="char-grid">
    <div><div class="char-name">??</div><div class="char-role">Công</div></div>
    <div class="char-divider">✧ ✖ ✧</div>
    <div><div class="char-name">??</div><div class="char-role">Thụ</div></div>
  </div>

  <div class="intro-block">
    <h4>📖 Giới thiệu</h4>
    <p>Khủng hoảng năm thứ 8. Hai người lớn nhát gan, không ai chịu nói trước.</p>
    <p>Một mối quan hệ đủ lâu để thành thói quen, đủ nặng để không dám buông, nhưng cũng đủ mệt để bắt đầu nghi ngờ.</p>
    <p>Đây có phải là kết thúc không? Hay chỉ là một cơn sóng khác trước khi bình yên trở lại?</p>
  </div>

  {chapters.length > 0 && (
    <a href={chapters[0].url} class="read-btn">Đọc từ Chương 1 →</a>
  )}

  <div class="toc-section">
    <div class="toc-title">🌊 Mục lục ({chapters.length} chương)</div>
    <div class="toc-grid">
      {chapters.map((c) => (
        <a href={c.url} class="toc-item">
          <span class="toc-num">C{c.frontmatter?.chuong}</span>
          <span>{c.frontmatter?.title || `Chương ${c.frontmatter?.chuong}`}</span>
        </a>
      ))}
    </div>
  </div>
  <!-- =============== KHU VỰC REVIEW CÔNG KHAI =============== -->
<div class="public-reviews-widget" data-truyen-id="tnctsct">
  <div class="prw-header">
    <h3>⭐ Đánh giá từ độc giả</h3>
    <div class="prw-stats">
      <span class="prw-avg">0.0</span>
      <span class="prw-stars">☆☆☆☆☆</span>
      <span class="prw-count">(0 đánh giá)</span>
    </div>
  </div>
  <div class="prw-list" id="prwList">
     <div style="grid-column: 1/-1; text-align:center; padding: 20px; font-style:italic; color:gray">Đang tải đánh giá...</div>
  </div>
</div>

<style>
  .public-reviews-widget {
    margin-top: 40px; padding-top: 24px;
    border-top: 2px dashed var(--sky-light);
    font-family: var(--read-ff, 'Newsreader', serif);
  }
  [data-theme="dark"] .public-reviews-widget { border-color: rgba(126,200,227,0.2); }
  .prw-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 10px;}
  .prw-header h3 { margin: 0; font-size: 1.15rem; color: var(--sky-dark); font-family: 'Merriweather', serif;}
  [data-theme="dark"] .prw-header h3 { color: #a8daf0; }
  .prw-stats { display: flex; align-items: center; gap: 8px; }
  .prw-avg { font-weight: bold; font-size: 1.5rem; color: var(--sky-dark); line-height: 1;}
  [data-theme="dark"] .prw-avg { color: #a8daf0; }
  .prw-stars { color: #fbbf24; font-size: 1.1rem; letter-spacing: 2px; }
  .prw-count { font-size: 0.8rem; color: var(--text-dim); }
  
  .prw-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
  .prw-item {
    background: var(--sky-pale); border: 1px solid rgba(186,230,253,0.5);
    padding: 18px; border-radius: 14px; transition: transform 0.2s, box-shadow 0.2s;
  }
  .prw-item:hover { transform: translateY(-3px); box-shadow: 0 4px 15px rgba(2,132,199,0.08); }
  [data-theme="dark"] .prw-item { background: rgba(15,35,54,0.6); border-color: rgba(126,200,227,0.15); }
  [data-theme="dark"] .prw-item:hover { box-shadow: 0 4px 15px rgba(0,0,0,0.3); }
  .prw-item-name { font-weight: 600; font-size: 0.95rem; color: var(--sky-dark); display: block; margin-bottom: 2px;}
  [data-theme="dark"] .prw-item-name { color: #a8daf0; }
  .prw-item-stars { color: #fbbf24; font-size: 0.85rem; letter-spacing: 1px; margin-bottom: 8px; display: block;}
  .prw-item-text { font-size: 0.9rem; color: var(--text-main); line-height: 1.6; margin: 0 0 10px 0; }
  [data-theme="dark"] .prw-item-text { color: #F3F9FF; }
  .prw-item-time { font-size: 0.75rem; color: var(--text-dim); font-style: italic;}
</style>

<script is:inline>
  (function loadPublicReviews() {
    const widget = document.querySelector('.public-reviews-widget');
    const listEl = document.getElementById('prwList');
    if(!widget || !listEl) return;
    const truyenId = widget.dataset.truyenId;
    
    function esc(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
    function timeAgo(ts){
      if(!ts) return ''; const d=Date.now()-ts;
      if(d<60000) return 'vừa xong'; if(d<3600000) return Math.floor(d/60000)+' phút trước';
      if(d<86400000) return Math.floor(d/3600000)+' giờ trước'; return Math.floor(d/86400000)+' ngày trước';
    }

    function initFetch(fb) {
      fb.onValue(fb.ref(fb.db, 'novel_reviews/' + truyenId), snap => {
        const data = snap.val() || {};
        const items = Object.entries(data).map(([id,v]) => ({id, ...v})).sort((a,b) => b.ts - a.ts);
        
        widget.querySelector('.prw-count').textContent = `(${items.length} đánh giá)`;
        
        let avg = 0;
        if(items.length > 0) {
           const total = items.reduce((sum, item) => sum + (item.rating||5), 0);
           avg = (total / items.length).toFixed(1);
        }
        widget.querySelector('.prw-avg').textContent = avg > 0 ? avg : '0.0';
        
        let starHtml = ''; const fullStars = Math.round(avg);
        for(let i=0; i<5; i++) starHtml += (i < fullStars ? '★' : '☆');
        widget.querySelector('.prw-stars').textContent = starHtml;

        if(items.length === 0) {
           listEl.innerHTML = '<div style="grid-column: 1/-1; text-align:center; padding: 20px; font-style:italic; color:var(--text-dim);">Chưa có đánh giá nào. Chờ bạn thả sao đấy! ⭐</div>';
        } else {
           listEl.innerHTML = items.map(rv => {
              const stars = '★'.repeat(rv.rating) + '☆'.repeat(5 - rv.rating);
              const badge = rv.isAdmin ? '<span style="background:var(--sky); color:#fff; font-size:.6rem; padding:2px 8px; border-radius:99px; margin-left:6px; vertical-align:middle; font-family:sans-serif">chủ nhà</span>' : '';
              return `
                <div class="prw-item">
                  <span class="prw-item-name">${esc(rv.name)||'Khách ẩn danh'}${badge}</span>
                  <span class="prw-item-stars">${stars}</span>
                  <p class="prw-item-text">${esc(rv.text).replace(/\n/g, '<br>')}</p>
                  <div class="prw-item-time">${timeAgo(rv.ts)}</div>
                </div>
              `;
           }).join('');
        }
      });
    }

    if(window.__ddFirebase?.db) { initFetch(window.__ddFirebase); }
    else { window.addEventListener('dd-firebase-ready', () => initFetch(window.__ddFirebase), {once:true}); }
  })();
</script>
<!-- ========================================================== -->
</Layout>
