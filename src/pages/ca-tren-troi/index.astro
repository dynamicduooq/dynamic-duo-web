---
import Layout from '../../layouts/Layout.astro';

// 1. Quét toàn bộ data truyện từ kho tổng (Lưu ý đường dẫn có 2 dấu chấm '../' vì đang đứng ở thư mục con)
const allStoryPages = Object.values(import.meta.glob('../truyen/**/index.astro', { eager: true })) as any[];
const allChaps = Object.values(import.meta.glob('../truyen/**/*.md', { eager: true })) as any[];

// 2. Thuật toán kiểm tra tiến độ truyện
const storiesData = allStoryPages.map((storyPage: any) => {
  const pathParts = (storyPage.url || '').split('/').filter(Boolean);
  const id = pathParts[pathParts.length - 1]; 
  
  const chapsOfStory = allChaps.filter((c: any) => 
    c.url?.includes(`/truyen/${id}/`) && c.frontmatter?.chuong
  );
  
  const isCompleted = storyPage.hoan_thanh === true || 
                     (storyPage.tong_so_chuong && chapsOfStory.length >= storyPage.tong_so_chuong);

  return {
    id,
    url: storyPage.url,
    title: storyPage.title || 'Đang cập nhật',
    author: storyPage.author || 'Đang cập nhật',
    chapCount: chapsOfStory.length,
    isCompleted
    // Bổ sung thêm các trường như bìa truyện, description nếu cần...
  };
});

// 3. Lọc lấy ĐÚNG mâm Cá Dưới Nước (Chưa hoàn thành)
const caTrenTroiList = storiesData.filter(s => !s.isCompleted);
---

<Layout frontmatter={{ title: 'Cá trên trời' }}>
  <style>
    .page-hero { text-align: center; padding: 10px 0 36px; }
    .page-emoji { font-size: 2.5rem; display: block; margin-bottom: 10px; }
    .page-title { font-family: 'Merriweather', serif; font-size: 1.4rem; color: var(--sky-dark); margin: 0 0 6px; }
    .page-sub { font-size: .85rem; color: var(--text-dim); font-style: italic; margin: 0 0 30px; }
    .cloud-note {
      background: var(--sky-pale);
      border: 1.5px dashed var(--sky-light);
      border-radius: var(--r-md);
      padding: 20px 24px;
      text-align: center;
      margin-bottom: 32px;
    }
    .cloud-note p { color: var(--text-mid); font-size: .88rem; font-style: italic; margin: 0; line-height: 1.7; }
    .upcoming-list { display: flex; flex-direction: column; gap: 16px; }
    .upcoming-item {
      display: flex; gap: 16px; align-items: center;
      border: 1px solid rgba(186,230,253,.5);
      border-radius: var(--r-md);
      padding: 16px 20px;
      background: #fff;
    }
    .upcoming-cover {
      width: 60px; height: 80px; border-radius: var(--r-sm);
      object-fit: cover; background: var(--sky-pale);
      flex-shrink: 0; display: block;
    }
    .upcoming-cover-placeholder {
      width: 60px; height: 80px; border-radius: var(--r-sm);
      background: var(--sky-pale); flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.5rem; color: var(--sky-light);
    }
    .upcoming-info { flex: 1; }
    .upcoming-badge {
      font-size: .65rem; letter-spacing: 1.5px; text-transform: uppercase;
      padding: 2px 10px; border-radius: var(--r-pill); margin-bottom: 6px;
      font-weight: 600; display: inline-block;
      background: #e0f2fe; color: #0369a1;
    }
    .upcoming-title { font-family: 'Merriweather', serif; font-size: .95rem; color: var(--sky-dark); margin: 0 0 4px; }
    .upcoming-author { font-size: .74rem; color: var(--text-dim); font-style: italic; margin: 0 0 6px; }
    .upcoming-desc { font-size: .82rem; color: var(--text-mid); margin: 0 0 8px; line-height: 1.5; }
    .upcoming-tags { display: flex; flex-wrap: wrap; gap: 4px; }
    .upcoming-tag { font-size: .65rem; padding: 2px 7px; border: 1px solid var(--sky-light); border-radius: var(--r-pill); color: var(--sky); background: var(--sky-pale); }
  </style>

  <div class="page-hero">
    <span class="page-emoji">🌤️</span>
    <h1 class="page-title">Cá trên trời</h1>
    <p class="page-sub">những chú cá đang bay — truyện dự định làm (sắp đào)</p>
  </div>

  <div class="cloud-note">
    <p>☁️ Những câu chuyện này vẫn đang nằm trên mây, chờ ngày hạ cánh.<br />
    Danh sách có thể thay đổi bất cứ lúc nào tùy vào tâm trạng của Xê và Gờ.</p>
  </div>

  <div class="upcoming-list">
    {upcoming.map(u => (
      <div class="upcoming-item">
        {u.cover
          ? <img src={u.cover} alt={u.title} class="upcoming-cover" onerror="this.style.display='none'" />
          : <div class="upcoming-cover-placeholder">☁️</div>
        }
        <div class="upcoming-info">
          <span class="upcoming-badge">🌤️ Sắp đào</span>
          <h3 class="upcoming-title">{u.title}</h3>
          <p class="upcoming-author">Tác giả: {u.author}</p>
          <p class="upcoming-desc">{u.desc}</p>
          <div class="upcoming-tags">
            {u.tags.map(t => <span class="upcoming-tag"># {t}</span>)}
          </div>
        </div>
      </div>
    ))}
  </div>
</Layout>
