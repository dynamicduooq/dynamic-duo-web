---
import Layout from '../../layouts/Layout.astro';
const allChaps = Object.values(import.meta.glob('../truyen/**/*.md', { eager: true })) as any[];

// 1. Lọc slug chuẩn xác, bỏ các url không phải truyện
const slugs = [...new Set(allChaps.map(p => {
  const parts = (p.url || "").split('/').filter(Boolean);
  const idx = parts.indexOf('truyen');
  return idx !== -1 ? parts[idx + 1] : null;
}))].filter(Boolean) as string[];

// 2. Gom dữ liệu
const storiesData = slugs.map(slug => {
  const storyChaps = allChaps.filter(p => p.url?.includes(`/truyen/${slug}/`));
  const infoFile = storyChaps.find(c => c.frontmatter?.truyen_name) || storyChaps[0];
  const fm = infoFile?.frontmatter || {};
  const chapCount = storyChaps.filter(c => c.frontmatter?.chuong && c.frontmatter.chuong !== 0).length;
  
  return { 
    title: fm.truyen_name || slug,
    author: fm.author || 'Ẩn danh',
    cover: fm.cover || `/dynamic-duo-web/images/bia${slug.replace(/-/g, '')}.png`,
    tags: fm.tags || [],
    desc: fm.description || '',
    isUpcoming: chapCount === 0, // Dấu hiệu của Cá trên trời (có file giới thiệu nhưng chưa có chương nào)
    url: `/dynamic-duo-web/truyen/${slug}/`
  };
});

// 3. Lọc danh sách Cá trên trời
const caTrenTroiList = storiesData.filter(s => s.isUpcoming);
---

<Layout frontmatter={{ title: 'Cá trên trời' }}>
  <style>
    .page-hero { text-align: center; padding: 10px 0 36px; }
    .page-emoji { font-size: 2.5rem; display: block; margin-bottom: 10px; }
    .page-title { font-family: 'Merriweather', serif; font-size: 1.4rem; color: var(--sky-dark); margin: 0 0 6px; }
    .page-sub { font-size: .85rem; color: var(--text-dim); font-style: italic; margin: 0; }

    .story-list { display: flex; flex-direction: column; gap: 24px; margin-top: 24px; max-width: 900px; margin-left: auto; margin-right: auto;}
    .story-item {
      display: flex; gap: 20px;
      border: 1px solid rgba(186,230,253,.5);
      border-radius: var(--r-md);
      overflow: hidden;
      background: #fff;
      transition: var(--t);
    }
    [data-theme="dark"] .story-item { background: var(--bg-card); border-color: rgba(126,200,227,0.15); }
    .story-item:hover { box-shadow: var(--sh-card); transform: translateY(-2px); }
    
    /* Cover cho truyện chưa có bìa thì hiện mây */
    .story-cover { width: 140px; min-height: 180px; object-fit: cover; flex-shrink: 0; background: var(--sky-pale); display: flex; align-items: center; justify-content: center; font-size: 3rem; color: var(--sky-light);}
    
    .story-info { padding: 18px 20px 18px 0; flex: 1; display: flex; flex-direction: column; }
    
    /* Đổi màu Badge cho Cá trên trời (Màu xám/bạc) */
    .story-badge {
      display: inline-block; font-size: .65rem; letter-spacing: 1.5px;
      text-transform: uppercase; padding: 2px 10px; border-radius: var(--r-pill);
      margin-bottom: 8px; font-weight: 600; width: fit-content;
      background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1;
    }
    [data-theme="dark"] .story-badge { background: rgba(30,41,59,0.6); color: #94a3b8; border-color: #334155;}

    .story-title { font-family: 'Merriweather', serif; font-size: 1rem; color: var(--sky-dark); margin: 0 0 4px; }
    [data-theme="dark"] .story-title { color: #a8daf0; }
    .story-author { font-size: .76rem; color: var(--text-dim); font-style: italic; margin: 0 0 8px; }
    .story-desc { font-size: .84rem; color: var(--text-mid); line-height: 1.65; margin: 0 0 10px; flex: 1; }
    [data-theme="dark"] .story-desc { color: #b8d4e8; }
    .story-tags { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 10px; }
    .story-tag { font-size: .68rem; padding: 2px 8px; border: 1px solid var(--sky-light); border-radius: var(--r-pill); color: var(--sky); background: var(--sky-pale); }
    [data-theme="dark"] .story-tag { background: rgba(20,55,90,.6); border-color: rgba(80,150,210,.4); color: #a8d4f0; }
    .story-progress { font-size: .72rem; color: var(--text-dim); margin-bottom: 12px; }
    .story-btns { display: flex; gap: 8px; }
    .btn-outline {
      padding: 7px 16px; border: 1.5px solid var(--sky-light); border-radius: var(--r-pill);
      color: var(--sky-dark); font-size: .8rem; font-family: 'Newsreader', serif; transition: var(--t);
    }
    [data-theme="dark"] .btn-outline { color: #a8daf0; border-color: rgba(80,150,210,.4); }
    .btn-outline:hover { background: var(--sky-pale); color: var(--sky); }
    [data-theme="dark"] .btn-outline:hover { background: rgba(20,55,90,.6); }
    @media (max-width: 500px) {
      .story-item { flex-direction: column; }
      .story-cover { width: 100%; height: 180px; }
      .story-info { padding: 14px; }
    }
    /* ─── FIXED: NỀN TRẮNG DARK THEME CHO THẺ TRUYỆN ─── */
[data-theme="dark"] .story-item, 
[data-theme="dark"] .story-card {
  background: var(--bg-card) !important;
  border-color: rgba(126,200,227,0.15) !important;
}

[data-theme="dark"] .story-item *, 
[data-theme="dark"] .story-card * {
  color: #d8eeff;
}

[data-theme="dark"] .story-item h2, 
[data-theme="dark"] .story-item h3,
[data-theme="dark"] .story-card h2, 
[data-theme="dark"] .story-card h3 {
  color: #a8daf0 !important;
}

[data-theme="dark"] .story-item .story-author,
[data-theme="dark"] .story-item .story-desc {
  color: #8fbcd4 !important;
}

[data-theme="dark"] .story-item .btn-outline,
[data-theme="dark"] .story-card .btn-outline {
  background: rgba(20,55,90,.6);
  border-color: rgba(80,150,210,.4);
  color: #a8d4f0 !important;
}
  </style>

  <div class="page-hero">
    <span class="page-emoji">🌤️</span>
    <h1 class="page-title">Cá trên trời</h1>
    <p class="page-sub">những chú cá nhỏ chờ một ngày tung cánh — dự án sắp ra mắt</p>
  </div>

  <div class="story-list">
    {caTrenTroiList.length === 0 ? (
      <div style="text-align: center; color: var(--text-dim); font-style: italic; padding: 40px 0;">
        Hiện không có dự án nào sắp ra mắt.
      </div>
    ) : (
      caTrenTroiList.map(s => (
        <div class="story-item">
          <a href={s.url}>
            {s.cover ? (
               <img src={s.cover} alt={s.title} class="story-cover" onerror="this.parentElement.style.background='var(--sky-pale)'; this.style.display='none'" />
            ) : (
               <div class="story-cover">☁️</div>
            )}
          </a>
          <div class="story-info">
            <span class="story-badge">🌤️ Sắp đào</span>
            <h2 class="story-title">{s.title}</h2>
            <p class="story-author">Tác giả: {s.author}</p>
            {s.desc && <p class="story-desc">{s.desc}</p>}
            <div class="story-tags">
              {s.tags.map((t: string) => <span class="story-tag"># {t}</span>)}
            </div>
            <p class="story-progress">⏱️ Tiến độ: Sắp cập nhật</p>
            <div class="story-btns">
              <a href={s.url} class="btn-outline">Xem giới thiệu →</a>
            </div>
          </div>
        </div>
      ))
    )}
  </div>
</Layout>