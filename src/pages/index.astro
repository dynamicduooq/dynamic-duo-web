<!-- ═══════════════════════════════════════════════════════════
     JAVASCRIPT
════════════════════════════════════════════════════════════ -->
<script is:inline>
/* ─────────────────────────────────────────────
   1. READING PROGRESS BAR
   Hiện trên trang chương (isNovelPage).
   Trên trang chủ thanh ẩn nhưng JS này
   vẫn an toàn khi chạy (sẽ không làm gì).
───────────────────────────────────────────── */
(function initReadingProgress() {
  const bar = document.getElementById('reading-progress');
  if (!bar) return;

  // Chỉ hiện khi có nội dung dài (chương truyện) hoặc user cuộn trang chủ
  bar.style.display = 'block';

  function update() {
    const scrolled = window.scrollY;
    const total = document.documentElement.scrollHeight - window.innerHeight;
    const pct = total > 0 ? Math.min(100, (scrolled / total) * 100) : 0;
    bar.style.width = pct + '%';
  }

  window.addEventListener('scroll', update, { passive: true });
  update();
})();

/* ─────────────────────────────────────────────
   2. DARK MODE — ổn định, lưu localStorage
───────────────────────────────────────────── */
(function initDarkMode() {
  const KEY = 'dd-theme';
  const btn = document.getElementById('darkBtn');

  function applyTheme(dark) {
    document.documentElement.setAttribute('data-theme', dark ? 'dark' : '');
    if (btn) btn.textContent = dark ? '☀️ Chế độ sáng' : '🌙 Chế độ tối';
    localStorage.setItem(KEY, dark ? 'dark' : 'light');

    // Sync giscus nếu có
    const iframe = document.querySelector('iframe.giscus-frame');
    if (iframe) {
      iframe.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: dark ? 'dark_dimmed' : 'light' } } },
        'https://giscus.app'
      );
    }
  }

  // Áp dụng ngay (tránh flash)
  const saved = localStorage.getItem(KEY);
  const prefersDark = window.matchMedia?.('(prefers-color-scheme: dark)').matches;
  applyTheme(saved === 'dark' || (!saved && prefersDark));

  btn?.addEventListener('click', () => {
    applyTheme(document.documentElement.getAttribute('data-theme') !== 'dark');
  });

  // Theo dõi thay đổi OS
  window.matchMedia?.('(prefers-color-scheme: dark)')
    .addEventListener('change', e => {
      if (!localStorage.getItem(KEY)) applyTheme(e.matches);
    });
})();

/* ─────────────────────────────────────────────
   3. MULTI-SELECT TAG FILTER
   Logic OR: ấn "hiện đại" → hiện tất cả truyện
   có tag "hiện đại". Ấn thêm "niên hạ" → hiện
   truyện có "hiện đại" HOẶC "niên hạ".
   Kết hợp với filter danh mục (cat) bằng AND.
───────────────────────────────────────────── */
(function initFilter() {
  const cards     = Array.from(document.querySelectorAll('.story-card'));
  const filterBtns = Array.from(document.querySelectorAll('#tagFilter .filter-btn'));
  const clearBtn  = document.getElementById('filterClear');
  const countEl   = document.getElementById('filterCount');
  const emptyEl   = document.getElementById('emptyState');

  let activeTags = new Set();   // tag OR logic
  let activeCats = new Set();   // cat AND logic với tags

  function applyFilter() {
    const noTagFilter = activeTags.size === 0;
    const noCatFilter = activeCats.size === 0;
    let visible = 0;

    cards.forEach(card => {
      const cardTags = (card.dataset.tags || '').split(',').map(t => t.trim().toLowerCase());
      const cardCat  = (card.dataset.cat  || '').toLowerCase();

      // OR trên tags: ít nhất 1 tag khớp
      const tagMatch = noTagFilter || [...activeTags].some(t => cardTags.includes(t));
      // AND trên cat: nếu có cat filter thì card phải thuộc cat đó
      const catMatch = noCatFilter || activeCats.has(cardCat);

      const show = tagMatch && catMatch;
      card.classList.toggle('hidden', !show);
      if (show) visible++;
    });

    countEl.textContent = visible + ' truyện';
    const hasFilter = activeTags.size > 0 || activeCats.size > 0;
    clearBtn.style.display = hasFilter ? 'inline-block' : 'none';

    // "Tất cả" button
    document.querySelector('.filter-btn[data-tag="all"]')
      ?.classList.toggle('active', !hasFilter);

    // Empty state
    if (emptyEl) emptyEl.style.display = visible === 0 ? 'block' : 'none';
  }

  function resetAll() {
    activeTags.clear();
    activeCats.clear();
    filterBtns.forEach(b => b.classList.remove('active'));
    document.querySelector('.filter-btn[data-tag="all"]')?.classList.add('active');
    // Sync tag cloud sidebar
    document.querySelectorAll('.tag-cloud-btn').forEach(b => b.classList.remove('active'));
    applyFilter();
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.dataset.tag === 'all') { resetAll(); return; }

      document.querySelector('.filter-btn[data-tag="all"]')?.classList.remove('active');

      if (btn.dataset.tag) {
        const tag = btn.dataset.tag.toLowerCase();
        if (activeTags.has(tag)) { activeTags.delete(tag); btn.classList.remove('active'); }
        else                      { activeTags.add(tag);    btn.classList.add('active'); }

        // Sync sidebar tag cloud
        const cloudBtn = document.querySelector(`.tag-cloud-btn[data-tag="${btn.dataset.tag}"]`);
        cloudBtn?.classList.toggle('active', activeTags.has(tag));

      } else if (btn.dataset.cat) {
        const cat = btn.dataset.cat.toLowerCase();
        if (activeCats.has(cat)) { activeCats.delete(cat); btn.classList.remove('active'); }
        else                      { activeCats.add(cat);    btn.classList.add('active'); }
      }

      if (activeTags.size === 0 && activeCats.size === 0)
        document.querySelector('.filter-btn[data-tag="all"]')?.classList.add('active');

      applyFilter();
    });
  });

  clearBtn?.addEventListener('click', resetAll);

  // Sidebar tag cloud
  document.querySelectorAll('.tag-cloud-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag?.toLowerCase();
      if (!tag) return;

      btn.classList.toggle('active');
      if (activeTags.has(tag)) activeTags.delete(tag);
      else                      activeTags.add(tag);

      // Sync filter bar
      const fb = document.querySelector(`#tagFilter .filter-btn[data-tag="${btn.dataset.tag}"]`);
      fb?.classList.toggle('active', activeTags.has(tag));

      if (activeTags.size === 0 && activeCats.size === 0)
           document.querySelector('.filter-btn[data-tag="all"]')?.classList.add('active');
      else document.querySelector('.filter-btn[data-tag="all"]')?.classList.remove('active');

      applyFilter();
      document.getElementById('storyGrid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
})();

/* ─────────────────────────────────────────────
   4. INLINE COMMENT SYSTEM
   Dùng cho trang chương (isNovelPage).
   Script tự phát hiện paragraphs trong .prose
   và gắn UI bình luận inline.
   Trên trang chủ script này tự noop.
───────────────────────────────────────────── */
(function initInlineComments() {
  // Chỉ kích hoạt trên trang có .chapter-content
  const content = document.querySelector('.chapter-content, .prose-chapter');
  if (!content) return;

  // Dummy comment store (localStorage per pathname)
  const STORE_KEY = 'dd-comments:' + location.pathname;
  let comments = [];
  try { comments = JSON.parse(localStorage.getItem(STORE_KEY) || '[]'); } catch(e) {}

  function saveComments() {
    try { localStorage.setItem(STORE_KEY, JSON.stringify(comments)); } catch(e) {}
  }

  function formatTime(ts) {
    const d = new Date(ts);
    return d.toLocaleDateString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric' })
      + ' ' + d.toLocaleTimeString('vi-VN', { hour:'2-digit', minute:'2-digit' });
  }

  function buildPopup(paraId) {
    const paraComments = comments.filter(c => c.paraId === paraId);

    const popup = document.createElement('div');
    popup.className = 'comment-popup';
    popup.dataset.paraId = paraId;

    const list = paraComments.map(c => `
      <div class="cp-header">
        <div class="cp-avatar">👤</div>
        <div class="cp-meta">
          <span class="cp-name">${c.name || 'Độc giả'}</span>
          <span class="cp-time">${formatTime(c.ts)}</span>
        </div>
      </div>
      <p class="cp-text">${c.text}</p>
      <div class="cp-reactions">
        <button class="cp-react-btn" data-cid="${c.id}" data-emoji="❤️">❤️ ${c.reactions?.['❤️'] || 0}</button>
        <button class="cp-react-btn" data-cid="${c.id}" data-emoji="😂">😂 ${c.reactions?.['😂'] || 0}</button>
        <button class="cp-react-btn" data-cid="${c.id}" data-emoji="😢">😢 ${c.reactions?.['😢'] || 0}</button>
      </div>
    `).join('<hr style="border:none;border-top:1px dashed var(--sky-light);margin:10px 0"/>');

    popup.innerHTML = `
      <button class="cp-close" title="Đóng">×</button>
      ${list || '<p class="cp-text" style="color:var(--text-dim);font-style:italic">Chưa có bình luận nào. Bạn là người đầu tiên! ✨</p>'}
      <div class="cp-input-row">
        <textarea class="cp-input" placeholder="Nhận xét về đoạn này..." rows="1"></textarea>
        <button class="cp-send">Gửi</button>
      </div>
    `;

    // Close
    popup.querySelector('.cp-close').addEventListener('click', () => closePopup(popup));

    // Send
    const input = popup.querySelector('.cp-input');
    const send  = popup.querySelector('.cp-send');
    send.addEventListener('click', () => {
      const text = input.value.trim();
      if (!text) return;
      const c = { id: Date.now(), paraId, text, name: 'Độc giả', ts: Date.now(), reactions: {} };
      comments.push(c);
      saveComments();
      input.value = '';
      // Rebuild popup
      const newPopup = buildPopup(paraId);
      popup.replaceWith(newPopup);
      newPopup.classList.add('open');
      // Update icon count
      updateIconCount(paraId);
    });

    // Reactions
    popup.querySelectorAll('.cp-react-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const cid = parseInt(btn.dataset.cid);
        const emoji = btn.dataset.emoji;
        const comment = comments.find(c => c.id === cid);
        if (!comment) return;
        if (!comment.reactions) comment.reactions = {};
        comment.reactions[emoji] = (comment.reactions[emoji] || 0) + 1;
        saveComments();
        btn.textContent = emoji + ' ' + comment.reactions[emoji];
        btn.classList.add('reacted');
      });
    });

    return popup;
  }

  function closePopup(popup) {
    popup.classList.remove('open');
    setTimeout(() => popup.remove(), 220);
  }

  function closeAllPopups() {
    document.querySelectorAll('.comment-popup.open').forEach(p => closePopup(p));
  }

  function updateIconCount(paraId) {
    const count = comments.filter(c => c.paraId === paraId).length;
    const icon = document.querySelector(`.comment-icon[data-para-id="${paraId}"]`);
    if (icon) icon.textContent = count > 0 ? count : '💬';
  }

  // Gắn icon vào từng paragraph
  const paras = content.querySelectorAll('p');
  paras.forEach((para, i) => {
    const paraId = 'p-' + i;
    para.style.position = 'relative';

    const count = comments.filter(c => c.paraId === paraId).length;
    const icon = document.createElement('button');
    icon.className = 'comment-icon';
    icon.dataset.paraId = paraId;
    icon.textContent = count > 0 ? count : '💬';
    icon.title = 'Bình luận đoạn này';
    para.appendChild(icon);

    icon.addEventListener('click', e => {
      e.stopPropagation();
      const existing = document.querySelector(`.comment-popup[data-para-id="${paraId}"]`);
      if (existing?.classList.contains('open')) { closePopup(existing); return; }
      closeAllPopups();
      const popup = buildPopup(paraId);
      para.appendChild(popup);
      requestAnimationFrame(() => popup.classList.add('open'));
    });
  });

  // Click ngoài đóng popup
  document.addEventListener('click', e => {
    if (!e.target.closest('.comment-popup') && !e.target.classList.contains('comment-icon')) {
      closeAllPopups();
    }
  });
})();

/* ─────────────────────────────────────────────
   5. DARK MODE + GISCUS SYNC
   Lắng nghe thay đổi iframe giscus khi đổi theme
───────────────────────────────────────────── */
(function syncGiscusDark() {
  const observer = new MutationObserver(() => {
    const dark = document.documentElement.getAttribute('data-theme') === 'dark';
    document.querySelector('iframe.giscus-frame')
      ?.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: dark ? 'dark_dimmed' : 'light' } } },
        'https://giscus.app'
      );
  });
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
})();
</script>

