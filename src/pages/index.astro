---
import Layout from '../layouts/Layout.astro';

const ndntkmPosts  = Object.values(import.meta.glob('./ca-tren-ban/neu-dem-nay-troi-khong-mua/*.md',   { eager: true })) as any[];
const tnctcstPosts = Object.values(import.meta.glob('./ca-tren-ban/toi-nghi-chung-toi-sap-chia-tay/*.md', { eager: true })) as any[];
const qhbcpPosts   = Object.values(import.meta.glob('./ca-duoi-nuoc/quan-he-ban-cung-phong/*.md',   { eager: true })) as any[];
const hcdhPosts    = Object.values(import.meta.glob('./ca-duoi-nuoc/ha-chay-dong-hoang/*.md',      { eager: true })) as any[];
const countChaps   = (posts: any[]) => posts.filter((p: any) => p.frontmatter?.chuong && p.frontmatter.chuong !== 0).length;

const ndntkmCount  = countChaps(ndntkmPosts);
const tnctcstCount = countChaps(tnctcstPosts);
const qhbcpCount   = countChaps(qhbcpPosts);
const hcdhCount    = countChaps(hcdhPosts);
---

<Layout title="Trang chủ" isHome={true}>
<style>
/* ─── HOME SHELL ─── */
.home-shell {
  display: grid;
  grid-template-columns: 1fr 240px;
  gap: 22px;
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px 28px 80px;
  align-items: start;
  box-sizing: border-box;
  width: 100%;
}
@media(max-width:1100px){ .home-shell{ grid-template-columns:1fr 200px; padding:18px 20px 80px; gap:16px; } }
@media(max-width:900px){  .home-shell{ grid-template-columns:1fr; padding:14px 14px 80px; } }

/* ─── TICKER ─── */
.ticker-wrap {
  overflow: hidden; padding: 6px 0;
  background: linear-gradient(90deg,rgba(224,242,254,.5),rgba(240,249,255,.7),rgba(224,242,254,.5));
  border-top: 1px solid var(--sky-light); border-bottom: 1px solid var(--sky-light);
}
[data-theme="dark"] .ticker-wrap {
  background: linear-gradient(90deg,rgba(8,18,32,.9),rgba(10,22,38,.95),rgba(8,18,32,.9));
  border-color: rgba(96,184,232,.18);
}
.ticker-track { display:flex; white-space:nowrap; animation:ticker 40s linear infinite; }
.ticker-track:hover { animation-play-state:paused; }
.ticker-item {
  display:inline-flex; align-items:center; padding:0 20px;
  font-size:.7rem; color:var(--sky2); letter-spacing:1.5px;
}
[data-theme="dark"] .ticker-item { color:#a8d8f0; }
.ticker-item::after { content:'𓆝'; color:var(--sky-light); margin-left:20px; }
@keyframes ticker { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }

/* ─── HERO ─── */
.hero { text-align:center; padding:18px 0 14px; }
.hero-banner-wrap {
  position:relative; border-radius:14px; overflow:hidden;
  max-height:190px; margin:0 auto;
  display:flex; align-items:center; justify-content:center;
}
.hero-banner-bg { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:0; }
.hero-banner-overlay {
  position:absolute; inset:0;
  background:linear-gradient(180deg,rgba(2,70,130,.35) 0%,rgba(2,50,100,.6) 100%);
  z-index:1; pointer-events:none;
}
.hero-name-img {
  position:relative; z-index:2; max-width:360px; width:82%;
  display:block; margin:0 auto; padding:22px 0;
  filter:drop-shadow(0 2px 12px rgba(0,0,0,.35));
}
.hero-tagline { font-size:.78rem; color:var(--text-dim); font-style:italic; margin:9px 0 0; }
[data-theme="dark"] .hero-tagline { color:#7ab8d4; }

/* ─── SECTION HEADER ─── */
.sec-hd { display:flex; align-items:center; gap:10px; margin:22px 0 11px; }
.sec-hd h2 {
  font-family:'Merriweather',serif; font-size:.76rem; color:var(--sky-dark);
  letter-spacing:2px; text-transform:uppercase; margin:0; text-align:left; white-space:nowrap;
}
[data-theme="dark"] .sec-hd h2 { color:#7ec8e3; }
.sec-line { flex:1; height:1px; background:linear-gradient(to right,var(--sky-light),transparent); }
[data-theme="dark"] .sec-line { background:linear-gradient(to right,rgba(96,184,232,.3),transparent); }

/* ─── FILTER BAR ─── */
.filter-bar {
  background: #ffffff; border:1px solid rgba(186,230,253,.5);
  border-radius:12px; padding:9px 12px;
  display:flex; flex-wrap:wrap; gap:5px; align-items:center;
  margin-bottom:12px;
}
[data-theme="dark"] .filter-bar { background:#0d1f33; border-color:rgba(96,184,232,.2); }
.fl-label { font-size:.62rem; letter-spacing:2px; text-transform:uppercase; color:var(--text-dim); flex-shrink:0; }
[data-theme="dark"] .fl-label { color:#6a9ab5; }
.fl-chips { display:flex; flex-wrap:wrap; gap:4px; flex:1; }
.chip {
  display:inline-flex; align-items:center; gap:3px; padding:3px 10px;
  border-radius:var(--r-pill); font-size:.67rem; cursor:pointer;
  transition:var(--t); border:1.5px solid rgba(186,230,253,.6);
  background:var(--sky-pale); color:var(--sky-dark); user-select:none;
  font-family:'Newsreader',serif; white-space:nowrap;
}
[data-theme="dark"] .chip { color:#a8d8f0; border-color:rgba(96,184,232,.25); background:rgba(14,32,52,.9); }
.chip:hover { background:var(--sky-light); color:var(--sky-dark); }
[data-theme="dark"] .chip:hover { background:rgba(96,184,232,.15); color:#e0f4ff; }
.chip.active { background:var(--sky); color:#fff; border-color:var(--sky); }
[data-theme="dark"] .chip.active { background:#1a6aaa; border-color:#7ec8e3; color:#e8f6ff; }
.chip-clear { background:none; border-color:rgba(186,230,253,.4); color:var(--text-dim); }
.chip-clear:hover { background:rgba(239,68,68,.08); color:#ef4444; border-color:#fca5a5; }
.fl-count {
  font-size:.7rem; background:var(--sky-pale); color:var(--sky-dark);
  padding:2px 8px; border-radius:var(--r-pill); border:1px solid var(--sky-light);
  white-space:nowrap; margin-left:auto;
}
[data-theme="dark"] .fl-count { background:rgba(21,101,160,.2); border-color:rgba(96,184,232,.25); color:#a8d8f0; }

/* ─── STORY GRID ─── */
.stories-grid { display:flex; flex-direction:column; gap:9px; }
.sc {
  display:flex;
  background: #ffffff;
  border:1px solid rgba(186,230,253,.5);
  border-radius:12px; overflow:hidden;
  transition:var(--t); box-shadow:0 2px 8px rgba(2,132,199,.05);
}
[data-theme="dark"] .sc { background:#0d1f33; border-color:rgba(96,184,232,.18); }
.sc:hover { box-shadow:0 6px 22px rgba(2,132,199,.12); transform:translateY(-2px); }
[data-theme="dark"] .sc:hover { box-shadow:0 6px 22px rgba(0,0,0,.5); }
.sc-cover-wrap {
  position:relative; flex-shrink:0; width:105px; min-height:135px; overflow:hidden;
  background:linear-gradient(135deg,var(--sky-pale),rgba(186,230,253,.3));
  display:flex; align-items:center; justify-content:center;
}
.sc-cover-wrap img { width:105px; height:auto; max-height:none; object-fit:contain; display:block; padding:4px; }
.sc-status {
  position:absolute; top:6px; left:0;
  font-size:.5rem; letter-spacing:1px; text-transform:uppercase;
  padding:2px 6px; border-radius:0 4px 4px 0; font-weight:700;
}
.status-ongoing  { background:rgba(2,132,199,.9);  color:#fff; }
.status-complete { background:rgba(5,150,105,.9);  color:#fff; }
.status-upcoming { background:rgba(100,116,139,.8); color:#fff; }
.sc-body { padding:10px 12px; flex:1; display:flex; flex-direction:column; gap:3px; min-width:0; }
.sc-shelf { font-size:.6rem; letter-spacing:1.5px; text-transform:uppercase; color:var(--sky); }
[data-theme="dark"] .sc-shelf { color:#7ec8e3; }
.sc-title {
  font-family:'Merriweather',serif; font-size:.84rem; color:#0c4a6e;
  margin:0; line-height:1.35; text-align:left;
  overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
}
[data-theme="dark"] .sc-title { color:#d8f0ff; }
.sc-meta { font-size:.65rem; color:#475569; font-style:italic; }
[data-theme="dark"] .sc-meta { color:#7ab8d4; }
.sc-tags { display:flex; flex-wrap:wrap; gap:3px; }
.sc-tag {
  font-size:.58rem; padding:1px 7px;
  border:1px solid var(--sky-light); border-radius:var(--r-pill);
  color:#0369a1; background:#e0f2fe;
}
[data-theme="dark"] .sc-tag { border-color:rgba(96,184,232,.3); background:rgba(21,101,160,.25); color:#a8d8f0; }
.sc-footer { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-top:auto; padding-top:4px; }
.sc-chapters { font-size:.65rem; color:#475569; }
[data-theme="dark"] .sc-chapters { color:#7ab8d4; }
.sc-link { font-size:.68rem; padding:3px 11px; background:var(--sky); color:#fff; border-radius:var(--r-pill); transition:var(--t); flex-shrink:0; }
.sc-link:hover { background:var(--sky2); }
.sc-link.secondary { background:#e0f2fe; color:#0369a1; }
[data-theme="dark"] .sc-link.secondary { color:#a8d8f0; background:rgba(21,101,160,.3); border:1px solid rgba(96,184,232,.25); }
.sc-link.secondary:hover { background:#bae6fd; }
[data-theme="dark"] .sc-link.secondary:hover { background:rgba(96,184,232,.18); }

/* ─── NOTICE ─── */
.notice-section { margin-top:22px; }
.notice-img { width:100%; display:block; border-radius:10px; }

/* ─── RECENT ─── */
.recent-list { display:flex; flex-direction:column; gap:6px; }
.recent-item {
  display:flex; align-items:center; gap:10px; padding:9px 12px;
  background:#ffffff; border:1px solid rgba(186,230,253,.4); border-radius:10px;
  transition:var(--t); color:var(--text-main);
}
[data-theme="dark"] .recent-item { background:#0d1f33; border-color:rgba(96,184,232,.18); }
.recent-item:hover { background:var(--sky-pale); border-color:var(--sky-light); transform:translateX(3px); }
[data-theme="dark"] .recent-item:hover { background:rgba(96,184,232,.08); }
.recent-icon { font-size:.95rem; flex-shrink:0; }
.ri-body { flex:1; min-width:0; }
.ri-story { font-size:.64rem; color:#64748b; text-overflow:ellipsis; overflow:hidden; white-space:nowrap; }
[data-theme="dark"] .ri-story { color:#6a9ab5; }
.ri-title { font-size:.8rem; color:#0c4a6e; font-weight:600; }
[data-theme="dark"] .ri-title { color:#d8f0ff; }
.recent-arrow { color:var(--sky); font-size:.88rem; }

/* ─── SIDEBAR ─── */
.sidebar-col {
  display:flex; flex-direction:column; gap:12px;
  position:sticky; top:68px;
  max-height:calc(100vh - 84px); overflow-y:auto; overflow-x:hidden;
  scrollbar-width:thin; scrollbar-color:var(--sky-light) transparent;
  padding-bottom:8px;
}
.sidebar-col::-webkit-scrollbar { width:3px; }
.sidebar-col::-webkit-scrollbar-thumb { background:var(--sky-light); border-radius:3px; }
@media(max-width:900px){ .sidebar-col{ position:static; max-height:none; } }

/* ─── WIDGET BASE ─── */
.widget {
  background:#ffffff; border:1px solid rgba(186,230,253,.65);
  border-radius:14px; padding:13px 12px; flex-shrink:0;
}
[data-theme="dark"] .widget {
  background:#0d1f33;
  border-color:rgba(96,184,232,.18);
}
.widget-title {
  font-family:'Merriweather',serif; font-size:.68rem;
  letter-spacing:2.5px; text-transform:uppercase; color:var(--sky);
  text-align:center; margin-bottom:10px;
}
[data-theme="dark"] .widget-title { color:#7ec8e3; }

/* Profile widget */
.profile-avatar {
  width:66px; height:66px; border-radius:50%; overflow:hidden;
  margin:0 auto 8px; border:3px solid var(--sky-light);
  background:var(--sky-pale); display:flex; align-items:center; justify-content:center; font-size:2rem;
}
.profile-name { font-family:'Merriweather',serif; color:#0c4a6e; font-size:.86rem; text-align:center; margin-bottom:2px; }
[data-theme="dark"] .profile-name { color:#d8f0ff; }
.profile-tagline { font-size:.72rem; color:#64748b; font-style:italic; text-align:center; line-height:1.5; margin-bottom:5px; }
[data-theme="dark"] .profile-tagline { color:#7ab8d4; }
.profile-deco { text-align:center; font-size:.88rem; letter-spacing:3px; color:var(--sky-light); }

/* Category tree */
.cat-tree { font-size:.74rem; color:#64748b; }
[data-theme="dark"] .cat-tree { color:#7ab8d4; }
.cat-tree ul { list-style:none; padding-left:12px; margin:3px 0; }
.cat-tree > ul { padding-left:0; }
.cat-tree a { color:#64748b; transition:color .2s; display:block; padding:2px 0; }
[data-theme="dark"] .cat-tree a { color:#7ab8d4; }
.cat-tree a:hover { color:var(--sky); }
[data-theme="dark"] .cat-tree a:hover { color:#d8f0ff; }
.cat-tree summary {
  cursor:pointer; font-size:.76rem; color:#0c4a6e; font-weight:600;
  padding:3px 0; list-style:none; display:flex; align-items:center; gap:5px;
}
[data-theme="dark"] .cat-tree summary { color:#a8d8f0; }
.cat-tree summary::-webkit-details-marker { display:none; }
.cat-tree summary::before { content:'▸'; font-size:.58rem; transition:transform .2s; color:var(--sky); }
[data-theme="dark"] .cat-tree summary::before { color:#7ec8e3; }
.cat-tree details[open]>summary::before { transform:rotate(90deg); }
.cat-count { font-size:.62rem; color:#94a3b8; margin-left:4px; }
[data-theme="dark"] .cat-count { color:#4a7a96; }

/* Quote widget */
.quote-body {
  font-style:italic; font-size:.75rem; color:#475569; line-height:1.75;
  border-left:3px solid var(--sky-light); padding-left:10px; margin:0;
}
[data-theme="dark"] .quote-body { color:#b8daf0; border-left-color:#1e4a6a; }
.quote-widget-inner {
  border-radius:10px; padding:10px 12px; margin:-2px;
}
[data-theme="dark"] .quote-widget-inner {
  background:linear-gradient(135deg,rgba(10,28,50,.95),rgba(6,16,30,.98));
  border:1px solid rgba(96,184,232,.18);
}
.quote-src { font-size:.62rem; color:#94a3b8; margin-top:6px; text-align:right; }
[data-theme="dark"] .quote-src { color:#4a7a96; }

/* ─── MESSAGE WIDGET ─── */
.msg-widget-tabs {
  display:flex; gap:0; margin-bottom:9px;
  border:1px solid rgba(186,230,253,.6); border-radius:var(--r-pill); overflow:hidden;
}
[data-theme="dark"] .msg-widget-tabs { border-color:rgba(96,184,232,.2); }
.msg-tab {
  flex:1; padding:4px 0; font-size:.6rem; letter-spacing:.5px; text-transform:uppercase;
  background:none; border:none; cursor:pointer; font-family:'Newsreader',serif;
  color:var(--text-mid); transition:var(--t);
}
.msg-tab.active { background:var(--sky); color:#fff; }
[data-theme="dark"] .msg-tab { color:#6a9ab5; background:transparent; }
[data-theme="dark"] .msg-tab.active { background:#1a6aaa; color:#e8f6ff; }
.msg-panel { display:none; }
.msg-panel.active { display:block; }

.msg-inp, .msg-textarea {
  width:100%; padding:5px 10px;
  border:1.5px solid var(--sky-light); font-family:'Newsreader',serif;
  color:#1e3a5f; background:#fff; outline:none;
  box-sizing:border-box; font-size:.7rem; margin-bottom:5px;
  border-radius:var(--r-pill);
}
.msg-textarea { border-radius:8px; resize:none; min-height:44px; }
.msg-inp:focus, .msg-textarea:focus { border-color:var(--sky); }
[data-theme="dark"] .msg-inp, [data-theme="dark"] .msg-textarea {
  background:#071220; border-color:#1a4a6a; color:#c8e4f5;
}
[data-theme="dark"] .msg-inp::placeholder, [data-theme="dark"] .msg-textarea::placeholder { color:#3a6a86; }

.msg-send-btn {
  width:100%; padding:5px; background:var(--sky); color:#fff;
  border:none; border-radius:var(--r-pill); font-size:.7rem;
  font-family:'Newsreader',serif; cursor:pointer; transition:var(--t);
}
.msg-send-btn:hover { background:var(--sky2); }
.msg-send-btn:disabled { opacity:.5; cursor:not-allowed; }
.msg-sent-notice {
  text-align:center; font-size:.62rem; color:#059669; padding:5px 0;
  display:none; font-style:italic;
}
[data-theme="dark"] .msg-sent-notice { color:#34d399; }

/* ── PUBLIC FEED ── */
.msg-public-feed {
  max-height:130px; overflow-y:auto; display:flex; flex-direction:column; gap:5px;
  margin-bottom:7px; scrollbar-width:thin; scrollbar-color:var(--sky-light) transparent;
}
.msg-public-feed::-webkit-scrollbar { width:3px; }
.msg-public-feed::-webkit-scrollbar-thumb { background:var(--sky-light); border-radius:3px; }

/* ── PUBLIC ITEM — fixed layout ── */
.msg-pub-item {
  position: relative;                          /* ← cần cho X absolute */
  background:var(--sky-pale); border-radius:8px;
  padding: 5px 24px 5px 8px;                  /* right padding để X không đè text */
  border:1px solid rgba(186,230,253,.35);
  line-height: 1.4;
}
[data-theme="dark"] .msg-pub-item {
  background:rgba(18,42,68,.6);
  border-color:rgba(96,184,232,.13);
}
.msg-pub-name {
  font-weight:700; color:var(--sky-dark); font-size:.6rem;
  display:inline;
}
[data-theme="dark"] .msg-pub-name { color:#7ec8e3; }
.msg-pub-time {
  font-size:.54rem; color:var(--text-dim); margin-left:4px;
  display:inline;
}
[data-theme="dark"] .msg-pub-time { color:#3a6a86; }
.msg-pub-text {
  color:var(--text-main); margin:1px 0 0; line-height:1.35;
  word-break:break-word; font-size:.6rem; display:block;
}
[data-theme="dark"] .msg-pub-text { color:#b8d8f0; }

/* ── X button — absolute top-right ── */
.msg-pub-del {
  position: absolute;
  top: 4px; right: 5px;
  background:none; border:none;
  font-size:.48rem; color:var(--text-dim);
  cursor:pointer; padding:1px 2px;
  line-height:1; border-radius:3px;
  transition:color .15s, background .15s;
  display:none;
}
.msg-pub-del.show { display:block; }
.msg-pub-del:hover { color:#ef4444; background:rgba(239,68,68,.1); }

.msg-public-empty { font-size:.6rem; color:var(--text-dim); font-style:italic; text-align:center; padding:8px 0; }
[data-theme="dark"] .msg-public-empty { color:#3a6a86; }

/* admin message highlight */
.msg-pub-admin { background:rgba(14,165,233,.06)!important; border-color:rgba(14,165,233,.22)!important; }
[data-theme="dark"] .msg-pub-admin { background:rgba(21,101,160,.18)!important; border-color:rgba(96,184,232,.28)!important; }
.msg-pub-admin-name { color:var(--sky-dark)!important; }
[data-theme="dark"] .msg-pub-admin-name { color:#7ec8e3!important; }
.msg-pub-owner-badge {
  display:inline-block; font-size:.44rem; background:var(--sky); color:#fff;
  padding:1px 4px; border-radius:var(--r-pill); margin-left:3px; vertical-align:middle;
}

/* ── PRIVATE CARDS ── */
.msg-priv-card {
  border-radius:9px; padding:7px 9px;
  border:1px solid rgba(186,230,253,.4); font-size:.62rem;
  background:var(--sky-pale);
}
[data-theme="dark"] .msg-priv-card {
  background:rgba(18,42,68,.5);
  border-color:rgba(96,184,232,.13);
}
.msg-priv-card.unread  { border-left:3px solid var(--sky); }
.msg-priv-card.replied { border-left:3px solid #34d399; opacity:.88; }
.msg-priv-card-header  { display:flex; align-items:center; gap:5px; margin-bottom:3px; }
.msg-priv-sender { font-weight:700; color:var(--sky-dark); font-size:.6rem; }
[data-theme="dark"] .msg-priv-sender { color:#7ec8e3; }
.msg-priv-time { font-size:.54rem; color:var(--text-dim); margin-left:auto; }
[data-theme="dark"] .msg-priv-time { color:#3a6a86; }
.msg-priv-del  { background:none; border:none; cursor:pointer; font-size:.54rem; color:var(--text-dim); padding:0 3px; transition:color .15s; }
.msg-priv-del:hover { color:#ef4444; }
.msg-priv-text { color:var(--text-main); line-height:1.4; margin:2px 0 5px; word-break:break-word; font-size:.6rem; }
[data-theme="dark"] .msg-priv-text { color:#b8d8f0; }
.msg-priv-reply-inp {
  width:100%; padding:5px 9px; border:1.5px solid var(--sky-light); border-radius:7px;
  font-size:.62rem; font-family:'Newsreader',serif; resize:none;
  background:#fff; color:var(--text-main); outline:none; margin-bottom:4px;
}
.msg-priv-reply-inp:focus { border-color:var(--sky); }
[data-theme="dark"] .msg-priv-reply-inp { background:#071220; border-color:#1a4a6a; color:#c8e4f5; }
.msg-priv-send-btn {
  padding:3px 10px; background:var(--sky); color:#fff; border:none;
  border-radius:var(--r-pill); font-size:.6rem; cursor:pointer; transition:var(--t);
}
.msg-priv-send-btn:hover { background:var(--sky2); }
.msg-priv-send-btn:disabled { opacity:.5; }
.msg-priv-replied-wrap {
  margin-top:4px; padding:4px 8px; background:rgba(52,211,153,.07);
  border-radius:6px; border:1px solid rgba(52,211,153,.22);
}
[data-theme="dark"] .msg-priv-replied-wrap { background:rgba(52,211,153,.04); border-color:rgba(52,211,153,.18); }
.msg-priv-replied-label { font-size:.54rem; color:#059669; font-weight:700; display:block; margin-bottom:2px; }
.msg-priv-replied-text  { font-size:.6rem; color:var(--text-main); line-height:1.4; }
[data-theme="dark"] .msg-priv-replied-text { color:#b8d8f0; }
.msg-priv-del-reply {
