.no-results.show { display:block; animation: fadeUpAnim 0.3s ease; }
.no-results .fish-icon { display: block; font-size: 2rem; margin-bottom: 10px; animation: swim 3s infinite ease-in-out alternate; }
.hidden { display:none !important; }
.reveal { opacity:0; transform:translateY(15px); transition:opacity .6s cubic-bezier(0.34, 1.56, 0.64, 1),transform .6s cubic-bezier(0.34, 1.56, 0.64, 1); }
.reveal.visible { opacity:1; transform:translateY(0); }

/* FLOATING MAIL BUBBLE */
.msg-bubble-btn { position:fixed; bottom: 126px; right: 22px; z-index: 410; width: 44px; height: 44px; border-radius:50%; background:linear-gradient(135deg, rgba(14,165,233,0.9), rgba(2,132,199,0.9)); backdrop-filter: blur(8px); border:1px solid rgba(255,255,255,0.2); cursor:pointer; color:#fff; font-size:1.1rem; box-shadow:0 6px 16px rgba(2,132,199,.4); display:flex; align-items:center; justify-content:center; transition:transform .3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow .3s ease; }
.msg-bubble-btn:hover { transform:scale(1.15) translateY(-3px); box-shadow:0 10px 25px rgba(2,132,199,.55); }
