<script is:inline>
// ── FILTER LOGIC ──
const allCards = document.querySelectorAll('.sc');
const chips = document.querySelectorAll('.chip');
const flCount = document.getElementById('flCount');
let activeTag = 'all', activeCat = null;

function updateFilter() {
  let visible = 0;
  allCards.forEach(card => {
    const cTags = (card.dataset.tags||'').split(',').map(t=>t.trim().toLowerCase());
    const cCat  = (card.dataset.cat||'').toLowerCase();
    const tagOk = activeTag === 'all' || cTags.includes(activeTag.toLowerCase());
    const catOk = !activeCat || cCat === activeCat;
    const show  = tagOk && catOk;
    card.setAttribute('data-hidden', show ? 'false' : 'true');
    if(show) visible++;
  });
  flCount.textContent = visible + ' truyện';
}

chips.forEach(chip => {
  chip.addEventListener('click', () => {
    if(chip.dataset.tag) {
      activeTag = chip.dataset.tag;
      activeCat = null;
      chips.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
    } else if(chip.dataset.cat) {
      activeCat = activeCat === chip.dataset.cat ? null : chip.dataset.cat;
      activeTag = 'all';
      chips.forEach(c => { if(c.dataset.cat) c.classList.remove('active'); });
      if(activeCat) chip.classList.add('active');
      document.querySelector('.all-chip').classList.remove('active');
    }
    updateFilter();
  });
});

// Tag cloud → filter
document.querySelectorAll('.tag-cloud-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.tag-cloud-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    // sync chip
    activeTag = btn.dataset.tag;
    activeCat = null;
    chips.forEach(c => {
      c.classList.toggle('active', c.dataset.tag === activeTag);
    });
    updateFilter();
    // scroll to stories
    document.getElementById('storiesGrid')?.scrollIntoView({behavior:'smooth',block:'start'});
  });
});

// ── DARK MODE ──
const darkBtn = document.getElementById('darkBtn');
function applyTheme(dark) {
  document.documentElement.setAttribute('data-theme', dark ? 'dark' : '');
  darkBtn.textContent = dark ? '☀️ Chế độ sáng' : '🌙 Chế độ tối';
  localStorage.setItem('dd-theme', dark ? 'dark' : 'light');
}
darkBtn.addEventListener('click', () => {
  applyTheme(document.documentElement.getAttribute('data-theme') !== 'dark');
});
// Restore on load
(function(){
  const saved = localStorage.getItem('dd-theme');
  if(saved === 'dark') applyTheme(true);
})();
</script>
