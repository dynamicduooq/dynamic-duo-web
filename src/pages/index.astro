---
import Layout from '../layouts/Layout.astro';

const ndntkmPosts  = Object.values(import.meta.glob('./ca-tren-ban/neu-dem-nay-troi-khong-mua/*.md',   { eager: true })) as any[];
const tnctcstPosts = Object.values(import.meta.glob('./ca-tren-ban/toi-nghi-chung-toi-sap-chia-tay/*.md', { eager: true })) as any[];
const qhbcpPosts   = Object.values(import.meta.glob('./ca-duoi-nuoc/quan-he-ban-cung-phong/*.md',   { eager: true })) as any[];
const hcdhPosts    = Object.values(import.meta.glob('./ca-duoi-nuoc/ha-chay-dong-hoang/*.md',      { eager: true })) as any[];
const countChaps   = (posts: any[]) => posts.filter((p: any) => p.frontmatter?.chuong && p.frontmatter.chuong !== 0).length;

const ndntkmCount  = countChaps(ndntkmPosts);
const tnctcstCount = countChaps(tnctcstPosts);
const qhbcpCount   = countChaps(qhbcpPosts);
const hcdhCount    = countChaps(hcdhPosts);
---

<Layout title="Trang chủ" isHome={true}>
<style>
/* Override .home-shell để tận dụng full width */
.home-shell {
  max-width: 1400px !important;
  margin: 0 auto !important;
  padding: 20px 40px 80px !important;
  width: 100% !important;
}
 
@media(min-width:1025px){
  .home-shell {
    grid-template-columns: 1fr 280px !important;
  }
}
 
@media(min-width:1400px){
  .home-shell {
    grid-template-columns: 1fr 300px !important;
  }
}
 
@media(max-width:768px){
  .home-shell {
    padding: 14px 16px 60px !important;
  }
}
/* ─── TICKER ─── */
.ticker-wrap {
  overflow:hidden; padding:7px 0;
  background:linear-gradient(90deg,rgba(224,242,254,.5),rgba(240,249,255,.7),rgba(224,242,254,.5));
  border-top:1px solid var(--sky-light); border-bottom:1px solid var(--sky-light);
}
[data-theme="dark"] .ticker-wrap {
  background:linear-gradient(90deg,rgba(13,27,42,.8),rgba(17,31,48,.9),rgba(13,27,42,.8));
  border-color:rgba(96,184,232,.2);
}
.ticker-track { display:flex; white-space:nowrap; animation:ticker 40s linear infinite; }
.ticker-track:hover { animation-play-state:paused; }
.ticker-item {
  display:inline-flex; align-items:center; padding:0 20px;
  font-size:.74rem; color:var(--sky2); letter-spacing:1.5px;
}
[data-theme="dark"] .ticker-item { color:#c8e8f8; }
.ticker-item::after { content:'𓆝'; color:var(--sky-light); margin-left:20px; }
@keyframes ticker { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }

/* ─── PAGE SHELL ─── */
.home-shell {
  display:grid;
  grid-template-columns:1fr 268px;
  gap:24px;
  padding:20px 20px 20px;
  max-width:100%;
  margin:0 auto;
  align-items:start;
  box-sizing:border-box;
  width:100%;
}
@media(max-width:1400px){.home-shell{grid-template-columns:1fr 220px;padding:24px 32px 80px;gap:18px;}}
@media(max-width:1024px){.home-shell{grid-template-columns:1fr;padding:18px 20px 60px;}.sidebar-col{display:none;}}

/* ─── HERO ─── */
.hero{text-align:center;padding:20px 0 16px;}
.hero-banner-wrap{
  position:relative;border-radius:14px;overflow:hidden;
  max-height:200px;margin:0 auto;
  display:flex;align-items:center;justify-content:center;
}
.hero-banner-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;}
.hero-banner-overlay{
  position:absolute;inset:0;
  background:linear-gradient(180deg,rgba(2,70,130,.35) 0%,rgba(2,50,100,.6) 100%);
  z-index:1;pointer-events:none;
}
.hero-name-img{
  position:relative;z-index:2;max-width:380px;width:85%;
  display:block;margin:0 auto;padding:24px 0;
  filter:drop-shadow(0 2px 12px rgba(0,0,0,.35));
}
.hero-tagline{font-size:.82rem;color:var(--text-dim);font-style:italic;margin:10px 0 0;}
[data-theme="dark"] .hero-tagline{color:#9ac8df;}

/* ─── SECTION HEADER ─── */
.sec-hd{display:flex;align-items:center;gap:10px;margin:24px 0 12px;}
.sec-hd h2{
  font-family:'Merriweather',serif;font-size:.78rem;color:var(--sky-dark);
  letter-spacing:2px;text-transform:uppercase;margin:0;text-align:left;white-space:nowrap;
}
[data-theme="dark"] .sec-hd h2{color:#89d0f5;}
.sec-line{flex:1;height:1px;background:linear-gradient(to right,var(--sky-light),transparent);}
[data-theme="dark"] .sec-line{background:linear-gradient(to right,rgba(96,184,232,.35),transparent);}

/* ─── FILTER BAR ─── */
.filter-bar{
  background:#fff;border:1px solid rgba(186,230,253,.5);
  border-radius:12px;padding:10px 12px;
  display:flex;flex-wrap:wrap;gap:6px;align-items:center;
  margin-bottom:14px;
}
[data-theme="dark"] .filter-bar{background:rgba(12,26,42,.98);border-color:rgba(96,184,232,.25);}
.fl-label{font-size:.65rem;letter-spacing:2px;text-transform:uppercase;color:var(--text-dim);flex-shrink:0;}
[data-theme="dark"] .fl-label{color:#9ac8df;}
.fl-chips{display:flex;flex-wrap:wrap;gap:4px;flex:1;}
.chip{
  display:inline-flex;align-items:center;gap:3px;padding:3px 11px;
  border-radius:var(--r-pill);font-size:.7rem;cursor:pointer;
  transition:var(--t);border:1.5px solid rgba(186,230,253,.6);
  background:var(--sky-pale);color:var(--sky-dark);user-select:none;
  font-family:'Newsreader',serif;white-space:nowrap;
}
[data-theme="dark"] .chip{
  color:#c8e8f8;
  border-color:rgba(96,184,232,.3);
  background:rgba(14,32,52,.9);
}
.chip:hover{background:var(--sky-light);color:var(--sky-dark);}
[data-theme="dark"] .chip:hover{background:rgba(96,184,232,.18);color:#e8f6ff;}
.chip.active{background:var(--sky);color:#fff;border-color:var(--sky);}
[data-theme="dark"] .chip.active{background:#1565a0;border-color:#89d0f5;color:#e8f6ff;}
.chip-clear{background:none;border-color:rgba(186,230,253,.4);color:var(--text-dim);}
[data-theme="dark"] .chip-clear{color:#9ac8df;}
.chip-clear:hover{background:rgba(239,68,68,.08);color:#ef4444;border-color:#fca5a5;}
.fl-count{
  font-size:.67rem;background:var(--sky-pale);color:var(--sky-dark);
  padding:2px 9px;border-radius:var(--r-pill);border:1px solid var(--sky-light);
  white-space:nowrap;margin-left:auto;
}
[data-theme="dark"] .fl-count{
  background:rgba(21,101,160,.25);border-color:rgba(96,184,232,.3);color:#c8e8f8;
}

/* ─── STORY GRID ─── */
.stories-grid{display:flex;flex-direction:column;gap:10px;}
.sc{
  display:flex;gap:0;
  background:#fff;border:1px solid rgba(186,230,253,.5);
  border-radius:12px;overflow:hidden;
  transition:var(--t);box-shadow:0 2px 8px rgba(2,132,199,.05);
}
[data-theme="dark"] .sc{background:rgba(12,26,42,.98);border-color:rgba(96,184,232,.22);}
.sc:hover{box-shadow:0 6px 22px rgba(2,132,199,.12);transform:translateY(-2px);}
[data-theme="dark"] .sc:hover{box-shadow:0 6px 22px rgba(0,0,0,.45);}

/* ── Ảnh bìa: rộng hơn, không crop, hiển thị đủ ── */
.sc-cover-wrap{
  position:relative;flex-shrink:0;
  width:110px;          /* tăng từ 78px lên 110px */
  min-height:140px;
  overflow:hidden;
  background:linear-gradient(135deg,var(--sky-pale),rgba(186,230,253,.3));
  display:flex;align-items:center;justify-content:center;
}
.sc-cover-wrap img{
  width:110px;
  height:auto;          /* bỏ height:100% để không bị crop */
  max-height:none;
  object-fit:contain;   /* contain thay vì cover — không crop */
  display:block;
  padding:4px;          /* nhỏ padding để không sát viền */
}
.sc-status{
  position:absolute;top:6px;left:0;
  font-size:.52rem;letter-spacing:1px;text-transform:uppercase;
  padding:2px 6px;border-radius:0 4px 4px 0;font-weight:700;
}
.status-ongoing{background:rgba(2,132,199,.9);color:#fff;}
.status-complete{background:rgba(5,150,105,.9);color:#fff;}
.status-upcoming{background:rgba(100,116,139,.8);color:#fff;}
.sc-body{padding:11px 13px;flex:1;display:flex;flex-direction:column;gap:4px;min-width:0;}
.sc-shelf{font-size:.62rem;letter-spacing:1.5px;text-transform:uppercase;color:var(--sky);}
[data-theme="dark"] .sc-shelf{color:#89d0f5;}

/* Tiêu đề truyện — căn TRÁI */
.sc-title{
  font-family:'Merriweather',serif;font-size:.86rem;
  color:#0c4a6e;
  margin:0;line-height:1.35;
  text-align:left;        /* căn trái */
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
}
[data-theme="dark"] .sc-title{color:#e0f4ff;}

.sc-meta{font-size:.67rem;color:#475569;font-style:italic;}
[data-theme="dark"] .sc-meta{color:#9ac8df;}
.sc-tags{display:flex;flex-wrap:wrap;gap:3px;}
.sc-tag{
  font-size:.6rem;padding:1px 7px;
  border:1px solid var(--sky-light);border-radius:var(--r-pill);
  color:#0369a1;background:#e0f2fe;
}
[data-theme="dark"] .sc-tag{
  border-color:rgba(96,184,232,.35);
  background:rgba(21,101,160,.3);
  color:#c8e8f8;
}
.sc-footer{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:auto;padding-top:4px;}
.sc-chapters{font-size:.67rem;color:#475569;}
[data-theme="dark"] .sc-chapters{color:#9ac8df;}
.sc-link{
  font-size:.71rem;padding:4px 12px;background:var(--sky);color:#fff;
  border-radius:var(--r-pill);transition:var(--t);flex-shrink:0;
}
.sc-link:hover{background:var(--sky2);}
.sc-link.secondary{background:#e0f2fe;color:#0369a1;}
[data-theme="dark"] .sc-link.secondary{
  color:#c8e8f8;background:rgba(21,101,160,.35);
  border:1px solid rgba(96,184,232,.3);
}
.sc-link.secondary:hover{background:#bae6fd;}
[data-theme="dark"] .sc-link.secondary:hover{background:rgba(96,184,232,.22);}

/* ─── NOTICE ─── */
.notice-section{margin-top:24px;}
.notice-img{width:100%;display:block;border-radius:10px;}

/* ─── RECENT ─── */
.recent-list{display:flex;flex-direction:column;gap:6px;}
.recent-item{
  display:flex;align-items:center;gap:10px;padding:10px 13px;
  background:#fff;border:1px solid rgba(186,230,253,.4);border-radius:10px;
  transition:var(--t);color:var(--text-main);
}
[data-theme="dark"] .recent-item{
  background:rgba(12,26,42,.98);border-color:rgba(96,184,232,.2);color:#c8e8f8;
}
.recent-item:hover{background:var(--sky-pale);border-color:var(--sky-light);transform:translateX(3px);}
[data-theme="dark"] .recent-item:hover{background:rgba(96,184,232,.1);}
.recent-icon{font-size:1rem;flex-shrink:0;}
.ri-body{flex:1;min-width:0;}
.ri-story{font-size:.67rem;color:#64748b;text-overflow:ellipsis;overflow:hidden;white-space:nowrap;}
[data-theme="dark"] .ri-story{color:#9ac8df;}
.ri-title{font-size:.83rem;color:#0c4a6e;font-weight:600;}
[data-theme="dark"] .ri-title{color:#e0f4ff;}
.recent-arrow{color:var(--sky);font-size:.9rem;}
[data-theme="dark"] .recent-arrow{color:#89d0f5;}

/* ─── SIDEBAR ─── */
.sidebar-col{
  display:flex;flex-direction:column;gap:14px;
  position:sticky;top:68px;
  max-height:calc(100vh - 84px);overflow-y:auto;overflow-x:hidden;
  scrollbar-width:thin;scrollbar-color:var(--sky-light) transparent;
  padding-bottom:8px;
}
.sidebar-col::-webkit-scrollbar{width:3px;}
.sidebar-col::-webkit-scrollbar-thumb{background:var(--sky-light);border-radius:3px;}

.widget{
  background:#fff;
  border:1px solid rgba(186,230,253,.65);
  border-radius:16px;padding:14px 13px;flex-shrink:0;
}
[data-theme="dark"] .widget{
  background:rgba(10,22,38,.98);
  border-color:rgba(96,184,232,.22);
}
.widget-title{
  font-family:'Merriweather',serif;font-size:.7rem;
  letter-spacing:2.5px;text-transform:uppercase;color:var(--sky);
  text-align:center;margin-bottom:11px;
}
[data-theme="dark"] .widget-title{color:#89d0f5;}
.profile-avatar{
  width:72px;height:72px;border-radius:50%;overflow:hidden;
  margin:0 auto 9px;border:3px solid var(--sky-light);
  background:var(--sky-pale);display:flex;align-items:center;justify-content:center;font-size:2rem;
}
.profile-name{font-family:'Merriweather',serif;color:#0c4a6e;font-size:.9rem;text-align:center;margin-bottom:3px;}
[data-theme="dark"] .profile-name{color:#e0f4ff;}
.profile-tagline{font-size:.76rem;color:#64748b;font-style:italic;text-align:center;line-height:1.5;margin-bottom:6px;}
[data-theme="dark"] .profile-tagline{color:#9ac8df;}
.profile-deco{text-align:center;font-size:.92rem;letter-spacing:3px;color:var(--sky-light);}
[data-theme="dark"] .profile-deco{color:#2a6a8a;}

/* Tag cloud */
.tag-cloud{display:flex;flex-wrap:wrap;justify-content:center;gap:4px;}
.tc-btn{
  display:inline-block;padding:3px 9px;background:#fff;color:#0369a1;
  border-radius:var(--r-pill);font-size:.7rem;border:1px dashed var(--sky-light);
  transition:var(--t);cursor:pointer;
}
[data-theme="dark"] .tc-btn{
  background:rgba(14,30,50,.9);color:#c8e8f8;border-color:rgba(96,184,232,.3);
}
.tc-btn:hover,.tc-btn.active{background:var(--sky-pale);border-style:solid;}
[data-theme="dark"] .tc-btn:hover,[data-theme="dark"] .tc-btn.active{
  background:rgba(96,184,232,.18);color:#e8f6ff;
}

/* Category tree */
.cat-tree{font-size:.76rem;color:#64748b;}
[data-theme="dark"] .cat-tree{color:#9ac8df;}
.cat-tree ul{list-style:none;padding-left:12px;margin:3px 0;}
.cat-tree > ul{padding-left:0;}
.cat-tree a{color:#64748b;transition:color .2s;display:block;padding:2px 0;}
[data-theme="dark"] .cat-tree a{color:#9ac8df;}
.cat-tree a:hover{color:var(--sky);}
[data-theme="dark"] .cat-tree a:hover{color:#e0f4ff;}
.cat-tree summary{
  cursor:pointer;font-size:.78rem;color:#0c4a6e;font-weight:600;
  padding:3px 0;list-style:none;display:flex;align-items:center;gap:5px;
}
[data-theme="dark"] .cat-tree summary{color:#c8e8f8;}
.cat-tree summary::-webkit-details-marker{display:none;}
.cat-tree summary::before{content:'▸';font-size:.6rem;transition:transform .2s;color:var(--sky);}
[data-theme="dark"] .cat-tree summary::before{color:#89d0f5;}
.cat-tree details[open]>summary::before{transform:rotate(90deg);}
.cat-count{font-size:.64rem;color:#94a3b8;margin-left:4px;}
[data-theme="dark"] .cat-count{color:#5a8fa8;}

/* Dark toggle */
.dark-btn{
  width:100%;padding:7px;background:none;border:1.5px solid var(--sky-light);
  border-radius:var(--r-pill);color:#0369a1;font-size:.74rem;cursor:pointer;
  transition:var(--t);font-family:'Newsreader',serif;
  display:flex;align-items:center;justify-content:center;gap:6px;
}
[data-theme="dark"] .dark-btn{border-color:rgba(96,184,232,.35);color:#c8e8f8;}
.dark-btn:hover{background:var(--sky-pale);}
[data-theme="dark"] .dark-btn:hover{background:rgba(96,184,232,.12);}

/* ── Quote widget ── */
.quote-body{
  font-style:italic;font-size:.78rem;color:#475569;line-height:1.75;
  border-left:3px solid var(--sky-light);padding-left:10px;margin:0;
}
/* Dark mode: nền xanh đậm ấm hơn, chữ sáng rõ */
[data-theme="dark"] .quote-widget-inner {
  background: linear-gradient(135deg, rgba(10,30,55,.95), rgba(8,22,42,.98));
  border: 1px solid rgba(96,184,232,.2);
  border-radius: 10px;
  padding: 10px 12px;
  margin: -2px;
}
[data-theme="dark"] .quote-body{
  color:#d4eeff;
  border-left-color:#2a6a8a;
}
.quote-src{font-size:.65rem;color:#94a3b8;margin-top:7px;text-align:right;}
[data-theme="dark"] .quote-src{color:#6a9ab5;}

/* Misc */
.no-results{display:none;text-align:center;padding:28px;color:var(--text-dim);font-style:italic;}
.no-results.show{display:block;}
.hidden{display:none !important;}
.reveal{opacity:0;transform:translateY(16px);transition:opacity .5s ease,transform .5s ease;}
.reveal.visible{opacity:1;transform:translateY(0);}
/* ─── MESSAGE WIDGET ─── */
.msg-widget-tabs {
  display: flex; gap: 0; margin-bottom: 10px;
  border: 1px solid rgba(186,230,253,.6); border-radius: var(--r-pill); overflow: hidden;
}
.msg-tab {
  flex: 1; padding: 5px 0; font-size: .68rem; letter-spacing: 1px; text-transform: uppercase;
  background: none; border: none; cursor: pointer; font-family: 'Newsreader', serif;
  color: var(--text-mid); transition: var(--t);
}
.msg-tab.active { background: var(--sky); color: #fff; }
[data-theme="dark"] .msg-tab { color: #9ac8df; }
[data-theme="dark"] .msg-tab.active { background: #1565a0; color: #e8f6ff; }
 
.msg-panel { display: none; }
.msg-panel.active { display: block; }
 
.msg-inp, .msg-textarea {
  width: 100%; padding: 6px 11px; border: 1.5px solid var(--sky-light);
  font-family: 'Newsreader', serif; color: var(--text-main); background: var(--cream);
  outline: none; box-sizing: border-box; border-radius: var(--r-pill); font-size: .75rem;
  margin-bottom: 6px;
}
.msg-textarea {
  border-radius: 10px; resize: none; min-height: 62px;
}
.msg-inp:focus, .msg-textarea:focus { border-color: var(--sky); }
[data-theme="dark"] .msg-inp, [data-theme="dark"] .msg-textarea {
  background: #091726; border-color: #1e5a7a; color: #daeeff;
}
[data-theme="dark"] .msg-inp::placeholder, [data-theme="dark"] .msg-textarea::placeholder { color: #4a7a96; }
 
.msg-send-btn {
  width: 100%; padding: 7px; background: var(--sky); color: #fff;
  border: none; border-radius: var(--r-pill); font-size: .74rem; font-family: 'Newsreader', serif;
  cursor: pointer; transition: var(--t);
}
.msg-send-btn:hover { background: var(--sky2); }
.msg-send-btn:disabled { opacity: .5; cursor: not-allowed; }
 
.msg-sent-notice {
  text-align: center; font-size: .74rem; color: #059669; padding: 6px 0;
  display: none; font-style: italic;
}
[data-theme="dark"] .msg-sent-notice { color: #34d399; }
 
/* Public feed */
.msg-public-feed {
  max-height: 180px; overflow-y: auto; display: flex; flex-direction: column; gap: 6px;
  margin-bottom: 8px;
  scrollbar-width: thin; scrollbar-color: var(--sky-light) transparent;
}
.msg-public-feed::-webkit-scrollbar { width: 3px; }
.msg-public-feed::-webkit-scrollbar-thumb { background: var(--sky-light); border-radius: 3px; }
 
.msg-pub-item {
  background: var(--sky-pale); border-radius: 10px; padding: 7px 10px;
  border: 1px solid rgba(186,230,253,.35); font-size: .74rem;
}
[data-theme="dark"] .msg-pub-item {
  background: rgba(21,50,80,.35); border-color: rgba(96,184,232,.12);
}
.msg-pub-name { font-weight: 700; color: var(--sky-dark); font-size: .66rem; }
[data-theme="dark"] .msg-pub-name { color: #89d0f5; }
.msg-pub-time { font-size: .6rem; color: var(--text-dim); margin-left: 5px; }
.msg-pub-text { color: var(--text-main); margin: 3px 0 0; line-height: 1.45; word-break: break-word; }
[data-theme="dark"] .msg-pub-text { color: #cce4f8; }
.msg-pub-del {
  float: right; background: none; border: none; font-size: .58rem; color: var(--text-dim);
  cursor: pointer; padding: 0 2px; transition: color .15s; display: none;
}
.msg-pub-del.show { display: inline; }
.msg-pub-del:hover { color: #ef4444; }
 
.msg-public-empty { font-size: .72rem; color: var(--text-dim); font-style: italic; text-align: center; padding: 10px 0; }
[data-theme="dark"] .msg-public-empty { color: #4a7a96; }
 
/* ─── FLOATING BUBBLE ─── */
.msg-bubble-btn {
  position: fixed; bottom: 88px; right: 22px; z-index: 410;
  width: 48px; height: 48px; border-radius: 50%;
  background: linear-gradient(135deg, var(--sky), var(--sky2));
  border: none; cursor: pointer; color: #fff; font-size: 1.25rem;
  box-shadow: 0 4px 18px rgba(2,132,199,.45);
  display: flex; align-items: center; justify-content: center;
  transition: transform .2s, box-shadow .2s;
}
.msg-bubble-btn:hover { transform: scale(1.1) translateY(-2px); box-shadow: 0 8px 24px rgba(2,132,199,.55); }
.msg-bubble-btn .msg-bubble-badge {
  position: absolute; top: -2px; right: -2px;
  background: #f43f5e; color: #fff; font-size: .55rem; font-weight: 700;
  min-width: 16px; height: 16px; border-radius: 8px; padding: 0 3px;
  display: none; align-items: center; justify-content: center;
  border: 2px solid #fff;
}
.msg-bubble-badge.show { display: flex; }
 
/* Popup khi click bubble */
.msg-popup {
  position: fixed; bottom: 148px; right: 16px; z-index: 420;
  width: min(340px, calc(100vw - 32px));
  background: #fff; border: 1px solid rgba(186,230,253,.6);
  border-radius: 18px; box-shadow: 0 16px 48px rgba(2,132,199,.18);
  padding: 16px 15px 14px;
  opacity: 0; pointer-events: none; transform: translateY(12px) scale(.97);
  transition: opacity .22s ease, transform .22s ease;
}
[data-theme="dark"] .msg-popup {
  background: rgba(10,22,38,.98); border-color: rgba(96,184,232,.22);
}
.msg-popup.open { opacity: 1; pointer-events: auto; transform: translateY(0) scale(1); }
 
.msg-popup-header {
  display: flex; align-items: center; justify-content: space-between; margin-bottom: 11px;
}
.msg-popup-title {
  font-family: 'Merriweather', serif; font-size: .78rem; color: var(--sky-dark);
  letter-spacing: 1.5px; text-transform: uppercase;
}
[data-theme="dark"] .msg-popup-title { color: #89d0f5; }
.msg-popup-close {
  width: 26px; height: 26px; border-radius: 50%; border: 1px solid rgba(186,230,253,.5);
  background: none; cursor: pointer; font-size: .68rem; color: var(--text-dim);
  display: flex; align-items: center; justify-content: center; transition: var(--t);
}
.msg-popup-close:hover { background: var(--sky-pale); color: var(--sky); }
[data-theme="dark"] .msg-popup-close { border-color: rgba(96,184,232,.2); color: #6a9ab5; }
 
/* Trên mobile: ẩn bubble nếu sidebar đang open */
@media(max-width:900px){
