/* ══════════════════════════════════════════
   1. HELPERS & DYNAMIC UI
   ══════════════════════════════════════════ */
(function setupGeneralUI() {
  const hour = new Date().getHours();
  let greeting = 'Chào buổi tối';
  if (hour >= 5 && hour < 11) greeting = 'Chào buổi sáng';
  else if (hour >= 11 && hour < 14) greeting = 'Chào buổi trưa';
  else if (hour >= 14 && hour < 18) greeting = 'Chào buổi chiều';
  const grEl = document.getElementById('dynamicGreeting');
  if(grEl) grEl.textContent = greeting + ', đọc truyện vui vẻ nhé! ';

  const lastReadUrl = localStorage.getItem('dd_last_read_url');
  const lastReadTitle = localStorage.getItem('dd_last_read_title');
  const crBanner = document.getElementById('continueReading');
  const crLink = document.getElementById('crLink');
  if (lastReadUrl && lastReadTitle && crBanner && crLink) {
    crLink.textContent = lastReadTitle;
    crBanner.href = lastReadUrl;
    crBanner.classList.remove('hidden');
  }

  const obs = new IntersectionObserver(es => es.forEach(e => { 
    if(e.isIntersecting){ e.target.classList.add('visible'); obs.unobserve(e.target); } 
  }), { threshold: 0.1 });
  document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

  const copyBtn = document.getElementById('sidebarEmailCopy');
  const tooltip = document.getElementById('emailTooltip');
  if(copyBtn && tooltip) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText('dynamicduoo.q@gmail.com').then(() => {
        tooltip.classList.add('show');
        setTimeout(() => tooltip.classList.remove('show'), 2000);
      });
    });
  }
})();

/* ══════════════════════════════════════════
   2. TRUYỆN FILTER LOGIC
   ══════════════════════════════════════════ */
(function setupStoryFilter() {
  const allCards  = document.querySelectorAll('.sc');
  const chips     = document.querySelectorAll('#filterChips .chip');
  const flCount   = document.getElementById('flCount');
  const chipClear = document.getElementById('chipClear');
  let activeTags = new Set();
  let activeCat  = null;

  function applyFilter() {
    let visibleCount = 0;
    allCards.forEach(card => {
      const cCat = card.dataset.cat || '';
      const cTags = (card.dataset.tags || '').split(',').map(t => t.trim().toLowerCase());
      const catMatch = activeCat === null || cCat === activeCat;
      const tagMatch = activeTags.size === 0 || [...activeTags].every(t => cTags.includes(t.toLowerCase()));
      const isVisible = catMatch && tagMatch;
      card.classList.toggle('hidden', !isVisible);
      if(isVisible) visibleCount++;
    });

    if(flCount) flCount.textContent = visibleCount + ' truyện';
    document.getElementById('noRes')?.classList.toggle('show', visibleCount === 0);
    if(chipClear) chipClear.style.display = (activeTags.size > 0 || activeCat !== null) ? 'inline-flex' : 'none';
  }

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      if(chip.id === 'chipClear') {
        activeTags.clear(); activeCat = null;
        chips.forEach(c => c.classList.remove('active'));
        document.querySelector('[data-tag="all"]')?.classList.add('active');
      } else if(chip.dataset.tag) {
        const tag = chip.dataset.tag;
        if(tag === 'all') {
          activeTags.clear();
          chips.forEach(c => c.dataset.tag && c.classList.remove('active'));
          chip.classList.add('active');
        } else {
          document.querySelector('[data-tag="all"]')?.classList.remove('active');
          if(activeTags.has(tag)) { activeTags.delete(tag); chip.classList.remove('active'); }
          else { activeTags.add(tag); chip.classList.add('active'); }
          if(activeTags.size === 0) document.querySelector('[data-tag="all"]')?.classList.add('active');
        }
      } else if(chip.dataset.cat) {
        const cat = chip.dataset.cat;
        chips.forEach(c => c.dataset.cat && c.classList.remove('active'));
        activeCat = (activeCat === cat) ? null : cat;
        if(activeCat) chip.classList.add('active');
      }
      applyFilter();
    });
  });

  window.addEventListener('scroll', () => {
    const fb = document.querySelector('.filter-bar');
    if(fb) fb.classList.toggle('is-stuck', window.scrollY > 300);
  }, { passive: true });
})();

/* ══════════════════════════════════════════
   3. GIAO DIỆN CHAT BUBBLE & FIREBASE LOGIC
   ══════════════════════════════════════════ */
(function setupMessagingSystem() {
  function esc(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function timeAgo(ts){
    if(!ts) return ''; const d = Date.now() - ts;
    if(d < 60000) return 'vừa xong';
    if(d < 3600000) return Math.floor(d/60000)+' phút trước';
    if(d < 86400000) return Math.floor(d/3600000)+' giờ trước';
    return Math.floor(d/86400000)+' ngày trước';
  }
  function getMsgToken(){
    let t = localStorage.getItem('dd_token');
    if(!t){ t = Math.random().toString(36).slice(2) + Date.now().toString(36); localStorage.setItem('dd_token', t); }
    return t;
  }

  const myToken = getMsgToken();
  const ADMIN_NAME = 'dynamic duo 𓆝';

  function setupTabs(containerId, dataAttr) {
    const container = document.getElementById(containerId);
    if(!container) return;
    container.querySelectorAll(`[${dataAttr}]`).forEach(tab => {
      tab.addEventListener('click', () => {
        const panelKey = tab.getAttribute(dataAttr);
        container.querySelectorAll(`[${dataAttr}]`).forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const panels = container.querySelectorAll('.msg-panel');
        panels.forEach(p => p.classList.remove('active'));
        const target = document.getElementById('msgPanel' + panelKey.charAt(0).toUpperCase() + panelKey.slice(1));
        if(target) target.classList.add('active');
      });
    });
  }
  setupTabs('msgSidebarWidget', 'data-panel');

  function initFirebaseLogic() {
    const fb = window.__ddFirebase; if(!fb || !fb.db) return;
    
    function autoCleanupPublic(data) {
        if(!data) return;
        const keys = Object.keys(data);
        if(keys.length > 150) {
            const sortedKeys = keys.sort((a,b) => data[a].ts - data[b].ts);
            const keysToDelete = sortedKeys.slice(0, keys.length - 150);
            keysToDelete.forEach(k => fb.remove(fb.ref(fb.db, `public_messages/${k}`)));
        }
    }

    const renderChatFeed = (messages, currentToken, isAdminUser) => {
        if(!messages || messages.length === 0) return '<div class="msg-public-empty">Hãy bắt đầu trò chuyện 𓆝</div>';
        return messages.map(m => {
            const isSentByAdmin = m.isAdmin; 
            const isMyMsg = isAdminUser ? isSentByAdmin : (m.token === currentToken && !isSentByAdmin);
            
            const wrapClass = isMyMsg ? 'user' : 'admin';
            const nameLabel = isSentByAdmin ? '🐋 Admin' : (esc(m.name) || 'Khách');
            const canDel = window.__ddIsAdmin || (m.token === currentToken && !isSentByAdmin);

            return `
            <div class="chat-bubble-wrap ${wrapClass}">
                <div class="chat-bubble">${esc(m.text)}</div>
                <div class="chat-meta">
                   ${!isMyMsg ? `<span>${nameLabel}</span> • ` : ''}
                   <span>${timeAgo(m.ts)}</span>
                   ${canDel ? `<button class="chat-del-btn" data-id="${m.id}" data-token="${m.token}">✕</button>` : ''}
                </div>
            </div>`;
        }).join('');
    };

    let activeAdminChatToken = null;

    const syncAdminUI = () => {
      const isAdmin = !!window.__ddIsAdmin;
      document.getElementById('msgPrivateAdminBox').style.display = isAdmin ? 'block' : 'none';
      document.getElementById('msgPrivateUserBox').style.display = isAdmin ? 'none' : 'block';

      document.querySelectorAll('.cfm-name').forEach(inp => {
          if (isAdmin) {
              inp.value = ADMIN_NAME;
              inp.disabled = true;
              inp.style.opacity = '0.7';
          } else {
              inp.disabled = false;
              inp.style.opacity = '1';
          }
      });

      document.querySelectorAll('.admin-edit-btn').forEach(el => {
          el.style.display = isAdmin ? 'block' : 'none';
      });
    };

// BẢNG TIN (NOTICE BOARD)
// 1. BẢNG TIN CHÍNH (SIDEBAR)
    fb.onValue(fb.ref(fb.db, 'site_notice'), snap => {
        const data = snap.val() || {};
        const text = data.content ? data.content.replace(/\n/g, '<br>').replace(/(<br\s*\/?>)\s+/gi, '$1') : '<i style="color:var(--text-dim)">Chưa có thông báo mới 𓆝</i>';
        const el = document.getElementById('siteNoticeContent');
        if(el) el.innerHTML = text;
    });

    document.getElementById('btnEditNotice')?.addEventListener('click', () => {
        const currentTextEl = document.getElementById('siteNoticeContent');
        let currentText = currentTextEl ? currentTextEl.innerText.trim() : '';
        if (currentText.includes('Chưa có thông báo') || currentText.includes('Đang tải')) currentText = '';
        
        const newText = prompt('📌 SỬA BẢNG TIN NHÀ CÁ:', currentText);
        if (newText !== null) {
            fb.update(fb.ref(fb.db, '/'), { site_notice: { content: newText.trim(), ts: Date.now() } })
              .then(() => alert('✅ Đã cập nhật bảng tin!'))
              .catch(e => alert('Lỗi: ' + e.message));
        }
    });

    // 2. THÔNG BÁO GHIM TRONG CHAT CHUNG
    fb.onValue(fb.ref(fb.db, 'chat_notice'), snap => {
        const data = snap.val() || {};
        const text = data.content ? data.content.replace(/\n/g, '<br>').replace(/(<br\s*\/?>)\s+/gi, '$1') : '<i style="color:var(--text-dim)">Trò chuyện vui vẻ nhé 𓆝</i>';
        const el = document.getElementById('chatNoticeContent');
        if(el) el.innerHTML = text;
    });

    document.getElementById('btnEditChatNotice')?.addEventListener('click', () => {
        const currentTextEl = document.getElementById('chatNoticeContent');
        let currentText = currentTextEl ? currentTextEl.innerText.trim() : '';
        if (currentText.includes('Trò chuyện vui vẻ') || currentText.includes('Đang tải')) currentText = '';
        
        const newText = prompt('📌 SỬA THÔNG BÁO GHIM (TƯỜNG CHUNG):', currentText);
        if (newText !== null) {
            fb.update(fb.ref(fb.db, '/'), { chat_notice: { content: newText.trim(), ts: Date.now() } })
              .then(() => alert('✅ Đã cập nhật thông báo ghim!'))
              .catch(e => alert('Lỗi: ' + e.message));
        }
    });

    document.getElementById('btnEditNotice')?.addEventListener('click', editNoticeHandler);
    document.getElementById('btnEditPopupNotice')?.addEventListener('click', editNoticeHandler);


    // 1. PUBLIC FEED LOGIC (Tường chung)
    fb.onValue(fb.ref(fb.db, 'public_messages'), snap => {
      const data = snap.val();
      autoCleanupPublic(data); 
      const renderPublic = (containerId) => {
        const el = document.getElementById(containerId);
        if(!el) return;
        if(!data) { el.innerHTML = '<div class="msg-public-empty">Chưa có tin nhắn 𓆝</div>'; return; }
        const items = Object.entries(data).map(([id,v])=>({id,...v})).sort((a,b)=>a.ts-b.ts);
        
        el.innerHTML = items.map(m => {
          const isMine = m.token === myToken && !m.isAdmin;
          const canDel = window.__ddIsAdmin || isMine;
          return `
            <div style="background: ${m.isAdmin?'rgba(14,165,233,0.1)':'var(--sky-pale)'}; padding: 8px 10px; border-radius: 10px; font-size: .7rem; border: 1px solid rgba(186,230,253,.4); margin-bottom: 6px;">
                <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
                    <strong style="color:var(--sky-dark)">${m.isAdmin?'🐋 ':''}${esc(m.name||'Khách')}</strong>
                    <span style="color:var(--text-dim); font-size:.6rem">${timeAgo(m.ts)}</span>
                </div>
                <div style="color:var(--text-main); word-break:break-word; line-height:1.4">${esc(m.text)}</div>
                ${canDel ? `<button class="chat-del-btn" style="margin-top:4px" data-id="${m.id}" data-type="public">✕ Xóa</button>` : ''}
            </div>
          `;
        }).join('');
        el.scrollTop = el.scrollHeight;

        el.querySelectorAll('.chat-del-btn').forEach(b => b.addEventListener('click', () => {
          if(confirm('Xóa tin nhắn này?')) fb.remove(fb.ref(fb.db, 'public_messages/' + b.dataset.id));
        }));
      };
      renderPublic('msgPublicFeed'); 
    });

    // 2. PRIVATE MESSAGING LOGIC
    fb.onValue(fb.ref(fb.db, `private_messages/${myToken}`), snap => {
        if(window.__ddIsAdmin) return;
        const data = snap.val();
        const items = data ? Object.entries(data).map(([id,v])=>({id,...v, token: myToken})).sort((a,b)=>a.ts-b.ts) : [];
        const html = renderChatFeed(items, myToken, false);
        
        const el = document.getElementById('msgPrivateFeedSidebar');
        if(el) {
            el.innerHTML = html;
            el.scrollTop = el.scrollHeight; 
            el.querySelectorAll('.chat-del-btn').forEach(b => b.addEventListener('click', () => {
                if(confirm('Xóa tin nhắn này?')) fb.remove(fb.ref(fb.db, `private_messages/${myToken}/${b.dataset.id}`));
            }));
        }
    });

    // ADMIN LISTENER
    fb.onValue(fb.ref(fb.db, 'private_messages'), snap => {
        if(!window.__ddIsAdmin) return;
        const fullData = snap.val() || {};
        
        const userListItems = Object.keys(fullData).map(token => {
            const msgs = Object.values(fullData[token]);
            const lastMsg = msgs.sort((a,b)=>b.ts - a.ts)[0]; 
            return { token, lastMsg };
        }).sort((a,b) => b.lastMsg.ts - a.lastMsg.ts); 

        const listHtml = userListItems.map(u => `
            <div class="admin-user-card" data-token="${u.token}">
                <div>
                    <div class="auc-name">${esc(u.lastMsg.name) || 'Khách ẩn danh'}</div>
                    <div class="auc-meta" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 150px;">${esc(u.lastMsg.text)}</div>
                </div>
                <div class="auc-meta">${timeAgo(u.lastMsg.ts)}</div>
            </div>
        `).join('');

        const el = document.getElementById('msgAdminUserListSidebar');
        if(el) {
            el.innerHTML = listHtml;
            el.querySelectorAll('.admin-user-card').forEach(card => {
                card.addEventListener('click', () => {
                    activeAdminChatToken = card.dataset.token;
                    openAdminChatView();
                    renderActiveAdminChat();
                });
            });
        }

        if(activeAdminChatToken) renderActiveAdminChat();

        function renderActiveAdminChat() {
            if(!activeAdminChatToken) return;
            const msgsData = fullData[activeAdminChatToken] || {};
            const items = Object.entries(msgsData).map(([id,v])=>({id,...v, token: activeAdminChatToken})).sort((a,b)=>a.ts-b.ts);
            const chatHtml = renderChatFeed(items, activeAdminChatToken, true);

            const msgFeed = document.getElementById('msgAdminFeedSidebar');
            if(msgFeed) {
                msgFeed.innerHTML = chatHtml;
                msgFeed.scrollTop = msgFeed.scrollHeight;
                msgFeed.querySelectorAll('.chat-del-btn').forEach(b => b.addEventListener('click', () => {
                    if(confirm('Xóa tin nhắn này?')) fb.remove(fb.ref(fb.db, `private_messages/${b.dataset.token}/${b.dataset.id}`));
                }));
            }
        }
    });

    function openAdminChatView() {
        document.getElementById('msgAdminUserListSidebar').style.display = 'none';
        document.getElementById('msgAdminActiveChatSidebar').style.display = 'block';
    }
    
    function closeAdminChatView() {
        activeAdminChatToken = null;
        document.getElementById('msgAdminUserListSidebar').style.display = 'flex';
        document.getElementById('msgAdminActiveChatSidebar').style.display = 'none';
    }

    document.getElementById('msgAdminBackSidebar')?.addEventListener('click', closeAdminChatView);

    // ── SEND LOGIC TỐI ƯU ──
    const handleSend = async (btnId, nameId, textId, targetPathResolver, isAdminMode = false) => {
      const btn = document.getElementById(btnId);
      if(!btn) return;
      btn.addEventListener('click', async (e) => {
        const tgt = e.target.closest('button'); 
        const textInp = document.getElementById(textId);
        const text = textInp.value.trim();
        if(!text) return;
        
        tgt.disabled = true;
        const name = window.__ddIsAdmin ? ADMIN_NAME : (document.getElementById(nameId)?.value.trim() || 'Khách');
        const tokenToSave = isAdminMode ? activeAdminChatToken : myToken;
        const payload = { name, text, ts: Date.now(), token: tokenToSave, isAdmin: !!window.__ddIsAdmin };
        
        try {
          const path = typeof targetPathResolver === 'function' ? targetPathResolver() : targetPathResolver;
          if(!path) throw new Error('Không xác định được luồng tin nhắn');
          await fb.push(fb.ref(fb.db, path), payload);
          textInp.value = '';
        } catch(e) { alert("Lỗi: " + e.message); }
        finally { tgt.disabled = false; }
      });
    };

    handleSend('msgPublicSend', 'msgPublicName', 'msgPublicText', 'public_messages');
    handleSend('msgPrivSendSidebar', 'msgPrivNameSidebar', 'msgPrivTextSidebar', () => `private_messages/${myToken}`);
    handleSend('msgAdminReplySendSidebar', null, 'msgAdminReplyTextSidebar', () => activeAdminChatToken ? `private_messages/${activeAdminChatToken}` : null, true);

    window.addEventListener('dd-auth-change', syncAdminUI);
    syncAdminUI();
  }

  if(window.__ddFirebase?.db) initFirebaseLogic();
  else window.addEventListener('dd-firebase-ready', initFirebaseLogic);
})();
</script>
</Layout>