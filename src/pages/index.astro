    <script is:inline>
    /* ── FILTER ── */
    let active = new Set();
    function toggleChip(el) {
        const f = el.dataset.f;
        active.has(f) ? (active.delete(f), el.classList.remove('active'))
                      : (active.add(f), el.classList.add('active'));
        applyFilter();
    }
    function filterByTag(f) {
        document.getElementById('stGrid').scrollIntoView({behavior:'smooth', block:'start'});
        const chip = document.querySelector(`[data-f="${f}"]`);
        if (chip && !active.has(f)) toggleChip(chip);
    }
    function clearChips() {
        active.clear();
        document.querySelectorAll('.chip.active').forEach(c => c.classList.remove('active'));
        applyFilter();
    }
    function applyFilter() {
        const cards = document.querySelectorAll('.story-card');
        let vis = 0;
        cards.forEach(c => {
            if (!active.size) { c.classList.remove('hidden'); vis++; return; }
            const attrs = ['shelf','genre','setup','glass'].map(k => c.dataset[k] || '').join(' ');
            const match = [...active].every(f => attrs.includes(f));
            c.classList.toggle('hidden', !match);
            if (match) vis++;
        });
        document.getElementById('fCount').textContent = vis + ' truyện';
        document.getElementById('noRes').classList.toggle('show', vis === 0);
    }

    /* ── REVEAL ── */
    const obs = new IntersectionObserver(es => es.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); }
    }), {threshold:.1});
    document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

    /* ── CALENDAR ── */
    (function buildCal() {
        const now = new Date();
        const yr = now.getFullYear(), mo = now.getMonth();
        const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        // Thứ Hai là ngày đầu tuần
        const firstDay = new Date(yr, mo, 1).getDay();
        const offset = (firstDay === 0) ? 6 : firstDay - 1;
        const daysInMonth = new Date(yr, mo + 1, 0).getDate();
        const today = now.getDate();
        const postDays = new Set([2, 4, 17, 18]);
        const days = ['T2','T3','T4','T5','T6','T7','CN'];

        let html = `<div class="cal-header">${monthNames[mo]} ${yr}</div><div class="cal-grid">`;
        days.forEach(d => html += `<div class="cal-day-header">${d}</div>`);
        for (let i = 0; i < offset; i++) html += `<div class="cal-day empty"></div>`;
        for (let d = 1; d <= daysInMonth; d++) {
            let cls = 'cal-day';
            if (d === today) cls += ' today';
            else if (postDays.has(d)) cls += ' has-post';
            html += `<div class="${cls}">${d}</div>`;
        }
        html += '</div>';
        const calC = document.getElementById('calContent');
        if (calC) calC.innerHTML = html;
    })();
    </script>
