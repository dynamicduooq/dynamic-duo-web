    <div style="font-size: .8rem; color: var(--text-main); display: flex; flex-direction: column; gap: 10px;">
       <div style="display:flex; justify-content:space-between; border-bottom: 1px dashed rgba(186,230,253,.5); padding-bottom: 6px;"><span>👁 Lượt xem:</span> <strong id="statViews" style="color:var(--sky)">0</strong></div>
       <div style="display:flex; justify-content:space-between; border-bottom: 1px dashed rgba(186,230,253,.5); padding-bottom: 6px;"><span>💬 Bình luận:</span> <strong id="statCmts" style="color:var(--sky)">0</strong></div>
       <div style="display:flex; justify-content:space-between;"><span>❤️ Lượt thích:</span> <strong id="statLikes" style="color:var(--sky)">0</strong></div>
    </div>
    <p style="font-size:.6rem;color:var(--text-dim);text-align:center;margin:12px 0 0;font-style:italic">Cập nhật theo thời gian thực</p>
  </div>
)}

{isNovelPage && (
  <div class="rv-modal" id="rvModal">
    <div class="rv-overlay" id="rvOverlay"></div>
    <div class="rv-content">
      <div class="rv-header">
        <h3 class="rv-title">⭐ Đánh giá tổng truyện</h3>
        <button class="rv-close" id="rvClose">✕</button>
      </div>
      <div class="rv-stats">
        <div class="rv-avg" id="rvAvg">0.0</div>
        <div class="rv-stars-display" id="rvStarsDisplay">☆☆☆☆☆</div>
        <div style="font-size:.7rem; color:var(--text-dim)" id="rvCount">0 đánh giá</div>
      </div>
      <div class="rv-form">
        <div class="rv-star-select" id="rvStarSelect">
          <span data-val="1">★</span><span data-val="2">★</span><span data-val="3">★</span><span data-val="4">★</span><span data-val="5" class="active">★</span>
        </div>
        <input class="comment-inp" id="rvName" placeholder="Tên của bạn (Tùy chọn)" style="width:100%; margin-bottom:8px;" autocomplete="off" />
        <textarea class="comment-textarea" id="rvText" placeholder="Nêu cảm nhận của bạn về bộ truyện này nhé..." rows="3" style="margin-bottom:8px;"></textarea>
        <div style="text-align:right">
          <button class="comment-submit-btn" id="rvSubmit" style="padding: 6px 16px; font-size: .8rem; background: #f59e0b;">Gửi đánh giá</button>
        </div>
      </div>
      <div class="rv-list" id="rvList">
        <div class="ic-loading">Đang tải đánh giá...</div>
      </div>
    </div>
  </div>
)}

<script is:inline>
/* ══ HELPERS ══ */
function esc(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function timeAgo(ts){
  if(!ts) return ''; const d=Date.now()-ts;
  if(d<60000) return 'vừa xong'; if(d<3600000) return Math.floor(d/60000)+' phút trước';
  if(d<86400000) return Math.floor(d/3600000)+' giờ trước'; return Math.floor(d/86400000)+' ngày trước';
}
function pageKey(){ return location.pathname.replace(/[^a-zA-Z0-9]/g,'_').replace(/^_+|_+$/g,'').substring(0,120); }
function avatarLetter(name){ return (name||'K').trim().charAt(0).toUpperCase(); }
function getMyToken(){ let t = localStorage.getItem('dd_token'); if(!t){ t = Math.random().toString(36).slice(2)+Date.now().toString(36); localStorage.setItem('dd_token',t); } return t; }
function getLiked(id){ try{ return JSON.parse(localStorage.getItem('dd_liked')||'{}')[id]||false; }catch(e){ return false; } }
function setLiked(id,v){ try{ const o=JSON.parse(localStorage.getItem('dd_liked')||'{}'); o[id]=v; localStorage.setItem('dd_liked',JSON.stringify(o)); }catch(e){} }
function getSavedName(){ return localStorage.getItem('dd_commenter_name') || ''; }
function saveName(name){ if(name && name.trim()) localStorage.setItem('dd_commenter_name', name.trim()); }

const ADMIN_DISPLAY_NAME = 'dynamic duo 𓆝';

function waitFirebase(cb){
  if(window.__ddFirebase?.db){ cb(window.__ddFirebase); return; }
  window.addEventListener('dd-firebase-ready',()=>{ if(window.__ddFirebase?.db) cb(window.__ddFirebase); },{once:true});
  let n=0; const t=setInterval(()=>{ if(window.__ddFirebase?.db){clearInterval(t);cb(window.__ddFirebase);} if(++n>60) clearInterval(t); },200);
}

/* ══ SETUP FAB & SCROLL ══ */
document.addEventListener('DOMContentLoaded', () => {
  const _rp = document.getElementById('read-progress');
  const fabWrap = document.getElementById('toolFabWrap');
  const fabToggle = document.getElementById('toolFabToggle');
  
  if(fabToggle && fabWrap) {
    fabToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      fabWrap.classList.toggle('open');
    });
    document.addEventListener('click', (e) => {
      if(!fabWrap.contains(e.target)) fabWrap.classList.remove('open');
    });
  }

  document.getElementById('fabUp')?.addEventListener('click', () => { window.scrollTo({top:0, behavior:'smooth'}); fabWrap?.classList.remove('open'); });
  document.getElementById('fabDown')?.addEventListener('click', () => { window.scrollTo({top:document.body.scrollHeight, behavior:'smooth'}); fabWrap?.classList.remove('open'); });

  function updScroll(){
    const y = window.scrollY;
    const max = Math.max(1, document.body.scrollHeight - window.innerHeight);
    const p = y / max;
    if(_rp) _rp.style.width = (p*100)+'%';
  }
  window.addEventListener('scroll', updScroll, {passive:true});
  requestAnimationFrame(() => setTimeout(updScroll, 200));
});

/* ══ HAMBURGER ══ */
document.getElementById('hamburger')?.addEventListener('click',()=>document.getElementById('mobileMenu')?.classList.toggle('open'));
document.addEventListener('click',e=>{
  const mm=document.getElementById('mobileMenu'),hb=document.getElementById('hamburger');
  if(mm?.classList.contains('open')&&!mm.contains(e.target)&&!hb?.contains(e.target)) mm.classList.remove('open');
});

/* ══ CHAPTER DROPDOWNS ══ */
function setupDD(btnId,listId){
  const btn=document.getElementById(btnId),list=document.getElementById(listId);
  if(!btn||!list) return;
  btn.addEventListener('click',e=>{
    e.stopPropagation();
    const was=list.classList.contains('open');
    document.querySelectorAll('.chap-dd-list.open').forEach(el=>el.classList.remove('open'));
    if(!was){ list.classList.add('open'); const cur=list.querySelector('.cur-chap'); if(cur) setTimeout(()=>cur.scrollIntoView({block:'nearest'}),30); }
  });
}
setupDD('ddBtnTop','ddListTop'); setupDD('ddBtnBot','ddListBot');
document.addEventListener('click',()=>document.querySelectorAll('.chap-dd-list.open').forEach(el=>el.classList.remove('open')));

/* ══ THEME TOGGLE ══ */
function applyTheme(dark){
  document.documentElement.setAttribute('data-theme',dark?'dark':'');
  localStorage.setItem('dd-theme',dark?'dark':'light');
  syncThemeBtns();
}
function syncThemeBtns(){
  const isDark = document.documentElement.getAttribute('data-theme')==='dark';
  const icon = isDark ? '☀️' : '🌙';
  const label = isDark ? 'Chế độ sáng' : 'Chế độ tối';
  document.querySelectorAll('.nav-theme-btn, .mobile-theme-row').forEach(el=>{
    if(el.tagName === 'BUTTON') { el.title = label; if(el.classList.contains('nav-theme-btn')) el.textContent = icon; }
  });
  document.querySelectorAll('.mobile-theme-row').forEach(el=>{ el.innerHTML = icon + ' ' + label; });
}
window.__ddToggleTheme=()=>applyTheme(document.documentElement.getAttribute('data-theme')!=='dark');
document.getElementById('navThemeBtn')?.addEventListener('click', window.__ddToggleTheme);
document.getElementById('navThemeBtnMobile')?.addEventListener('click', window.__ddToggleTheme);
syncThemeBtns();

/* ══ ADMIN AUTH & STATS BUTTON ══ */
(function setupAdminBtn(){
  const btn = document.getElementById('fabAdmin');
  const statsBtn = document.getElementById('fabStats');
  let isAdmin = !!window.__ddIsAdmin;
  
  function syncBtn(){
    if(btn) {
       btn.style.display = 'flex';
       btn.textContent = isAdmin ? '🔓' : '🔑';
       btn.title = isAdmin ? 'Đăng xuất Admin' : 'Đăng nhập Admin';
    }
    if(statsBtn) {
       statsBtn.style.display = isAdmin ? 'flex' : 'none';
    }
  }
  syncBtn();
  window.addEventListener('dd-auth-change', e => { isAdmin = e.detail.isAdmin; syncBtn(); });
  
  btn?.addEventListener('click', () => {
    const fb = window.__ddFirebase; if(!fb) return;
    if(isAdmin){
      if(confirm('Đăng xuất tài khoản admin?')) fb.signOut(fb.auth);
    } else {
      const p = new fb.GoogleAuthProvider();
      fb.signInWithPopup(fb.auth, p).catch(e => alert('Lỗi đăng nhập: '+e.message));
    }
    document.getElementById('toolFabWrap')?.classList.remove('open');
  });
})();

/* ══════════════════════════════════════════
   A. CÀI ĐẶT ĐỌC TRUYỆN & CHỐNG COPY
══════════════════════════════════════════ */
document.addEventListener('DOMContentLoaded', () => {
  const root = document.documentElement;
  let fz = parseInt(localStorage.getItem('dd_fz') || '18');
  let ff = localStorage.getItem('dd_ff') || "'Newsreader', serif";
  
  const novelContent = document.querySelector('.novel-content');
  if(novelContent) {
     localStorage.setItem('dd_last_read_url', window.location.pathname);
     localStorage.setItem('dd_last_read_title', document.title.split('|')[0].trim());
  }
  
  const btn = document.getElementById('fabSettings');
  const pop = document.getElementById('rsPopup');
  const statsBtn = document.getElementById('fabStats');
  const statsPop = document.getElementById('statsPopup');
  const fabWrap = document.getElementById('toolFabWrap');
  
  if(btn && pop) {
    btn.addEventListener('click', e => { 
        e.stopPropagation(); 
        pop.classList.toggle('open'); 
        if(statsPop) statsPop.classList.remove('open'); 
        if(fabWrap) fabWrap.classList.remove('open');
    });
    document.addEventListener('click', e => { 
        if(!pop.contains(e.target) && e.target !== btn) pop.classList.remove('open'); 
    });

    document.getElementById('rsDec').addEventListener('click', () => { if(fz > 12) { fz-=1; root.style.setProperty('--read-fz', fz + 'px'); localStorage.setItem('dd_fz', fz); } });
    document.getElementById('rsInc').addEventListener('click', () => { if(fz < 30) { fz+=1; root.style.setProperty('--read-fz', fz + 'px'); localStorage.setItem('dd_fz', fz); } });

    const fontBtns = pop.querySelectorAll('[data-font]');
    fontBtns.forEach(fb => {
      if(fb.dataset.font === ff) { fontBtns.forEach(b=>b.classList.remove('active')); fb.classList.add('active'); }
      fb.addEventListener('click', () => {
        ff = fb.dataset.font;
        root.style.setProperty('--read-ff', ff);
        localStorage.setItem('dd_ff', ff);
        fontBtns.forEach(b=>b.classList.remove('active'));
        fb.classList.add('active');
      });
    });
  }

  if(statsBtn && statsPop) {
      statsBtn.addEventListener('click', e => {
          e.stopPropagation();
          statsPop.classList.toggle('open');
          if(pop) pop.classList.remove('open');
          if(fabWrap) fabWrap.classList.remove('open');
      });
      document.addEventListener('click', e => { 
        if(!statsPop.contains(e.target) && e.target !== statsBtn) statsPop.classList.remove('open'); 
      });
  }

  if(novelContent) {
    document.addEventListener('contextmenu', e => e.preventDefault());
    document.addEventListener('copy', e => e.preventDefault());
    document.addEventListener('keydown', e => {
      if(!document.activeElement || !['INPUT','TEXTAREA'].includes(document.activeElement.tagName)) {
        if(e.key === 'ArrowLeft') { 
          const p = document.querySelector('.chap-nav-row a.chap-pn:first-child'); 
          if(p && !p.classList.contains('disabled')) window.location.href = p.href; 
        }
        if(e.key === 'ArrowRight') { 
          const n = document.querySelector('.chap-nav-row a.chap-pn:last-child'); 
          if(n && !n.classList.contains('disabled')) window.location.href = n.href; 
        }
      }
      if (e.ctrlKey && (e.key === 'p' || e.key === 's' || e.key === 'c' || e.key === 'u')) { e.preventDefault(); }
    });
  }
});

/* ══════════════════════════════════════════
   B. INLINE COMMENT SIDEBAR
══════════════════════════════════════════ */
(function setupInlineSidebar(){
  const novelWrap  = document.getElementById('novelLayoutWrap');
  const content    = document.getElementById('novelContent');
  const sidebar    = document.getElementById('icSidebar');
  const sideList   = document.getElementById('icSidebarList');
  const closeBtn   = document.getElementById('icSidebarClose');
  const formName   = document.getElementById('icFormName');
  const formText   = document.getElementById('icFormText');
  const formSend   = document.getElementById('icFormSend');
  const overlay    = document.getElementById('icOverlay');
  const quotingBar = document.getElementById('icQuotingBar');
  const quotingLabel = document.getElementById('icQuotingLabel');
  if(!content || !sidebar || !novelWrap) return;

  if(formName && getSavedName()) formName.value = getSavedName();

  let currentIdx   = null;
  let currentUnsub = null;
  let isAdmin      = !!window.__ddIsAdmin;
  const myToken    = getMyToken();
  let quotingReplyId   = null;
  let quotingReplyName = null;

  document.getElementById('icQuotingCancel')?.addEventListener('click', clearQuoting);

  function setQuoting(rid, rname){
    quotingReplyId   = rid;
    quotingReplyName = rname;
    if(quotingBar)   quotingBar.classList.add('show');
    if(quotingLabel) quotingLabel.textContent = '↩ Reply cho ' + (rname || 'Khách vô danh');
    formText?.focus();
  }
  function clearQuoting(){
    quotingReplyId   = null;
    quotingReplyName = null;
    if(quotingBar) quotingBar.classList.remove('show');
  }

  window.addEventListener('dd-auth-change', e => {
    isAdmin = e.detail.isAdmin;
    if(isAdmin && formName) { formName.value = ADMIN_DISPLAY_NAME; formName.style.display = 'none'; } 
    else if(formName) { formName.style.display = ''; if(!formName.value) formName.value = getSavedName(); }
  });

  function adminBadgeHtml(){ return '<span class="ic-item-admin-badge">chủ nhà</span>'; }
  function replyAdminBadgeHtml(){ return '<span class="ic-reply-admin-badge">chủ nhà</span>'; }

  function openSidebar(idx){
    content.querySelectorAll('p.ic-active').forEach(p => p.classList.remove('ic-active'));
    currentIdx = idx;
    clearQuoting();
    const paras   = content.querySelectorAll('p');
    const preview = document.getElementById('icParaPreview');
    if(preview){
      const clone = paras[idx] ? paras[idx].cloneNode(true) : null;
      if(clone){ clone.querySelectorAll('.ic-trigger').forEach(b => b.remove()); preview.textContent = clone.textContent.trim().substring(0,120)+(clone.textContent.trim().length>120?'…':''); }
    }
    if(sideList) sideList.innerHTML = '<div class="ic-empty">Đang tải...</div>';
    if(paras[idx]) paras[idx].classList.add('ic-active');
    novelWrap.classList.add('sidebar-open');
    if(overlay) overlay.classList.add('show');
    loadInlineComments(idx);
    setTimeout(() => formText?.focus(), 200);
  }

  function closeSidebar(){
    novelWrap.classList.remove('sidebar-open');
    if(overlay) overlay.classList.remove('show');
    content.querySelectorAll('p.ic-active').forEach(p => p.classList.remove('ic-active'));
    if(currentUnsub){ try{currentUnsub();}catch(e){} currentUnsub = null; }
    currentIdx = null;
    clearQuoting();
  }

  closeBtn?.addEventListener('click', closeSidebar);
  overlay?.addEventListener('click', closeSidebar);

  function loadInlineComments(idx){
    if(currentUnsub){ try{currentUnsub();}catch(e){} currentUnsub = null; }
    waitFirebase(({db, ref, onValue}) => {
      const key = 'inline_' + pageKey() + '_p' + idx;
      currentUnsub = onValue(ref(db, 'comments/' + key), snap => {
        if(currentIdx !== idx) return;
        renderInlineComments(snap.val(), key, idx);
      });
    });
  }

  function renderInlineComments(data, key, idx){
    if(!sideList) return;
    if(!data){ sideList.innerHTML = '<div class="ic-empty">Chưa có bình luận cho đoạn này 🌊<br><small>Hãy là người đầu tiên!</small></div>'; return; }
    const items = Object.entries(data).map(([id,v]) => ({id,...v})).sort((a,b) => (a.ts||0) - (b.ts||0));

    sideList.innerHTML = items.map(c => {
      const isMine = c.token === myToken; const canDel = isAdmin || isMine; const cIsAdmin = c.isAdmin === true;
      const replies = c.replies ? Object.entries(c.replies).map(([rid,rv]) => ({id:rid,...rv})).sort((a,b) => (a.ts||0)-(b.ts||0)) : [];
      const repliesHtml = replies.map(r => {
        const rMine  = r.token === myToken; const rCanDel= isAdmin || rMine; const rIsAdmin = r.isAdmin === true;
        const atTag  = r.replyTo ? `<span class="ic-reply-at">@${esc(r.replyTo.name)}</span>` : '';
        return `<div class="ic-reply-item" id="icri-${esc(r.id)}">
          <div class="ic-reply-avatar">${esc(avatarLetter(r.name))}</div>
          <div class="ic-reply-body">
            <span class="ic-reply-name">${esc(r.name)||'Khách vô danh'}${rIsAdmin ? replyAdminBadgeHtml() : ''}</span>
            <div class="ic-reply-text">${atTag}${esc(r.text)}</div>
            <button class="ic-rr-btn" data-action="rr-reply" data-cid="${esc(c.id)}" data-rid="${esc(r.id)}" data-rname="${esc(r.name||'Khách vô danh')}">↩ Reply</button>
          </div>
          ${rCanDel ? `<button class="ic-reply-del show" data-action="del-reply" data-key="${esc(key)}" data-cid="${esc(c.id)}" data-rid="${esc(r.id)}">✕</button>` : ''}
        </div>`;
      }).join('');

      return `<div class="ic-item" id="icitem-${esc(c.id)}">
        <div class="ic-item-header">
          <span class="ic-item-name">${esc(c.name)||'Khách vô danh'}${cIsAdmin ? adminBadgeHtml() : ''}</span>
          <span class="ic-item-time">${timeAgo(c.ts)}</span>
        </div>
        <div class="ic-item-text">${esc(c.text)}</div>
        <div class="ic-item-actions">
          <button class="ic-reply-toggle" data-action="toggle-reply" data-cid="${esc(c.id)}">
            ↩ Reply ${replies.length > 0 ? '('+replies.length+')' : ''}
          </button>
          ${canDel ? `<button class="ic-del-btn show" data-action="del-comment" data-key="${esc(key)}" data-id="${esc(c.id)}">✕ Xóa</button>` : ''}
        </div>
        <div class="ic-replies ${replies.length > 0 ? 'open' : ''}" id="icreplies-${esc(c.id)}">
          ${repliesHtml}
          <div class="ic-reply-form" id="icrf-${esc(c.id)}">
            <input placeholder="Tên (tùy chọn)" data-role="rname" value="${isAdmin ? esc(ADMIN_DISPLAY_NAME) : esc(getSavedName())}" ${isAdmin ? 'readonly style="display:none"' : ''} />
            <textarea placeholder="Viết reply..." rows="2" data-role="rtext"></textarea>
            <div class="ic-reply-form-row">
              <button class="ic-rf-cancel" data-action="cancel-reply" data-cid="${esc(c.id)}">Hủy</button>
              <button class="ic-rf-send"   data-action="send-reply"   data-cid="${esc(c.id)}" data-key="${esc(key)}">Gửi ✦</button>
            </div>
          </div>
        </div>
      </div>`;
    }).join('');
    sideList.scrollTop = sideList.scrollHeight;
  }

  sideList?.addEventListener('click', async e => {
    const btn = e.target.closest('[data-action]');
    if(!btn) return;
    const action = btn.dataset.action;

    if(action === 'del-comment'){
      if(!confirm('Xóa bình luận này?')) return;
      waitFirebase(({db, ref, remove}) => remove(ref(db, 'comments/' + btn.dataset.key + '/' + btn.dataset.id)));
      return;
    }
    if(action === 'del-reply'){
      if(!confirm('Xóa reply này?')) return;
      waitFirebase(({db, ref, remove}) => remove(ref(db, 'comments/' + btn.dataset.key + '/' + btn.dataset.cid + '/replies/' + btn.dataset.rid)));
      return;
    }
    if(action === 'toggle-reply'){
      const cid     = btn.dataset.cid;
      const replies = document.getElementById('icreplies-' + cid);
      const form    = document.getElementById('icrf-' + cid);
      if(replies) replies.classList.add('open');
      if(form){ form.classList.toggle('open'); if(form.classList.contains('open')) form.querySelector('[data-role="rtext"]')?.focus(); }
      clearQuoting();
      return;
    }
    if(action === 'rr-reply'){
      const cid   = btn.dataset.cid; const rid   = btn.dataset.rid; const rname = btn.dataset.rname;
      const form  = document.getElementById('icrf-' + cid); const replies = document.getElementById('icreplies-' + cid);
      if(replies) replies.classList.add('open');
      if(form){ form.classList.add('open'); form.querySelector('[data-role="rtext"]')?.focus(); }
      setQuoting(rid, rname); setTimeout(() => sideList?.scrollTo({top: sideList.scrollHeight, behavior:'smooth'}), 50);
      return;
    }
    if(action === 'cancel-reply'){ document.getElementById('icrf-' + btn.dataset.cid)?.classList.remove('open'); clearQuoting(); return; }
    if(action === 'send-reply'){
      const form = document.getElementById('icrf-' + btn.dataset.cid);
      const text = (form?.querySelector('[data-role="rtext"]')?.value || '').trim();
      if(!text) return; btn.disabled = true;
      const nameVal = isAdmin ? ADMIN_DISPLAY_NAME : (form?.querySelector('[data-role="rname"]')?.value || '').trim() || 'Khách vô danh';
      if(!isAdmin) saveName(nameVal);
      const payload = { name: nameVal, text, ts: Date.now(), token: myToken, isAdmin: isAdmin ? true : false };
      if(quotingReplyId){ payload.replyTo = { id: quotingReplyId, name: quotingReplyName || '' }; }
      waitFirebase(async ({db, ref, push}) => {
        try{
          await push(ref(db, 'comments/' + btn.dataset.key + '/' + btn.dataset.cid + '/replies'), payload);
          form.querySelector('[data-role="rtext"]').value = ''; form.classList.remove('open'); clearQuoting();
        } catch(e){ alert('Lỗi: ' + e.message); }
        btn.disabled = false;
      });
      return;
    }
  });

  formSend?.addEventListener('click', async () => {
    const text = (formText?.value || '').trim();
    if(!text || currentIdx === null) return;
    formSend.disabled = true;
    const nameVal = isAdmin ? ADMIN_DISPLAY_NAME : (formName?.value || '').trim() || 'Khách vô danh';
    if(!isAdmin) saveName(nameVal);
    waitFirebase(async ({db, ref, push}) => {
      const key = 'inline_' + pageKey() + '_p' + currentIdx;
      try{
        await push(ref(db, 'comments/' + key), { name : nameVal, text, ts: Date.now(), token: myToken, isAdmin: isAdmin ? true : false });
        if(formText) formText.value = '';
      } catch(e){ alert('Lỗi: ' + e.message); }
      formSend.disabled = false;
    });
  });
  formText?.addEventListener('keydown', e => { if(e.key === 'Enter' && (e.ctrlKey || e.metaKey)) formSend?.click(); });

  const paragraphs = content.querySelectorAll('p');
  paragraphs.forEach((p, idx) => {
    const btn = document.createElement('button');
    btn.className = 'ic-trigger'; btn.title = 'Bình luận đoạn ' + (idx + 1);
    btn.setAttribute('aria-label', 'Bình luận đoạn ' + (idx + 1));
    btn.innerHTML = '💬'; 
    p.appendChild(btn);

    waitFirebase(({db, ref, onValue}) => {
      const key = 'inline_' + pageKey() + '_p' + idx;
      onValue(ref(db, 'comments/' + key), snap => {
        const cnt = snap.val() ? Object.keys(snap.val()).length : 0;
        btn.innerHTML = cnt > 0 ? `💬<span>${cnt}</span>` : '💬';
        btn.classList.toggle('has-comments', cnt > 0);
      });
    });

    btn.addEventListener('click', e => {
      e.stopPropagation();
      if(currentIdx === idx && novelWrap.classList.contains('sidebar-open')){ closeSidebar(); } else { openSidebar(idx); }
    });
  });
})();

/* ══════════════════════════════════════════
   C. CHAPTER LIKE SYSTEM
══════════════════════════════════════════ */
(function setupChapterLike(){
  const btn = document.getElementById('btnLikeChapter');
  const countEl = document.getElementById('chapLikeCount');
  if(!btn || !countEl) return;

  const key = 'chap_' + pageKey();
  const myToken = getMyToken();
  const storageKey = 'dd_liked_' + key;

  if(localStorage.getItem(storageKey) === 'true') {
    btn.classList.add('liked'); btn.querySelector('.heart').textContent = '❤️';
  }

  waitFirebase(({db, ref, onValue, update, remove}) => {
    const likeRef = ref(db, 'chapter_likes/' + key);
    
    onValue(likeRef, snap => {
      const data = snap.val() || {};
      countEl.textContent = Object.keys(data).length;
      if(data[myToken]) { btn.classList.add('liked'); btn.querySelector('.heart').textContent = '❤️'; localStorage.setItem(storageKey, 'true'); }
    });

    btn.addEventListener('click', async () => {
      const isLiked = btn.classList.contains('liked');
      btn.disabled = true;
      try {
        if(isLiked) {
          await remove(ref(db, `chapter_likes/${key}/${myToken}`));
          btn.classList.remove('liked'); btn.querySelector('.heart').textContent = '🤍'; localStorage.removeItem(storageKey);
        } else {
          await update(ref(db, `chapter_likes/${key}`), { [myToken]: Date.now() });
          btn.classList.add('liked'); btn.querySelector('.heart').textContent = '❤️'; localStorage.setItem(storageKey, 'true');
        }
      } catch(e) { console.error('Lỗi like:', e); }
      btn.disabled = false;
    });
  });
})();

/* ══════════════════════════════════════════
   D. NOVEL REVIEW SYSTEM
══════════════════════════════════════════ */
(function setupNovelReview(){
  const truyenId = document.querySelector('.page-wrapper')?.dataset.truyenId;
  const btnOpen = document.getElementById('btnOpenReview');
  const modal = document.getElementById('rvModal');
  const overlay = document.getElementById('rvOverlay');
  if(!truyenId || !btnOpen || !modal) return;

  const closeBtn = document.getElementById('rvClose');
  const submitBtn = document.getElementById('rvSubmit');
  const starSelect = document.getElementById('rvStarSelect');
  const listEl = document.getElementById('rvList');
  const myToken = getMyToken();
  let selectedStars = 5;

  const openModal = () => { overlay.classList.add('show'); modal.classList.add('show'); document.getElementById('toolFabWrap')?.classList.remove('open'); };
  const closeModal = () => { overlay.classList.remove('show'); modal.classList.remove('show'); };
  btnOpen.addEventListener('click', openModal);
  closeBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', closeModal);

  if(starSelect) {
    const stars = starSelect.querySelectorAll('span');
    stars.forEach(s => {
      s.addEventListener('click', () => {
        selectedStars = parseInt(s.dataset.val);
        stars.forEach(st => { st.classList.toggle('active', parseInt(st.dataset.val) <= selectedStars); });
      });
    });
  }

  waitFirebase(({db, ref, onValue, push, remove}) => {
    const reviewRef = ref(db, 'novel_reviews/' + truyenId);
    
    onValue(reviewRef, snap => {
      const data = snap.val() || {};
      const items = Object.entries(data).map(([id,v]) => ({id, ...v})).sort((a,b) => b.ts - a.ts);
      
      document.getElementById('rvCount').textContent = `${items.length} đánh giá`;
      let avg = 0;
      if(items.length > 0) {
         const total = items.reduce((sum, item) => sum + (item.rating||5), 0);
         avg = (total / items.length).toFixed(1);
      }
      document.getElementById('rvAvg').textContent = avg > 0 ? avg : '0.0';
      
      const displayStars = document.getElementById('rvStarsDisplay');
      if(displayStars) {
         let starHtml = ''; const fullStars = Math.round(avg);
         for(let i=0; i<5; i++) starHtml += (i < fullStars ? '★' : '☆');
         displayStars.textContent = starHtml;
      }

      if(items.length === 0) {
         listEl.innerHTML = '<div class="ic-empty">Chưa có đánh giá nào. Hãy là người đầu tiên!</div>';
      } else {
         listEl.innerHTML = items.map(rv => {
            const isMine = rv.token === myToken; const canDel = window.__ddIsAdmin || isMine;
            const stars = '★'.repeat(rv.rating) + '☆'.repeat(5 - rv.rating);
            const badge = rv.isAdmin ? '<span class="ic-item-admin-badge" style="margin-left:5px">chủ nhà</span>' : '';
            return `
              <div class="rv-item">
                 <div class="rv-item-hd">
                    <div>
                      <span class="rv-item-name">${esc(rv.name)||'Khách vô danh'}</span>${badge}
                      <div class="rv-item-stars">${stars}</div>
                    </div>
                    ${canDel ? `<button class="rv-del-btn show" data-id="${esc(rv.id)}">Xóa</button>` : ''}
                 </div>
                 <p class="rv-item-text">${esc(rv.text).replace(/\n/g, '<br>')}</p>
                 <div class="rv-item-time">${timeAgo(rv.ts)}</div>
              </div>
            `;
         }).join('');

         listEl.querySelectorAll('.rv-del-btn').forEach(b => {
            b.addEventListener('click', async () => {
               if(!confirm('Xóa đánh giá này?')) return;
               await remove(ref(db, `novel_reviews/${truyenId}/${b.dataset.id}`));
            });
         });
      }
    });

    submitBtn?.addEventListener('click', async () => {
      const text = document.getElementById('rvText')?.value.trim();
      const name = document.getElementById('rvName')?.value.trim() || 'Khách';
      if(!text) { alert('Vui lòng viết vài lời nhận xét nhé!'); return; }
      
      submitBtn.disabled = true;
      try {
        await push(reviewRef, { name: window.__ddIsAdmin ? ADMIN_DISPLAY_NAME : name, text: text, rating: selectedStars, ts: Date.now(), token: myToken, isAdmin: !!window.__ddIsAdmin });
        document.getElementById('rvText').value = ''; saveName(name);
      } catch(e) { alert('Lỗi: ' + e.message); }
      submitBtn.disabled = false;
    });
  });
})();

/* ══════════════════════════════════════════
   E. THỐNG KÊ LƯỢT XEM VÀ BÌNH LUẬN DÀNH CHO ADMIN
══════════════════════════════════════════ */
waitFirebase(({db, ref, get, update, onValue}) => {
  const isNovel = document.querySelector('.novel-content') !== null;
  if(!isNovel) return;
  const key = pageKey();

  const viewRef = ref(db, 'page_views/' + key);
  get(viewRef).then(snap => {
     let views = (snap.val() && snap.val().views) || 0;
     if(!window.__ddIsAdmin) { update(ref(db, 'page_views'), { [key + '/views']: views + 1 }).catch(()=>{}); }
  });

  onValue(viewRef, snap => {
      const vEl = document.getElementById('statViews');
      if(vEl) vEl.textContent = (snap.val() && snap.val().views) || 0;
  });

  onValue(ref(db, 'comments/chap_' + key), snap => {
      const data = snap.val() || {};
      let cmtCount = Object.keys(data).length; let likeCount = 0;
      Object.values(data).forEach(c => {
        if(c.likes) likeCount += Object.keys(c.likes).length;
        if(c.replies) cmtCount += Object.keys(c.replies).length;
      });
      const cEl = document.getElementById('statCmts'); const lEl = document.getElementById('statLikes');
      if(cEl) cEl.textContent = cmtCount; if(lEl) lEl.textContent = likeCount;
  });
});

/* ══════════════════════════════════════════
   F. CHAPTER-END COMMENT
══════════════════════════════════════════ */
(function setupChapComments(){
  const section   = document.getElementById('chapCommentSection');
  if(!section) return;

  const cmtList   = document.getElementById('cmtList');
  const cmtName   = document.getElementById('cmtName');
  const cmtText   = document.getElementById('cmtText');
  const cmtSubmit = document.getElementById('cmtSubmit');
  if(!cmtList) return;

  if(cmtName && getSavedName()) cmtName.value = getSavedName();

  const myToken     = getMyToken();
  const key         = 'chap_' + pageKey();
  let isAdmin       = false;
  let lastData      = null;
  let listenerBound = false;
  let rebuildTimer  = null;

  function scheduleRebuild(data){
    lastData = data;
    clearTimeout(rebuildTimer);
    rebuildTimer = setTimeout(() => rebuildComments(lastData), 60);
  }

  window.addEventListener('dd-auth-change', e => {
    isAdmin = e.detail.isAdmin;
    if(isAdmin){ if(cmtName){ cmtName.value = ADMIN_DISPLAY_NAME; cmtName.style.display = 'none'; } } 
    else { if(cmtName){ cmtName.style.display = ''; if(!cmtName.value || cmtName.value === ADMIN_DISPLAY_NAME) cmtName.value = getSavedName(); } }
    if(lastData !== null) rebuildComments(lastData);
  });

  function adminBadgeHtml(){ return '<span class="comment-admin-badge">chủ nhà</span>'; }
  function replyAdminBadgeHtml(){ return '<span class="reply-admin-badge">chủ nhà</span>'; }

  function rebuildComments(data){
    if(!cmtList) return;
    if(!data){ cmtList.innerHTML = '<div class="comment-empty">𓆝 Chưa có bình luận. Hãy là người đầu tiên!</div>'; return; }
    const items = Object.entries(data).map(([id,v]) => ({id,...v})).sort((a,b) => (a.ts||0) - (b.ts||0));

    cmtList.innerHTML = items.map(c => {
      const isMine = c.token === myToken; const canDel = isAdmin || isMine; const cIsAdmin = c.isAdmin === true;
      const likeCount = c.likes ? Object.keys(c.likes).length : 0; const liked = getLiked(c.id);
      const replies = c.replies ? Object.entries(c.replies).map(([rid,rv]) => ({id:rid,...rv})).sort((a,b) => (a.ts||0)-(b.ts||0)) : [];

      const repliesHtml = replies.map(r => {
        const rMine = r.token === myToken; const rCanDel = isAdmin || rMine; const rIsAdmin = r.isAdmin === true;
        const atTag = r.replyTo ? `<span class="reply-at">@${esc(r.replyTo.name)}</span> ` : '';
        return `<div class="reply-item" id="ri-${esc(r.id)}">
          <div class="reply-avatar">${esc(avatarLetter(r.name))}</div>
          <div class="reply-body">
            <span class="reply-name">${esc(r.name)||'Khách vô danh'}${rIsAdmin ? replyAdminBadgeHtml() : ''}</span>
            <span class="reply-time">${timeAgo(r.ts)}</span>
            <div class="reply-text">${atTag}${esc(r.text)}</div>
            <button class="reply-quote-btn" data-cid="${esc(c.id)}" data-rid="${esc(r.id)}" data-rname="${esc(r.name||'Khách vô danh')}">↩ Reply</button>
          </div>
          <button class="reply-del ${rCanDel?'show':''}" data-rid="${esc(r.id)}" data-cid="${esc(c.id)}">✕</button>
        </div>`;
      }).join('');

      return `<div class="comment-card" id="cmt-${esc(c.id)}">
        <div class="comment-card-header">
          <div class="comment-card-avatar">${esc(avatarLetter(c.name))}</div>
          <span class="comment-card-name">${esc(c.name)||'Khách vô danh'}${cIsAdmin ? adminBadgeHtml() : ''}</span>
          <span class="comment-card-time">${timeAgo(c.ts)}</span>
        </div>
        <p class="comment-card-text">${esc(c.text)}</p>
        <div class="comment-card-actions">
          <button class="cmt-like-btn ${liked?'liked':''}" data-id="${esc(c.id)}">
            ${liked?'❤️':'🤍'} <span>${likeCount}</span>
          </button>
          <button class="cmt-reply-btn" data-id="${esc(c.id)}">
            💬 ${replies.length > 0 ? replies.length+' reply' : 'Reply'}
          </button>
          <button class="cmt-del-btn ${canDel?'show':''}" data-id="${esc(c.id)}">🗑 Xóa</button>
        </div>
        <div class="reply-thread ${replies.length > 0 ? 'open' : ''}" id="thread-${esc(c.id)}">
          <div class="reply-items-wrap" id="riwrap-${esc(c.id)}">${repliesHtml}</div>
          <div class="reply-form" id="rf-${esc(c.id)}">
            <div class="reply-quoting" id="rq-${esc(c.id)}" style="display:none">
              <span class="reply-quoting-label"></span>
              <button class="reply-quoting-cancel" data-cid="${esc(c.id)}">✕</button>
            </div>
            <input class="reply-inp" placeholder="Tên (tùy chọn)" data-role="rname" value="${isAdmin ? esc(ADMIN_DISPLAY_NAME) : esc(getSavedName())}" ${isAdmin ? 'style="display:none"' : ''} />
            <textarea class="reply-inp-text" placeholder="Viết reply..." rows="2" data-role="rtext"></textarea>
            <div class="reply-form-btns">
              <button class="reply-cancel-btn" data-cid="${esc(c.id)}">Hủy</button>
              <button class="reply-send-btn"   data-cid="${esc(c.id)}">Gửi ✦</button>
            </div>
          </div>
        </div>
      </div>`;
    }).join('');

    bindEvents();
  }

  function bindEvents(){
    const fb = window.__ddFirebase; if(!fb) return;
    cmtList.querySelectorAll('.cmt-like-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id; if(getLiked(id)) return; setLiked(id, true);
        try { await fb.push(fb.ref(fb.db, `comments/${key}/${id}/likes`), {ts:Date.now()}); } catch(e){}
      });
    });
    cmtList.querySelectorAll('.cmt-reply-btn').forEach(btn => { btn.addEventListener('click', () => openReplyForm(btn.dataset.id, null, null)); });
    cmtList.querySelectorAll('.reply-quote-btn').forEach(btn => { btn.addEventListener('click', () => openReplyForm(btn.dataset.cid, btn.dataset.rid, btn.dataset.rname)); });
    cmtList.querySelectorAll('.reply-quoting-cancel').forEach(btn => { btn.addEventListener('click', () => clearQuoting(btn.dataset.cid)); });
    cmtList.querySelectorAll('.reply-cancel-btn').forEach(btn => { btn.addEventListener('click', () => { document.getElementById('rf-'+btn.dataset.cid)?.classList.remove('open'); clearQuoting(btn.dataset.cid); }); });
    
    cmtList.querySelectorAll('.reply-send-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const cid  = btn.dataset.cid; const form = document.getElementById('rf-'+cid); const text = (form?.querySelector('[data-role="rtext"]')?.value||'').trim();
        if(!text) return; btn.disabled = true;
        const nameInput = form?.querySelector('[data-role="rname"]'); const nameVal = isAdmin ? ADMIN_DISPLAY_NAME : (nameInput?.value||'').trim() || 'Khách vô danh';
        if(!isAdmin) saveName(nameVal);
        const quotBox = document.getElementById('rq-'+cid); const replyTo = quotBox?.dataset.replyToId ? { id: quotBox.dataset.replyToId, name: quotBox.dataset.replyToName || '' } : null;
        const payload = { name: nameVal, text, ts: Date.now(), token: myToken, isAdmin: isAdmin ? true : false }; if(replyTo) payload.replyTo = replyTo;
        try {
          await fb.push(fb.ref(fb.db, `comments/${key}/${cid}/replies`), payload);
          form.querySelector('[data-role="rtext"]').value = ''; form.classList.remove('open'); clearQuoting(cid);
          setTimeout(() => { const wrap = document.getElementById('riwrap-'+cid); if(wrap) wrap.lastElementChild?.scrollIntoView({behavior:'smooth', block:'nearest'}); }, 300);
        } catch(e){ alert('Lỗi: '+e.message); }
        btn.disabled = false;
      });
    });
    
    cmtList.querySelectorAll('.cmt-del-btn.show').forEach(btn => { btn.addEventListener('click', async () => { if(!confirm('Xóa bình luận này?')) return; await fb.remove(fb.ref(fb.db, `comments/${key}/${btn.dataset.id}`)); }); });
    cmtList.querySelectorAll('.reply-del.show').forEach(btn => { btn.addEventListener('click', async () => { if(!confirm('Xóa reply này?')) return; await fb.remove(fb.ref(fb.db, `comments/${key}/${btn.dataset.cid}/replies/${btn.dataset.rid}`)); }); });
  }

  function openReplyForm(cid, rid, rname){
    const thread = document.getElementById('thread-'+cid); const form = document.getElementById('rf-'+cid);
    if(thread) thread.classList.add('open');
    if(form){ form.classList.add('open'); if(rid){ setQuoting(cid, rid, rname); } else { clearQuoting(cid); } form.querySelector('[data-role="rtext"]')?.focus(); }
  }
  function setQuoting(cid, rid, rname){
    const box = document.getElementById('rq-'+cid); if(!box) return;
    box.style.display = 'flex'; box.dataset.replyToId = rid; box.dataset.replyToName = rname;
    const label = box.querySelector('.reply-quoting-label'); if(label) label.textContent = '↩ Reply cho ' + (rname||'Khách vô danh');
  }
  function clearQuoting(cid){
    const box = document.getElementById('rq-'+cid); if(!box) return; box.style.display = 'none'; box.dataset.replyToId = ''; box.dataset.replyToName = '';
  }

  waitFirebase(({db, ref, push, onValue}) => {
    onValue(ref(db, 'comments/'+key), snap => scheduleRebuild(snap.val()));
    if(listenerBound) return; listenerBound = true;
    cmtSubmit?.addEventListener('click', async () => {
      const text = (cmtText?.value||'').trim(); if(!text) return; cmtSubmit.disabled = true;
      const nameVal = isAdmin ? ADMIN_DISPLAY_NAME : (cmtName?.value||'').trim() || 'Khách vô danh'; if(!isAdmin) saveName(nameVal);
      try { await push(ref(db, 'comments/'+key), { name: nameVal, text, ts: Date.now(), token: myToken, isAdmin: isAdmin ? true : false }); if(cmtText) cmtText.value = ''; } catch(e){ alert('Lỗi: '+e.message); }
      cmtSubmit.disabled = false;
    });
    cmtText?.addEventListener('keydown', e => { if(e.key === 'Enter' && (e.ctrlKey || e.metaKey)) cmtSubmit?.click(); });
  });
})();
</script>
</body>
