---
import Layout from '../layouts/Layout.astro';
import settings from '../data/settings.json';

const ndntkmPosts  = Object.values(import.meta.glob('./ca-tren-ban/neu-dem-nay-troi-khong-mua/*.md',   { eager: true })) as any[];
const tnctcstPosts = Object.values(import.meta.glob('./ca-tren-ban/toi-nghi-chung-toi-sap-chia-tay/*.md', { eager: true })) as any[];
const qhbcpPosts   = Object.values(import.meta.glob('./ca-duoi-nuoc/quan-he-ban-cung-phong/*.md',   { eager: true })) as any[];
const hcdhPosts    = Object.values(import.meta.glob('./ca-duoi-nuoc/ha-chay-dong-hoang/*.md',      { eager: true })) as any[];
const countChaps   = (posts: any[]) => posts.filter((p: any) => p.frontmatter?.chuong && p.frontmatter.chuong !== 0).length;

const ndntkmCount  = countChaps(ndntkmPosts);
const tnctcstCount = countChaps(tnctcstPosts);
const qhbcpCount   = countChaps(qhbcpPosts);
const hcdhCount    = countChaps(hcdhPosts);
---

<Layout title="Trang chủ">
<style>
/* ─── TICKER ─── */
.ticker-wrap {
  overflow:hidden; padding:7px 0;
  background:linear-gradient(90deg,rgba(224,242,254,.5),rgba(240,249,255,.7),rgba(224,242,254,.5));
  border-top:1px solid var(--sky-light); border-bottom:1px solid var(--sky-light);
}
.ticker-track { display:flex; white-space:nowrap; animation:ticker 40s linear infinite; }
.ticker-track:hover { animation-play-state:paused; }
.ticker-item {
  display:inline-flex; align-items:center; padding:0 20px;
  font-size:.74rem; color:var(--sky2); letter-spacing:1.5px;
}
.ticker-item::after { content:'𓆝'; color:var(--sky-light); margin-left:20px; }
@keyframes ticker { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }

/* ─── PAGE SHELL: 2 CỘT ─── */
.home-shell {
  display:grid;
  grid-template-columns:1fr 260px;
  gap:24px;
  max-width:1160px;
  margin:0 auto;
  padding:28px 32px 80px;
}
@media(max-width:960px) { .home-shell{grid-template-columns:1fr; padding:20px 18px 60px;} .sidebar-col{display:none;} }

/* ─── HERO ─── */
.hero {
  text-align:center;
  padding:32px 0 28px;
}
.hero-name-img {
  max-width:420px; width:100%;
  margin:0 auto 18px; display:block;
  filter:drop-shadow(0 2px 8px rgba(2,132,199,.18));
}
.hero-banner-wrap {
  position:relative; border-radius:16px; overflow:hidden;
  max-height:200px; margin:0 auto;
}
.hero-banner-wrap img { width:100%; height:200px; object-fit:cover; display:block; }
.hero-banner-wrap::after {
  content:''; position:absolute; inset:0;
  background:linear-gradient(180deg, transparent 20%, rgba(2,70,130,.55) 100%);
  pointer-events:none;
}
.hero-banner-caption {
  position:absolute; bottom:14px; left:0; right:0;
  text-align:center; z-index:2;
  font-family:'Literata',serif; font-size:1.05rem; font-weight:600;
  color:#fff; letter-spacing:.5px; text-shadow:0 1px 4px rgba(0,0,0,.4);
}
.hero-tagline {
  font-size:.88rem; color:var(--text-dim); font-style:italic; margin:12px 0 0;
}

/* ─── SECTION HEADER ─── */
.sec-hd { display:flex; align-items:center; gap:10px; margin:32px 0 14px; }
.sec-hd h2 {
  font-family:'Merriweather',serif; font-size:.82rem; color:var(--sky-dark);
  letter-spacing:2px; text-transform:uppercase; margin:0; text-align:left; white-space:nowrap;
}
.sec-line { flex:1; height:1px; background:linear-gradient(to right,var(--sky-light),transparent); }
.sec-link { font-size:.72rem; color:var(--sky); white-space:nowrap; }
.sec-link:hover { text-decoration:underline; }

/* ─── FILTER BAR ─── */
.filter-bar {
  background:#fff; border:1px solid rgba(186,230,253,.5);
  border-radius:14px; padding:11px 14px;
  display:flex; flex-wrap:wrap; gap:6px; align-items:center;
  margin-bottom:16px;
}
[data-theme="dark"] .filter-bar { background:rgba(15,34,64,.85); }
.fl-label { font-size:.66rem; letter-spacing:2px; text-transform:uppercase; color:var(--text-dim); flex-shrink:0; }
.fl-chips { display:flex; flex-wrap:wrap; gap:4px; flex:1; }
.chip {
  display:inline-flex; align-items:center; gap:3px; padding:3px 11px;
  border-radius:var(--r-pill); font-size:.71rem; cursor:pointer;
  transition:var(--t); border:1.5px solid rgba(186,230,253,.5);
  background:var(--sky-pale); color:var(--text-mid); user-select:none;
  font-family:'Newsreader',serif; white-space:nowrap;
}
.chip:hover { background:var(--sky-light); color:var(--sky-dark); }
.chip.active { background:var(--sky); color:#fff; border-color:var(--sky); }
.fl-count { font-size:.68rem; background:var(--sky-pale); color:var(--sky); padding:2px 9px; border-radius:var(--r-pill); border:1px solid var(--sky-light); white-space:nowrap; margin-left:auto; }

/* ─── STORY GRID: HÀNG NGANG ─── */
.stories-grid {
  display:flex; flex-direction:column; gap:10px;
}
.sc {
  display:flex; gap:0;
  background:#fff; border:1px solid rgba(186,230,253,.45);
  border-radius:14px; overflow:hidden;
  transition:var(--t); box-shadow:0 2px 8px rgba(2,132,199,.05);
}
[data-theme="dark"] .sc { background:rgba(13,26,50,.9); }
.sc:hover { box-shadow:0 6px 24px rgba(2,132,199,.12); transform:translateY(-2px); }
.sc[data-hidden="true"] { display:none; }

.sc-cover-wrap {
  position:relative; flex-shrink:0; width:80px; overflow:hidden;
  background:linear-gradient(135deg,var(--sky-pale),rgba(186,230,253,.3));
}
.sc-cover-wrap img { width:80px; height:100%; object-fit:cover; display:block; min-height:100px; }
.sc-status {
  position:absolute; top:6px; left:0;
  font-size:.55rem; letter-spacing:1px; text-transform:uppercase;
  padding:2px 6px; border-radius:0 4px 4px 0;
  font-weight:700;
}
.status-ongoing { background:rgba(2,132,199,.85); color:#fff; }
.status-complete { background:rgba(5,150,105,.85); color:#fff; }
.status-upcoming { background:rgba(100,116,139,.75); color:#fff; }

.sc-body {
  padding:12px 14px 12px; flex:1; display:flex; flex-direction:column; gap:4px;
  min-width:0;
}
.sc-shelf { font-size:.64rem; letter-spacing:1.5px; text-transform:uppercase; color:var(--sky); }
.sc-title {
  font-family:'Merriweather',serif; font-size:.88rem; color:var(--sky-dark);
  margin:0; line-height:1.35;
  overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
}
.sc-meta { font-size:.68rem; color:var(--text-dim); font-style:italic; }
.sc-tags { display:flex; flex-wrap:wrap; gap:3px; }
.sc-tag { font-size:.6rem; padding:1px 6px; border:1px solid var(--sky-light); border-radius:var(--r-pill); color:var(--sky); background:var(--sky-pale); }
.sc-footer { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-top:auto; padding-top:4px; }
.sc-chapters { font-size:.68rem; color:var(--text-dim); }
.sc-link {
  font-size:.72rem; padding:4px 12px;
  background:var(--sky); color:#fff; border-radius:var(--r-pill);
  transition:var(--t); flex-shrink:0;
}
.sc-link:hover { background:var(--sky2); }
.sc-link.secondary { background:var(--sky-pale); color:var(--sky-dark); }
.sc-link.secondary:hover { background:var(--sky-light); }

/* ─── NOTICE / LƯU Ý ─── */
.notice-section { margin-top:36px; }
.notice-container {
  background:linear-gradient(135deg,rgba(240,249,255,.7),rgba(255,255,255,.9));
  border:1px solid rgba(186,230,253,.6); border-radius:18px; overflow:hidden;
}
[data-theme="dark"] .notice-container { background:rgba(12,26,50,.8); }
.notice-big-title {
  text-align:center; padding:24px 20px 16px;
  border-bottom:1px dashed rgba(186,230,253,.5);
}
.notice-big-title h2 { font-family:'Literata',serif; font-size:1.5rem; color:var(--sky-dark); margin:0 0 4px; }
.notice-big-title h2 em { font-style:italic; color:var(--sky); }
.notice-big-title p { font-size:.78rem; color:var(--text-dim); letter-spacing:2px; margin:0; }
.notice-block { padding:16px 22px; border-bottom:1px dashed rgba(186,230,253,.4); }
.notice-block:last-of-type { border-bottom:none; }
.notice-block-header { display:flex; align-items:center; gap:8px; margin-bottom:8px; }
.notice-icon { font-size:1.1rem; }
.notice-block-title { font-family:'Merriweather',serif; font-size:.85rem; color:var(--sky-dark); font-weight:600; }
.notice-body { font-size:.84rem; color:var(--text-mid); line-height:1.8; margin:0; }
.notice-body strong { color:var(--sky-dark); }
.notice-deco { text-align:center; font-size:1.1rem; margin-top:10px; letter-spacing:4px; color:var(--sky-light); }
.notice-wave {
  padding:18px 22px; text-align:center;
  background:linear-gradient(135deg,rgba(186,230,253,.15),rgba(240,249,255,.3));
  font-size:.84rem; color:var(--text-mid); font-style:italic; line-height:1.75;
}

/* ─── RECENT ─── */
.recent-list { display:flex; flex-direction:column; gap:6px; }
.recent-item {
  display:flex; align-items:center; gap:10px; padding:10px 14px;
  background:#fff; border:1px solid rgba(186,230,253,.4); border-radius:10px;
  transition:var(--t); color:var(--text-main);
}
[data-theme="dark"] .recent-item { background:rgba(13,26,50,.9); }
.recent-item:hover { background:var(--sky-pale); border-color:var(--sky-light); transform:translateX(3px); }
.recent-icon { font-size:1rem; flex-shrink:0; }
.ri-body { flex:1; min-width:0; }
.ri-story { font-size:.68rem; color:var(--text-dim); text-overflow:ellipsis; overflow:hidden; white-space:nowrap; }
.ri-title { font-size:.84rem; color:var(--sky-dark); font-weight:600; }
.recent-arrow { color:var(--sky); font-size:.9rem; }

/* ─── SIDEBAR ─── */
.sidebar-col { display:flex; flex-direction:column; gap:16px; }
.sidebar-col > .widget { position:sticky; top:72px; }
.sidebar-col > .widget + .widget { position:static; }
.widget {
  background:rgba(240,249,255,.65); border:1px solid rgba(186,230,253,.7);
  border-radius:18px; padding:16px 14px;
}
[data-theme="dark"] .widget { background:rgba(15,42,64,.8); border-color:rgba(30,74,110,.7); }
.widget-title {
  font-family:'Merriweather',serif; font-size:.72rem; letter-spacing:2.5px;
  text-transform:uppercase; color:var(--sky); text-align:center; margin-bottom:12px;
}
/* Profile */
.profile-avatar {
  width:76px; height:76px; border-radius:50%; overflow:hidden;
  margin:0 auto 10px; border:3px solid var(--sky-light);
  background:var(--sky-pale); display:flex; align-items:center; justify-content:center;
  font-size:2.2rem;
}
.profile-name { font-family:'Merriweather',serif; color:var(--sky-dark); font-size:.92rem; text-align:center; margin-bottom:3px; }
.profile-tagline { font-size:.78rem; color:var(--text-mid); font-style:italic; text-align:center; line-height:1.5; margin-bottom:6px; }
.profile-deco { text-align:center; font-size:.95rem; letter-spacing:3px; color:var(--sky-light); }
/* Tag cloud */
.tag-cloud { display:flex; flex-wrap:wrap; justify-content:center; gap:4px; }
.tc-btn {
  display:inline-block; padding:3px 9px;
  background:#fff; color:var(--sky); border-radius:var(--r-pill);
  font-size:.71rem; border:1px dashed var(--sky-light);
  transition:var(--t); cursor:pointer;
}
[data-theme="dark"] .tc-btn { background:rgba(15,30,50,.8); }
.tc-btn:hover, .tc-btn.active { background:var(--sky-pale); border-style:solid; }
/* Category tree */
.cat-tree { font-size:.78rem; color:var(--text-mid); }
.cat-tree ul { list-style:none; padding-left:12px; margin:3px 0; }
.cat-tree>ul { padding-left:0; }
.cat-tree a { color:var(--text-mid); transition:color .2s; display:block; padding:2px 0; }
.cat-tree a:hover { color:var(--sky); }
.cat-tree summary {
  cursor:pointer; font-size:.8rem; color:var(--sky-dark); font-weight:600;
  padding:3px 0; list-style:none; display:flex; align-items:center; gap:5px;
}
.cat-tree summary::-webkit-details-marker { display:none; }
.cat-tree summary::before { content:'▸'; font-size:.6rem; transition:transform .2s; color:var(--sky); }
.cat-tree details[open]>summary::before { transform:rotate(90deg); }
.cat-count { font-size:.65rem; color:var(--text-dim); margin-left:4px; }
/* Dark mode btn */
.dark-btn {
  width:100%; padding:7px; background:none;
  border:1.5px solid var(--sky-light); border-radius:var(--r-pill);
  color:var(--sky); font-size:.76rem; cursor:pointer; transition:var(--t);
  font-family:'Newsreader',serif; display:flex; align-items:center; justify-content:center; gap:6px;
}
.dark-btn:hover { background:var(--sky-pale); }
/* Quote */
.quote-body { font-style:italic; font-size:.8rem; color:var(--text-mid); line-height:1.75; border-left:3px solid var(--sky-light); padding-left:10px; margin:0; }
.quote-src { font-size:.66rem; color:var(--text-dim); margin-top:7px; text-align:right; }
/* no results */
.no-results { display:none; text-align:center; padding:28px; color:var(--text-dim); font-style:italic; }
.no-results.show { display:block; }
.hidden { display:none !important; }

/* ─── reveal ─── */
.reveal { opacity:0; transform:translateY(18px); transition:opacity .5s ease, transform .5s ease; }
.reveal.visible { opacity:1; transform:translateY(0); }
</style>

<!-- TICKER (chỉnh nội dung tại đây) -->
<div class="ticker-wrap">
  <div class="ticker-track" id="tickerTrack">
    <span class="ticker-item">Chào mừng đến với dynamic duo 𓆝.°•</span>
    <span class="ticker-item">Nếu đêm nay trời không mưa · Hoàn thành · {ndntkmCount} chương</span>
    <span class="ticker-item">Tôi nghĩ chúng tôi sắp chia tay · Hoàn thành · {tnctcstCount} chương</span>
    <span class="ticker-item">Quan hệ bạn cùng phòng · Đang tiến hành 🌊</span>
    <span class="ticker-item">Hạ cháy đồng hoang · Đang tiến hành 🌊</span>
    <span class="ticker-item">paired dreams, boundless gleam</span>
    <span class="ticker-item">Vật dễ vỡ · Thiếu đế xuân tâm · Sắp đào 🌤️</span>
    <!-- Lặp lại để không bị hở -->
    <span class="ticker-item">Chào mừng đến với dynamic duo 𓆝.°•</span>
    <span class="ticker-item">Nếu đêm nay trời không mưa · Hoàn thành · {ndntkmCount} chương</span>
    <span class="ticker-item">Tôi nghĩ chúng tôi sắp chia tay · Hoàn thành · {tnctcstCount} chương</span>
    <span class="ticker-item">Quan hệ bạn cùng phòng · Đang tiến hành 🌊</span>
    <span class="ticker-item">Hạ cháy đồng hoang · Đang tiến hành 🌊</span>
    <span class="ticker-item">paired dreams, boundless gleam</span>
    <span class="ticker-item">Vật dễ vỡ · Thiếu đế xuân tâm · Sắp đào 🌤️</span>
  </div>
</div>

<div class="home-shell">
  <!-- ── MAIN COLUMN ── -->
  <div class="main-col">

    <!-- HERO -->
    <div class="hero">
      <img
        src="/dynamic-duo-web/images/namexoanen.png"
        alt="dynamic duo"
        class="hero-name-img"
        onerror="this.style.display='none'"
      />
      <div class="hero-banner-wrap">
        <img
          src="/dynamic-duo-web/images/banner.png"
          alt="Dynamic Duo Banner"
          onerror="this.src='/dynamic-duo-web/images/frontpage.png'"
        />
        <div class="hero-banner-caption">paired dreams, boundless gleam.</div>
      </div>
      <p class="hero-tagline">𓆝 𓆟 𓆞 &nbsp;·&nbsp; dynamicduoo.q@gmail.com &nbsp;·&nbsp; 𓆝 𓆟 𓆞</p>
    </div>

    <!-- FILTER + STORIES -->
    <div class="sec-hd">
      <h2>📚 Tủ truyện</h2>
      <div class="sec-line"></div>
    </div>

    <div class="filter-bar">
      <span class="fl-label">Lọc</span>
      <div class="fl-chips" id="filterChips">
        <button class="chip active" data-tag="all">Tất cả</button>
        <button class="chip" data-cat="duoi-nuoc">🐠 Đang làm</button>
        <button class="chip" data-cat="tren-ban">🍽️ Xong</button>
        <button class="chip" data-cat="upcoming">🌤️ Sắp đào</button>
        <button class="chip" data-tag="đam mỹ"># đam mỹ</button>
        <button class="chip" data-tag="HE"># HE</button>
        <button class="chip" data-tag="chua xót"># chua xót</button>
        <button class="chip" data-tag="niên hạ"># niên hạ</button>
        <button class="chip" data-tag="mất trí nhớ"># mất trí nhớ</button>
        <button class="chip" data-tag="gương vỡ lại lành"># gương vỡ lại lành</button>
      </div>
      <span class="fl-count" id="flCount">6 truyện</span>
    </div>

    <div class="stories-grid" id="storiesGrid">

      <!-- QHBCP -->
      <div class="sc" data-cat="duoi-nuoc" data-tags="đam mỹ,hiện đại,niên hạ,trai thẳng,yêu thầm">
        <div class="sc-cover-wrap">
          <img src="/dynamic-duo-web/images/biaqhbcp.png" alt="Quan hệ bạn cùng phòng" loading="lazy" onerror="this.parentElement.style.background='var(--sky-pale)'" />
          <span class="sc-status status-ongoing">Đang đăng</span>
        </div>
        <div class="sc-body">
          <div class="sc-shelf">🐠 Cá dưới nước</div>
          <h3 class="sc-title">Quan hệ bạn cùng phòng</h3>
          <div class="sc-meta">Hạnh Lan · Edit: Dynamic Duo</div>
          <div class="sc-tags">
            <span class="sc-tag"># niên hạ</span>
            <span class="sc-tag"># đam mỹ</span>
            <span class="sc-tag"># trai thẳng</span>
          </div>
          <div class="sc-footer">
            <span class="sc-chapters">📖 {qhbcpCount}/72 chương</span>
            <div style="display:flex;gap:5px">
              <a href="/dynamic-duo-web/ca-duoi-nuoc/quan-he-ban-cung-phong/" class="sc-link secondary">Giới thiệu</a>
              <a href="/dynamic-duo-web/ca-duoi-nuoc/quan-he-ban-cung-phong/chuong-01/" class="sc-link">Đọc →</a>
            </div>
          </div>
        </div>
      </div>

      <!-- HCDH -->
      <div class="sc" data-cat="duoi-nuoc" data-tags="đam mỹ,hiện đại,chua xót,mất trí nhớ,đồng quê">
        <div class="sc-cover-wrap">
          <img src="/dynamic-duo-web/images/biatdxt.png" alt="Hạ cháy đồng hoang" loading="lazy" onerror="this.parentElement.style.background='var(--sky-pale)'" />
          <span class="sc-status status-ongoing">Đang đăng</span>
        </div>
        <div class="sc-body">
          <div class="sc-shelf">🐠 Cá dưới nước</div>
          <h3 class="sc-title">Hạ cháy đồng hoang</h3>
          <div class="sc-meta">Hỉ Thượng Mi Sao · Edit: Dynamic Duo</div>
          <div class="sc-tags">
            <span class="sc-tag"># mất trí nhớ</span>
            <span class="sc-tag"># chua xót</span>
            <span class="sc-tag"># đồng quê</span>
          </div>
          <div class="sc-footer">
            <span class="sc-chapters">📖 {hcdhCount}/109 chương</span>
            <div style="display:flex;gap:5px">
              <a href="/dynamic-duo-web/ca-duoi-nuoc/ha-chay-dong-hoang/" class="sc-link secondary">Giới thiệu</a>
              <a href="/dynamic-duo-web/ca-duoi-nuoc/ha-chay-dong-hoang/chuong-01/" class="sc-link">Đọc →</a>
            </div>
          </div>
        </div>
      </div>

      <!-- NDNTKM -->
      <div class="sc" data-cat="tren-ban" data-tags="đam mỹ,hiện đại,HE,gương vỡ lại lành,drama motip cũ">
        <div class="sc-cover-wrap">
          <img src="/dynamic-duo-web/images/biandntkm.png" alt="Nếu đêm nay trời không mưa" loading="lazy" onerror="this.parentElement.style.background='var(--sky-pale)'" />
          <span class="sc-status status-complete">Hoàn thành</span>
        </div>
        <div class="sc-body">
          <div class="sc-shelf">🍽️ Cá trên bàn</div>
          <h3 class="sc-title">Nếu đêm nay trời không mưa</h3>
          <div class="sc-meta">Tam Đạo · Edit: Dynamic Duo</div>
          <div class="sc-tags">
            <span class="sc-tag"># HE</span>
            <span class="sc-tag"># gương vỡ lại lành</span>
            <span class="sc-tag"># drama motip cũ</span>
          </div>
          <div class="sc-footer">
            <span class="sc-chapters">📖 {ndntkmCount} chương (full)</span>
            <div style="display:flex;gap:5px">
              <a href="/dynamic-duo-web/ca-tren-ban/neu-dem-nay-troi-khong-mua/" class="sc-link secondary">Giới thiệu</a>
              <a href="/dynamic-duo-web/ca-tren-ban/neu-dem-nay-troi-khong-mua/chuong-01/" class="sc-link">Đọc →</a>
            </div>
          </div>
