---
import Layout from '../layouts/Layout.astro';

const allChaps = Object.values(import.meta.glob('./truyen/**/*.md', { eager: true })) as any[];
const storyHomePages = Object.keys(import.meta.glob('./truyen/*/index.astro'));

const slugs = storyHomePages.map(path => {
  const parts = path.split('/');
  return parts[parts.length - 2];
});

const storiesData = slugs.map(slug => {
  const storyChaps = allChaps.filter(c => c.url.includes(`/truyen/${slug}/`));
  const infoFile = storyChaps.find(c => c.frontmatter?.truyen_name) || storyChaps[0];
  const fm = infoFile?.frontmatter || {};
  const fallbackTitle = slug.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');

  const chapCount = storyChaps.filter(c => c.frontmatter?.chuong !== undefined && c.frontmatter?.chuong !== 0).length;
  const tongSoChuong = fm.tong_so_chuong || 0;
  const isCompleted = tongSoChuong > 0 && chapCount >= tongSoChuong;

  return {
    id: slug,
    title: fm.truyen_name || fallbackTitle, 
    author: fm.author || 'Ẩn danh',
    cover: `/dynamic-duo-web/images/bia${slug.replace(/-/g, '')}.png`,
    tags: fm.tags || [],
    chapCount,
    tong_so_chuong: tongSoChuong,
    isCompleted,
    url: `/dynamic-duo-web/truyen/${slug}/`
  };
});

const caDuoiNuocList = storiesData.filter(s => !s.isCompleted && s.chapCount > 0);
const caTrenBanList = storiesData.filter(s => s.isCompleted);
const caTrenTroiList = storiesData.filter(s => s.chapCount === 0);

const recentChaps = allChaps
  .filter((c: any) => c.frontmatter?.date && c.frontmatter?.draft !== true)
  .sort((a: any, b: any) => {
      const dateDiff = new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf();
      if (dateDiff !== 0) return dateDiff;
      return (b.frontmatter.chuong || 0) - (a.frontmatter.chuong || 0);
  })
  .slice(0, 3);
---
<Layout title="Trang chủ" isHome={true}>
<style is:global>
.home-shell {
  display: grid; grid-template-columns: 1fr 300px; gap: 32px; max-width: 1150px;
  margin: 0 auto; padding: 20px 50px 80px; align-items: start; box-sizing: border-box; width: 100%;
}
@media(max-width:1100px){ .home-shell { grid-template-columns: 1fr 260px; padding: 18px 40px 80px; } }
@media(max-width:900px){  
  .home-shell { display: flex; flex-direction: column; align-items: center; padding: 14px 20px 80px; }
  .main-col, .sidebar-col, .hero, .notice-section, .filter-bar, .stories-grid, .recent-list, .sec-hd { width: 100%; max-width: 550px; }
  .main-col { display: flex; flex-direction: column; align-items: center; }
  .sidebar-col { position: static; max-height: none; }
}

.ticker-wrap { overflow: hidden; padding: 6px 0; background: linear-gradient(90deg,rgba(224,242,254,.5),rgba(240,249,255,.7),rgba(224,242,254,.5)); border-top: 1px solid var(--sky-light); border-bottom: 1px solid var(--sky-light); }
[data-theme="dark"] .ticker-wrap { background: linear-gradient(90deg,rgba(10,20,35,.9),rgba(12,24,40,.95),rgba(10,20,35,.9)); border-color: rgba(100,160,220,.25); }
.ticker-track { display:flex; white-space:nowrap; animation:ticker 25s linear infinite; }
.ticker-track:hover { animation-play-state:paused; }
.ticker-item { display:inline-flex; align-items:center; padding:0 20px; font-size:.7rem; color:var(--sky2); letter-spacing:1.5px; }
[data-theme="dark"] .ticker-item { color:#a8d4f0; }
.ticker-item::after { content:'𓆝'; color:var(--sky-light); margin-left:20px; }
[data-theme="dark"] .ticker-item::after { color:rgba(100,160,220,.4); }
@keyframes ticker { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }

.hero { text-align:center; padding:18px 0 14px; }
.hero-greeting { font-family: 'Merriweather', serif; font-size: 1.15rem; color: var(--sky-dark); margin-bottom: 6px; font-weight: 600; opacity: 0; transform: translateY(10px); animation: fadeUpAnim 0.8s ease forwards; }
[data-theme="dark"] .hero-greeting { color: #a8daf0; }
.hero-banner-wrap { position:relative; border-radius:18px; overflow:hidden; width: 100%; min-height: 260px; margin:0 auto; display:flex; align-items:center; justify-content:center; border: 6px solid #fff; box-shadow: 0 8px 25px rgba(2,132,199,.15); }
[data-theme="dark"] .hero-banner-wrap { border-color: rgba(30,74,106,.8); box-shadow: 0 8px 25px rgba(0,0,0,.4); }
.hero-banner-bg { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:0; }
.hero-banner-overlay { position:absolute; inset:0; background:linear-gradient(180deg,rgba(2,70,130,.35) 0%,rgba(2,50,100,.6) 100%); z-index:1; pointer-events:none; }
.hero-name-img { position:relative; z-index:2; max-width:360px; width:82%; display:block; margin:0 auto; padding:22px 0; filter:drop-shadow(0 2px 12px rgba(0,0,0,.35)); }
.hero-tagline { font-size:.78rem; color:var(--text-dim); font-style:italic; margin:12px 0 0; }
[data-theme="dark"] .hero-tagline { color:#8ab8d8; }

.sec-hd { display:flex; align-items:center; gap:10px; margin:22px 0 11px; }
.sec-hd h2 { font-family:'Merriweather',serif; font-size:.76rem; color:var(--sky-dark); letter-spacing:2px; text-transform:uppercase; margin:0; text-align:left; white-space:nowrap; }
[data-theme="dark"] .sec-hd h2 { color:#a8daf0; }
.sec-line { flex:1; height:1px; background:linear-gradient(to right,var(--sky-light),transparent); }
[data-theme="dark"] .sec-line { background:linear-gradient(to right,rgba(80,150,210,.4),transparent); }

.filter-bar { background: rgba(255, 255, 255, 0.85); border:1px solid rgba(186,230,253,.5); border-radius:12px; padding:9px 12px; display:flex; flex-wrap:wrap; gap:5px; align-items:center; margin-bottom:12px; position: sticky; top: 66px; z-index: 100; backdrop-filter: blur(12px); box-shadow: 0 4px 15px rgba(2,132,199,.05); transition: box-shadow 0.3s ease; }
[data-theme="dark"] .filter-bar { background: rgba(15, 35, 54, 0.85); border-color:rgba(80,150,210,.3); box-shadow: 0 4px 15px rgba(0,0,0,.2);}
.filter-bar.is-stuck { box-shadow: 0 8px 25px rgba(2,132,199,.15); }
.fl-label { font-size:.62rem; letter-spacing:2px; text-transform:uppercase; color:var(--text-dim); flex-shrink:0; }
.fl-chips { display:flex; flex-wrap:wrap; gap:4px; flex:1; }
.chip { display:inline-flex; align-items:center; gap:3px; padding:3px 10px; border-radius:var(--r-pill); font-size:.67rem; cursor:pointer; transition:var(--t); border:1.5px solid rgba(186,230,253,.6); background:var(--sky-pale); color:var(--sky-dark); user-select:none; font-family:'Newsreader',serif; white-space:nowrap; }
[data-theme="dark"] .chip { color:#d8eeff; border-color:rgba(126,200,227,.25); background:rgba(15,35,54,.8); }
.chip:hover { background:var(--sky-light); color:var(--sky-dark); transform: translateY(-1px); box-shadow: 0 2px 5px rgba(2,132,199,.1); }
[data-theme="dark"] .chip:hover { background:rgba(126,200,227,.15); color:#F3F9FF; box-shadow: 0 2px 5px rgba(0,0,0,.3); }
.chip.active { background:var(--sky); color:#fff; border-color:var(--sky); }
[data-theme="dark"] .chip.active { background:#1e4a6a; border-color:#7ec8e3; color:#F3F9FF; }
.chip-clear { background:none; border-color:rgba(186,230,253,.4); color:var(--text-dim); }
.chip-clear:hover { background:rgba(239,68,68,.08); color:#ef4444; border-color:#fca5a5; }
.fl-count { font-size:.7rem; background:var(--sky-pale); color:var(--sky-dark); padding:2px 8px; border-radius:var(--r-pill); border:1px solid var(--sky-light); white-space:nowrap; margin-left:auto; }
[data-theme="dark"] .fl-count { background:rgba(15,35,54,.6); border-color:rgba(126,200,227,.2); color:#a8daf0; }

.cr-banner { display: flex; align-items: center; gap: 12px; text-decoration: none; background: linear-gradient(135deg, var(--sky-light), var(--sky-pale));  border-radius: 12px; padding: 10px 16px; margin-bottom: 16px;  border: 1px solid rgba(186,230,253,.8); box-shadow: 0 4px 15px rgba(2,132,199,.1); transition: transform 0.3s, box-shadow 0.3s; }
[data-theme="dark"] .cr-banner { background: linear-gradient(135deg, rgba(30,74,106,.8), rgba(13,32,53,.8)); border-color: rgba(126,200,227,.3); }
.cr-banner:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(2,132,199,.15); }
.cr-icon { font-size: 1.6rem; animation: cr-float 3s ease-in-out infinite; }
.cr-label { font-size: .65rem; text-transform: uppercase; letter-spacing: 1px; color: var(--sky-dark); display: block; margin-bottom: 2px;}
[data-theme="dark"] .cr-label { color: #8ab8d8; }
.cr-title { font-size: .85rem; font-weight: 600; color: var(--text-main); font-family: 'Merriweather', serif;}
[data-theme="dark"] .cr-title { color: #F3F9FF; }
.cr-arrow { margin-left: auto; color: var(--sky); font-size: 1.2rem; }
[data-theme="dark"] .cr-arrow { color: #a8daf0; }
@keyframes cr-float { 0% { transform: translateY(0); } 50% { transform: translateY(-4px); } 100% { transform: translateY(0); } }

@keyframes fadeUpAnim { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
.stories-grid { display:flex; flex-direction:column; gap:10px; }
.sc { display:flex; background: var(--bg-card); border:1px solid rgba(186,230,253,.5); border-radius:12px; overflow:hidden; transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease; box-shadow:0 2px 8px rgba(2,132,199,.05); animation: fadeUpAnim 0.5s ease backwards; }
.sc:nth-child(1) { animation-delay: 0.05s; } .sc:nth-child(2) { animation-delay: 0.1s; }
.sc:nth-child(3) { animation-delay: 0.15s; } .sc:nth-child(4) { animation-delay: 0.2s; }
.sc:nth-child(5) { animation-delay: 0.25s; } .sc:nth-child(6) { animation-delay: 0.3s; }
[data-theme="dark"] .sc { border-color:rgba(80,150,210,.25); }
.sc:hover { box-shadow:0 12px 30px rgba(2,132,199,.12); transform:translateY(-4px) scale(1.01); z-index: 10; }
[data-theme="dark"] .sc:hover { box-shadow:0 12px 30px rgba(0,0,0,.6); }
.sc-cover-wrap { position:relative; flex-shrink:0; width:110px; min-height:140px; overflow:hidden; background: var(--sky-pale); display:flex; align-items:center; justify-content:center; }
.sc-cover-wrap img { width:100px; height:100%; object-fit:cover; display:block; padding:0; border-radius: 12px 0 0 12px; transition: transform 0.4s ease; }
.sc:hover .sc-cover-wrap img { transform: scale(1.05); }
.sc-status { position:absolute; top:6px; left:0; font-size:.5rem; letter-spacing:1px; text-transform:uppercase; padding:2px 6px; border-radius:0 4px 4px 0; font-weight:700; box-shadow: 2px 2px 8px rgba(0,0,0,0.15); }
.status-ongoing  { background:rgba(2,132,199,.9);  color:#fff; }
.status-complete { background:rgba(5,150,105,.9);  color:#fff; }
.status-upcoming { background:rgba(100,116,139,.8); color:#fff; }
.sc-body { padding:12px 14px; flex:1; display:flex; flex-direction:column; gap:4px; min-width:0; }
.sc-shelf { font-size:.6rem; letter-spacing:1.5px; text-transform:uppercase; color:var(--sky); }
[data-theme="dark"] .sc-shelf { color:#7ec8e3; }
.sc-title { font-family:'Merriweather',serif; font-size:.88rem; color:#0c4a6e; margin:0; line-height:1.35; text-align:left; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
[data-theme="dark"] .sc-title { color:#e8f4ff; }
.sc-meta { font-size:.65rem; color:#475569; font-style:italic; }
[data-theme="dark"] .sc-meta { color:#9bbcdb; }
.sc-tags { display:flex; flex-wrap:wrap; gap:4px; margin-top:2px;}
.sc-tag { font-size:.58rem; padding:1px 7px; border:1px solid var(--sky-light); border-radius:var(--r-pill); color:#0369a1; background:#e0f2fe; }
[data-theme="dark"] .sc-tag { border-color:rgba(80,150,210,.4); background:rgba(20,55,90,.6); color:#a8d4f0; }
.sc-footer { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: auto; padding-top: 6px; flex-wrap: wrap; }
.sc-chapters { font-size: .65rem; color: #475569; }
[data-theme="dark"] .sc-chapters { color: #9bbcdb; }
.sc-link { font-size: .68rem; padding: 4px 10px; background: var(--sky); color: #fff; border-radius: var(--r-pill); transition: var(--t); flex-shrink: 0; font-family: 'Newsreader', serif; white-space: nowrap; }
.sc-link:hover { background: var(--sky2); transform: translateY(-1px); }
.sc-link.secondary { background: #e0f2fe; color: #0369a1; }
[data-theme="dark"] .sc-link.secondary { color: #a8d4f0; background: rgba(20,55,90,.7); border: 1px solid rgba(80,150,210,.35); }
[data-theme="dark"] .sc-link.secondary:hover { background: rgba(80,150,210,.25); }
@media(max-width: 420px) { .sc-footer { flex-direction: column; align-items: flex-start; gap: 8px; } .sc-footer > div { width: 100%; display: flex; justify-content: space-between; } }

.notice-section { margin-top:22px; }
.notice-img-wrap { background: #fff; padding: 10px; border-radius: 12px; border: 1px solid rgba(186,230,253,.5); box-shadow: 0 4px 15px rgba(2,132,199,.05); display: flex; justify-content: center; align-items: center; }
[data-theme="dark"] .notice-img-wrap { background: var(--bg-card); border-color: rgba(80,150,210,.25); }
.notice-img { width: 90%; max-width: 400px; display:block; border-radius:8px; transition: transform 0.3s; }
.notice-img:hover { transform: scale(1.03); box-shadow: 0 4px 15px rgba(2,132,199,.1); }
@media(max-width:768px){ .notice-img { width: 85%; } }
/* Cẩm nang */
    .guide-box {
