---
import Layout from '../layouts/Layout.astro';

// Lấy số chương đã đăng cho mỗi truyện
const ndntkmPosts = Object.values(import.meta.glob('./ca-tren-ban/neu-dem-nay-troi-khong-mua/*.md', { eager: true })) as any[];
const tnctcstPosts = Object.values(import.meta.glob('./ca-tren-ban/toi-nghi-chung-toi-sap-chia-tay/*.md', { eager: true })) as any[];
const qhbcpPosts   = Object.values(import.meta.glob('./ca-duoi-nuoc/quan-he-ban-cung-phong/*.md',  { eager: true })) as any[];
const hcdhPosts    = Object.values(import.meta.glob('./ca-duoi-nuoc/ha-chay-dong-hoang/*.md',     { eager: true })) as any[];

const countChaps = (posts: any[]) => posts.filter(p => p.frontmatter?.chuong && p.frontmatter.chuong !== 0).length;

const stories = [
  {
    id: 'qhbcp',
    title: 'Quan hệ bạn cùng phòng',
    author: 'Hạnh Lan',
    desc: 'Anh ấy nghèo thì đã sao? Tôi có tiền là được rồi.',
    cover: '/dynamic-duo-web/images/biaqhbcp.png',
    href: '/dynamic-duo-web/ca-duoi-nuoc/quan-he-ban-cung-phong/',
    firstChap: '/dynamic-duo-web/ca-duoi-nuoc/quan-he-ban-cung-phong/chuong-01/',
    cat: 'ongoing', catLabel: '🌊 Cá dưới nước',
    tags: ['đam mỹ', 'hiện đại', 'niên hạ', 'trai thẳng'],
    done: countChaps(qhbcpPosts), total: 72,
  },
  {
    id: 'hcdh',
    title: 'Hạ cháy đồng hoang',
    author: 'Hỉ Thượng Mi Sao',
    desc: 'Tình yêu là bản năng ẩn sau miền hoang tàn của ký ức.',
    cover: '/dynamic-duo-web/images/biahcdh.png',
    href: '/dynamic-duo-web/ca-duoi-nuoc/ha-chay-dong-hoang/',
    firstChap: '/dynamic-duo-web/ca-duoi-nuoc/ha-chay-dong-hoang/chuong-01/',
    cat: 'ongoing', catLabel: '🌊 Cá dưới nước',
    tags: ['đam mỹ', 'hiện đại', 'chua xót', 'mất trí nhớ'],
    done: countChaps(hcdhPosts), total: 109,
  },
  {
    id: 'ndntkm',
    title: 'Nếu đêm nay trời không mưa',
    author: 'Tam Đạo',
    desc: 'Tình cờ gặp lại mối tình đầu từng đá anh — lần này thật sự không còn yêu nữa.',
    cover: '/dynamic-duo-web/images/biandntkm.png',
    href: '/dynamic-duo-web/ca-tren-ban/neu-dem-nay-troi-khong-mua/',
    firstChap: '/dynamic-duo-web/ca-tren-ban/neu-dem-nay-troi-khong-mua/chuong-01/',
    cat: 'completed', catLabel: '🍽️ Cá trên bàn',
    tags: ['đam mỹ', 'hiện đại', 'HE', 'gương vỡ lại lành'],
    done: countChaps(ndntkmPosts), total: 76,
  },
  {
    id: 'tnctsct',
    title: 'Tôi nghĩ chúng tôi sắp chia tay',
    author: 'Hạ Nhất Thiên',
    desc: 'Khủng hoảng năm thứ 8. Hai người lớn nhát gan.',
    cover: '/dynamic-duo-web/images/biatnctsct.png',
    href: '/dynamic-duo-web/ca-tren-ban/toi-nghi-chung-toi-sap-chia-tay/',
    firstChap: '/dynamic-duo-web/ca-tren-ban/toi-nghi-chung-toi-sap-chia-tay/chuong-01/',
    cat: 'completed', catLabel: '🍽️ Cá trên bàn',
    tags: ['đam mỹ', 'hiện đại', 'HE', 'chua xót'],
    done: countChaps(tnctcstPosts), total: 74,
  },
];

const allTags = [...new Set(stories.flatMap(s => s.tags))].sort();
---

<Layout frontmatter={{ title: 'Trang chủ' }}>
  <style>
    /* ── HERO ── */
    .hero { text-align: center; padding: 30px 0 44px; }
    .hero-logo { width: 84px; height: 84px; border-radius: 50%; object-fit: cover; border: 3px solid var(--sky-light); box-shadow: 0 4px 20px rgba(14,165,233,.15); margin-bottom: 16px; }
    .hero-title { font-family: 'Literata', serif; font-size: 1.9rem; font-weight: 600; color: var(--sky-dark); margin: 0 0 5px; }
    .hero-tagline { font-size: .88rem; color: var(--text-dim); font-style: italic; margin: 0 0 22px; }
    .hero-banner { width: 100%; max-height: 200px; object-fit: cover; border-radius: var(--r-lg); box-shadow: var(--sh-soft); }

    /* ── SECTION HEADER ── */
    .sec-hd { display: flex; align-items: center; gap: 10px; margin: 44px 0 18px; }
    .sec-hd h2 { font-family: 'Merriweather', serif; font-size: .88rem; color: var(--sky-dark); letter-spacing: 2px; text-transform: uppercase; margin: 0; text-align: left; white-space: nowrap; }
    .sec-line { flex: 1; height: 1px; background: linear-gradient(to right, var(--sky-light), transparent); }
    .sec-link { font-size: .74rem; color: var(--sky); white-space: nowrap; transition: var(--t); }
    .sec-link:hover { text-decoration: underline; }

    /* ── TAG FILTER ── */
    .tag-filter { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 24px; justify-content: center; }
    .filter-btn {
      padding: 4px 14px; border: 1.5px solid var(--sky-light); border-radius: var(--r-pill);
      font-size: .76rem; color: var(--text-mid); cursor: pointer; transition: var(--t);
      background: #fff; font-family: 'Newsreader', serif;
    }
    .filter-btn:hover { border-color: var(--sky); color: var(--sky); background: var(--sky-pale); }
    .filter-btn.active { background: var(--sky); color: #fff; border-color: var(--sky); }
    .filter-btn.all-btn.active { background: var(--sky); color: #fff; }

    /* ── CARDS ── */
    .story-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    @media (max-width: 540px) { .story-grid { grid-template-columns: 1fr; } }

    .story-card {
      border: 1px solid rgba(186,230,253,.5); border-radius: var(--r-md);
      overflow: hidden; background: #fff; transition: var(--t);
      display: flex; flex-direction: column;
    }
    .story-card:hover { box-shadow: var(--sh-card); transform: translateY(-3px); }
    .story-card[data-hidden="true"] { display: none; }

    .card-img-wrap { position: relative; }
    .card-cover { width: 100%; height: 175px; object-fit: cover; display: block; background: var(--sky-pale); }
    .card-cat-badge {
      position: absolute; top: 10px; left: 10px;
      font-size: .62rem; letter-spacing: 1.2px; text-transform: uppercase;
      padding: 3px 10px; border-radius: var(--r-pill); font-weight: 600;
      backdrop-filter: blur(8px);
    }
    .card-cat-badge.ongoing { background: rgba(254,249,195,.9); color: #854d0e; }
    .card-cat-badge.completed { background: rgba(220,252,231,.9); color: #166534; }

    .card-body { padding: 13px 15px 15px; flex: 1; display: flex; flex-direction: column; }
    .card-title { font-family: 'Merriweather', serif; font-size: .9rem; color: var(--sky-dark); margin: 0 0 3px; line-height: 1.4; }
    .card-author { font-size: .72rem; color: var(--text-dim); font-style: italic; margin: 0 0 8px; }
    .card-desc { font-size: .82rem; color: var(--text-mid); line-height: 1.6; margin: 0 0 9px; flex: 1; }
    .card-tags { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 8px; }
    .card-tag { font-size: .65rem; padding: 2px 7px; border: 1px solid var(--sky-light); border-radius: var(--r-pill); color: var(--sky); background: var(--sky-pale); }
    .card-progress { font-size: .7rem; color: var(--text-dim); margin-bottom: 10px; }
    .card-prog-bar { height: 3px; background: rgba(186,230,253,.35); border-radius: 2px; overflow: hidden; margin-top: 3px; }
    .card-prog-fill { height: 100%; background: var(--sky-light); border-radius: 2px; }
    .card-btns { display: flex; gap: 6px; }
    .card-btn-outline { flex: 1; text-align: center; padding: 7px 8px; border: 1.5px solid var(--sky-light); border-radius: var(--r-pill); color: var(--sky-dark); font-size: .76rem; transition: var(--t); }
    .card-btn-outline:hover { background: var(--sky-pale); color: var(--sky); }
    .card-btn-fill { flex: 1; text-align: center; padding: 7px 8px; background: var(--sky); border: 1.5px solid var(--sky); border-radius: var(--r-pill); color: #fff; font-size: .76rem; transition: var(--t); }
    .card-btn-fill:hover { background: var(--sky2); border-color: var(--sky2); }

    /* ── UPCOMING ── */
    .upcoming-box {
      background: var(--sky-pale); border: 1.5px dashed var(--sky-light);
      border-radius: var(--r-md); padding: 22px 24px; text-align: center;
    }
    .upcoming-box p { color: var(--text-mid); font-size: .88rem; font-style: italic; margin: 0 0 10px; }
  </style>

  <!-- HERO -->
  <div class="hero">
    <img src="/dynamic-duo-web/images/logo1.png" alt="Logo" class="hero-logo" onerror="this.style.display='none'" />
    <h1 class="hero-title">dynamic duo 𓆝.°•</h1>
    <p class="hero-tagline">paired dreams, boundless gleam.</p>
    <img src="/dynamic-duo-web/images/banner.png" alt="Banner" class="hero-banner" onerror="this.style.display='none'" />
  </div>

  <!-- TAG FILTER -->
  <div class="tag-filter" id="tagFilter">
    <button class="filter-btn all-btn active" data-tag="all">Tất cả</button>
    {allTags.map(tag => (
      <button class="filter-btn" data-tag={tag}># {tag}</button>
    ))}
  </div>

  <!-- CÁ DƯỚI NƯỚC -->
  <div class="sec-hd">
    <h2>🐠 Cá dưới nước</h2>
    <div class="sec-line"></div>
    <a href="/dynamic-duo-web/ca-duoi-nuoc/" class="sec-link">Xem tất cả →</a>
  </div>

  <div class="story-grid" id="storyGrid">
    {stories.map(s => {
      const pct = Math.min(100, Math.round((s.done / s.total) * 100));
      return (
        <div class="story-card" data-tags={s.tags.join(',')}>
          <div class="card-img-wrap">
            <a href={s.href}>
              <img src={s.cover} alt={s.title} class="card-cover" onerror="this.src='/dynamic-duo-web/images/frontpage.png'" />
            </a>
            <span class={`card-cat-badge ${s.cat}`}>{s.catLabel}</span>
          </div>
          <div class="card-body">
            <h3 class="card-title">{s.title}</h3>
            <p class="card-author">{s.author}</p>
            <p class="card-desc">{s.desc}</p>
            <div class="card-tags">
              {s.tags.map(t => <span class="card-tag"># {t}</span>)}
            </div>
            <div class="card-progress">
              📖 {s.done}/{s.total} chương ({pct}%)
              <div class="card-prog-bar"><div class="card-prog-fill" style={`width:${pct}%`}></div></div>
            </div>
            <div class="card-btns">
              <a href={s.href} class="card-btn-outline">Trang truyện</a>
              <a href={s.firstChap} class="card-btn-fill">Đọc →</a>
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <!-- CÁ TRÊN TRỜI -->
  <div class="sec-hd" style="margin-top:44px">
    <h2>🌤️ Cá trên trời</h2>
    <div class="sec-line"></div>
    <a href="/dynamic-duo-web/ca-tren-troi/" class="sec-link">Xem →</a>
  </div>
  <div class="upcoming-box">
    <p>☁️ Đang đặt gạch... những chú cá đang bay trên mây, sắp hạ cánh.</p>
    <a href="/dynamic-duo-web/ca-tren-troi/" style="font-size:.82rem;color:var(--sky)">Xem danh sách sắp đào →</a>
  </div>

  <script is:inline>
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.story-card');
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const tag = btn.dataset.tag;
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        cards.forEach(card => {
          if (tag === 'all') { card.setAttribute('data-hidden','false'); return; }
          const ct = (card.dataset.tags || '').split(',').map(t => t.trim().toLowerCase());
          card.setAttribute('data-hidden', ct.includes(tag.toLowerCase()) ? 'false' : 'true');
        });
      });
    });
  </script>
</Layout>
