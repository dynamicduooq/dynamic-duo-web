<script is:inline>
/* ══════════════════════════════════════
   FILTER
══════════════════════════════════════ */
const allCards  = document.querySelectorAll('.sc');
const chips     = document.querySelectorAll('#filterChips .chip');
const flCount   = document.getElementById('flCount');
const chipClear = document.getElementById('chipClear');
let activeTags = new Set();
let activeCat  = null;

function updateClearBtn(){ if(chipClear) chipClear.style.display=(activeTags.size>0||activeCat!==null)?'inline-flex':'none'; }
function applyFilter(){
  let vis=0;
  allCards.forEach(card=>{
    // Reset animation bằng cách remove rồi add lại class (để chạy lại CSS keyframe)
    card.style.animation = 'none';
    card.offsetHeight; // trigger reflow
    card.style.animation = '';

    const cCat  = card.dataset.cat||'';
    const cTags = (card.dataset.tags||'').split(',').map(t=>t.trim().toLowerCase());
    const catOk = activeCat===null||cCat===activeCat;
    const tagOk = activeTags.size===0||[...activeTags].every(t=>cTags.includes(t.toLowerCase()));
    const show  = catOk&&tagOk;
    card.classList.toggle('hidden',!show);
    if(show) vis++;
  });
  if(flCount) flCount.textContent=vis+' truyện';
  document.getElementById('noRes')?.classList.toggle('show',vis===0);
  updateClearBtn();
}
chips.forEach(chip=>{
  chip.addEventListener('click',()=>{
    if(chip.id==='chipClear'){ activeTags.clear(); activeCat=null; chips.forEach(c=>c.classList.remove('active')); document.querySelector('[data-tag="all"]')?.classList.add('active'); applyFilter(); return; }
    if(chip.dataset.tag){
      const tag=chip.dataset.tag;
      if(tag==='all'){ activeTags.clear(); chips.forEach(c=>c.dataset.tag&&c.classList.remove('active')); chip.classList.add('active'); }
      else{ document.querySelector('[data-tag="all"]')?.classList.remove('active'); if(activeTags.has(tag)){activeTags.delete(tag);chip.classList.remove('active');}else{activeTags.add(tag);chip.classList.add('active');} if(activeTags.size===0) document.querySelector('[data-tag="all"]')?.classList.add('active'); }
    } else if(chip.dataset.cat){
      const cat=chip.dataset.cat; chips.forEach(c=>c.dataset.cat&&c.classList.remove('active')); activeCat=(activeCat===cat)?null:cat; if(activeCat) chip.classList.add('active');
    }
    applyFilter();
  });
});

/* ══════════════════════════════════════
   REVEAL ON SCROLL
══════════════════════════════════════ */
const obs=new IntersectionObserver(es=>es.forEach(e=>{ if(e.isIntersecting){e.target.classList.add('visible');obs.unobserve(e.target);} }),{threshold:.1});
document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));

/* ══════════════════════════════════════
   CLICK TO COPY EMAIL
══════════════════════════════════════ */
(function setupCopyEmail(){
  const copyBtn = document.getElementById('sidebarEmailCopy');
  const tooltip = document.getElementById('emailTooltip');
  if(!copyBtn || !tooltip) return;

  copyBtn.addEventListener('click', (e) => {
    navigator.clipboard.writeText('dynamicduoo.q@gmail.com').then(() => {
      // Position tooltip near cursor
      const rect = copyBtn.getBoundingClientRect();
      tooltip.style.left = (e.clientX - rect.left - 20) + 'px';
      tooltip.classList.add('show');
      setTimeout(() => tooltip.classList.remove('show'), 2000);
    });
  });
})();

/* ══════════════════════════════════════
   MAIL BUBBLE
══════════════════════════════════════ */
(function setupBubble(){
  const btn   = document.getElementById('msgBubbleBtn');
  const popup = document.getElementById('msgPopup');
  const close = document.getElementById('msgPopupClose');
  if(!btn||!popup) return;

  btn.addEventListener('click', e => {
    e.stopPropagation();
    popup.classList.toggle('open');
  });
  close?.addEventListener('click', () => popup.classList.remove('open'));
  document.addEventListener('click', e => {
    if(popup.classList.contains('open') && !popup.contains(e.target) && !btn.contains(e.target))
      popup.classList.remove('open');
  });

  popup.querySelectorAll('[data-popup-panel]').forEach(tab => {
    tab.addEventListener('click', () => {
      const panel = tab.dataset.popupPanel;
      popup.querySelectorAll('[data-popup-panel]').forEach(t=>t.classList.remove('active'));
      tab.classList.add('active');
      popup.querySelectorAll('.msg-panel').forEach(p=>p.classList.remove('active'));
      document.getElementById('msgPopupPanel'+(panel.charAt(0).toUpperCase()+panel.slice(1)))?.classList.add('active');
    });
  });
})();

/* ══════════════════════════════════════
   MESSAGE WIDGET
══════════════════════════════════════ */
(function setupMessageWidget(){
  function msgEsc(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function msgTime(ts){
    if(!ts) return '';
    const d=Date.now()-ts;
    if(d<60000)    return 'vừa xong';
    if(d<3600000)  return Math.floor(d/60000)+' phút trước';
    if(d<86400000) return Math.floor(d/3600000)+' giờ trước';
    return Math.floor(d/86400000)+' ngày trước';
  }
  function getMsgToken(){ let t=localStorage.getItem('dd_token'); if(!t){t=Math.random().toString(36).slice(2)+Date.now().toString(36);localStorage.setItem('dd_token',t);} return t; }
  const myToken     = getMsgToken();
  const ADMIN_NAME  = 'dynamic duo 𓆝';
  let isAdmin=false, lastPublicData=null, lastPrivateData=null, pubDebounce=null, privDebounce=null;

  window.addEventListener('dd-auth-change', e => {
    isAdmin = e.detail.isAdmin;
    updateAdminUI();
    renderPublicMessages(lastPublicData);
    renderPrivateMessages(lastPrivateData);
  });

  function updateAdminUI(){
    const nameEl     = document.getElementById('msgPublicName');
    const adminPanel = document.getElementById('msgPrivateAdminPanel');
    const userNote   = document.getElementById('msgPrivateUserNote');
    if(nameEl)     { nameEl.style.display = isAdmin ? 'none' : ''; }
    if(adminPanel) { adminPanel.style.display = isAdmin ? 'block' : 'none'; }
    if(userNote)   { userNote.style.display   = isAdmin ? 'none'  : 'block'; }
  }

  document.querySelectorAll('#msgSidebarWidget [data-panel]').forEach(tab => {
    tab.addEventListener('click', () => {
      const panel = tab.dataset.panel;
      document.querySelectorAll('#msgSidebarWidget [data-panel]').forEach(t=>t.classList.remove('active'));
      tab.classList.add('active');
      document.querySelectorAll('#msgSidebarWidget .msg-panel').forEach(p=>p.classList.remove('active'));
      document.getElementById('msgPanel'+(panel.charAt(0).toUpperCase()+panel.slice(1)))?.classList.add('active');
    });
  });

  function renderPrivateMessages(data){
    lastPrivateData = data;
    const adminList = document.getElementById('msgPrivateAdminList');
    const userView  = document.getElementById('msgPrivateUserReply');

    if(adminList){
      if(!isAdmin){ adminList.innerHTML=''; return; }
      if(!data){ adminList.innerHTML='<div class="msg-public-empty">Chưa có tin nhắn riêng tư nào 🌊</div>'; return; }
      const items = Object.entries(data).map(([id,v])=>({id,...v})).sort((a,b)=>(b.ts||0)-(a.ts||0));
      adminList.innerHTML = items.map(m => {
        const replied = m.adminReply;
        return `<div class="msg-priv-card ${replied?'replied':'unread'}" id="mpc-${msgEsc(m.id)}">
          <div class="msg-priv-card-header">
            <span class="msg-priv-sender">${msgEsc(m.name)||'Ẩn danh'}</span>
            <span class="msg-priv-time">${msgTime(m.ts)}</span>
            <button class="msg-priv-del" title="Xóa tin nhắn" data-mid="${msgEsc(m.id)}">✕</button>
          </div>
          <div class="msg-priv-text">${msgEsc(m.text)}</div>
          ${replied
            ? `<div class="msg-priv-replied-wrap">
                <span class="msg-priv-replied-label">↩ Chủ nhà trả lời:</span>
                <div class="msg-priv-replied-text">${msgEsc(replied.text)}</div>
                <div style="text-align:right">
                  <button class="msg-priv-del-reply" data-mid="${msgEsc(m.id)}">Thử lại / Xóa</button>
                </div>
               </div>`
            : `<div>
                <textarea class="msg-priv-reply-inp" placeholder="Nhập nội dung trả lời cho ${msgEsc(m.name)||'bạn này'}..." rows="2" id="mprft-${msgEsc(m.id)}"></textarea>
                <div style="display:flex;justify-content:flex-end;margin-top:3px">
                  <button class="msg-priv-send-btn" data-mid="${msgEsc(m.id)}">Gửi reply ↩</button>
                </div>
               </div>`
          }
        </div>`;
      }).join('');
      adminList.querySelectorAll('.msg-priv-send-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const mid=btn.dataset.mid, ta=document.getElementById('mprft-'+mid), text=(ta?.value||'').trim();
          if(!text) return; btn.disabled=true;
          if(window.__ddFirebase){ const {db,ref,update}=window.__ddFirebase; try{ await update(ref(db,'private_messages/'+mid+'/adminReply'),{text,ts:Date.now()}); if(ta) ta.value=''; }catch(e){alert('Lỗi: '+e.message);} }
          btn.disabled=false;
        });
      });
      adminList.querySelectorAll('.msg-priv-del').forEach(btn => {
        btn.addEventListener('click', async () => { if(!confirm('Xóa tin nhắn này?')) return; if(window.__ddFirebase){const {db,ref,remove}=window.__ddFirebase; await remove(ref(db,'private_messages/'+btn.dataset.mid));} });
      });
      adminList.querySelectorAll('.msg-priv-del-reply').forEach(btn => {
        btn.addEventListener('click', async () => { if(!confirm('Xóa reply này?')) return; if(window.__ddFirebase){const {db,ref,remove}=window.__ddFirebase; await remove(ref(db,'private_messages/'+btn.dataset.mid+'/adminReply'));} });
      });
    }

    if(userView && !isAdmin){
      if(!data){ userView.innerHTML=''; return; }
      const myMsgs = Object.entries(data).map(([id,v])=>({id,...v})).filter(m=>m.token===myToken&&m.adminReply).sort((a,b)=>(b.ts||0)-(a.ts||0));
      if(myMsgs.length===0){ userView.innerHTML=''; return; }
      userView.innerHTML = `<div class="msg-admin-reply-section">
        <div class="msg-admin-reply-title">💬 Có tin nhắn mới từ chủ nhà:</div>
        ${myMsgs.map(m=>`<div class="msg-admin-reply-card">
          <div class="msg-admin-reply-orig">Tin của bạn: <em>${msgEsc(m.text.substring(0,60))}${m.text.length>60?'...':''}</em></div>
          <div class="msg-admin-reply-body"><span class="msg-admin-badge">dynamic duo 𓆝</span>${msgEsc(m.adminReply.text)}</div>
          <div class="msg-admin-reply-time">${msgTime(m.adminReply.ts)}</div>
        </div>`).join('')}
      </div>`;
    }
  }

  function bindPrivateSend(nameId,textId,sendId,doneId){
    const nameEl=document.getElementById(nameId), textEl=document.getElementById(textId), sendEl=document.getElementById(sendId), doneEl=document.getElementById(doneId);
    if(!sendEl) return;
    function doSend(){
      const text=(textEl?.value||'').trim(); if(!text) return; sendEl.disabled=true;
      function wfl(cb){if(window.__ddFirebase?.db){cb(window.__ddFirebase);return;}const t=setInterval(()=>{if(window.__ddFirebase?.db){clearInterval(t);cb(window.__ddFirebase);}},200);}
      wfl(async({db,ref,push})=>{ try{ await push(ref(db,'private_messages'),{name:(nameEl?.value||'').trim()||'Ẩn danh',text,ts:Date.now(),token:myToken,read:false}); if(textEl)textEl.value=''; if(doneEl){doneEl.style.display='block';setTimeout(()=>{if(doneEl)doneEl.style.display='none';},3500);} }catch(e){alert('Lỗi: '+e.message);} sendEl.disabled=false; });
    }
    sendEl.addEventListener('click',doSend);
    textEl?.addEventListener('keydown',e=>{if(e.key==='Enter'&&(e.ctrlKey||e.metaKey))doSend();});
  }
  bindPrivateSend('msgPrivateName','msgPrivateText','msgPrivateSend','msgPrivateDone');
  bindPrivateSend('msgPopupPrivateName','msgPopupPrivateText','msgPopupPrivateSend','msgPopupPrivateDone');

  function renderPublicMessages(data){
    lastPublicData = data;
    function renderFeed(feedEl){
      if(!feedEl) return;
      const empty='<div class="msg-public-empty">Chưa có lời nhắn nào 𓆝</div>';
      if(!data){ feedEl.innerHTML=empty; return; }
      const items=Object.entries(data).map(([id,v])=>({id,...v})).sort((a,b)=>(a.ts||0)-(b.ts||0));
      feedEl.innerHTML=items.map(m=>{
        const isMine=m.token===myToken, canDel=isAdmin||isMine, isOwner=m.isAdmin===true;
        return `<div class="msg-pub-item ${isOwner?'msg-pub-admin':''}">
          <div class="msg-pub-item-header">
            <span class="msg-pub-name ${isOwner?'msg-pub-admin-name':''}">${isOwner?'🐋 '+msgEsc(m.name):msgEsc(m.name)||'Khách vô danh'}</span>
            ${isOwner?'<span class="msg-pub-owner-badge">chủ nhà</span>':''}
            <span class="msg-pub-time">${msgTime(m.ts)}</span>
            <button class="msg-pub-del ${canDel?'show':''}" title="Xóa" data-mid="${msgEsc(m.id)}">✕</button>
          </div>
          <div class="msg-pub-text">${msgEsc(m.text)}</div>
        </div>`;
      }).join('');
      feedEl.scrollTop=feedEl.scrollHeight;
      feedEl.querySelectorAll('.msg-pub-del.show').forEach(btn=>{
        btn.addEventListener('click',async()=>{ if(!confirm('Xóa lời nhắn này?'))return; if(window.__ddFirebase){const {db,ref,remove}=window.__ddFirebase; await remove(ref(db,'public_messages/'+btn.dataset.mid));} });
      });
    }
    renderFeed(document.getElementById('msgPublicFeed'));
    renderFeed(document.getElementById('msgPopupPublicFeed'));
  }

  function bindPublicSend(nameId,textId,sendId,doneId){
    const nameEl=document.getElementById(nameId), textEl=document.getElementById(textId), sendEl=document.getElementById(sendId), doneEl=document.getElementById(doneId);
    if(!sendEl) return;
    function doSend(){
      const text=(textEl?.value||'').trim(); if(!text) return; sendEl.disabled=true;
      function wfl(cb){if(window.__ddFirebase?.db){cb(window.__ddFirebase);return;}const t=setInterval(()=>{if(window.__ddFirebase?.db){clearInterval(t);cb(window.__ddFirebase);}},200);}
      wfl(async({db,ref,push})=>{ try{ const name=isAdmin?ADMIN_NAME:(nameEl?.value||'').trim()||'Khách vô danh'; await push(ref(db,'public_messages'),{name,text,ts:Date.now(),token:myToken,isAdmin:isAdmin?true:false}); if(textEl)textEl.value=''; if(doneEl){doneEl.style.display='block';setTimeout(()=>{if(doneEl)doneEl.style.display='none';},3000);} }catch(e){alert('Lỗi: '+e.message);} sendEl.disabled=false; });
    }
    sendEl.addEventListener('click',doSend);
    textEl?.addEventListener('keydown',e=>{if(e.key==='Enter'&&(e.ctrlKey||e.metaKey))doSend();});
  }
  bindPublicSend('msgPublicName','msgPublicText','msgPublicSend','msgPublicDone');
  bindPublicSend('msgPopupPublicName','msgPopupPublicText','msgPopupPublicSend','msgPopupPublicDone');

  function wfl(cb){
    if(window.__ddFirebase?.db){cb(window.__ddFirebase);return;}
    window.addEventListener('dd-firebase-ready',()=>{if(window.__ddFirebase?.db)cb(window.__ddFirebase);},{once:true});
    let n=0; const t=setInterval(()=>{if(window.__ddFirebase?.db){clearInterval(t);cb(window.__ddFirebase);}if(++n>60)clearInterval(t);},200);
  }
  wfl(({db,ref,onValue})=>{
    onValue(ref(db,'public_messages'),  snap=>{clearTimeout(pubDebounce);  pubDebounce =setTimeout(()=>renderPublicMessages(snap.val()),60);});
    onValue(ref(db,'private_messages'), snap=>{clearTimeout(privDebounce); privDebounce=setTimeout(()=>renderPrivateMessages(snap.val()),60);});
  });
})();
</script>
</Layout>