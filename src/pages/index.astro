---
import Layout from '../layouts/Layout.astro';
import settings from '../data/settings.json';
---
<Layout title="Trang chủ">
<style is:global>
/* ─── RESET & VARS TỪ BẢN CŨ ─────────────────────────────── */
:root {
  --sky:#0284c7; --sky2:#0369a1; --sky-light:#bae6fd; --sky-pale:#f0f9ff;
  --sky-dark:#03507c; --text:#1e3a50; --text-mid:#5f8295; --text-dim:#94a3b8;
  --r-sm:12px; --r-md:20px; --r-lg:28px; --r-pill:999px;
  --sh-soft:0 4px 20px rgba(2,132,199,.07);
  --sh-card:0 8px 30px rgba(2,132,199,.10);
  --t:.28s cubic-bezier(.4,0,.2,1);
}

/* ─── HERO (Logo & Avatar) ─────────────────────────────────────── */
.hero {
  min-height: 80vh; display:flex; align-items:center; justify-content:center;
  padding: 80px 24px 60px; text-align:center; position:relative; overflow:hidden;
}
.hero-deco { position:absolute; inset:0; pointer-events:none; overflow:hidden; }
.hero-blob {
  position:absolute; border-radius:50%;
  background:radial-gradient(circle,rgba(186,230,253,.32),transparent);
  animation:float 9s ease-in-out infinite;
}
.hero-blob:nth-child(1){width:340px;height:340px;top:-90px;right:-70px;animation-delay:0s}
.hero-blob:nth-child(2){width:220px;height:220px;bottom:6%;left:-60px;animation-delay:3s}
.hero-blob:nth-child(3){width:150px;height:150px;top:33%;right:6%;animation-delay:5.5s}
@keyframes float { 0%,100%{transform:translateY(0) scale(1)} 50%{transform:translateY(-20px) scale(1.04)} }
@keyframes fadeUp { from{opacity:0;transform:translateY(24px)} to{opacity:1;transform:translateY(0)} }

.hero-inner { position:relative; z-index:1; max-width:650px; display: flex; flex-direction: column; align-items: center; }
.hero-logo { max-width: 85%; width: 480px; filter: drop-shadow(0px 4px 6px rgba(2, 132, 199, 0.15)); animation: fadeUp 0.9s ease both; margin-bottom: 20px; }
.hero-avatar { width: 140px; height: 140px; border-radius: 50%; border: 4px solid white; box-shadow: 0 8px 20px rgba(2, 132, 199, 0.2); object-fit: cover; animation: fadeUp 1.1s ease both; transition: 0.5s; }
.hero-avatar:hover { transform: rotate(10deg); }
.hero-eyebrow { color:var(--sky-light); font-size:1.1rem; letter-spacing:5px; margin-bottom:14px; animation:fadeUp .7s ease both; }

/* ─── TICKER ───────────────────────────────────── */
.ticker-wrap {
  overflow:hidden; background:linear-gradient(90deg,rgba(224,242,254,.5),rgba(240,249,255,.7),rgba(224,242,254,.5));
  border-top:1px solid var(--sky-light); border-bottom:1px solid var(--sky-light); padding:9px 0; margin-bottom: 40px;
}
.ticker-track { display:flex; white-space:nowrap; animation:ticker 32s linear infinite; }
.ticker-track:hover { animation-play-state:paused; }
.ticker-item { display:inline-flex; align-items:center; gap:24px; font-size:.78rem; color:var(--sky2); letter-spacing:1.5px; padding:0 24px; }
.ticker-item::after { content:'·'; color:var(--sky-light); margin-left:24px; }
@keyframes ticker { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }

/* ─── PAGE LAYOUT ───────────────────────────────── */
.page-body {
  max-width:1120px; margin:0 auto; padding:0px 20px 80px; display:grid; grid-template-columns:1fr 290px; gap:34px; align-items:start;
}

/* ─── SIDEBAR ──────────────────────────────────── */
.sidebar { position:sticky; top:90px; display:flex; flex-direction:column; gap:20px; }
.widget { background:rgba(240,249,255,.6); border:1px solid #e0f2fe; border-radius:20px; padding:20px 16px; }
.widget-title { font-family:'Merriweather',serif; font-size:.78rem; letter-spacing:2.5px; text-transform:uppercase; color:var(--sky); text-align:center; margin-bottom:12px; }
.widget-divider { display:flex; align-items:center; gap:8px; justify-content:center; margin-bottom:12px; font-size:.75rem; color:var(--sky-light); letter-spacing:2px; }

/* Profile widget */
.profile-widget { text-align:center; }
.profile-avatar { width:86px; height:86px; border-radius:50%; overflow:hidden; margin:0 auto 11px; border:3px solid var(--sky-light); }
.profile-avatar img { width:100%; height:100%; object-fit:cover; }
.profile-name { font-family:'Merriweather',serif; color:#334155; font-size:1rem; margin-bottom:5px; }
.profile-tagline { font-size:.84rem; color:#64748b; font-style:italic; line-height:1.5; margin-bottom:7px; }
.profile-deco { font-size:1rem; letter-spacing:3px; color:var(--sky-light); }

/* Tag cloud */
.tag-cloud { display:flex; flex-wrap:wrap; justify-content:center; gap:5px; line-height:1.8; }
.tag-cloud a { display:inline-block; padding:4px 10px; background:#fff; color:var(--sky); border-radius:var(--r-pill); font-size:.76rem; border:1px dashed var(--sky-light); font-family:'Newsreader',serif; transition:var(--t); cursor:pointer; }
.tag-cloud a:hover { background:var(--sky-pale); border-style:solid; }

/* Now playing */
.now-playing { display:flex; align-items:center; gap:12px; }
.vinyl { width:42px; height:42px; border-radius:50%; overflow:hidden; flex-shrink:0; animation:spin 6s linear infinite; animation-play-state:paused; }
.vinyl:hover { animation-play-state:running; }
.vinyl img { width:100%; height:100%; object-fit:cover; }
@keyframes spin { to{transform:rotate(360deg)} }
.np-info { text-align:left; min-width:0; }
.np-label { font-size:.63rem; color:var(--text-dim); text-transform:uppercase; letter-spacing:1px; margin-bottom:2px; }
.np-song { font-family:'Merriweather',serif; color:#475569; font-size:.8rem; line-height:1.3; }

/* Calendar */
.cal-header { display:flex; align-items:center; justify-content:space-between; font-size:.8rem; color:var(--sky-dark); margin-bottom:10px; font-weight:600; }
.cal-grid { display:grid; grid-template-columns:repeat(7,1fr); gap:2px; text-align:center; }
.cal-grid .cal-day-header { font-size:.62rem; color:var(--text-dim); letter-spacing:.5px; padding:3px 0; }
.cal-grid .cal-day { font-size:.73rem; color:var(--text-mid); padding:3px 0; border-radius:6px; cursor:default; }
.cal-grid .cal-day.today { background:var(--sky); color:#fff; font-weight:600; }
.cal-grid .cal-day.has-post { color:var(--sky); font-weight:600; cursor:pointer; }
.cal-grid .cal-day.has-post:hover { background:var(--sky-pale); }
.cal-grid .cal-day.empty { opacity:0; }

/* Category tree & Quote */
.cat-tree { font-size:.8rem; color:var(--text-mid); }
.cat-tree ul { list-style:none; margin-left:14px; margin-top:3px; padding:0; }
.cat-tree > ul { margin-left:0; }
.cat-tree a { color:var(--text-mid); transition:color .2s; text-decoration:none; }
.cat-tree a:hover { color:var(--sky); }
.cat-tree summary { cursor:pointer; font-size:.8rem; color:var(--sky-dark); font-weight:600; padding:3px 0; list-style:none; display:flex; align-items:center; gap:5px; }
.cat-tree summary::-webkit-details-marker { display:none; }
.cat-tree summary::before { content:'▸'; font-size:.6rem; transition:transform .2s; color:var(--sky); }
.cat-tree details[open] > summary::before { transform:rotate(90deg); }
.cat-tree li { margin:3px 0; }

.quote-widget blockquote { font-style:italic; font-size:.82rem; color:var(--text-mid); line-height:1.75; border-left:3px solid var(--sky-light); padding-left:12px; margin:0; }
.quote-source { font-size:.7rem; color:var(--text-dim); margin-top:8px; letter-spacing:.5px; text-align:right;}

/* ─── MAIN CONTENT ─────────────────────────────── */
.main-content { min-width:0; }
.sec-label { display:inline-block; font-size:.7rem; letter-spacing:2.5px; text-transform:uppercase; color:var(--sky); border:1px solid var(--sky-light); border-radius:var(--r-pill); padding:3px 14px; margin-bottom:12px; background:var(--sky-pale); }
.sec-title { font-family:'Merriweather',serif; font-weight:700; font-size:clamp(1.25rem,3vw,1.7rem); color:var(--sky-dark); margin-bottom:6px; text-align:left; }
.sec-sub { font-size:.86rem; color:var(--text-mid); font-style:italic; margin-bottom:26px; }

/* ─── NOTICE / LƯU Ý ────────────────────────────── */
.notice-section { margin-bottom:44px; }
.notice-container { background:#fff; border:1px solid rgba(186,230,253,.5); border-radius:var(--r-lg); overflow:hidden; box-shadow:var(--sh-soft); }
.notice-big-title { text-align:center; padding:28px 24px 16px; background:linear-gradient(180deg,#deeffe 0%,#f5faff 100%); border-bottom:1px solid rgba(186,230,253,.4); position:relative; overflow:hidden; }
.notice-big-title h2 { font-family:'Merriweather',serif; font-size:clamp(2rem,6vw,3.5rem); font-weight:700; color:var(--sky-dark); letter-spacing:4px; position:relative; z-index:1; line-height:1.1; margin:0; }
.notice-big-title h2 em { font-style:normal; color:var(--sky); }
.notice-big-title p { font-style:italic; color:var(--text-mid); font-size:.84rem; margin-top:6px; position:relative; z-index:1; }

.notice-block { padding:22px 26px; border-bottom:1px solid rgba(186,230,253,.4); position:relative; }
.notice-block:last-child { border-bottom:none; }
.notice-block-header { display:flex; align-items:center; gap:10px; margin-bottom:11px; }
.notice-icon { font-size:1.25rem; flex-shrink:0; }
.notice-block-title { font-family:'Merriweather',serif; font-size:.88rem; color:var(--sky-dark); font-weight:700; letter-spacing:.5px; }
.notice-body { font-size:.88rem; line-height:1.9; color:var(--text-main); text-align:center; max-width:560px; margin:0 auto; font-weight:300; }
.notice-wave { background:linear-gradient(135deg,#e0f2fe,#f0f9ff); padding:22px; text-align:center; border-top:1px solid rgba(186,230,253,.4); }
.notice-wave p { font-family:'Merriweather',serif; font-style:italic; color:var(--sky-dark); font-size:.88rem; line-height:1.7; margin:0; }
.notice-deco { display:flex; justify-content:center; align-items:center; gap:20px; padding:10px 0; opacity:.7; font-size:2rem; letter-spacing:8px; color:var(--sky-light); }

/* ─── FEATURED CARD ─────────────────────────────── */
.featured-card { display:grid; grid-template-columns:120px 1fr; gap:22px; align-items:start; background:#fff; border:1px solid var(--sky-light); border-radius:var(--r-lg); padding:22px; box-shadow:var(--sh-soft); margin-bottom:32px; position:relative; overflow:hidden; }
.featured-card::before { content:''; position:absolute; top:0; left:0; bottom:0; width:4px; background:linear-gradient(to bottom,var(--sky-light),var(--sky)); }
.fc-cover { border-radius:12px; overflow:hidden; aspect-ratio:.65; background:var(--sky-pale); box-shadow:0 6px 18px rgba(2,132,199,.12); }
.fc-cover img { width:100%; height:100%; object-fit:cover; }
.fc-badge { font-size:.63rem; letter-spacing:2px; text-transform:uppercase; color:var(--sky); border:1px solid var(--sky-light); border-radius:var(--r-pill); padding:2px 10px; display:inline-block; margin-bottom:8px; background:var(--sky-pale); }
.fc-title { font-family:'Merriweather',serif; font-size:1.2rem; color:var(--sky-dark); margin-bottom:2px; font-weight:700; text-align:left; }
.fc-desc { font-size:.84rem; line-height:1.8; color:var(--text-mid); margin-bottom:12px; font-weight:300; }
.fc-actions { display:flex; gap:8px; flex-wrap:wrap; }
.fc-btn { padding: 8px 16px; border-radius: 20px; font-size: 0.8rem; font-weight: bold; text-decoration: none; transition: 0.3s; }
.fc-btn-primary { background: var(--sky); color: white; }
.fc-btn-primary:hover { background: var(--sky2); }
.fc-btn-outline { border: 1px solid var(--sky); color: var(--sky); }
.fc-btn-outline:hover { background: var(--sky-pale); }

/* ─── FILTER BAR & STORY GRID ────────────────────────────────── */
.filter-bar { background:#fff; border:1px solid rgba(186,230,253,.4); border-radius:var(--r-lg); padding:14px 16px; display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin-bottom:20px; }
.fl-label { font-size:.7rem; letter-spacing:2px; text-transform:uppercase; color:var(--text-dim); flex-shrink:0; }
.filter-groups { display:flex; flex-wrap:wrap; gap:5px; flex:1; }
.filter-group { display:flex; flex-wrap:wrap; gap:4px; padding:0 8px; border-left:2px solid var(--sky-light); }
.filter-group:first-child { border-left:none; padding-left:0; }
.chip { display:inline-flex; align-items:center; gap:3px; padding:3px 10px; border-radius:var(--r-pill); font-size:.72rem; cursor:pointer; transition:var(--t); border:1.5px solid rgba(186,230,253,.5); background:var(--sky-pale); color:var(--text-mid); user-select:none; white-space:nowrap; }
.chip:hover { background:var(--sky-light); color:var(--sky-dark); }
.chip.active { background:var(--sky); color:#fff; border-color:var(--sky); box-shadow:0 2px 8px rgba(2,132,199,.22); }
.chip-clear { background:transparent; color:var(--text-dim); border-color:rgba(186,230,253,.3); font-size:.7rem; }
.chip-clear:hover { background:#fee2e2; color:#dc2626; border-color:#fca5a5; }
.filter-count { font-size:.7rem; background:var(--sky-pale); color:var(--sky); padding:1px 8px; border-radius:var(--r-pill); border:1px solid var(--sky-light); white-space:nowrap; }

.stories-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(185px,1fr)); gap:16px; margin-bottom:40px; }
.story-card { background:#fff; border:1px solid rgba(186,230,253,.5); border-radius:var(--r-lg); overflow:hidden; box-shadow:var(--sh-soft); transition:var(--t); display:flex; flex-direction:column; position:relative; }
.story-card:hover { transform:translateY(-5px); box-shadow:var(--sh-card); border-color:var(--sky-light); }
.story-card.hidden { display:none; }
.sc-cover { width:100%; padding-top:150%; position:relative; overflow:hidden; background:linear-gradient(135deg,var(--sky-pale),rgba(186,230,253,.3)); }
.sc-cover img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform .5s ease; }
.story-card:hover .sc-cover img { transform:scale(1.04); }
.sc-status { position:absolute; top:10px; right:10px; font-size:.6rem; letter-spacing:1.2px; text-transform:uppercase; padding:2px 8px; border-radius:var(--r-pill); backdrop-filter:blur(8px); }
.status-ongoing { background:rgba(2,132,199,.8); color:#fff; }
.status-complete { background:rgba(5,150,105,.8); color:#fff; }
.status-upcoming { background:rgba(124,58,237,.8); color:#fff; }
.sc-body { padding:13px 13px 11px; flex:1; display:flex; flex-direction:column; }
.sc-shelf { font-size:.63rem; letter-spacing:1.5px; text-transform:uppercase; color:var(--sky); margin-bottom:4px; }
.sc-title { font-family:'Merriweather',serif; font-size:.95rem; font-weight:700; color:var(--sky-dark); margin-bottom:2px; line-height:1.3; text-align:left;}
.sc-meta { font-size:.7rem; color:var(--text-mid); margin-bottom:7px; line-height:1.5; }
.sc-tags { display:flex; flex-wrap:wrap; gap:3px; margin-bottom:9px; }
.sc-tag { padding:2px 7px; border-radius:var(--r-pill); font-size:.63rem; border:1px solid var(--sky-light); color:var(--sky); background:var(--sky-pale); cursor:pointer; transition:var(--t); }
.sc-footer { margin-top:auto; padding-top:9px; border-top:1px solid rgba(186,230,253,.4); display:flex; align-items:center; justify-content:space-between; }
.sc-chapters { font-size:.68rem; color:var(--text-dim); }
.sc-link { font-size:.73rem; color:var(--sky); padding:4px 11px; border:1px solid var(--sky-light); border-radius:var(--r-pill); transition:var(--t); text-decoration:none; }
.sc-link:hover { background:var(--sky-pale); }
.no-results { display:none; text-align:center; padding:50px; color:var(--text-dim); font-style:italic; grid-column:1/-1; }
.no-results.show { display:block; }

/* ─── RECENT UPDATES ────────────────────────────── */
.recent-list { display:flex; flex-direction:column; gap:9px; margin-bottom:40px; }
.recent-item { display:flex; align-items:center; gap:13px; background:#fff; border:1px solid rgba(186,230,253,.4); border-radius:var(--r-md); padding:11px 15px; transition:var(--t); text-decoration:none; }
.recent-item:hover { border-color:var(--sky-light); background:var(--sky-pale); transform:translateX(4px); }
.recent-icon { font-size:1.2rem; flex-shrink:0; }
.ri-body { flex:1; min-width:0; }
.ri-story { font-size:.66rem; letter-spacing:1.5px; text-transform:uppercase; color:var(--sky); margin-bottom:1px; }
.ri-title { font-size:.86rem; color:var(--sky-dark); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.ri-date { font-size:.66rem; color:var(--text-dim); margin-top:1px; }
.recent-arrow { color:var(--sky-light); font-size:.85rem; flex-shrink:0; }

.reveal { opacity:0; transform:translateY(18px); transition:opacity .6s ease,transform .6s ease; }
.reveal.visible { opacity:1; transform:translateY(0); }

@media(max-width:920px) { .page-body{grid-template-columns:1fr;} .sidebar{display:none;} }
</style>

<section class="hero" id="hero">
  <div class="hero-deco">
    <div class="hero-blob"></div><div class="hero-blob"></div><div class="hero-blob"></div>
  </div>
  <div class="hero-inner">
    <div class="hero-eyebrow">⋆✴︎˚｡⋆</div>
    <img src="/dynamic-duo-web/images/namexoanen.png" alt="Dynamic Duo" class="hero-logo" onerror="this.src='/images/namexoanen.png'" />
    <img src="https://i.pinimg.com/564x/42/bd/28/42bd2870420df20c027411604a1130e5.jpg" alt="Avatar Nhà Cá" class="hero-avatar" />
  </div>
</section>

<div class="ticker-wrap">
  <div class="ticker-track">
    <span class="ticker-item">✧ Chào mừng cậu đến với bể cá</span>
    <span class="ticker-item">𓆝 dynamic duo</span>
    <span class="ticker-item">paired dreams, boundless gleam</span>
    <span class="ticker-item">Nếu đêm nay trời không mưa</span>
    <span class="ticker-item">Tôi nghĩ chúng tôi sắp chia tay</span>
    <span class="ticker-item">Quan hệ bạn cùng phòng</span>
    <span class="ticker-item">Hạ cháy đồng hoang</span>
    <span class="ticker-item">✧ Chào mừng cậu đến với bể cá</span>
    <span class="ticker-item">𓆝 dynamic duo</span>
    <span class="ticker-item">paired dreams, boundless gleam</span>
    <span class="ticker-item">Nếu đêm nay trời không mưa</span>
    <span class="ticker-item">Tôi nghĩ chúng tôi sắp chia tay</span>
    <span class="ticker-item">Quan hệ bạn cùng phòng</span>
    <span class="ticker-item">Hạ cháy đồng hoang</span>
  </div>
</div>

<div class="page-body">

  <main class="main-content">

    <section class="notice-section reveal">
      <div class="sec-label">𓆝 lưu ý</div>

      <div class="notice-container">
        <div class="notice-big-title">
          <h2>Dynamic <em>Duo</em></h2>
          <p>𓆝.°• paired dreams, boundless gleam •°.𓆝</p>
        </div>

        <div class="notice-block">
          <div class="notice-block-header">
            <span class="notice-icon">🪸</span>
            <span class="notice-block-title">Về bể cá</span>
          </div>
          <p class="notice-body">
            Nhà có <strong>hai người</strong>, dễ tính và thoải mái về xưng hô. Chúng mình vô cùng hoan nghênh những lời góp ý để hoàn thiện hơn, nhưng trái tim mong manh, mong cậu ghé qua đừng buông lời nặng nề •ᴗ•
          </p>
          <div class="notice-deco">🐟 🐡 🐠 🫧</div>
        </div>

        <div class="notice-block">
          <div class="notice-block-header">
            <span class="notice-icon">📚</span>
            <span class="notice-block-title">Về gu truyện trong nhà</span>
          </div>
          <p class="notice-body">
            Truyện được chọn hoàn toàn theo gu của chúng mình. Đa số sẽ có <strong>thủy tinh</strong> và các tình tiết <strong>drama cũ rích</strong>, không phù hợp với <strong>tất cả mọi người</strong>.<br>
            Chúng mình sẽ cố gắng <strong>cảnh báo</strong> trước, tuy nhiên sẽ có một số trường hợp đặc biệt, chúng mình cũng sẽ báo trước. Các cậu nhớ đọc kỹ lưu ý trước khi quyết định nhảy hố nha.
          </p>
          <div class="notice-deco">🌿 🪸 🌿</div>
        </div>

        <div class="notice-block">
          <div class="notice-block-header">
            <span class="notice-icon">⚠️</span>
            <span class="notice-block-title">Về bản edit</span>
          </div>
          <p class="notice-body">
            Chúng mình đang chập chững học tiếng Trung, các bản edit có dùng các <strong>công cụ hỗ trợ</strong>. Do đó, độ chính xác không thể cam đoan 100% so với bản gốc. Nhưng chúng mình sẽ luôn cố gắng trau chuốt câu chữ mượt mà nhất có thể, đừng quên góp ý về lỗi chính tả nữa nhé!
          </p>
        </div>

        <div class="notice-block">
          <div class="notice-block-header">
            <span class="notice-icon">🌊</span>
            <span class="notice-block-title">Về lịch đăng</span>
          </div>
