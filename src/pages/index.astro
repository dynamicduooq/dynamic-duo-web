<script is:inline>
/* ══ HELPERS ══ */
function esc(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function timeAgo(ts){
  if(!ts) return '';
  const d=Date.now()-ts;
  if(d<60000) return 'vừa xong';
  if(d<3600000) return Math.floor(d/60000)+' phút trước';
  if(d<86400000) return Math.floor(d/3600000)+' giờ trước';
  return Math.floor(d/86400000)+' ngày trước';
}
function pageKey(){
  return location.pathname.replace(/[^a-zA-Z0-9]/g,'_').replace(/^_+|_+$/g,'').substring(0,120);
}
function getStoryId() {
  const parts = location.pathname.split('/').filter(Boolean);
  return parts.length >= 2 ? parts[1] : 'unknown';
}
function avatarLetter(name){ return (name||'K').trim().charAt(0).toUpperCase(); }
function getMyToken(){
  let t = localStorage.getItem('dd_token');
  if(!t){ t = Math.random().toString(36).slice(2)+Date.now().toString(36); localStorage.setItem('dd_token',t); }
  return t;
}
function getLiked(id){ try{ return JSON.parse(localStorage.getItem('dd_liked')||'{}')[id]||false; }catch(e){ return false; } }
function setLiked(id,v){ try{ const o=JSON.parse(localStorage.getItem('dd_liked')||'{}'); o[id]=v; localStorage.setItem('dd_liked',JSON.stringify(o)); }catch(e){} }

function getSavedName(){ return localStorage.getItem('dd_commenter_name') || ''; }
function saveName(name){ if(name && name.trim()) localStorage.setItem('dd_commenter_name', name.trim()); }

/* ══ XỬ LÝ NÚT GOM TRÊN MOBILE (FAB) ══ */
document.addEventListener('DOMContentLoaded', () => {
  const fabTrigger = document.getElementById('fabTrigger');
  const fabActions = document.getElementById('fabActions');
  const fabContainer = document.getElementById('fabContainer');
  
  if(fabTrigger && fabActions) {
    fabTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      fabActions.classList.toggle('show');
      fabTrigger.classList.toggle('active');
    });
    document.addEventListener('click', (e) => {
      if(fabContainer && !fabContainer.contains(e.target)) {
         fabActions.classList.remove('show');
         fabTrigger.classList.remove('active');
      }
    });
  }
});

/* CÀI ĐẶT ĐỌC TRUYỆN, PHÍM TẮT, LỊCH SỬ & CHỐNG COPY */
document.addEventListener('DOMContentLoaded', () => {
  const root = document.documentElement;
  let fz = parseInt(localStorage.getItem('dd_fz') || '18');
  let ff = localStorage.getItem('dd_ff') || "'Newsreader', serif";
  
  const novelContent = document.querySelector('.novel-content');
  if(novelContent) {
     localStorage.setItem('dd_last_read_url', window.location.pathname);
     localStorage.setItem('dd_last_read_title', document.title.split('|')[0].trim());
  }
  
  const btn = document.getElementById('readSettingsBtn');
  const pop = document.getElementById('rsPopup');
  
  if(btn && pop) {
    btn.addEventListener('click', e => { 
        e.stopPropagation(); 
        pop.classList.toggle('open'); 
        document.getElementById('statsPopup')?.classList.remove('open'); 
        document.getElementById('reviewPopup')?.classList.remove('open'); 
    });
    document.addEventListener('click', e => { 
        if(!pop.contains(e.target) && e.target !== btn) pop.classList.remove('open'); 
    });

    document.getElementById('rsDec').addEventListener('click', () => { if(fz > 12) { fz-=1; root.style.setProperty('--read-fz', fz + 'px'); localStorage.setItem('dd_fz', fz); } });
    document.getElementById('rsInc').addEventListener('click', () => { if(fz < 30) { fz+=1; root.style.setProperty('--read-fz', fz + 'px'); localStorage.setItem('dd_fz', fz); } });

    const fontBtns = pop.querySelectorAll('[data-font]');
    fontBtns.forEach(fb => {
      if(fb.dataset.font === ff) { fontBtns.forEach(b=>b.classList.remove('active')); fb.classList.add('active'); }
      fb.addEventListener('click', () => {
        ff = fb.dataset.font;
        root.style.setProperty('--read-ff', ff);
        localStorage.setItem('dd_ff', ff);
        fontBtns.forEach(b=>b.classList.remove('active'));
        fb.classList.add('active');
      });
    });
  }

  // Keyboard shortcuts & Anti-copy
  if(novelContent) {
    document.addEventListener('contextmenu', e => e.preventDefault());
    document.addEventListener('copy', e => e.preventDefault());

    document.addEventListener('keydown', e => {
      if(!document.activeElement || !['INPUT','TEXTAREA'].includes(document.activeElement.tagName)) {
        if(e.key === 'ArrowLeft') { 
          const p = document.querySelector('.chap-nav-row a.chap-pn:first-child'); 
          if(p && !p.classList.contains('disabled')) window.location.href = p.href; 
        }
        if(e.key === 'ArrowRight') { 
          const n = document.querySelector('.chap-nav-row a.chap-pn:last-child'); 
          if(n && !n.classList.contains('disabled')) window.location.href = n.href; 
        }
      }
      
      if (e.ctrlKey && (e.key === 'p' || e.key === 's' || e.key === 'c' || e.key === 'u')) {
        e.preventDefault();
      }
    });
  }
});

/* Admin name constant */
const ADMIN_DISPLAY_NAME = 'dynamic duo 𓆝';

function waitFirebase(cb){
  if(window.__ddFirebase?.db){ cb(window.__ddFirebase); return; }
  window.addEventListener('dd-firebase-ready',()=>{ if(window.__ddFirebase?.db) cb(window.__ddFirebase); },{once:true});
  let n=0; const t=setInterval(()=>{ if(window.__ddFirebase?.db){clearInterval(t);cb(window.__ddFirebase);} if(++n>60) clearInterval(t); },200);
}

/* ══ LOGIC LƯỢT XEM, LƯỢT THÍCH VÀ ĐÁNH GIÁ ══ */
waitFirebase(({db, ref, get, update, push, onValue}) => {
  const isNovel = document.querySelector('.novel-content') !== null;
  if(!isNovel) return;
  const key = pageKey();
  const storyId = getStoryId();
  const myToken = getMyToken();

  // 1. Logic Tăng Lượt Xem
  const viewRef = ref(db, 'page_views/' + key);
  get(viewRef).then(snap => {
     let views = (snap.val() && snap.val().views) || 0;
     if(!window.__ddIsAdmin) { 
       update(ref(db, 'page_views'), { [key + '/views']: views + 1 }).catch(e => console.log(e));
     }
  });

  // 2. Logic Nút Tim Chương (Like)
  const chapLikeBtn = document.getElementById('chapLikeBtn');
  const chapLikeCount = document.getElementById('chapLikeCount');
  const likeRef = ref(db, 'chapter_likes/' + key);

  if(chapLikeBtn && chapLikeCount) {
     onValue(likeRef, snap => {
         const data = snap.val() || {};
         chapLikeCount.textContent = Object.keys(data).length;
         if(data[myToken]) {
             chapLikeBtn.style.color = '#ef4444';
             chapLikeBtn.style.borderColor = '#fca5a5';
             chapLikeBtn.style.background = 'rgba(239,68,68,0.1)';
             chapLikeBtn.innerHTML = '❤️ Đã thích: <span style="font-weight:bold;">' + Object.keys(data).length + '</span>';
         }
     });

     chapLikeBtn.addEventListener('click', async () => {
         const snap = await get(likeRef);
         const data = snap.val() || {};
         if(!data[myToken]) {
             chapLikeBtn.style.transform = 'scale(1.1)';
             setTimeout(() => chapLikeBtn.style.transform = 'scale(1)', 200);
             update(ref(db, 'chapter_likes'), { [key + '/' + myToken]: Date.now() });
         }
     });
  }

  // 3. Logic Đánh giá truyện (Review)
  const reviewBtn = document.getElementById('novelReviewBtn');
  const reviewPop = document.getElementById('reviewPopup');
  
  if(reviewBtn && reviewPop) {
      let currentRating = 0;
      const stars = reviewPop.querySelectorAll('.star-btn');
      const rvName = document.getElementById('rvName');
      const rvText = document.getElementById('rvText');
      const rvSubmit = document.getElementById('rvSubmit');
      const rvList = document.getElementById('rvList');
      const rvAvg = document.getElementById('rvAvg');
      
      if(getSavedName()) rvName.value = getSavedName();

      reviewBtn.addEventListener('click', e => { 
          e.stopPropagation(); 
          reviewPop.classList.toggle('open'); 
          document.getElementById('rsPopup')?.classList.remove('open');
          document.getElementById('statsPopup')?.classList.remove('open');
      });
      document.addEventListener('click', e => { if(!reviewPop.contains(e.target) && e.target !== reviewBtn) reviewPop.classList.remove('open'); });

      stars.forEach(s => {
          s.addEventListener('click', () => {
              currentRating = parseInt(s.dataset.val);
              stars.forEach(st => {
                  st.classList.toggle('active', parseInt(st.dataset.val) <= currentRating);
                  st.textContent = parseInt(st.dataset.val) <= currentRating ? '★' : '☆';
              });
          });
      });

      // Load Reviews
      onValue(ref(db, 'novel_reviews/' + storyId), snap => {
          const data = snap.val() || {};
          const items = Object.values(data).sort((a,b) => b.ts - a.ts);
          if(items.length === 0) {
              rvList.innerHTML = '<div style="font-size:.7rem; color:var(--text-dim); text-align:center; font-style:italic;">Chưa có đánh giá nào.</div>';
              rvAvg.textContent = '0.0';
          } else {
              let total = 0;
              rvList.innerHTML = items.map(r => {
                  total += r.rating;
                  let st = '';
                  for(let i=1; i<=5; i++) st += i<=r.rating ? '★' : '☆';
                  return `<div class="rv-item">
                    <div class="rv-header"><span class="rv-name">${esc(r.name)||'Khách'}</span> <span class="rv-stars">${st}</span></div>
                    <div style="font-size:.7rem; color:var(--text-main); margin-bottom:2px;">${esc(r.text)}</div>
                    <div style="font-size:.6rem; color:var(--text-dim); text-align:right;">${timeAgo(r.ts)}</div>
                  </div>`;
              }).join('');
              rvAvg.textContent = (total / items.length).toFixed(1);
          }
      });

      rvSubmit.addEventListener('click', async () => {
          const text = rvText.value.trim();
          if(currentRating === 0) return alert('Bạn chưa chọn số sao đánh giá!');
          if(!text) return alert('Bạn viết thêm chút cảm nhận nhé!');
          rvSubmit.disabled = true;
          const nameVal = (rvName.value||'').trim() || 'Khách vô danh';
          saveName(nameVal);
          try {
              await push(ref(db, 'novel_reviews/' + storyId), {
                  name: nameVal, rating: currentRating, text: text, ts: Date.now(), token: myToken
              });
              rvText.value = '';
              // Reset stars
              currentRating = 0;
              stars.forEach(st => { st.classList.remove('active'); st.textContent = '☆'; });
          } catch(e) { alert('Lỗi: '+e.message); }
          rvSubmit.disabled = false;
      });
  }

  // 4. Bảng Thống kê Admin
  window.addEventListener('dd-auth-change', e => {
    const btn = document.getElementById('adminStatsBtn');
    if(btn) {
      btn.style.display = e.detail.isAdmin ? 'flex' : 'none';
      if(e.detail.isAdmin) btn.classList.add('visible');
    }
  });

  const sBtn = document.getElementById('adminStatsBtn');
  const sPop = document.getElementById('statsPopup');
  
  if(sBtn && sPop) {
    sBtn.addEventListener('click', e => { 
        e.stopPropagation(); 
        sPop.classList.toggle('open'); 
        document.getElementById('rsPopup')?.classList.remove('open');
        document.getElementById('reviewPopup')?.classList.remove('open');
    });
    document.addEventListener('click', e => { if(!sPop.contains(e.target) && e.target !== sBtn) sPop.classList.remove('open'); });
    
    onValue(viewRef, snap => {
       const vEl = document.getElementById('statViews');
       if(vEl) vEl.textContent = (snap.val() && snap.val().views) || 0;
    });

    onValue(ref(db, 'comments/chap_' + key), snap => {
       const data = snap.val() || {};
       let cmtCount = Object.keys(data).length;
       Object.values(data).forEach(c => {
          if(c.replies) cmtCount += Object.keys(c.replies).length;
       });
       const cEl = document.getElementById('statCmts');
       if(cEl) cEl.textContent = cmtCount;
    });

    onValue(likeRef, snap => {
       const data = snap.val() || {};
       const lEl = document.getElementById('statLikes');
       if(lEl) lEl.textContent = Object.keys(data).length;
    });
  }
});


/* ══ SCROLL + PROGRESS ══ */
const _st=document.getElementById('scrollTop'),_sb=document.getElementById('scrollBot'),_rp=document.getElementById('read-progress');
if(_st) _st.addEventListener('click',()=>window.scrollTo({top:0,behavior:'smooth'}));
if(_sb) _sb.addEventListener('click',()=>window.scrollTo({top:document.body.scrollHeight,behavior:'smooth'}));
function updScroll(){
  const y=window.scrollY, max=Math.max(1,document.body.scrollHeight-window.innerHeight), p=y/max;
  if(_st) _st.classList.toggle('show',y>300);
  if(_sb) _sb.classList.toggle('show',p<.97&&max>100);
  if(_rp) _rp.style.width=(p*100)+'%';
}
window.addEventListener('scroll',updScroll,{passive:true});
requestAnimationFrame(()=>setTimeout(updScroll,200));

/* ══ HAMBURGER ══ */
document.getElementById('hamburger')?.addEventListener('click',()=>document.getElementById('mobileMenu')?.classList.toggle('open'));
document.addEventListener('click',e=>{
  const mm=document.getElementById('mobileMenu'),hb=document.getElementById('hamburger');
  if(mm?.classList.contains('open')&&!mm.contains(e.target)&&!hb?.contains(e.target)) mm.classList.remove('open');
