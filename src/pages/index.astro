<!-- TẤT CẢ CÁC NÚT ĐƯỢC GOM VÀO MỘT KHỐI FAB CHO GỌN -->
<style is:global>
  .fab-container { position:fixed; bottom:24px; right:22px; z-index:400; display:flex; flex-direction:column; align-items:flex-end; gap:8px; pointer-events:none; }
  .fab-actions { display:flex; flex-direction:column; gap:8px; pointer-events:none; }
  /* Làm các nút mờ mờ để không cản trở việc đọc */
  .scroll-btn { width:40px; height:40px; border-radius:50%; background:rgba(14,165,233,0.4); backdrop-filter:blur(4px); color:#fff; border:none; cursor:pointer; font-size:1.1rem; box-shadow:0 4px 10px rgba(0,0,0,0.1); transition:all .3s ease; display:flex; align-items:center; justify-content:center; opacity:0; pointer-events:none; border: 1px solid rgba(255,255,255,0.2);}
  [data-theme="dark"] .scroll-btn { background: rgba(126,200,227,.2); border-color: rgba(126,200,227,.1);}
  .scroll-btn.show { opacity:1; pointer-events:auto; }
  .scroll-btn:hover { background:var(--sky) !important; transform:scale(1.1); box-shadow:0 6px 15px rgba(2,132,199,.4); opacity: 1 !important;}
  [data-theme="dark"] .scroll-btn:hover { background: #1e4a6a !important;}
  
  .fab-trigger { width:44px; height:44px; border-radius:50%; background:rgba(100,116,139,0.3); backdrop-filter:blur(4px); color:#fff; border:1px solid rgba(255,255,255,0.2); cursor:pointer; font-size:1.4rem; display:none; align-items:center; justify-content:center; pointer-events:auto; transition:all .2s; box-shadow:0 4px 10px rgba(0,0,0,0.1);}
  .fab-trigger:hover, .fab-trigger.active { background:rgba(100,116,139,0.7); transform: scale(1.1);}
  [data-theme="dark"] .fab-trigger { background:rgba(255,255,255,.1); border-color: rgba(255,255,255,.05);}

  /* PC: Hiện bình thường, ẩn nút gom */
  @media(min-width: 769px) {
    .fab-actions { opacity: 1 !important; transform: none !important; pointer-events: auto; }
  }
  /* Mobile: Ẩn các nút con, hiện nút gom */
  @media(max-width: 768px) {
    .fab-trigger { display: flex; }
    .fab-actions { opacity: 0; transform: translateY(20px); transition: all 0.3s ease; }
    .fab-actions.show { opacity: 1; transform: translateY(0); pointer-events: auto; }
  }
</style>

