---
import Layout from '../layouts/Layout.astro';
import settings from '../data/settings.json';
---

<Layout title="Trang chủ">

    <style>
        /* ══════════════════════════════════════════
           HERO
        ══════════════════════════════════════════ */
        .hero {
            position: relative; overflow: hidden;
            padding: 60px 20px 40px;
            text-align: center;
        }
        .hero-eyebrow { font-size: 1.5rem; letter-spacing: 8px; color: var(--sky-light); margin-bottom: 12px; }
        .hero-tag {
            font-family: 'Literata', serif; font-style: italic;
            font-size: 1rem; color: var(--text-mid); margin: 16px 0 24px; letter-spacing: .5px;
        }
        .hero-div { display: flex; align-items: center; gap: 12px; justify-content: center; margin: 24px auto; max-width: 320px; }
        .hero-div hr { flex: 1; border: none; border-top: 1px dashed var(--sky-light); }
        .hero-div span { color: var(--sky-light); font-size: 1.1rem; }
        .hero-desc { color: var(--text-mid); font-size: .96rem; max-width: 500px; margin: 0 auto 28px; line-height: 1.8; text-align: center; }
        .hero-cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

        /* ── Buttons ── */
        .btn { display: inline-flex; align-items: center; gap: 6px; padding: 10px 22px; border-radius: var(--r-pill); font-size: .85rem; font-family: 'Newsreader', serif; transition: var(--t); cursor: pointer; border: none; }
        .btn-primary { background: var(--sky); color: #fff; box-shadow: 0 4px 12px rgba(14,165,233,.3); }
        .btn-primary:hover { background: var(--sky2); transform: translateY(-2px); }
        .btn-ghost { background: transparent; color: var(--sky); border: 1.5px solid var(--sky); }
        .btn-ghost:hover { background: var(--sky-pale); }

        /* ══════════════════════════════════════════
           TICKER
        ══════════════════════════════════════════ */
        .ticker-wrap {
            overflow: hidden; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
            padding: 9px 0; background: var(--sky-pale); margin-bottom: 0;
        }
        .ticker-track { display: flex; gap: 48px; animation: ticker 28s linear infinite; white-space: nowrap; width: max-content; }
        .ticker-item { font-size: .72rem; color: var(--sky); letter-spacing: 2px; text-transform: uppercase; }
        @keyframes ticker { from { transform: translateX(0); } to { transform: translateX(-50%); } }

        /* ══════════════════════════════════════════
           PAGE BODY — 2 CỘT, WIDTH RỘNG
        ══════════════════════════════════════════ */
        .page-body {
            width: 94%; max-width: 1480px;
            margin: 0 auto; padding: 48px 0 80px;
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 40px; align-items: start;
        }

        /* ── Sections ── */
        .main-content { min-width: 0; }
        .sec-label { font-size: .62rem; letter-spacing: 3px; text-transform: uppercase; color: var(--sky); margin-bottom: 4px; }
        .sec-title { font-family: 'Merriweather', serif; font-size: 1.35rem; color: var(--sky-dark); margin: 0 0 4px; text-align: left; }
        .sec-sub { font-size: .82rem; color: var(--text-dim); font-style: italic; margin: 0 0 22px; }
        section { margin-bottom: 56px; }

        /* ── Reveal animation ── */
        .reveal { opacity: 0; transform: translateY(18px); transition: opacity .5s ease, transform .5s ease; }
        .reveal.visible { opacity: 1; transform: translateY(0); }

        /* ══════════════════════════════════════════
           NOTICE SECTION
        ══════════════════════════════════════════ */
        .notice-container { border: 1.5px solid var(--border); border-radius: var(--r-lg); overflow: hidden; }
        .notice-big-title { background: var(--sky-pale); padding: 24px; text-align: center; border-bottom: 1px solid var(--border); }
        .notice-big-title h2 { margin: 0 0 4px; font-size: 1.4rem; color: var(--sky-dark); text-align: center; }
        .notice-big-title p { margin: 0; font-size: .8rem; color: var(--text-dim); font-style: italic; }
        .notice-block { padding: 20px 24px; border-bottom: 1px dashed var(--border); }
        .notice-block:last-of-type { border-bottom: none; }
        .notice-block-header { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
        .notice-icon { font-size: 1rem; }
        .notice-block-title { font-family: 'Merriweather', serif; font-size: .9rem; font-weight: 700; color: var(--sky-dark); }
        .notice-body { margin: 0; font-size: .88rem; color: var(--text-mid); line-height: 1.75; text-align: left; }
        .notice-deco { text-align: center; font-size: 1.2rem; margin-top: 10px; letter-spacing: 8px; }
        .notice-wave { background: var(--sky-pale); padding: 20px 24px; text-align: center; }
        .notice-wave p { margin: 0; font-size: .88rem; color: var(--text-mid); font-style: italic; line-height: 1.8; }

        /* ══════════════════════════════════════════
           FEATURED CARD
        ══════════════════════════════════════════ */
        .featured-card {
            display: grid; grid-template-columns: 180px 1fr; gap: 24px;
            background: var(--bg-content); border: 1.5px solid var(--border);
            border-radius: var(--r-lg); overflow: hidden; padding: 0;
        }
        .fc-cover { height: 220px; overflow: hidden; }
        .fc-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .featured-card > div:last-child { padding: 22px 20px 22px 0; display: flex; flex-direction: column; justify-content: center; }
        .fc-badge { font-size: .65rem; letter-spacing: 2px; text-transform: uppercase; color: var(--sky); font-family: 'Newsreader', serif; }
        .fc-title { font-family: 'Merriweather', serif; font-size: 1.1rem; color: var(--sky-dark); margin: 6px 0 3px; text-align: left; }
        .fc-zh { font-size: .78rem; color: var(--text-dim); font-style: italic; margin-bottom: 8px; }
        .fc-desc { font-size: .85rem; color: var(--text-mid); line-height: 1.65; margin-bottom: 10px; }
        .fc-meta { font-size: .72rem; color: var(--text-dim); margin-bottom: 14px; }
        .fc-actions { display: flex; gap: 8px; }

        /* ══════════════════════════════════════════
           FILTER BAR — HÀNG NGANG
        ══════════════════════════════════════════ */
        .filter-bar {
            display: flex; flex-wrap: wrap; align-items: center;
            gap: 8px; margin-bottom: 24px;
            padding: 14px 18px;
            background: var(--sky-pale); border: 1px solid var(--border);
            border-radius: var(--r-lg);
        }
        .fl-label {
            font-size: .68rem; letter-spacing: 2px; text-transform: uppercase;
            color: var(--text-dim); white-space: nowrap; margin-right: 4px;
        }
        .filter-groups {
            display: flex; flex-wrap: wrap; gap: 6px; align-items: center; flex: 1;
        }
        /* Separator nhỏ giữa các nhóm */
        .filter-groups .filter-sep {
            width: 1px; height: 18px; background: var(--border); margin: 0 2px;
        }
        .chip {
            display: inline-flex; align-items: center; gap: 4px;
            padding: 5px 14px; border-radius: var(--r-pill);
            font-size: .78rem; font-family: 'Newsreader', serif;
            border: 1.5px solid var(--border); background: var(--bg-content);
            color: var(--text-mid); cursor: pointer; transition: var(--t);
            white-space: nowrap; user-select: none;
        }
        .chip:hover { border-color: var(--sky); color: var(--sky); background: var(--sky-pale); }
        .chip.active { background: var(--sky); border-color: var(--sky); color: #fff; }
        .chip-clear { border-style: dashed; color: var(--text-dim); font-size: .72rem; }
        .chip-clear:hover { border-color: #ef4444; color: #ef4444; background: #fff5f5; }
        .filter-count { font-size: .72rem; color: var(--text-dim); margin-left: auto; white-space: nowrap; }

        /* ══════════════════════════════════════════
           STORIES GRID — COMPACT
        ══════════════════════════════════════════ */
        .stories-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 20px;
        }
        .story-card { background: var(--bg-content); border: 1px solid var(--border); border-radius: var(--r-lg); overflow: hidden; transition: var(--t); }
        .story-card:hover { box-shadow: var(--sh-card); transform: translateY(-3px); border-color: var(--sky-light); }
        .story-card.hidden { display: none; }
        .sc-cover { position: relative; height: 160px; overflow: hidden; }
        .sc-cover img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s ease; }
        .story-card:hover .sc-cover img { transform: scale(1.04); }
        .sc-status { position: absolute; top: 8px; right: 8px; font-size: .62rem; padding: 3px 8px; border-radius: var(--r-pill); font-weight: 700; letter-spacing: .5px; }
        .status-ongoing { background: #fef3c7; color: #92400e; }
        .status-complete { background: #d1fae5; color: #065f46; }
        .status-upcoming { background: #ede9fe; color: #5b21b6; }
        .sc-body { padding: 14px; }
        .sc-shelf { font-size: .62rem; color: var(--sky); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 4px; }
        .sc-title { font-family: 'Merriweather', serif; font-size: .88rem; color: var(--sky-dark); margin: 0 0 5px; line-height: 1.45; text-align: left; }
        .sc-meta { font-size: .72rem; color: var(--text-dim); margin-bottom: 8px; line-height: 1.4; }
        .sc-tags { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 10px; }
        .sc-tag { font-size: .68rem; padding: 2px 8px; border-radius: var(--r-pill); background: var(--sky-pale); color: var(--sky); cursor: pointer; transition: var(--t); }
        .sc-tag:hover { background: var(--sky-light); color: #fff; }
        .sc-footer { display: flex; align-items: center; justify-content: space-between; padding-top: 8px; border-top: 1px dashed var(--border); }
        .sc-chapters { font-size: .7rem; color: var(--text-dim); }
        .sc-link { font-size: .75rem; color: var(--sky); font-weight: 700; transition: var(--t); }
        .sc-link:hover { color: var(--sky2); }
        .no-results { grid-column: 1 / -1; text-align: center; color: var(--text-dim); font-style: italic; padding: 30px; display: none; }
        .no-results.show { display: block; }

        /* ══════════════════════════════════════════
           RECENT LIST
        ══════════════════════════════════════════ */
        .recent-list { display: flex; flex-direction: column; gap: 10px; }
        .recent-item { display: flex; align-items: center; gap: 14px; padding: 13px 16px; background: var(--bg-content); border: 1px solid var(--border); border-radius: var(--r-md); transition: var(--t); }
        .recent-item:hover { border-color: var(--sky); background: var(--sky-pale); transform: translateX(3px); }
        .recent-icon { font-size: 1.2rem; flex-shrink: 0; }
        .ri-body { flex: 1; min-width: 0; }
        .ri-story { font-size: .72rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 1px; }
        .ri-title { font-size: .9rem; color: var(--sky-dark); font-family: 'Merriweather', serif; margin-top: 2px; }
        .recent-arrow { color: var(--sky-light); font-size: 1rem; flex-shrink: 0; }

        /* ══════════════════════════════════════════
           SIDEBAR — CỘT PHẢI
        ══════════════════════════════════════════ */
        .sidebar { position: sticky; top: 72px; display: flex; flex-direction: column; gap: 16px; }
        .widget {
            background: var(--bg-content); border: 1px solid var(--border);
            border-radius: var(--r-lg); padding: 18px 16px;
        }
        .widget-title {
            font-family: 'Merriweather', serif; font-size: .82rem;
            color: var(--sky-dark); margin: 0 0 8px; text-align: center;
        }
        .widget-divider { text-align: center; color: var(--sky-light); font-size: .75rem; margin-bottom: 10px; letter-spacing: 4px; }

        /* Profile */
        .profile-widget { text-align: center; }
        .profile-avatar { width: 72px; height: 72px; border-radius: 50%; overflow: hidden; border: 3px solid var(--sky-light); margin: 0 auto 10px; }
        .profile-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .profile-name { font-family: 'Merriweather', serif; font-size: .9rem; color: var(--sky-dark); font-weight: 700; }
        .profile-tagline { font-size: .75rem; color: var(--text-dim); font-style: italic; margin: 4px 0 0; }
        .profile-deco { font-size: .8rem; color: var(--sky-light); letter-spacing: 4px; margin-top: 8px; }

        /* Tag cloud sidebar */
        .tag-cloud { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; }
        .tag-cloud a { font-size: .72rem; padding: 4px 10px; border-radius: var(--r-pill); background: var(--sky-pale); color: var(--sky); border: 1px solid var(--border); cursor: pointer; transition: var(--t); }
        .tag-cloud a:hover { background: var(--sky-light); color: #fff; border-color: var(--sky-light); }

        /* Now playing */
        .now-playing { display: flex; align-items: center; gap: 12px; }
        .vinyl { width: 48px; height: 48px; border-radius: 50%; overflow: hidden; flex-shrink: 0; border: 2px solid var(--sky-light); }
        .vinyl img { width: 100%; height: 100%; object-fit: cover; }
        .np-label { font-size: .62rem; letter-spacing: 2px; text-transform: uppercase; color: var(--sky); }
        .np-song { font-size: .8rem; color: var(--text-mid); font-style: italic; margin-top: 2px; }

        /* Calendar */
        .cal-header { text-align: center; font-size: .78rem; font-weight: 700; color: var(--sky-dark); margin-bottom: 8px; letter-spacing: 1px; }
        .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
        .cal-day-header { text-align: center; font-size: .6rem; color: var(--text-dim); font-weight: 700; padding: 2px 0; letter-spacing: .5px; }
        .cal-day { text-align: center; font-size: .7rem; color: var(--text-mid); padding: 4px 2px; border-radius: 4px; line-height: 1.2; }
        .cal-day.empty { }
        .cal-day.today { background: var(--sky); color: #fff; font-weight: 700; border-radius: 50%; }
        .cal-day.has-post { background: var(--sky-pale); color: var(--sky); font-weight: 700; border: 1px solid var(--sky-light); border-radius: 50%; }

        /* Quote */
        .quote-widget blockquote { font-size: .8rem; font-style: italic; color: var(--text-mid); border-left: 2px solid var(--sky-light); padding: 8px 12px; margin: 0 0 8px; background: var(--sky-pale); border-radius: 0 8px 8px 0; text-align: left; }
        .quote-source { font-size: .7rem; color: var(--text-dim); text-align: right; }
    </style>

    <section class="hero" id="hero">
        <div class="hero-eyebrow">⋆✴︎˚｡⋆</div>
        <img src="/dynamic-duo-web/images/namexoanen.png" alt="Dynamic Duo"
             style="max-width:100%;width:420px;margin:0 auto 16px;display:block;filter:drop-shadow(0 4px 6px rgba(0,0,0,0.1));"
             onerror="this.src='/images/namexoanen.png'">
        <img src="https://i.pinimg.com/564x/42/bd/28/42bd2870420df20c027411604a1130e5.jpg" alt="Avatar"
             style="width:120px;height:120px;border-radius:50%;border:4px solid white;box-shadow:0 8px 20px rgba(2,132,199,0.2);object-fit:cover;margin:0 auto 20px;display:block;">
        <p class="hero-tag">𓆝.°• paired dreams, boundless gleam.</p>
        <div class="hero-div"><hr><span>𓆝.°•</span><hr></div>
        <p class="hero-desc">Ở đây chúng mình có hai người, và chúng mình có những câu chuyện tình yêu sâu sắc <em style="color:var(--text-mid)">(cũ rích)</em>.</p>
        <div class="hero-cta">
            <a href="/dynamic-duo-web/ca-tren-ban" class="btn btn-primary">🐠 Xem truyện</a>
            <a href="/dynamic-duo-web/about" class="btn btn-ghost">Về chúng mình →</a>
        </div>
    </section>

    <div class="ticker-wrap">
        <div class="ticker-track">
            <span class="ticker-item">✧ Chào mừng cậu đến với bể cá</span>
            <span class="ticker-item">𓆝 dynamic duo</span>
            <span class="ticker-item">paired dreams, boundless gleam</span>
            <span class="ticker-item">Nếu đêm nay trời không mưa</span>
            <span class="ticker-item">Tôi nghĩ chúng tôi sắp chia tay</span>
            <span class="ticker-item">Quan hệ bạn cùng phòng</span>
            <span class="ticker-item">Hạ cháy đồng hoang</span>
            <span class="ticker-item">✧ Chào mừng cậu đến với bể cá</span>
            <span class="ticker-item">𓆝 dynamic duo</span>
            <span class="ticker-item">paired dreams, boundless gleam</span>
        </div>
    </div>

    <div class="page-body">
        <main class="main-content">

            <!-- NOTICE -->
            <section class="notice-section reveal">
                <div class="sec-label">𓆝 lưu ý</div>
                <div class="notice-container">
                    <div class="notice-big-title">
                        <h2>Dynamic <em>Duo</em></h2>
                        <p>𓆝.°• paired dreams, boundless gleam •°.𓆝</p>
                    </div>
                    <div class="notice-block">
                        <div class="notice-block-header"><span class="notice-icon">🪸</span><span class="notice-block-title">Về bể cá</span></div>
                        <p class="notice-body">Nhà có <strong>hai người</strong>, để tính và thoải mái về xưng hô. Chúng mình vô cùng hoan nghênh những lời góp ý để hoàn thiện hơn, nhưng trái tim mong manh, mong cậu ghé qua đừng buông lời nặng nề •ᴗ•</p>
                        <div class="notice-deco">🐟 🐡 🐠 🫧</div>
                    </div>
                    <div class="notice-block">
                        <div class="notice-block-header"><span class="notice-icon">📚</span><span class="notice-block-title">Về gu truyện trong nhà</span></div>
                        <p class="notice-body">Truyện được chọn hoàn toàn theo gu của chúng mình. Đa số sẽ có <strong>thủy tinh</strong> và các tình tiết <strong>drama cũ rích</strong>, không phù hợp với <strong>tất cả mọi người</strong>.<br>Chúng mình sẽ cố gắng <strong>cảnh báo</strong> trước.</p>
                        <div class="notice-deco">🌿 🪸 🌿</div>
                    </div>
                    <div class="notice-block">
                        <div class="notice-block-header"><span class="notice-icon">⚠️</span><span class="notice-block-title">Về bản edit</span></div>
                        <p class="notice-body">Chúng mình đang chập chững học tiếng Trung, các bản edit có dùng các <strong>công cụ hỗ trợ</strong>. Do đó, độ chính xác không thể cam đoan 100% so với bản gốc. Nhưng chúng mình sẽ luôn cố gắng trau chuốt câu chữ mượt mà nhất có thể.</p>
                    </div>
                    <div class="notice-block">
                        <div class="notice-block-header"><span class="notice-icon">🌊</span><span class="notice-block-title">Về lịch đăng</span></div>
                        <p class="notice-body">Hiện nhà <strong>chưa có lịch up truyện</strong> cố định, nhưng chúng mình sẽ cố gắng duy trì tiến độ đều đặn nhất.<br>Tuy nhiên, <strong>tần suất đăng truyện</strong> có thể thay đổi linh hoạt.</p>
                        <div class="notice-deco">⚓ 🦈 🐋</div>
                    </div>
                    <div class="notice-wave"><p>Chào mừng các cậu ghé chơi.<br>Mong rằng cậu sẽ để lại góc nhỏ này thật nhiều bông hoa rực rỡ... ᗒ᳨ᗕ</p></div>
                </div>
            </section>

            <!-- FEATURED -->
            <section class="reveal">
                <div class="sec-label">✦ nổi bật</div>
                <h2 class="sec-title">Truyện được ghim</h2>
                <div class="featured-card">
                    <div class="fc-cover">
                        <img src="/dynamic-duo-web/images/biandntkm.png" alt="Nếu đêm nay trời không mưa">
                    </div>
                    <div>
                        <span class="fc-badge">✧ Editor's pick</span>
                        <h3 class="fc-title">Nếu đêm nay trời không mưa</h3>
                        <div class="fc-zh">(如果今夜不下雨)</div>
                        <p class="fc-desc">Một câu chuyện về tình yêu, sự mất mát và những điều còn lại sau cơn mưa...</p>
                        <div class="fc-meta">⋆ Tam Đạo &nbsp;|&nbsp; Editor: Dynamic Duo &nbsp;|&nbsp; 74 chương + NT</div>
                        <div class="fc-actions">
                            <a href="/dynamic-duo-web/ca-tren-ban/neu-dem-nay-troi-khong-mua" class="btn btn-primary" style="font-size:.78rem;padding:8px 16px">Đọc truyện →</a>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ALL STORIES -->
            <section class="reveal">
                <div class="sec-label">𓆝 bể cá</div>
                <h2 class="sec-title">Tất cả truyện</h2>
                <p class="sec-sub">tất cả những chú cá của chúng mình</p>

                <!-- FILTER BAR HÀNG NGANG -->
                <div class="filter-bar">
                    <span class="fl-label">Lọc:</span>
                    <div class="filter-groups">
                        <span class="chip" data-f="duoi-nuoc" onclick="toggleChip(this)">🐠 Cá dưới nước</span>
                        <span class="chip" data-f="tren-ban" onclick="toggleChip(this)">🍽️ Cá trên bàn</span>
                        <span class="chip" data-f="tren-troi" onclick="toggleChip(this)">☁️ Cá trên trời</span>
                        <span class="filter-sep"></span>
                        <span class="chip" data-f="nien-ha" onclick="toggleChip(this)"># Niên hạ</span>
                        <span class="chip" data-f="nien-thuong" onclick="toggleChip(this)"># Niên thượng</span>
                        <span class="filter-sep"></span>
                        <span class="chip" data-f="dam-thuy-tinh" onclick="toggleChip(this)">💧 Dằm</span>
                        <span class="chip" data-f="manh-thuy-tinh" onclick="toggleChip(this)">🔷 Mảnh</span>
