<script is:inline>
/* ─── FILTER ─── */
const allCards  = document.querySelectorAll('.sc');
const chips     = document.querySelectorAll('#filterChips .chip');
const flCount   = document.getElementById('flCount');
const chipClear = document.getElementById('chipClear');
let activeTags = new Set();
let activeCat  = null;

function updateClearBtn() {
  if (chipClear) chipClear.style.display = (activeTags.size > 0 || activeCat !== null) ? 'inline-flex' : 'none';
}
function applyFilter() {
  let vis = 0;
  allCards.forEach(card => {
    const cCat  = card.dataset.cat || '';
    const cTags = (card.dataset.tags || '').split(',').map(t => t.trim().toLowerCase());
    const catOk = activeCat === null || cCat === activeCat;
    const tagOk = activeTags.size === 0 || [...activeTags].every(t => cTags.includes(t.toLowerCase()));
    const show = catOk && tagOk;
    card.classList.toggle('hidden', !show);
    if (show) vis++;
  });
  flCount.textContent = vis + ' truyện';
  document.getElementById('noRes')?.classList.toggle('show', vis === 0);
  updateClearBtn();
}
chips.forEach(chip => {
  chip.addEventListener('click', () => {
    if (chip.id === 'chipClear') {
      activeTags.clear(); activeCat = null;
      chips.forEach(c => c.classList.remove('active'));
      document.querySelector('[data-tag="all"]')?.classList.add('active');
      document.querySelectorAll('#tagCloud .tc-btn').forEach(b => b.classList.remove('active'));
      applyFilter(); return;
    }
    if (chip.dataset.tag) {
      const tag = chip.dataset.tag;
      if (tag === 'all') {
        activeTags.clear(); chips.forEach(c => c.dataset.tag && c.classList.remove('active')); chip.classList.add('active');
      } else {
        document.querySelector('[data-tag="all"]')?.classList.remove('active');
        if (activeTags.has(tag)) { activeTags.delete(tag); chip.classList.remove('active'); }
        else { activeTags.add(tag); chip.classList.add('active'); }
        if (activeTags.size === 0) document.querySelector('[data-tag="all"]')?.classList.add('active');
      }
    } else if (chip.dataset.cat) {
      const cat = chip.dataset.cat;
      chips.forEach(c => c.dataset.cat && c.classList.remove('active'));
      activeCat = (activeCat === cat) ? null : cat;
      if (activeCat) chip.classList.add('active');
    }
    applyFilter();
  });
});
document.querySelectorAll('#tagCloud .tc-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const tag = btn.dataset.tag;
    if (activeTags.has(tag)) { activeTags.delete(tag); btn.classList.remove('active'); }
    else { activeTags.add(tag); btn.classList.add('active'); }
    chips.forEach(c => {
      if (c.dataset.tag === tag)   c.classList.toggle('active', activeTags.has(tag));
      if (c.dataset.tag === 'all') c.classList.toggle('active', activeTags.size === 0);
    });
    if (activeTags.size === 0) document.querySelector('[data-tag="all"]')?.classList.add('active');
    applyFilter();
    document.getElementById('storiesGrid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
});

/* ─── REVEAL ─── */
const obs = new IntersectionObserver(es => es.forEach(e => {
  if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); }
}), { threshold: .1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

/* ─── DARK MODE BUTTON ─── */
(function() {
  const btn = document.getElementById('darkBtnIdx');
  if (!btn) return;
  function syncBtn() {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    btn.textContent = isDark ? '☀️ Chế độ sáng' : '🌙 Chế độ tối';
  }
  syncBtn();
  btn.addEventListener('click', () => {
    if (typeof window.__ddToggleTheme === 'function') window.__ddToggleTheme();
    syncBtn();
  });
})();
<script is:inline>
(function setupMessageWidget(){
  /* ── Helpers ── */
  function msgEsc(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function msgTime(ts){
    if(!ts) return '';
    const d = Date.now()-ts;
    if(d<60000) return 'vừa xong';
    if(d<3600000) return Math.floor(d/60000)+' phút trước';
    if(d<86400000) return Math.floor(d/3600000)+' giờ trước';
    return Math.floor(d/86400000)+' ngày trước';
  }
  function getMsgToken(){
    let t = localStorage.getItem('dd_token');
    if(!t){ t = Math.random().toString(36).slice(2)+Date.now().toString(36); localStorage.setItem('dd_token',t); }
    return t;
  }
  const myToken     = getMsgToken();
  const ADMIN_EMAIL = 'dynamicduoo.q@gmail.com';
  let isAdmin       = false;
  window.addEventListener('dd-auth-change', e => {
    isAdmin = e.detail.isAdmin;
    renderPublicMessages(lastPublicData);
  });
 
  /* ── Tab switcher factory ── */
  function setupTabs(tabSelector, panelPrefix){
    document.querySelectorAll(tabSelector).forEach(tab => {
      tab.addEventListener('click', () => {
        const panel = tab.dataset.panel || tab.dataset.popupPanel;
        document.querySelectorAll(tabSelector).forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        // Ẩn tất cả panel trong cùng container
        const container = tab.closest('.msg-popup, .widget');
        container?.querySelectorAll('.msg-panel').forEach(p => p.classList.remove('active'));
        document.getElementById(panelPrefix + (panel.charAt(0).toUpperCase()+panel.slice(1)))?.classList.add('active');
      });
    });
  }
  setupTabs('[data-panel]',       'msgPanel');
  setupTabs('[data-popup-panel]', 'msgPopupPanel');
 
  /* ── Bubble toggle ── */
  const bubbleBtn  = document.getElementById('msgBubbleBtn');
  const popup      = document.getElementById('msgPopup');
  const popupClose = document.getElementById('msgPopupClose');
 
  bubbleBtn?.addEventListener('click', e => {
    e.stopPropagation();
    popup?.classList.toggle('open');
    // Ẩn badge khi mở
    if(popup?.classList.contains('open')){
      const badge = document.getElementById('msgBubbleBadge');
      if(badge){ badge.textContent=''; badge.classList.remove('show'); }
      localStorage.setItem('dd_msg_seen', Date.now());
    }
  });
  popupClose?.addEventListener('click', () => popup?.classList.remove('open'));
  document.addEventListener('click', e => {
    if(popup?.classList.contains('open') && !popup.contains(e.target) && e.target !== bubbleBtn)
      popup.classList.remove('open');
  });
 
  /* ── Firebase: gửi tin nhắn RIÊNG TƯ ── */
  function bindPrivateSend(nameId, textId, sendId, doneId){
    const nameEl = document.getElementById(nameId);
    const textEl = document.getElementById(textId);
    const sendEl = document.getElementById(sendId);
    const doneEl = document.getElementById(doneId);
    if(!sendEl) return;
 
    let bound = false;
    function doSend(){
      const text = (textEl?.value||'').trim();
      if(!text) return;
      sendEl.disabled = true;
 
      function waitFirebaseLocal(cb){
        if(window.__ddFirebase?.db){ cb(window.__ddFirebase); return; }
        const t = setInterval(() => { if(window.__ddFirebase?.db){ clearInterval(t); cb(window.__ddFirebase); } }, 200);
      }
 
      waitFirebaseLocal(async ({db, ref, push}) => {
        try {
          await push(ref(db, 'private_messages'), {
            name  : (nameEl?.value||'').trim() || 'Khách vô danh',
            text,
            ts    : Date.now(),
            token : myToken,
            read  : false
          });
          if(textEl) textEl.value = '';
          if(doneEl){ doneEl.style.display='block'; setTimeout(()=>{ if(doneEl) doneEl.style.display='none'; }, 3000); }
        } catch(e){ alert('Lỗi gửi: '+e.message); }
        sendEl.disabled = false;
      });
    }
 
    sendEl.addEventListener('click', doSend);
    textEl?.addEventListener('keydown', e => { if(e.key==='Enter'&&(e.ctrlKey||e.metaKey)) doSend(); });
  }
 
  bindPrivateSend('msgPrivateName',      'msgPrivateText',      'msgPrivateSend',      'msgPrivateDone');
  bindPrivateSend('msgPopupPrivateName', 'msgPopupPrivateText', 'msgPopupPrivateSend', 'msgPopupPrivateDone');
 
  /* ── Firebase: Public messages ── */
  let lastPublicData = null;
  let publicUnsubDebounce = null;
 
  function renderPublicMessages(data){
    lastPublicData = data;
    const feeds = [
      document.getElementById('msgPublicFeed'),
      document.getElementById('msgPopupPublicFeed')
    ];
    const empty = '<div class="msg-public-empty">Chưa có lời nhắn nào 𓆝</div>';
    if(!data){
      feeds.forEach(f => { if(f) f.innerHTML = empty; });
      return;
    }
    const items = Object.entries(data)
      .map(([id,v]) => ({id,...v}))
      .sort((a,b) => (a.ts||0)-(b.ts||0));
 
    const html = items.map(m => {
      const isMine = m.token === myToken;
      const canDel = isAdmin || isMine;
      return `<div class="msg-pub-item">
        <button class="msg-pub-del ${canDel?'show':''}" data-mid="${msgEsc(m.id)}">✕</button>
        <span class="msg-pub-name">${msgEsc(m.name)||'Khách vô danh'}</span>
        <span class="msg-pub-time">${msgTime(m.ts)}</span>
        <div class="msg-pub-text">${msgEsc(m.text)}</div>
      </div>`;
    }).join('');
 
    feeds.forEach(f => {
      if(!f) return;
      f.innerHTML = html || empty;
      f.scrollTop = f.scrollHeight;
      // Gắn delete buttons
      f.querySelectorAll('.msg-pub-del.show').forEach(btn => {
        btn.addEventListener('click', async () => {
          if(!confirm('Xóa lời nhắn này?')) return;
          if(window.__ddFirebase){
            const {db, ref, remove} = window.__ddFirebase;
            await remove(ref(db, 'public_messages/'+btn.dataset.mid));
          }
        });
      });
    });
 
    // Hiện badge bubble nếu có tin mới
    const lastSeen = parseInt(localStorage.getItem('dd_msg_seen')||'0');
    const newCount = items.filter(m => (m.ts||0) > lastSeen).length;
    const badge = document.getElementById('msgBubbleBadge');
    if(badge && newCount > 0 && !popup?.classList.contains('open')){
      badge.textContent = newCount > 9 ? '9+' : String(newCount);
      badge.classList.add('show');
    } else if(badge){
      badge.classList.remove('show');
    }
  }
 
  function bindPublicSend(nameId, textId, sendId, doneId){
    const nameEl = document.getElementById(nameId);
    const textEl = document.getElementById(textId);
    const sendEl = document.getElementById(sendId);
    const doneEl = document.getElementById(doneId);
    if(!sendEl) return;
 
    function doSend(){
      const text = (textEl?.value||'').trim();
      if(!text) return;
      sendEl.disabled = true;
      function waitFirebaseLocal(cb){
        if(window.__ddFirebase?.db){ cb(window.__ddFirebase); return; }
        const t = setInterval(() => { if(window.__ddFirebase?.db){ clearInterval(t); cb(window.__ddFirebase); } }, 200);
      }
      waitFirebaseLocal(async ({db, ref, push}) => {
        try {
          await push(ref(db, 'public_messages'), {
            name  : (nameEl?.value||'').trim() || 'Khách vô danh',
            text,
            ts    : Date.now(),
            token : myToken
          });
          if(textEl) textEl.value = '';
          if(doneEl){ doneEl.style.display='block'; setTimeout(()=>{ if(doneEl) doneEl.style.display='none'; }, 3000); }
        } catch(e){ alert('Lỗi gửi: '+e.message); }
        sendEl.disabled = false;
      });
    }
    sendEl.addEventListener('click', doSend);
    textEl?.addEventListener('keydown', e => { if(e.key==='Enter'&&(e.ctrlKey||e.metaKey)) doSend(); });
  }
 
  bindPublicSend('msgPublicName',      'msgPublicText',      'msgPublicSend',      'msgPublicDone');
  bindPublicSend('msgPopupPublicName', 'msgPopupPublicText', 'msgPopupPublicSend', 'msgPopupPublicDone');
 
  /* ── Subscribe realtime public messages ── */
  function waitFirebaseLocal(cb){
    if(window.__ddFirebase?.db){ cb(window.__ddFirebase); return; }
    window.addEventListener('dd-firebase-ready', () => { if(window.__ddFirebase?.db) cb(window.__ddFirebase); }, {once:true});
    let n=0; const t=setInterval(()=>{ if(window.__ddFirebase?.db){clearInterval(t);cb(window.__ddFirebase);} if(++n>60)clearInterval(t); },200);
  }
 
  waitFirebaseLocal(({db, ref, onValue}) => {
    onValue(ref(db, 'public_messages'), snap => {
      clearTimeout(publicUnsubDebounce);
      publicUnsubDebounce = setTimeout(() => renderPublicMessages(snap.val()), 60);
    });
  });
 
})();
</script>
</script>
