<script is:inline>
/* ─── FILTER ─── */
const allCards = document.querySelectorAll('.sc');
const chips = document.querySelectorAll('#filterChips .chip');
const flCount = document.getElementById('flCount');
let activeTags = new Set(), activeCat = null;

function applyFilter() {
  let vis = 0;
  allCards.forEach(card => {
    const cCat  = card.dataset.cat || '';
    const cTags = (card.dataset.tags || '').split(',').map(t => t.trim().toLowerCase());
    const catOk = !activeCat || cCat === activeCat;
    const tagOk = activeTags.size === 0 || [...activeTags].some(t => cTags.includes(t.toLowerCase()));
    const show  = catOk && tagOk;
    card.classList.toggle('hidden', !show);
    if (show) vis++;
  });
  flCount.textContent = vis + ' truyện';
  const nr = document.getElementById('noRes');
  if (nr) nr.classList.toggle('show', vis === 0);
}

chips.forEach(chip => {
  chip.addEventListener('click', () => {
    if (chip.dataset.tag) {
      const tag = chip.dataset.tag;
      if (tag === 'all') {
        activeTags.clear(); activeCat = null;
        chips.forEach(c => c.classList.remove('active'));
        chip.classList.add('active');
      } else {
        document.querySelector('[data-tag="all"]')?.classList.remove('active');
        if (activeTags.has(tag)) { activeTags.delete(tag); chip.classList.remove('active'); }
        else { activeTags.add(tag); chip.classList.add('active'); }
        if (activeTags.size === 0) document.querySelector('[data-tag="all"]')?.classList.add('active');
      }
    } else if (chip.dataset.cat) {
      const cat = chip.dataset.cat;
      chips.forEach(c => c.dataset.cat && c.classList.remove('active'));
      if (activeCat === cat) { activeCat = null; }
      else { activeCat = cat; chip.classList.add('active'); }
    }
    applyFilter();
  });
});

/* tag cloud → filter */
document.querySelectorAll('#tagCloud .tc-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('#tagCloud .tc-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    activeTags.clear(); activeTags.add(btn.dataset.tag); activeCat = null;
    chips.forEach(c => {
      if (c.dataset.tag) c.classList.toggle('active', c.dataset.tag === btn.dataset.tag || c.dataset.tag === 'all' && activeTags.size === 0);
    });
    applyFilter();
    document.getElementById('storiesGrid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
});

/* ─── DARK MODE BUTTON ─── */
const darkBtnIdx = document.getElementById('darkBtnIdx');
function syncDarkBtn() {
  const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
  if (darkBtnIdx) darkBtnIdx.textContent = isDark ? '☀️ Chế độ sáng' : '🌙 Chế độ tối';
}
syncDarkBtn();
darkBtnIdx?.addEventListener('click', () => { window.__ddToggleTheme(); syncDarkBtn(); });

/* ─── REVEAL ─── */
const obs = new IntersectionObserver(es => es.forEach(e => {
  if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); }
}), { threshold: .1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
</script>
