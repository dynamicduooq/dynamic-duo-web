---
import Layout from '../layouts/Layout.astro';
import settings from '../data/settings.json';
---
<Layout>
    <div style="text-align: center; margin-bottom: 30px;">
        <img src={settings.banner} alt="Banner" style="width: 100%; border-radius: 15px; box-shadow: 0 10px 20px rgba(0,0,0,0.1);" onerror="this.style.display='none'" />
    </div>

    <div style="background: #f0f9ff; border-radius: 20px; padding: 10px 15px; display: flex; align-items: center; border: 1px solid #bae6fd; margin: 20px auto; max-width: 800px; box-shadow: inset 0 2px 4px rgba(2,132,199,0.05);">
        <span style="background: #0ea5e9; color: white; padding: 4px 12px; border-radius: 15px; font-family: sans-serif; font-size: 0.85rem; font-weight: bold; white-space: nowrap; margin-right: 15px;">BẢNG TIN 📢</span>
        <marquee scrollamount="5" style="font-family: 'Newsreader', serif; font-size: 16px; color: #0369a1;">
            Nhà mới xây còn đang trong quá trình hoàn thiện, các cậu có thể gửi mail đề cử truyện edit và góp ý thêm cho chúng mình nhé! Chúc các cậu đọc truyện vui vẻ ⸜(｡˃ ᵕ ˂ )⸝♡
        </marquee>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 40px;">
        <div style="padding: 20px; background: #e0f2fe; border-radius: 10px; text-align: center;">
            <h3 style="color: var(--primary);">🔥 Đang tiến hành</h3>
            <a href="/on-going" style="font-weight: bold; color: #0284c7; text-decoration: none;">Xem ngay ➔</a>
        </div>
        <div style="padding: 20px; background: #f0f9ff; border-radius: 10px; text-align: center;">
            <h3 style="color: var(--primary);">✔️ Đã hoàn thành</h3>
            <a href="/completed" style="font-weight: bold; color: #0284c7; text-decoration: none;">Khám phá ➔</a>
        </div>
    </div>
</Layout>