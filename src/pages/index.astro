---
import Layout from '../layouts/Layout.astro';

const ndntkmPosts  = Object.values(import.meta.glob('./ca-tren-ban/neu-dem-nay-troi-khong-mua/*.md',   { eager: true })) as any[];
const tnctcstPosts = Object.values(import.meta.glob('./ca-tren-ban/toi-nghi-chung-toi-sap-chia-tay/*.md', { eager: true })) as any[];
const qhbcpPosts   = Object.values(import.meta.glob('./ca-duoi-nuoc/quan-he-ban-cung-phong/*.md',   { eager: true })) as any[];
const hcdhPosts    = Object.values(import.meta.glob('./ca-duoi-nuoc/ha-chay-dong-hoang/*.md',      { eager: true })) as any[];
const countChaps   = (posts: any[]) => posts.filter((p: any) => p.frontmatter?.chuong && p.frontmatter.chuong !== 0).length;

const ndntkmCount  = countChaps(ndntkmPosts);
const tnctcstCount = countChaps(tnctcstPosts);
const qhbcpCount   = countChaps(qhbcpPosts);
const hcdhCount    = countChaps(hcdhPosts);
---

<Layout title="Trang chủ" isHome={true}>
<style is:global>
/* ─── HOME SHELL ─── */
.home-shell {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 28px;
  max-width: 1260px;
  margin: 0 auto;
  padding: 20px 28px 80px;
  align-items: start;
  box-sizing: border-box;
  width: 100%;
}
@media(max-width:1100px){ .home-shell{ grid-template-columns:1fr 260px; padding:18px 20px 80px; gap:20px; } }
@media(max-width:900px){  .home-shell{ grid-template-columns:1fr; padding:14px 14px 80px; } }

/* ─── TICKER ─── */
.ticker-wrap {
  overflow: hidden; padding: 6px 0;
  background: linear-gradient(90deg,rgba(224,242,254,.5),rgba(240,249,255,.7),rgba(224,242,254,.5));
  border-top: 1px solid var(--sky-light); border-bottom: 1px solid var(--sky-light);
}
[data-theme="dark"] .ticker-wrap {
  background: linear-gradient(90deg,rgba(10,20,35,.9),rgba(12,24,40,.95),rgba(10,20,35,.9));
  border-color: rgba(100,160,220,.25);
}
.ticker-track { display:flex; white-space:nowrap; animation:ticker 40s linear infinite; }
.ticker-track:hover { animation-play-state:paused; }
.ticker-item {
  display:inline-flex; align-items:center; padding:0 20px;
  font-size:.7rem; color:var(--sky2); letter-spacing:1.5px;
}
[data-theme="dark"] .ticker-item { color:#a8d4f0; }
.ticker-item::after { content:'𓆝'; color:var(--sky-light); margin-left:20px; }
[data-theme="dark"] .ticker-item::after { color:rgba(100,160,220,.4); }
@keyframes ticker { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }

/* ─── HERO ─── */
.hero { text-align:center; padding:18px 0 14px; }
.hero-greeting {
  font-family: 'Merriweather', serif; font-size: 1.15rem; color: var(--sky-dark);
  margin-bottom: 6px; font-weight: 600; opacity: 0; transform: translateY(10px);
  animation: fadeUpAnim 0.8s ease forwards;
}
[data-theme="dark"] .hero-greeting { color: #a8daf0; }
.hero-banner-wrap {
  position:relative; border-radius:18px; overflow:hidden;
  max-width: 90%; max-height:220px; margin:0 auto;
  display:flex; align-items:center; justify-content:center;
  border: 6px solid #fff; box-shadow: 0 8px 25px rgba(2,132,199,.15);
}
[data-theme="dark"] .hero-banner-wrap { border-color: rgba(30,74,106,.8); box-shadow: 0 8px 25px rgba(0,0,0,.4); }
.hero-banner-bg { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:0; }
.hero-banner-overlay {
  position:absolute; inset:0;
  background:linear-gradient(180deg,rgba(2,70,130,.35) 0%,rgba(2,50,100,.6) 100%);
  z-index:1; pointer-events:none;
}
.hero-name-img {
  position:relative; z-index:2; max-width:360px; width:82%;
  display:block; margin:0 auto; padding:22px 0;
  filter:drop-shadow(0 2px 12px rgba(0,0,0,.35));
}
.hero-tagline { font-size:.78rem; color:var(--text-dim); font-style:italic; margin:12px 0 0; }
[data-theme="dark"] .hero-tagline { color:#8ab8d8; }

/* ─── SECTION HEADER ─── */
.sec-hd { display:flex; align-items:center; gap:10px; margin:22px 0 11px; }
.sec-hd h2 {
  font-family:'Merriweather',serif; font-size:.76rem; color:var(--sky-dark);
  letter-spacing:2px; text-transform:uppercase; margin:0; text-align:left; white-space:nowrap;
}
[data-theme="dark"] .sec-hd h2 { color:#a8daf0; }
.sec-line { flex:1; height:1px; background:linear-gradient(to right,var(--sky-light),transparent); }
[data-theme="dark"] .sec-line { background:linear-gradient(to right,rgba(80,150,210,.4),transparent); }

/* ─── FILTER BAR (Sticky Effect) ─── */
.filter-bar {
  background: rgba(255, 255, 255, 0.85); border:1px solid rgba(186,230,253,.5);
  border-radius:12px; padding:9px 12px;
  display:flex; flex-wrap:wrap; gap:5px; align-items:center;
  margin-bottom:12px;
  position: sticky; top: 66px; z-index: 100;
  backdrop-filter: blur(12px); box-shadow: 0 4px 15px rgba(2,132,199,.05);
  transition: box-shadow 0.3s ease;
}
[data-theme="dark"] .filter-bar { background: rgba(15, 35, 54, 0.85); border-color:rgba(80,150,210,.3); box-shadow: 0 4px 15px rgba(0,0,0,.2);}
.filter-bar.is-stuck { box-shadow: 0 8px 25px rgba(2,132,199,.15); }
.fl-label { font-size:.62rem; letter-spacing:2px; text-transform:uppercase; color:var(--text-dim); flex-shrink:0; }
.fl-chips { display:flex; flex-wrap:wrap; gap:4px; flex:1; }
.chip {
  display:inline-flex; align-items:center; gap:3px; padding:3px 10px;
  border-radius:var(--r-pill); font-size:.67rem; cursor:pointer;
  transition:var(--t); border:1.5px solid rgba(186,230,253,.6);
  background:var(--sky-pale); color:var(--sky-dark); user-select:none;
  font-family:'Newsreader',serif; white-space:nowrap;
}
[data-theme="dark"] .chip { color:#d8eeff; border-color:rgba(126,200,227,.25); background:rgba(15,35,54,.8); }
.chip:hover { background:var(--sky-light); color:var(--sky-dark); transform: translateY(-1px); box-shadow: 0 2px 5px rgba(2,132,199,.1); }
[data-theme="dark"] .chip:hover { background:rgba(126,200,227,.15); color:#F3F9FF; box-shadow: 0 2px 5px rgba(0,0,0,.3); }
.chip.active { background:var(--sky); color:#fff; border-color:var(--sky); }
[data-theme="dark"] .chip.active { background:#1e4a6a; border-color:#7ec8e3; color:#F3F9FF; }
.chip-clear { background:none; border-color:rgba(186,230,253,.4); color:var(--text-dim); }
.chip-clear:hover { background:rgba(239,68,68,.08); color:#ef4444; border-color:#fca5a5; }
.fl-count {
  font-size:.7rem; background:var(--sky-pale); color:var(--sky-dark);
  padding:2px 8px; border-radius:var(--r-pill); border:1px solid var(--sky-light);
  white-space:nowrap; margin-left:auto;
}
[data-theme="dark"] .fl-count { background:rgba(15,35,54,.6); border-color:rgba(126,200,227,.2); color:#a8daf0; }

/* ─── CONTINUE READING BANNER ─── */
.cr-banner {
  display: flex; align-items: center; gap: 12px; text-decoration: none;
  background: linear-gradient(135deg, var(--sky-light), var(--sky-pale)); 
  border-radius: 12px; padding: 10px 16px; margin-bottom: 16px; 
  border: 1px solid rgba(186,230,253,.8); box-shadow: 0 4px 15px rgba(2,132,199,.1); 
  transition: transform 0.3s, box-shadow 0.3s;
}
[data-theme="dark"] .cr-banner { background: linear-gradient(135deg, rgba(30,74,106,.8), rgba(13,32,53,.8)); border-color: rgba(126,200,227,.3); }
.cr-banner:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(2,132,199,.15); }
.cr-icon { font-size: 1.6rem; animation: cr-float 3s ease-in-out infinite; }
.cr-label { font-size: .65rem; text-transform: uppercase; letter-spacing: 1px; color: var(--sky-dark); display: block; margin-bottom: 2px;}
[data-theme="dark"] .cr-label { color: #8ab8d8; }
.cr-title { font-size: .85rem; font-weight: 600; color: var(--text-main); font-family: 'Merriweather', serif;}
[data-theme="dark"] .cr-title { color: #F3F9FF; }
.cr-arrow { margin-left: auto; color: var(--sky); font-size: 1.2rem; }
[data-theme="dark"] .cr-arrow { color: #a8daf0; }
@keyframes cr-float { 0% { transform: translateY(0); } 50% { transform: translateY(-4px); } 100% { transform: translateY(0); } }

/* ─── STORY GRID ─── */
@keyframes fadeUpAnim { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
.stories-grid { display:flex; flex-direction:column; gap:10px; }
.sc {
  display:flex; background: var(--bg-card); border:1px solid rgba(186,230,253,.5);
  border-radius:12px; overflow:hidden; transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
  box-shadow:0 2px 8px rgba(2,132,199,.05); animation: fadeUpAnim 0.5s ease backwards;
}
.sc:nth-child(1) { animation-delay: 0.05s; } .sc:nth-child(2) { animation-delay: 0.1s; }
.sc:nth-child(3) { animation-delay: 0.15s; } .sc:nth-child(4) { animation-delay: 0.2s; }
.sc:nth-child(5) { animation-delay: 0.25s; } .sc:nth-child(6) { animation-delay: 0.3s; }

[data-theme="dark"] .sc { border-color:rgba(80,150,210,.25); }
.sc:hover { box-shadow:0 12px 30px rgba(2,132,199,.12); transform:translateY(-4px) scale(1.01); z-index: 10; }
[data-theme="dark"] .sc:hover { box-shadow:0 12px 30px rgba(0,0,0,.6); }
.sc-cover-wrap {
  position:relative; flex-shrink:0; width:110px; min-height:140px; overflow:hidden;
  background:linear-gradient(135deg,var(--sky-pale),rgba(186,230,253,.4));
  display:flex; align-items:center; justify-content:center;
}
.sc-cover-wrap img { width:100px; height:auto; max-height:none; object-fit:contain; display:block; padding:4px; transition: transform 0.4s ease; }
.sc:hover .sc-cover-wrap img { transform: scale(1.05); }
.sc-status {
  position:absolute; top:6px; left:0; font-size:.5rem; letter-spacing:1px; text-transform:uppercase;
  padding:2px 6px; border-radius:0 4px 4px 0; font-weight:700; box-shadow: 2px 2px 8px rgba(0,0,0,0.15);
}
.status-ongoing  { background:rgba(2,132,199,.9);  color:#fff; }
.status-complete { background:rgba(5,150,105,.9);  color:#fff; }
.status-upcoming { background:rgba(100,116,139,.8); color:#fff; }
.sc-body { padding:12px 14px; flex:1; display:flex; flex-direction:column; gap:4px; min-width:0; }
.sc-shelf { font-size:.6rem; letter-spacing:1.5px; text-transform:uppercase; color:var(--sky); }
[data-theme="dark"] .sc-shelf { color:#7ec8e3; }
.sc-title { font-family:'Merriweather',serif; font-size:.88rem; color:#0c4a6e; margin:0; line-height:1.35; text-align:left; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
[data-theme="dark"] .sc-title { color:#e8f4ff; }
.sc-meta { font-size:.65rem; color:#475569; font-style:italic; }
[data-theme="dark"] .sc-meta { color:#9bbcdb; }
.sc-tags { display:flex; flex-wrap:wrap; gap:4px; margin-top:2px;}
.sc-tag { font-size:.58rem; padding:1px 7px; border:1px solid var(--sky-light); border-radius:var(--r-pill); color:#0369a1; background:#e0f2fe; }
[data-theme="dark"] .sc-tag { border-color:rgba(80,150,210,.4); background:rgba(20,55,90,.6); color:#a8d4f0; }
.sc-footer { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-top:auto; padding-top:6px; }
.sc-chapters { font-size:.65rem; color:#475569; }
[data-theme="dark"] .sc-chapters { color:#9bbcdb; }
.sc-link { font-size:.68rem; padding:4px 12px; background:var(--sky); color:#fff; border-radius:var(--r-pill); transition:var(--t); flex-shrink:0; font-family:'Newsreader', serif;}
.sc-link:hover { background:var(--sky2); transform: translateX(2px); }
.sc-link.secondary { background:#e0f2fe; color:#0369a1; }
[data-theme="dark"] .sc-link.secondary { color:#a8d4f0; background:rgba(20,55,90,.7); border:1px solid rgba(80,150,210,.35); }
.sc-link.secondary:hover { background:#bae6fd; transform: translateY(-1px); }
[data-theme="dark"] .sc-link.secondary:hover { background:rgba(80,150,210,.25); }

/* ─── NOTICE ─── */
.notice-section { margin-top:22px; }
.notice-img { width:100%; display:block; border-radius:10px; transition: transform 0.3s; }
.notice-img:hover { transform: scale(1.01); box-shadow: 0 4px 15px rgba(2,132,199,.1); }

/* ─── RECENT ─── */
.recent-list { display:flex; flex-direction:column; gap:8px; }
.recent-item {
  display:flex; align-items:center; gap:12px; padding:10px 14px;
  background:var(--bg-card); border:1px solid rgba(186,230,253,.4); border-radius:10px;
  transition:var(--t); color:var(--text-main); box-shadow:0 2px 6px rgba(0,0,0,.02);
}
[data-theme="dark"] .recent-item { border-color:rgba(80,150,210,.25); }
.recent-item:hover { background:var(--sky-pale); border-color:var(--sky-light); transform:translateX(5px); box-shadow:0 4px 12px rgba(2,132,199,.08); }
[data-theme="dark"] .recent-item:hover { background:rgba(80,150,210,.12); box-shadow:0 4px 12px rgba(0,0,0,.4); }
.recent-icon { font-size:.95rem; flex-shrink:0; }
.ri-body { flex:1; min-width:0; }
.ri-story { font-size:.64rem; color:#64748b; text-overflow:ellipsis; overflow:hidden; white-space:nowrap; margin-bottom: 2px;}
[data-theme="dark"] .ri-story { color:#9bbcdb; }
.ri-title { font-size:.8rem; color:#0c4a6e; font-weight:600; }
[data-theme="dark"] .ri-title { color:#e8f4ff; }
.recent-arrow { color:var(--sky); font-size:.88rem; transition: transform 0.2s; }
.recent-item:hover .recent-arrow { transform: translateX(3px); }

.badge-new { display: inline-block; background: #ef4444; color: #fff; font-size: .55rem; padding: 2px 5px; border-radius: var(--r-pill); margin-left: 6px; vertical-align: middle; animation: pulse-red 2s infinite; font-family: 'Newsreader', serif; }
@keyframes pulse-red { 0% { box-shadow: 0 0 0 0 rgba(239,68,68,.7); } 70% { box-shadow: 0 0 0 4px rgba(239,68,68,0); } 100% { box-shadow: 0 0 0 0 rgba(239,68,68,0); } }

/* ─── SIDEBAR ─── */
.sidebar-col {
  display:flex; flex-direction:column; gap:16px;
  position:sticky; top:68px; max-height:calc(100vh - 84px); overflow-y:auto; overflow-x:hidden;
  scrollbar-width:thin; scrollbar-color:var(--sky-light) transparent; padding-bottom:8px;
}
.sidebar-col::-webkit-scrollbar { width:4px; }
.sidebar-col::-webkit-scrollbar-thumb { background:var(--sky-light); border-radius:4px; }
@media(max-width:900px){ .sidebar-col{ position:static; max-height:none; } }

/* ─── WIDGET BASE ─── */
.widget {
  background:var(--bg-card); border:1px solid rgba(186,230,253,.65); border-radius:16px; padding:16px 14px; flex-shrink:0; box-shadow: 0 4px 12px rgba(2,132,199,.04);
}
[data-theme="dark"] .widget { border-color:rgba(80,150,210,.28); box-shadow: 0 4px 12px rgba(0,0,0,.2); }
.widget-title { font-family:'Merriweather',serif; font-size:.7rem; letter-spacing:2.5px; text-transform:uppercase; color:var(--sky); text-align:center; margin-bottom:12px; }
[data-theme="dark"] .widget-title { color:#7ec8e3; }

/* Profile widget */
.profile-avatar { width:72px; height:72px; border-radius:50%; overflow:hidden; margin:0 auto 10px; border:3px solid var(--sky-light); background:var(--sky-pale); display:flex; align-items:center; justify-content:center; font-size:2rem; transition: transform 0.3s; }
.profile-avatar:hover { transform: rotate(5deg) scale(1.05); border-color: var(--sky); }
.profile-name { font-family:'Merriweather',serif; color:#0c4a6e; font-size:.9rem; text-align:center; margin-bottom:2px; }
[data-theme="dark"] .profile-name { color:#e8f4ff; }
.profile-tagline { font-size:.74rem; color:#64748b; font-style:italic; text-align:center; line-height:1.5; margin-bottom:8px; }
[data-theme="dark"] .profile-tagline { color:#9bbcdb; }
.profile-deco { text-align:center; font-size:.88rem; letter-spacing:3px; color:var(--sky-light); }

/* Category tree */
.cat-tree { font-size:.76rem; color:#64748b; }
[data-theme="dark"] .cat-tree { color:#9bbcdb; }
.cat-tree ul { list-style:none; padding-left:14px; margin:4px 0; }
.cat-tree > ul { padding-left:0; }
.cat-tree a { color:#64748b; transition:color .2s, transform .2s; display:inline-block; padding:3px 0; }
[data-theme="dark"] .cat-tree a { color:#9bbcdb; }
.cat-tree a:hover { color:var(--sky); transform: translateX(3px); }
[data-theme="dark"] .cat-tree a:hover { color:#e8f4ff; }
.cat-tree summary { cursor:pointer; font-size:.8rem; color:#0c4a6e; font-weight:600; padding:4px 0; list-style:none; display:flex; align-items:center; gap:6px; transition: color 0.2s; }
.cat-tree summary:hover { color: var(--sky); }
[data-theme="dark"] .cat-tree summary { color:#d0e6f5; }
[data-theme="dark"] .cat-tree summary:hover { color:#e8f4ff; }
.cat-tree summary::-webkit-details-marker { display:none; }
.cat-tree summary::before { content:'▸'; font-size:.6rem; transition:transform .2s; color:var(--sky); }
[data-theme="dark"] .cat-tree summary::before { color:#7ec8e3; }
.cat-tree details[open]>summary::before { transform:rotate(90deg); }
.cat-count { font-size:.62rem; color:#94a3b8; margin-left:auto; background: var(--sky-pale); padding: 1px 6px; border-radius: var(--r-pill); border: 1px solid rgba(186,230,253,.4);}
[data-theme="dark"] .cat-count { color:#6a8ea8; background: rgba(15,35,60,.5); border-color: rgba(80,150,210,.2); }

/* Quote widget */
.quote-body { font-style:italic; font-size:.78rem; color:#475569; line-height:1.75; border-left:3px solid var(--sky-light); padding-left:12px; margin:0; }
[data-theme="dark"] .quote-body { color:#e8f4ff; border-left-color:rgba(126,200,227,.4); }
.quote-widget-inner { border-radius:10px; padding:12px 14px; margin:-2px; background: rgba(240,249,255, 0.4); }
[data-theme="dark"] .quote-widget-inner { background:rgba(15, 35, 60, 0.4); border:1px solid rgba(126,200,227,.15); }
.quote-src { font-size:.64rem; color:#94a3b8; margin-top:8px; text-align:right; font-weight: 600; }
[data-theme="dark"] .quote-src { color:#a3cbeb; }

/* ─── MESSAGE WIDGET ─── */
.msg-widget-tabs { display:flex; gap:0; margin-bottom:12px; border:1px solid rgba(186,230,253,.6); border-radius:var(--r-pill); overflow:hidden; background: var(--bg-card); }
[data-theme="dark"] .msg-widget-tabs { border-color:rgba(80,150,210,.3); }
.msg-tab { flex:1; padding:7px 0; font-size:.7rem; letter-spacing:.5px; text-transform:uppercase; background:none; border:none; cursor:pointer; font-family:'Newsreader',serif; color:var(--text-mid); transition:all .3s ease; position: relative; }
.msg-tab.active { background:var(--sky); color:#fff; font-weight: 600; }
[data-theme="dark"] .msg-tab { color:#8ab8d8; background:transparent; }
[data-theme="dark"] .msg-tab.active { background:#1a5a90; color:#e8f6ff; }
.online-pulse { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #10b981; margin-left: 4px; vertical-align: middle; box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); animation: pulse-green 2s infinite; }
@keyframes pulse-green { 0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); } 70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); } 100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); } }

.msg-panel { display:none; animation: fadeUpAnim 0.3s ease; }
.msg-panel.active { display:block; }
.msg-inp, .msg-textarea { width:100%; padding:8px 12px; border:1.5px solid var(--sky-light); font-family:'Newsreader',serif; color:var(--text-main); background:#fff; outline:none; box-sizing:border-box; font-size:.75rem; margin-bottom:8px; border-radius:var(--r-pill); transition: border-color 0.2s, box-shadow 0.2s; }
.msg-textarea { border-radius:12px; resize:none; min-height:56px; }
.msg-inp:focus, .msg-textarea:focus { border-color:var(--sky); box-shadow: 0 0 0 3px rgba(14,165,233,0.1); }
[data-theme="dark"] .msg-inp, [data-theme="dark"] .msg-textarea { background:rgba(10,25,45,.9); border-color:rgba(80,150,210,.4); color:#d8eeff; }
[data-theme="dark"] .msg-inp:focus, [data-theme="dark"] .msg-textarea:focus { border-color:#7ec8e3; box-shadow: 0 0 0 3px rgba(126,200,227,0.15); }
[data-theme="dark"] .msg-inp::placeholder, [data-theme="dark"] .msg-textarea::placeholder { color:#4a7a9a; }

.msg-send-btn { width:100%; padding:8px; background:var(--sky); color:#fff; border:none; border-radius:var(--r-pill); font-size:.76rem; font-family:'Newsreader',serif; cursor:pointer; transition:var(--t); font-weight: 600; }
.msg-send-btn:hover { background:var(--sky2); transform: translateY(-1px); box-shadow: 0 4px 10px rgba(2,132,199,.2); }
.msg-send-btn:disabled { opacity:.5; cursor:not-allowed; transform: none; box-shadow: none;}
.msg-sent-notice { text-align:center; font-size:.7rem; color:#059669; padding:8px 0; display:none; font-style:italic; font-weight: 600; }
[data-theme="dark"] .msg-sent-notice { color:#34d399; }

.msg-public-feed { max-height:160px; overflow-y:auto; display:flex; flex-direction:column; gap:6px; margin-bottom:10px; scrollbar-width:thin; scrollbar-color:var(--sky-light) transparent; padding-right: 4px; }
.msg-public-feed::-webkit-scrollbar { width:4px; }
.msg-public-feed::-webkit-scrollbar-thumb { background:var(--sky-light); border-radius:4px; }
.msg-pub-item { background:var(--sky-pale); border-radius:10px; padding:8px 10px; border:1px solid rgba(186,230,253,.35); font-size:.7rem; line-height:1.5; }
[data-theme="dark"] .msg-pub-item { background:rgba(15,35,60,.7); border-color:rgba(80,150,210,.2); }
.msg-pub-item-header { display: flex; align-items: center; gap: 6px; margin-bottom: 3px; }
.msg-pub-del { margin-left: auto; background:none; border:1px solid rgba(186,230,253,.5); font-size:.56rem; color:var(--text-dim); cursor:pointer; padding:1px 5px; border-radius:4px; transition:color .15s, border-color .15s; display:none; line-height:1.4; flex-shrink:0; }
.msg-pub-del.show { display:inline-flex; align-items:center; }
.msg-pub-del:hover { color:#ef4444; border-color:#fca5a5; background: rgba(239,68,68,0.05); }
[data-theme="dark"] .msg-pub-del { border-color:rgba(80,150,210,.3); color:#5a7a9a; }
.msg-pub-name { font-weight:700; color:var(--sky-dark); font-size:.7rem; }
[data-theme="dark"] .msg-pub-name { color:#5aacdf; }
.msg-pub-time { font-size:.62rem; color:var(--text-dim); }
[data-theme="dark"] .msg-pub-time { color:#4a6a8a; }
.msg-pub-text { color:var(--text-main); margin:0; line-height:1.45; word-break:break-word; font-size:.7rem; }
[data-theme="dark"] .msg-pub-text { color:#c0dff5; }
.msg-public-empty { font-size:.7rem; color:var(--text-dim); font-style:italic; text-align:center; padding:12px 0; }
[data-theme="dark"] .msg-public-empty { color:#4a6a8a; }

.msg-priv-card { border-radius:10px; padding:10px 12px; border:1px solid rgba(186,230,253,.4); font-size:.7rem; background:var(--sky-pale); }
[data-theme="dark"] .msg-priv-card { background:rgba(15,35,60,.6); border-color:rgba(80,150,210,.2); }
.msg-priv-card.unread  { border-left:3px solid var(--sky); }
.msg-priv-card.replied { border-left:3px solid #34d399; opacity:.85; }
.msg-priv-card-header  { display:flex; align-items:center; gap:6px; margin-bottom:4px; }
.msg-priv-sender { font-weight:700; color:var(--sky-dark); font-size:.7rem; }
[data-theme="dark"] .msg-priv-sender { color:#5aacdf; }
.msg-priv-time { font-size:.62rem; color:var(--text-dim); margin-left:auto; }
[data-theme="dark"] .msg-priv-time { color:#4a6a8a; }
.msg-priv-del  { background:none; border:none; cursor:pointer; font-size:.6rem; color:var(--text-dim); padding:0 3px; transition:color .15s; }
.msg-priv-del:hover { color:#ef4444; }
.msg-priv-text { color:var(--text-main); line-height:1.45; margin:3px 0 6px; word-break:break-word; font-size:.7rem; }
[data-theme="dark"] .msg-priv-text { color:#c0dff5; }
.msg-priv-reply-inp { width:100%; padding:6px 10px; border:1.5px solid var(--sky-light); border-radius:8px; font-size:.7rem; font-family:'Newsreader',serif; resize:none; background:#fff; color:var(--text-main); outline:none; margin-bottom:4px; }
.msg-priv-reply-inp:focus { border-color:var(--sky); }
[data-theme="dark"] .msg-priv-reply-inp { background:rgba(10,25,45,.9); border-color:rgba(80,150,210,.4); color:#d8eeff; }
.msg-priv-send-btn { padding:4px 12px; background:var(--sky); color:#fff; border:none; border-radius:var(--r-pill); font-size:.68rem; cursor:pointer; transition:var(--t); }
.msg-priv-send-btn:hover { background:var(--sky2); }
.msg-priv-send-btn:disabled { opacity:.5; }
.msg-priv-replied-wrap { margin-top:6px; padding:6px 10px; background:rgba(52,211,153,.08); border-radius:8px; border:1px solid rgba(52,211,153,.25); }
[data-theme="dark"] .msg-priv-replied-wrap { background:rgba(52,211,153,.05); border-color:rgba(52,211,153,.2); }
.msg-priv-replied-label { font-size:.64rem; color:#059669; font-weight:700; display:block; margin-bottom:3px; }
.msg-priv-replied-text  { font-size:.7rem; color:var(--text-main); line-height:1.4; }
[data-theme="dark"] .msg-priv-replied-text { color:#c0dff5; }
.msg-priv-del-reply { background:none; border:none; cursor:pointer; font-size:.58rem; color:var(--text-dim); padding:2px 4px; margin-top:3px; border-radius:4px; transition:color .15s; }
.msg-priv-del-reply:hover { color:#ef4444; background: rgba(239,68,68,0.05);}
.msg-admin-reply-section { margin-top:8px; }
.msg-admin-reply-title   { font-size:.68rem; color:#059669; font-weight:700; margin-bottom:6px; }
.msg-admin-reply-card    { padding:8px 10px; background:rgba(52,211,153,.07); border:1px solid rgba(52,211,153,.2); border-radius:10px; margin-bottom:6px; }
[data-theme="dark"] .msg-admin-reply-card { background:rgba(52,211,153,.05); }
.msg-admin-reply-orig    { font-size:.64rem; color:var(--text-dim); font-style:italic; margin-bottom:4px; border-left: 2px solid #34d399; padding-left: 6px;}
.msg-admin-reply-body    { font-size:.7rem; color:var(--text-main); line-height:1.4; }
[data-theme="dark"] .msg-admin-reply-body { color:#c0dff5; }
.msg-admin-badge         { display:inline-block; background:var(--sky); color:#fff; font-size:.58rem; font-weight:700; padding:1px 6px; border-radius:var(--r-pill); margin-right:4px; }
.msg-admin-reply-time    { font-size:.6rem; color:var(--text-dim); text-align:right; margin-top:3px; }
.msg-pub-admin           { background:rgba(14,165,233,.06)!important; border-color:rgba(14,165,233,.25)!important; }
[data-theme="dark"] .msg-pub-admin { background:rgba(20,60,100,.5)!important; border-color:rgba(80,150,210,.35)!important; }
.msg-pub-admin-name      { color:var(--sky-dark)!important; }
[data-theme="dark"] .msg-pub-admin-name { color:#5aacdf!important; }
.msg-pub-owner-badge     { display:inline-block; font-size:.54rem; background:var(--sky); color:#fff; padding:1px 5px; border-radius:var(--r-pill); margin-left:4px; vertical-align:middle; }
.msg-panel p { font-size:.7rem; color:var(--text-dim); margin:0 0 8px; font-style:italic; line-height:1.5; }
[data-theme="dark"] .msg-panel p { color:#5a7a9a; }

/* Misc */
.no-results { display:none; text-align:center; padding:30px; color:var(--text-dim); font-style:italic; font-size: 0.9rem;}
.no-results.show { display:block; animation: fadeUpAnim 0.3s ease; }
.no-results .fish-icon { display: block; font-size: 2rem; margin-bottom: 10px; animation: swim 3s infinite ease-in-out alternate; }
.hidden { display:none !important; }
.reveal { opacity:0; transform:translateY(15px); transition:opacity .6s cubic-bezier(0.34, 1.56, 0.64, 1),transform .6s cubic-bezier(0.34, 1.56, 0.64, 1); }
.reveal.visible { opacity:1; transform:translateY(0); }
.contact-email { font-size:.75rem; margin-bottom:6px; padding: 4px 8px; border-radius: 6px; display: inline-block; transition: background 0.2s;}
.contact-email:hover { background: var(--sky-pale); color: var(--sky-dark); }
[data-theme="dark"] .contact-email { color:#8ab8d8; }
[data-theme="dark"] .contact-email:hover { background: rgba(126,200,227,0.1); color: #e8f4ff; }
.copy-tooltip { position: absolute; background: #333; color: #fff; font-size: 0.65rem; padding: 4px 8px; border-radius: 4px; pointer-events: none; opacity: 0; transform: translateY(-5px); transition: all 0.2s; white-space: nowrap; z-index: 1000; }
.copy-tooltip.show { opacity: 1; transform: translateY(-30px); }
  </style>
</head>
