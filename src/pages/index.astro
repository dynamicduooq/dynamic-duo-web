<script is:inline>
// ── MULTI-SELECT TAG FILTER ──
(function() {
  const cards = Array.from(document.querySelectorAll('.story-card'));
  const filterBtns = Array.from(document.querySelectorAll('#tagFilter .filter-btn'));
  const clearBtn = document.getElementById('filterClear');
  const countEl = document.getElementById('filterCount');

  // State: sets of active tags and cats (multi-select)
  let activeTags = new Set();  // empty = all
  let activeCats = new Set();  // empty = all

  function applyFilter() {
    const noTagFilter = activeTags.size === 0;
    const noCatFilter = activeCats.size === 0;
    let visible = 0;

    cards.forEach(card => {
      const cardTags = (card.dataset.tags || '').split(',').map(t => t.trim().toLowerCase());
      const cardCat  = (card.dataset.cat  || '').toLowerCase();

      const tagMatch = noTagFilter || [...activeTags].some(t => cardTags.includes(t.toLowerCase()));
      const catMatch = noCatFilter || activeCats.has(cardCat);

      if (tagMatch && catMatch) {
        card.classList.remove('hidden');
        visible++;
      } else {
        card.classList.add('hidden');
      }
    });

    countEl.textContent = visible + ' truyện';
    const hasFilter = activeTags.size > 0 || activeCats.size > 0;
    clearBtn.style.display = hasFilter ? 'inline-block' : 'none';

    // Sync "Tất cả" button
    const allBtn = document.querySelector('.filter-btn[data-tag="all"]');
    if (allBtn) allBtn.classList.toggle('active', !hasFilter);
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.dataset.tag === 'all') {
        // Reset everything
        activeTags.clear();
        activeCats.clear();
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        applyFilter();
        return;
      }

      // Remove "Tất cả" active state
      const allBtn = document.querySelector('.filter-btn[data-tag="all"]');
      allBtn?.classList.remove('active');

      if (btn.dataset.tag) {
        const tag = btn.dataset.tag.toLowerCase();
        if (activeTags.has(tag)) {
          activeTags.delete(tag);
          btn.classList.remove('active');
        } else {
          activeTags.add(tag);
          btn.classList.add('active');
        }
      } else if (btn.dataset.cat) {
        const cat = btn.dataset.cat.toLowerCase();
        if (activeCats.has(cat)) {
          activeCats.delete(cat);
          btn.classList.remove('active');
        } else {
          activeCats.add(cat);
          btn.classList.add('active');
        }
      }

      // If nothing active, reset to "Tất cả"
      if (activeTags.size === 0 && activeCats.size === 0) {
        allBtn?.classList.add('active');
      }

      applyFilter();
    });
  });

  clearBtn.addEventListener('click', () => {
    activeTags.clear();
    activeCats.clear();
    filterBtns.forEach(b => b.classList.remove('active'));
    document.querySelector('.filter-btn[data-tag="all"]')?.classList.add('active');
    applyFilter();
  });

  // Tag cloud sidebar → add to filter (not replace)
  document.querySelectorAll('.tag-cloud-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag?.toLowerCase();
      if (!tag) return;
      btn.classList.toggle('active');
      if (activeTags.has(tag)) {
        activeTags.delete(tag);
      } else {
        activeTags.add(tag);
        // Sync filter bar button
        const fb = document.querySelector(`.filter-btn[data-tag="${btn.dataset.tag}"]`);
        fb?.classList.add('active');
        document.querySelector('.filter-btn[data-tag="all"]')?.classList.remove('active');
      }
      if (activeTags.size === 0 && activeCats.size === 0) {
        document.querySelector('.filter-btn[data-tag="all"]')?.classList.add('active');
      }
      applyFilter();
      document.getElementById('storyGrid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
})();

// ── DARK MODE ──
(function() {
  const btn = document.getElementById('darkBtn');
  function applyTheme(dark) {
    document.documentElement.setAttribute('data-theme', dark ? 'dark' : '');
    if (btn) btn.textContent = dark ? '☀️ Chế độ sáng' : '🌙 Chế độ tối';
    localStorage.setItem('dd-theme', dark ? 'dark' : 'light');
  }
  btn?.addEventListener('click', () => {
    applyTheme(document.documentElement.getAttribute('data-theme') !== 'dark');
  });
  // Restore saved theme
  const saved = localStorage.getItem('dd-theme');
  if (saved === 'dark') applyTheme(true);
})();
</script>

</Layout>