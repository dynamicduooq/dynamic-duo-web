.sidebar-col { display: flex; flex-direction: column; gap: 16px; position: static; align-self: start; width: 100%; padding-bottom: 20px; }

.widget { background:var(--bg-card); border:1px solid rgba(186,230,253,.65); border-radius:16px; padding:16px 14px; flex-shrink:0; box-shadow: 0 4px 12px rgba(2,132,199,.04); }
[data-theme="dark"] .widget { border-color:rgba(80,150,210,.28); box-shadow: 0 4px 12px rgba(0,0,0,.2); }
.widget-title { font-family:'Merriweather',serif; font-size:.7rem; letter-spacing:2.5px; text-transform:uppercase; color:var(--sky); text-align:center; margin-bottom:12px; }
