/* Popup from bubble */
.msg-popup { position:fixed; bottom:132px; right:20px; z-index:420; width:min(360px,calc(100vw - 32px)); background:rgba(255,255,255,0.98); backdrop-filter: blur(16px); border:1px solid rgba(186,230,253,.6); border-radius:18px; box-shadow:0 16px 50px rgba(2,132,199,.2); padding:18px 16px 16px; opacity:0; pointer-events:none; transform:translateY(15px) scale(.95); transition:opacity .25s cubic-bezier(0.34, 1.56, 0.64, 1), transform .25s cubic-bezier(0.34, 1.56, 0.64, 1); }
