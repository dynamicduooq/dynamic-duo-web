---
// src/pages/index.astro — dynamic duo homepage (hoàn chỉnh)
import Layout from '../layouts/Layout.astro';

const ndntkmPosts  = Object.values(import.meta.glob('./ca-tren-ban/neu-dem-nay-troi-khong-mua/*.md',       { eager: true })) as any[];
const tnctcstPosts = Object.values(import.meta.glob('./ca-tren-ban/toi-nghi-chung-toi-sap-chia-tay/*.md', { eager: true })) as any[];
const qhbcpPosts   = Object.values(import.meta.glob('./ca-duoi-nuoc/quan-he-ban-cung-phong/*.md',          { eager: true })) as any[];
const hcdhPosts    = Object.values(import.meta.glob('./ca-duoi-nuoc/ha-chay-dong-hoang/*.md',              { eager: true })) as any[];

const countChaps = (posts: any[]) =>
  posts.filter(p => p.frontmatter?.chuong && p.frontmatter.chuong !== 0).length;

const stories = [
  {
    id: 'qhbcp',
    title: 'Quan hệ bạn cùng phòng',
    author: 'Hạnh Lan',
    desc: 'Anh ấy nghèo thì đã sao? Tôi có tiền là được rồi.',
    cover: '/dynamic-duo-web/images/biaqhbcp.png',
    href: '/dynamic-duo-web/ca-duoi-nuoc/quan-he-ban-cung-phong/',
    firstChap: '/dynamic-duo-web/ca-duoi-nuoc/quan-he-ban-cung-phong/chuong-01/',
    cat: 'ongoing', catLabel: '🌊 Đang tiến hành',
    tags: ['đam mỹ','hiện đại','niên hạ','trai thẳng','yêu thầm'],
    done: countChaps(qhbcpPosts), total: 72,
  },
  {
    id: 'hcdh',
    title: 'Hạ cháy đồng hoang',
    author: 'Hỉ Thượng Mi Sao',
    desc: 'Tình yêu là bản năng ẩn sau miền hoang tàn của ký ức.',
    cover: '/dynamic-duo-web/images/biatdxt.png',
    href: '/dynamic-duo-web/ca-duoi-nuoc/ha-chay-dong-hoang/',
    firstChap: '/dynamic-duo-web/ca-duoi-nuoc/ha-chay-dong-hoang/chuong-01/',
    cat: 'ongoing', catLabel: '🌊 Đang tiến hành',
    tags: ['đam mỹ','hiện đại','chua xót','mất trí nhớ','đồng quê'],
    done: countChaps(hcdhPosts), total: 109,
  },
  {
    id: 'ndntkm',
    title: 'Nếu đêm nay trời không mưa',
    author: 'Tam Đạo',
    desc: 'Tình cờ gặp lại mối tình đầu từng đá anh — lần này thật sự không còn yêu nữa.',
    cover: '/dynamic-duo-web/images/biandntkm.png',
    href: '/dynamic-duo-web/ca-tren-ban/neu-dem-nay-troi-khong-mua/',
    firstChap: '/dynamic-duo-web/ca-tren-ban/neu-dem-nay-troi-khong-mua/chuong-01/',
    cat: 'completed', catLabel: '✅ Hoàn thành',
    tags: ['đam mỹ','hiện đại','HE','gương vỡ lại lành','drama motip cũ'],
    done: countChaps(ndntkmPosts), total: 76,
  },
  {
    id: 'tnctsct',
    title: 'Tôi nghĩ chúng tôi sắp chia tay',
    author: 'Hạ Nhất Thiên',
    desc: 'Khủng hoảng năm thứ 8. Hai người lớn nhát gan.',
    cover: '/dynamic-duo-web/images/biatnctsct.png',
    href: '/dynamic-duo-web/ca-tren-ban/toi-nghi-chung-toi-sap-chia-tay/',
    firstChap: '/dynamic-duo-web/ca-tren-ban/toi-nghi-chung-toi-sap-chia-tay/chuong-01/',
    cat: 'completed', catLabel: '✅ Hoàn thành',
    tags: ['đam mỹ','hiện đại','HE','chua xót','1v1'],
    done: countChaps(tnctcstPosts), total: 74,
  },
  {
    id: 'vdv',
    title: 'Vật dễ vỡ',
    author: '??',
    desc: 'Chương sẽ được cập nhật sớm.',
    cover: '/dynamic-duo-web/images/biavdv.png',
    href: '/dynamic-duo-web/ca-tren-ban/vat-de-vo/',
    firstChap: '/dynamic-duo-web/ca-tren-ban/vat-de-vo/',
    cat: 'upcoming', catLabel: '🌤️ Sắp đào',
    tags: ['đam mỹ'], done: 0, total: 0,
  },
  {
    id: 'tdxt',
    title: 'Thiếu đế xuân tâm',
    author: '??',
    desc: 'Chương sẽ được cập nhật sớm.',
    cover: '/dynamic-duo-web/images/biatdxt.png',
    href: '/dynamic-duo-web/ca-tren-ban/thieu-de-xuan-tam/',
    firstChap: '/dynamic-duo-web/ca-tren-ban/thieu-de-xuan-tam/',
    cat: 'upcoming', catLabel: '🌤️ Sắp đào',
    tags: ['đam mỹ','cổ đại'], done: 0, total: 0,
  },
];

const allTags = [...new Set(stories.flatMap(s => s.tags))].sort();

// Phân nhóm truyện theo danh mục trang
const duoiNuocStories = stories.filter(s => ['qhbcp','hcdh'].includes(s.id));
const trenBanStories  = stories.filter(s => ['ndntkm','tnctsct','vdv','tdxt'].includes(s.id));
---

<Layout frontmatter={{ title: 'Trang chủ' }}>

<!-- ═══════════════════════════════════════════════════════════
     INLINE STYLES — chỉ dùng cho trang chủ
════════════════════════════════════════════════════════════ -->
<style>
  /* ── PAGE LAYOUT ── */
  .home-layout {
    display: grid;
    grid-template-columns: 1fr 256px;
    gap: 28px;
    align-items: start;
    margin-top: 12px;
  }
  @media (max-width: 860px) {
    .home-layout { grid-template-columns: 1fr; }
    .home-sidebar { display: none; }
  }

  /* ── SIDEBAR ── */
  .home-sidebar {
    position: sticky;
    top: 72px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .widget {
    background: rgba(240,249,255,.7);
    border: 1px solid rgba(186,230,253,.65);
    border-radius: 16px;
    padding: 16px 14px;
  }
  [data-theme="dark"] .widget {
    background: rgba(15,23,42,.7);
    border-color: rgba(56,100,138,.5);
  }
  .widget-title {
    font-family: 'Merriweather', serif;
    font-size: .65rem; letter-spacing: 2.5px;
    text-transform: uppercase; color: var(--sky);
    text-align: center; margin-bottom: 12px;
  }

  /* Profile */
  .profile-avatar {
    width: 68px; height: 68px; border-radius: 50%;
    margin: 0 auto 8px; border: 2.5px solid var(--sky-light);
    background: var(--sky-pale);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.8rem; overflow: hidden;
  }
  .profile-name { font-family: 'Merriweather', serif; color: var(--sky-dark); font-size: .88rem; text-align: center; margin-bottom: 3px; }
  .profile-tagline { font-size: .75rem; color: var(--text-mid); font-style: italic; text-align: center; line-height: 1.5; }
  .profile-deco { text-align: center; font-size: .9rem; letter-spacing: 3px; color: var(--sky-light); margin: 6px 0; }

  /* Dark mode toggle */
  .dark-mode-btn {
    display: flex; align-items: center; justify-content: center; gap: 6px;
    width: 100%; padding: 7px 14px;
    background: none; border: 1.5px solid var(--sky-light);
    border-radius: 999px; color: var(--sky);
    font-size: .76rem; cursor: pointer; transition: all .2s;
    font-family: 'Newsreader', serif;
  }
  .dark-mode-btn:hover { background: var(--sky-pale); }

  /* Tag cloud */
  .tag-cloud { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px; }
  .tag-cloud-btn {
    display: inline-block; padding: 2px 9px;
    background: #fff; color: var(--sky);
    border-radius: 999px; font-size: .7rem;
    border: 1px dashed var(--sky-light);
    font-family: 'Newsreader', serif; transition: all .2s; cursor: pointer;
  }
  [data-theme="dark"] .tag-cloud-btn { background: rgba(15,23,42,.6); }
  .tag-cloud-btn:hover, .tag-cloud-btn.active {
    background: var(--sky-pale); border-style: solid; color: var(--sky2);
  }

  /* Category tree */
  .cat-tree { font-size: .78rem; color: var(--text-mid); }
  .cat-tree ul { list-style: none; padding-left: 12px; margin-top: 3px; }
  .cat-tree > ul { padding-left: 0; }
  .cat-tree a { color: var(--text-mid); transition: color .2s; display: block; padding: 2px 0; }
  .cat-tree a:hover { color: var(--sky); }
  .cat-tree summary {
    cursor: pointer; font-size: .78rem; color: var(--sky-dark);
    font-weight: 600; padding: 3px 0; list-style: none;
    display: flex; align-items: center; gap: 5px;
  }
  .cat-tree summary::-webkit-details-marker { display: none; }
  .cat-tree summary::before { content: '▸'; font-size: .58rem; transition: transform .2s; color: var(--sky); }
  .cat-tree details[open] > summary::before { transform: rotate(90deg); }
  .cat-tree li { margin: 2px 0; }
  .cat-count { font-size: .65rem; color: var(--text-dim); margin-left: 4px; }

  /* Quote */
  .quote-body { font-style: italic; font-size: .8rem; color: var(--text-mid); line-height: 1.75; border-left: 3px solid var(--sky-light); padding-left: 10px; margin: 0; }
  .quote-src { font-size: .66rem; color: var(--text-dim); margin-top: 6px; text-align: right; }

  /* ── MAIN ── */
  .home-main { min-width: 0; }

  /* HERO */
  .hero { text-align: center; padding: 20px 0 36px; }
  .hero-logo {
    width: 80px; height: 80px; border-radius: 50%; object-fit: cover;
    border: 3px solid var(--sky-light); box-shadow: 0 4px 20px rgba(14,165,233,.15);
    margin-bottom: 14px;
  }
  .hero-title { font-family: 'Literata', serif; font-size: 1.9rem; font-weight: 600; color: var(--sky-dark); margin: 0 0 4px; }
  .hero-tagline { font-size: .86rem; color: var(--text-dim); font-style: italic; margin: 0 0 20px; }
  .hero-banner { width: 100%; max-height: 190px; object-fit: cover; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,.08); }

  /* NOTICE BOX */
  .notice-box {
    background: rgba(240,249,255,.85);
    border: 1px dashed var(--sky-light);
    border-radius: 12px;
    padding: 14px 18px;
    margin-bottom: 28px;
    font-size: .8rem;
    color: var(--text-mid);
    line-height: 1.7;
  }
  [data-theme="dark"] .notice-box { background: rgba(15,23,42,.5); border-color: rgba(56,100,138,.5); }
  .notice-box h4 { font-size: .78rem; letter-spacing: 1.5px; text-transform: uppercase; color: var(--sky); text-align: left; margin: 0 0 8px; }
  .notice-box ul { margin: 0; padding-left: 16px; }
  .notice-box li { margin-bottom: 3px; }

  /* SECTION HEADER */
  .sec-hd { display: flex; align-items: center; gap: 10px; margin: 40px 0 16px; }
  .sec-hd h2 { font-family: 'Merriweather', serif; font-size: .85rem; color: var(--sky-dark); letter-spacing: 2px; text-transform: uppercase; margin: 0; text-align: left; white-space: nowrap; }
  .sec-line { flex: 1; height: 1px; background: linear-gradient(to right, var(--sky-light), transparent); }
  .sec-link { font-size: .72rem; color: var(--sky); white-space: nowrap; transition: all .2s; }
  .sec-link:hover { text-decoration: underline; }

  /* TAG FILTER */
  .tag-filter {
    display: flex; flex-wrap: wrap; gap: 5px;
    margin-bottom: 20px; align-items: center;
  }
  .filter-label { font-size: .64rem; letter-spacing: 2px; text-transform: uppercase; color: var(--text-dim); margin-right: 2px; flex-shrink: 0; }
  .filter-btn {
    padding: 3px 13px; border: 1.5px solid var(--sky-light);
    border-radius: 999px; font-size: .74rem;
    color: var(--text-mid); cursor: pointer; transition: all .2s;
    background: #fff; font-family: 'Newsreader', serif; user-select: none;
  }
  [data-theme="dark"] .filter-btn { background: rgba(15,23,42,.6); }
  .filter-btn:hover { border-color: var(--sky); color: var(--sky); background: var(--sky-pale); }
  .filter-btn.active { background: var(--sky); color: #fff; border-color: var(--sky); }
  .filter-clear {
    font-size: .66rem; color: var(--text-dim); cursor: pointer;
    padding: 3px 8px; transition: all .2s; border-radius: 999px;
    margin-left: 2px; background: none; border: none; font-family: 'Newsreader', serif;
  }
  .filter-clear:hover { color: var(--sky); background: var(--sky-pale); }
  .filter-count {
    font-size: .66rem; color: var(--sky); background: var(--sky-pale);
    border: 1px solid var(--sky-light); padding: 2px 8px;
    border-radius: 999px; margin-left: auto; white-space: nowrap;
  }

  /* ── STORY CARDS ── */
  .story-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 540px) { .story-grid { grid-template-columns: 1fr; } }

  .story-card {
    border: 1px solid rgba(186,230,253,.5); border-radius: 12px;
    overflow: hidden; background: #fff; transition: all .2s;
    display: flex; flex-direction: column;
  }
  [data-theme="dark"] .story-card { background: rgba(15,23,42,.8); border-color: rgba(56,100,138,.4); }
  .story-card:hover { box-shadow: 0 4px 15px rgba(2,132,199,.12); transform: translateY(-3px); }
  .story-card.hidden { display: none; }

  .card-img-wrap { position: relative; }
  .card-cover { width: 100%; height: 170px; object-fit: cover; display: block; background: var(--sky-pale); }
  .card-cat-badge {
    position: absolute; top: 9px; left: 9px;
    font-size: .6rem; letter-spacing: 1.2px; text-transform: uppercase;
    padding: 2px 9px; border-radius: 999px; font-weight: 600;
    backdrop-filter: blur(8px);
  }
  .card-cat-badge.ongoing   { background: rgba(254,249,195,.9); color: #854d0e; }
  .card-cat-badge.completed { background: rgba(220,252,231,.9); color: #166534; }
  .card-cat-badge.upcoming  { background: rgba(241,245,249,.85); color: #64748b; }

  .card-body { padding: 12px 14px 14px; flex: 1; display: flex; flex-direction: column; }
  .card-title { font-family: 'Merriweather', serif; font-size: .88rem; color: var(--sky-dark); margin: 0 0 2px; line-height: 1.35; }
  .card-author { font-size: .7rem; color: var(--text-dim); font-style: italic; margin: 0 0 7px; }
  .card-desc { font-size: .8rem; color: var(--text-mid); line-height: 1.6; margin: 0 0 8px; flex: 1; }
  .card-tags { display: flex; flex-wrap: wrap; gap: 3px; margin-bottom: 8px; }
  .card-tag { font-size: .62rem; padding: 2px 7px; border: 1px solid var(--sky-light); border-radius: 999px; color: var(--sky); background: var(--sky-pale); }
  .card-progress { font-size: .68rem; color: var(--text-dim); margin-bottom: 9px; }
  .card-prog-bar { height: 3px; background: rgba(186,230,253,.35); border-radius: 2px; overflow: hidden; margin-top: 3px; }
  .card-prog-fill { height: 100%; background: var(--sky-light); border-radius: 2px; transition: width .5s ease; }
  .card-btns { display: flex; gap: 6px; }
  .card-btn-outline {
    flex: 1; text-align: center; padding: 6px 6px;
    border: 1.5px solid var(--sky-light); border-radius: 999px;
    color: var(--sky-dark); font-size: .74rem; transition: all .2s;
  }
  .card-btn-outline:hover { background: var(--sky-pale); color: var(--sky); }
  .card-btn-fill {
    flex: 1; text-align: center; padding: 6px 6px;
    background: var(--sky); border: 1.5px solid var(--sky);
    border-radius: 999px; color: #fff; font-size: .74rem; transition: all .2s;
  }
  .card-btn-fill:hover { background: var(--sky2); border-color: var(--sky2); }

  /* UPCOMING BOX */
  .upcoming-box {
    background: var(--sky-pale); border: 1.5px dashed var(--sky-light);
    border-radius: 12px; padding: 20px 22px; text-align: center; margin-bottom: 20px;
  }
  .upcoming-box p { color: var(--text-mid); font-size: .86rem; font-style: italic; margin: 0 0 8px; }

  /* ══════════════════════════════════════════════
     READING PROGRESS BAR (thanh tiến trình đọc)
     - Chỉ hiện trên trang chương (isNovelPage)
     - Ở đây ta ẩn vì trang chủ không cần
  ══════════════════════════════════════════════ */
  #reading-progress {
    display: none; /* trang chủ ẩn hoàn toàn */
  }

  /* ══════════════════════════════════════════════
     INLINE COMMENT SYSTEM (kiểu Wattpad / Docs)
  ══════════════════════════════════════════════ */

  /* Tooltip bình luận inline - áp dụng cho trang đọc truyện (chương) */
  .inline-comment-wrap {
    position: relative;
    display: inline;
  }
  /* Đoạn được highlight khi có comment */
  .highlight-comment {
    background: linear-gradient(180deg, transparent 60%, rgba(14,165,233,.25) 60%);
    cursor: pointer;
    border-bottom: 1.5px dashed var(--sky-light);
    transition: background .2s;
  }
  .highlight-comment:hover {
    background: linear-gradient(180deg, transparent 50%, rgba(14,165,233,.4) 50%);
  }
  /* Bubble icon ở lề */
  .comment-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 20px; height: 20px; border-radius: 50%;
    background: var(--sky); color: #fff;
    font-size: .55rem; font-weight: 700;
    vertical-align: super; margin-left: 2px; cursor: pointer;
    transition: transform .2s, box-shadow .2s;
    box-shadow: 0 2px 6px rgba(14,165,233,.3);
    position: relative; top: -4px;
  }
  .comment-icon:hover { transform: scale(1.15); box-shadow: 0 4px 10px rgba(14,165,233,.4); }

  /* Popup bình luận inline */
  .comment-popup {
    position: absolute;
    left: 0; top: calc(100% + 8px);
    width: 300px; max-width: 90vw;
    background: #fff;
    border: 1px solid rgba(186,230,253,.8);
    border-radius: 14px;
    box-shadow: 0 8px 32px rgba(2,132,199,.15);
    padding: 14px 16px;
    z-index: 200;
    font-family: 'Newsreader', serif;
    font-style: normal;
    opacity: 0; pointer-events: none;
    transform: translateY(6px);
    transition: opacity .2s, transform .2s;
  }
  [data-theme="dark"] .comment-popup {
    background: #0f172a;
    border-color: rgba(56,100,138,.6);
    box-shadow: 0 8px 32px rgba(0,0,0,.4);
  }
  .comment-popup.open {
    opacity: 1; pointer-events: auto; transform: translateY(0);
  }
  /* Mũi tên nhỏ */
  .comment-popup::before {
    content: '';
    position: absolute; top: -7px; left: 18px;
    width: 13px; height: 13px;
    background: #fff; border-left: 1px solid rgba(186,230,253,.8); border-top: 1px solid rgba(186,230,253,.8);
    transform: rotate(45deg);
  }
  [data-theme="dark"] .comment-popup::before {
    background: #0f172a;
    border-color: rgba(56,100,138,.6);
  }
  /* Header popup */
  .cp-header { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
  .cp-avatar {
    width: 28px; height: 28px; border-radius: 50%;
    background: var(--sky-pale); border: 1.5px solid var(--sky-light);
    display: flex; align-items: center; justify-content: center; font-size: .75rem;
  }
  .cp-meta { flex: 1; }
  .cp-name { font-size: .72rem; font-weight: 700; color: var(--sky-dark); display: block; }
  .cp-time { font-size: .64rem; color: var(--text-dim); }
  .cp-close {
    background: none; border: none; color: var(--text-dim);
    cursor: pointer; font-size: .9rem; line-height: 1; padding: 2px 4px;
    border-radius: 4px; transition: background .15s;
  }
  .cp-close:hover { background: var(--sky-pale); color: var(--sky); }
  /* Nội dung comment */
  .cp-text { font-size: .82rem; color: var(--text-mid); line-height: 1.65; margin-bottom: 10px; }
  /* Input thêm comment */
  .cp-input-row { display: flex; gap: 6px; align-items: flex-end; }
  .cp-input {
    flex: 1; resize: none; border: 1px solid var(--sky-light);
    border-radius: 10px; padding: 7px 10px; font-family: 'Newsreader', serif;
    font-size: .78rem; color: var(--text-mid); background: var(--sky-pale);
    line-height: 1.5; outline: none; transition: border-color .2s;
    min-height: 36px; max-height: 80px;
  }
  [data-theme="dark"] .cp-input { background: rgba(15,23,42,.6); border-color: rgba(56,100,138,.5); color: #cbd5e1; }
  .cp-input:focus { border-color: var(--sky); }
  .cp-send {
    padding: 7px 12px; background: var(--sky); color: #fff;
    border: none; border-radius: 10px; font-size: .74rem;
    cursor: pointer; transition: background .2s; white-space: nowrap;
    font-family: 'Newsreader', serif;
  }
  .cp-send:hover { background: var(--sky2); }
  /* Reactions */
  .cp-reactions { display: flex; gap: 5px; margin-top: 8px; flex-wrap: wrap; }
  .cp-react-btn {
    padding: 2px 8px; border-radius: 999px;
    border: 1px solid var(--sky-light); background: var(--sky-pale);
    font-size: .72rem; cursor: pointer; transition: all .15s; color: var(--text-mid);
  }
  .cp-react-btn:hover, .cp-react-btn.reacted { background: var(--sky); color: #fff; border-color: var(--sky); }

  /* ── NÚT COMMENT Ở LỀ PHẢI (cho trang chương) ── */
  .margin-comment-btn {
    position: absolute; right: -48px; top: 0;
    width: 32px; height: 32px; border-radius: 50%;
    background: #fff; border: 1.5px solid var(--sky-light);
    color: var(--sky); font-size: .8rem; cursor: pointer;
    display: none; align-items: center; justify-content: center;
    box-shadow: 0 2px 8px rgba(14,165,233,.12); transition: all .2s;
  }
  .margin-comment-btn:hover { background: var(--sky); color: #fff; }
