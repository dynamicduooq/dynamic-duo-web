---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const allPosts = Object.values(import.meta.glob('../**/*.md', { eager: true }));
  const uniqueTags = [...new Set(allPosts.map((post: any) => post.frontmatter?.tags || []).flat())];

  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts.filter((post: any) =>
      post.frontmatter?.tags?.includes(tag) &&
      post.url &&
      !post.url.endsWith('/ca-duoi-nuoc') &&
      !post.url.endsWith('/ca-tren-ban')
    );
    return { params: { tag }, props: { posts: filteredPosts } };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;

// Lấy tất cả tag từ các bài viết đã lọc để hiển thị bộ lọc AND
const allPosts = Object.values(import.meta.glob('../**/*.md', { eager: true }));
const allTags = [...new Set(
  allPosts
    .filter((p: any) => p.url && !p.url.endsWith('/ca-duoi-nuoc') && !p.url.endsWith('/ca-tren-ban'))
    .flatMap((p: any) => p.frontmatter?.tags || [])
)].sort();
---

<Layout title={`Thể loại: ${tag}`}>
  <h1 style="font-family:'Merriweather',serif;color:var(--sky-dark);border-bottom:2px dashed var(--sky-light);padding-bottom:15px;margin-bottom:20px;">
    🏷️ #{tag}
  </h1>

  <!-- BỘ LỌC AND -->
  <div id="tag-filter-wrap" style="margin-bottom:28px;">
    <p style="font-size:.78rem;color:var(--text-dim);letter-spacing:.5px;margin-bottom:10px;">
      ✦ Chọn thêm tag để lọc (AND — phải đáp ứng đủ):
    </p>
    <div id="tag-filter-list" style="display:flex;flex-wrap:wrap;gap:6px;">
      {allTags.map((t: string) => (
        <button
          class={`tag-filter-btn${t === tag ? ' active locked' : ''}`}
          data-tag={t}
          style={t === tag ? 'pointer-events:none;opacity:.6;' : ''}
        >
          #{t}
        </button>
      ))}
    </div>
    <p id="active-tags-label" style="font-size:.76rem;color:var(--sky);margin-top:10px;display:none;"></p>
  </div>

  <!-- DANH SÁCH TRUYỆN -->
  <ul id="post-list" style="padding:0;margin:0;">
    {posts.map((post: any) => (
      <li
        class="post-item"
        data-tags={JSON.stringify(post.frontmatter?.tags || [])}
        style="margin:20px 0;list-style:none;border-bottom:1px dashed var(--sky-pale);padding-bottom:15px;"
      >
        <a href={post.url} style="font-size:1.1rem;font-weight:bold;color:var(--sky2);font-family:'Merriweather',serif;">
          {post.frontmatter?.title || 'Truyện'}
        </a>
        {post.frontmatter?.date && (
          <p style="font-size:13px;color:var(--text-dim);margin-top:5px;">
            📅 {new Date(post.frontmatter.date).toLocaleDateString('vi-VN')}
          </p>
        )}
        <div style="margin-top:6px;">
          {(post.frontmatter?.tags || []).map((t: string) => (
            <a href={`/dynamic-duo-web/tags/${t}`} class="tag-badge" style="font-size:.75rem;">#{t}</a>
          ))}
        </div>
      </li>
    ))}
  </ul>

  <p id="empty-msg" style="display:none;font-style:italic;color:var(--text-dim);text-align:center;margin-top:40px;">
    𓆝 Không có truyện nào đáp ứng đủ tất cả các tag đã chọn.
  </p>

  <style>
    .tag-filter-btn {
      padding: 4px 13px; border: 1.5px solid var(--sky-light);
      border-radius: 999px; font-size: .78rem; cursor: pointer;
      color: var(--text-mid); background: var(--sky-pale);
      transition: all .18s ease; font-family: 'Newsreader', serif;
    }
    .tag-filter-btn:hover { border-color: var(--sky); color: var(--sky); }
    .tag-filter-btn.active { background: var(--sky); color: #fff; border-color: var(--sky); }
  </style>

  <script is:inline define:vars={{ initialTag: tag }}>
    const activeTags = new Set([initialTag]);

    const btns = document.querySelectorAll('.tag-filter-btn:not(.locked)');
    const items = document.querySelectorAll('.post-item');
    const emptyMsg = document.getElementById('empty-msg');
    const label = document.getElementById('active-tags-label');

    // Đánh dấu tag hiện tại là active
    document.querySelectorAll('.tag-filter-btn').forEach(btn => {
      if (btn.dataset.tag === initialTag) btn.classList.add('active');
    });

    function applyFilter() {
      let visible = 0;
      items.forEach(item => {
        const tags = JSON.parse(item.dataset.tags || '[]');
        const match = [...activeTags].every(t => tags.includes(t));
        item.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      emptyMsg.style.display = visible === 0 ? '' : 'none';

      if (activeTags.size > 1) {
        label.style.display = '';
        label.textContent = '✦ Đang lọc: ' + [...activeTags].map(t => '#' + t).join(' + ');
      } else {
        label.style.display = 'none';
      }
    }

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const t = btn.dataset.tag;
        if (activeTags.has(t)) {
          activeTags.delete(t);
          btn.classList.remove('active');
        } else {
          activeTags.add(t);
          btn.classList.add('active');
        }
        applyFilter();
      });
    });

    applyFilter();
  </script>
</Layout>