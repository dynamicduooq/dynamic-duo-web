---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const allPosts = Object.values(import.meta.glob('../**/*.md', { eager: true }));
  const uniqueTags = [...new Set(allPosts.map((post: any) => post.frontmatter?.tags || []).flat())];

  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts.filter((post: any) =>
        post.frontmatter?.tags?.includes(tag) &&
        post.url &&
        !post.url.endsWith('/ca-duoi-nuoc') &&
        !post.url.endsWith('/ca-tren-ban')
    );
    return {
      params: { tag },
      props: { posts: filteredPosts }
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Layout title={`Thể loại: ${tag}`} fullWidth={true}>
  <div style="width:92%;max-width:860px;margin:40px auto 80px;background:var(--bg-content);padding:40px 48px;border-radius:var(--r-lg);box-shadow:var(--sh-soft);border:1px solid var(--border);">
  <style>
    .tag-page-header {
      text-align: center;
      margin-bottom: 32px;
      padding-bottom: 20px;
      border-bottom: 2px dashed var(--sky-light);
    }
    .tag-page-header h1 {
      font-family: 'Merriweather', serif;
      color: var(--sky-dark);
      font-size: 1.5rem;
      margin: 0 0 6px;
      text-align: center;
    }
    .tag-page-header p {
      font-size: .82rem;
      color: var(--text-dim);
      font-style: italic;
      margin: 0;
      text-align: center;
    }
    .tag-post-list {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding: 0;
      margin: 0;
    }
    .tag-post-item {
      list-style: none;
      border-bottom: 1px dashed var(--border);
      padding: 16px 0;
    }
    .tag-post-item:last-child { border-bottom: none; }
    .tag-post-link {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      text-decoration: none;
      transition: var(--t);
    }
    .tag-post-link:hover .tpl-title { color: var(--sky); }
    .tpl-title {
      font-family: 'Merriweather', serif;
      font-size: 1rem;
      font-weight: 700;
      color: var(--sky2);
      transition: var(--t);
      line-height: 1.4;
    }
    .tpl-date {
      font-size: .75rem;
      color: var(--text-dim);
      white-space: nowrap;
      margin-top: 3px;
      font-family: sans-serif;
    }
    .tag-empty {
      font-style: italic;
      color: var(--text-dim);
      text-align: center;
      margin-top: 40px;
      font-size: .9rem;
    }
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: .8rem;
      color: var(--sky);
      border: 1.5px solid var(--border);
      border-radius: var(--r-pill);
      padding: 6px 14px;
      margin-bottom: 28px;
      transition: var(--t);
    }
    .back-link:hover { background: var(--sky-pale); border-color: var(--sky); }
  </style>

  <a href="/dynamic-duo-web/" class="back-link">← Về trang chủ</a>

  <div class="tag-page-header">
    <h1>🏷️ #{tag}</h1>
    <p>{posts.length} chương / truyện thuộc thể loại này</p>
  </div>

  {posts.length > 0 ? (
    <ul class="tag-post-list">
      {posts.map((post: any) => (
        <li class="tag-post-item">
          <a href={post.url} class="tag-post-link">
            <span class="tpl-title">{post.frontmatter?.title || 'Chương truyện'}</span>
            {post.frontmatter?.date && (
              <span class="tpl-date">
                📅 {new Date(post.frontmatter.date).toLocaleDateString('vi-VN')}
              </span>
            )}
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="tag-empty">𓆝 Chưa có chương truyện nào thuộc thể loại này.</p>
  )}
</Layout>