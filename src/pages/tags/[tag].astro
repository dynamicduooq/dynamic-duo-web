---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  // Quét toàn bộ file markdown nằm trong thư mục src/pages
  const allPosts = Object.values(import.meta.glob('../**/*.md', { eager: true }));
  
  // Quét và lọc ra danh sách các tag độc nhất
  const uniqueTags = [...new Set(allPosts.map((post: any) => post.frontmatter?.tags || []).flat())];

  // Sinh đường dẫn tĩnh cho từng tag
  return uniqueTags.map((tag) => {
    // Lọc các bài viết chứa tag này và chỉ lấy những chương truyện thực tế (loại trừ file danh mục index)
    const filteredPosts = allPosts.filter((post: any) => 
        post.frontmatter?.tags?.includes(tag) && 
        post.url && 
        !post.url.endsWith('/ca-duoi-nuoc') && 
        !post.url.endsWith('/ca-tren-ban')
    );
    
    return { 
      params: { tag }, 
      props: { posts: filteredPosts } 
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---
<Layout title={`Thể loại: ${tag}`}>
  <div style="margin-bottom: 30px;">
      <h1 style="font-family: 'Merriweather', serif; color: var(--sky-dark); border-bottom: 2px dashed var(--sky-light); padding-bottom: 15px; margin-bottom: 30px; text-align: left;">
          🏷️ Thể loại: #{tag}
      </h1>
      
      <ul style="padding: 0; margin: 0;">
        {posts.map((post: any) => (
          <li style="margin: 20px 0; list-style: none; border-bottom: 1px dashed var(--sky-pale); padding-bottom: 15px; display: flex; flex-direction: column; align-items: flex-start;">
            <a href={post.url} style="font-size: 1.15rem; font-weight: bold; color: var(--sky2); text-decoration: none; transition: var(--t); font-family: 'Merriweather', serif;">
              {post.frontmatter?.title || 'Chương truyện'}
            </a>
            
            {post.frontmatter?.date && (
                <p style="font-size: 13px; color: var(--text-dim); margin-top: 6px; margin-bottom: 0; font-family: sans-serif;">
                    📅 {new Date(post.frontmatter.date).toLocaleDateString('vi-VN')}
                </p>
            )}
          </li>
        ))}
      </ul>
      
      {posts.length === 0 && (
          <p style="font-style: italic; color: var(--text-dim); text-align: center; margin-top: 40px;">𓆝 Chưa có chương truyện nào thuộc thể loại này.</p>
      )}
  </div>
</Layout>