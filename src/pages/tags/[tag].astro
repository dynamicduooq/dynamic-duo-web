---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const allPosts = Object.values(
    import.meta.glob('../**/*.md', { eager: true })
  ) as any[];

  const uniqueTags = [
    ...new Set(
      allPosts.flatMap((p: any) => p.frontmatter?.tags || []).filter(Boolean)
    ),
  ] as string[];

  return uniqueTags.map((tag) => {
    const filtered = allPosts.filter(
      (p: any) =>
        p.frontmatter?.tags?.includes(tag) &&
        p.url &&
        p.frontmatter?.chuong !== undefined &&
        p.frontmatter?.chuong !== 0
    );
    // Group by truyen_id
    const grouped: Record<string, any[]> = {};
    for (const p of filtered) {
      const id = p.frontmatter?.truyen_id || 'other';
      if (!grouped[id]) grouped[id] = [];
      grouped[id].push(p);
    }
    for (const id in grouped) {
      grouped[id].sort((a, b) => (a.frontmatter?.chuong ?? 999) - (b.frontmatter?.chuong ?? 999));
    }
    return { params: { tag }, props: { posts: filtered, grouped } };
  });
}

const { tag } = Astro.params;
const { posts, grouped } = Astro.props as { posts: any[], grouped: Record<string, any[]> };

const storyNames: Record<string, string> = {
  ndntkm:  'Nếu đêm nay trời không mưa',
  tnctsct: 'Tôi nghĩ chúng tôi sắp chia tay',
  qhbcp:   'Quan hệ bạn cùng phòng',
  hcdh:    'Hạ cháy đồng hoang',
  vdv:     'Vật dễ vỡ',
  tdxt:    'Thiếu đế xuân tâm',
};
---

<Layout frontmatter={{ title: `#${tag}` }} fullWidth={true}>
  <style>
    .tag-hero { text-align:center; margin-bottom:28px; }
    .tag-hero-badge {
      display:inline-block; padding:6px 22px;
      background:var(--sky-pale); border:2px solid var(--sky-light);
      border-radius:var(--r-pill); font-size:1rem; color:var(--sky-dark);
      font-family:'Merriweather',serif; margin-bottom:8px;
    }
    .tag-count { font-size:.82rem; color:var(--text-dim); }
    .group-hd {
      font-family:'Literata',serif; font-size:.88rem; font-weight:600;
      color:var(--sky-dark); padding:9px 14px;
      background:var(--sky-pale); border-radius:var(--r-sm);
      margin:20px 0 8px; border-left:3px solid var(--sky);
    }
    .chap-row {
      display:flex; align-items:center; gap:10px;
      padding:9px 14px; border-bottom:1px dashed rgba(186,230,253,.35);
      color:var(--text-main); transition:var(--t); border-radius:var(--r-sm);
    }
    .chap-row:hover { background:var(--sky-pale); color:var(--sky); }
    .chap-row:last-child { border-bottom:none; }
    .chap-num { font-size:.7rem; color:var(--text-dim); width:32px; flex-shrink:0; font-family:monospace; }
    .chap-name { font-size:.88rem; flex:1; }
    .back-link { display:inline-flex; align-items:center; gap:5px; font-size:.8rem; color:var(--sky); margin-bottom:20px; }
    .back-link:hover { text-decoration:underline; }
    .empty { text-align:center; padding:40px; color:var(--text-dim); font-style:italic; }
    .all-tags-row { display:flex; flex-wrap:wrap; gap:5px; margin-top:28px; padding-top:20px; border-top:1px dashed var(--sky-light); }
    .all-tags-row a {
      padding:3px 12px; border:1.5px solid var(--sky-light); border-radius:var(--r-pill);
      font-size:.74rem; color:var(--sky); transition:var(--t);
    }
    .all-tags-row a:hover { background:var(--sky-pale); }
  </style>

  <a href="/dynamic-duo-web/" class="back-link">← Trang chủ</a>

  <div class="tag-hero">
    <div class="tag-hero-badge">🏷️ #{tag}</div>
    <div class="tag-count">{posts.length} chương thuộc thể loại này</div>
  </div>

  {posts.length === 0 && (
    <div class="empty">𓆝 Chưa có chương nào thuộc thể loại này.</div>
  )}

  {Object.entries(grouped).map(([id, chaps]) => (
    <div>
      <div class="group-hd">📖 {storyNames[id] || id} — {chaps.length} chương</div>
      {(chaps as any[]).map((p: any) => (
        <a href={p.url} class="chap-row">
          <span class="chap-num">C{p.frontmatter?.chuong}</span>
          <span class="chap-name">{p.frontmatter?.title || `Chương ${p.frontmatter?.chuong}`}</span>
        </a>
      ))}
    </div>
  ))}

  <div class="all-tags-row">
    <span style="font-size:.72rem;color:var(--text-dim);letter-spacing:1px;text-transform:uppercase;align-self:center;margin-right:4px">Tags khác:</span>
  </div>
</Layout>