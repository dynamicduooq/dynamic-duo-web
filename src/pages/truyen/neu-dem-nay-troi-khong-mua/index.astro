---
import Layout from '../../../layouts/Layout.astro';

const allPosts = Object.values(
  import.meta.glob('./*.md', { eager: true })
) as any[];

const chapters = allPosts
  .filter((p) => p.frontmatter?.chuong && p.frontmatter.chuong !== 0)
  .sort((a, b) => (a.frontmatter?.chuong ?? 999) - (b.frontmatter?.chuong ?? 999));
  const tong_so_chuong = 74; // Điền tổng số chương của truyện này (nếu chưa rõ thì để 9999)
const hoan_thanh = true;   // Nếu đã dịch xong 100%, đổi thành true
---

<Layout frontmatter={{
  title: 'Nếu đêm nay trời không mưa',
  description: 'Tình cờ gặp lại mối tình đầu từng đá anh — lần này thật sự không còn yêu nữa.',
  tags: ['đam mỹ', 'hiện đại', 'HE', 'gương vỡ lại lành', 'drama motip cũ', 'thủy tinh']
}}>
  <style>
    .story-cover { width: 200px; border-radius: 12px; box-shadow: var(--sh-card); display: block; margin: 0 auto 28px; }
    .story-meta { text-align: center; margin-bottom: 20px; }
    .story-meta-row { font-size: .9rem; color: var(--text-mid); margin: 4px 0; }
    .story-meta-row strong { color: var(--sky-dark); }
    .status-badge {
      display: inline-block; padding: 3px 14px; border-radius: var(--r-pill);
      font-size: .72rem; letter-spacing: 1.5px; text-transform: uppercase;
      font-weight: 600; background: #dcfce7; color: #166534; margin: 8px 0 16px;
    }
    .progress-bar-wrap { max-width: 320px; margin: 12px auto; }
    .progress-label { font-size: .76rem; color: var(--text-dim); text-align: center; margin-bottom: 5px; }
    .progress-bar { height: 6px; background: rgba(186,230,253,.4); border-radius: 3px; overflow: hidden; }
    .progress-fill { height: 100%; background: linear-gradient(to right, var(--sky-light), var(--sky)); border-radius: 3px; }
    .intro-block {
      background: var(--sky-pale); border: 1px solid rgba(186,230,253,.5);
      border-radius: var(--r-md); padding: 20px 24px; margin: 24px 0;
      font-size: .9rem; color: var(--text-mid); line-height: 1.8;
    }
    .intro-block h4 { font-size: .8rem; letter-spacing: 2px; text-transform: uppercase; color: var(--sky-dark); text-align: left; margin: 0 0 10px; }
    .intro-block p { margin: 0 0 8px; }
    .intro-block p:last-child { margin-bottom: 0; }
    .char-grid { display: grid; grid-template-columns: 1fr auto 1fr; gap: 10px; align-items: center; text-align: center; margin: 20px 0; }
    .char-name { font-family: 'Merriweather', serif; font-size: .95rem; color: var(--sky-dark); }
    .char-role { font-size: .72rem; color: var(--text-dim); letter-spacing: 1px; text-transform: uppercase; margin-top: 3px; }
    .char-divider { font-size: 1.2rem; color: var(--sky-light); }
    .toc-section { margin-top: 32px; }
    .toc-title {
      font-family: 'Merriweather', serif; font-size: .88rem; color: var(--sky-dark);
      letter-spacing: 2px; text-transform: uppercase; text-align: center;
      margin-bottom: 16px; padding-bottom: 10px;
      border-bottom: 1px dashed var(--sky-light);
    }
    .toc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
    @media (max-width: 480px) { .toc-grid { grid-template-columns: 1fr; } }
    .toc-item {
      display: flex; align-items: center; gap: 8px; padding: 8px 12px;
      border-radius: var(--r-sm); font-size: .84rem; color: var(--text-mid);
      transition: var(--t); border: 1px solid transparent;
    }
    .toc-item:hover { background: var(--sky-pale); color: var(--sky); border-color: rgba(186,230,253,.5); }
    .toc-num { font-size: .7rem; color: var(--text-dim); width: 28px; flex-shrink: 0; font-family: monospace; }
    .read-btn {
      display: block; text-align: center; margin: 28px auto 0;
      padding: 12px 32px; background: var(--sky); color: #fff;
      border-radius: var(--r-pill); font-size: .9rem; font-family: 'Newsreader', serif;
      transition: var(--t); max-width: 220px;
    }
    .read-btn:hover { background: var(--sky2); transform: translateY(-2px); }
  </style>

  <img src="/dynamic-duo-web/images/biandntkm.png" alt="Bìa truyện" class="story-cover"
    onerror="this.src='/dynamic-duo-web/images/frontpage.png'" />

  <div class="story-meta">
    <h2 style="margin:0 0 4px;font-size:1.3rem">Nếu đêm nay trời không mưa</h2>
    <p style="font-size:.8rem;color:var(--text-dim);font-style:italic;margin:0 0 10px">如果今夜不下雨</p>
    <span class="status-badge">✅ Hoàn thành</span>
    <div class="story-meta-row"><strong>Tác giả:</strong> Tam Đạo</div>
    <div class="story-meta-row"><strong>Editor:</strong> Dynamic Duo</div>
    <div class="story-meta-row"><strong>Thể loại:</strong> Đam mỹ · Hiện đại · HE · Nien thuong</div>
    <div class="progress-bar-wrap">
      <div class="progress-label">📖 Tiến độ: 100% ({chapters.length} chương)</div>
      <div class="progress-bar"><div class="progress-fill" style="width:100%"></div></div>
    </div>
  </div>

  <div class="char-grid">
    <div><div class="char-name">Hạ Tranh</div><div class="char-role">Công</div></div>
    <div class="char-divider">✧ ✖ ✧</div>
    <div><div class="char-name">Lâm Hướng Bắc</div><div class="char-role">Thụ</div></div>
  </div>

  <div class="intro-block">
    <h4>🌧️ Giới thiệu</h4>
    <p>Đó là một đêm mưa, trong buổi tụ họp với đồng nghiệp, Hạ Tranh tình cờ gặp lại Lâm Hướng Bắc – người từng đá anh nhiều năm trước.</p>
    <p>Mười năm trước, Lâm Hướng Bắc từng ôm mộng lớn. Mười năm sau, chỉ một người thực hiện được ước mơ thuở thiếu thời.</p>
    <p>Lâm Hướng Bắc rất giỏi nói dối. Thật ra, cuộc sống của cậu vô cùng tệ. Cậu nói đã quên đi quá khứ, nhưng đó chỉ là lời nói dối trắng trợn.</p>
  </div>

  <div class="intro-block" style="margin-top:12px">
    <h4>💫 Góc dò mìn</h4>
    <p>Biển sâu nước lạnh, hãy mặc áo phao và đọc kỹ trước khi lặn nhé!</p>
    <p>· Thụ từng ngồi tù.<br/>· Công thụ xa nhau mười năm đều từng quen người khác (chưa lên giường).<br/>· Miệng công thụ cứng hơn kim cương.</p>
  </div>

  {chapters.length > 0 && (
    <a href={chapters[0].url} class="read-btn">Đọc từ Chương 1 →</a>
  )}

  <div class="toc-section">
    <div class="toc-title">🌊 Mục lục ({chapters.length} chương)</div>
    <div class="toc-grid">
      {chapters.map((c) => (
        <a href={c.url} class="toc-item">
          <span class="toc-num">C{c.frontmatter?.chuong}</span>
          <span>{c.frontmatter?.title || `Chương ${c.frontmatter?.chuong}`}</span>
        </a>
      ))}
    </div>
  </div>
<div class="story-review-section" data-truyen-id="ndntkm">
  <div class="sr-header">
    <h3>⭐ Đánh giá truyện</h3>
    <div class="sr-stats">
      <span class="sr-avg" id="srAvg">0.0</span>
      <span class="sr-stars-display" id="srStarsDisplay">☆☆☆☆☆</span>
      <span class="sr-count" id="srCount">(0 đánh giá)</span>
    </div>
  </div>

  <div class="sr-form">
    <div class="sr-star-select" id="srStarSelect">
      <span data-val="1">★</span><span data-val="2">★</span><span data-val="3">★</span><span data-val="4">★</span><span data-val="5" class="active">★</span>
    </div>
    <input class="sr-inp" id="srName" placeholder="Tên của bạn (Tùy chọn)" autocomplete="off" />
    <textarea class="sr-textarea" id="srText" placeholder="Nêu cảm nhận của bạn về bộ truyện này nhé..." rows="3"></textarea>
    <div style="text-align:right">
      <button class="sr-submit-btn" id="srSubmit">Gửi đánh giá</button>
    </div>
  </div>

  <div class="sr-list" id="srList">
    <div style="text-align:center; padding: 20px; color: var(--text-dim); font-style: italic;">Đang tải đánh giá...</div>
  </div>
</div>

<style>
  /* Giao diện khu vực Đánh giá */
  .story-review-section {
    margin-top: 40px; padding-top: 24px;
    border-top: 2px dashed var(--sky-light);
    font-family: var(--read-ff, 'Newsreader', serif);
  }
  [data-theme="dark"] .story-review-section { border-color: rgba(126,200,227,0.2); }
  
  .sr-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 10px;}
  .sr-header h3 { margin: 0; font-size: 1.2rem; color: var(--sky-dark); font-family: 'Merriweather', serif; font-weight: bold;}
  [data-theme="dark"] .sr-header h3 { color: #a8daf0; }
  .sr-stats { display: flex; align-items: center; gap: 8px; }
  .sr-avg { font-weight: bold; font-size: 1.8rem; color: var(--sky-dark); line-height: 1;}
  [data-theme="dark"] .sr-avg { color: #a8daf0; }
  .sr-stars-display { color: #fbbf24; font-size: 1.2rem; letter-spacing: 2px; }
  .sr-count { font-size: 0.85rem; color: var(--text-dim); font-style: italic;}
  
  /* Form gửi đánh giá */
  .sr-form { background: var(--sky-pale); padding: 18px; border-radius: 12px; margin-bottom: 24px; border: 1px solid rgba(186,230,253,.4); }
  [data-theme="dark"] .sr-form { background: rgba(15,35,54,.6); border-color: rgba(126,200,227,.15); }
  .sr-star-select { font-size: 2rem; color: #d1d5db; cursor: pointer; user-select: none; text-align: center; margin-bottom: 12px; letter-spacing: 5px;}
  .sr-star-select span { transition: color 0.2s; }
  .sr-star-select span:hover, .sr-star-select span.active { color: #fbbf24; }
  .sr-inp, .sr-textarea { width: 100%; padding: 10px 14px; border: 1.5px solid var(--sky-light); border-radius: 8px; font-size: .85rem; font-family: inherit; color: var(--text-main); background: var(--cream); outline: none; margin-bottom: 10px; transition: all 0.2s;}
  .sr-inp:focus, .sr-textarea:focus { border-color: var(--sky); box-shadow: 0 0 0 3px rgba(14,165,233,0.1); }
  [data-theme="dark"] .sr-inp, [data-theme="dark"] .sr-textarea { background: #091620; border-color: #1e4a6a; color: #F3F9FF; }
  .sr-submit-btn { padding: 8px 20px; background: #f59e0b; color: #fff; border: none; border-radius: 99px; font-size: .85rem; cursor: pointer; font-family: inherit; font-weight: bold; transition: all 0.2s; }
  .sr-submit-btn:hover { background: #d97706; transform: translateY(-2px); box-shadow: 0 4px 10px rgba(245,158,11,0.3); }
  .sr-submit-btn:disabled { opacity: 0.5; pointer-events: none; }

  /* Danh sách đánh giá */
  .sr-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
  .sr-item { background: var(--bg-card); border: 1px solid var(--sky-light); padding: 16px; border-radius: 12px; transition: transform 0.2s, box-shadow 0.2s; box-shadow: 0 2px 8px rgba(0,0,0,0.02);}
  .sr-item:hover { transform: translateY(-3px); box-shadow: 0 6px 16px rgba(2,132,199,0.08); }
  [data-theme="dark"] .sr-item { border-color: rgba(126,200,227,0.15); background: rgba(10,25,45,0.4); }
  .sr-item-hd { display: flex; justify-content: space-between; margin-bottom: 8px; }
  .sr-item-name { font-weight: bold; font-size: .9rem; color: var(--sky-dark); display: block; margin-bottom: 2px;}
  [data-theme="dark"] .sr-item-name { color: #a8daf0; }
  .sr-item-stars { color: #fbbf24; font-size: .9rem; letter-spacing: 1px; display: block;}
  .sr-item-text { font-size: .9rem; color: var(--text-main); margin: 0 0 10px 0; line-height: 1.6; word-break: break-word;}
  [data-theme="dark"] .sr-item-text { color: #F3F9FF; }
  .sr-item-time { font-size: .75rem; color: var(--text-dim); font-style: italic;}
  .sr-del-btn { font-size: .75rem; color: #ef4444; background: none; border: none; cursor: pointer; display: none; padding: 0;}
  .sr-del-btn.show { display: block; }
  .sr-del-btn:hover { text-decoration: underline; }
</style>

<script is:inline>
  (function initStoryReview() {
    const section = document.querySelector('.story-review-section');
    if(!section) return;
    const truyenId = section.dataset.truyenId;
    const listEl = document.getElementById('srList');
    const submitBtn = document.getElementById('srSubmit');
    const starSelect = document.getElementById('srStarSelect');
    
    let selectedStars = 5;
    
    function esc(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
    function timeAgo(ts){
      if(!ts) return ''; const d=Date.now()-ts;
      if(d<60000) return 'vừa xong'; if(d<3600000) return Math.floor(d/60000)+' phút trước';
      if(d<86400000) return Math.floor(d/3600000)+' giờ trước'; return Math.floor(d/86400000)+' ngày trước';
    }
    function getMyToken(){ let t = localStorage.getItem('dd_token'); if(!t){ t = Math.random().toString(36).slice(2)+Date.now().toString(36); localStorage.setItem('dd_token',t); } return t; }

    const myToken = getMyToken();
    const ADMIN_DISPLAY_NAME = 'dynamic duo 𓆝';
    
    // Khôi phục tên đã nhập
    const savedName = localStorage.getItem('dd_commenter_name');
    if(savedName) document.getElementById('srName').value = savedName;

    // Click chọn sao
    if(starSelect) {
      const stars = starSelect.querySelectorAll('span');
      stars.forEach(s => {
        s.addEventListener('click', () => {
          selectedStars = parseInt(s.dataset.val);
          stars.forEach(st => { st.classList.toggle('active', parseInt(st.dataset.val) <= selectedStars); });
        });
      });
    }

    function setupFirebaseLogic(fb) {
      const reviewRef = fb.ref(fb.db, 'novel_reviews/' + truyenId);
      
      // Lắng nghe dữ liệu hiển thị
      fb.onValue(reviewRef, snap => {
        const data = snap.val() || {};
        const items = Object.entries(data).map(([id,v]) => ({id, ...v})).sort((a,b) => b.ts - a.ts);
        
        document.getElementById('srCount').textContent = `(${items.length} đánh giá)`;
        
        let avg = 0;
        if(items.length > 0) {
           const total = items.reduce((sum, item) => sum + (item.rating||5), 0);
           avg = (total / items.length).toFixed(1);
        }
        document.getElementById('srAvg').textContent = avg > 0 ? avg : '0.0';
        
        let starHtml = ''; const fullStars = Math.round(avg);
        for(let i=0; i<5; i++) starHtml += (i < fullStars ? '★' : '☆');
        document.getElementById('srStarsDisplay').textContent = starHtml;

        if(items.length === 0) {
           listEl.innerHTML = '<div style="grid-column: 1/-1; text-align:center; padding: 20px; font-style:italic; color:var(--text-dim);">Chưa có đánh giá nào. Hãy là người đầu tiên bóc tem truyện nhé! ⭐</div>';
        } else {
           listEl.innerHTML = items.map(rv => {
              const isMine = rv.token === myToken; const canDel = window.__ddIsAdmin || isMine;
              const stars = '★'.repeat(rv.rating) + '☆'.repeat(5 - rv.rating);
              const badge = rv.isAdmin ? '<span style="background:var(--sky); color:#fff; font-size:.6rem; padding:2px 8px; border-radius:99px; margin-left:6px; vertical-align:middle; font-family:sans-serif">chủ nhà</span>' : '';
              return `
                <div class="sr-item">
                   <div class="sr-item-hd">
                      <div>
                        <span class="sr-item-name">${esc(rv.name)||'Khách ẩn danh'}${badge}</span>
                        <span class="sr-item-stars">${stars}</span>
                      </div>
                      ${canDel ? `<button class="sr-del-btn show" data-id="${esc(rv.id)}">Xóa</button>` : ''}
                   </div>
                   <p class="sr-item-text">${esc(rv.text).replace(/\n/g, '<br>')}</p>
                   <div class="sr-item-time">${timeAgo(rv.ts)}</div>
                </div>
              `;
           }).join('');

           listEl.querySelectorAll('.sr-del-btn').forEach(b => {
              b.addEventListener('click', async () => {
                 if(!confirm('Xóa đánh giá này?')) return;
                 await fb.remove(fb.ref(fb.db, `novel_reviews/${truyenId}/${b.dataset.id}`));
              });
           });
        }
      });

      // Gửi đánh giá
      if(submitBtn && !submitBtn.dataset.bound) {
        submitBtn.dataset.bound = "true";
        submitBtn.addEventListener('click', async () => {
          const text = document.getElementById('srText')?.value.trim();
          let name = document.getElementById('srName')?.value.trim() || 'Khách';
          if(!text) { alert('Vui lòng viết vài lời nhận xét nhé!'); return; }
          
          if(window.__ddIsAdmin) name = ADMIN_DISPLAY_NAME;
          else if(name !== 'Khách') localStorage.setItem('dd_commenter_name', name);
          
          submitBtn.disabled = true;
          submitBtn.textContent = 'Đang gửi...';
          try {
            await fb.push(reviewRef, { name: name, text: text, rating: selectedStars, ts: Date.now(), token: myToken, isAdmin: !!window.__ddIsAdmin });
            document.getElementById('srText').value = '';
          } catch(e) { alert('Lỗi khi gửi: ' + e.message); }
          
          setTimeout(() => {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Gửi đánh giá';
          }, 500);
        });
      }
    }

    if(window.__ddFirebase?.db) { setupFirebaseLogic(window.__ddFirebase); }
    else { window.addEventListener('dd-firebase-ready', () => setupFirebaseLogic(window.__ddFirebase), {once:true}); }
  })();
</script>
</Layout>
