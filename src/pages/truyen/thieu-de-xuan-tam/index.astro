---
import Layout from '../../../layouts/Layout.astro';

const allPosts = Object.values(
  import.meta.glob('./*.md', { eager: true })
) as any[];

const chapters = allPosts
  .filter((p) => p.frontmatter?.chuong && p.frontmatter.chuong !== 0)
  .sort((a, b) => (a.frontmatter?.chuong ?? 999) - (b.frontmatter?.chuong ?? 999));
  const tong_so_chuong = 80; // Điền tổng số chương của truyện này (nếu chưa rõ thì để 9999)
const hoan_thanh = false;   // Nếu đã dịch xong 100%, đổi thành true
const total = tong_so_chuong; 
const pct = Math.floor((chapters.length / total) * 100); // Thêm 2 dòng cho tất cả index
---

<Layout frontmatter={{
  title: 'Thiếu đế xuân tâm',
  description: 'Chỉ cho phép thích trẫm, đừng trao tim mình cho bất kì kẻ nào khác.',
  tags: ['đam mỹ', 'cổ đại', 'HE', 'chua xót', '1v1', 'thủy tinh', 'niên hạ']
}}>
  <style>
    .story-cover { width: 200px; border-radius: 12px; box-shadow: var(--sh-card); display: block; margin: 0 auto 28px; }
    .status-badge { display: inline-block; padding: 3px 14px; border-radius: var(--r-pill); font-size: .72rem; letter-spacing: 1.5px; text-transform: uppercase; font-weight: 600; background: #dcfce7; color: #166534; margin: 8px 0 16px; }
    .progress-bar-wrap { max-width: 320px; margin: 12px auto; }
    .progress-label { font-size: .76rem; color: var(--text-dim); text-align: center; margin-bottom: 5px; }
    .progress-bar { height: 6px; background: rgba(186,230,253,.4); border-radius: 3px; overflow: hidden; }
    .progress-fill { height: 100%; background: linear-gradient(to right, var(--sky-light), var(--sky)); border-radius: 3px; }
    .intro-block { background: var(--sky-pale); border: 1px solid rgba(186,230,253,.5); border-radius: var(--r-md); padding: 20px 24px; margin: 24px 0; font-size: .9rem; color: var(--text-mid); line-height: 1.8; }
    .intro-block h4 { font-size: .8rem; letter-spacing: 2px; text-transform: uppercase; color: var(--sky-dark); text-align: left; margin: 0 0 10px; }
    .intro-block p { margin: 0 0 8px; }
/* THIẾT KẾ GRID NHÂN VẬT CÔNG - THỤ */
    .char-grid { 
      display: grid; grid-template-columns: 1fr auto 1fr; gap: 20px; 
      align-items: stretch; margin: 36px 0; 
    }
    .char-box { 
      background: var(--bg-card); border: 1px solid var(--sky-light); 
      border-radius: 16px; padding: 20px 16px; text-align: center; 
      box-shadow: 0 4px 15px rgba(14,165,233,0.05); transition: transform 0.2s;
    }
    .char-box:hover { transform: translateY(-4px); border-color: var(--sky); }
    [data-theme="dark"] .char-box { background: rgba(15,35,54,0.4); border-color: rgba(126,200,227,0.2); }
    
    .char-role { 
      font-size: 0.7rem; font-weight: bold; text-transform: uppercase; 
      letter-spacing: 2px; padding: 4px 16px; border-radius: 99px; 
      display: inline-block; margin-bottom: 12px;
    }
    /* Màu riêng cho Công (Đỏ nhạt) và Thụ (Xanh nhạt) */
    .char-role.top { background: #fee2e2; color: #b91c1c; border: 1px solid #fca5a5;} 
    .char-role.bot { background: #e0f2fe; color: #0369a1; border: 1px solid #7dd3fc;} 
    [data-theme="dark"] .char-role.top { background: rgba(220,38,38,0.15); color: #fca5a5; border-color: rgba(248,113,113,0.3);}
    [data-theme="dark"] .char-role.bot { background: rgba(14,165,233,0.15); color: #7dd3fc; border-color: rgba(56,189,248,0.3);}
    
    .char-name { font-family: 'Merriweather', serif; font-size: 1.2rem; color: var(--sky-dark); margin-bottom: 8px; font-weight: bold;}
    [data-theme="dark"] .char-name { color: #a8daf0; }
    
    .char-attr { font-size: 0.85rem; color: var(--text-mid); line-height: 1.5; font-style: italic;}
    [data-theme="dark"] .char-attr { color: #b8d4e8; }
    
    .char-divider { display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: var(--sky-light); }
    
    /* Reponsive trên điện thoại */
    @media (max-width: 600px) { 
      .char-grid { grid-template-columns: 1fr; gap: 12px; } 
      .char-divider { transform: rotate(90deg); margin: 5px 0;} 
    }
   .toc-section { margin-top: 32px; }
    .toc-title { font-family: 'Merriweather', serif; font-size: .88rem; color: var(--sky-dark); letter-spacing: 2px; text-transform: uppercase; text-align: center; margin-bottom: 16px; padding-bottom: 10px; border-bottom: 1px dashed var(--sky-light); }
    .toc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
    @media (max-width: 480px) { .toc-grid { grid-template-columns: 1fr; } }
    .toc-item { display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: var(--r-sm); font-size: .84rem; color: var(--text-mid); transition: var(--t); border: 1px solid transparent; }
    .toc-item:hover { background: var(--sky-pale); color: var(--sky); border-color: rgba(186,230,253,.5); }
    .toc-num { font-size: .7rem; color: var(--text-dim); width: 28px; flex-shrink: 0; font-family: monospace; }
    .read-btn { display: block; text-align: center; margin: 28px auto 0; padding: 12px 32px; background: var(--sky); color: #fff; border-radius: var(--r-pill); font-size: .9rem; font-family: 'Newsreader', serif; transition: var(--t); max-width: 220px; }
    .read-btn:hover { background: var(--sky2); transform: translateY(-2px); }
  </style>

  <img src="/dynamic-duo-web/images/biatdxt.png" alt="Bìa truyện" class="story-cover"
    onerror="this.src='/dynamic-duo-web/images/frontpage.png'" />


  <div style="text-align:center">
    <h2 style="margin:0 0 10px;font-size:1.3rem">Thiếu đế xuân tâm</h2>
    <span class="status-badge">🌊 Đang tiến hành</span>
    <div style="font-size:.9rem;color:var(--text-mid);margin:4px 0"><strong style="color:var(--sky-dark)">Tác giả:</strong> Hạnh Lan</div>
    <div style="font-size:.9rem;color:var(--text-mid);margin:4px 0"><strong style="color:var(--sky-dark)">Editor:</strong> Dynamic Duo</div>
    <div style="font-size:.9rem;color:var(--text-mid);margin:4px 0"><strong style="color:var(--sky-dark)">Thể loại:</strong> Đam mỹ · Hiện đại · Niên hạ</div>
    <div class="progress-bar-wrap">
      <div class="progress-label">📖 Tiến độ: {pct}% ({chapters.length}/{total} chương)</div>
      <div class="progress-bar"><div class="progress-fill" style={`width:${pct}%`}></div></div>
    </div>
  </div>

<div class="char-grid">
    <!-- KHUNG CHO CÔNG -->
    <div class="char-box">
       <div class="char-role top">Công</div>
       <div class="char-name">Triệu Húc</div>
       <div class="char-attr">Hoàng đế nhỏ tuổi, cố chấp điên cuồng, dục vọng chiếm hữu cao</div>
    </div>
    
    <!-- BIỂU TƯỢNG Ở GIỮA -->
    <div class="char-divider">✧ ✖ ✧</div>
    
    <!-- KHUNG CHO THỤ -->
    <div class="char-box">
       <div class="char-role bot">Thụ</div>
       <div class="char-name">Phó Nguyên Thanh</div>
       <div class="char-attr">Quyền hoạn thê thảm, đẹp mà mạnh mẽ, không thiết sống</div>
    </div>
  </div>

  <div class="intro-block">
<p>
<strong>Giới thiệu:</strong>
</p>
<p>Lão tổ tông của Ty Lễ giám đổ bệnh, bệnh tình rất nguy kịch.</p>
<p>Sau khi tìm đến danh y, có được một phương thuốc cứu mạng: Lấy người làm lô đỉnh, tu luyện thuật “thái dương bổ khuyết”*, hành pháp Đại Hoang Ngọc Kinh thì có thể kéo dài tuổi thọ thêm vài tháng.</p>
<p>
<i>(*) Thái dương bổ khuyết: Lấy dương bù âm</i>
</p>
<p>Tử sĩ được tuyển chọn đưa vào trướng, thế mà lại hơi giống Tiên đế.</p>
<p>Đời người đã sắp đi đến hồi kết, sao y không buông thả một chút, cho dù chỉ là làm tình lữ giả cũng được... Coi như tìm chút an ủi cho một đời khổ nạn của mình.</p>
<p>Xuân phong mấy bận, cả cơ thể lẫn linh hồn đều đã lún sâu, mới phát hiện ra lô đỉnh kia chính là Thiếu đế giả dạng.</p>
<p>Thế mà bản thân lại dây dưa với vị Đế vương mà bao năm nay mình vẫn coi như con ruột, y vừa thẹn vừa giận, vô cùng phẫn nộ, hỏi Thiếu đế đã thích mình từ khi nào.</p>
<p>Thiếu đế cười một tiếng, đáp:</p>
<p>“Trang Chu hiểu mộng, Vọng Đế xuân tâm.</p>
<p>Xuân tình này của trẫm đã sớm thác gửi từ lần đầu tiên gặp a phụ rồi.”</p>
<p>--</p>
<p>Chỉ cho phép thích trẫm, đừng trao tim mình cho bất kì kẻ nào khác.</p>
<p>Hoàng đế công nhỏ tuổi hơn, diễn như không diễn, cố chấp điên cuồng, có nhiều bộ mặt (Triệu Húc) x Quyền hoạn thụ vừa đẹp vừa mạnh mẽ nhưng số khổ, không thiết sống (Phó Nguyên Thanh)</p>
<p>--</p>
<p>⋆.˚ <strong>Thông tin bổ sung:</strong>
</p>
<p>• Công nhỏ hơn thụ chừng 13 tuổi (công 20 tuổi, thụ 33 tuổi).</p>
<p>• Công vừa bệnh hoạn, vừa điên cuồng lại đen tối, tính tình cố chấp, dục vọng chiếm hữu cực mạnh.</p>
<p>⚠︎ <strong>Lưu ý (lời tác giả):</strong>
</p>
<p>• Truyện lấy bối cảnh giả tưởng, tham khảo chế độ nhà Minh, có những thiết lập riêng của tác giả.</p>
<p>• Điểm mấu chốt của cốt truyện thật ra đã nói rõ trong phần giới thiệu, đây là một câu chuyện có tuyến tình cảm khá ngọt theo kiểu “đường trộn vụn thủy tinh”, thụ thuộc kiểu vừa đẹp vừa mạnh mẽ nhưng số phận bi đát.</p>
</p>
<p>⋆.˚<i>
<strong>Nhan đề truyện được lấy cảm hứng từ hai câu thơ trong bài “Cẩm Sắt” (Lý Thương Ẩn):</strong>
</i>
</p>
<p>
<i>“Trang sinh hiểu mộng mê hồ điệp</i>
</p>
<p>
<i>Vọng Đế xuân tâm thác đỗ quyên”.</i>
</p>
<p>Vế đầu nhắc đến điển tích Trang Chu mộng điệp, tương truyền, Trang Tử nằm mơ thấy mình hóa bướm, nhởn nhơ bay lượn mà quên mất bản thân. Đến khi tỉnh giấc, ông ngỡ ngàng không rõ là mình vừa mơ hóa thành bướm, hay chính bướm đang mơ thấy mình hóa thành Trang Chu. Câu thơ mượn tích này để diễn tả cảm giác mông lung, chơi vơi, cõi đời hư ảo không phân định rõ đâu là mộng, đâu là thực.</p>
<p>Vế sau nhắc tích Vọng Đế hóa quyên, gợi nhắc bi kịch của Vua Thục (Vọng Đế) mang nỗi oan khuất và tiếc nuối, sau khi chết, hồn ông hóa thành chim đỗ quyên, ngày đêm cất tiếng kêu than bi thiết đến mức nhỏ máu.</p>
<p>Bên cạnh đó, xuân tâm (春心) vốn mang nghĩa là lòng xuân, đồng nghĩa với “xuân tình” (春情) chỉ tình yêu đôi lứa, có thể bao hàm cả sắc thái sắc dục. Khi được đặt cạnh hình ảnh bi ai của chim đỗ quyên, “xuân tâm” từ tình yêu thông thường được nâng lên thành chấp niệm tình cảm sâu nặng, đau đớn và bi thương như những giọt huyết lệ.</p>
 </div>
  <div class="intro-block" style="margin-top:12px">
    <h4>💫 Góc dò mìn</h4>
    <p>Biển sâu nước lạnh, hãy mặc áo phao và đọc kỹ trước khi lặn nhé!</p>
<p>• Công là Hoàng đế, để phù hợp với bối cảnh lịch sử sẽ có hôn ước được xếp sẵn, một chút tình tiết cung đấu và vài nhân vật nữ phản diện (không thể tránh khỏi, xin lỗi).</p>
<p>• Có tình tiết công tự ghen với chính mình, tự “cắm sừng” chính mình... Tôi thấy không có vấn đề gì, nhưng có thể một số người sẽ không thích.</p>
<p>• Thụ là “trai tân” lớn tuổi, công là tình đầu.</p>
  </div>
  {chapters.length > 0 && (
    <a href={chapters[0].url} class="read-btn">Đọc từ Chương 1 →</a>
  )}

  <div class="toc-section">
    <div class="toc-title">🌊 Mục lục ({chapters.length} chương)</div>
    <div class="toc-grid">
      {chapters.map((c) => (
        <a href={c.url} class="toc-item">
          <span class="toc-num">C{c.frontmatter?.chuong}</span>
          <span>{c.frontmatter?.title || `Chương ${c.frontmatter?.chuong}`}</span>
        </a>
      ))}
    </div>
  </div>
  <!-- =============== KHU VỰC REVIEW CÔNG KHAI =============== -->
<div class="public-reviews-widget" data-truyen-id="thieu-de-xuan-tam">
  <div class="prw-header">
    <h3>⭐ Đánh giá từ độc giả</h3>
    <div class="prw-stats">
      <span class="prw-avg">0.0</span>
      <span class="prw-stars">☆☆☆☆☆</span>
      <span class="prw-count">(0 đánh giá)</span>
    </div>
  </div>

  <!-- FORM VIẾT ĐÁNH GIÁ MỚI -->
  <div class="prw-form-box">
    <div class="prw-star-select" id="prwStarSelect">
      <span data-val="1">★</span><span data-val="2">★</span><span data-val="3">★</span><span data-val="4">★</span><span data-val="5" class="active">★</span>
    </div>
    <input class="prw-inp" id="prwName" placeholder="Tên của bạn (Tùy chọn)" autocomplete="off" />
    <textarea class="prw-textarea" id="prwText" placeholder="Bộ truyện này thế nào? Chia sẻ cảm nhận của bạn với mọi người nhé..." rows="3"></textarea>
    <div style="text-align:right">
      <button class="prw-submit-btn" id="prwSubmit">Gửi đánh giá</button>
    </div>
  </div>

  <!-- DANH SÁCH ĐÁNH GIÁ -->
<div class="prw-list" id="prwList">
     <div style="text-align:center; padding: 20px; font-style:italic; color:var(--text-dim); font-size: 0.85rem;">Đang tải đánh giá...</div>
  </div>

<!-- LƯU Ý: Phải có is:global thì CSS mới ăn vào phần HTML tạo bằng Javascript -->
<style is:global>
  /* KHUNG TỔNG THỂ */
  .public-reviews-widget {
    margin-top: 40px; padding-top: 24px;
    border-top: 2px dashed var(--sky-light);
    font-family: var(--read-ff, 'Newsreader', serif);
  }
  [data-theme="dark"] .public-reviews-widget { border-color: rgba(126,200,227,0.2); }
  
  /* PHẦN ĐẦU (TIÊU ĐỀ & ĐIỂM SỐ) */
  .prw-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 10px;}
  .prw-header h3 { margin: 0; font-size: 1.15rem; color: var(--sky-dark); font-family: 'Merriweather', serif; font-weight: bold;}
  [data-theme="dark"] .prw-header h3 { color: #a8daf0; }
  .prw-stats { display: flex; align-items: center; gap: 8px; }
  .prw-avg { font-weight: bold; font-size: 1.5rem; color: var(--sky-dark); line-height: 1;}
  [data-theme="dark"] .prw-avg { color: #a8daf0; }
  .prw-stars { color: #fbbf24; font-size: 1.1rem; letter-spacing: 2px; }
  .prw-count { font-size: 0.8rem; color: var(--text-dim); font-style: italic;}
  
  /* FORM ĐIỀN ĐÁNH GIÁ */
  .prw-form-box { background: var(--sky-pale); padding: 18px; border-radius: 12px; margin-bottom: 24px; border: 1px solid rgba(186,230,253,.5); }
  [data-theme="dark"] .prw-form-box { background: rgba(15,35,54,.6); border-color: rgba(126,200,227,.15); }
  .prw-star-select { font-size: 2rem; color: #d1d5db; cursor: pointer; user-select: none; text-align: center; margin-bottom: 12px; letter-spacing: 5px;}
  .prw-star-select span { transition: color 0.2s; }
  .prw-star-select span:hover, .prw-star-select span.active { color: #fbbf24; }
  .prw-inp, .prw-textarea { width: 100%; padding: 10px 14px; border: 1.5px solid var(--sky-light); border-radius: 8px; font-size: .85rem; font-family: inherit; color: var(--text-main); background: var(--cream); outline: none; margin-bottom: 10px; transition: all 0.2s; box-sizing: border-box;}
  .prw-inp:focus, .prw-textarea:focus { border-color: var(--sky); box-shadow: 0 0 0 3px rgba(14,165,233,0.1); }
  [data-theme="dark"] .prw-inp, [data-theme="dark"] .prw-textarea { background: #091620; border-color: #1e4a6a; color: #F3F9FF; }
  .prw-submit-btn { padding: 8px 24px; background: #f59e0b; color: #fff; border: none; border-radius: 99px; font-size: .85rem; cursor: pointer; font-family: inherit; font-weight: bold; transition: all 0.2s; }
  .prw-submit-btn:hover { background: #d97706; transform: translateY(-2px); box-shadow: 0 4px 10px rgba(245,158,11,0.3); }
  .prw-submit-btn:disabled { opacity: 0.5; pointer-events: none; }

  /* DANH SÁCH REVIEW (DẠNG LƯỚI CARD) */
.prw-list { display: flex; flex-direction: column; gap: 12px; }
  
  /* TỪNG THẺ REVIEW MỘT */
  .prw-item {
    background: #fff; border: 1px solid rgba(186,230,253,0.8);
    padding: 16px; border-radius: 12px; transition: transform 0.2s, box-shadow 0.2s;
    display: flex; flex-direction: column; gap: 10px;
    box-shadow: 0 4px 15px rgba(14,165,233,0.05);
  }
  .prw-item:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(14,165,233,0.12); }
  [data-theme="dark"] .prw-item { background: rgba(15,35,54,0.6); border-color: rgba(126,200,227,0.15); box-shadow: none; }
  [data-theme="dark"] .prw-item:hover { box-shadow: 0 6px 20px rgba(0,0,0,0.4); }
  
  /* THÔNG TIN NGƯỜI DÙNG & SAO */
  .prw-user-info { display: flex; flex-direction: column; gap: 3px; }
  .prw-name { font-weight: 600; font-size: 0.9rem; color: var(--sky-dark); font-family: sans-serif; display: flex; align-items: center;}
  [data-theme="dark"] .prw-name { color: #a8daf0; }
  .prw-stars { color: #fbbf24; font-size: 0.85rem; letter-spacing: 2px; }
  .prw-admin-badge { background: var(--sky); color: #fff; font-size: 0.6rem; padding: 2px 6px; border-radius: 99px; margin-left: 6px; text-transform: uppercase;}
  
  /* NỘI DUNG CHỮ */
  .prw-text { font-size: 0.85rem; color: var(--text-main); line-height: 1.6; margin: 0; word-break: break-word;}
  [data-theme="dark"] .prw-text { color: #F3F9FF; }
  
  /* PHẦN CHÂN THẺ (THỜI GIAN & NÚT XÓA) */
  .prw-footer { display: flex; justify-content: space-between; align-items: center; margin-top: auto; border-top: 1px dashed rgba(186,230,253,0.6); padding-top: 10px;}
  [data-theme="dark"] .prw-footer { border-top-color: rgba(126,200,227,0.2); }
  .prw-time { font-size: 0.75rem; color: var(--text-dim); font-style: italic;}
  
  /* NÚT XÓA (CHỈ CHỦ NHÂN MỚI THẤY NHỜ JS) */
  .prw-del { font-size: 0.7rem; color: #ef4444; background: rgba(239,68,68,0.1); border: none; cursor: pointer; padding: 4px 10px; border-radius: 6px; transition: all 0.2s; font-family: sans-serif; font-weight: bold;}
  .prw-del:hover { background: #ef4444; color: #fff;}
</style>

<script is:inline>
  (function loadPublicReviews() {
    const widget = document.querySelector('.public-reviews-widget');
    const listEl = document.getElementById('prwList');
    if(!widget || !listEl) return;
    const truyenId = widget.dataset.truyenId;
    
    function esc(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
    function timeAgo(ts){
      if(!ts) return ''; const d=Date.now()-ts;
      if(d<60000) return 'vừa xong'; if(d<3600000) return Math.floor(d/60000)+' phút trước';
      if(d<86400000) return Math.floor(d/3600000)+' giờ trước'; return Math.floor(d/86400000)+' ngày trước';
    }
    // Lấy Token máy hiện tại để check quyền
    function getMyToken(){ let t = localStorage.getItem('dd_token'); if(!t){ t = Math.random().toString(36).slice(2)+Date.now().toString(36); localStorage.setItem('dd_token',t); } return t; }
    
    const myToken = getMyToken();

    // Khôi phục tên đã nhập lần trước
    const savedName = localStorage.getItem('dd_commenter_name');
    if(savedName) document.getElementById('prwName').value = savedName;

    // Logic chọn sao
    let selectedStars = 5;
    const starSelect = document.getElementById('prwStarSelect');
    if(starSelect) {
      const stars = starSelect.querySelectorAll('span');
      stars.forEach(s => {
        s.addEventListener('click', () => {
          selectedStars = parseInt(s.dataset.val);
          stars.forEach(st => { st.classList.toggle('active', parseInt(st.dataset.val) <= selectedStars); });
        });
      });
    }

    function initFirebase(fb) {
      // 1. Tải danh sách Review
      fb.onValue(fb.ref(fb.db, 'novel_reviews/' + truyenId), snap => {
        const data = snap.val() || {};
        const items = Object.entries(data).map(([id,v]) => ({id, ...v})).sort((a,b) => b.ts - a.ts);
        
        widget.querySelector('.prw-count').textContent = `(${items.length} đánh giá)`;
        
        let avg = 0;
        if(items.length > 0) {
           const total = items.reduce((sum, item) => sum + (item.rating||5), 0);
           avg = (total / items.length).toFixed(1);
        }
        widget.querySelector('.prw-avg').textContent = avg > 0 ? avg : '0.0';
        
        let starHtml = ''; const fullStars = Math.round(avg);
        for(let i=0; i<5; i++) starHtml += (i < fullStars ? '★' : '☆');
        widget.querySelector('.prw-stars').textContent = starHtml;

        if(items.length === 0) {
           listEl.innerHTML = '<div style="text-align:center; padding: 20px; font-style:italic; color:var(--text-dim); font-size: 0.85rem">Chưa có đánh giá nào. Chờ bạn thả sao đấy! ⭐</div>';
        } else {
           listEl.innerHTML = items.map(rv => {
              const stars = '★'.repeat(rv.rating) + '☆'.repeat(5 - rv.rating);
              const badge = rv.isAdmin ? '<span class="prw-admin-badge">chủ nhà</span>' : '';
              
              // BẢO MẬT GIAO DIỆN: Chỉ token của người gửi hoặc Admin mới tạo ra HTML nút Xóa
              const canDel = window.__ddIsAdmin || rv.token === myToken;

              // XUẤT HTML THẺ REVIEW CÓ CLASS VỪA ĐỊNH NGHĨA TRONG STYLE
              return `
                <div class="prw-item">
                  <div class="prw-user-info">
                    <span class="prw-name">${esc(rv.name)||'Khách ẩn danh'} ${badge}</span>
                    <span class="prw-stars">${stars}</span>
                  </div>
                  <div class="prw-text">${esc(rv.text).replace(/\n/g, '<br>')}</div>
                  <div class="prw-footer">
                    <span class="prw-time">${timeAgo(rv.ts)}</span>
                    ${canDel ? `<button class="prw-del" data-id="${esc(rv.id)}">Xóa</button>` : ''}
                  </div>
                </div>
              `;
           }).join('');

           // Gắn sự kiện Xóa
           listEl.querySelectorAll('.prw-del').forEach(b => {
              b.addEventListener('click', async () => {
                 if(!confirm('Bạn có chắc chắn muốn xóa đánh giá này?')) return;
                 await fb.remove(fb.ref(fb.db, `novel_reviews/${truyenId}/${b.dataset.id}`));
              });
           });
        }
      });

      // 2. Logic Nút Gửi Review (Có block để chống bấm gửi 2 lần)
      const submitBtn = document.getElementById('prwSubmit');
      if(submitBtn && !submitBtn.dataset.boundSubmit) {
        submitBtn.dataset.boundSubmit = "true";
        submitBtn.addEventListener('click', async () => {
          const text = document.getElementById('prwText')?.value.trim();
          let name = document.getElementById('prwName')?.value.trim() || 'Khách';
          if(!text) { alert('Vui lòng viết vài lời nhận xét nhé!'); return; }
          
          if(window.__ddIsAdmin) name = 'dynamic duo 𓆝';
          else if(name !== 'Khách') localStorage.setItem('dd_commenter_name', name);
          
          submitBtn.disabled = true;
          submitBtn.textContent = 'Đang gửi...';
          
          try {
            await fb.push(fb.ref(fb.db, 'novel_reviews/' + truyenId), {
              name: name,
              text: text,
              rating: selectedStars,
              ts: Date.now(),
              token: myToken,
              isAdmin: !!window.__ddIsAdmin
            });
            document.getElementById('prwText').value = '';
          } catch(e) { 
            alert('Lỗi khi gửi: ' + e.message); 
          } finally {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Gửi đánh giá';
          }
        });
      }
    }

    if(window.__ddFirebase?.db) { initFirebase(window.__ddFirebase); }
    else { window.addEventListener('dd-firebase-ready', () => initFirebase(window.__ddFirebase), {once:true}); }
  })();
</script>
<!-- ========================================================== -->  
</Layout>